#!/usr/bin/env ruby
# frozen_string_literal: true

# Rewrites every committed MARKUP_DIGEST — a component's constant, a template's comment —
# to the digest of its current markup. Run it after editing markup that renders inside a
# fragment cache.

require_relative "../config/environment"

updated = MarkupDigest.files.filter_map do |file|
  digest = MarkupDigest.update(file)
  "#{file.relative_path_from(Rails.root)}: #{digest}" if digest
end

puts updated.any? ? updated.join("\n") : "All markup digests are current"
