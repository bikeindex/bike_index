#!/usr/bin/env ruby
require "fileutils"
load File.expand_path("env", __dir__)

# path to your application root.
APP_ROOT = File.expand_path("..", __dir__)

without_seeds = ARGV.include?("--without_seeds")

def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

# ".git" from the main checkout and "" outside a repo both expand to APP_ROOT
def shared_root
  root = File.expand_path(File.dirname(`git rev-parse --git-common-dir 2>/dev/null`.strip), APP_ROOT)
  root unless root == APP_ROOT
end

FileUtils.chdir APP_ROOT do
  # Untracked state too stateful to duplicate comes from the root checkout rather
  # than being rebuilt per workspace
  if (root = shared_root)
    puts "== Setting up workspace against #{root} =="

    # Copy .env.test from root repo
    env_test = File.join(root, ".env.test")
    if File.exist?(env_test)
      puts "Copying .env.test from #{root}..."
      FileUtils.cp env_test, ".env.test"
    end

    # Copy .env.conductor_dev from root repo
    env_dev = File.join(root, ".env.conductor_dev")
    if File.exist?(env_dev)
      puts "Copying .env.conductor_dev from #{root}..."
      FileUtils.cp env_dev, ".env.development"
    end

    # Symlink storage directory for Active Storage
    root_storage = File.join(root, "storage")
    if Dir.exist?(root_storage)
      puts "Symlinking storage from #{root_storage}..."
      FileUtils.rm_rf "storage"
    else
      puts "Creating storage directory at #{root_storage}..."
      FileUtils.mkdir_p root_storage
    end
    FileUtils.ln_sf root_storage, "storage"

    # A clone (APFS clonefile) shares the root install's disk blocks, where npm writes a
    # full 160MB copy per workspace. npm replaces a symlinked node_modules, so it can't be one
    root_node_modules = File.join(root, "node_modules")
    if Dir.exist?(root_node_modules) && !Dir.exist?("node_modules")
      puts "Cloning node_modules from #{root_node_modules}..."
      system("cp", "-Rc", root_node_modules, "node_modules")
    end

    # Copy Facebook VCR cassettes
    fb_cassettes = File.join(root, "spec/vcr_cassettes/facebook")
    if Dir.exist?(fb_cassettes)
      puts "Copying spec/vcr_cassettes/facebook from #{root}..."
      FileUtils.mkdir_p "spec/vcr_cassettes/facebook"
      Dir.glob(File.join(fb_cassettes, "*")).each { |f| FileUtils.cp f, "spec/vcr_cassettes/facebook/" }
    end
  end

  puts "== Checking Ruby version =="
  required_ruby = File.read(".tool-versions")[/^ruby (\S+)/, 1]
  if required_ruby && required_ruby != RUBY_VERSION
    if ENV["SETUP_RUBY_INSTALLED"]
      abort "Failed to activate Ruby #{required_ruby} via mise after installing"
    end
    abort "mise is required but not found. See https://mise.jdx.dev/" unless system("which mise > /dev/null 2>&1")
    puts "Ruby #{required_ruby} required (current: #{RUBY_VERSION}), installing via mise..."
    system!("mise install ruby@#{required_ruby}")
    exec({"SETUP_RUBY_INSTALLED" => "1"}, "mise", "exec", "--", "ruby", __FILE__, *ARGV)
  end

  puts "== Installing dependencies =="
  system! "gem install bundler --conservative"
  system("bundle check") || system!("bundle install")

  puts "== Starting redis so database can be migrated =="
  system "redis-server &"

  npm_install = spawn("npm install")

  # The layout needs tailwind.css and emails (which seeding sends) need email.css; without
  # the build Sprockets tries compiling email.scss with sassc
  puts "\n== Preparing database, building stylesheets, clearing logs =="
  system! "bin/rails db:prepare tailwindcss:build dartsass:build log:clear"
  Process.wait(npm_install)

  unless without_seeds
    # db:seed isn't idempotent: a re-run over seeded records dies on duplicates
    if system("bin/rails runner 'exit Bike.unscoped.exists?'")
      puts "\n== Database already seeded =="
    else
      puts "\n== Seeding database =="
      system! "bin/rake db:seed"
    end

    # Opt-in, matching lib/tasks/parallel_migrate.rake
    unless ENV["PARALLEL_MIGRATIONS"].to_s.strip.empty?
      puts "\n== Preparing parallel test databases =="
      system! "bin/rake parallel:prepare"
    end

    # Autocomplete (typeahead) is loaded by db:seed above; here we just load counts
    puts "\n== loading bike counts =="
    system! "bin/rake setup:load_counts"
  end

  puts "\n== Restarting application server =="
  system! "bin/rails restart"
end
