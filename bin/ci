#!/usr/bin/env ruby

# Runs locally what CI runs (.github/workflows/ci.yml), in one command.
#
#   bin/ci            lint + scan + the full spec suite
#   bin/ci --lint     just lint + scan
#   bin/ci --tests    just the spec suite
#   bin/ci --github   also report each result on the pushed HEAD commit
#
# Nothing stops at the first failure, so one run reports every check.

APP_ROOT = File.expand_path("..", __dir__)

# Each linter is listed out rather than delegated to `bin/lint --no-fix`, which
# aborts on the first failure and runs the three npm checks as one command.
LINT_AND_SCAN = {
  "standardrb" => "bundle exec standardrb --no-fix",
  "rubocop" => "bundle exec rubocop -c .rubocop_custom.yml",
  "js lint" => "npm run js:lint_check",
  "html lint" => "npm run html:lint_check",
  "html format" => "npm run html:format_check",
  "brakeman" => "bin/brakeman"
}.freeze

# parallel:prepare stands in for CI's db:create/db:schema:load - parallel test
# databases aren't migrated automatically (see README). RETRY_FLAKY is set the
# way ci.yml sets it, so a `:flaky`-tagged example gets the same two retries here.
TESTS = {
  "db prepare" => "bin/rake parallel:prepare",
  "rspec" => "RETRY_FLAKY=true bin/turbo_tests"
}.freeze

def run(name, command)
  puts "\n\e[1;34m== #{name}\e[0m: #{command}"
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  succeeded = system(command)
  {name:, succeeded:, elapsed: Process.clock_gettime(Process::CLOCK_MONOTONIC) - started}
end

# Commit statuses, not check runs - check runs are only writable by a GitHub App,
# and `gh` holds a user token. The local-ci/ prefix keeps a laptop's word about a
# commit distinguishable from the workflow's own checks.
def post_status(result, sha, note)
  posted = system("gh", "api", "--silent", "-X", "POST", "repos/{owner}/{repo}/statuses/#{sha}",
    "-f", "state=#{result[:succeeded] ? "success" : "failure"}",
    "-f", "context=local-ci/#{result[:name]}",
    "-f", "description=#{format("%.0fs on this machine", result[:elapsed])}#{note}")
  warn "  could not post the #{result[:name]} status - is #{sha[0, 7]} pushed?" unless posted
end

unknown = ARGV - ["--lint", "--tests", "--github"]
abort "Unknown option(s): #{unknown.join(" ")}\nUsage: bin/ci [--lint | --tests] [--github]" if unknown.any?

checks = if ARGV.include?("--lint")
  LINT_AND_SCAN
elsif ARGV.include?("--tests")
  TESTS
else
  LINT_AND_SCAN.merge(TESTS)
end

Dir.chdir(APP_ROOT) do
  github = ARGV.include?("--github")
  sha = `git rev-parse HEAD`.strip
  # A run against a dirty tree describes code that isn't at that sha - say so on
  # the status rather than refusing to post one.
  note = `git status --porcelain`.empty? ? "" : ", with uncommitted changes"

  results = checks.map do |name, command|
    result = run(name, command)
    post_status(result, sha, note) if github
    result
  end

  puts "\n\e[1m== bin/ci\e[0m"
  results.each do |result|
    status = result[:succeeded] ? "\e[32mpass\e[0m" : "\e[31mFAIL\e[0m"
    puts format("  %-11s %s %6.1fs", result[:name], status, result[:elapsed])
  end

  exit results.all? { |result| result[:succeeded] }
end
