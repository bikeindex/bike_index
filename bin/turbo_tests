#!/usr/bin/env ruby
# frozen_string_literal: true

# Before bin/env: it picks the Redis database off RAILS_ENV, and the REDIS_URL it
# lands on here is inherited by every worker. Unset, that's a *dev* database - one
# shared by all of them, and by a running bin/dev.
ENV["RAILS_ENV"] ||= "test"
load File.expand_path("env", __dir__)

require "bundler/setup"
require "digest"
require "etc"

# For some reason (I believe because of dartsass) assets get recompiled every time tests run
# So handle asset compilation ourselves
#
# JS counts as much as CSS: test serves from the sprockets manifest, so an
# unrebuilt bundle means the specs drive whatever JavaScript was compiled last -
# green while testing code that is no longer in the tree.
CSS_SOURCES = [
  "app/assets/stylesheets/**/*.{scss,css}",
  "app/assets/tailwind/**/*.css",
  "config/initializers/dartsass.rb"
].freeze

JS_SOURCES = ["app/assets/javascripts/**/*", "app/javascript/**/*"].freeze

# Each output against its own sources - the two are built by different tools, and
# SKIP_CSS_BUILD leaves builds/tailwind.css behind, so one shared cutoff would
# read as permanently stale.
def stale?(sources, outputs)
  return true if outputs.empty?

  oldest_asset_time = outputs.map { |file| File.mtime(file) }.min
  sources.any? do |pattern|
    app_glob(pattern).any? { |file| File.file?(file) && File.mtime(file) > oldest_asset_time }
  end
end

def app_glob(pattern)
  Dir.glob(File.expand_path("../#{pattern}", __dir__))
end

def assets_need_compilation?
  stale?(CSS_SOURCES, app_glob("app/assets/builds/*.css")) ||
    stale?(JS_SOURCES, app_glob("public/assets/.sprockets-manifest*.json"))
end

if assets_need_compilation?
  puts "Compiling assets before tests..."
  # Hide the output, dartsass vomits a bunch of warnings
  system("RAILS_ENV=test bundle exec rails assets:precompile 2>/dev/null")
end

# Make sure precompilation is off, because it's just been handled
ENV["RAILS_ASSETS_PRECOMPILE"] = "false"
# dartsass-rails hooks into test:prepare, skip since assets are already compiled
ENV["SKIP_CSS_BUILD"] = "true"

# turbo_tests defaults to one process per core, but bin/env only has 8 test Redis
# databases to hand out (8-15), so a 9th worker shares one - and specs asserting
# on Sidekiq queue contents then see another worker's jobs. Cap unless asked.
worker_args = ARGV.grep(/\A-n/).any? ? [] : ["-n", [Etc.nprocessors, 8].min.to_s]

# Pass all arguments to turbo_tests
exec "bundle", "exec", "turbo_tests", *worker_args, *ARGV
