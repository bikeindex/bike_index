#!/usr/bin/env bash

if [ -n "$1" ]; then
  export TRANSLATION_IO_API_KEY="$1"
fi

set -e

CYAN="\033[0;36m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
GREEN="\033[0;32m"
NONE="\033[0m"

output() {
  printf "\n${1}${2}${NONE}\n\n"
}

# Only alias git on macOS (local dev); CI has git on a different path
if [ -z "$CI" ] && [ -f /usr/local/bin/git ]; then
  alias git=/usr/local/bin/git
fi

output "${CYAN}" "Checking Translations"

# The job runs as root over a workspace the runner owns, so git refuses to read the
# repo at all without this. Only under $CI — locally it would write ~/.gitconfig.
if [ -n "$CI" ]; then
  git config --global --add safe.directory "$PWD"
  git config user.name "github-actions[bot]"
  git config user.email "github-actions[bot]@users.noreply.github.com"
fi

# Assigned rather than tested inline, so a git that can't answer aborts under `set -e`
# instead of reading as "some other branch" and skipping green
current_branch="$(git rev-parse --abbrev-ref HEAD)"

sync_branch_prefix="translations-sync-"
sync_commit_message="translations sync"

# A sync branch is checked too, rather than skipping green: translation.io gains
# translations while its PR sits open
case "$current_branch" in
  "$TRANSLATION_BRANCH" | "$sync_branch_prefix"*) ;;
  *)
    output "${GREEN}" "Skipping: on ${current_branch}, neither TRANSLATION_BRANCH (${TRANSLATION_BRANCH}) nor a ${sync_branch_prefix} branch"
    exit 0
    ;;
esac

# A sync branch forked from an older main, so its purge would drop every key main
# gained since — and push that deletion onto the PR and translation.io
if [ "$current_branch" != "$TRANSLATION_BRANCH" ]; then
  # The CI checkout is depth 1, which leaves the merge no base to find
  if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
    git fetch --unshallow origin "$TRANSLATION_BRANCH"
  else
    git fetch origin "$TRANSLATION_BRANCH"
  fi
  # Assigned before the merge: a merge with nothing to do leaves no ORIG_HEAD
  pre_merge_head="$(git rev-parse HEAD)"
  # Conflicts can only be in config/locales, which the sync rewrites wholesale
  git merge --no-edit -X ours FETCH_HEAD
  # Gems are baked into the image from this branch's lockfile, and its final stage
  # carries no compiler for a bump the merge just brought in — so the sync, which
  # reads translation keys rather than gems, runs against what's installed
  git show "$pre_merge_head:Gemfile" > Gemfile
  git show "$pre_merge_head:Gemfile.lock" > Gemfile.lock
fi

echo bundle exec rake translation:sync_and_purge prepare_translations
bundle exec rake translation:sync_and_purge prepare_translations

# Back to the merged pair, so the diff below reads as translations alone
git checkout HEAD -- Gemfile Gemfile.lock

output "${YELLOW}" "Stashing translation.io timestamp file"
set -x
git stash -- config/locales/.translation_io
git status --short
# Reset the migrations, in case of postgres artifacts changing things
git checkout HEAD db/
set +x

if [[ -z "$(git --no-pager diff)" ]]; then
  output "${GREEN}" "No uncommitted translations. Done."
  exit 0
else
  output "${RED}" "Uncommitted Translations"
  git --no-pager diff

  if [ -n "$CI" ]; then
    # Sync branches carry a timestamp, so `gh pr list --head` can't be used — it
    # wants an exact branch name.
    # Deliberately not failure-tolerant: a swallowed error reads as "no open sync
    # PR" and opens a duplicate.
    open_sync_pr=$(gh pr list --state open --limit 100 --json number,headRefName \
      --jq "map(select(.headRefName | startswith(\"$sync_branch_prefix\")))[0] | select(.) | \"\(.number) \(.headRefName)\"")
    read -r open_pr_number open_pr_branch <<<"$open_sync_pr"

    if [ "$current_branch" = "$open_pr_branch" ]; then
      output "${YELLOW}" "On CI — re-syncing sync PR #${open_pr_number}"
      push_branch="$current_branch"
    elif [ "$current_branch" != "$TRANSLATION_BRANCH" ]; then
      output "${RED}" "No open sync PR for ${current_branch} — leaving the branch alone"
      exit 1
    elif [ -n "$open_pr_branch" ]; then
      output "${YELLOW}" "On CI — adding these translations to open sync PR #${open_pr_number}"
      push_branch="$open_pr_branch"
    else
      output "${YELLOW}" "On CI — creating translation sync PR"
      push_branch="${sync_branch_prefix}$(date +%Y%m%d%H%M%S)"
      # Sha too: main has moved on by the time anyone reads the PR
      pr_body="Created from ${TRANSLATION_BRANCH} at $(git rev-parse HEAD) ($(git log -1 --format=%s))"
    fi

    git stash pop || true
    git add config/locales/
    git commit -m "$sync_commit_message"

    if [ -n "$open_pr_branch" ] && [ "$open_pr_branch" != "$current_branch" ]; then
      # The PR's branch forked from an older main, so the sync is re-applied onto its
      # tip rather than pushed from here — the push has to fast-forward, and the
      # locales as this run just synced them are what the PR should carry
      synced_locales="$(git rev-parse HEAD)"
      git fetch origin "$push_branch"
      git checkout -B "$push_branch" FETCH_HEAD
      git checkout "$synced_locales" -- config/locales/

      # The timestamp file moves on every sync, so it can't speak to whether
      # translation.io returned anything the PR doesn't already have
      if git diff --cached --quiet -- config/locales ":(exclude)config/locales/.translation_io"; then
        output "${YELLOW}" "#${open_pr_number} already carries these translations — merge it"
        exit 1
      fi
      git commit -m "$sync_commit_message"
    fi

    # In CI the checkout persists the App token as git creds, so this pushes as
    # the App — a non-default-token push is what fires `on: push` and gives the
    # PR its required checks. A default-token push triggers no workflows at all.
    git push origin "HEAD:${push_branch}"

    if [ -z "$open_pr_branch" ]; then
      gh pr create \
        --title "Automated translations sync from CI" \
        --body "$pr_body" \
        --base main \
        --head "$push_branch"

      output "${YELLOW}" "PR created with CI running. Build will fail until the PR is merged."
    else
      output "${YELLOW}" "Pushed onto #${open_pr_number}. That push's own run re-checks it."
    fi
  fi

  exit 1
fi
