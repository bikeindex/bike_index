<div
  data-controller="search--kind-select-fields"
  data-search--kind-select-fields-api-count-url-value="<%= api_count_url %>"
  data-search--kind-select-fields-option-kinds-value="<%= option_kind.to_s %>"
>
  <div
    class="tw:mt-5 tw:ml-auto tw:flex tw:w-full tw:flex-wrap tw:sm:mt-2 tw:sm:w-min tw:sm:flex-nowrap <%= location_initially_shown? ? '' : 'tw:hidden' %>"
    data-search--kind-select-fields-target="locationWrap"
  >
    <span class="tw:flex tw:flex-nowrap">
      <span class="tw:mr-2 tw:block tw:py-1.5">
        <%= translation(".within") %>
      </span>

      <%= label_tag :distance,
      translation(".search_distance"),
      class: "twlabel tw:sr-only" %>

      <%= number_field_tag :distance,
      @distance,
      :placeholder => default_distance,
      :min => GeocodeHelper::MIN_DISTANCE,
      :class => "twinput tw:mr-2 tw:min-w-20 fieldResetsCounts",
      "data-search--kind-select-fields-target" => "distance" %>
    </span>

    <span class="tw:mt-3 tw:flex tw:flex-nowrap tw:sm:mt-0">
      <span class="tw:mr-2 tw:block tw:py-1.5 tw:text-nowrap">
        <%= translation(".miles_of") %>
      </span>

      <%= label_tag :location,
      translation(".search_location"),
      class: "twlabel tw:sr-only" %>

      <%= text_field_tag :location,
      @location,
      :placeholder => translation(".search_location"),
      :class => "twinput tw:min-w-50 fieldResetsCounts",
      "data-search--kind-select-fields-target" => "location" %>
    </span>
  </div>

  <div class="tw:mt-6 tw:flex tw:flex-wrap tw:gap-2">
    <%= render UI::Forms::RadioButtonGroup::Component.new(
      name: option_kind,
      selected: @kind_scope,
      entries: radio_entries,
      data: {action: "change->search--kind-select-fields#updateLocationVisibility"},
    ) %>

    <% unless @is_marketplace %>
      <%= render UI::ButtonGroup::Component.new(entries: [marketplace_link_entry]) %>
    <% end %>
  </div>
</div>
