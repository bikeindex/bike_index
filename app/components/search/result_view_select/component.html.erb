<ul class="tw:mt-2 tw:flex tw:flex-row-reverse tw:gap-4">
  <% view_options.each do |view, icon, title| %>
    <li>
      <%= label_tag "search_result_view_#{view}", title:, class: label_classes do %>
        <%= helpers.inline_svg_tag icon, class: "tw:block tw:w-6 tw:h-6 tw:cursor-pointer" %>

        <span class="tw:sr-only"><%= title %></span>

        <%# The result component is chosen server-side, so switching layout re-runs the search %>
        <%= radio_button_tag(:search_result_view, view, selected?(view),
          class: "tw:sr-only", data: {action: "change->search--form#submit"}) %>
      <% end %>
    </li>
  <% end %>
</ul>
