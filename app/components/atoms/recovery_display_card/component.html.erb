<% photo_classes = "tw:h-45 tw:w-full tw:bg-gray-100 tw:object-cover tw:lg:h-42 tw:dark:bg-gray-700" %>

<li
  class="
    tw:flex-col tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:dark:border-gray-700 tw:dark:bg-gray-800
    <%= @html_class %>
  "
>
  <% if @recovery_display.photo_url.present? %>
    <%= image_tag(@recovery_display.photo_url, alt: @recovery_display.image_alt,
      class: photo_classes, loading: "lazy") %>
  <% else %>
    <div class="<%= photo_classes %>"></div>
  <% end %>

  <%= tag.div(class: "tw:flex tw:flex-1 tw:flex-col tw:justify-between tw:gap-3 tw:p-3 tw:lg:p-4",
    data: {controller: "atoms--recovery-display-card", atoms__recovery_display_card_locale_value: I18n.locale}) do %>
    <blockquote
      class="
        tw:m-0 tw:border-0 tw:p-0 tw:text-[15px] tw:text-gray-700
        tw:dark:text-gray-200
      "
      data-atoms--recovery-display-card-target="quote"
    >
      <%= @recovery_display.quote %>
    </blockquote>

    <div class="tw:flex tw:flex-col tw:gap-2">
      <p class="tw:m-0 tw:text-[11.5px] tw:text-gray-500 tw:dark:text-gray-400">
        <% if @recovery_display.quote_by.present? %>
          <strong
            class="
              tw:mr-1 tw:text-[13.5px] tw:font-extrabold tw:text-slate-900
              tw:dark:text-gray-100
            "
          >
            <%= @recovery_display.quote_by %>
          </strong>
        <% end %>

        <%= translation(".recovered") %>
        <%= render(UI::Time::Component.new(time: @recovery_display.recovered_at)) %>

        <span data-atoms--recovery-display-card-target="credit" hidden>
          <%= translation(".translated_from_english") %>
        </span>
      </p>

      <% if @recovery_display.link.present? %>
        <%= link_to link_label, @recovery_display.link, target: "_blank", rel: "noopener", title: @recovery_display.link, class: "twlink tw:block tw:truncate tw:text-sm" %>
      <% end %>
    </div>
  <% end %>
</li>
