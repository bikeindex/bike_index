<div class="tw:mt-8 tw:mb-4 tw:grid tw:gap-x-8 tw:md:grid-cols-12">
  <% unless @skip_total %>
    <div class="tw:md:col-span-5">
      <p class="tw:mb-2 tw:md:mb-0">
        <strong><%= number_with_delimiter(count) %></strong> Matching
        <%= viewing.pluralize(count) %>


        <% if show_time_range? %>
          <em>
            <% if @time_range_column.present? %>
              <strong><%= UI::PeriodSelect::Component.column_label(@time_range_column) %></strong>
            <% end %>

            <%= render(UI::TimeRange::Component.new(time_range: @index.time_range, period: @index.period)) %>
          </em>
        <% elsif show_today_count? %>
          <em class="less-strong">
            (<%= number_with_delimiter(today_count) %> today)
          </em>
        <% end %>

        <% if @count_detail.present? %>
          <span class="less-strong"><%= @count_detail %></span>
        <% end %>
      </p>
    </div>
  <% end %>

  <% if @index.pagy.present? %>
    <div class="tw:flex tw:flex-wrap tw:justify-end tw:gap-4 tw:md:text-right tw:lg:flex-nowrap <%= (@skip_total ? "tw:md:col-span-12" : "tw:md:col-span-7") %>">
      <%= render(UI::Pagination::Component.new(pagy: @index.pagy, page_params: @index.params)) %>

      <%= select_tag :per_page_select, options_for_select(per_pages.map { |i| ["#{i} / page", i] }, selected: @index.per_page), id: nil, class: "twinput tw:inline-block", style: "margin-top: -6px; max-width: 8rem;", data: {controller: "admin--per-page-select", action: "admin--per-page-select#navigate"} %>
    </div>
  <% end %>
</div>
