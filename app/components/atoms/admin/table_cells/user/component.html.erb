<span class="tw:inline-flex tw:items-baseline tw:gap-x-2">
  <% if show_missing_user? %>
    <small class="<%= error_text_class %>" title="<%= @user_id %>">
      Missing user
    </small>
    <% if show_email_for_missing_user? %>
      <%= render(UI::Code::Inline::Component.new(text: @user_id, small: true)) %>
    <% end %>
  <% end %>

  <% if show_user_link? %>
    <%= link_to email_display, user_link_path, title: @email, class: "twlink-underlined" %>
  <% elsif show_email_only? %>
    <span title="<%= @email %>"><%= email_display %></span>
  <% end %>

  <% if deleted_user? %>
    <small class="<%= error_text_class %>">user deleted</small>
  <% end %>

  <%= render(Atoms::Admin::Badges::User::Component.new(user: @user)) %>

  <% if show_search? %>
    <%= link_to search_emoji, computed_search_url, class: "display-sortable-link tw:text-xs" %>
  <% end %>
</span>
