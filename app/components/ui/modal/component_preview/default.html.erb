<div class="tw:space-y-8">
  <%= render(UI::Button::Component.new(text: "Open Settings", commandfor: "settings-modal", command: "show-modal")) %>

  <%= render(UI::Button::Component.new(text: "Open Confirmation", commandfor: "confirm-modal", command: "show-modal")) %>

  <%= render(UI::Button::Component.new(text: "Open Long", commandfor: "long-modal", command: "show-modal")) %>
</div>

<%= render(UI::Modal::Component.new(title: "Settings", id: "settings-modal")) do |modal| %>
  <% modal.with_body do %>
    Modal body content
  <% end %>
<% end %>

<%= render(UI::Modal::Component.new(title: "Confirmation", id: "confirm-modal")) do |modal| %>
  <% modal.with_body do %>
    <p class="tw:mb-4">
      Are you sure you want to proceed?
    </p>

    <%= render(UI::Button::Component.new(text: "Confirm", color: :primary, data: { action: "click->ui--modal#close" })) %>
  <% end %>
<% end %>

