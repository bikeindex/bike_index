<% @items.each_with_index do |(question, answer), index| %>
  <div
    class="tw:border-b tw:border-gray-200 tw:py-4 tw:dark:border-gray-700"
    data-controller="ui--collapse"
  >
    <%= render(UI::Collapse::Component.new(chevron: true, color: :link,
      html_class: "tw:w-full tw:gap-2 tw:text-[17.5px] tw:font-bold tw:twtext-color")) do %>
      <span class="tw:flex-1 tw:text-left"><%= question %></span>
    <% end %>

    <div
      data-ui--collapse-target="content"
      class="<%= "tw:hidden" unless index.zero? %>"
    >
      <p class="tw:m-0 tw:mt-2.5 tw:pr-11 tw:text-base tw:leading-relaxed">
        <%= answer %>
      </p>
    </div>
  </div>
<% end %>
