<% @items.each_with_index do |(question, answer), index| %>
  <div class="<%= @item_classes %>" data-controller="ui--collapse">
    <%= render(UI::Collapse::Component.new(chevron: true, color: :link, html_class: @trigger_classes)) do %>
      <span class="tw:flex-1 tw:text-left"><%= question %></span>
    <% end %>

    <div
      data-ui--collapse-target="content"
      class="<%= "tw:hidden" unless index.zero? %>"
    >
      <p class="<%= @answer_classes %>">
        <%= answer %>
      </p>
    </div>
  </div>
<% end %>
