<div
  class="twgutter-bleed tw:mb-4 tw:overflow-x-scroll tw:pb-3"
  data-controller="ui--table"
  data-ui--table-sticky-value="<%= @sticky %>"
>
  <table class="<%= table_classes %>">
    <thead class="tw:bg-gray-50 tw:text-sm tw:dark:bg-gray-700">
      <tr>
        <% @columns.each do |col| %>
          <th class="<%= [col.th_classes(bordered: @bordered, sortable_table:), sticky_th_classes].compact.join(" ") %>">
            <%= col.render_header(render_sortable: @render_sortable, current_sort:, current_direction:, sortable_url: method(:sortable_url), sort_icon: ->(direction) { render(UI::IconSorting::Component.new(direction:)) }) %>

            <% if col.header_tooltip %>
              <%= render(UI::Tooltip::Component.new(text: col.header_tooltip)) %>
            <% end %>
          </th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% @records.each do |record| %>
        <% cache_if(@cache_key, [@cache_key, record, *cache_records_for(record)]) do %>
          <tr>
            <% @columns.each do |col| %>
              <td class="<%= col.td_classes(bordered: @bordered) %>">
                <%= col.render_cell(record) { |r| capture { instance_exec(r, &col.cell_block) } } %>
              </td>
            <% end %>
          </tr>
        <% end %>
      <% end %>
    </tbody>

    <% if footer? %>
      <tfoot>
        <tr>
          <% @columns.each do |col| %>
            <td class="<%= col.tfoot_classes(bordered: @bordered) %>">
              <%= col.footer %>
            </td>
          <% end %>
        </tr>
      </tfoot>
    <% end %>
  </table>
</div>
