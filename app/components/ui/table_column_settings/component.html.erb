<%= tag.div(class: [("tw:hidden!" unless @field_name), "tw:border-b tw:border-gray-100 tw:bg-gray-50 tw:px-5 tw:py-5 tw:dark:border-gray-700 tw:dark:bg-gray-900"],
  data: panel_data) do %>
  <div class="tw:mb-5 tw:flex tw:flex-wrap tw:items-baseline tw:gap-x-3 tw:gap-y-2">
    <%= render(UI::Header::Component.new(text: @field_name ? translation(".included_columns") : translation(".visible_columns"),
      tag: :h3, html_class: "uncap tw:mb-0! tw:pr-1")) %>

    <%= render(UI::Button::Component.new(text: translation(".all"), color: :link, data: {action: "ui--table-column-settings#selectAll"})) %>
    <%= render(UI::Button::Component.new(text: translation(".none"), color: :link, data: {action: "ui--table-column-settings#selectNone"})) %>
    <%= render(UI::Button::Component.new(text: translation(".default"), color: :link, data: {action: "ui--table-column-settings#selectDefault"})) %>
  </div>

  <div
    class="
      tw:grid tw:grid-cols-2 tw:gap-x-7 tw:gap-y-2.5 tw:md:grid-flow-col
      tw:md:grid-cols-3
    "
    style="grid-template-rows: repeat(<%= column_rows %>, auto)"
  >
    <% @columns.each do |key, label| %>
      <%# Unchecked columns read quieter than the ones showing %>
      <%= render(UI::Forms::Checkbox::Component.new(name: @field_name || key, value: key,
        checked: @always_visible.include?(key) || @checked.include?(key), label: checkbox_label(key, label),
        class_name: "tw:mb-0! tw:leading-[1.25]! tw:text-gray-400 tw:has-checked:text-gray-900 tw:dark:has-checked:text-gray-100",
        html_options: checkbox_html_options(key))) %>
    <% end %>
  </div>

  <% unless @field_name %>
    <%#
      Shown by a ui--table-column-order while the columns are out of their default order. Spaced by
      the div inside, as the collapse animates this one's height
    %>
    <div class="tw:hidden!" data-ui--table-column-order-target="reset">
      <div class="tw:pt-5">
        <%= render(UI::Button::Component.new(text: translation(".return_to_default_order"), color: :link,
          data: {action: "ui--table-column-order#reset"})) %>
      </div>
    </div>
  <% end %>
<% end %>
