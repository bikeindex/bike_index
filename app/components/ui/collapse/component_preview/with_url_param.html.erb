<div data-controller="collapse" data-collapse-param-value="details">
  <button
    type="button"
    data-action="collapse#toggle"
    data-collapse-target="trigger"
    aria-expanded="false"
    class="twlink tw:flex tw:items-center tw:gap-2"
  >
    <span data-collapse-target="chevron" class="tw:inline-block tw:transition-transform tw:duration-200"><span class="tw:flex"><%= render UI::IconChevron::Component.new %></span></span>
    Toggle details
  </button>

  <div data-collapse-target="content" class="tw:mt-2 tw:hidden">
    <p class="tw:mb-0">
      Persisted panel body — open state lives in the <code>?details=1</code> URL
      param.
    </p>
  </div>
</div>
