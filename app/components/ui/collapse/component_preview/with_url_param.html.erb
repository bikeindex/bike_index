<div data-controller="ui--collapse" data-ui--collapse-param-value="details">
  <button
    type="button"
    data-action="ui--collapse#toggle"
    data-ui--collapse-target="trigger"
    aria-expanded="false"
    class="twlink tw:flex tw:items-center tw:gap-2"
  >
    <span data-ui--collapse-target="chevron" class="tw:inline-block tw:transition-transform tw:duration-200"><span class="tw:flex"><%= render UI::IconChevron::Component.new %></span></span>
    Toggle details
  </button>

  <div data-ui--collapse-target="content" class="tw:mt-2 tw:hidden">
    <p
      class="
        tw:mb-0 tw:flex tw:h-64 tw:items-center tw:justify-center
        tw:rounded-lg tw:bg-gray-100 tw:text-center tw:dark:bg-gray-800
      "
    >
      Persisted panel body — open state lives in the <code>?details=1</code> URL
      param.
    </p>

    <label class="tw:flex tw:items-center tw:gap-2">
      <%= check_box_tag :panel_checkbox, "1", false %> Panel checkbox
    </label>
  </div>

  <%# Tall enough that the opening panel reaches over it - what the spec's clipping check reads %>
  <div
    id="below"
    class="
      tw:mt-2 tw:flex tw:h-96 tw:items-center tw:justify-center
      tw:rounded-lg tw:border tw:border-dashed tw:border-gray-300
      tw:text-gray-500 tw:dark:border-gray-700
    "
  >
    Content the panel pushes down as it opens
  </div>
</div>
