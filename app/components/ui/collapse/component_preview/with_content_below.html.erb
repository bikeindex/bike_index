<div data-controller="ui--collapse">
  <button
    type="button"
    data-action="ui--collapse#toggle"
    data-ui--collapse-target="trigger"
    aria-expanded="false"
    class="twlink"
  >
    Toggle panel
  </button>

  <div data-ui--collapse-target="content" class="tw:hidden!">
    <div class="tw:h-64">Tall panel body</div>

    <label class="tw:flex tw:items-center tw:gap-2">
      <%= check_box_tag :panel_checkbox, "1", false %> Panel checkbox
    </label>
  </div>

  <div id="below" class="tw:h-96">
    Content the panel pushes down as it opens
  </div>
</div>
