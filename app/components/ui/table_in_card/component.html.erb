<% table_html = tag.div(class: WRAPPER_CLASSES, data: wrapper_data) do %>
  <%= render(UI::Table::Component.new(**@table_options, classes: TABLE_CLASSES, unbordered: true)) do |table| %>
    <% @columns.each_with_index do |(options, block), index| %>
      <% table.column(**column_options(options, index), &block) %>
    <% end %>
  <% end %>
<% end %>

<% if @column_settings %>
  <%# table-bleed reads the twwiderow container and data-table-bleed %>
  <div class="twwiderow tw:mb-4" data-table-bleed="false">
    <%= card do %>
      <%# Full bleed drops the card's gutter, so the header meets the page's %>
      <div
        class="
          tw:flex tw:flex-wrap tw:items-center tw:justify-end tw:gap-x-4
          tw:gap-y-2 tw:px-4 tw:py-3 tw:table-bleed:px-0
        "
      >
        <% if description? %>
          <p class="tw:m-0 tw:text-xs tw:text-gray-500"><%= description %></p>
        <% end %>

        <div class="tw:ml-auto tw:flex tw:flex-wrap tw:items-center tw:gap-2">
          <% if actions? %>
            <div class="tw:flex tw:flex-wrap tw:items-end tw:gap-2">
              <%= actions %>
            </div>
          <% end %>

          <%= render(UI::Collapse::Component.new(text: "Column settings", chevron: :trailing, size: :sm)) %>
        </div>
      </div>

      <%# Full bleed runs past the card and its border, so the table draws the line under itself %>
      <div class="tw:table-bleed:mx-[calc(var(--gutter)*-1)]">
        <%= render(UI::TableColumnSettings::Component.new(**@column_settings.except(:storage_key), orderable: true)) %>

        <%# Otherwise it's rounded to the card's rounded-xl inside its border, or the cells square the corners off %>
        <div
          class="
            tw:overflow-hidden tw:rounded-b-[11px] tw:border-gray-200
            tw:dark:border-gray-700 tw:table-bleed:rounded-b-none
            tw:table-bleed:border-b
          "
        >
          <%= table_html %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <%= table_html %>
<% end %>
