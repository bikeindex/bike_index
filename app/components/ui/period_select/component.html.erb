<div data-controller="ui--collapse ui--period-select">
  <div class="<%= row_classes %>" role="group">
    <% if @prepend_text.present? %>
      <span class="mr-2 less-strong"><%= @prepend_text %></span>
    <% end %>

    <% visible_periods.each do |p| %>
      <%= @form ? period_radio(p) : render(period_button(p)) %>
    <% end %>

    <%= render(custom_button) %>

    <%#
      None of the chips is the custom range, so a search would drop it otherwise. It
      renders after them, so it outranks a picked chip until ui--period-select disables it
    %>

    <% if @form && @period == "custom" %>
      <%= hidden_field_tag :period, "custom", form: @form, data: {"ui--period-select-target": "customPeriod"} %>
    <% end %>
  </div>

  <%= form_with(
    url: "#",
    method: :get,
    builder: BikeIndexFormBuilder,
    html: {class: custom_form_classes, data: {"ui--collapse-target": "content", action: "submit->ui--period-select#submit"}}
  ) do |f| %>
    <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-3">
      <div class="tw:flex tw:items-center tw:gap-2">
        <%= f.label :start_time_selector, translation(".from"), class: "twlabel tw:m-0" %>

        <%= render UI::Forms::Input::Component.new(
          form_builder: f,
          attribute: :start_time_selector,
          kind: :datetime_local_field,
          html_options: {value: @start_time.strftime(INPUT_TIME_FORMAT), step: 60,
                         data: {"ui--period-select-target": "startTime"}}
        ) %>
      </div>

      <div class="tw:flex tw:items-center tw:gap-2">
        <%= f.label :end_time_selector, translation(".to"), class: "twlabel tw:m-0" %>

        <%= render UI::Forms::Input::Component.new(
          form_builder: f,
          attribute: :end_time_selector,
          kind: :datetime_local_field,
          html_options: {value: @end_time.strftime(INPUT_TIME_FORMAT), step: 60,
                         data: {"ui--period-select-target": "endTime"}}
        ) %>
      </div>

      <%= render UI::Button::Component.new(
        text: translation(".update"),
        color: :primary,
        size: :sm,
        type: "submit"
      ) %>
    </div>
  <% end %>
</div>
