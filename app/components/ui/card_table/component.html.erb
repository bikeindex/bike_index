<% table_html = tag.div(class: WRAPPER_CLASSES, data: wrapper_data) do %>
  <%= render(UI::Table::Component.new(**@table_options, classes: TABLE_CLASSES, unbordered: true)) do |table| %>
    <% @columns.each_with_index do |(options, block), index| %>
      <% table.column(**column_options(options, index), &block) %>
    <% end %>
  <% end %>
<% end %>

<% if @column_settings %>
  <% bulk_actions = tag.div(actions, class: "tw:flex tw:flex-wrap tw:items-center tw:gap-2") if actions? %>

  <%# twfullbleed reads the twwiderow container %>
  <div class="twwiderow tw:mb-4">
    <%= card do %>
      <%# Full bleed drops the card's gutter, so the header meets the page's %>
      <div
        class="
          tw:flex tw:flex-wrap tw:items-center tw:justify-end tw:gap-x-4
          tw:gap-y-2 tw:py-3 tw:@min-[672px]/twwiderow:px-4
        "
      >
        <% if description? %>
          <div class="tw:text-xs tw:text-gray-500"><%= description %></div>
        <% end %>

        <div class="tw:ml-auto tw:flex tw:flex-wrap tw:items-center tw:gap-2">
          <% if actions? %>
            <%# The footer's copy is the one a phone reaches after checking rows %>
            <div class="tw:hidden tw:sm:block"><%= bulk_actions %></div>
          <% end %>

          <%= render(UI::Collapse::Component.new(text: "Column settings", chevron: :trailing, size: :sm)) %>
        </div>
      </div>

      <%= render(UI::TableColumnSettings::Component.new(**@column_settings.except(:storage_key), orderable: true)) %>

      <%# Full bleed takes the table over the admin gutter, past the card, so it's clipped here %>
      <div
        class="
          tw:overflow-hidden
          tw:@max-[672px]/twwiderow:mx-[calc(var(--gutter)*-1)]
        "
      >
        <%= table_html %>
      </div>

      <% if actions? %>
        <div
          class="
            tw:border-t tw:border-gray-100 tw:px-4 tw:py-3
            tw:dark:border-gray-700
          "
        >
          <%= bulk_actions %>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= table_html %>
<% end %>
