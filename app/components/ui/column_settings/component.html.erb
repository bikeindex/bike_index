<div
  class="
    tw:hidden! tw:border-b tw:border-gray-100 tw:bg-gray-50 tw:px-5 tw:py-5
    tw:dark:border-gray-700 tw:dark:bg-gray-900
  "
  data-ui--collapse-target="content"
>
  <div class="tw:mb-5 tw:flex tw:flex-wrap tw:items-baseline tw:gap-x-3 tw:gap-y-2">
    <%= render(UI::Header::Component.new(text: translation(".visible_columns"), tag: :h3, html_class: "uncap tw:mb-0! tw:pr-1")) %>
    <%= render(UI::Button::Component.new(text: translation(".all"), color: :link, data: {action: "ui--column-settings#selectAll"})) %>
    <%= render(UI::Button::Component.new(text: translation(".none"), color: :link, data: {action: "ui--column-settings#selectNone"})) %>
    <%= render(UI::Button::Component.new(text: translation(".default"), color: :link, data: {action: "ui--column-settings#selectDefault"})) %>
  </div>

  <div
    class="
      tw:grid tw:grid-cols-2 tw:gap-x-7 tw:gap-y-2.5 tw:md:grid-flow-col
      tw:md:grid-cols-3
    "
    style="grid-template-rows: repeat(<%= column_rows %>, auto)"
  >
    <% @columns.each do |cell_name, label| %>
      <%= render(UI::Forms::Checkbox::Component.new(name: cell_name, value: cell_name, label:,
        class_name: "tw:mb-0! tw:leading-[1.25]! tw:text-gray-400 tw:has-checked:text-gray-900 tw:dark:has-checked:text-gray-100",
        html_options: {id: "column_settings_#{cell_name}", class: "tw:accent-blue-600",
                       data: {"ui--column-settings-target": "checkbox", action: "ui--column-settings#update",
                              default: @defaults.include?(cell_name), narrow_hidden: @narrow_hidden.include?(cell_name)}})) %>
    <% end %>
  </div>
</div>
