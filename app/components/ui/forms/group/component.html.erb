<div class="<%= @wrapper_class %>">
  <%= label_markup %>

  <% unless @kind == :content_block %>
    <%= render(UI::Forms::Input::Component.new(form_builder: @form_builder, attribute: @attribute, kind: @kind, required: required?, html_options: @html_options)) %>
  <% end %>

  <%= content if content? %>
</div>
