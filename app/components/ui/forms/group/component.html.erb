<div class="<%= @wrapper_class %>">
  <% if @kind == :check_box %>
    <%= @form_builder.label @attribute,
      @form_builder.check_box(@attribute, {class: "tw:cursor-pointer"}.merge(@html_options)) +
        tag.span(@label_text),
      class: "twlabel tw:inline-flex tw:cursor-pointer tw:items-center tw:gap-2" %>
  <% else %>
    <%= @form_builder.label @attribute, label_content, class: "twlabel" %>
    <% unless @kind == :content_block %>
      <%= render(UI::Forms::Input::Component.new(form_builder: @form_builder, attribute: @attribute, kind: @kind, choices: @choices, select_options: @select_options, html_options: input_html_options)) %>
    <% end %>
    <%= content if content? %>
  <% end %>
</div>
