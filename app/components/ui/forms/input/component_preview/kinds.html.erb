<%= form_with(url: "#", builder: BikeIndexFormBuilder) do |f| %>
  <div class="tw:mb-4">
    <%= f.label :name, class: "twlabel" %>
    <%= render(UI::Forms::Input::Component.new(form_builder: f, attribute: :name, html_options: {placeholder: "Your name"})) %>
  </div>

  <div class="tw:mb-4">
    <%= f.label :description, class: "twlabel" %>
    <%= render(UI::Forms::Input::Component.new(form_builder: f, attribute: :description, kind: :text_area, html_options: {placeholder: "Write something...", rows: 4})) %>
  </div>

  <div class="tw:mb-4">
    <%= f.label :start_time, class: "twlabel" %>
    <%= render(UI::Forms::Input::Component.new(form_builder: f, attribute: :start_time, kind: :datetime_local_field, html_options: {step: 60})) %>
  </div>
<% end %>
