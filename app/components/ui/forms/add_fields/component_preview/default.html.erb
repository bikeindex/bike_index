<% location_fields = ->(builder) { render("ui/forms/add_fields/component_preview/location_fields", f: builder) } %>

<%= form_with(model: organization, url: "#", builder: BikeIndexFormBuilder) do |f| %>
  <%= f.fields_for(:locations, &location_fields) %>

  <%= render(UI::Forms::AddFields::Component.new(name: "Add a location", form_builder: f, association: :locations, fields: location_fields, class_name: "twlink")) %>
<% end %>
