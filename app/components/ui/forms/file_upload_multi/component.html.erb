<%# drop is bound to the root, not the frame, so dropping on the list or the button works too. %>
<div
  data-controller="ui--forms--file-upload-multi"
  data-ui--forms--file-upload-multi-url-value="<%= @url %>"
  data-ui--forms--file-upload-multi-params-value="<%= @params.to_json %>"
  data-ui--forms--file-upload-multi-file-param-value="<%= @file_param %>"
  data-ui--forms--file-upload-multi-uploading-value="<%= translation(".uploading") %>"
  data-ui--forms--file-upload-multi-failed-value="<%= translation(".upload_failed") %>"
  data-action="drop->ui--forms--file-upload-multi#drop dragover@document->ui--forms--file-upload-multi#dragOver dragleave@document->ui--forms--file-upload-multi#endDrag drop@document->ui--forms--file-upload-multi#endDrag"
>
  <%= tag.ul(content, **@list_html_options.deep_merge(data: {"ui--forms--file-upload-multi-target": "list"})) %>

  <%#
    data-over rather than is-active, which also matches :active and would flash the frame
    whenever the button inside it is pressed.
  %>

  <div
    class="
      tw:my-2 tw:rounded-lg tw:p-2 tw:outline-2 tw:outline-offset-2
      tw:outline-transparent tw:transition-colors tw:outline-dashed
      tw:data-[dragging=true]:outline-gray-300
      tw:data-[over=true]:bg-blue-50 tw:data-[over=true]:outline-blue-500
      tw:dark:data-[dragging=true]:outline-gray-600
      tw:dark:data-[over=true]:bg-blue-950
    "
    data-ui--forms--file-upload-multi-target="dropZone"
    data-action="dragenter->ui--forms--file-upload-multi#highlightDropZone dragleave->ui--forms--file-upload-multi#unhighlightDropZone"
  >
    <div class="tw:inline-flex tw:flex-wrap tw:items-center tw:gap-3">
      <%#
        sr-only keeps the input focusable and in the accessibility tree; the label is the visible
        button. It carries no name -- nothing submits it, the controller posts its files itself.
      %>

      <%= tag.input(type: "file", id: @input_id, multiple: true, accept: @accept,
            class: "tw:peer tw:sr-only",
            data: {"ui--forms--file-upload-multi-target": "input", action: "ui--forms--file-upload-multi#upload"}) %>

      <%= label_tag(@input_id, label_content, class: @label_classes) %>

      <span class="tw:text-gray-500 tw:dark:text-gray-400"><%= translation(".or_drag_and_drop") %></span>
    </div>

    <ul
      class="tw:mt-2"
      aria-live="polite"
      data-ui--forms--file-upload-multi-target="status"
    ></ul>
  </div>
</div>
