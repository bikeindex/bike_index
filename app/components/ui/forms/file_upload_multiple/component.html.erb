<%= render(UI::Forms::FilePicker::Component.new(input_options: @input_options, accept: @accept, camera: @camera, url: @url, data: @data)) do |picker| %>
  <% picker.with_attached do %>
    <%= tag.ul(content, **@list_html_options.deep_merge(data: {"ui--forms--file-upload-target": "list"})) %>
  <% end %>

  <% picker.with_status do %>
    <%# a row per file uploading, which its markup in the list replaces %>
    <ul
      class="tw:mt-2"
      aria-live="polite"
      data-ui--forms--file-upload-target="status"
    ></ul>
  <% end %>
<% end %>
