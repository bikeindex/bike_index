<div
  class="tw:mb-4 tw:rounded tw:border tw:border-gray-200 tw:p-3 <%= UI::Forms::NestedFields::Component::WRAPPER_CLASS %>"
  data-new-record="<%= @form_builder.object.new_record? %>"
>
  <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :name, label_text: "Location name")) %>

  <%= @form_builder.hidden_field :_destroy %>
  <%= render(UI::Button::Component.new(text: "Remove", color: :error, data: {action: "click->#{UI::Forms::NestedFields::Component::CONTROLLER}#remove"})) %>
</div>
