<%= tag.div(class: @class_name, data: controller_data) do %>
  <%= saved_fields %>

  <%= tag.template(blank_fields, data: target_data("template")) %>

  <%# Added records go in ahead of this, so they stay above the add button %>
  <%= tag.span(nil, data: target_data("target")) %>

  <%= render(UI::Button::Component.new(text: @add_label, color: :link, html_class: @add_class_name, data: add_button_data)) %>
<% end %>
