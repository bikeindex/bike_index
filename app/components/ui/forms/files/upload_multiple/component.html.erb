<%= render(UI::Forms::Files::Picker::Component.new(input_options: @input_options, accept: @accept, url: @url, data: @data)) do |picker| %>
  <% picker.with_attached do %>
    <%= tag.ul(content, **@list_html_options.deep_merge(data: {"ui--forms--files--picker-target": "list"})) %>
  <% end %>

  <% picker.with_status do %>
    <ul
      class="tw:mt-2"
      aria-live="polite"
      data-ui--forms--files--picker-target="status"
    ></ul>
  <% end %>
<% end %>
