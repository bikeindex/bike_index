<%# Option tags from a collection, addressing value and text by method name %>
<%= form_with(url: "#", builder: BikeIndexFormBuilder) do |f| %>
  <%= render(UI::Forms::Select::Component.new(form_builder: f, attribute: :primary_frame_color_id,
    option_tags: options_from_collection_for_select(Color.all, :id, :name, Color.find_by(name: "Blue")&.id),
    options: {include_blank: "Choose a color"})) %>
<% end %>
