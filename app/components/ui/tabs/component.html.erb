<%#
  twgutter-bleed rather than w-full: the row scrolls the whole width of the page, and a
  width:100% border box with negative margins would slide left instead of bleeding both sides.

  pb-4 for the reason UI::Table's scroll wrapper has pb-3: overflow-x makes overflow-y auto
  too, so a horizontal scrollbar that takes up space shortens the box and the tabs start
  scrolling vertically. 16px is the room one takes; macOS's overlay scrollbars take none,
  which is why this only shows up on some machines
%>

<nav
  class="twgutter-bleed tw:overflow-x-auto tw:pb-4"
  aria-label="<%= @nav_label %>"
  data-controller="ui--tabs"
>
  <%#
    min-w-full so the underline still spans the row when the tabs don't fill it, w-max so
    it follows them out past the edge when they do
  %>

  <div class="tw:flex tw:w-max tw:min-w-full tw:gap-1 tw:border-b tw:border-gray-300">
    <% @tabs.each do |tab| %>
      <%# "page" rather than tab[:active] - a false renders aria-current="false", which counts as current %>
      <%= link_to tab[:href], class: link_classes(tab), aria: {current: ("page" if tab[:active])},
            data: {"ui--tabs-target": ("active" if tab[:active])} do %>
        <%= tab[:label] %>

        <% if tab[:count].present? %>
          <small><%= helpers.number_display(tab[:count]) %></small>
        <% end %>
      <% end %>
    <% end %>
  </div>
</nav>
