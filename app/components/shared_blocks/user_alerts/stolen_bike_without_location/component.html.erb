<%= render SharedBlocks::UserAlerts::BikeListModal::Component.new(id: MODAL_ID,
      title: translation(".stolen_missing_location_title"),
      intro: translation(".location_critical_html", bike_type:),
      footer: translation(".without_location_all_is_lost", bike_type:)) do %>
  <% @bikes.each do |bike| %>
    <p class="tw:mb-3">
      <%= link_to translation(".add_location_theft_bike_title_html", bike_title: bike.title_string),
            edit_theft_details_path(bike), class: "twlink-underlined" %>
    </p>
  <% end %>
<% end %>
