<%#
  No overflow-hidden, which would clip the tooltips - so the photo rounds its own
  corners, and the hovered card rises over the next row for a tooltip to show.
  Its tooltips sit above the card's link, which covers the rest of it
%>

<% cache(cache_key) do %>
  <li
    class="
      tw:relative tw:flex tw:flex-col tw:rounded-xl tw:border
      tw:border-gray-200 tw:bg-white tw:transition tw:focus-within:z-10
      tw:hover:z-10 tw:hover:-translate-y-0.5 tw:hover:shadow-lg
      tw:active:translate-y-0.5 tw:hover:active:translate-y-0
      tw:dark:border-gray-700 tw:dark:bg-gray-800
      tw:[&_[data-controller~=ui--tooltip]]:relative
      tw:[&_[data-controller~=ui--tooltip]]:z-20
    "
    data-test-id="search-result-card-<%= @bike.id %>"
  >
    <div
      class="
        tw:relative tw:h-40 tw:rounded-t-[11px] tw:bg-gray-100
        tw:dark:bg-gray-900
      "
    >
      <% if thumb_image_url.present? %>
        <%= image_tag(thumb_image_url, alt: @bike.title_string, skip_pipeline: true, class: "tw:h-full tw:w-full tw:rounded-t-[11px] tw:object-cover") %>
      <% else %>
        <%= helpers.bike_placeholder_image_tag(alt: @bike.title_string, class: "tw:h-full tw:w-full tw:object-contain tw:p-8") %>
      <% end %>

      <% if for_sale_listing&.amount_cents.present? %>
        <span
          class="
            tw:absolute tw:top-2 tw:left-2 tw:rounded-full tw:bg-gray-900/80
            tw:px-2 tw:py-1 tw:text-xs tw:font-extrabold tw:text-white
          "
        >
          <%= amount_display(for_sale_listing) %>
        </span>
      <% end %>

      <span class="tw:absolute tw:top-2 tw:right-2">
        <%= render(status_badge(size: :md)) %>
      </span>
    </div>

    <div class="tw:flex tw:flex-col tw:gap-2 tw:px-3 tw:pt-3 tw:pb-3.5">
      <h3 class="tw:m-0 tw:font-sans tw:text-base tw:leading-snug tw:normal-case">
        <%= link_to bike_href, class: "tw:twtext-color tw:hover:underline", data: bike_link_data do %>
          <strong><%= [@bike.year, @bike.mnfg_name].compact.join(" ") %></strong>
          <%= @bike.frame_model_truncated %>
          <span class="tw:absolute tw:inset-0 tw:z-10"></span>
        <% end %>
      </h3>

      <%= render(Atoms::FrameColors::Component.new(bike: @bike, html_class: "tw:text-sm tw:text-gray-500")) %>

      <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-1.5">
        <%= render(Atoms::VehicleTypeBadges::Component.new(bike: @bike)) %>

        <% if render_member_badge? %>
          <%= render(UI::Badge::Component.new(text: translation(".member_listing"), title: translation(".member_listing_tooltip"), color: :purple)) %>
        <% end %>
      </div>

      <% if location.present? %>
        <p class="tw:m-0 tw:text-xs tw:text-gray-400"><%= location %></p>
      <% end %>

      <div
        class="
          tw:@container tw:flex tw:flex-wrap tw:items-baseline tw:gap-x-2
          tw:gap-y-1
        "
      >
        <%= render(Atoms::Serial::Component.new(bike: @bike, organization: @organization, explanation: :serial_tooltip)) %>

        <% if credibility_badges? %>
          <%= render(Atoms::RegistrationDates::Component.new(bike: @bike)) %>
        <% end %>
      </div>

      <% if render_org_badge? %>
        <div>
          <%= render(UI::Badge::Component.new(text: org_badge_text, color: organized? ? :notice : :gray)) %>
        </div>
      <% end %>
    </div>
  </li>
<% end %>
