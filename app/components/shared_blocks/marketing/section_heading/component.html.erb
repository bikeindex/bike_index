<div class="<%= @html_class %>">
  <% if @eyebrow.present? %>
    <p class="tw:m-0 tw:mb-2 <%= @eyebrow_classes %>"><%= @eyebrow %></p>
  <% end %>

  <%= tag.h2(@heading, id: @id,
    class: "tw:m-0 tw:font-header tw:text-[26px] tw:leading-tight tw:font-extrabold tw:text-balance tw:lg:text-[34px]") %>

  <% if @intro.present? %>
    <p class="tw:m-0 tw:mt-3 tw:text-[15px] tw:leading-relaxed tw:text-pretty tw:lg:text-[17px] <%= @on_dark ? "tw:text-white/85" : "tw:text-gray-500 tw:dark:text-gray-400" %>">
      <%= @intro %>
    </p>
  <% end %>
</div>
