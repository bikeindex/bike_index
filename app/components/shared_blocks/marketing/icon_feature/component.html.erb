<div class="<%= wrapper_classes %>">
  <span class="tw:flex tw:size-10 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-full tw:text-white <%= @circle %>">
    <%= helpers.inline_svg_tag(@icon, class: "tw:size-5", aria_hidden: true) %>
  </span>

  <div>
    <h3 class="tw:m-0 tw:text-[17px] tw:font-extrabold">
      <%= @title %>
    </h3>

    <p
      class="
        tw:m-0 tw:mt-1 tw:text-[15px] tw:leading-normal tw:text-gray-500
        tw:dark:text-gray-400
      "
    >
      <%= @body %>
    </p>
  </div>
</div>
