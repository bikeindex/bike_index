<div class="tw:flex tw:flex-wrap tw:items-end tw:justify-between tw:gap-x-6 tw:gap-y-1">
  <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(heading: @heading,
    intro: translation(".reported_by_owners"))) %>

  <%= link_to(translation(".read_more_recovery_stories"), recovery_stories_path,
    class: "twlink tw:text-[15.5px] tw:font-bold") %>
</div>

<% if @recovery_displays.any? %>
  <ul
    class="
      tw:m-0 tw:-mx-5 tw:mt-4 tw:flex tw:snap-x tw:snap-mandatory
      tw:scroll-px-5 tw:list-none tw:gap-4 tw:overflow-x-auto tw:p-0 tw:px-5
      tw:sm:mx-0 tw:sm:grid tw:sm:grid-cols-2 tw:sm:overflow-visible
      tw:sm:px-0 tw:lg:mt-6 tw:lg:grid-cols-4
    "
  >
    <% @recovery_displays.each do |recovery_display| %>
      <%= render(Atoms::RecoveryDisplayCard::Component.new(recovery_display:,
      html_class: "tw:flex tw:w-4/5 tw:shrink-0 tw:snap-start tw:sm:w-auto")) %>
    <% end %>
  </ul>
<% else %>
  <p class="tw:m-0 tw:mt-4 tw:text-gray-500 tw:dark:text-gray-400">
    <%= translation(".no_recoveries") %>
  </p>
<% end %>
