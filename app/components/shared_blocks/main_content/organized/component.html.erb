<div class="organized-wrap">
  <div class="<%= container %>">
    <%# the layout skips its own spot for this, so it lands inside the content column %>
    <% if @show_general_alert %>
      <%= render SharedBlocks::UserAlerts::Wrapper::Component.new(current_user: @current_user, wrapper_class: "tw:my-4") %>
    <% end %>

    <% if OrgServices::Displayer.law_enforcement_missing_verified_features?(@current_organization) %>
      <%= render(UI::Alerts::Base::Component.new(kind: :notice, dismissable: true, text: translation(".additional_features_html", email_link: email_link), margin_classes: "tw:mb-10")) %>
    <% end %>

    <% if OrgServices::Displayer.subscription_expired_alert?(@current_organization) %>
      <%= render(UI::Alerts::Base::Component.new(kind: :notice, dismissable: true, text: translation(".subscription_expired_html", email_link: email_link), margin_classes: "tw:mb-10")) %>
    <% end %>

    <%= render SharedBlocks::MainContent::OrganizedShopIntegrationAlert::Component.new(
      current_organization: @current_organization,
      controller_name: @controller_name,
      action_name: @action_name
    ) %>

    <%= content %>
  </div>
</div>

<% if include_javascript_pack? %>
  <script>
    window.passiveOrganizationId = <%== @passive_organization&.slug.to_json %>;
  </script>
  <%# Important that this is below the content, sometimes important page data is added to the dom in there %>
  <script src="/vendored_assets/application.js"></script>
<% end %>
