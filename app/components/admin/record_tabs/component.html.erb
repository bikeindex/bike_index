<%#
  .admin-subnav already bleeds -15px; matching --gutter exactly is what lets everything
  inside drop .col's compensating padding. .twgutter-bleed can't do it - it's in a layer,
  and admin_unvendored is imported outside one, so it wins whatever the specificity
%>

<div class="admin-subnav tw:-mx-[var(--gutter)]! tw:px-[var(--gutter)] tw:pb-0!">
  <div class="tw:flex-1">
    <h1>
      <%= @title %>

      <% if @subtitle.present? %>
        <small><%= @subtitle %></small>
      <% end %>
    </h1>
  </div>

  <div class="tw:flex-1">
    <ul>
      <% @links.each do |link| %>
        <li class="nav-item"><%= link %></li>
      <% end %>
    </ul>
  </div>

  <% if alert? %>
    <div class="tw:mt-6 tw:w-full tw:md:w-1/2"><%= alert %></div>
  <% end %>

  <%# Scrolls rather than wraps, so a row too wide for the screen stays one row %>

  <nav
    class="tw:mt-3 tw:w-full tw:overflow-x-auto"
    aria-label="<%= @nav_label %>"
    data-controller="admin--record-tabs"
  >
    <div class="tw:-mb-px tw:flex tw:w-max tw:gap-1">
      <% @tabs.each do |tab| %>
        <%# "page" rather than tab[:active] - a false renders aria-current="false", which counts as current %>
        <%= link_to tab[:href], class: link_classes(tab), aria: {current: ("page" if tab[:active])},
              data: {"admin--record-tabs-target": ("active" if tab[:active])} do %>
          <%= tab_label(tab) %>

          <% if tab[:count].present? %>
            <small><%= helpers.number_display(tab[:count]) %></small>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </nav>
</div>
