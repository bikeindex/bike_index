<%#
  -mx-4/px-4 keeps .admin-subnav's border-bottom running to the viewport edge, which it
  got from a -15px margin the .col padding used to cancel
%>

<div class="admin-subnav tw:-mx-4! tw:px-4 tw:pb-0!">
  <div class="tw:grow tw:basis-0">
    <h1>
      <%= @title %>

      <% if @subtitle.present? %>
        <small><%= @subtitle %></small>
      <% end %>
    </h1>
  </div>

  <div class="tw:grow tw:basis-0">
    <ul>
      <% @links.each do |link| %>
        <li class="nav-item"><%= link %></li>
      <% end %>
    </ul>
  </div>

  <% if alert? %>
    <div class="tw:mt-6 tw:w-full tw:md:w-1/2"><%= alert %></div>
  <% end %>

  <%#
    Divs rather than a ul: .admin-subnav ul is force-right-aligned, and its .active is a
    blue pill. The -1px pulls the tabs onto the subnav's border-bottom, so the active
    tab's white lower edge breaks the line the way a tab should
  %>

  <nav
    class="nav nav-tabs tw:mt-3 tw:-mb-px tw:w-full tw:border-b-0!"
    aria-label="<%= @nav_label %>"
  >
    <% @tabs.each do |tab| %>
      <div class="nav-item">
        <%# "page" rather than tab[:active] - a false renders aria-current="false", which counts as current %>
        <%= link_to tab[:label], tab[:href], class: link_classes(tab), aria: {current: ("page" if tab[:active])} %>
      </div>
    <% end %>
  </nav>
</div>
