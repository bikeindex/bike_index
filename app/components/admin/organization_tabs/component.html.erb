<div class="admin-subnav">
  <div class="col">
    <h1>
      <%= @organization.name %>

      <% if @subtitle.present? %>
        <small><%= @subtitle %></small>
      <% end %>
    </h1>
  </div>

  <div class="col">
    <ul>
      <% top_right_links.each do |link| %>
        <li class="nav-item"><%= link %></li>
      <% end %>
    </ul>
  </div>

  <% if @organization.deleted? %>
    <div class="col-md-6 mt-4">
      <%= render(UI::Alerts::Base::Component.new(kind: :error, header: "Organization deleted")) do %>
        <%= render(UI::Time::Component.new(time: @organization.deleted_at, format: :localize_time_precise, preposition: true)) %>
      <% end %>
    </div>
  <% end %>
</div>

<nav class="tw:mb-4" aria-label="Organization sections">
  <%= render(UI::ButtonGroup::Component.new(entries: tabs)) %>
</nav>
