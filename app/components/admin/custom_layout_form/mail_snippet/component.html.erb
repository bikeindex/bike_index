<div class="form form-horizontal clearfix">
  <%= render(UI::Alerts::ObjectError::Component.new(object: @organization)) %>

  <%= form_for @organization, as: :organization, url: form_url, action: "update" do |f| %>
    <%= f.fields_for :mail_snippets do |snippet| %>
      <% if snippet.object.kind == @edit_template %>
        <%= render(UI::Forms::Group::Component.new(form_builder: snippet, attribute: :body, kind: :text_area,
          label_text: "#{snippet.object.kind.titleize} snippet",
          html_options: {rows: 10, placeholder: description_for(snippet.object.kind)})) %>

        <div class="row">
          <div class="col-md-6">
            <%= render(UI::Forms::Checkbox::Component.new(form_builder: snippet, attribute: :is_enabled,
              label: enable_label)) %>
          </div>

          <div class="col-md-6">
            <%= f.submit "Save", class: "btn btn-success float-right" %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

<ul
  id="public_images"
  class="list-unstyled mt-4 not-blog-public-images"
  data-order-url="<%= order_public_images_url %>"
>
  <% if @mail_snippet.public_images %>
    <%= render partial: "public_images/admin_public_image", collection: @mail_snippet.public_images, as: :public_image, locals: {skip_order: true} %>
  <% end %>
</ul>

<section class="custom-layouts">
  <%= render partial: "public_images/admin_new_form", locals: {imageable_type: "MailSnippet"} %>
</section>
