<div class="<%= wrapper_classes %>">
  <%# A wrapper, so a heading and its subtitle are one flex item rather than two %>
  <div class="tw:mr-auto">
    <%= render(UI::Header::Component.new(text: @title, subtitle: @subtitle, margin: false)) %>
  </div>

  <%# not content?, which is true for a caller whose items all render to nothing %>
  <% if content.present? %>
    <ul
      class="
        tw:mb-0 tw:flex tw:list-none tw:flex-row tw:flex-wrap
        tw:items-baseline tw:gap-1 tw:pl-0 tw:text-sm
      "
    >
      <%= content %>
    </ul>
  <% end %>
</div>
