<div class="tw:mb-6">
  <h1 class="uncap tw:mb-2 tw:text-2xl tw:font-semibold">
    <%= action_word %>
    <strong><%= @registration_sequence.display_name %></strong> registration
    sequence
  </h1>

  <%# ml-auto holds the organization link against the right edge, wrapped or not %>
  <div
    class="
      tw:flex tw:flex-wrap tw:items-baseline tw:justify-between tw:gap-x-4
      tw:gap-y-1
    "
  >
    <%= render UI::ButtonGroup::Component.new(entries:) %>

    <% if organization_path.present? %>
      <%= link_to "View in organization", organization_path, class: "twlink tw:ml-auto tw:text-sm" %>
    <% end %>
  </div>
</div>
