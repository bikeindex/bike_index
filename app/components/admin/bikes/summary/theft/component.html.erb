<h4 class="tw:mt-4">
  <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">Theft information</span>
</h4>

<div class="tw:flex tw:flex-wrap">
  <div class="tw:w-full tw:md:w-1/2 tw:md:pr-4">
    <table class="table-list">
      <tbody>
        <% if @display_dev_info %>
          <tr class="tw:text-sm">
            <td>ID</td>

            <td><code><%= @stolen_record.id %></code></td>
          </tr>
        <% end %>

        <tr>
          <td>Theft description</td>

          <td><%= @stolen_record.theft_description %></td>
        </tr>

        <tr>
          <td>Stolen record created</td>

          <td>
            <%= render(UI::Time::Component.new(time: @stolen_record.created_at)) %>
          </td>
        </tr>

        <tr>
          <td>Stolen at</td>

          <td>
            <%= render(UI::Time::Component.new(time: @stolen_record.date_stolen)) %>
          </td>
        </tr>

        <tr>
          <td>Callable by</td>

          <td><%= callable_by %></td>
        </tr>

        <% unless @stolen_record.recovered? %>
          <tr>
            <td>Link to recover</td>

            <td>
              <input
                type="text"
                class="twinput"
                readonly
                autocomplete="off"
                value="<%= recovery_link %>"
              >
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="tw:w-full tw:md:w-1/2">
    <table class="table-list">
      <tbody>
        <tr>
          <td>Approved?</td>

          <td>
            <% if @stolen_record.approved %>
              <%= check_mark %>
            <% else %>
              <small class="twless-strong">nope</small>
            <% end %>
          </td>
        </tr>

        <tr>
          <td>Estimated $</td>

          <td><%= @stolen_record.estimated_value %></td>
        </tr>

        <tr>
          <td>Location</td>

          <td>
            <%= @stolen_record.formatted_address_string(visible_attribute: :street) %>

            <% if @stolen_record.without_street? %>
              <em class="tw:text-sm <%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">
                missing address (user alerted)
              </em>
            <% end %>
          </td>
        </tr>

        <tr>
          <td>Phone</td>

          <td>
            <%= render(Atom::Phone::Component.new(phone: @stolen_record.phone, skip_link: true)) %>

            <% if @stolen_record.secondary_phone.present? %>
              <small class="tw:block">
                <span class="twless-strong">secondary:</span>
                <%= render(Atom::Phone::Component.new(phone: @stolen_record.secondary_phone, skip_link: true)) %>
              </small>
            <% end %>
          </td>
        </tr>

        <tr>
          <td>Police Department</td>

          <td><%= @stolen_record.police_report_department %></td>
        </tr>

        <tr>
          <td>Police Report</td>

          <td><%= @stolen_record.police_report_number %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
