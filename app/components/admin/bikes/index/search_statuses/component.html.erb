<div
  class="tw:mb-2 <%= "tw:hidden" unless @not_default_statuses %>"
  data-controller="admin--search-statuses"
  data-action="admin--search-statuses:toggle@window->admin--search-statuses#toggle
               change->admin--search-statuses#lock"
>
  <p class="tw:mb-1"><em>Include bikes that are:</em></p>

  <div class="twfieldrow">
    <div>
      <% Admin::Bikes::Index::SearchStatuses::Component::PLAIN_STATUSES.each do |status, label| %>
        <%= render(UI::Forms::Checkbox::Component.new(name: :"search_status_#{status}",
              label: label || with_owner_label, checked: searched?(status))) %>
      <% end %>
    </div>

    <div>
      <% Admin::Bikes::Index::SearchStatuses::Component::ONLY_STATUSES.each do |status, label| %>
        <% if only?(status) %>
          <%= render(UI::Forms::Checkbox::Component.new(name: :"search_status_#{status}_only",
                label: safe_join([label, tag.strong("Only")], " "), checked: true)) %>
        <% else %>
          <div class="tw:flex tw:items-baseline tw:gap-2">
            <%#
              The checkbox's own label is a flex, so its baseline as a flex item comes from
              the input unless its contents baseline-align too - without this its text sits
              3px off "only" and the note. Forced, because the component's own
              tw:items-center is the same property and wins the tie otherwise.
            %>

            <%= render(UI::Forms::Checkbox::Component.new(name: :"search_status_#{status}",
                  label:, checked: searched?(status), class_name: "tw:items-baseline!")) %>

            <%= link_to "only", only_path(status), class: "twlink tw:text-sm" %>

            <% if default_on?(status) %>
              <em class="twless-strong tw:text-xs">on by default</em>

              <%= render(UI::Tooltip::Component.new(text: "enabled because of your superuser settings")) %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if @not_default_statuses %>
        <div class="tw:mt-1 tw:text-right tw:text-sm">
          <%= link_to "reset to default statuses", reset_path, class: "twlink" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
