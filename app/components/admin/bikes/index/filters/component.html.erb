<% if @show_search_statuses %>
  <li class="nav-item tw:text-sm">
    <%#
      The panel this opens is Admin::Bikes::Index::SearchStatuses, inside the search form -
      a different branch of the skeleton, so the two talk over a window event
    %>

    <%= render(UI::Button::Component.new(text: "Search statuses", color: :secondary, size: :sm,
          active: @not_default_statuses,
          data: {controller: "admin--search-statuses",
                 action: "click->admin--search-statuses#dispatchToggle"})) %>
  </li>
<% end %>

<%#
  These read their state off the controller, so they carry .active themselves - UI::ActiveLink
  resolves it from the URL for cached fragments, and only sets aria-current, which the
  admin row doesn't style
%>

<li class="nav-item tw:text-sm">
  <%= link_to "motorized", url_for(search_params.merge(search_motorized: !@motorized)),
        class: nav_link_class(@motorized) %>
</li>

<li class="nav-item tw:text-sm">
  <%= link_to "multi-delete", url_for(search_params.merge(search_multi_delete: !@multi_delete)),
        class: nav_link_class(@multi_delete) %>
</li>

<li class="nav-item tw:text-sm">
  <%= link_to "Unknown Mnfgs", missing_manufacturer_admin_bikes_path, class: nav_link_class(false) %>
</li>

<li class="nav-item tw:text-sm">
  <%= render(UI::Dropdown::Component.new(name: origin_name, button_size: :sm,
        active: !any_origin_active?)) do |dropdown|
    dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Any Origin", match: :query, query: {search_origin: nil}, path: url_for(search_params.merge(search_origin: nil))) }
    dropdown.with_entry_divider
    Ownership.origins.each do |origin|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: origin.humanize, match: :query, query: {search_origin: origin}, path: origin_path(origin)) }
    end
  end %>
</li>

<li class="nav-item tw:text-sm">
  <%= render(UI::Dropdown::Component.new(name: pos_name, button_size: :sm,
        active: @pos_search_type.present?)) do |dropdown|
    Admin::Bikes::Index::Filters::Component::POS_TYPES.each do |value, label|
      dropdown.with_entry_divider if value == "any_pos"
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: label, match: :query, query: {search_pos: value}, path: pos_path(value)) }
    end
    dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "any (POS or not)", match: :query, query: {search_pos: nil}, path: url_for(search_params.merge(search_pos: nil))) }
  end %>
</li>

<li class="nav-item tw:text-sm">
  <%= link_to "Detailed graphs", graphs_path, class: "nav-link" %>
</li>
