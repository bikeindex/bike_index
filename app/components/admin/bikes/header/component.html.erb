<% if @bike.blank? %>
  <%= render(UI::Alerts::Base::Component.new(kind: :error, header: "No registration present",
        text: "This screen is scoped to a registration, and it no longer exists")) %>
<% else %>
  <%= render(Admin::Bikes::Tabs::Component.new(bike: @bike, active: @active, stolen_record: @stolen_record,
        display_recovery: @display_recovery)) %>

  <%#
    One panel, the way the dark .admin-bike-tabs band used to read - what the registration
    is, set apart from whichever tab's body follows it
  %>

  <%= render(UI::Card::Component.new(shadow: true, additional_classes: "tw:mt-4")) do %>
    <%= render(Admin::Bikes::Summary::Details::Component.new(bike: @bike, user: @user,
          stolen_record: @stolen_record, display_dev_info: @display_dev_info)) %>

    <%= render(Admin::Bikes::Summary::Theft::Component.new(stolen_record: @stolen_record, bike: @bike,
          display_dev_info: @display_dev_info)) %>

    <%= render(Admin::Bikes::Summary::Recovery::Component.new(stolen_record: @stolen_record,
          display_recovery: @display_recovery)) %>
  <% end %>
<% end %>
