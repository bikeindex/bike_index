<div class="row mt-4">
  <div class="col-sm-6">
    <h2>
      <%= number_with_delimiter(@bikes_count) %>
      <%= "Bike".pluralize(@bikes_count) %>

      <em class="small">
        <%= link_to "view all bikes", admin_bikes_path(organization_id: @organization.to_param) %>
      </em>
    </h2>
  </div>

  <div class="col-sm-6 text-right">
    <%= link_to "org bikes view", organization_registrations_path(organization_id: @organization.to_param), class: "gray-link mt-3 d-inline-block" %>
  </div>
</div>

<%= render Admin::BikesTable::Component.new(bikes: @bikes) %>
