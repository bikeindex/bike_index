<nav class="navbar navbar-expand-md navbar-light bg-light admin-navbar">
  <span class="navbar-brand">
    <%= link_to image_tag("logo.svg"), helpers.user_root_url %>
  </span>

  <% if @current_user.superuser? %>
    <ul class="navbar-nav d-none d-lg-flex">
      <% shortcut_links.each do |link| %>
        <li class="nav-item">
          <%# bootstrap's .nav-link.active color, keyed off a class this component doesn't emit %>
          <%= render UI::ActiveLink::Component.new(text: link[:title], path: link[:path],
                html_class: "nav-link tw:is-active:text-black/90", match: link[:match]) %>
        </li>
      <% end %>

      <% if mailer_links.any? %>
        <li class="nav-item">
          <%= render(UI::Dropdown::Component.new(name: "Mailers", button_class: "nav-link tw:mr-1 tw:cursor-pointer")) do |dropdown| %>
            <% mailer_links.each do |title, path| %>
              <% dropdown.with_entry_item { link_to title, path } %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if display_view_all? %>
      <%= link_to current_nav_link[:path], class: "nav-link text-muted em" do %>
        All
        <div class="d-none d-sm-inline-block d-lg-none d-xl-inline-block">
          <%= view_all_title %>
        </div>
      <% end %>
    <% end %>
    <div
      class="tw:mt-1 tw:min-w-75 tw:max-sm:min-w-60"
      data-controller="admin--navbar"
      data-action="hw-combobox:selection->admin--navbar#navigate"
    >
      <%= render(UI::Forms::Combobox::Component.new(name: :admin_navigation, options: combobox_options, placeholder:)) %>
    </div>
  <% end %>

  <%= link_to "Exit Admin", root_path, class: "btn btn-outline-secondary ml-auto less-strong d-none d-lg-inline-block" %>
</nav>
