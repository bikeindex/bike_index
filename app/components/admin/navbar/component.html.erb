<nav class="navbar navbar-expand-md navbar-light bg-light admin-navbar more">
  <span class="navbar-brand">
    <%= link_to (image_tag("logo.svg")), helpers.user_root_url %>
  </span>

  <% if @current_user.superuser? %>
    <ul class="navbar-nav d-none d-lg-flex">
      <% shortcut_links.each do |link| %>
        <li class="nav-item">
          <%= helpers.active_link link[:title], link[:path], role: "button", class: "nav-link", match_controller: true %>
        </li>
      <% end %>

      <% if render_mailer_links? %>
        <li class="dropdown nav-item">
          <a class="dropdown-toggle nav-link" data-toggle="dropdown">
            Mailers
          </a>

          <div class="dropdown-menu admin-nav-dropdown">
            <% mailer_links.each do |title, path| %>
              <%= link_to title, path, role: "button", class: "btn btn-light dropdown-item" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
    <% if display_view_all? %>
      <%= link_to active_link[:path], class: "nav-link text-muted em" do %>
        All
        <div class="d-none d-sm-inline-block d-lg-none d-xl-inline-block">
          <%= view_all_title %>
        </div>
      <% end %>
    <% end %>
    <div
      class="tw:mt-1 tw:min-w-75 tw:max-sm:min-w-60"
      data-controller="admin--navbar"
      data-action="hw-combobox:selection->admin--navbar#navigate"
    >
      <%= render(::UI::Forms::Combobox::Component.new(name: :admin_navigation, options: combobox_options, placeholder:)) %>
    </div>
  <% end %>

  <%= link_to "Exit Admin", root_path, class: "btn btn-outline-secondary ml-auto less-strong d-none d-lg-inline-block" %>
</nav>
