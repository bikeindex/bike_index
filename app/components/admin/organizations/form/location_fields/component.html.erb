<fieldset>
  <%= render(UI::Card::Component.new(mobile_flush: true)) do %>
    <div class="twfieldrow">
      <div>
        <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :name)) %>
      </div>

      <div>
        <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :phone, kind: :telephone_field)) %>
      </div>
    </div>

    <%= @form_builder.fields_for :address_record, @location.find_or_build_address_record do |address_form| %>
      <%= render(UI::Forms::AddressGroup::Component.new(form_builder: address_form)) %>
    <% end %>

    <%#
      items-baseline so Remove sits on the first checkbox's baseline rather than the top
      of a block three checkboxes tall
    %>

    <div class="tw:flex tw:items-baseline tw:gap-2">
      <div>
        <%= checkbox(:publicly_visible, publicly_visible_label) %>

        <% if @organization.enabled?("impound_bikes") %>
          <%= checkbox(:impound_location) %>

          <%= checkbox(:default_impound_location) %>
        <% end %>
      </div>

      <% if @location.destroy_forbidden? %>
        <small class="twless-strong tw:ml-auto">can't remove, has impounded bikes</small>
      <% else %>
        <%= @form_builder.hidden_field :_destroy %>

        <%# twlink is in the components layer, so the red utilities outrank it %>
        <%= render(UI::Button::Component.new(text: "Remove", color: :link,
              html_class: "tw:ml-2 tw:text-sm tw:text-red-700 tw:hover:text-red-800 tw:dark:text-red-400",
              data: {action: "click->#{UI::Forms::NestedFields::Component::CONTROLLER}#remove"})) %>
      <% end %>
    </div>
  <% end %>
</fieldset>
