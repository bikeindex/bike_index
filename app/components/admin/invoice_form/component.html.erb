<div class="mt-4" data-controller="admin--invoice-form">
  <%= form_for [:admin, @organization, @invoice] do |f| %>
    <%= f.hidden_field :organization_feature_ids, data: {"admin--invoice-form-target": "featureIds"} %>
    <%= render(UI::Alerts::ObjectError::Component.new(object: @invoice)) %>

    <div class="full-screen-table">
      <table class="table table-striped table-bordered table-sm">
        <thead class="thead-light">
          <th></th>
          <th>Name</th>
          <th>Kind</th>
          <th>Amount</th>
        </thead>

        <tbody>
          <% @organization_features.each do |organization_feature| %>
            <tr>
              <td><%= feature_checkbox(organization_feature) %></td>

              <td>
                <%= link_to organization_feature.name, edit_admin_organization_feature_url(organization_feature) %>

                <% if show_feature_slugs?(organization_feature) %>
                  <code class="only-dev-visible">
                    <small><%= organization_feature.feature_slugs.join(" ") %></small>
                  </code>
                <% end %>
              </td>

              <td><small><%= organization_feature.kind.humanize %></small></td>

              <td><%= organization_feature.amount_formatted %></td>
            </tr>
          <% end %>

          <tr>
            <td class="tw:border-t-2 tw:border-black"></td>
            <td class="tw:border-t-2 tw:border-black"></td>

            <td class="text-right tw:border-t-2 tw:border-black">
              One Time Features
              <small
                class="less-strong"
                data-admin--invoice-form-target="oneTimeCount"
              ></small>
            </td>

            <td class="tw:border-t-2 tw:border-black">
              $
              <span data-admin--invoice-form-target="oneTimeCost"></span>
            </td>
          </tr>

          <tr>
            <td></td>
            <td></td>

            <td class="text-right">
              Recurring Features
              <small
                class="less-strong"
                data-admin--invoice-form-target="recurringCount"
              ></small>
            </td>

            <td>
              $
              <span data-admin--invoice-form-target="recurringCost"></span>
            </td>
          </tr>

          <tr>
            <td></td>
            <td></td>
            <td class="text-right">Total</td>
            <td>$<span data-admin--invoice-form-target="totalCost"></span></td>
          </tr>

          <tr>
            <td></td>
            <td></td>

            <td class="text-right">
              <%= f.label :amount_due, "Amount due $" %>
            </td>

            <td>
              <%= render(UI::Forms::Input::Component.new(form_builder: f, attribute: :amount_due, kind: :number_field,
                html_options: {data: {"admin--invoice-form-target": "amountDue", action: "input->admin--invoice-form#recalculate"}})) %>
            </td>
          </tr>

          <tr>
            <td></td>
            <td></td>
            <td class="text-right">Discount</td>

            <td>
              $
              <span data-admin--invoice-form-target="discountCost"></span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="row">
      <div class="col-md-6">
        <%= f.hidden_field :timezone, value: "", class: "hiddenFieldTimezone" %>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :start_at, kind: :datetime_local_field,
          label_text: "Coverage starts", required: true, html_options: {value: start_at, step: 60})) %>
      </div>

      <div class="col-md-6">
        <div
          class="<%= "tw:hidden!" if @invoice.endless? %>"
          data-admin--invoice-form-target="endsAt"
        >
          <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :end_at, kind: :datetime_local_field,
            label_text: "Coverage ends", required: true, html_options: {value: end_at, step: 60})) %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :notes, kind: :text_area,
          html_options: {rows: 4})) %>
      </div>

      <div class="col-md-3 col-6">
        <%= f.submit "Save", class: "btn btn-lg btn-success mt-4" %>
      </div>

      <div class="col-md-3 col-6 mt-4 mr-2">
        <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :is_endless,
          label: "Coverage never ends",
          input_data: {"admin--invoice-form-target": "isEndless", action: "change->admin--invoice-form#toggleEndsAt"})) %>
      </div>
    </div>

    <hr>

    <div class="row mt-4">
      <div class="col-md-6">
        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :child_enabled_feature_slugs_string,
          kind: :text_area, label_text: child_slugs_label,
          html_options: {rows: 2, placeholder: "comma separated list of features"})) do |group| %>
          <% group.with_helper_text do %>
            <em>available features in current invoice:</em>
            <%= safe_join(@invoice.feature_slugs.map { |slug| content_tag(:code, slug) }, ", ") %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
