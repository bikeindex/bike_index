<div id="invoiceForm" class="mt-4">
  <%= form_for [:admin, @organization, @invoice] do |f| %>
    <%= f.hidden_field :organization_feature_ids %>
    <%= render(UI::Alerts::ObjectError::Component.new(object: @invoice)) %>

    <div class="full-screen-table">
      <table class="table table-striped table-bordered table-sm">
        <thead class="thead-light">
          <th></th>
          <th>Name</th>
          <th>Kind</th>
          <th>Amount</th>
        </thead>

        <tbody>
          <% @organization_features.each do |organization_feature| %>
            <tr>
              <td class="organizationFeatureCheck">
                <%= feature_checkbox(organization_feature) %>
              </td>

              <td>
                <%= link_to organization_feature.name, edit_admin_organization_feature_url(organization_feature) %>

                <% if show_feature_slugs?(organization_feature) %>
                  <code class="only-dev-visible">
                    <small><%= organization_feature.feature_slugs.join(" ") %></small>
                  </code>
                <% end %>
              </td>

              <td><small><%= organization_feature.kind.humanize %></small></td>

              <td><%= organization_feature.amount_formatted %></td>
            </tr>
          <% end %>

          <tr>
            <td class="tw:border-t-2 tw:border-black"></td>
            <td class="tw:border-t-2 tw:border-black"></td>

            <td class="text-right tw:border-t-2 tw:border-black">
              One Time Features
              <small class="less-strong" id="oneTimeCount"></small>
            </td>

            <td class="tw:border-t-2 tw:border-black">
              $
              <span id="oneTimeCost"></span>
            </td>
          </tr>

          <tr>
            <td></td>
            <td></td>

            <td class="text-right">
              Recurring Features
              <small class="less-strong" id="recurringCount"></small>
            </td>

            <td>$<span id="recurringCost"></span></td>
          </tr>

          <tr>
            <td></td>
            <td></td>
            <td class="text-right">Total</td>
            <td>$<span id="totalCost"></span></td>
          </tr>

          <tr>
            <td></td>
            <td></td>

            <td class="text-right">
              <%= f.label :amount_due, "Amount due $" %>
            </td>

            <td class="inputTriggerRecalculation">
              <%= f.number_field :amount_due, class: "form-control" %>
            </td>
          </tr>

          <tr>
            <td></td>
            <td></td>
            <td class="text-right">Discount</td>
            <td>$<span id="discountCost"></span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <%= f.label :start_at, "Coverage starts" %>
          <%= f.hidden_field :timezone, value: "", class: "hiddenFieldTimezone" %>
          <%= f.datetime_local_field :start_at, value: start_at, step: 60, required: true, class: "form-control" %>
        </div>
      </div>

      <div class="col-md-6">
        <div
          id="subscriptionEndsAt"
          class="form-group collapse <%= "show" unless @invoice.endless? %>"
        >
          <%= f.label :end_at, "Coverage ends" %>
          <%= f.datetime_local_field :end_at, value: end_at, step: 60, required: true, class: "form-control" %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <%= f.label :notes %>
          <%= f.text_area :notes, rows: 4, class: "form-control" %>
        </div>
      </div>

      <div class="col-md-3 col-6">
        <div class="form-group">
          <%= f.submit "Save", class: "btn btn-lg btn-success mt-4" %>
        </div>
      </div>

      <div class="col-md-3 col-6">
        <div id="endlessCheckBox" class="form-group text-right">
          <div class="form-check mt-4 mr-2">
            <%= f.check_box :is_endless %>
            <%= f.label :is_endless, "Coverage never ends" %>
          </div>
        </div>
      </div>
    </div>

    <hr>

    <div class="row mt-4">
      <div class="col-md-6">
        <div class="form-group">
          <%= f.label :child_enabled_feature_slugs_string do %>
            Features passed on to children
            <small class="em"> If this is for a parent organization, choose which features from this invoice should apply to the child organizations </small>
          <% end %>

          <%= f.text_area :child_enabled_feature_slugs_string, rows: 2, placeholder: "comma separated list of features", class: "form-control" %>

          <small class="below-input-help">
            <em>available features in current invoice:</em>
            <%= safe_join(@invoice.feature_slugs.map { |slug| content_tag(:code, slug) }, ", ") %>
          </small>
        </div>
      </div>
    </div>
  <% end %>
</div>
