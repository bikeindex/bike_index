<div class="full-screen-table">
  <table class="table table-striped table-bordered">
    <thead class="thead-light">
      <th>Paid&nbsp;at</th>
      <th>User</th>
      <th>Invoice</th>
      <th>Kind</th>
      <th>Amount</th>
    </thead>

    <tbody>
      <% payments.each do |payment| %>
        <tr>
          <td>
            <%= link_to edit_admin_payment_path(payment) do %>
              <%= render(UI::Time::Component.new(time: payment.created_at)) %>
            <% end %>
          </td>

          <td>
            <% if payment.user_id.present? %>
              <%= link_to payment.user.display_name, edit_admin_user_path(payment.user) %>
            <% elsif payment.email.present? %>
              <%= payment.email %>
              <small class="less-strong">no user</small>
            <% end %>
          </td>

          <td>
            <% if payment.invoice_id.present? %>
              <%= link_to payment.invoice.display_name, invoice_path(payment) %>

              <% if payment.invoice.subscription_start_at %>
                <small>
                  <%= render(UI::Time::Component.new(time: payment.invoice.subscription_start_at)) %>
                </small>
              <% end %>
            <% end %>
          </td>

          <td><small><%= payment.payment_method.humanize %></small></td>

          <td><%= payment.amount_formatted %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
