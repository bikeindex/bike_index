<%= render(Admin::OrganizationTabs::Component.new(organization: @organization, active: :custom_layouts)) %>

<div class="tw:grid tw:items-start tw:gap-x-8 tw:md:grid-cols-2">
  <p>
    <%= link_to "Custom layouts version history", version_history_url %>
  </p>

  <table class="table-list">
    <tr>
      <td>Paid</td>
      <td><strong><%= @organization.paid? %></strong></td>
    </tr>
  </table>
