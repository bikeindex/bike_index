<li class="nav-item tw:text-sm">
  <%= render(UI::Dropdown::Component.new(name: kind_name, button_size: :sm, active: kind.present?)) do |dropdown|
    dropdown.with_entry_item { filter_link("All Kinds", :search_kind, nil) }
    dropdown.with_entry_divider
    Organization.kinds.each do |organization_kind|
      dropdown.with_entry_item { filter_link(organization_kind.humanize, :search_kind, organization_kind) }
    end
  end %>
</li>

<li class="nav-item tw:text-sm">
  <%= render(UI::Dropdown::Component.new(name: pos_name, button_size: :sm, active: pos_kind.present?)) do |dropdown|
    pos_entries.each do |entry|
      dropdown.with_entry_item { filter_link(entry.humanize, :search_pos, entry) }
      dropdown.with_entry_divider if entry == "broken_pos"
    end
  end %>
</li>

<li class="nav-item">
  <%= link_to "Paid", paid_path, class: "nav-link #{"active" if @search_paid}" %>
</li>

<li class="nav-item">
  <%= link_to "New Organization", new_admin_organization_url, class: "nav-link" %>
</li>
