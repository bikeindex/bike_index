<h1><%= translation("is_this_the_same", bike_type:) %></h1>

<p>
  <% if shop_name.present? %>
    <%= translation("shop_registered_it_html", shop_name:, bike_type:) %>
  <% else %>
    <%= translation("pos_registered_it", bike_type:) %>
  <% end %>
</p>

<% [@pos_bike, @bike].each do |registration| %>
  <%= render(Emails::Partials::BikeBox::Component.new(bike: registration, ownership: registration.current_ownership, bike_url_path: bike_url(registration))) %>
<% end %>

<p><%= translation("combine_them", bike_type:) %></p>

<%= link_to translation("review_and_combine"), my_account_pos_registration_match_url(@pos_registration_match), class: "binx-button" %>

<p><%= translation("if_theyre_different") %></p>
