<%= render Register::Page::Component.new do %>
  <%= render Register::Progress::Component.new(steps: @steps, step: 2) %>

  <% if BikeServices::Register.confirmation_email_pending?(@b_param, user: @current_user) %>
    <%= render UI::Alerts::Base::Component.new(kind: :purple, text: translation(".confirmation_link_sent"),
        icon: helpers.inline_svg_tag("icons/envelope.svg", class: "tw:h-4 tw:w-4 tw:shrink-0", aria_hidden: true)) %>
  <% end %>

  <%= render UI::Header::Component.new(text: translation(".add_your_bikes_details", cycle_type:), subtitle: translation(".more_useful_registration")) %>

  <% if @b_param.errors.any? %>
    <%= render UI::Alerts::Base::Component.new(kind: :error, text: @b_param.errors.full_messages.to_sentence) %>
  <% end %>

  <%= form_with(url: register_path, method: :patch, scope: :bike,
      data: {turbo: true, controller: "autofocus form-persist register--status-fields register--organization register--retry",
        form_persist_key_value: "register-details-#{@b_param.id_token}",
        action: "input->form-persist#save hw-combobox:selection->form-persist#save hw-combobox:selection->register--status-fields#update register--organization:changed->register--status-fields#update submit->form-persist#clear"}) do |f| %>
    <%= hidden_field_tag :b_param_token, @b_param.id_token %>

    <% bike = @b_param.bike %>
    <% color_displays = Color.pluck(:id, :display).to_h %>

    <% color_combobox_options = Color.select_options.map do |name, id|
        swatch = render(UI::ColorSwatch::Component.new(display: color_displays[id], name:, size: :sm))
        {value: id, display: name, content: content_tag(:span, safe_join([swatch, name]), class: "tw:inline-flex tw:items-center tw:gap-2")}
      end %>

    <% optional_badge = render(UI::Badge::Component.new(text: translation(".optional"), size: :xs)) %>

    <%= render Register::SectionLabel::Component.new(text: translation(".bike_details", cycle_type:)) %>

    <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :frame_model,
        label_text: translation(".model"),
        html_options: {value: bike["frame_model"], placeholder: translation(".model_placeholder")}) %>

    <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :year,
        label_text: translation(".model_year"),
        html_options: {value: bike["year"], inputmode: "numeric",
          placeholder: translation(".model_year_placeholder"), class: "tw:font-mono"}) %>

    <div class="tw:mb-4" data-controller="register--additional-colors">
      <%= f.label :primary_frame_color_id, class: "twlabel" do %>
        <%= translation(".color") %>
        <%= tag.span("*", class: "tw:text-red-600") %>
        <%= render UI::Badge::Component.new(text: translation(".up_to_3"), size: :xs) %>
      <% end %>

      <%= render UI::Forms::Combobox::Component.new(name: :primary_frame_color_id, form: f,
          value: @b_param.primary_frame_color_id, options: color_combobox_options,
          placeholder: translation(".primary_color_blank"), required: true, rich_display: :inline,
          dialog_label: translation(".color"), no_js: true) %>

      <% {secondary_frame_color_id: translation(".second_color_blank"), tertiary_frame_color_id: translation(".third_color_blank")}.each do |field, blank_label| %>
        <% value = bike[field.to_s] %>

        <div
          class="tw:mt-2 tw:flex tw:items-center tw:gap-3 <%= "tw:hidden" if value.blank? %>"
          data-register--additional-colors-target="row"
        >
          <div class="tw:flex-1">
            <%= render UI::Forms::Combobox::Component.new(name: field, form: f,
                value:, options: color_combobox_options, placeholder: blank_label,
                rich_display: :inline, dialog_label: blank_label, no_js: true) %>
          </div>

          <%= render UI::Button::Component.new(text: "×", color: :link,
              html_class: "tw:shrink-0 tw:text-xl tw:leading-none tw:font-bold",
              aria: {label: translation(".remove_additional_color")},
              data: {action: "register--additional-colors#remove"}) %>
        </div>
      <% end %>

      <% all_colors_shown = %w[secondary_frame_color_id tertiary_frame_color_id].all? { |field| bike[field].present? } %>

      <div
        class="tw:mt-2 <%= "tw:hidden" if all_colors_shown %>"
        data-register--additional-colors-target="addButton"
      >
        <%= render UI::Button::Component.new(text: "+ #{translation(".add_another_color")}",
            color: :link, html_class: "tw:text-xs tw:font-bold",
            data: {action: "register--additional-colors#add"}) %>
      </div>
    </div>

    <div class="tw:mb-4" data-controller="register--frame-size">
      <span class="twlabel">
        <%= translation(".frame_size") %><%= optional_badge %>
      </span>

      <div class="tw:mt-2 tw:mb-2">
        <%= render UI::Forms::RadioButtonGroup::Component.new(name: "bike[frame_size]", full_width: true,
            selected: bike["frame_size"],
            data: {"register--frame-size-target": "chip", action: "change->register--frame-size#pickChip"},
            entries: %w[xs s m l xl].map { |size| {value: size, label: size.upcase} }) %>
      </div>

      <div class="tw:flex tw:items-center tw:gap-2.5">
        <span class="tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">
          <%= translation(".or") %>
        </span>

        <div class="tw:flex tw:flex-1 tw:items-center">
          <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :frame_size_number, kind: :number_field,
              html_options: {value: bike["frame_size_number"], step: 0.5, min: 0, placeholder: translation(".enter_size"),
                class: "tw:rounded-r-none",
                data: {"register--frame-size-target": "number", action: "input->register--frame-size#pickNumber"}}) %>

          <%= f.select :frame_size_unit, [[translation(".inches"), "in"], [translation(".cm"), "cm"]],
              {selected: bike["frame_size_unit"] || "in"},
              class: "tw:self-stretch tw:rounded-r-sm tw:border tw:border-l-0
                tw:border-gray-300 tw:bg-gray-50 tw:px-3 tw:py-1.5
                tw:text-sm tw:font-medium tw:text-gray-500
                tw:dark:border-gray-600 tw:dark:bg-gray-700
                tw:dark:text-gray-400" %>
        </div>
      </div>
    </div>

    <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :image,
        label_text: translation(".attach_photo", cycle_type:)) do |group| %>
      <% group.with_helper_text do %>
        <span class="tw:flex tw:items-start tw:gap-1.5">
          <%= helpers.inline_svg_tag("icons/info.svg", class: "tw:mt-px tw:h-3.5 tw:w-3.5 tw:shrink-0", aria_hidden: true) %>
          <%= translation(".database_public_note") %>
        </span>
      <% end %>

      <%# The token rides the query string - DirectUpload posts to this url verbatim %>
      <%= render UI::Forms::FileUpload::Component.new(form_builder: f, attribute: :image,
            accept: ImageUploader.permitted_extensions,
            direct_upload_url: register_direct_uploads_path(b_param_token: @b_param.id_token),
            html_options: {"aria-describedby" => group.helper_text_id}) %>
    <% end %>

    <div class="tw:mb-4" data-controller="ui--collapse register--serial">
      <div class="tw:flex tw:items-center tw:justify-between tw:gap-2">
        <%= f.label :serial_number, class: "twlabel" do %>
          <%= translation(".serial_number") %>
          <%= tag.span("*", class: "tw:text-red-600") %>
        <% end %>

        <%= render UI::Button::Component.new(color: :link, html_class: "tw:text-xs tw:font-bold",
            data: {action: "ui--collapse#toggle", "ui--collapse-target": "trigger"},
            aria: {expanded: "false"}) do %>
          <span
            data-ui--collapse-target="chevron"
            class="tw:inline-block tw:transition-transform tw:duration-200"
          >
            <span class="tw:flex">
              <%= render UI::IconChevron::Component.new %>
            </span>
          </span>

          <%= translation(".wheres_my_serial") %>
        <% end %>
      </div>

      <% made_without_serial = bike["serial_number"] == "made_without_serial" %>
      <% serial_missing = bike["serial_number"] == "unknown" %>

      <div
        class="<%= "tw:hidden" if made_without_serial %>"
        data-register--serial-target="serialSection"
      >
        <%# Hidden rather than removed, so the serial it holds still submits %>
        <div
          class="<%= "tw:hidden" if serial_missing %>"
          data-register--serial-target="inputRow"
        >
          <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :serial_number, kind: :text_field, required: true,
              html_options: {value: bike["serial_number"], placeholder: translation(".serial_placeholder"),
                autocomplete: "off", data: {"register--serial-target": "input"},
                class: "tw:mt-1 tw:font-mono"}) %>
        </div>

        <%= render UI::Forms::Checkbox::Component.new(name: :serial_missing, value: true,
            checked: serial_missing, label: translation(".missing_serial"), class_name: "tw:mt-2",
            input_data: {"register--serial-target": "missing", action: "change->register--serial#toggleMissing"}) %>

        <div
          class="tw:mt-1.5 <%= "tw:hidden" unless serial_missing %>"
          data-register--serial-target="madeWithoutLink"
        >
          <%= render UI::Button::Component.new(text: translation(".without_serial_number", cycle_type:),
              color: :link, html_class: "tw:text-xs tw:font-bold",
              commandfor: "made-without-serial-modal", command: "show-modal") %>
        </div>
      </div>

      <div
        class="<%= "tw:hidden" unless made_without_serial %>"
        data-register--serial-target="madeWithoutRow"
      >
        <%= render UI::Forms::Checkbox::Component.new(name: :made_without_serial_checkbox, value: true,
            checked: made_without_serial, label: translation(".without_serial", cycle_type:), class_name: "tw:mt-2",
            input_data: {"register--serial-target": "madeWithoutCheckbox", action: "change->register--serial#toggleMadeWithout"}) %>
      </div>

      <%= render UI::Modal::Component.new(id: "made-without-serial-modal", title: translation(".are_you_certain")) do |modal| %>
        <% modal.with_body do %>
          <p class="tw:mb-3">
            <%= translation(".very_very_few_bikes_html", cycle_type:, cycle_types: cycle_type.pluralize) %>
          </p>

          <ul class="tw:mb-0 tw:list-disc tw:pl-5">
            <li><%= translation(".was_made_before_1970") %></li>

            <li class="tw:list-none tw:text-xs tw:text-gray-500">
              — <%= translation(".or") %> —
            </li>

            <li><%= translation(".is_a_handmade_frame") %></li>
          </ul>

          <p class="tw:mt-4 tw:mb-0">
            <%= translation(".it_probably_has_a_serial_number") %>
          </p>

          <p class="tw:mt-3 tw:mb-0">
            <%= translation(".read_how_to_find_html",
              how_to_find_link: link_to(translation(".how_to_find_serial"), serials_path, target: "_blank", class: "twlink")) %>
          </p>

          <div class="tw:mt-5 tw:grid tw:grid-cols-2 tw:gap-4">
            <div>
              <%= render UI::Button::Component.new(text: translation(".nevermind"), color: :secondary,
                  html_class: "tw:w-full", data: {action: "ui--modal#close"}) %>

              <p class="tw:mt-1 tw:mb-0 tw:text-center tw:text-xs tw:text-gray-500">
                <%= translation(".i_just_dont_know_the_serial") %>
              </p>
            </div>

            <div>
              <%= render UI::Button::Component.new(text: translation(".im_100_sure"), color: :error,
                  html_class: "tw:w-full",
                  data: {action: "register--serial#confirmMadeWithout ui--modal#close"}) %>

              <p class="tw:mt-1 tw:mb-0 tw:text-center tw:text-xs tw:text-gray-500">
                <%= translation(".without_serial", cycle_type:) %>
              </p>
            </div>
          </div>
        <% end %>
      <% end %>

      <div
        class="
          tw:mt-2 tw:hidden tw:rounded-sm tw:border tw:border-gray-200
          tw:bg-gray-50 tw:p-4 tw:dark:border-gray-700 tw:dark:bg-gray-900
        "
        data-ui--collapse-target="content"
      >
        <p class="tw:mb-2 tw:text-xs tw:text-gray-600 tw:dark:text-gray-400">
          <%= translation(".serial_help_intro") %>
        </p>

        <ul
          class="
            tw:mb-3 tw:list-disc tw:pl-5 tw:text-xs tw:text-gray-600
            tw:dark:text-gray-400
          "
        >
          <li><%= translation(".serial_location_bottom_bracket") %></li>
          <li><%= translation(".serial_location_head_tube") %></li>
          <li><%= translation(".serial_location_rear_dropouts") %></li>
        </ul>

        <div class="tw:mb-3 tw:grid tw:grid-cols-3 tw:gap-2">
          <% {"serials/serial_bb.jpg" => translation(".bottom_bracket"),
              "serials/serial_headtube.jpg" => translation(".head_tube"),
              "serials/serial_pinsch.jpg" => translation(".rear_dropouts")}.each do |image, caption| %>
            <figure class="tw:m-0">
              <%= image_tag image, alt: caption, class: "tw:aspect-square tw:w-full tw:rounded-sm tw:object-cover" %>

              <figcaption
                class="
                  tw:mt-1 tw:text-center tw:text-xs tw:font-medium
                  tw:text-gray-500 tw:dark:text-gray-400
                "
              >
                <%= caption %>
              </figcaption>
            </figure>
          <% end %>
        </div>

        <%#
          turbo: false - the form's data-turbo opts in every link inside it, and this
          one leaves for a legacy page whose jQuery doesn't re-run on a Turbo render
        %>

        <%= link_to translation(".view_serial_guide"), serials_path, class: "twlink tw:text-xs tw:font-semibold",
            data: {turbo: false} %>
      </div>
    </div>

    <% if show_bike_sticker? %>
      <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :bike_sticker,
          label_text: reg_label("reg_bike_sticker", translation(".sticker_number")),
          html_options: {value: @b_param.bike_sticker_code, placeholder: translation(".sticker_placeholder"),
            autocomplete: "off", class: "tw:font-mono"}) %>
    <% end %>

    <% status_options = {"status_with_owner" => [translation(".owner_registration"), translation(".owner_registration_description")],
        "status_stolen" => [translation(".stolen"), translation(".stolen_description", cycle_type:)],
        "status_impounded" => [translation(".found"), translation(".found_description", cycle_type:)]}.map do |status, (title, description)|
        content = safe_join([content_tag(:span, title, class: "tw:block tw:font-semibold"),
          content_tag(:span, description, class: "tw:block tw:text-xs tw:text-[#9a9aa2] tw:dark:text-gray-500")])
        {display: title, value: status, content:}
      end %>

    <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :status,
        label_text: translation(".registration_type"), required: true)) do %>
      <%= render UI::Forms::Combobox::Component.new(name: :status, form: f, required: true,
          value: @b_param.status, options: status_options, rich_display: :stacked,
          dialog_label: translation(".registration_type"), no_js: true) %>
    <% end %>

    <%= render Register::SectionLabel::Component.new(text: contact_section_label, divider: true) %>

    <%#
      Heads the section it decides the contents of. Only an organization assigned
      automatically - one a link named isn't up for debate
    %>

    <% if auto_organization.present? %>
      <div
        class="
          tw:mb-4 tw:rounded-sm tw:border tw:border-gray-300 tw:bg-gray-50
          tw:p-3 tw:dark:border-gray-600 tw:dark:bg-gray-700
        "
      >
        <%= render UI::Forms::Checkbox::Component.new(name: :register_with_organization,
            checked: organization.present?,
            label: translation(".register_with_org", org_name: auto_organization.short_name),
            input_data: {"register--organization-target": "checkbox",
              action: "change->register--organization#toggle"}) %>

        <p
          class="
            tw:mt-1 tw:mb-0 tw:pl-6 tw:text-xs tw:text-gray-500
            tw:dark:text-gray-400
          "
        >
          <%= translation(".register_with_org_description", org_name: auto_organization.short_name) %>
        </p>
      </div>
    <% end %>

    <div class="tw:mb-4">
      <span class="twlabel"><%= translation(".email") %></span>

      <p
        class="
          tw:mt-1 tw:mb-0 tw:flex tw:items-center tw:justify-between
          tw:gap-2 tw:rounded-sm tw:border tw:border-gray-300 tw:bg-gray-50
          tw:px-2.5 tw:py-1.5 tw:dark:border-gray-600 tw:dark:bg-gray-700
        "
      >
        <span class="tw:truncate tw:text-base tw:text-gray-600 tw:dark:text-gray-300">
          <%= @b_param.owner_email %>
        </span>

        <%= render UI::Badge::Component.new(text: translation(".from_step_1"), size: :xs) %>
      </p>
    </div>

    <%# Who the registration is for - a signed in registrant's own address arrives with a name %>
    <% if user_name_required? %>
      <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :user_name,
          label_text: translation(".owner_name"), required: true,
          html_options: {value: bike["user_name"], autocomplete: "name",
            placeholder: translation(".owner_name_placeholder")}) %>
    <% end %>

    <%# The organization's own asks sit under its heading, alongside the contact fields %>
    <div
      class="<%= "tw:hidden" if organization_dropped? %>"
      data-register--organization-target="field"
    >
      <% if show_extra_registration_number? %>
        <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :extra_registration_number,
            label_text: reg_label("reg_extra_registration_number", translation(".additional_serial_sticker_number")),
            html_options: {value: bike["extra_registration_number"], autocomplete: "off", class: "tw:font-mono"}) %>
      <% end %>

      <% if show_organization_affiliation? %>
        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :organization_affiliation,
            label_text: reg_label("reg_organization_affiliation", translation(".affiliation", org_name: reg_organization.short_name)))) do %>
          <%= render UI::Forms::Select::Component.new(form_builder: f, attribute: :organization_affiliation,
              option_tags: reg_organization.organization_affiliation_options,
              options: {selected: bike["organization_affiliation"], include_blank: true}) %>
        <% end %>
      <% end %>

      <% if show_student_id? %>
        <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :student_id,
            label_text: reg_label("reg_student_id", translation(".student_id")),
            required: reg_organization.enabled?("require_reg_student_id"),
            html_options: {value: bike["student_id"], autocomplete: "off"}) %>
      <% end %>
    </div>

    <div
      class="<%= "tw:hidden" unless show_phone? %>"
      data-register--status-fields-target="field"
      data-statuses="<%= phone_statuses.to_json %>"
      data-texts="<%= phone_required_texts.to_json %>"
    >
      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :phone, kind: :telephone_field,
          label_text: translation(".phone"), wrapper_class: "tw:mb-6",
          required: phone_required?, required_toggleable: true,
          html_options: {value: bike["phone"], placeholder: translation(".phone_placeholder")})) do |group| %>
        <% group.with_helper_text do %>
          <%= tag.span(phone_required_texts[@b_param.status], data: {required_helper: true},
              hidden: !phone_required?) %>
        <% end %>
      <% end %>
    </div>

    <%#
      Skipped entirely without an organization asking for it - the country and state
      selects are ~300 options and two queries that no status could ever reveal
    %>

    <% if address_statuses.any? %>
      <div
        class="tw:mb-6 <%= "tw:hidden" unless show_address? %>"
        data-register--status-fields-target="field"
        data-register--organization-target="statusField"
        data-organization-off="<%= "true" if organization_dropped? %>"
        data-statuses="<%= address_statuses.to_json %>"
      >
        <%# _attributes explicitly: form_with has no model to infer nested attributes from %>
        <%= f.fields_for :address_record_attributes, address_record do |address_form| %>
          <%= render UI::Forms::AddressGroup::Component.new(form_builder: address_form,
              required: reg_organization.enabled?("require_reg_address")) %>
        <% end %>
      </div>
    <% end %>

    <%#
      The label is a block so register--status-fields has a span to rewrite: which
      statuses have a step after this form is decided by the combobox above
    %>

    <%= render(UI::Button::Component.new(color: :primary, size: :lg, type: "submit",
        spinner: true, html_class: "tw:w-full")) do %>
      <span
        data-register--status-fields-target="submitLabel"
        data-texts="<%= submit_texts.to_json %>"
      >
        <%= submit_text %>
      </span>
    <% end %>

    <%= render Register::BackLink::Component.new(href: register_path(b_param_token: @b_param.id_token, step: 1)) %>
  <% end %>
<% end %>
