<%= render Register::Page::Component.new do %>
  <%= render Register::Progress::Component.new(step: 2, total: 2) %>

  <%= render UI::Alert::Component.new(kind: :purple, text: translation(".confirmation_link_sent"),
      icon: helpers.inline_svg_tag("icons/envelope.svg", class: "tw:-mb-0.5 tw:h-4 tw:w-4 tw:shrink-0", aria_hidden: true)) %>

  <%= render UI::Header::Component.new(text: translation(".add_your_bikes_details"), subtitle: translation(".easier_to_recover")) %>

  <%= form_with(url: register_path, method: :patch, scope: :bike,
      data: {controller: "form-persist", form_persist_key_value: "register-details-#{@b_param.id_token}",
        action: "input->form-persist#save hw-combobox:selection->form-persist#save submit->form-persist#clear"}) do |f| %>
    <%= hidden_field_tag :b_param_token, @b_param.id_token %>

    <% bike = @b_param.bike %>
    <% color_displays = Color.pluck(:id, :display).to_h %>

    <% color_combobox_options = Color.select_options.map do |name, id|
        swatch = render(UI::ColorSwatch::Component.new(display: color_displays[id], name:, size: :sm))
        {value: id, display: name, content: content_tag(:span, safe_join([swatch, name]), class: "tw:inline-flex tw:items-center tw:gap-2")}
      end %>

    <% optional_badge = render(UI::Badge::Component.new(text: translation(".optional"), size: :xs)) %>

    <%= render Register::SectionLabel::Component.new(text: translation(".bike_details")) %>

    <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :frame_model,
        label_text: translation(".model"),
        html_options: {value: bike["frame_model"], placeholder: translation(".model_placeholder")}) %>

    <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :year,
        label_text: translation(".model_year"),
        html_options: {value: bike["year"], inputmode: "numeric",
          placeholder: translation(".model_year_placeholder"), class: "tw:font-mono"}) %>

    <div class="tw:mb-4" data-controller="register--additional-colors">
      <%= f.label :primary_frame_color_id, class: "twlabel" do %>
        <%= translation(".color") %>
        <%= render UI::Badge::Component.new(text: translation(".up_to_3"), size: :xs) %>
      <% end %>

      <%= render UI::Forms::Combobox::Component.new(name: :primary_frame_color_id, form: f,
          value: @b_param.primary_frame_color_id, options: color_combobox_options,
          placeholder: translation(".primary_color_blank"), rich_display: true) %>

      <% {secondary_frame_color_id: translation(".second_color_blank"), tertiary_frame_color_id: translation(".third_color_blank")}.each do |field, blank_label| %>
        <% value = bike[field.to_s] %>

        <div
          class="tw:mt-2 tw:flex tw:items-center tw:gap-3 <%= "tw:hidden" if value.blank? %>"
          data-register--additional-colors-target="row"
        >
          <%= render UI::Forms::Combobox::Component.new(name: field, form: f,
              value:, options: color_combobox_options, placeholder: blank_label,
              rich_display: "tw:flex-1") %>

          <%= render UI::Button::Component.new(text: "×", color: :link,
              html_class: "tw:shrink-0 tw:text-xl tw:leading-none tw:font-bold",
              aria: {label: translation(".remove_additional_color")},
              data: {action: "register--additional-colors#remove"}) %>
        </div>
      <% end %>

      <% all_colors_shown = %w[secondary_frame_color_id tertiary_frame_color_id].all? { |field| bike[field].present? } %>

      <div
        class="tw:mt-2 <%= "tw:hidden" if all_colors_shown %>"
        data-register--additional-colors-target="addButton"
      >
        <%= render UI::Button::Component.new(text: "+ #{translation(".add_another_color")}",
            color: :link, html_class: "tw:text-xs tw:font-bold",
            data: {action: "register--additional-colors#add"}) %>
      </div>
    </div>

    <div class="tw:mb-4" data-controller="register--frame-size">
      <span class="twlabel">
        <%= translation(".frame_size") %><%= optional_badge %>
      </span>

      <div class="tw:mt-2 tw:mb-2">
        <%= render UI::Forms::RadioButtonGroup::Component.new(name: "bike[frame_size]", full_width: true,
            selected: bike["frame_size"],
            data: {"register--frame-size-target": "chip", action: "change->register--frame-size#pickChip"},
            entries: %w[xs s m l xl].map { |size| {value: size, label: size.upcase} }) %>
      </div>

      <div class="tw:flex tw:items-center tw:gap-2.5">
        <span class="tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">
          <%= translation(".or") %>
        </span>

        <div class="tw:flex tw:flex-1 tw:items-center">
          <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :frame_size_number, kind: :number_field,
              html_options: {value: bike["frame_size_number"], step: 0.5, min: 0, placeholder: translation(".enter_size"),
                class: "tw:rounded-r-none",
                data: {"register--frame-size-target": "number", action: "input->register--frame-size#pickNumber"}}) %>

          <%= f.select :frame_size_unit, [[translation(".inches"), "in"], [translation(".cm"), "cm"]],
              {selected: bike["frame_size_unit"] || "in"},
              class: "tw:self-stretch tw:rounded-r-sm tw:border tw:border-l-0
                tw:border-gray-300 tw:bg-gray-50 tw:px-3 tw:py-1.5
                tw:text-sm tw:font-medium tw:text-gray-500
                tw:dark:border-gray-600 tw:dark:bg-gray-700
                tw:dark:text-gray-400" %>
        </div>
      </div>
    </div>

    <div class="tw:mb-4" data-controller="register--photo">
      <span class="twlabel">
        <%= translation(".attach_photo") %>
        <%= optional_badge %>
      </span>

      <%= f.file_field :image, accept: ImageUploader.permitted_extensions.join(","),
          class: "tw:hidden",
          data: {
            "register--photo-target": "input",
            action: "change->register--photo#changed"
          } %>

      <div class="tw:mt-2 tw:grid tw:grid-cols-2 tw:gap-2">
        <%= render UI::Button::Component.new(text: translation(".take_photo"), color: :secondary,
            data: {action: "register--photo#takePhoto"}) %>

        <%= render UI::Button::Component.new(text: translation(".upload"), color: :secondary,
            data: {action: "register--photo#upload"}) %>
      </div>

      <p
        class="
          tw:mt-1.5 tw:truncate tw:text-xs tw:font-medium tw:text-gray-700
          tw:dark:text-gray-300
        "
        data-register--photo-target="filename"
      ></p>

      <p class="tw:mt-1.5 tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">
        <%= translation(".database_public_note") %>
      </p>
    </div>

    <div class="tw:mb-4" data-controller="ui--collapse register--serial">
      <div class="tw:flex tw:items-center tw:justify-between tw:gap-2">
        <%= f.label :serial_number, class: "twlabel" do %>
          <%= translation(".serial_number") %>
          <%= tag.span("*", class: "tw:text-red-600") %>
        <% end %>

        <%= render UI::Button::Component.new(text: translation(".wheres_my_serial"),
            color: :link, html_class: "tw:text-xs tw:font-bold", data: {action: "ui--collapse#toggle"}) %>
      </div>

      <% made_without_serial = bike["serial_number"] == "made_without_serial" %>

      <div
        class="<%= "tw:hidden" if made_without_serial %>"
        data-register--serial-target="serialSection"
      >
        <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :serial_number, kind: :text_field, required: true,
            html_options: {value: bike["serial_number"], placeholder: translation(".serial_placeholder"),
              autocomplete: "off", data: {"register--serial-target": "input"},
              class: ["tw:mt-1 tw:font-mono", ("tw:text-gray-400" if bike["serial_number"] == "unknown")].compact.join(" ")}) %>

        <%= render UI::Forms::Checkbox::Component.new(name: :serial_missing, value: true,
            checked: bike["serial_number"] == "unknown", label: translation(".missing_serial"), class_name: "tw:mt-2",
            input_data: {"register--serial-target": "missing", action: "change->register--serial#toggleMissing"}) %>

        <div
          class="tw:mt-1.5 <%= "tw:hidden" unless bike["serial_number"] == "unknown" %>"
          data-register--serial-target="madeWithoutLink"
        >
          <%= render UI::Button::Component.new(text: translation(".without_serial_number"),
              color: :link, html_class: "tw:text-xs tw:font-bold",
              data: {open_modal: "made-without-serial-modal"}) %>
        </div>
      </div>

      <div
        class="<%= "tw:hidden" unless made_without_serial %>"
        data-register--serial-target="madeWithoutRow"
      >
        <%= render UI::Forms::Checkbox::Component.new(name: :made_without_serial_checkbox, value: true,
            checked: made_without_serial, label: translation(".without_serial"), class_name: "tw:mt-2",
            input_data: {"register--serial-target": "madeWithoutCheckbox", action: "change->register--serial#toggleMadeWithout"}) %>
      </div>

      <%= render UI::Modal::Component.new(id: "made-without-serial-modal", title: translation(".are_you_certain")) do |modal| %>
        <% modal.with_body do %>
          <p class="tw:mb-2"><%= translation(".very_very_few_bikes_html") %></p>

          <ul class="tw:mb-2 tw:list-disc tw:pl-5">
            <li><%= translation(".was_made_before_1970") %></li>

            <li class="tw:list-none tw:text-center">
              — <%= translation(".or") %> —
            </li>

            <li><%= translation(".is_a_handmade_frame") %></li>
          </ul>

          <p class="tw:mb-1">
            <%= translation(".it_probably_has_a_serial_number") %>
          </p>

          <p class="tw:mb-4">
            <%= translation(".read_how_to_find_html",
              how_to_find_link: link_to(translation(".how_to_find_serial"), serials_path, target: "_blank", class: "twlink")) %>
          </p>

          <div class="tw:grid tw:grid-cols-2 tw:gap-4">
            <div>
              <%= render UI::Button::Component.new(text: translation(".nevermind"), color: :secondary,
                  html_class: "tw:w-full", data: {action: "ui--modal#close"}) %>

              <p class="tw:mt-1 tw:mb-0 tw:text-center tw:text-xs tw:text-gray-500">
                <%= translation(".i_just_dont_know_the_serial") %>
              </p>
            </div>

            <div>
              <%= render UI::Button::Component.new(text: translation(".im_100_sure"), color: :error,
                  html_class: "tw:w-full",
                  data: {action: "register--serial#confirmMadeWithout ui--modal#close"}) %>

              <p class="tw:mt-1 tw:mb-0 tw:text-center tw:text-xs tw:text-gray-500">
                <%= translation(".without_serial") %>
              </p>
            </div>
          </div>
        <% end %>
      <% end %>

      <div
        class="
          tw:mt-2 tw:hidden tw:rounded-sm tw:border tw:border-gray-200
          tw:bg-gray-50 tw:p-4 tw:dark:border-gray-700 tw:dark:bg-gray-900
        "
        data-ui--collapse-target="content"
      >
        <p class="tw:mb-2 tw:text-xs tw:text-gray-600 tw:dark:text-gray-400">
          <%= translation(".serial_help_intro") %>
        </p>

        <ul
          class="
            tw:mb-3 tw:list-disc tw:pl-5 tw:text-xs tw:text-gray-600
            tw:dark:text-gray-400
          "
        >
          <li><%= translation(".serial_location_bottom_bracket") %></li>
          <li><%= translation(".serial_location_head_tube") %></li>
          <li><%= translation(".serial_location_rear_dropouts") %></li>
        </ul>

        <div class="tw:mb-3 tw:grid tw:grid-cols-3 tw:gap-2">
          <% {"serials/serial_bb.jpg" => translation(".bottom_bracket"),
              "serials/serial_headtube.jpg" => translation(".head_tube"),
              "serials/serial_pinsch.jpg" => translation(".rear_dropouts")}.each do |image, caption| %>
            <figure class="tw:m-0">
              <%= image_tag image, alt: caption, class: "tw:aspect-square tw:w-full tw:rounded-sm tw:object-cover" %>

              <figcaption
                class="
                  tw:mt-1 tw:text-center tw:text-xs tw:font-medium
                  tw:text-gray-500 tw:dark:text-gray-400
                "
              >
                <%= caption %>
              </figcaption>
            </figure>
          <% end %>
        </div>

        <%= link_to translation(".view_serial_guide"), serials_path, class: "twlink tw:text-xs tw:font-semibold" %>
      </div>
    </div>

    <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :bike_sticker,
        label_text: translation(".sticker_number"),
        html_options: {value: @b_param.bike_sticker_code, placeholder: translation(".sticker_placeholder"),
          autocomplete: "off", class: "tw:font-mono"}) %>

    <div class="tw:mb-4">
      <%= f.label :status, translation(".registration_type"), class: "twlabel" %>

      <% status_options = {"status_with_owner" => [translation(".owner_registration"), translation(".owner_registration_description")],
          "status_stolen" => [translation(".stolen"), translation(".stolen_description")],
          "status_impounded" => [translation(".found"), translation(".found_description")]}.map do |status, (title, description)|
          content = safe_join([content_tag(:span, title, class: "tw:block tw:font-semibold"),
            content_tag(:span, description, class: "tw:block tw:text-xs tw:text-[#9a9aa2] tw:dark:text-gray-500")])
          {display: title, value: status, content:}
        end %>

      <%= render UI::Forms::Combobox::Component.new(name: :status, form: f,
          value: @b_param.status || "status_with_owner", options: status_options) %>
    </div>

    <%= render Register::SectionLabel::Component.new(text: translation(".additional_contact_info"), divider: true) %>

    <div class="tw:mb-4">
      <span class="twlabel"><%= translation(".email") %></span>

      <p
        class="
          tw:mt-1 tw:mb-0 tw:flex tw:items-center tw:justify-between
          tw:gap-2 tw:rounded-sm tw:border tw:border-gray-300 tw:bg-gray-50
          tw:px-2.5 tw:py-1.5 tw:dark:border-gray-600 tw:dark:bg-gray-700
        "
      >
        <span class="tw:truncate tw:text-base tw:text-gray-600 tw:dark:text-gray-300">
          <%= @b_param.owner_email %>
        </span>

        <%= render UI::Badge::Component.new(text: translation(".from_step_1"), size: :xs) %>
      </p>
    </div>

    <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :phone, kind: :telephone_field,
        label_text: translation(".phone"), wrapper_class: "tw:mb-6",
        html_options: {value: bike["phone"], placeholder: translation(".phone_placeholder")}) %>

    <%= render UI::Button::Component.new(text: translation(".complete_registration"),
        color: :primary, size: :lg, kind: :submit, spinner: true, html_class: "tw:w-full") %>

    <p class="tw:mt-3 tw:mb-0 tw:text-center">
      <%= link_to "← #{translation(".back")}", register_path(b_param_token: @b_param.id_token, step: 1),
          class: "tw:text-sm tw:font-medium tw:text-gray-500 tw:no-underline tw:hover:text-gray-700 tw:dark:text-gray-400" %>
    </p>
  <% end %>
<% end %>
