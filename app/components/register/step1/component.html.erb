<%= render Register::Page::Component.new(data: {controller: "register--heading",
    "register--heading-names-value": cycle_type_names.to_json,
    action: "hw-combobox:selection->register--heading#update"}) do %>
  <%= render Register::Progress::Component.new(step: 1, total: 2) %>
  <%= render UI::Header::Component.new(text: heading_text, subtitle: translation(".just_the_essentials")) %>

  <% if @b_param.errors.any? %>
    <%= render UI::Alert::Component.new(kind: :error, text: @b_param.errors.full_messages.to_sentence) %>
  <% end %>

  <%= form_with(model: @b_param, url: register_path, method: :post, scope: :b_param,
      data: {controller: "autofocus"}) do |f| %>
    <%= hidden_field_tag :b_param_token, @b_param.id_token %>

    <%# So the organization survives a submission that has to build a registration %>
    <%= hidden_field_tag :organization_id, organization.id if organization.present? %>

    <%= render Register::SectionLabel::Component.new(text: translation(".bike_info_html", cycle_type: cycle_type_tag)) %>

    <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :manufacturer_id,
        label_text: Manufacturer.model_name.human, required: true)) do %>
      <%# The async combobox reads f.object.manufacturer to display the saved value %>
      <%= render UI::Forms::ComboboxManufacturer::Component.new(form: f,
          frame_maker: true, required: true) %>
    <% end %>

    <div
      class="tw:mb-4"
      data-controller="register--propulsion"
      data-register--propulsion-always-motorized-value="<%= CycleType::ALWAYS_MOTORIZED.to_json %>"
      data-register--propulsion-never-motorized-value="<%= CycleType::NEVER_MOTORIZED.to_json %>"
    >
      <% cycle_type_options = CycleType.select_options(traditional_bike: true).map do |label, slug|
          base, parens = label.split(" (", 2)
          content = if parens
            safe_join([base, " ", content_tag(:span, "(#{parens}", class: "tw:text-[#9a9aa2] tw:dark:text-gray-500")])
          else
            label
          end
          {display: label, value: slug, content:}
        end %>

      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :cycle_type,
          label_text: translation(".vehicle_type"), required: true, wrapper_class: "tw:mb-0")) do %>
        <%= render UI::Forms::Combobox::Component.new(name: :cycle_type, form: f, required: true,
            value: @b_param.cycle_type, options: cycle_type_options, rich_display: true) %>
      <% end %>

      <%= render UI::Forms::Checkbox::Component.new(name: :propulsion_type_motorized, value: true,
          checked: @b_param.motorized?, label: translation(".electric_motorized"), class_name: "tw:mt-3",
          data: {"register--propulsion-target": "motorizedWrapper"},
          input_data: {"register--propulsion-target": "motorized", action: "change->register--propulsion#update"}) %>

      <p class="tw:mt-1.5 tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">
        <%= translation(".electric_helper") %>
      </p>
    </div>

    <%= render Register::SectionLabel::Component.new(text: translation(".your_info"), divider: true) %>

    <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :owner_email, kind: :email_field,
        label_text: translation(".email"), required: true, wrapper_class: "tw:mb-6",
        html_options: {value: @b_param.owner_email, placeholder: translation(".email_placeholder")}) %>

    <%= render UI::Button::Component.new(text: translation(".next"), color: :primary, size: :lg,
        kind: :submit, spinner: true, html_class: "tw:w-full") %>

    <% if confirmation_email_pending? %>
      <p
        class="
          tw:mt-3 tw:text-center tw:text-xs tw:text-gray-500
          tw:dark:text-gray-400
        "
      >
        <%= translation(".no_need_to_wait") %>
      </p>
    <% end %>

    <% if returned_from_step_2? %>
      <p class="tw:mt-3 tw:mb-0 tw:text-center">
        <%= render UI::Button::Component.new(text: translation(".start_over"), color: :link,
            html_class: "tw:text-sm tw:font-medium tw:text-gray-500 tw:hover:text-gray-700 tw:hover:no-underline tw:dark:text-gray-400",
            data: {open_modal: "start-over-modal"}) %>
      </p>
      <%= render UI::Modal::Component.new(id: "start-over-modal", title: translation(".start_over_certain")) do |modal| %>
        <% modal.with_body do %>
          <p class="tw:mb-0">
            <%= translation(".start_over_discards", cycle_type:) %>
          </p>

          <div class="tw:mt-5 tw:text-center">
            <%= render UI::ButtonLink::Component.new(text: translation(".yes_start_over"), color: :error,
                href: new_register_path(b_param_token: false)) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
