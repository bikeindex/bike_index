<div class="tw:mb-3">
  <% if electric_detected? %>
    <%= render UI::Badge::Component.new(text: translation(".electric_detected"), color: :warning) %>
  <% elsif @page.organization_specific && badge_name.present? %>
    <%= render UI::Badge::Component.new(text: badge_name, color: :notice) %>
  <% end %>
</div>

<%# uncap: the org preview renders in a layout that upper-cases headings; the flow's doesn't %>
<%= render UI::Header::Component.new(text: @page.heading_text, subtitle: @page.subtitle, html_class: "uncap") %>

<% if @page.image_url.present? %>
  <%= image_tag @page.image_url, alt: "", class: "tw:mb-5 tw:w-full tw:rounded-lg tw:object-cover" %>
<% end %>

<%= render Register::SectionLabel::Component.new(text: @page.title) do %>
  <% if sequence.faq_url.present? %>
    <%= render UI::Tooltip::Component.new(text: translation(".have_questions")) do |tooltip| %>
      <% tooltip.with_body do %>
        <%= translation(".have_questions") %>
        <%= link_to translation(".read_the_faq.#{sequence.kind}"), sequence.faq_url, target: "_blank", rel: "noopener", class: "twlink" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render UI::Card::Component.new(divided: true) do %>
  <% @page.bullets.each_with_index do |bullet, index| %>
    <label
      class="
        tw:mb-0 tw:flex tw:cursor-pointer tw:items-start tw:gap-3 tw:px-4
        tw:py-3.5 tw:text-sm tw:font-normal
      "
    >
      <%= render Register::RuleCheckbox::Component.new(name: checkbox_name(index), checked: @checked) %>

      <span><%= sanitize bullet %></span>
    </label>
  <% end %>
<% end %>
