<%= render Register::Page::Component.new do %>
  <%= render Register::Progress::Component.new(step: @step.to_i, total: BikeServices::Register.total_steps(@sequence)) %>

  <%= render Register::AcknowledgmentProgress::Component.new(number: position + 1,
      total: BikeServices::Register.acknowledgment_step_count(@sequence)) %>

  <%= form_with(url: acknowledge_register_path, method: :patch,
      data: {controller: "register--acknowledgment"}) do %>
    <%= hidden_field_tag :b_param_token, @b_param.id_token %>
    <%= hidden_field_tag :step, @step %>

    <%= render Register::PageContent::Component.new(page:, control: ->(index) {
      check_box_tag "acknowledged[#{index}]", "1", acknowledged?,
        class: "tw:mt-0.5 tw:h-4 tw:w-4 tw:shrink-0 tw:cursor-pointer",
        data: {"register--acknowledgment-target": "checkbox", action: "change->register--acknowledgment#update"}
    }) do |content| %>
      <% content.with_badge do %>
        <% if first? %>
          <%= render UI::Badge::Component.new(text: translation(".electric_detected"), color: :warning) %>
        <% elsif page.organization_specific && organization_name.present? %>
          <%= render UI::Badge::Component.new(text: organization_name, color: :notice) %>
        <% end %>
      <% end %>

      <% content.with_faq do %>
        <% if @sequence.faq_url.present? %>
          <%= render UI::Tooltip::Component.new(text: translation(".have_questions")) do |tooltip| %>
            <% tooltip.with_body do %>
              <%= translation(".have_questions") %>
              <%= link_to translation(".read_the_faq"), @sequence.faq_url, target: "_blank", rel: "noopener", class: "twlink" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render UI::Button::Component.new(text: translation(".continue"), color: :primary, size: :lg,
        kind: :submit, spinner: true, disabled: true, html_class: "tw:mt-5 tw:w-full",
        data: {"register--acknowledgment-target": "submit"}) %>

    <%= render Register::BackLink::Component.new(href: previous_path) %>
  <% end %>
<% end %>
