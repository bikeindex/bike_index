<%# uncap: the org preview renders in a layout that upper-cases headings; the flow's doesn't %>
<%= render UI::Header::Component.new(text: translation(".youre_almost_done"), subtitle:, html_class: "uncap") %>

<%= render UI::Card::Component.new(divided: true) do %>
  <% @pages.each_with_index do |page, index| %>
    <div class="tw:flex tw:items-center tw:justify-between tw:gap-3 tw:px-4 tw:py-3">
      <span class="tw:flex tw:items-center tw:gap-2.5">
        <span
          class="
            tw:flex tw:h-5.5 tw:w-5.5 tw:shrink-0 tw:items-center
            tw:justify-center tw:rounded-full tw:bg-green-100
            tw:text-green-600 tw:dark:bg-green-950 tw:dark:text-green-400
          "
        >
          <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:h-3 tw:w-3", aria_hidden: true) %>
        </span>

        <span class="tw:text-sm tw:font-semibold"><%= page.title %></span>
      </span>

      <% if @page_path.present? %>
        <%= link_to translation(".review"), @page_path.call(index),
            class: "twlink tw:shrink-0 tw:text-xs tw:font-bold tw:tracking-wide tw:uppercase" %>
      <% end %>
    </div>
  <% end %>
<% end %>
