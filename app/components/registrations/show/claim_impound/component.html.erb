<%= render(UI::Card::Component.new) do %>
  <div data-controller="registrations--show--contact-owner">
    <h2
      class="
        tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
        tw:uppercase
      "
    >
      <%= translation(".does_this_look_like_your_bike") %>
    </h2>

    <div class="tw:mt-3">
      <% if sign_in_redirect %>
        <%= render(UI::ButtonLink::Component.new(href: sign_in_redirect, text: translation(".claim_impounded_bike"), color: :purple)) %>
      <% elsif stolen_record_options.any? %>
        <%= render(UI::Button::Component.new(
          text: translation(".claim_impounded_bike"),
          color: :purple,
          data: {"registrations--show--contact-owner-target": "trigger", action: "registrations--show--contact-owner#reveal"}
        )) %>
        <div
          data-registrations--show--contact-owner-target="form"
          class="tw:hidden"
        >
          <%= form_with(model: impound_claim, url: impound_claims_path, data: {controller: "csrf-refresh"}) do |form| %>
            <%= form.hidden_field :impound_record_id, value: impound_record.id %>

            <%= form.label :stolen_record_id, translation(".select_your_stolen_bike"), class: "twlabel tw:mt-1" %>

            <%= form.select :stolen_record_id, stolen_record_options,
              {prompt: translation(".choose_stolen_bike")},
              {required: true, class: "twinput tw:w-full"} %>

            <div class="tw:mt-3">
              <%= render(UI::Button::Component.new(text: translation(".open_claim"), color: :purple, kind: :submit)) %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="tw:text-sm tw:opacity-65">
          <%= translation(".need_stolen_bike_html", add_link: link_to(translation(".add_a_stolen_bike"), new_bike_path(status: "status_stolen"), class: "twlink", target: "_blank", rel: "noopener")) %>
        </p>
      <% end %>
    </div>
  </div>
<% end %>
