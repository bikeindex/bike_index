<%= render(UI::Card::Component.new) do %>
  <h2 class="tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2] tw:uppercase">
    <%= translation(".impound_details") %>
  </h2>

  <%= render(Registrations::Show::Map::Component.new(latitude: impound_record.latitude_public, longitude: impound_record.longitude_public, precise: impound_record.show_address)) %>

  <%= render(UI::DefinitionList::Container::Component.new(term: :below)) do %>
    <% if impound_record.formatted_address_string.present? %>
      <%= render(UI::DefinitionList::Row::Component.new(label: translation(".location"), value: impound_record.formatted_address_string)) %>
    <% end %>

    <%= render(UI::DefinitionList::Row::Component.new(label: translation(".impounded_at"), value: impound_record.impounded_at, time_localizer_settings: %i[preciseTime originalTimeZone])) %>
  <% end %>
<% end %>
