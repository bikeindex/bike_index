<div
  class="
    tw:mx-auto tw:flex tw:w-full tw:max-w-[1440px] tw:flex-col tw:gap-6
    tw:px-2
  "
>
  <div class="tw:flex tw:flex-wrap tw:items-start tw:justify-between tw:gap-4">
    <div>
      <div class="tw:mb-2 tw:flex tw:flex-wrap tw:items-center tw:gap-2">
        <%= render(Registrations::Show::ViewSwitcher::Component.new(bike: @bike, current_view: [@org_role, @organization], available_views: @available_views, label: @organization.short_name, color: org_chip_color, solid: false, role_label: role_label, current_user: @current_user)) %>
      </div>

      <h1 class="tw:text-2xl tw:font-bold"><%= title %></h1>

      <p class="tw:opacity-65">
        <%= render(Registrations::Show::Subtitle::Component.new(bike: @bike)) %>
      </p>

      <div class="tw:mt-2 tw:flex tw:flex-wrap tw:gap-2">
        <% if @bike.claimed? && !unregistered? %>
          <%= render(UI::Badge::Component.new(text: translation(".claimed"), color: :notice, indicator: true)) %>
        <% end %>

        <%= render(Registrations::Show::Status::Component.new(bike: @bike)) %>
      </div>
    </div>
  </div>

  <%= render(current_alerts_component) %>

  <%= render(Registrations::Show::OrgTopActions::Wrapper::Component.new(bike: @bike, organization: @organization, org_role: @org_role, current_user: @current_user, display_dev_info: @display_dev_info)) %>

  <%# tw:contents collapses the column wrappers on mobile, so tw:order can interleave them %>

  <div class="tw:grid tw:gap-6 tw:lg:grid-cols-3">
    <div class="tw:contents tw:lg:col-span-2 tw:lg:flex tw:lg:flex-col tw:lg:gap-6">
      <% archive_images = @bike.public_images.select(&:image_url) %>

      <% if archive_images.any? %>
        <%= render(UI::Card::Component.new) do %>
          <h2
            class="
              tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
              tw:uppercase
            "
          >
            <%= translation(".photo_archive") %>
          </h2>

          <ul class="tw:mt-3 tw:flex tw:flex-wrap tw:gap-3">
            <% archive_images.each do |public_image| %>
              <li>
                <a
                  href="<%= public_image.image_url %>"
                  target="_blank"
                  rel="noopener"
                  class="
                    tw:block tw:size-24 tw:overflow-hidden tw:rounded-lg
                    tw:border tw:border-gray-200 tw:transition
                    tw:hover:border-[#715eb2] tw:dark:border-gray-700
                  "
                >
                  <%= image_tag(public_image.image_url(:small), alt: public_image.image_alt, class: "tw:size-full tw:object-cover") %>
                </a>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <%= render(Registrations::Show::StolenDetails::Component.new(bike: @bike, current_user: @current_user)) %>
      <%= render(Registrations::Show::ImpoundDetails::Component.new(bike: @bike, organization: @organization)) %>

      <%= render(Registrations::Show::BikeIndexCard::Component.new(bike: @bike, term: :below)) %>

      <div class="tw:order-5 tw:lg:order-none">
        <%= render(Registrations::Show::BikeDetails::Component.new(bike: @bike, serial_user: @current_user)) %>
      </div>

      <% if @bike.description.present? %>
        <%= render(UI::Card::Component.new(additional_classes: "tw:order-6 tw:lg:order-none")) do %>
          <h2
            class="
              tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
              tw:uppercase
            "
          >
            <%= translation(".about_this_bike", bike_type: @bike.type) %>
          </h2>

          <p class="tw:mt-2"><%= @bike.description %></p>
        <% end %>
      <% end %>

      <% if show_notes? %>
        <%= render(UI::Card::Component.new(additional_classes: "tw:order-4 tw:lg:order-none")) do %>
          <h2
            class="
              tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
              tw:uppercase
            "
          >
            <%= translation(".internal_notes") %>
          </h2>

          <% if bike_organization_note.present? %>
            <div
              class="
                tw:mt-3 tw:border-b tw:border-gray-100 tw:pb-3
                tw:dark:border-gray-800
              "
            >
              <p class="tw:text-sm"><%= bike_organization_note.body %></p>

              <p class="tw:mt-1 tw:text-xs tw:opacity-65">
                <%= translation(".note_by", user: bike_organization_note.user&.display_name) %>

                <%= render(UI::Time::Component.new(time: bike_organization_note.updated_at)) %>
              </p>
            </div>
          <% end %>

          <%= form_with(url: notes_url, method: :patch, class: "tw:mt-3", data: {controller: "csrf-refresh"}) do |f| %>
            <%= f.text_area :notes, value: bike_organization_note&.body, name: "notes", rows: 3, class: "twinput tw:w-full", placeholder: translation(".notes_placeholder") %>

            <div class="tw:mt-2 tw:flex tw:items-center tw:justify-between">
              <small class="tw:opacity-65">
                <%= translation(".posts_as", user: @current_user.display_name) %>
              </small>

              <%= f.submit translation(".post_note"), class: UI::Button::Component.build_classes(color: :primary, size: :sm) %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% component_list = Registrations::Show::ComponentList::Component.new(bike: @bike, collapsed: true) %>

      <% if component_list.render? %>
        <div class="tw:order-7 tw:lg:order-none">
          <%= render(component_list) %>
        </div>
      <% end %>
    </div>

    <div class="tw:contents tw:lg:flex tw:lg:flex-col tw:lg:gap-6">
      <%= render(UI::Card::Component.new(additional_classes: "tw:order-1 tw:lg:order-none")) do %>
        <h2
          class="
            tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
            tw:uppercase
          "
        >
          <%= translation(".owner_access") %>
        </h2>

        <div class="tw:mt-3">
          <% if unregistered? %>
            <p class="tw:text-sm tw:opacity-65">
              <%= translation(".unregistered_owner", bike_type: @bike.type) %>
            </p>
          <% else %>
            <%= render(UI::DefinitionList::Container::Component.new(term: :right_align)) do %>
              <% if organization_registered? %>
                <%= info_row(translation(".owner_name"), @bike.owner_name) %>
              <% end %>

              <% if show_contact? %>
                <%= info_row(translation(".owner_email")) do %>
                  <% if @bike.owner_email.present? %>
                    <%= link_to(@bike.owner_email, "mailto:#{@bike.owner_email}", class: "twlink") %>
                  <% end %>
                <% end %>
                <%= info_row(translation(".owner_phone")) { render UI::PhoneDisplay::Component.new(phone: owner_phone) } %>
                <% owner_reg_field_rows.each do |label, value| %>
                  <%= info_row(label, value) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <% if staff? && (unregistered? || show_contact?) %>
          <div
            class="
              tw:mt-3 tw:flex tw:items-center tw:justify-between tw:gap-3
              tw:rounded-lg tw:bg-purple-50 tw:p-3 tw:dark:bg-purple-950
            "
          >
            <div class="tw:min-w-0">
              <p class="tw:text-sm tw:font-bold">
                <%= translation(".org_can_edit", org_name: @organization.short_name, bike_type: @bike.type) %>
              </p>

              <p class="tw:mt-1 tw:text-xs tw:opacity-65">
                <%= translation(".org_can_edit_sub", bike_type: @bike.type) %>
              </p>
            </div>

            <%= render(UI::ButtonLink::Component.new(href: edit_access_path, text: translation(".edit"), color: :secondary, size: :sm, html_class: "tw:flex-none")) %>
          </div>
        <% elsif !show_contact? && !unregistered? %>
          <div
            class="
              tw:mt-3 tw:rounded-lg tw:border tw:border-dashed
              tw:border-gray-300 tw:p-4 tw:dark:border-gray-700
            "
          >
            <p class="tw:font-bold"><%= contact_blocked_title %></p>

            <p class="tw:mt-1 tw:text-sm tw:opacity-65">
              <%= contact_blocked_message %>
            </p>
          </div>
        <% end %>
      <% end %>

      <%= render(UI::Card::Component.new(additional_classes: "tw:order-2 tw:lg:order-none")) do %>
        <h2
          class="
            tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
            tw:uppercase
          "
        >
          <%= translation(".registration_information") %>
        </h2>

        <div class="tw:mt-3">
          <% if registration_information? %>
            <%= render(UI::DefinitionList::Container::Component.new(term: :right_align)) do %>
              <% if @organization.enabled?("credibility_badges") %>
                <%= info_row(translation(".credibility")) do %>
                  <span class="tw:inline-flex tw:items-center tw:gap-1.5">
                    <span
                      class="
                        tw:inline-block tw:rounded tw:px-2 tw:py-0.5
                        tw:font-bold tw:text-white
                      "
                      style="background-color: <%= credibility_color %>"
                    >
                      <%= credibility_score %>
                    </span>

                    <%= render(UI::Tooltip::Component.new(text: translation(".credibility"))) do |tooltip| %>
                      <% tooltip.with_body do %>
                        <span class="tw:block tw:text-left">
                          <span class="tw:mb-1 tw:block tw:font-semibold">
                            Factors in score
                          </span>

                          <% credibility_badges.each do |badge, value| %>
                            <span class="tw:flex tw:justify-between tw:gap-4">
                              <span>
                                <%= CredibilityScorer.humanize_badge(badge) %>
                              </span>

                              <span class="<%= "tw:text-red-600" if value.negative? %>">
                                <%= value %>
                              </span>
                            </span>
                          <% end %>
                        </span>
                      <% end %>

                      <% tooltip.with_tooltip_button(class: "tw:inline-flex tw:size-4 tw:items-center tw:justify-center tw:rounded-full tw:bg-gray-200 tw:text-[10px] tw:font-bold tw:text-gray-600 tw:hover:bg-gray-300 tw:dark:bg-gray-700 tw:dark:text-gray-200") do %>
                        ?
                      <% end %>
                    <% end %>
                  </span>
                <% end %>
              <% end %>

              <% if @organization.enabled?("bike_stickers") %>
                <%= info_row(translation(".sticker")) do %>
                  <div class="tw:flex tw:flex-col tw:items-end tw:gap-0.5">
                    <% bike_stickers.each do |bike_sticker| %>
                      <span>
                        <%= sticker_link(bike_sticker) %>

                        <% if bike_sticker.claimed_at.present? %>
                          <span class="tw:text-xs tw:opacity-65">
                            <%= translation(".sticker_claimed") %>
                            <%= render(UI::Time::Component.new(time: bike_sticker.claimed_at)) %>
                          </span>
                        <% end %>
                      </span>
                    <% end %>

                    <% if staff? %>
                      <%= render(UI::Button::Component.new(text: translation(".link_sticker"), color: :link, html_class: "tw:text-xs", commandfor: "link-sticker-modal", command: "show-modal")) %>
                    <% end %>
                  </div>
                <% end %>
              <% end %>

              <% if organization_registered? %>
                <% if @organization.parent? %>
                  <%= info_row(translation(".organization_registered"), @bike.creation_organization&.name) %>
                <% end %>
                <% unless unregistered? %>
                  <%= info_row(translation(".claimed")) do %>
                    <% if @bike.claimed? %>
                      <%= render(UI::Time::Component.new(time: current_ownership.claimed_at)) %>
                    <% end %>
                  <% end %>
                <% end %>
                <% if show_contact? %>
                  <%= info_row(translation(".creator"), @bike.creator&.display_name) %>
                <% end %>
                <%= info_row(translation(".creation_source")) { render(Org::OriginDisplay::Component.new(creation_description: @bike.creation_description)) } %>
                <% if show_contact? %>
                  <% org_registration_field_rows.each do |label, value| %>
                    <%= info_row(label, value) %>
                  <% end %>
                <% end %>
                <% if @organization.enabled?("avery_export") %>
                  <%= info_row(translation(".avery_exportable"), @bike.avery_exportable? ? translation(".is_true") : translation(".is_false")) %>
                <% end %>
                <%= info_row(translation(".audit")) do %>
                  <% if organization_model_audit.present? %>
                    <%= link_to helpers.model_audit_display(model_audit), organization_model_audit_path(model_audit, organization_id: @organization.to_param), class: "twlink" %>
                    <span class="tw:ml-2 tw:font-bold <%= helpers.status_display_class(organization_model_audit.certification_status) %>">
                      <%= organization_model_audit.certification_status_humanized %>
                    </span>
                  <% else %>
                    <span class="tw:opacity-65">
                      <%= translation(".not_audited") %>
                    </span>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% else %>
            <p class="tw:text-sm tw:opacity-65">
              <%= translation(".no_registration_information", org_name: @organization.short_name) %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if show_other_registrations? %>
    <%= render(UI::Card::Component.new) do %>
      <div class="tw:flex tw:items-baseline tw:justify-between">
        <h2
          class="
            tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
            tw:uppercase
          "
        >
          <%= translation(".other_registrations") %>
        </h2>

        <span class="tw:text-xs tw:opacity-65">
          <% if other_registrations_count.positive? %>
            <%= translation(".other_registrations_count_html", count: helpers.number_display(other_registrations_count)) %>
          <% else %>
            <%= translation(".no_other_registrations") %>
          <% end %>
        </span>
      </div>

      <% if other_registrations_count.positive? %>
        <%= tag.div(class: "org-search-component tw:mt-3", data: other_registrations_settings.column_toggle_data_attributes) do %>
          <%= render(other_registrations_settings) %>

          <div class="tw:mt-3">
            <%= render(Org::SearchResults::BikesTable::Component.new(organization: @organization, bikes: recent_other_registrations, current_user: @current_user, settings_component: other_registrations_settings)) %>
          </div>
        <% end %>
      <% end %>

      <% if more_other_registrations? %>
        <p class="tw:mt-3 tw:text-xs tw:opacity-65">
          <%= translation(".showing_recent", count: recent_other_registrations.size) %>
          ·
          <%= link_to translation(".view_all_registrations"), other_registrations_search_path, class: "twlink", data: {turbo_frame: "_top"} %>
        </p>
      <% end %>
    <% end %>
  <% end %>

  <% if staff? && @organization.enabled?("bike_stickers") %>
    <%= render(UI::Modal::Component.new(id: "link-sticker-modal", title: translation(".link_sticker"))) do |modal| %>
      <% modal.with_body do %>
        <%= form_with model: BikeSticker.new, url: organization_sticker_path(id: "code", organization_id: @organization.to_param), method: :put, class: "tw:flex tw:flex-col tw:gap-3" do |form| %>
          <%= form.hidden_field :bike_id, value: @bike.id %>

          <div>
            <%= form.label :code, translation(".sticker_code"), class: "twlabel" %>
            <%= form.text_field :code, required: true, class: "twinput" %>
          </div>

          <%= render(UI::Button::Component.new(text: translation(".assign_sticker"), color: :purple, type: "submit")) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Registrations::Show::LegacyViewLink::Component.new(bike: @bike, current_user: @current_user)) %>
</div>
