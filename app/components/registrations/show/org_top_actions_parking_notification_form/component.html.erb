<div
  data-registrations--show--action-panels-target="panel"
  data-panel-name="parking impound"
  data-controller="registrations--show--parking-notification"
  data-registrations--show--parking-notification-us-country-id-value="<%= Country.united_states_id %>"
  data-registrations--show--parking-notification-notification-heading-value="<%= translation(".create_parking_notification") %>"
  data-registrations--show--parking-notification-impound-heading-value="<%= translation(".impound_this_bike_type", bike_type: @bike.type) %>"
  data-registrations--show--parking-notification-default-kind-value="<%= new_parking_notification.kind %>"
  data-registrations--show--parking-notification-mapbox-key-value="<%= ENV["MAPBOX_MAPPING"] %>"
  data-action="registrations--show--action-panels:shown->registrations--show--parking-notification#applyMode"
  class="tw:hidden"
>
  <%= render(UI::Card::Component.new) do %>
    <h2
      data-registrations--show--parking-notification-target="heading"
      class="
        tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
        tw:uppercase
      "
    >
      <%= translation(".create_parking_notification") %>
    </h2>

    <div class="tw:mt-3">
      <%= form_with(model: new_parking_notification, url: create_parking_notifications_path, data: {controller: "csrf-refresh form-persist", "form-persist-key-value": "parking-notification-#{@bike.id}", action: "input->form-persist#save submit->form-persist#clear"}) do |form| %>
        <%= form.hidden_field :bike_id %>
        <%= form.hidden_field :latitude, data: {"registrations--show--parking-notification-target": "latitude"} %>
        <%= form.hidden_field :longitude, data: {"registrations--show--parking-notification-target": "longitude"} %>
        <%= form.hidden_field :accuracy, data: {"registrations--show--parking-notification-target": "accuracy"} %>

        <% if new_parking_notification.can_be_repeat? %>
          <div class="tw:mb-4">
            <%= render(UI::Forms::RadioButtonGroup::Component.new(name: "parking_notification[is_repeat]", selected: new_parking_notification.is_repeat, entries: [{value: true, label: "Repeat ##{new_parking_notification.earlier_bike_notifications.count} of earlier notification"}, {value: false, label: "First notice"}], data: {action: "registrations--show--parking-notification#selectRepeat"})) %>
          </div>
        <% end %>

        <div
          class="tw:mb-4"
          data-registrations--show--parking-notification-target="locationSection"
        >
          <%= render(UI::Forms::RadioButtonGroup::Component.new(name: "location_mode", selected: "current", entries: [{value: "current", label: "Use my current location"}, {value: "entered", label: "Enter address manually"}], data: {action: "registrations--show--parking-notification#selectLocationMode", "registrations--show--parking-notification-target": "locationMode"})) %>

          <p
            data-registrations--show--parking-notification-target="status"
            class="
              tw:mt-2 tw:flex tw:hidden tw:items-center tw:gap-1.5
              tw:text-sm tw:opacity-65
            "
          >
            <span
              data-registrations--show--parking-notification-target="statusDot"
              class="
                tw:hidden tw:size-2 tw:flex-none tw:rounded-full
                tw:bg-green-500
              "
            ></span>

            <span
              data-registrations--show--parking-notification-target="statusText"
            ></span>
          </p>

          <div
            data-registrations--show--parking-notification-target="addressGroup"
            class="tw:mt-3 tw:hidden"
          >
            <%= form.hidden_field :use_entered_address, value: false, data: {"registrations--show--parking-notification-target": "useEnteredAddress"} %>

            <%= render(UI::Forms::AddressGroup::Component.new(form_builder: form, street_label: translation(".address_or_intersection"))) %>
          </div>
        </div>

        <%= render(UI::Forms::Group::Component.new(form_builder: form, attribute: :message, kind: :text_area, label_text: "Optional message to send to the owner", html_options: {rows: 3, placeholder: "Optional"})) %>

        <div
          class="tw:mb-4"
          data-registrations--show--parking-notification-target="kindGroup"
        >
          <p class="twlabel">Notification because</p>
          <%= render(UI::Forms::RadioButtonGroup::Component.new(name: "parking_notification[kind]", selected: new_parking_notification.kind, entries: ::ParkingNotification.kinds.map { |kind| {value: kind, label: ::ParkingNotification.kinds_humanized[kind.to_sym]} })) %>
        </div>

        <div class="tw:mb-4">
          <p class="twlabel">Photo</p>
          <%= render(UI::Forms::FileUpload::Component.new(form_builder: form, attribute: :image, accept: ImageUploader.permitted_extensions)) %>
          <%= form.hidden_field :image_cache %>
        </div>

        <%= render(UI::Forms::Group::Component.new(form_builder: form, attribute: :internal_notes, kind: :text_area, label_text: translation(".parking_notification_notes_html", org_name: @organization.short_name), html_options: {rows: 2})) %>

        <%= render(UI::Button::Component.new(text: "Create parking notification", color: :primary, kind: :submit, disabled: true, data: {"registrations--show--parking-notification-target": "submit"})) %>
      <% end %>
    </div>
  <% end %>
</div>
