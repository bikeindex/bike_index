<div class="tw:mt-2 tw:text-center">
  <% if redesign_enabled? %>
    <%= render(UI::Alert::Component.new(kind: :purple)) do %>
      <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-3">
        <span class="tw:font-semibold">
          <%= translation(".using_new_view") %>
        </span>

        <%= render(UI::ButtonLink::Component.new(text: translation(".switch_to_classic"), href: toggle_show_redesign_my_account_path, method: :post, params: {bike_id: @bike.id}, form: {data: {controller: "csrf-refresh"}}, color: :secondary, size: :sm)) %>
      </div>
    <% end %>
  <% else %>
    <p class="tw:mb-2 tw:text-sm tw:text-gray-500 tw:dark:text-gray-400">
      <%= translation(".preview_notice") %>
    </p>
    <%= render(UI::ButtonLink::Component.new(text: translation(".switch_to_new"), href: toggle_show_redesign_my_account_path, method: :post, params: {bike_id: @bike.id}, form: {data: {controller: "csrf-refresh"}}, color: :primary, size: :sm)) %>
  <% end %>
</div>
