<div
  class="
    tw:mx-auto tw:-mt-9 tw:flex tw:w-full tw:max-w-[1440px] tw:flex-col
    tw:gap-6 tw:px-2 tw:min-[992px]:-mt-[60px]
  "
>
  <div class="tw:grid tw:gap-6 tw:lg:grid-cols-3">
    <div class="tw:lg:col-span-2">
      <div
        class="
          tw:lg:rounded-sm tw:lg:border tw:lg:border-gray-200 tw:lg:bg-white
          tw:lg:p-4 tw:lg:dark:border-gray-700 tw:lg:dark:bg-gray-800
        "
      >
        <%= render(Registrations::Show::Photos::Component.new(bike: @bike, owner: @owner, title: title, subtitle: subtitle)) %>
      </div>
    </div>

    <div class="tw:flex tw:flex-col tw:gap-4 tw:lg:pt-7">
      <div>
        <div class="tw:mb-1">
          <%= render(Registrations::Show::ViewSwitcher::Component.new(bike: @bike, current_view: [@owner ? :owner : :public, nil], available_views: @available_views, label: audience_label, color: audience_color)) %>
        </div>

        <div class="tw:hidden tw:lg:block">
          <h1 class="tw:text-3xl tw:leading-tight tw:font-extrabold">
            <%= title %>
          </h1>

          <p class="tw:mt-1 tw:text-sm tw:opacity-65"><%= subtitle %></p>
        </div>
      </div>

      <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2">
        <% if @bike.status_with_owner? && !@bike.user_hidden %>
          <%= render(UI::Badge::Component.new(text: translation(".registered_protected"), color: :notice, icon: "kelsey/registration_show/shield")) %>
        <% end %>

        <%= render(UI::Badge::Component.new(text: status_label, color: status_color, indicator: true)) %>
      </div>

      <%= render(UI::Card::Component.new) do %>
        <h2
          class="
            tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
            tw:uppercase
          "
        >
          <%= translation(".this_bike_on_bike_index", bike_type: @bike.type) %>
        </h2>

        <div class="tw:mt-3">
          <%= render(UI::DefinitionList::Container::Component.new(term: :right_align)) do %>
            <% if color_swatches.any? %>
              <%= render(UI::DefinitionList::Row::Component.new(label: primary_colors_label)) do %>
                <%= safe_join(color_swatches, content_tag(:span, " and ", class: "tw:font-normal tw:text-gray-400")) %>
              <% end %>
            <% end %>

            <%= render(UI::DefinitionList::Row::Component.new(label: translation(".frame_material"), value: @bike.frame_material_name)) %>
            <%= render(UI::DefinitionList::Row::Component.new(label: translation(".activity"), value: activity_name)) %>
            <%= render(UI::DefinitionList::Row::Component.new(label: translation(".id"))) { render(UI::ShortId::Component.new(record: @bike)) } %>
            <%= render(UI::DefinitionList::Row::Component.new(label: translation(".registered_since"))) { render(UI::Time::Component.new(time: @bike.created_at)) } %>
          <% end %>
        </div>
      <% end %>

      <div class="tw:mt-auto tw:flex tw:flex-col tw:gap-2">
        <% if @owner %>
          <%= edit_bike_button %>
          <% if show_marketplace_button? %>
            <%= render(UI::ButtonLink::Component.new(href: edit_bike_path(@bike, edit_template: "marketplace"), text: translation(".sell_on_marketplace"), color: :primary, size: :lg, class: "tw:justify-center tw:text-center tw:py-2.5!")) %>
          <% end %>
          <%= render(Registrations::Show::Share::Component.new(text: translation(".share_my_page"), url: bike_url(@bike))) %>
          <% if @bike.status_with_owner? %>
            <%= render(UI::ButtonLink::Component.new(href: edit_bike_path(@bike, edit_template: "report_stolen"), text: translation(".mark_stolen"), color: :danger_outline, class: "tw:justify-center tw:text-center tw:py-2.5!")) %>
          <% end %>
        <% else %>
          <%= render(Registrations::Show::Share::Component.new(text: translation(".share"), url: bike_url(@bike))) %>
        <% end %>
      </div>
    </div>
  </div>

  <%= render(Registrations::Show::ContactOwner::Component.new(bike: @bike, current_user: @current_user, owner: @owner)) %>

  <%= render(Registrations::Show::StolenDetails::Component.new(bike: @bike, current_user: @current_user)) %>

  <%= render(UI::Card::Component.new) do %>
    <h2
      class="
        tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
        tw:uppercase
      "
    >
      <%= translation(".bike_details", bike_type: @bike.type_titleize) %>
    </h2>

    <div class="tw:mt-3">
      <%= render(UI::DefinitionList::Container::Component.new(term: :below)) do %>
        <%= render(UI::DefinitionList::Row::Component.new(label: translation(".serial"))) { helpers.render_serial_display(@bike, @current_user, skip_explanation: !@owner) } %>
        <%= render(UI::DefinitionList::Row::Component.new(label: translation(".other_serial"), value: @bike.extra_registration_number)) %>
        <%= render(UI::DefinitionList::Row::Component.new(label: translation(".vehicle_type"), value: vehicle_type)) %>
        <%= render(UI::DefinitionList::Row::Component.new(label: translation(".manufacturer"), value: manufacturer_name)) %>
        <%= render(UI::DefinitionList::Row::Component.new(label: translation(".model"), value: @bike.frame_model)) %>
        <%= render(UI::DefinitionList::Row::Component.new(label: translation(".year"), value: @bike.year)) %>
        <%= render(UI::DefinitionList::Row::Component.new(label: translation(".frame_material"), value: @bike.frame_material_name)) %>
        <%= render(UI::DefinitionList::Row::Component.new(label: translation(".frame_size"), value: @bike.frame_size&.upcase)) %>
        <%= render(UI::DefinitionList::Row::Component.new(label: translation(".handlebar_type"), value: @bike.handlebar_type_name)) %>
      <% end %>
    </div>
  <% end %>

  <% if @bike.description.present? %>
    <%= render(UI::Card::Component.new) do %>
      <h2
        class="
          tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
          tw:uppercase
        "
      >
        <%= translation(".about_this_bike", bike_type: @bike.type) %>
      </h2>

      <p class="tw:mt-2"><%= @bike.description %></p>
    <% end %>
  <% end %>

  <%= render(Registrations::Show::ComponentList::Component.new(bike: @bike)) %>
</div>
