<div
  data-registrations--show--action-panels-target="panel"
  data-panel-name="notifications_show"
  class="tw:hidden"
>
  <%= render(UI::Card::Component.new) do %>
    <h2
      class="
        tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
        tw:uppercase
      "
    >
      <%= translation(".parking_notifications") %>
    </h2>

    <%= link_to translation(".view_all", bike_type: @bike.type), notifications_path, class: "twlink tw:mt-1 tw:inline-block tw:text-sm" %>

    <div class="tw:mt-4">
      <% if parking_notification.present? %>
        <%= render(Org::ParkingNotificationDetails::Component.new(parking_notification:, organization: @organization, skip_bike: true, display_dev_info: @display_dev_info)) %>
        <div class="tw:mt-3">
          <%= render(UI::ButtonLink::Component.new(href: notification_path, text: translation(".view_notification"), color: :secondary)) %>
        </div>
      <% else %>
        <p class="tw:text-sm tw:opacity-65">
          <%= translation(".no_notifications", bike_type: @bike.type) %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>
