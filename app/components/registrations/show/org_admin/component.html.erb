<% action_card_classes = "tw:relative tw:flex tw:min-h-[60px] tw:items-center tw:gap-3 tw:rounded-xl tw:border tw:border-gray-200 tw:bg-white tw:p-4 tw:transition tw:hover:border-[#715eb2] tw:hover:bg-[#f7f5fc] tw:lg:flex-1 tw:dark:border-gray-700 tw:dark:bg-gray-800 tw:dark:hover:bg-purple-950" %>

<div
  class="
    tw:mx-auto tw:flex tw:w-full tw:max-w-[1440px] tw:flex-col tw:gap-6
    tw:px-2
  "
>
  <div class="tw:flex tw:flex-wrap tw:items-start tw:justify-between tw:gap-4">
    <div>
      <div class="tw:mb-2 tw:flex tw:flex-wrap tw:items-center tw:gap-2">
        <%= render(Registrations::Show::ViewSwitcher::Component.new(bike: @bike, current_view: [staff? ? :staff : :limited, @organization], available_views: @available_views, label: @organization.short_name, color: org_chip_color, solid: false, role_label: role_label)) %>
      </div>

      <h1 class="tw:text-2xl tw:font-bold"><%= title %></h1>

      <p class="tw:opacity-65">
        <%= render(Registrations::Show::Subtitle::Component.new(bike: @bike)) %>
      </p>

      <div class="tw:mt-2 tw:flex tw:flex-wrap tw:gap-2">
        <% if @bike.claimed? %>
          <%= render(UI::Badge::Component.new(text: translation(".claimed"), color: :notice, indicator: true)) %>
        <% end %>

        <%= render(Registrations::Show::Status::Component.new(bike: @bike)) %>
      </div>
    </div>
  </div>

  <div class="tw:grid tw:grid-cols-2 tw:gap-3 tw:lg:flex">
    <% if show_contact? %>
      <%= link_to "mailto:#{@bike.owner_email}", class: action_card_classes do %>
        <%= action_icon("mail") %>
        <%= action_label(translation(".message_owner"), translation(".message_owner_sub")) %>
      <% end %>
    <% end %>

    <% if show_impound? %>
      <%= link_to impound_path, class: action_card_classes do %>
        <%= action_icon("lock", tile: staff? ? :purple : :amber) %>
        <%= action_label(impound_label, impound_sub) %>
      <% end %>
    <% end %>

    <% if staff? && show_parking_notifications? %>
      <%= link_to notifications_path, class: action_card_classes do %>
        <%= action_icon("map-pin") %>
        <%= action_label(translation(".parking_notice"), translation(".parking_notice_sub")) %>
      <% end %>
    <% end %>

    <% if show_parking_notifications? %>
      <%= link_to notifications_path, class: action_card_classes do %>
        <% if active_notifications_count > 0 %>
          <span class="tw:absolute tw:top-2 tw:right-2">
            <%= render(UI::Badge::Component.new(text: active_notifications_count, color: :notice, size: :sm)) %>
          </span>
        <% end %>

        <%= action_icon("bell", tile: :blue) %>

        <%= action_label(translation(".view_notifications"), translation(".view_notifications_sub")) %>
      <% end %>
    <% end %>
  </div>

  <div class="tw:grid tw:gap-6 tw:lg:grid-cols-3">
    <div class="tw:flex tw:flex-col tw:gap-6 tw:lg:col-span-2">
      <% archive_images = @bike.public_images.select(&:image_url) %>

      <% if archive_images.any? %>
        <%= render(UI::Card::Component.new) do %>
          <h2
            class="
              tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
              tw:uppercase
            "
          >
            <%= translation(".photo_archive") %>
          </h2>

          <ul class="tw:mt-3 tw:flex tw:flex-wrap tw:gap-3">
            <% archive_images.each do |public_image| %>
              <li>
                <a
                  href="<%= public_image.image_url %>"
                  target="_blank"
                  rel="noopener"
                  class="
                    tw:block tw:size-24 tw:overflow-hidden tw:rounded-lg
                    tw:border tw:border-gray-200 tw:transition
                    tw:hover:border-[#715eb2] tw:dark:border-gray-700
                  "
                >
                  <%= image_tag(public_image.image_url(:small), alt: public_image.name.to_s, class: "tw:size-full tw:object-cover") %>
                </a>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <%= render(Registrations::Show::StolenDetails::Component.new(bike: @bike, current_user: @current_user)) %>
      <%= render(Registrations::Show::ImpoundDetails::Component.new(bike: @bike)) %>

      <%= render(Registrations::Show::BikeIndexCard::Component.new(bike: @bike, term: :below)) %>

      <%= render(Registrations::Show::BikeDetails::Component.new(bike: @bike, serial_user: @current_user)) %>

      <% if @bike.description.present? %>
        <%= render(UI::Card::Component.new) do %>
          <h2
            class="
              tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
              tw:uppercase
            "
          >
            <%= translation(".about_this_bike", bike_type: @bike.type) %>
          </h2>

          <p class="tw:mt-2"><%= @bike.description %></p>
        <% end %>
      <% end %>

      <% if show_notes? %>
        <%= render(UI::Card::Component.new) do %>
          <h2
            class="
              tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
              tw:uppercase
            "
          >
            <%= translation(".internal_notes") %>
          </h2>

          <% if bike_organization_note.present? %>
            <div
              class="
                tw:mt-3 tw:border-b tw:border-gray-100 tw:pb-3
                tw:dark:border-gray-800
              "
            >
              <p class="tw:text-sm"><%= bike_organization_note.body %></p>

              <p class="tw:mt-1 tw:text-xs tw:opacity-65">
                <%= translation(".note_by", user: bike_organization_note.user&.display_name) %>

                <%= render(UI::Time::Component.new(time: bike_organization_note.updated_at)) %>
              </p>
            </div>
          <% end %>

          <%= form_with(url: notes_url, method: :patch, class: "tw:mt-3", data: {controller: "csrf-refresh"}) do |f| %>
            <%= f.text_area :notes, value: bike_organization_note&.body, name: "notes", rows: 3, class: "twinput tw:w-full", placeholder: translation(".notes_placeholder") %>

            <div class="tw:mt-2 tw:flex tw:items-center tw:justify-between">
              <small class="tw:opacity-65">
                <%= translation(".posts_as", user: @current_user.display_name) %>
              </small>

              <%= f.submit translation(".post_note"), class: UI::Button::Component.build_classes(color: :purple, size: :sm) %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <%= render(Registrations::Show::ComponentList::Component.new(bike: @bike, collapsed: true)) %>
    </div>

    <div class="tw:flex tw:flex-col tw:gap-6">
      <%= render(UI::Card::Component.new) do %>
        <h2
          class="
            tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
            tw:uppercase
          "
        >
          <%= translation(".owner_access") %>
        </h2>

        <% if show_contact? %>
          <div class="tw:mt-3">
            <%= render(UI::DefinitionList::Container::Component.new(term: :right_align)) do %>
              <%= render(UI::DefinitionList::Row::Component.new(label: translation(".owner_name"), value: @bike.owner_name)) %>
              <%= render(UI::DefinitionList::Row::Component.new(label: translation(".owner_email"))) { link_to(@bike.owner_email, "mailto:#{@bike.owner_email}", class: "twlink") } %>

              <% if owner_phone.present? %>
                <%= render(UI::DefinitionList::Row::Component.new(label: translation(".owner_phone"))) { link_to(owner_phone, "tel:#{owner_phone}", class: "twlink tw:font-mono") } %>
              <% end %>

              <%= render(UI::DefinitionList::Row::Component.new(label: translation(".registered"))) { render(UI::Time::Component.new(time: @bike.created_at)) } %>

              <% org_registration_field_rows.each do |label, value| %>
                <%= render(UI::DefinitionList::Row::Component.new(label: label, value: value)) %>
              <% end %>
            <% end %>
          </div>
          <% if staff? %>
            <div
              class="
                tw:mt-3 tw:rounded-lg tw:bg-purple-50 tw:p-3
                tw:dark:bg-purple-950
              "
            >
              <p class="tw:text-sm tw:font-bold">
                <%= translation(".org_can_edit", org_name: @organization.short_name, bike_type: @bike.type) %>
              </p>

              <p class="tw:mt-1 tw:text-xs tw:opacity-65">
                <%= translation(".org_can_edit_sub", bike_type: @bike.type) %>
              </p>

              <div class="tw:mt-2 tw:flex tw:gap-4">
                <%= link_to translation(".edit_bike_type", bike_type: @bike.type), edit_access_path, class: "twlink tw:text-sm" %>

                <span
                  class="tw:cursor-not-allowed tw:text-sm tw:opacity-50"
                  title="<%= translation(".coming_soon") %>"
                >
                  <%= translation(".link_sticker") %>
                </span>
              </div>
            </div>
          <% end %>
        <% else %>
          <div
            class="
              tw:mt-3 tw:rounded-lg tw:border tw:border-dashed
              tw:border-gray-300 tw:p-4 tw:dark:border-gray-700
            "
          >
            <p class="tw:font-bold"><%= contact_blocked_title %></p>

            <p class="tw:mt-1 tw:text-sm tw:opacity-65">
              <%= contact_blocked_message %>
            </p>
          </div>
        <% end %>
      <% end %>

      <%= render(UI::Card::Component.new) do %>
        <h2
          class="
            tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
            tw:uppercase
          "
        >
          <%= translation(".e_vehicle_compliance") %>
        </h2>

        <div class="tw:mt-3 tw:flex tw:flex-col tw:gap-3">
          <div class="tw:flex tw:items-center tw:justify-between tw:gap-3">
            <div class="tw:min-w-0">
              <p class="tw:text-sm tw:font-bold">
                <%= translation(".audit") %>
              </p>

              <% if organization_model_audit.present? %>
                <%= link_to helpers.model_audit_display(model_audit), organization_model_audit_path(model_audit, organization_id: @organization.to_param), class: "twlink tw:text-xs" %>
              <% else %>
                <p class="tw:text-xs tw:opacity-65">
                  <%= translation(".not_audited") %>
                </p>
              <% end %>
            </div>

            <% if organization_model_audit.present? %>
              <span class="tw:flex-none tw:text-xs tw:font-bold <%= helpers.status_display_class(organization_model_audit.certification_status) %>">
                <%= organization_model_audit.certification_status_humanized %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if show_parking_notifications? %>
        <%= render(UI::Card::Component.new) do %>
          <h2
            class="
              tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
              tw:uppercase
            "
          >
            <%= translation(".parking_notifications") %>
          </h2>

          <p class="tw:mt-3 tw:text-sm">
            <%= link_to "#{active_notifications_count} #{translation(".active")}", notifications_path, class: "twlink" %>
            <span class="tw:mx-1 tw:text-gray-400">·</span>
            <%= link_to "#{resolved_notifications_count} #{translation(".resolved")}", resolved_notifications_path, class: "twlink" %>
          </p>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if show_contact? && other_registrations_count.positive? %>
    <%= render(UI::Card::Component.new) do %>
      <div class="tw:flex tw:items-baseline tw:justify-between">
        <h2
          class="
            tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
            tw:uppercase
          "
        >
          <%= translation(".other_registrations") %>
        </h2>

        <span class="tw:text-xs tw:opacity-65">
          <%= translation(".other_registrations_count_html", count: helpers.number_display(other_registrations_count)) %>
        </span>
      </div>

      <div class="tw:mt-3">
        <%= render(Org::SearchResults::BikesTable::Component.new(organization: @organization, bikes: recent_other_registrations, current_user: @current_user)) %>
      </div>

      <% if more_other_registrations? %>
        <p class="tw:mt-3 tw:text-xs tw:opacity-65">
          <%= translation(".showing_recent", count: recent_other_registrations.size) %>
          ·
          <%= link_to translation(".view_all_registrations"), other_registrations_search_path, class: "twlink", data: {turbo_frame: "_top"} %>
        </p>
      <% end %>
    <% end %>
  <% end %>
</div>
