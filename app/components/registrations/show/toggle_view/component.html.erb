<%= render(UI::Alert::Component.new(kind: :purple)) do %>
  <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-3">
    <% if redesign_enabled? %>
      <span class="tw:font-semibold">
        <%= translation(".viewing_in_legacy") %>
        <%= button_to translation(".switch_to_legacy_default"), toggle_show_redesign_my_account_path, params: {bike_id: @bike.id}, form: {class: "tw:inline"}, class: "twlink tw:bg-transparent! tw:border-0! tw:p-0! tw:font-semibold! tw:cursor-pointer!" %>
      </span>
      <%= render(UI::ButtonLink::Component.new(text: translation(".view_in_new"), href: registration_path(@bike), color: :secondary, size: :sm)) %>
    <% else %>
      <span class="tw:font-semibold">
        <%= translation(".try_new_view", bike_type: @bike.type) %>
      </span>
      <%= render(UI::ButtonLink::Component.new(text: translation(".switch_to_new"), href: toggle_show_redesign_my_account_path, method: :post, params: {bike_id: @bike.id}, color: :secondary, size: :sm)) %>
    <% end %>
  </div>
<% end %>
