<%= render(UI::Alert::Component.new(kind: :purple, header: heading, margin_classes: "")) do %>
  <div
    data-controller="ui--collapse"
    data-ui--collapse-param-value="contact_owner"
  >
    <% if claim.present? %>
      <% if claim.unsubmitted? %>
        <%= form_with(model: claim, url: impound_claim_path(claim), data: {controller: "csrf-refresh"}) do |form| %>
          <%= form.label :message, translation(".prove_its_yours", bike_type: claim.bike_type), class: "twlabel" %>
          <%= form.text_area :message, rows: 4, class: "twinput tw:w-full" %>

          <div class="tw:mt-3">
            <%= render(UI::Button::Component.new(text: translation(".save_message"), color: :secondary, kind: :submit)) %>
          </div>
        <% end %>
        <%= form_with(model: claim, url: impound_claim_path(claim), data: {controller: "csrf-refresh"}) do |form| %>
          <%= form.hidden_field :status, value: "submitting" %>

          <div class="tw:mt-4">
            <%= render(UI::Button::Component.new(text: translation(".submit_claim"), color: :purple, kind: :submit)) %>
          </div>

          <p class="tw:mt-1 tw:text-sm tw:opacity-65">
            <%= translation(".no_editing_after_submitting") %>
          </p>
        <% end %>
      <% else %>
        <p>
          <%= translation(".claim_submitted") %>
          <%= render(UI::Time::Component.new(time: claim.submitted_at)) %>
        </p>
        <% if claim.successful? %>
          <p class="tw:mt-2">
            <%= translation(".claim_was_status", status: claim.status_humanized) %>
          </p>
        <% end %>
      <% end %>
    <% elsif submitting_claim.present? %>
      <p>
        <%= translation(".claim_with_this_bike_type", status: submitting_claim.status_humanized, bike_type: @bike.type) %>
      </p>
      <% if submitting_claim.bike_claimed.present? %>
        <p class="tw:mt-2">
          <%= link_to translation(".view_claimed_bike_type", kind: submitting_claim.kind, bike_type: submitting_claim.bike_claimed.type),
              registration_path(submitting_claim.bike_claimed), class: "twlink" %>
        </p>
      <% end %>
    <% elsif sign_in_redirect %>
      <%= render(UI::ButtonLink::Component.new(href: sign_in_redirect, text: claim_button_text, color: :purple)) %>
    <% elsif stolen_record_options.any? %>
      <%= render(UI::Button::Component.new(
          text: claim_button_text,
          color: :purple,
          aria: {expanded: false},
          data: {"ui--collapse-target": "trigger", action: "ui--collapse#toggle"}
        )) %>
      <div data-ui--collapse-target="content" class="tw:hidden">
        <%= form_with(model: new_claim, url: impound_claims_path, data: {controller: "csrf-refresh"}) do |form| %>
          <%= form.hidden_field :impound_record_id, value: impound_record.id %>

          <%= form.label :stolen_record_id, translation(".select_your_stolen_bike"), class: "twlabel tw:mt-1" %>

          <%= form.select :stolen_record_id, stolen_record_options,
              {prompt: translation(".choose_stolen_bike")},
              {required: true, class: "twinput tw:w-full"} %>

          <div class="tw:mt-3">
            <%= render(UI::Button::Component.new(text: translation(".open_claim"), color: :purple, kind: :submit)) %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="tw:text-sm tw:opacity-65">
        <%= translation(".need_stolen_bike_html", add_link: link_to(translation(".add_a_stolen_bike"), new_bike_path(status: "status_stolen"), class: "twlink", target: "_blank", rel: "noopener")) %>
      </p>
    <% end %>
  </div>
<% end %>
