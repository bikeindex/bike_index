<%= render(UI::Modal::Component.new(id: "notification-token-modal", title: @matching_notification.subject, open: true)) do |modal| %>
  <% modal.with_body do %>
    <% if @matching_notification.message.present? %>
      <p><%= @matching_notification.message %></p>
    <% end %>

    <% if organization_snippet.present? %>
      <div class="tw:mt-2"><%= organization_snippet.html_safe %></div>
    <% end %>

    <div class="tw:mt-4">
      <% if resolved? %>
        <p class="tw:font-bold"><%= resolved_text %></p>
        <p class="tw:mt-1 tw:text-sm tw:opacity-65">
          <%= translation(".no_futher_action_necessary") %>
        </p>
      <% else %>
        <%= form_with(url: resolve_token_bike_path(@bike), method: :put, data: {controller: "csrf-refresh"}) do |form| %>
          <%= form.hidden_field :token, value: @token %>
          <%= form.hidden_field :token_type, value: @token_type %>

          <%= render(UI::Button::Component.new(text: resolve_button_text, color: :purple, kind: :submit)) %>
        <% end %>
      <% end %>
    </div>

    <% if organization.present? %>
      <p class="tw:mt-4 tw:text-sm tw:opacity-65">
        <%= translation(".organization_sent_this_message", org_name: organization.name) %>

        <% if @matching_notification.sent_at.present? %>
          <%= render(UI::Time::Component.new(time: @matching_notification.sent_at)) %>
        <% end %>
      </p>
      <% if organization_email.present? %>
        <p class="tw:mt-1 tw:text-sm tw:opacity-65">
          <%= translation(".please_email_organization_with_questions_html", email_link: mail_to(organization_email, class: "twlink")) %>
        </p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
