<% items.each do |item| %>
  <% case item[:type] %>
  <% when :divider %>
    <li class="divider-nav-item"></li>
  <% when :disabled %>
    <li>
      <span class="<%= disabled_classes(item) %>"><%= item[:label] %></span>
    </li>
  <% when :link %>
    <li>
      <%= render UI::ActiveLink::Component.new(text: item[:label], path: item[:path],
            active: active_state(item), match: MATCHES.fetch(item[:active], :path),
            html_class: link_classes(item)) %>
    </li>
  <% when :super_admin_link %>
    <li class="less-strong mt-4">
      <%= link_to item[:label], item[:path], class: "nav-link" %>
    </li>
  <% end %>
<% end %>
