<%= render Register::PageContent::Component.new(page: @page, control: ->(_index) {
  check_box_tag "preview_#{@page.id}[]", "1", false, id: nil, class: "tw:mt-0.5 tw:h-4 tw:w-4 tw:shrink-0 tw:cursor-pointer"
}) do |content| %>
  <% content.with_badge do %>
    <% if @page.organization_specific && organization_name.present? %>
      <%= render UI::Badge::Component.new(text: organization_name, color: :notice) %>
    <% end %>
  <% end %>

  <% content.with_faq do %>
    <% if @sequence.faq_url.present? %>
      <%= link_to "FAQ", @sequence.faq_url, target: "_blank", rel: "noopener", class: "twlink tw:text-xs" %>
    <% end %>
  <% end %>
<% end %>
