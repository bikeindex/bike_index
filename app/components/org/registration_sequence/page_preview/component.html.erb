<%#
  Nameless so a walk-through's GET form doesn't serialize them; the shared
  register--acknowledgment controller (when one wraps this) gates Continue on them.
%>

<%= render Register::PageContent::Component.new(page: @page, first: @first, control: ->(_index) {
  tag.input(type: "checkbox", class: "tw:mt-0.5 tw:h-4 tw:w-4 tw:shrink-0 tw:cursor-pointer",
    data: {"register--acknowledgment-target": "checkbox", action: "change->register--acknowledgment#update"})
}) %>
