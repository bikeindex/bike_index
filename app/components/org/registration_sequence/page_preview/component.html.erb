<%#
  Nameless so a walk-through's GET form doesn't serialize them; the shared
  register--acknowledgment controller (when one wraps this) gates Continue on them.
%>

<%= render Register::PageContent::Component.new(page: @page, control: ->(_index) {
  tag.input(type: "checkbox", class: "tw:mt-0.5 tw:h-4 tw:w-4 tw:shrink-0 tw:cursor-pointer",
    data: {"register--acknowledgment-target": "checkbox", action: "change->register--acknowledgment#update"})
}) do |content| %>
  <% content.with_badge do %>
    <% if @first %>
      <%= render UI::Badge::Component.new(text: t("components.register.step_acknowledgment.electric_detected"), color: :warning) %>
    <% elsif @page.organization_specific && organization_name.present? %>
      <%= render UI::Badge::Component.new(text: organization_name, color: :notice) %>
    <% end %>
  <% end %>

  <% content.with_faq do %>
    <% if @sequence.faq_url.present? %>
      <%= render UI::Tooltip::Component.new(text: t("components.register.step_acknowledgment.have_questions")) do |tooltip| %>
        <% tooltip.with_body do %>
          <%= t("components.register.step_acknowledgment.have_questions") %>
          <%= link_to t("components.register.step_acknowledgment.read_the_faq"), @sequence.faq_url, target: "_blank", rel: "noopener", class: "twlink" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
