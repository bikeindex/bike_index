<%= render Register::Page::Component.new do %>
  <%= render Register::Progress::Component.new(step: progress_step, total: progress_total) %>

  <%= render Register::AcknowledgmentProgress::Component.new(number: @index + 1, total: acknowledgment_step_count) %>

  <% if reviewing? %>
    <%= render UI::Header::Component.new(text: "You're almost done", subtitle: "A quick review before you finish.", html_class: "uncap") %>
    <%= render UI::DividedCard::Component.new do %>
      <% pages.each do |page| %>
        <div
          class="
            tw:flex tw:items-center tw:gap-2.5 tw:px-4 tw:py-3 tw:text-sm
            tw:font-semibold
          "
        >
          <span
            class="
              tw:flex tw:h-5.5 tw:w-5.5 tw:shrink-0 tw:items-center
              tw:justify-center tw:rounded-full tw:bg-green-100
              tw:text-green-600
            "
          >
            <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:h-3 tw:w-3", aria_hidden: true) %>
          </span>

          <%= page.title %>
        </div>
      <% end %>
    <% end %>
    <%# The acknowledgment gates Finish, via the same register--acknowledgment controller the flow uses %>
    <%= form_with url: exit_path, method: :get, data: {controller: "register--acknowledgment"} do %>
      <div class="tw:mt-5">
        <%= render UI::DividedCard::Component.new do %>
          <label
            class="
              tw:mb-0 tw:flex tw:cursor-pointer tw:items-start tw:gap-3
              tw:px-4 tw:py-3.5 tw:text-sm tw:font-normal
            "
          >
            <%= tag.input(type: "checkbox", class: "tw:mt-0.5 tw:h-4 tw:w-4 tw:shrink-0 tw:cursor-pointer",
              data: {"register--acknowledgment-target": "checkbox", action: "change->register--acknowledgment#update"}) %>

            <span>
              I, <em>registrant's name</em>,
              <%= @registration_sequence.acknowledgment %>
            </span>
          </label>
        <% end %>
      </div>

      <%= render UI::Button::Component.new(text: "Finish preview", color: :primary, size: :lg, kind: :submit,
        spinner: true, disabled: true, html_class: "tw:mt-5 tw:w-full", data: {"register--acknowledgment-target": "submit"}) %>
    <% end %>
  <% else %>
    <%# Continue is gated on checking every rule, the same as the real flow %>
    <%= form_with url: sequence_path, method: :get, data: {controller: "register--acknowledgment"} do %>
      <%# page is 1-indexed, so the next screen (index @index + 1) is param @index + 2 %>
      <%= hidden_field_tag :page, @index + 2 %>

      <%= render Org::RegistrationSequence::PagePreview::Component.new(page: current_page, first: @index.zero?) %>

      <%= render UI::Button::Component.new(text: "Continue", color: :primary, size: :lg, kind: :submit,
        spinner: true, disabled: true, html_class: "tw:mt-5 tw:w-full", data: {"register--acknowledgment-target": "submit"}) %>
    <% end %>
  <% end %>

  <%= render Register::BackLink::Component.new(href: back_path) %>
<% end %>
