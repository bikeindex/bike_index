<div class="tw:mx-auto tw:flex tw:max-w-md tw:flex-col tw:gap-8">
  <% @registration_sequence.registration_sequence_pages.each do |page| %>
    <%= render Org::RegistrationSequence::PagePreview::Component.new(page:) %>
  <% end %>

  <%# The final acknowledgment binding the registrant to every page above %>
  <%= render UI::DividedCard::Component.new do %>
    <label
      class="
        tw:mb-0 tw:flex tw:cursor-pointer tw:items-start tw:gap-3 tw:px-4
        tw:py-3.5 tw:text-sm tw:font-normal
      "
    >
      <%= check_box_tag "preview_acknowledged", "1", false, id: nil, class: "tw:mt-0.5 tw:h-4 tw:w-4 tw:shrink-0 tw:cursor-pointer" %>

      <span>
        I, <em>registrant's name</em>,
        <%= @registration_sequence.acknowledgment %>
      </span>
    </label>
  <% end %>
</div>
