<section id="registration_sequences_<%= @kind %>">
  <h2 class="uncap tw:mt-8 tw:mb-4 tw:text-xl tw:font-semibold">
    <%= kind_display %> registrations
  </h2>

  <h3 class="uncap tw:mb-2 tw:text-lg tw:font-semibold">Current</h3>

  <% if active.present? %>
    <p class="tw:mb-2 tw:text-gray-600">
      This is the active version your registrants see.
      <%= link_to "Preview", sequence_path(active), class: "twlink" %>
    </p>
    <div class="tw:mb-6">
      <%= render Org::RegistrationSequence::PageList::Component.new(registration_sequence: active) %>
    </div>
  <% else %>
    <p class="tw:mb-2 tw:text-gray-600">
      There is no active <%= kind_display.downcase %> registration sequence.
    </p>
    <% if @editable %>
      <p class="tw:mb-2 tw:text-gray-600">
        Edit your draft sequence and contact Bike Index when you're ready to
        make it live.
      </p>
    <% end %>
  <% end %>

  <% if @editable %>
    <h3 class="uncap tw:mb-2 tw:text-lg tw:font-semibold">Draft</h3>

    <% if draft.present? %>
      <div
        class="
          tw:mb-2 tw:flex tw:flex-wrap tw:items-baseline tw:justify-between
          tw:gap-x-4 tw:gap-y-1
        "
      >
        <p class="tw:mb-0 tw:text-gray-600">
          Your draft sequence, last edited
          <%= render UI::Time::Component.new(time: draft.updated_at, format: :localize_time_precise) %>
        </p>

        <%= render UI::ButtonLink::Component.new(text: "Edit", href: create_draft_path, method: :post, color: :primary, form_class: "button_to tw:ml-auto") %>
      </div>
      <%# Read-only, like the active version above - the draft has its own screen %>
      <div class="tw:mb-6">
        <%= render Org::RegistrationSequence::PageList::Component.new(registration_sequence: draft, editable: false) %>
      </div>
      <%# onsubmit, not turbo_confirm: Turbo Drive is off app-wide %>
      <div class="tw:mb-6 tw:flex">
        <%= render UI::ButtonLink::Component.new(text: "Discard draft", href: sequence_path(draft), method: :delete, color: :error, size: :sm,
        form_class: "button_to tw:ml-auto", form: {onsubmit: discard_confirm}) %>
      </div>
    <% else %>
      <p class="tw:mb-2 tw:text-gray-600">You don't have a draft sequence</p>
      <div class="tw:mb-6">
        <%= render UI::ButtonLink::Component.new(text: create_draft_text, href: create_draft_path, method: :post, color: :primary) %>
      </div>
    <% end %>
  <% end %>

  <% if previous.any? %>
    <h3 class="uncap tw:mb-2 tw:text-lg tw:font-semibold">Previous</h3>
    <ul class="tw:list-none tw:text-gray-600">
      <% previous.each do |registration_sequence| %>
        <li class="tw:mb-1">
          <%= link_to "Preview", sequence_path(registration_sequence), class: "twlink" %>
          ended
          <%= render UI::Time::Component.new(time: registration_sequence.end_at) %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
