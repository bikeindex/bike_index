<div class="tw:py-6" data-controller="page-preview">
  <div class="tw:mb-6 tw:flex tw:items-center tw:justify-between">
    <%# A step below admin's own h1 %>
    <% if @admin %>
      <%= render(UI::Header::Component.new(text: editing? ? "Edit page" : "Add page", tag: :h2, html_class: "uncap tw:mb-0! tw:font-normal! tw:text-gray-500!")) %>
    <% else %>
      <%= render(UI::Header::Component.new(text: editing? ? "Edit page" : "Add page", html_class: "uncap tw:mb-0!")) %>
    <% end %>

    <%= link_to "Back to sequence overview", sequence_path, class: "twlink" %>
  </div>

  <%= form_with model: @page, url: form_url, html: {multipart: true} do |f| %>
    <%= render Org::RegistrationSequence::PageEdit::Component.new(form_builder: f) %>

    <div
      class="
        tw:mt-4 tw:flex tw:items-baseline tw:justify-between tw:pt-4
        tw:md:pt-8
      "
    >
      <%= render UI::Button::Component.new(text: editing? ? "Save page" : "Add page", color: :primary, type: "submit") %>

      <% if editing? %>
        <%= render UI::ButtonLink::Component.new(text: "Delete page", href: page_path, color: :error, size: :sm, data: {turbo: true, turbo_method: :delete, turbo_confirm: "This action can't be undone, you'll have to re-create the page"}) %>
      <% end %>
    </div>
  <% end %>

  <% if editing? %>
    <p
      data-page-preview-target="hint"
      hidden
      class="tw:mt-2 tw:mb-0 tw:text-sm tw:text-gray-500"
    >
      Save the page to see the updated preview.
    </p>
    <div data-page-preview-target="preview" class="tw:mt-8">
      <%= render(UI::Header::Component.new(text: "Preview", tag: :h2, html_class: "uncap")) %>

      <%# pt and mb cancel the flow shell's negative margins; padding doesn't collapse %>
      <div class="tw:mb-24 tw:pt-(--nav-gap)">
        <%= render Register::Page::Component.new do %>
          <%= render Register::PageContent::Component.new(page: @page, first: @page.listing_order.to_i.zero?) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
