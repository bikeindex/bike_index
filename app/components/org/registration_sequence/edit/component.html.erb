<div class="tw:mb-3 tw:flex tw:items-baseline tw:justify-between tw:gap-4">
  <h1 class="uncap">
    Draft registration sequence
    <span class="tw:text-xl tw:font-normal tw:text-gray-500">· <%= helpers.number_display(pages.size) %> <%= "page".pluralize(pages.size) %></span>
  </h1>

  <%= render UI::ButtonLink::Component.new(href: organization_registration_sequence_pages_path(organization_id: @organization.to_param, registration_sequence_id: @registration_sequence.id), method: :post, color: :secondary, class: "tw:whitespace-nowrap") do %>
    <span aria-hidden="true">+</span> Add page
  <% end %>
</div>

<%= render UI::Card::Component.new do %>
  <div
    data-controller="sortable"
    class="tw:-my-1.5 tw:divide-y tw:divide-gray-200"
  >
    <% pages.each do |page| %>
      <div
        data-sortable-target="item"
        data-url="<%= organization_registration_sequence_page_path(organization_id: @organization.to_param, id: page.id) %>"
        data-controller="ui--collapse"
        class="tw:py-1.5"
      >
        <div class="tw:flex tw:items-baseline">
          <%= render UI::DragHandle::Component.new(controller: "sortable", html_class: "tw:pr-4") %>

          <div class="tw:min-w-0 tw:flex-1">
            <div class="tw:flex tw:items-center tw:gap-2">
              <button
                type="button"
                data-action="ui--collapse#toggle"
                data-ui--collapse-target="trigger"
                aria-expanded="false"
                class="tw:cursor-pointer tw:text-gray-400 tw:hover:text-gray-600"
              >
                <span class="tw:sr-only">Toggle page details</span>

                <span
                  data-ui--collapse-target="chevron"
                  class="tw:inline-block tw:transition-transform tw:duration-200"
                >
                  <span class="tw:flex">
                    <%= render UI::IconChevron::Component.new %>
                  </span>
                </span>
              </button>

              <h3 class="uncap tw:mb-0 tw:text-base tw:font-semibold">
                <%= page.title %>
              </h3>

              <% if page.organization_specific %>
                <%= render UI::Badge::Component.new(text: @organization.short_name, color: :notice, size: :xs) %>
              <% end %>
            </div>

            <% if page.subtitle.present? %>
              <p
                data-ui--collapse-target="content"
                class="
                  tw:mt-1 tw:mb-0 tw:hidden tw:pl-5 tw:text-sm
                  tw:text-gray-600
                "
              >
                <%= page.subtitle %>
              </p>
            <% end %>
          </div>

          <%= link_to "Edit", edit_organization_registration_sequence_page_path(organization_id: @organization.to_param, id: page.id), class: "twlink" %>
        </div>

        <div
          data-ui--collapse-target="content"
          class="
            tw:prose tw:mt-1 tw:hidden tw:max-w-none tw:py-2 tw:text-sm
            tw:[&_ul]:my-0 tw:[&_ul]:list-disc tw:[&_ul]:pl-5
          "
        >
          <%= page.body&.html_safe %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<h2 class="uncap tw:mt-8 tw:mb-3 tw:text-xl">Settings</h2>

<%= render UI::Card::Component.new do %>
  <%= form_with model: @registration_sequence, url: organization_registration_sequence_path(organization_id: @organization.to_param, id: @registration_sequence.id), method: :patch do |f| %>
    <div class="tw:flex tw:flex-col tw:gap-4">
      <div>
        <%= f.label :faq_url, "FAQ link", class: "twlabel" %>
        <%= f.url_field :faq_url, class: "twinput tw:w-full", placeholder: "https://" %>

        <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-500">
          Linked from every page, for registrants with questions about these
          policies.
        </p>
      </div>

      <div>
        <%= f.label :attestation_text, "Final attestation", class: "twlabel" %>

        <%= f.text_area :attestation_text, rows: 3, class: "twinput tw:w-full",
            placeholder: RegistrationSequence::DEFAULT_ATTESTATION_TEXT %>

        <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-500">
          Follows "I, <em>registrant's name</em>," on the last page, where the
          registrant agrees to everything they've acknowledged.
        </p>
      </div>

      <div>
        <%= render UI::Button::Component.new(text: "Save settings", color: :primary, kind: :submit) %>
      </div>
    </div>
  <% end %>
<% end %>
