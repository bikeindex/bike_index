<div class="tw:mb-3 tw:flex tw:items-baseline tw:justify-between tw:gap-4">
  <%# Admin's own header already names the sequence, so only the page count is left to say %>
  <% if @admin %>
    <h2 class="uncap tw:mb-0 tw:text-xl tw:font-normal tw:text-gray-500">
      <%= helpers.number_display(pages.size) %> <%= "page".pluralize(pages.size) %>
    </h2>
  <% else %>
    <h1 class="uncap">
      <%= @registration_sequence.status_display %> registration sequence
      <span class="tw:text-xl tw:font-normal tw:whitespace-nowrap tw:text-gray-500">· <%= helpers.number_display(pages.size) %> <%= "page".pluralize(pages.size) %></span>
    </h1>
  <% end %>

  <% if @registration_sequence.editable? %>
    <%= render UI::ButtonLink::Component.new(href: new_page_path, color: :secondary, class: "tw:whitespace-nowrap") do %>
      <span aria-hidden="true">+</span> Add page
    <% end %>
  <% end %>
</div>

<%= render Org::RegistrationSequence::PageList::Component.new(registration_sequence: @registration_sequence, admin: @admin) %>

<%= render UI::Card::Component.new(additional_classes: "tw:mt-8") do %>
  <% if @registration_sequence.editable? %>
    <%= form_with model: @registration_sequence, url: sequence_path, method: :patch do |f| %>
      <div class="tw:flex tw:flex-col tw:gap-4">
        <div>
          <%= f.label :faq_url, "FAQ link", class: "twlabel" %>
          <%= f.url_field :faq_url, class: "twinput tw:w-full", placeholder: "https://" %>

          <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-500">
            Linked from every page, for registrants with questions about these
            policies.
          </p>
        </div>

        <div>
          <%= f.label :acknowledgment_text, "Final acknowledgment", class: "twlabel" %>

          <%= f.text_area :acknowledgment_text, rows: 3, class: "twinput tw:w-full",
              placeholder: RegistrationSequence::DEFAULT_ACKNOWLEDGMENT_TEXT %>

          <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-500">
            Follows "I, <em>registrant's name</em>," on the last page, where the
            registrant agrees to everything they've acknowledged.
          </p>
        </div>

        <div>
          <%= render UI::Button::Component.new(text: "Save settings", color: :primary, kind: :submit) %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="tw:mb-4 tw:text-gray-600">
      Registrants have acknowledged this sequence, so it can't be edited —
      changes belong in a new draft.
    </p>
    <%= render UI::DefinitionList::Container::Component.new(term: :below) do %>
      <%= render UI::DefinitionList::Row::Component.new(label: "FAQ link", value: @registration_sequence.faq_url) %>

      <%= render UI::DefinitionList::Row::Component.new(label: "Final acknowledgment", value: @registration_sequence.acknowledgment) %>
    <% end %>
  <% end %>
<% end %>

<%= render UI::ButtonLink::Component.new(text: "Preview", href: sequence_path, color: :secondary, size: :lg, class: "tw:mt-8 tw:w-full") %>
