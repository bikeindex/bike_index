<div class="tw:mb-3 tw:flex tw:items-baseline tw:justify-between tw:gap-4">
  <%# Admin's header names the sequence %>
  <% if @admin %>
    <%= render(UI::Header::Component.new(tag: :h2, html_class: "uncap tw:mb-0! tw:font-normal! tw:text-gray-500!")) do %>
      <%= helpers.number_display(pages.size) %> <%= "page".pluralize(pages.size) %>
    <% end %>
  <% else %>
    <%= render(UI::Header::Component.new(html_class: "uncap tw:mb-0!")) do %>
      <%= @registration_sequence.status_display %>
      <%= @registration_sequence.kind_display %> registration sequence
      <span class="tw:text-xl tw:font-normal tw:whitespace-nowrap tw:text-gray-500">· <%= helpers.number_display(pages.size) %> <%= "page".pluralize(pages.size) %></span>
    <% end %>
  <% end %>

  <% if @editable %>
    <%= render UI::ButtonLink::Component.new(href: new_page_path, color: :secondary, html_class: "tw:whitespace-nowrap") do %>
      <span aria-hidden="true">+</span> Add page
    <% end %>
  <% end %>
</div>

<%= render Org::RegistrationSequence::PageList::Component.new(registration_sequence: @registration_sequence, admin: @admin) %>

<% if @editable %>
  <%= render UI::Card::Component.new(additional_classes: "tw:mt-8") do %>
    <%= form_with model: @registration_sequence, url: sequence_path, method: :patch do |f| %>
      <div class="tw:flex tw:flex-col tw:gap-4">
        <div>
          <%= f.label :faq_url, "FAQ link", class: "twlabel" %>
          <%= f.url_field :faq_url, class: "twinput tw:w-full", placeholder: "https://" %>

          <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-500">
            Linked from every page, for registrants with questions about these
            policies.
          </p>
        </div>

        <div>
          <%= f.label :acknowledgment_text, "Final acknowledgment", class: "twlabel" %>

          <%= f.text_area :acknowledgment_text, rows: 3, class: "twinput tw:w-full",
              placeholder: @registration_sequence.default_acknowledgment %>

          <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-500">
            Follows "I, <em>registrant's name</em>," on the last page, where the
            registrant agrees to everything they've acknowledged.
          </p>
        </div>

        <div>
          <%= render UI::Button::Component.new(text: "Save settings", color: :primary, type: "submit") %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<%# Admin's header carries the switch %>
<% unless @admin %>
  <%= render UI::ButtonLink::Component.new(text: "Preview", href: sequence_path, color: :secondary, size: :lg, html_class: "tw:mt-8 tw:w-full") %>
<% end %>
