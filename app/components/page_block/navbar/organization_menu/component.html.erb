<span class="current-organization-nav-item">
  <%#
    UI::Button's utilities outrank @layer legacy, so the color and box the nav gives
    its links have to be restated here to reach this toggle
  %>

  <%= render UI::Button::Component.new(
        id: "passive_organization_submenu",
        color: :link,
        html_class: "tw:block! tw:px-[15px]! tw:py-2! tw:text-white! tw:hover:text-white!",
        aria: {haspopup: true, expanded: false},
        data: {toggle: "dropdown"}
      ) do %>
    <%= @organization.short_name %>
    <%= render UI::IconChevron::Component.new(direction: :down, html_class: "tw:ml-1") %>
  <% end %>

  <ul
    class="current-organization-submenu"
    aria-labelledby="passive_organization_submenu"
  >
    <%= render menu_items %>
  </ul>
</span>
