<span class="current-organization-nav-item">
  <%# UI::Button's utilities outrank @layer legacy, so the toggle is styled here %>

  <%= render UI::Button::Component.new(
        id: "passive_organization_submenu",
        color: :link,
        html_class: "tw:block! tw:px-[15px] tw:py-2 tw:mb-2 " \
          "tw:font-header tw:text-xs tw:leading-[18px] tw:uppercase tw:text-white",
        aria: {haspopup: true, expanded: false},
        data: {action: "click->page-block--navbar#toggleDropdown",
               "page-block--navbar-target": "organizationToggle"}
      ) do %>
    <%= @organization.short_name %>
    <%= render UI::IconChevron::Component.new(direction: :down, html_class: "tw:ml-1") %>
  <% end %>

  <ul
    class="current-organization-submenu"
    aria-labelledby="passive_organization_submenu"
  >
    <%= render menu_items %>
  </ul>
</span>
