<%= render UI::Dropdown::Component.new(name: @name, button_class: @button_class) do |dropdown| %>
  <%# The caller's trigger, as content rather than a slot -- a slot this deep goes unevaluated %>
  <% dropdown.with_button { content } %>

  <% items.each do |item| %>
    <% if item[:type] == :divider %>
      <% dropdown.with_entry_divider %>
    <% else %>
      <% dropdown.with_entry_item do %>
        <%= link_to item[:label], item[:path], **link_options(item) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
