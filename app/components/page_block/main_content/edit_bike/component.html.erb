<div id="edit-bike-skeleton">
  <div class="form-well-header container" data-template="<%= @edit_template %>">
    <% unless @bike.version? %>
      <%# Show alerts if bike is impounded or has current notifications %>
      <%= helpers.render partial: "/bikes/owner_bike_status_alerts" %>
    <% end %>

    <div class="edit-bike-header">
      <h1 class="uncap">
        <% if @bike.status_with_owner? %>
          <%= translation(".edit") %>
        <% else %>
          <%= bike_status_span(@bike) %>
        <% end %>

        <% if @bike.version? %>
          <strong><%= @bike.display_name %></strong>
          <small class="d-block d-md-inline">
            of <em><%= @bike_og.title_string %></em>
          </small>
        <% else %>
          <%= bike_title_html(@bike) %>
        <% end %>

        <% if @bike.deleted? %>
          <em class="text-danger uncap d-block">
            This <%= @bike.version? ? "version" : @bike.type %> was deleted
            <% if @bike.deleted_at.present? %>
              <span class="localizeTime preciseTime withPreposition">
                <%= l(@bike.deleted_at, format: :convert_time) %>
              </span>
            <% end %>
          </em>
        <% end %>
      </h1>

      <% unless @bike.user? %>
        <p class="mb-0">
          <% if @bike.authorized_by_organization?(u: @current_user, org: @passive_organization) %>
            <%= translation(".owned_with_permission_to_edit_html", owner_email:, org_name: @passive_organization&.short_name) %>
          <% else # it's almost certainly because the user hasn't claimed it %>
            <%= translation(".owned_but_hasnt_been_claimed_html", owner_email:) %>
          <% end %>
        </p>
      <% end %>

      <p class="mb-4">
        <% if @bike.version? %>
          <%= link_to translation(".view_bike_version", bike_type: @bike.type_titleize), bike_version_path(@bike), class: "gray-link" %>
        <% else %>
          <%= link_to translation(".view_bike", bike_type: @bike.type_titleize), bike_path(@bike), class: "gray-link" %>
        <% end %>
      </p>
    </div>
  </div>

  <%= content %>

  <div class="mobile-nonfloating-menu pl-1 pr-1 text-center bootstrapstyle">
    <strong class="d-inline-block">
      <%= translation(".edit_pages", bike_type: @bike.type) %>
    </strong>

    <% @edit_templates.each do |template, description| %>
      <% is_active = 'active' if @edit_template.match(/#{template}/) %>

      <a
        class="ml-1 mr-1 d-inline-block text-underline <%= is_active %>"
        href="<%= helpers.edit_bike_template_path_for(@bike, template) %>"
      >
        <%= description %>
      </a>
    <% end %>
  </div>
</div>
