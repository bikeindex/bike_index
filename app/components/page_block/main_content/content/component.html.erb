<div class="container">
  <div class="row">
    <div class="col-md-8 primary-content-block legacy-content-wrap">
      <%= content %>

      <div class="d-md-none d-sm-block mb-2 mt-4">
        <div class="ad-block ad-binx ad468x60"></div>
      </div>
    </div>

    <div class="col-md-4 primary-content-menu">
      <%# check if this is a donation info page %>
      <% if render_why_donate? %>
        <div class="next-steps-wrap donation">
          <header>
            <%= translation(".make_a_difference") %>
            <%= link_to translation(".donate_today"), donate_path(source: referral_source), class: "btn btn-primary" %>
          </header>

          <ul>
            <li class="mt-3">
              <%= link_to "Donate $5", donate_path(initial_amount: 5, source: referral_source), class: "btn btn-secondary donate-btn" %>
            </li>

            <li class="mt-2">
              <%= link_to "Donate $50", donate_path(initial_amount: 50, source: referral_source), class: "btn btn-secondary donate-btn" %>
            </li>

            <li class="mt-2 mb-2">
              <%= link_to "Donate $200", donate_path(initial_amount: 200, source: referral_source), class: "btn btn-secondary donate-btn" %>
            </li>
          </ul>
        </div>
        <style type="text/scss">
          .next-steps-wrap .btn.donate-btn {
            display: block;
            width: auto;
            margin-top: 0;
          }
          .next-steps-wrap.donation {
            border-radius: 4px;
          }
        </style>
      <% elsif render_get_your_stolen_bike_back? %>
        <div class="next-steps-wrap donation">
          <header>
            Bike Index recovery record
          </header>

          <ul>
            <li class="mt-3">
              <strong><%= number_with_delimiter(Counts.recoveries) %> -</strong>
              Stolen bikes recovered
            </li>

            <li class="mt-2">
              <strong>$<%= number_with_delimiter(Counts.recoveries_value) %> -</strong>
              Value of bikes recovered with Bike Index
            </li>
          </ul>
        </div>
      <% else %>
        <nav class="content-nav-group">
          <h3><%= translation(".related") %></h3>

          <ul class="tw:m-0 tw:mb-4 tw:list-none">
            <% if content_page_type == "news" %>
              <li>
                <%#
                  Only the unfiltered index: a search or a period is a narrower page than
                  this link points at, which is what :full_path tells apart
                %>

                <%= render UI::ActiveLink::Component.new(text: translation(".bike_index_news"),
                      path: news_index_path, match: :full_path) %>
              </li>
            <% end %>

            <% if @related_blogs.present? %>
              <% @related_blogs.each do |blog| %>
                <li class="mt-3"><%= link_to blog.title, news_url(blog) %></li>
              <% end %>
            <% else %>
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".about"), path: about_path) %>
              </li>
            <% end %>

            <% unless content_page_type == "news" %>
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".help"), path: help_url) %>
              </li>
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".where"), path: where_path) %>
              </li>
              <% if %w(manufacturers where).include?(content_page_type) %>
                <li>
                  <%= render UI::ActiveLink::Component.new(text: translation(".sign_up_your_organization"), path: new_organization_path) %>
                </li>
              <% end %>
            <% end %>
          </ul>
        </nav>
        <nav class="content-nav-group">
          <h3><%= translation(".other_pages") %></h3>

          <ul class="tw:m-0 tw:mb-4 tw:list-none">
            <li>
              <%= render UI::ActiveLink::Component.new(text: translation(".how_to_get_your_stolen_bike_back"), path: get_your_stolen_bike_back_path) %>
            </li>

            <% unless content_page_type == "news" %>
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".bike_index_news"), path: news_index_path) %>
              </li>
            <% end %>

            <li>
              <%= render UI::ActiveLink::Component.new(text: translation(".protect_your_bike"), path: protect_your_bike_path) %>
            </li>

            <li>
              <%= render UI::ActiveLink::Component.new(text: translation(".bicycle_serials"), path: serials_path) %>
            </li>

            <% if %w(news about manufacturers).include?(content_page_type) %>
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".donate"), path: why_donate_path) %>
              </li>
            <% end %>

            <% if %w(news serials manufacturers).include?(content_page_type) %>
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".bike_index_store"), path: store_path) %>
              </li>
            <% end %>

            <li>
              <%= render UI::ActiveLink::Component.new(text: translation(".design_and_developer_resources"), path: resources_path) %>
            </li>

            <li>
              <%= render UI::ActiveLink::Component.new(text: translation(".sign_up_your_organization"), path: new_organization_path) %>
            </li>
          </ul>
        </nav>
        <div class="ad-block ad-binx ad300x600 d-none d-md-block"></div>
        <%= helpers.render partial: "/shared/google_ad", locals: {klass: "ad-block ad-google ad300x600 mt-3 d-none d-md-block"} %>
      <% end %>
    </div>
  </div>

  <% if render_get_your_stolen_bike_back? %>
    <div class="root-landing-recovery-stories mt-4">
      <div id="recovery-stories-container" class="extras-hidden">
        <%= helpers.render partial: "shared/recovery_display", collection: RecoveryDisplay.limit(5) %>

        <div class="recovery-block recovery-see-more">
          <%= link_to "read more recovery stories",
            recovery_stories_path,
            class: "see-more-link" %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @blog.present? && @current_user&.superuser? %>
    <div class="text-center mt-4 less-strong">
      <%= link_to "edit post", edit_admin_news_path(@blog), class: "btn btn-outline-primary" %>
    </div>
  <% end %>
</div>
