<nav class="organized-left-menu bootstrapstyle">
  <div class="organized-menu-wrapper">
    <header class="<%= show_overview_dashboard? ? "with-dashboard-link" : "with-divider-below" %>">
      <% if OrganizationDisplayer.avatar?(@current_organization) %>
        <%= image_tag @current_organization.avatar.url(:medium), alt: @current_organization.name %>
      <% end %>

      <h3>
        <%= translation(".admin_panel") %>
        <span><%= @current_organization.name %></span>
      </h3>
    </header>

    <ul class="organized-mainmenu">
      <%# unless we're showing overview_dashboard, we want to start off with a divider - which is not true of the header menu %>
      <% unless show_overview_dashboard? %>
        <li class="divider-nav-item"></li>
      <% end %>

      <%= render menu_items %>
    </ul>
  </div>
</nav>

<div class="organized-wrap">
  <div class="<%= helpers.organized_container %>">
    <%# the layout skips its own spot for this - the menu is positioned over it %>
    <% if @show_general_alert %>
      <%= render PageBlock::UserAlerts::Wrapper::Component.new(current_user: @current_user, wrapper_class: nil) %>
    <% end %>

    <% if OrganizationDisplayer.law_enforcement_missing_verified_features?(@current_organization) %>
      <div class="organization-wide-alert alert alert-info in">
        <button
          class="close"
          aria-label="Close"
          data-dismiss="alert"
          type="button"
        >
          <span aria-hidden="true">&times;</span>
        </button>

        <p>
          <%= translation(".additional_features_html", email_link: link_to("gavin@bikeindex.org", "mailto:gavin@bikeindex.org")) %>
        </p>
      </div>
    <% end %>

    <% if OrganizationDisplayer.subscription_expired_alert?(@current_organization) %>
      <div class="organization-wide-alert alert alert-info in">
        <button
          class="close"
          aria-label="Close"
          data-dismiss="alert"
          type="button"
        >
          <span aria-hidden="true">&times;</span>
        </button>

        <p>
          <%= translation(".subscription_expired_html", email_link: link_to("gavin@bikeindex.org", "mailto:gavin@bikeindex.org")) %>
        </p>
      </div>
    <% end %>

    <% if OrganizationDisplayer.bike_shop_display_integration_alert?(@current_organization) %>
      <div class="organization-wide-alert alert alert-info in">
        <button
          class="close"
          aria-label="Close"
          data-dismiss="alert"
          type="button"
        >
          <span aria-hidden="true">&times;</span>
        </button>

        <div>
          <p><%= translation(".use_lightspeed_retail_pos") %></p>

          <ul>
            <li>
              <% link = link_to translation(".integrate_bike_index_with_lightspeed"), lightspeed_interface_path %>
              <%= translation(".link_to_register_html", link:) %>
            </li>

            <li>
              <% link = link_to translation(".how_integration_works"), lightspeed_path %>
              <%= translation(".read_a_full_explanation_html", link:) %>
            </li>
          </ul>
        </div>

        <div class="mt-2">
          <p><%= translation(".use_ascend") %></p>

          <ul>
            <li>
              <% link = link_to translation(".integrate_bike_index_with_ascend"), ascend_path %>
              <%= translation(".link_to_register_html", link:) %>
            </li>
          </ul>
        </div>

        <div class="mt-2">
          <p><%= translation(".other_point_of_sale_system") %></p>

          <ul>
            <li>
              <% if @controller_name == "bikes" && @action_name == "new" %>
                <%= translation(".viewing_our_streamlined_page") %>
              <% else %>
                <% link = link_to translation(".streamlined_bike_shop_registration_page"), new_organization_bike_path(organization_id: @current_organization.to_param) %>
                <%= translation(".register_bikes_with_link_html", link:) %>
              <% end %>
            </li>
          </ul>
        </div>
      </div>
    <% end %>

    <%= content %>
  </div>
</div>

<% if helpers.organized_include_javascript_pack? %>
  <script>
    window.passiveOrganizationId = <%== @passive_organization&.slug.to_json %>;
  </script>
  <%# Important that this is below the content, sometimes important page data is added to the dom in there %>
  <script src="/vendored_assets/application.js"></script>
<% end %>
