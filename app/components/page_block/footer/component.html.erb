<% cache(cache_key) do %>
  <footer class="primary-footer">
    <div class="primary-footer-nav">
      <div class="container">
        <div class="row">
          <nav
            class="col-md-2 pull-right"
            aria-label="<%= translation(".bike_index") %>"
          >
            <h4><%= translation(".bike_index") %></h4>

            <ul class="tw:m-0 tw:list-none">
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".search"), path: helpers.default_bike_search_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".marketplace"), path: search_marketplace_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".register_a_bike"), path: new_register_path, match: :controller) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".faq_and_help"), path: help_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".blog"), path: news_index_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".about"), path: about_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".where_we_are"), path: where_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".stolen_bike_recoveries"), path: recovery_stories_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".how_to_get_your_stolen_bike_back"), path: get_your_stolen_bike_back_path) %>
              </li>
            </ul>
          </nav>

          <nav
            class="col-md-2 pull-right"
            aria-label="<%= translation(".support_us") %>"
          >
            <h4><%= translation(".support_us") %></h4>

            <ul class="tw:m-0 tw:list-none">
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".donate"), path: why_donate_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".store"), path: store_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".ambassadors"), path: ambassadors_how_to_path) %>
              </li>
            </ul>
          </nav>

          <nav
            class="col-md-2 pull-right"
            aria-label="<%= translation(".resources") %>"
          >
            <h4><%= translation(".resources") %></h4>

            <ul class="tw:m-0 tw:list-none">
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".api_documentation"), path: documentation_index_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".dev_and_design_resources"), path: resources_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".security"), path: security_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".bike_manufacturer_list"), path: manufacturers_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".protect_your_bike"), path: protect_your_bike_path) %>
              </li>

              <li>
                <%= link_to translation(".status_page"), "https://status.bikeindex.org" %>
              </li>

              <% if Flipper.enabled?(:strava_integration, @current_user) %>
                <li>
                  <%= render UI::ActiveLink::Component.new(text: translation(".strava_search"), path: strava_search_path) %>
                </li>
              <% end %>
            </ul>
          </nav>

          <nav
            class="col-md-2 pull-right"
            aria-label="<%= translation(".who_we_serve") %>"
          >
            <h4><%= translation(".who_we_serve") %></h4>

            <ul class="tw:m-0 tw:list-none">
              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".bike_shops"), path: for_bike_shops_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".schools_and_universities"), path: for_schools_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".cities"), path: for_cities_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".law_enforcement"), path: for_law_enforcement_path) %>
              </li>

              <li>
                <%= render UI::ActiveLink::Component.new(text: translation(".community_groups"), path: for_community_groups_path) %>
              </li>

              <li>
                <%= link_to translation(".press_inquiries"), "mailto:bryan@bikeindex.org,gavin@bikeindex.org" %>
              </li>
            </ul>
          </nav>

          <div class="col-md-2 pull-right"></div>

          <nav
            class="col-md-2 social-nav"
            aria-label="<%= translation(".social_media") %>"
          >
            <ul class="tw:m-0 tw:list-none">
              <li>
                <%# = link_to "https://twitter.com/BikeIndex" do %>
                <%# %span.sr-only Bike Index Twitter %>
                <%# = inline_svg_tag "icons/twitter.svg", class: "tw:block tw:w-6 tw:h-6" %>
                <%# end %>
                <%= link_to "https://bsky.app/profile/bikeindex.org" do %>
                  <span class="sr-only">Bike Index Blue SKy</span>
                  <%= helpers.inline_svg_tag "icons/bluesky.svg", class: "tw:block tw:w-6 tw:h-6" %>
                <% end %>
              </li>

              <li>
                <%= link_to "https://universeodon.com/@bikeindex", rel: 'me' do %>
                  <span class="sr-only">Bike Index Fediverse</span>
                  <%= helpers.inline_svg_tag "icons/mastodon.svg", class: "tw:block tw:w-6 tw:h-6" %>
                <% end %>
              </li>

              <li>
                <%= link_to "https://facebook.com/bikeindex" do %>
                  <span class="sr-only">Bike Index Facebook</span>
                  <%= helpers.inline_svg_tag "icons/facebook.svg", class: "tw:block tw:w-6 tw:h-6" %>
                <% end %>
              </li>

              <li>
                <%= link_to "https://instagram.com/bikeindex" do %>
                  <span class="sr-only">Bike Index Instagram</span>
                  <%= helpers.inline_svg_tag "icons/instagram.svg", class: "tw:block tw:w-6 tw:h-6" %>
                <% end %>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>

    <nav class="terms-and-stuff" aria-label="<%= translation(".legal") %>">
      <div class="container">
        <div class="row">
          <div class="col-md-6 text-left">
            <%#
              No action: the footer is cached across every page, so the URL to add the locale
              to is the one the browser is on -- which an action-less GET form submits to
            %>

            <%= tag.form method: :get, class: "locale-form", data: {
                  controller: "page-block--locale-select",
                  action: "submit->page-block--locale-select#submit change->page-block--locale-select#submit"
                } do %>
              <div class="row">
                <div class="form-group">
                  <%= label_tag(:locale, translation(".language")) %>

                  <%= select_tag(:locale,
                  options_for_select(helpers.language_choices, selected: I18n.locale),
                  class: "form-control-sm") %>

                  <% if @current_user.present? && @current_user.preferred_language != I18n.locale %>
                    <em class="below-input-help text-right">
                      <%= link_to translation(".change_preferred_language"), edit_my_account_path %>
                    </em>
                  <% end %>

                  <%= submit_tag "update", name: "Update", class: "btn btn-primary btn-sm sr-only" %>
                </div>
              </div>
            <% end %>
          </div>

          <div class="col-md-6 text-right">
            <p>
              <%= [link_to(translation(".privacy_policy"), privacy_url),
              (@current_user&.has_organization_role? ? link_to(translation(".vendor_terms"), vendor_terms_url) : nil),
            link_to(translation(".terms_and_conditions"), terms_url)].compact.to_sentence.html_safe %>
            </p>

            <p>
              <span
                data-license="https://github.com/bikeindex/bike_index/blob/main/LICENSE"
              >
                <%= translation(".copyright_html", current_year: Time.current.year) %>
              </span>
            </p>
          </div>
        </div>
      </div>
    </nav>
  </footer>

  <% unless @skip_facebook %>
    <%# Facebook pixel %>
    <script>
  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
  n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
  document,'script','https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', <%= raw FACEBOOK_PIXEL_ID.to_json %>);
  fbq('track', "PageView");
  </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=<%= FACEBOOK_PIXEL_ID %>&amp;ev=PageView&amp;noscript=1"
        alt=""
      >
    </noscript>
  <% end %>

  <script>
  var trackOutboundLink = function(url) {
    ga("send", "event", "outbound", "click", url, {transport: "beacon", hitCallback: function() {document.location = url;}});
  };

  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-K88RMWC');
</script>

  <iframe
    src="https://www.googletagmanager.com/ns.html?id=GTM-K88RMWC"
    height="0"
    width="0"
    style="display:none;visibility:hidden"
    title="Google tag manager"
  ></iframe>
<% end %>
