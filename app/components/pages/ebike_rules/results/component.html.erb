<section
  aria-live="polite"
  class="
    tw:mx-auto tw:flex tw:max-w-[1120px] tw:flex-col tw:gap-6
    tw:px-[clamp(12px,4vw,32px)] tw:pt-[clamp(28px,5vw,40px)] tw:pb-2
  "
>
  <div
    role="status"
    class="tw:flex tw:gap-4 tw:rounded-lg tw:border-2 tw:px-[clamp(16px,3vw,28px)] tw:py-5 tw:dark:bg-gray-800 <%= VERDICTS[@verdict][:classes] %>"
  >
    <%= render(Pages::EbikeRules::StatusIcon::Component.new(status: VERDICTS[@verdict][:icon], size: :lg)) %>

    <div class="tw:flex tw:min-w-0 tw:flex-col tw:gap-1">
      <span class="tw:text-xs tw:font-bold tw:tracking-[.08em] tw:uppercase"><%= verdict_label %></span>

      <p
        class="
          tw:font-header tw:text-[clamp(18px,2.4vw,22px)] tw:leading-snug
          tw:font-bold
        "
      >
        <%= render(Pages::EbikeRules::UnbrokenHyphens::Component.new(text: headline)) %>
      </p>

      <% if details.any? %>
        <ul
          class="
            tw:flex tw:flex-col tw:gap-1 tw:text-[15px] tw:text-gray-700
            tw:dark:text-gray-300
          "
        >
          <% details.each do |detail| %>
            <li><%= detail %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>

  <div
    class="
      tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))]
      tw:items-start tw:gap-6
    "
  >
    <%= render(UI::Card::Component.new(shadow: true, additional_classes: "tw:rounded-lg tw:p-0!")) do %>
      <% if @bike.photo_url %>
        <div
          class="
            tw:relative tw:h-[clamp(200px,26vw,260px)] tw:overflow-hidden
            tw:rounded-t-lg tw:border-b tw:border-gray-200 tw:bg-gray-50
            tw:dark:border-gray-700 tw:dark:bg-gray-900
          "
        >
          <%= image_tag @bike.photo_url, alt: bike_name, class: "tw:size-full tw:object-contain" %>

          <span
            class="
              tw:pointer-events-none tw:absolute tw:top-3 tw:left-3
              tw:rounded-full tw:bg-white/90 tw:px-2.5 tw:py-1 tw:text-xs
              tw:font-bold tw:tracking-[.06em] tw:text-gray-700 tw:uppercase
            "
          >
            <%= translation(".stock_photo") %>
          </span>
        </div>
      <% end %>

      <div class="tw:flex tw:flex-col tw:gap-5 tw:p-[clamp(18px,3vw,28px)]">
        <div class="tw:flex tw:items-start tw:gap-4">
          <div class="tw:min-w-0 tw:flex-1">
            <span class="<%= EYEBROW_CLASSES %>"><%= translation(".your_bike") %></span>

            <h2 class="<%= NAME_CLASSES %>">
              <%= @bike.manual? ? translation(".your_ebike") : @bike.make_and_model %>
            </h2>

            <p class="tw:mt-1 tw:text-[15px] tw:text-gray-700 tw:dark:text-gray-300">
              <%= subline %>
            </p>
          </div>

          <div class="tw:flex tw:flex-none tw:gap-2">
            <% tile_classes.each do |e_bike_class| %>
              <%= render(Pages::EbikeRules::ClassTile::Component.new(e_bike_class:, class_unknown: @bike.class_unknown, size: :lg)) %>
            <% end %>
          </div>
        </div>

        <div class="tw:border-y tw:border-gray-200 tw:py-4 tw:dark:border-gray-700">
          <%= render(UI::DefinitionList::Container::Component.new(term: :below)) do %>
            <% specs.each do |label, value| %>
              <%= render(UI::DefinitionList::Row::Component.new(label:, value:, render_with_no_value: true,
                no_value_text: translation(".not_provided"))) %>
            <% end %>
          <% end %>
        </div>

        <div class="tw:flex tw:flex-col tw:gap-3.5">
          <h3 class="tw:text-[15px] tw:font-bold">
            <%= translation(".ul_certification") %>
          </h3>

          <%= render(Pages::EbikeRules::UlBadge::Component.new(standard: 2849, status: @bike.ul2849)) %>
          <%= render(Pages::EbikeRules::UlBadge::Component.new(standard: 2271, status: @bike.ul2271)) %>
        </div>

        <% if @bike.manual? %>
          <p
            class="
              tw:rounded-sm tw:bg-gray-50 tw:px-3 tw:py-2.5 tw:text-sm
              tw:text-gray-700 tw:dark:bg-gray-900 tw:dark:text-gray-300
            "
          >
            <%= translation(".entered_unverified") %>
          </p>
        <% else %>
          <%= link_to bikebook_path(vehicle_models: @bike.bikebook_id), class: "twlink tw:inline-flex tw:items-center tw:gap-1.5 tw:text-[15px] tw:font-semibold" do %>
            <%= translation(".full_bikebook_entry") %>
            <%= helpers.inline_svg_tag("icons/external-link.svg", class: "tw:size-4", aria_hidden: true) %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= render(UI::Card::Component.new(shadow: true, additional_classes: "tw:flex tw:flex-col tw:gap-4 tw:rounded-lg tw:p-[clamp(18px,3vw,28px)]!")) do %>
      <div>
        <span class="<%= EYEBROW_CLASSES %>"><%= translation(".your_state") %></span>
        <h2 class="<%= NAME_CLASSES %>"><%= @state[:name] %></h2>

        <p class="tw:mt-1.5 tw:text-[15px] tw:text-gray-700 tw:dark:text-gray-300">
          <%= @law ? @law[:description] : translation(".being_compiled") %>
        </p>
      </div>

      <% if @law %>
        <ul class="tw:border-t tw:border-gray-200 tw:dark:border-gray-700">
          <% @rules.each do |row| %>
            <li
              class="
                tw:grid tw:grid-cols-[22px_minmax(0,1fr)] tw:items-start
                tw:gap-x-3 tw:border-b tw:border-gray-200 tw:py-3
                tw:dark:border-gray-700
              "
            >
              <span class="tw:mt-px"><%= render(Pages::EbikeRules::StatusIcon::Component.new(status: row[:status], label: status_label(row[:status]))) %></span>

              <div class="tw:flex tw:min-w-0 tw:flex-col tw:gap-0.5">
                <span class="tw:text-sm tw:font-bold"><%= render(Pages::EbikeRules::RuleLabel::Component.new(id: row[:id])) %></span>
                <span class="tw:text-[15px] tw:text-gray-700 tw:dark:text-gray-300"><%= render(Pages::EbikeRules::RuleValue::Component.new(law: @law, id: row[:id])) %></span>
                <span class="tw:text-sm tw:font-semibold"><%= note(row) %></span>
              </div>
            </li>
          <% end %>
        </ul>

        <div data-controller="ui--collapse">
          <%= render(UI::Collapse::Component.new(text: translation(".read_more"), chevron: :trailing, color: :link)) %>

          <div class="tw:mt-4 tw:hidden" data-ui--collapse-target="content">
            <%= render(Pages::EbikeRules::LawDetails::Component.new(law: @law)) %>
          </div>
        </div>

        <p class="tw:text-[13px] tw:text-gray-700 tw:dark:text-gray-300">
          <%= translation(".source_html", link: link_to(translation(".bikebook_name"), bikebook_path(vehicle_models: @law[:id]), class: "twlink")) %>
        </p>
      <% else %>
        <div
          class="
            tw:flex tw:flex-col tw:gap-2 tw:rounded-lg tw:border
            tw:border-dashed tw:border-gray-300 tw:p-4.5
            tw:dark:border-gray-600
          "
        >
          <strong class="tw:text-[15px]"><%= translation(".still_reviewing", state: @state[:name]) %></strong>
          <span class="tw:text-[15px] tw:text-gray-700 tw:dark:text-gray-300"><%= translation(".still_reviewing_body") %></span>
        </div>
      <% end %>
    <% end %>
  </div>

  <div
    class="
      tw:flex tw:flex-wrap tw:items-center tw:gap-x-6 tw:gap-y-4
      tw:rounded-lg tw:border-3 tw:border-[#111] tw:bg-white
      tw:px-[clamp(18px,3vw,28px)] tw:py-[clamp(18px,3vw,24px)]
      tw:shadow-[4px_4px_0_#111] tw:dark:bg-gray-800
    "
  >
    <div class="tw:flex-[1_1_300px]">
      <h3 class="tw:font-header tw:text-xl tw:font-extrabold">
        <%= translation(".is_registered") %>
      </h3>

      <p class="tw:mt-1 tw:text-[15px] tw:text-gray-700 tw:dark:text-gray-300">
        <%= translation(".recovered_more_often") %>
      </p>
    </div>

    <%= render(UI::ButtonLink::Component.new(href: register_href, text: translation(".register_free"), color: :yellow, size: :callout)) %>
  </div>
</section>
