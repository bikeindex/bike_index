<%= helpers.turbo_frame_tag(FRAME_ID, class: ["tw:block", @additional_classes]) do %>
  <section
    class="
      tw:border-y tw:border-gray-200 tw:bg-gray-50 tw:dark:border-gray-700
      tw:dark:bg-gray-900
    "
  >
    <div class="tw:py-[clamp(40px,7vw,64px)] <%= Pages::EbikeRules::Show::Component::SECTION_CLASSES %>">
      <% heading, intro = if outside_us
        [unbroken_hyphen(translation(".place_heading", place: @place[:name]))]
      elsif state_classes
        [unbroken_hyphen(translation(".state_classes_heading", state: @place[:name])),
          translation(".state_classes_intro", state: @place[:name])]
      else
        [unbroken_hyphen(translation(".classes_heading")), translation(".classes_intro")]
      end %>

      <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(heading:, intro:,
        html_class: ("tw:mb-7 tw:max-w-[640px]" if intro))) %>

      <% if outside_us %>
        <div class="tw:mt-7 tw:flex tw:flex-col tw:gap-8">
          <% outside_us[:laws].each do |law| %>
            <%= render(UI::Card::Component.new(additional_classes: "tw:p-6!")) do %>
              <%= render(Pages::EbikeRules::LawSummary::Component.new(law:, titled: true)) %>
            <% end %>
          <% end %>
        </div>

        <% if cards.any? %>
          <h3 class="tw:mt-10 tw:mb-4 tw:font-header tw:text-xl tw:font-extrabold">
            <%= translation(".other_classes", place: @place[:name]) %>
          </h3>
        <% end %>
      <% end %>

      <div
        class="
          tw:group/class-cards tw:grid
          tw:grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))]
          tw:gap-4
        "
      >
        <% cards.each do |card| %>
          <%= render(card) %>
        <% end %>
      </div>

      <% if state_law %>
        <div
          class="tw:mt-6"
          data-controller="ui--collapse"
          data-ui--collapse-param-value="state_rules"
        >
          <%= render(UI::Collapse::Component.new(text: translation(".state_rules", state: @place[:name]), chevron: :trailing, color: :link)) %>

          <div class="tw:mt-4 tw:hidden" data-ui--collapse-target="content">
            <%= render(UI::Card::Component.new(additional_classes: "tw:p-[clamp(18px,3vw,28px)]!")) do %>
              <h3 class="tw:mb-3 tw:font-header tw:text-xl tw:font-extrabold">
                <%= state_law[:name] %>
              </h3>

              <%= render(Pages::EbikeRules::LawDetails::Component.new(law: state_law)) %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
