<%# A snapshot keeps the state chosen on leaving, which connecting would act on and leave again %>
<% helpers.content_for(:header) { tag.meta(name: "turbo-cache-control", content: "no-cache") } %>

<section
  class="
    tw:border-b tw:border-gray-200 tw:bg-gray-50 tw:dark:border-gray-700
    tw:dark:bg-gray-900
  "
>
  <div class="tw:pt-[clamp(36px,6vw,64px)] tw:pb-28 <%= SECTION_CLASSES %>">
    <h1
      class="
        tw:mb-3.5 tw:font-header tw:text-[clamp(34px,6vw,54px)]
        tw:leading-[1.05] tw:font-black tw:tracking-[-.01em]
      "
    >
      <%= unbroken_hyphen(translation(".heading")) %>
    </h1>

    <p
      class="
        tw:max-w-[620px] tw:text-[clamp(16px,2vw,19px)] tw:text-gray-700
        tw:dark:text-gray-300
      "
    >
      <%= copy[:subheading] %>
    </p>
  </div>
</section>

<div
  id="check"
  class="tw:relative tw:-mt-20 tw:scroll-mt-4 <%= SECTION_CLASSES %>"
>
  <%= form_with url: form_path, method: :get, html: {aria: {label: translation(".form_label")}},
      class: "tw:group/lookup tw:flex tw:flex-col tw:gap-3.5 tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:p-[clamp(18px,4vw,32px)] tw:shadow-[0_10px_30px_rgba(44,62,80,.16)] tw:dark:border-gray-700 tw:dark:bg-gray-800",
      data: {controller: "ebike-rules--lookup", action: "turbo:frame-load@document->ebike-rules--lookup#checkLoaded click@window->ebike-rules--lookup#checkInState", details: details_mode,
             "ebike-rules--lookup-manifest-url-value": @manifest_url,
             "ebike-rules--lookup-path-value": ebike_rules_path,
             "ebike-rules--lookup-country-path-value": country_path,
             "ebike-rules--lookup-display-value": bike_display,
             "ebike-rules--lookup-legend-value": translation(".details_legend"),
             "ebike-rules--lookup-model-legend-value": translation(".model_details", model: "%{model}"),
             "ebike-rules--lookup-failed-text-value": translation(".bikebook_didnt_load"),
             "ebike-rules--lookup-title-value": @default_title} do |f| %>
    <%#
      A line height rather than a min-height, which the state's "(CO)" overlay copies along with the font;
      forced past the gem's own stylesheet, which is unlayered
    %>

    <div
      class="
        tw:flex tw:flex-wrap tw:items-start tw:gap-4
        tw:[&_.hw-combobox\_\_input]:leading-[34px]!
      "
    >
      <div class="tw:flex tw:min-w-0 tw:flex-[2_1_220px] tw:flex-col tw:gap-2">
        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :state, label_text: copy[:state],
            optional_badge: false, wrapper_class: nil)) do %>
          <div
            data-ebike-rules--lookup-target="state"
            data-action="hw-combobox:selection->ebike-rules--lookup#chooseState"
          >
            <%= render(UI::Forms::ComboboxState::Component.new(states: place_options,
                html_options: {value: place_value, placeholder: copy[:select_state],
                               aria: {invalid: (true if error?(:state))}})) %>
          </div>
        <% end %>

        <%# Shown in the browser when a bike is picked before a state %>
        <template data-ebike-rules--lookup-target="stateNeeded">
          <p
            role="alert"
            class="
              tw:text-[13px] tw:font-semibold tw:text-red-700
              tw:dark:text-red-400
            "
          >
            <%= copy[:state_error] %>
          </p>
        </template>

        <%# A note on the place runs on into the country switch, until a pick clears it %>
        <div
          class="
            tw:flex tw:flex-col tw:gap-2 tw:has-[[data-inline-note]]:block
            tw:has-[[data-inline-note]]:[&_p]:inline
          "
        >
          <div data-ebike-rules--lookup-target="stateNote" class="tw:contents">
            <% if error?(:state) %>
              <%= field_error(:state, copy[:state_error]) %>
            <% elsif detected? %>
              <p
                class="tw:text-[13px] tw:text-gray-700 tw:dark:text-gray-300"
                data-inline-note
              >
                <%= helpers.inline_svg_tag("icons/map-pin.svg", class: "tw:inline tw:size-3.5 tw:align-[-2px] tw:text-blue-600", aria_hidden: true) %>

                <span><%= translation(".detected_place_html", state: @lookup.detected_place[:name]) %></span>
              </p>
            <% elsif place_value.nil? %>
              <p
                class="tw:text-[13px] tw:text-gray-700 tw:dark:text-gray-300"
                data-inline-note
              >
                <%= copy[:choose_place] %>
              </p>
            <% end %>
          </div>

          <p class="tw:text-[13px] tw:text-gray-700 tw:dark:text-gray-300">
            <%= copy[:not_in_country] %>
          </p>
        </div>
      </div>

      <div class="tw:flex tw:min-w-0 tw:flex-[4_1_300px] tw:flex-col tw:gap-2">
        <%# Grayed while custom details stand in for the model's, until it's picked from again %>
        <div
          class="
            tw:flex tw:flex-col tw:gap-2 tw:transition-opacity
            tw:group-data-[details=custom]/lookup:not-focus-within:opacity-50
          "
        >
          <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :vehicle_models, label_text: translation(".bike_model"),
            optional_badge: false, wrapper_class: nil)) do %>
            <%# Stamped once the catalog loads, so the combobox searches it from its first keystroke %>
            <template data-ebike-rules--lookup-target="combobox">
              <%= render(UI::Forms::Combobox::Component.new(name: "vehicle_models", src: bikebook_path(electric: 1, market: @lookup.country),
                dialog_label: translation(".bike_model"),
                html_options: {value: @lookup.bikebook_id, placeholder: translation(".bike_placeholder"),
                               aria: {invalid: (true if error?(:bike))}})) %>
            </template>

            <div
              data-ebike-rules--lookup-target="comboboxSlot"
              data-action="
                  hw-combobox:selection->ebike-rules--lookup#chooseBike
                  pointerdown->ebike-rules--lookup#notePick:capture
                  keydown.enter->ebike-rules--lookup#notePick:capture
                  click->ebike-rules--lookup#repick
                  keydown.enter->ebike-rules--lookup#repick
                "
            >
              <input
                id="vehicle_models"
                type="text"
                class="twinput tw:min-h-12 tw:text-base!"
                placeholder="<%= translation(".bikebook_loading") %>"
                autocomplete="off"
                disabled
              >
            </div>
          <% end %>

          <%= field_error(:bike, translation(".bike_error")) %>
        </div>

        <p class="tw:text-[13px] tw:text-gray-700 tw:dark:text-gray-300">
          <%= translation(".compare_html", link: link_to(translation(".visit_bikebook_link"), bikebook_path, class: "twlink")) %>
        </p>
      </div>

      <noscript class="tw:flex tw:flex-[1_0_170px] tw:sm:pt-6">
        <%= render(UI::Button::Component.new(text: translation(".check_my_bike"), color: :primary, size: :lg,
            type: "submit", html_class: "tw:min-h-12 tw:w-full tw:justify-center")) %>
      </noscript>
    </div>

    <%= tag.fieldset(data: {action: "change->ebike-rules--lookup#checkDetails"},
        class: "tw:flex tw:flex-col tw:gap-4 tw:rounded-lg tw:border tw:border-gray-200 tw:bg-gray-50 tw:px-[clamp(14px,3vw,22px)] tw:py-4.5 tw:dark:border-gray-700 tw:dark:bg-gray-900") do %>
      <legend class="tw:px-1.5 tw:text-[15px] tw:font-bold">
        <span
          class="tw:group-data-[details=custom]/lookup:hidden"
          data-ebike-rules--lookup-target="legend"
        >
          <%= details_legend %>
        </span>

        <span class="tw:hidden tw:group-data-[details=custom]/lookup:inline">
          <%= translation(".custom_details") %>
        </span>
      </legend>

      <%# Disabled while the model is the check, so its details stay out of the URL %>
      <%= hidden_field_tag :manual, "1", id: nil, disabled: details_mode == "model", data: {"ebike-rules--lookup-target": "manual"} %>

      <div class="tw:flex tw:flex-wrap tw:items-start tw:gap-5">
        <%# Each control centered in the wattage field's height, so their text lines up %>
        <div class="tw:flex-[2_1_260px]">
          <span id="manual-top-speed-label" class="twlabel"><%= translation(".top_speed") %></span>

          <div
            role="radiogroup"
            aria-labelledby="manual-top-speed-label"
            class="tw:grid tw:min-h-12 tw:items-center"
          >
            <%= render(UI::Forms::RadioButtonGroup::Component.new(name: "top_speed", entries: top_speed_entries,
                selected: @lookup.details[:top_speed])) %>
          </div>
        </div>

        <div class="tw:flex-[1_1_150px]">
          <span id="manual-throttle-label" class="twlabel"><%= translation(".has_throttle") %></span>

          <div
            role="radiogroup"
            aria-labelledby="manual-throttle-label"
            class="tw:flex tw:min-h-12 tw:items-center"
          >
            <%= render(UI::Forms::RadioButtonGroup::Component.new(name: "throttle", entries: throttle_entries, kind: :toggle,
                selected: @lookup.details[:throttle])) %>
          </div>
        </div>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :watts, kind: :number_field,
            label_text: translation(".motor_wattage"), optional_badge: false, wrapper_class: "tw:flex-[1_1_150px]",
            html_options: {value: @lookup.details[:watts], min: 1, inputmode: "numeric", autocomplete: "off",
                           placeholder: copy[:watts_placeholder], class: "tw:min-h-12 tw:text-base!",
                           data: {action: "keydown.enter->ebike-rules--lookup#checkDetails:prevent"}})) %>
      </div>
    <% end %>
  <% end %>

  <%# Its own form, which goes to the place's page as the lookup's does without JavaScript %>
  <%= render(UI::Modal::Component.new(id: COUNTRY_MODAL_ID, title: translation(".switch_country_title"))) do |modal| %>
    <% modal.with_body do %>
      <%= form_with url: ebike_rules_path, method: :get, class: "tw:flex tw:flex-col tw:gap-3 tw:pb-2",
          data: {controller: "ebike-rules--switch-country", action: "hw-combobox:selection->ebike-rules--switch-country#choose"} do |f| %>
        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :country, label_text: translation(".country"),
            optional_badge: false, wrapper_class: "tw:contents")) do %>
          <%= render(UI::Forms::ComboboxState::Component.new(name: :country, states: country_options,
              html_options: {placeholder: translation(".select_country")})) %>
        <% end %>

        <noscript>
          <%= render(UI::Button::Component.new(text: translation(".switch_country_title"), color: :primary, type: "submit")) %>
        </noscript>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= render(Pages::EbikeRules::Check::Component.new(lookup: @lookup, page_title: @page_title)) %>

<%= render(Pages::EbikeRules::Classes::Component.new(place: @lookup.place, additional_classes: @lookup.result? ? "tw:mt-10" : "tw:mt-14")) %>

<section class="tw:border-b tw:border-gray-200 tw:dark:border-gray-700">
  <div class="tw:flex tw:flex-wrap tw:items-start tw:gap-x-14 tw:gap-y-8 tw:py-[clamp(44px,8vw,72px)] <%= SECTION_CLASSES %>">
    <div class="tw:max-w-[400px] tw:flex-[1_1_300px]">
      <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(eyebrow: translation(".for_parents"),
        heading: unbroken_hyphen(translation(".parents_heading")), intro: copy[:parents_body], html_class: "tw:mb-5")) %>

      <a
        href="#state-laws"
        class="
          twlink tw:inline-flex tw:items-center tw:gap-1.5 tw:text-[15px]
          tw:font-semibold
        "
      >
        <%= copy[:parents_link] %>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <ol
      class="
        tw:grid tw:flex-[2_1_420px]
        tw:grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))]
        tw:gap-x-8
      "
    >
      <% parent_steps.each.with_index(1) do |(title, body), n| %>
        <li
          class="
            tw:grid tw:grid-cols-[32px_minmax(0,1fr)] tw:gap-3.5 tw:border-t
            tw:border-gray-200 tw:py-4.5 tw:dark:border-gray-700
          "
        >
          <span
            aria-hidden="true"
            class="
              tw:flex tw:size-8 tw:items-center tw:justify-center
              tw:rounded-full tw:bg-slate-900 tw:font-header tw:text-[15px]
              tw:font-extrabold tw:text-white
            "
          >
            <%= n %>
          </span>

          <div>
            <h3 class="tw:my-1 tw:font-bold"><%= title %></h3>

            <p
              class="
                tw:text-[15px] tw:leading-relaxed tw:text-gray-700
                tw:dark:text-gray-300
              "
            >
              <%= body %>
            </p>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<section class="tw:py-[clamp(44px,8vw,72px)] <%= SECTION_CLASSES %>">
  <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(eyebrow: translation(".battery_safety"), heading: translation(".ul_heading"),
    intro: translation(".ul_intro"), html_class: "tw:mb-7 tw:max-w-[640px]")) %>

  <div
    class="
      tw:mb-9 tw:grid
      tw:grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] tw:gap-5
    "
  >
    <% ul_standards.each do |standard| %>
      <%= render(UI::Card::Component.new(shadow: true, additional_classes: "tw:flex tw:flex-col tw:gap-3 tw:rounded-lg tw:p-6!")) do %>
        <div class="tw:flex tw:flex-wrap tw:items-baseline tw:gap-3">
          <span class="tw:font-header tw:text-[32px] tw:leading-none tw:font-black"><%= standard[:code] %></span>

          <span
            class="
              tw:text-[15px] tw:font-bold tw:text-blue-600
              tw:dark:text-blue-400
            "
          >
            <%= standard[:scope] %>
          </span>
        </div>

        <p
          class="
            tw:text-[15px] tw:leading-relaxed tw:text-gray-700
            tw:dark:text-gray-300
          "
        >
          <%= standard[:body] %>
        </p>

        <ul
          class="
            tw:list-disc tw:pl-4.5 tw:text-[15px] tw:leading-relaxed
            tw:text-gray-700 tw:dark:text-gray-300
          "
        >
          <% standard[:tests].each do |test| %>
            <li><%= test %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>

  <div
    class="
      tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))]
      tw:gap-x-9 tw:gap-y-7 tw:border-t tw:border-gray-200 tw:pt-7
      tw:dark:border-gray-700
    "
  >
    <div>
      <h3 class="tw:mb-2 tw:text-[17px] tw:font-bold">
        <%= translation(".certification_involves_heading") %>
      </h3>

      <p
        class="
          tw:text-[15px] tw:leading-relaxed tw:text-gray-700
          tw:dark:text-gray-300
        "
      >
        <%= translation(".certification_involves_body") %>
      </p>
    </div>

    <div>
      <h3 class="tw:mb-2 tw:text-[17px] tw:font-bold">
        <%= translation(".banned_heading") %>
      </h3>

      <p
        class="
          tw:text-[15px] tw:leading-relaxed tw:text-gray-700
          tw:dark:text-gray-300
        "
      >
        <%= copy[:banned_body] %>
      </p>
    </div>

    <div class="tw:flex tw:items-start tw:gap-4">
      <div class="tw:flex-1">
        <h3 class="tw:mb-2 tw:text-[17px] tw:font-bold">
          <%= translation(".how_to_check_heading") %>
        </h3>

        <ol
          class="
            tw:list-decimal tw:pl-4.5 tw:text-[15px] tw:leading-relaxed
            tw:text-gray-700 tw:dark:text-gray-300
          "
        >
          <li><%= translation(".how_to_check_1") %></li>
          <li><%= translation(".how_to_check_2") %></li>
          <li><%= translation(".how_to_check_lookup") %></li>
        </ol>
      </div>

      <%= image_tag "kelsey/partners/assets-law_2.png", alt: "", class: "tw:w-22 tw:flex-none" %>
    </div>
  </div>
</section>

<section class="tw:bg-blue-600 tw:text-white">
  <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-x-9 tw:gap-y-5 tw:py-8 <%= SECTION_CLASSES %>">
    <%= image_tag "kelsey/illustrations/comic-assets_bike-hero.png", alt: "", class: "tw:w-30 tw:flex-none" %>

    <div class="tw:flex-[1_1_300px]">
      <h2
        class="
          tw:font-header tw:text-[clamp(20px,3vw,26px)] tw:leading-tight
          tw:font-extrabold
        "
      >
        <%= translation(".register_band_heading") %>
      </h2>

      <div
        class="
          tw:mt-3 tw:flex tw:flex-wrap tw:gap-x-7 tw:gap-y-1.5
          tw:text-[15px] tw:text-white/90
        "
      >
        <span><%= translation(".bikes_registered_html", number: tag.strong(number_display(@registered_count), class: "tw:font-header tw:text-lg tw:font-extrabold tw:text-[#ffd660]")) %></span>
        <span><%= translation(".recoveries_html", number: tag.strong(number_display(@recoveries_count), class: "tw:font-header tw:text-lg tw:font-extrabold tw:text-[#ffd660]")) %></span>
      </div>
    </div>

    <%= render(UI::ButtonLink::Component.new(href: new_register_path, text: translation(".register_your_bike"),
        color: :yellow, size: :callout)) %>
  </div>
</section>

<%= render(Pages::EbikeRules::StateReference::Component.new(country: @lookup.country)) %>

<p
  class="
    tw:bg-blue-600 tw:px-[clamp(16px,4vw,32px)] tw:py-7 tw:text-center
    tw:text-[13px] tw:text-white/90
  "
>
  <%= copy[:disclaimer] %>
</p>
