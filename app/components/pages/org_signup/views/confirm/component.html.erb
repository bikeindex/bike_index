<%= render Pages::Register::Parts::Shell::Component.new do %>
  <div class="tw:px-1 tw:py-6 tw:text-center">
    <%= render UI::Header::Component.new(text: translation(".activate_org", name: @organization_signup.name),
        subtitle: translation(".confirm_email_to_activate_html", email: tag.strong(@organization_signup.email))) %>

    <% if @signed_in_as.present? %>
      <div class="tw:text-left">
        <%= render UI::Alerts::Base::Component.new(kind: :warning) do %>
          <dl class="tw:space-y-2">
            <div>
              <dt><%= translation(".signed_in_as") %></dt>

              <dd class="tw:font-bold tw:wrap-anywhere">
                <%= @signed_in_as %>
              </dd>
            </div>

            <div>
              <dt><%= translation(".link_is_for") %></dt>

              <dd class="tw:font-bold tw:wrap-anywhere">
                <%= @organization_signup.email %>
              </dd>
            </div>
          </dl>

          <p class="tw:mt-2"><%= translation(".activating_signs_you_out") %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with(url: confirm_email_organization_signup_path, method: :post,
        data: {turbo: true, controller: "register--retry"}) do %>
      <%= hidden_field_tag :signup_token, @organization_signup.id_token %>
      <%= hidden_field_tag :confirmation_token, @token %>
      <%= hidden_field_tag :sign_out, true if @signed_in_as.present? %>

      <% if @accept_terms %>
        <div class="tw:my-4">
          <%= render UI::Forms::Checkbox::Component.new(name: :terms_of_service, required: true, checked: @terms_checked,
              class_name: "tw:justify-center tw:text-left", label: translation(".i_agree_to_terms")) %>

          <p class="tw:mt-1 tw:text-sm">
            <%= translation(".read_terms_html",
                terms_link: link_to(translation(".terms_of_service"), terms_path, target: "_blank", class: "twlink"),
                vendor_terms_link: link_to(translation(".vendor_terms"), vendor_terms_path, target: "_blank", class: "twlink")) %>
          </p>
        </div>
      <% end %>

      <%= render UI::Button::Component.new(type: "submit", color: :primary, size: :lg, spinner: true, html_class: "tw:w-full",
          text: @signed_in_as.present? ? translation(".sign_out_and_activate") : translation(".activate")) %>
    <% end %>
  </div>
<% end %>
