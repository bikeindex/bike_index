<% show_search_statuses = !@ignored_only %>
<% sortable_params = @sortable_params %>

<% unless @ignored_only %>
  <div class="tw:text-right tw:text-sm">
    <%= link_to "Ignored bikes only (deleted, test, spam)", admin_graphs_path(sortable_params.merge(search_ignored: true)), class: "twlink tw:inline-block tw:px-4 tw:py-2" %>
  </div>
<% end %>

<div class="tw:my-6 tw:grid tw:gap-x-8 tw:md:grid-cols-2">
  <div class="tw:order-2 tw:md:order-1">
    <% if @index.params[:search_manufacturer].present? %>
      Bikes
      <% if @manufacturer.present? %>
        made by
        <%= link_to @manufacturer.name, admin_manufacturer_path(@manufacturer), class: "twlink" %>
      <% else %>
        No manufacturer found for
        <%= render(UI::Code::Inline::Component.new(text: @index.params[:search_manufacturer])) %>
      <% end %>
      <%= render(UI::ButtonLink::Component.new(href: url_for(sortable_params.merge(search_manufacturer: nil)), text: "view all manufacturer bikes", color: :link_gray, html_class: "tw:text-sm")) %>
    <% end %>

    <% if @ignored_only %>
      <p class="tw:mb-4">
        Viewing only <strong>ignored</strong> bikes
        <em>(deleted, test, spam)</em>
        <%= render(UI::ButtonLink::Component.new(href: url_for(sortable_params.merge(search_ignored: false)), text: "view not ignored bikes", color: :link_gray, html_class: "tw:text-sm")) %>
      </p>
    <% end %>

    <% if @total_count.present? %>
      <p class="tw:mt-6 tw:mb-4">
        <%= number_display(@total_count) %> matching bikes
        <em><%= render(UI::TimeRange::Component.new(time_range: @index.time_range, period: @index.period)) %></em>
      </p>
    <% end %>
  </div>

  <div class="tw:order-1 tw:md:order-2">
    <% if show_search_statuses %>
      <%= form_tag admin_graphs_path(search_kind: "bikes"), method: :get, data: {controller: "ui--collapse"} do %>
        <%= render partial: "/shared/hidden_search_fields" %>

        <%= render(Pages::Admin::Bikes::Index::SearchStatuses::Component.new(index: @index, searched_statuses: @searched_statuses, default_statuses: @default_statuses, not_default_statuses: @not_default_statuses)) %>

        <div class="tw:mt-2 tw:flex tw:items-baseline tw:justify-end tw:gap-2">
          <%= render(UI::Collapse::Component.new(text: "Search statuses", chevron: true, size: :sm)) %>

          <%= render(UI::Button::Component.new(text: "Search", color: :primary, type: "submit", name: "search")) %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @ignored_only %>
    <div class="tw:md:col-span-2">
      <%= render(UI::Chart::Component.new(series: variable_admin_graphs_path(sortable_params.merge(bike_graph_kind: "ignored")), stacked: true)) %>
    </div>
  <% end %>
</div>

<div class="tw:mt-6"></div>

<%= render(UI::Chart::Component.new(series: variable_admin_graphs_path(sortable_params))) %>

<div class="tw:mb-6 tw:text-center">
  <small class="less-strong">
    <strong>Note:</strong> Columns are separate because they are independent
    counts: total registrations &amp; stolen records created for those
    registrations
    <em class="tw:block">This is different from other graphs showing counts of nonstolen &amp; stolen (which add up to the total registrations). This is done here so that this graph includes recovered bikes.</em>
  </small>
</div>

<%# Don't render all the extra stuff if looking at a period that is longer than 1 year %>
<% render_other_bike_graphs = helpers.time_range_length(@index.time_range) < 367.days.to_i %>

<% if render_other_bike_graphs %>
  <%= render(UI::Container::Component.new) do %>
    <div class="tw:mt-6">
      <%= render(Pages::Admin::Graphs::BikesTable::Component.new(kind: "origin", sortable_params:)) %>
    </div>
  <% end %>

  <div class="tw:mt-6"></div>
  <%= render(UI::Chart::Component.new(series: variable_admin_graphs_path(sortable_params.merge(bike_graph_kind: "origin")), stacked: true)) %>

  <div class="twwiderow twwiderow-3 tw:mt-4 tw:gap-y-6">
    <div>
      <%= render(Pages::Admin::Graphs::BikesTable::Component.new(kind: "ios_version", sortable_params:)) %>

      <%= render(UI::Chart::Component.new(series: variable_admin_graphs_path(sortable_params.merge(bike_graph_kind: "ios_version")), stacked: true)) %>
    </div>

    <div>
      <%= render(Pages::Admin::Graphs::BikesTable::Component.new(kind: "pos", sortable_params:)) %>

      <%= render(UI::Chart::Component.new(series: variable_admin_graphs_path(sortable_params.merge(bike_graph_kind: "pos")), stacked: true)) %>
    </div>

    <div>
      <%= render(Pages::Admin::Graphs::BikesTable::Component.new(kind: "register_setting", sortable_params:)) %>

      <%= render(UI::Chart::Component.new(series: variable_admin_graphs_path(sortable_params.merge(bike_graph_kind: "register_setting")))) %>
    </div>
  </div>

  <%= render(UI::Container::Component.new) do %>
    <div class="tw:mt-6">
      <%= render(Pages::Admin::Graphs::BikesTable::Component.new(kind: "organization", sortable_params:)) %>
    </div>
  <% end %>
<% end %>
