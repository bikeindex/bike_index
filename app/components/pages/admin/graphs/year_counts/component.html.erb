<%= render(UI::Table::Component.new(records: rows)) do |table| %>
  <% table.column(label: "") do |row| %>
    <%= row.year %>
  <% end %>

  <% labels.each do |label| %>
    <% table.column(label:) do |row| %>
      <% count, projection = row.counts[label] %>
      <%= number_display(count) %>

      <% if projection %>
        <span class="less-strong ml-1"><%= number_display(projection) %></span>
      <% end %>
    <% end %>
  <% end %>
<% end %>
