<% duplicate_counts = self.duplicate_counts %>
<% location = method(:location) %>

<%= render(UI::CardTable::Component.new(records: rows, render_sortable: true, sort_state: @sort_state,
  column_settings: {storage_key: "adminStolenBikesColumns", columns: COLUMNS, defaults: DEFAULT_COLUMNS, narrow_hidden: %i[photo_cell created_at_cell]},
  form: {url: bulk_update_admin_stolen_bikes_path, method: :patch})) do |table| %>
  <% table.with_actions do %>
    <%= render(UI::Button::Component.new(text: "Approve selected", color: :primary, size: :sm, type: :submit, name: :bulk_action, value: :approve)) %>
    <%= render(UI::Button::Component.new(text: "Mark spam", size: :sm, type: :submit, name: :bulk_action, value: :spam)) %>

    <%= render(UI::Button::Component.new(text: "Delete selected", color: :error, size: :sm, type: :submit, name: :bulk_action, value: :delete,
      onclick: "return confirm('Delete the selected bikes?')")) %>
  <% end %>

  <% table.selection_column(param: "sr_selected") do |(stolen_record)| %>
    <%= render(UI::ButtonLink::Component.new(text: "View", href: edit_admin_stolen_bike_path(stolen_record, stolen_record_id: true), size: :sm)) %>
  <% end %>

  <% table.column(hideable: :photo_cell) do |(_stolen_record, bike)| %>
    <%= render(Atoms::BikeThumbnail::Component.new(bike:)) %>
  <% end %>

  <% table.column(sortable: "created_at", hideable: :created_at_cell) do |(stolen_record)| %>
    <%= link_to edit_admin_stolen_bike_path(stolen_record, stolen_record_id: true), class: "twlink tw:font-bold tw:whitespace-nowrap" do %>
      <%= render(UI::Time::Component.new(time: stolen_record.created_at)) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "date_stolen", hideable: :date_stolen_cell, classes: "tw:whitespace-nowrap") do |(stolen_record)| %>
    <%= render(UI::Time::Component.new(time: stolen_record.date_stolen)) %>
  <% end %>

  <% table.column(hideable: :bike_cell) do |(_stolen_record, bike)| %>
    <% if bike.present? %>
      <%= link_to edit_admin_bike_path(bike), class: "twlink" do %>
        <strong><%= bike.mnfg_name %></strong>
        <%= bike.frame_model %>
      <% end %>
      <%= render(Atoms::Admin::Badges::BikeHiddenExplanation::Component.new(bike:)) %>
    <% else %>
      <span class="tw:text-amber-600">no bike</span>
    <% end %>
  <% end %>

  <% table.column(hideable: :value_cell) do |(stolen_record)| %>
    <% if stolen_record.estimated_value.present? %>
      $<%= number_display(stolen_record.estimated_value) %>
    <% end %>
  <% end %>

  <% table.column(hideable: :theft_description_cell, classes: "tw:min-w-64") do |(stolen_record)| %>
    <%= stolen_record.theft_description %>
  <% end %>

  <% table.column(hideable: :location_cell) do |(stolen_record)| %>
    <%= location.call(stolen_record) %>
  <% end %>

  <% table.column(hideable: :police_department_cell) do |(stolen_record)| %>
    <%= stolen_record.police_report_department %>
  <% end %>

  <% table.column(hideable: :police_report_cell) do |(stolen_record)| %>
    <%= stolen_record.police_report_number %>
  <% end %>

  <% table.column(hideable: :duplicates_cell, classes: "tw:text-center") do |(_stolen_record, bike)| %>
    <% duplicate_count = bike && duplicate_counts[bike.id] %>

    <% if duplicate_count.present? %>
      <%= link_to number_display(duplicate_count), admin_bike_path(bike, active_tab: "duplicates"), class: "twlink tw:font-bold" %>
    <% end %>
  <% end %>

  <% table.column(hideable: :owner_cell, classes: "tw:leading-none") do |(stolen_record, bike)| %>
    <% if bike.present? %>
      <%= bike.owner_email %>
      <%= render(Atoms::Admin::Badges::User::Component.new(user: bike.user)) %>
      <br>
      <%= link_to "Contact owner", edit_admin_stolen_bike_path(stolen_record, stolen_record_id: true, anchor: "contact-owner"), class: "twlink tw:text-xs" %>
    <% end %>
  <% end %>

  <% table.column(hideable: :approved_cell, classes: "tw:text-center") do |(stolen_record)| %>
    <%= check_mark if stolen_record.approved %>
  <% end %>
<% end %>
