<%# A restored draft opens the email card %>
<div
  data-controller="admin--bug-report-email"
  data-action="table-multi-checkbox:change->admin--bug-report-email#sync form-persist:restored@window->admin--bug-report-email#show"
>
  <%= render(Pages::Admin::BugReports::EmailForm::Component.new) %>

  <%= render(UI::Table::InCard::Component.new(records: @collection, cache_key: self.class.cache_digest, render_sortable: @render_sortable, sort_state: @sort_state,
  column_settings: {storage_key: "adminBugReportsColumns", columns: COLUMNS, defaults: COLUMNS.keys, narrow_hidden: %i[receiver_cell member_cell invoiced_cell pull_request_cell]},
  form: {url: assign_tags_admin_bug_reports_path, method: :post, id: FORM_ID},
  cache_records: ->(bug_report) { bug_report.user },
  data: sortable_links_data)) do |table| %>
    <% table.with_actions do %>
      <%= render(UI::Forms::Group::Component.new(attribute: :tags, label_text: "Tag to assign", wrapper_class: "tw:mb-0 tw:min-w-64")) do %>
        <%= render UI::Forms::Combobox::Component.new(name: :tags, options: @searchable_tags, free_text: true, html_options: {placeholder: "Select or create a tag"}) %>
      <% end %>

      <%# formnovalidate, as the email card's message is required and belongs to this form %>
      <%= render(UI::Button::Component.new(text: "Add tag to selected", color: :primary, size: :sm, type: :submit, formnovalidate: true)) %>

      <%= render(UI::Button::Component.new(text: "Email selected senders", size: :sm, aria: {expanded: "false"},
      data: {"admin--bug-report-email-target": "trigger", action: "admin--bug-report-email#toggle"})) %>
    <% end %>

    <% table.selection_column(param: "bug_reports_selected",
    checkbox_options: ->(bug_report) { {data: {email_banned: bug_report.sender_email_banned?.presence}} }) %>

    <% table.column(sortable: "received_at", label: "Received", lower_right: ->(bug_report) { content_tag(:span, bug_report.id, class: "only-dev-visible") }) do |bug_report| %>
      <%= link_to render(UI::Time::Component.new(time: bug_report.received_at || bug_report.created_at)),
      admin_bug_report_path(bug_report), class: "twlink tw:text-xs" %>
    <% end %>

    <% table.column(sortable: "github_pull_request", hideable: :pull_request_cell) do |bug_report| %>
      <% if bug_report.github_pull_request.present? %>
        <%= link_to "##{bug_report.github_pull_request}", bug_report.github_pull_request_url, class: "twlink" %>
        <%= helpers.bug_report_search_link(search_pull_request: bug_report.github_pull_request) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "email", hideable: :sender_cell) do |bug_report| %>
      <% if bug_report.user_id.present? %>
        <%= render Atoms::Admin::TableCells::User::Component.new(user: bug_report.user, user_id: bug_report.user_id) %>
      <% else %>
        <span class="tw:block tw:xl:inline"><%= bug_report.from_name %></span>
        <%= render(UI::Code::Inline::Component.new(text: bug_report.email)) %>
      <% end %>

      <%# a fixed path rather than sortable_search_params, which caching would bake in %>
      <%= link_to search_emoji, admin_bug_reports_path(search_email: bug_report.email), class: "display-sortable-link tw:text-sm" %>
    <% end %>

    <% table.column(sortable: "receiver", hideable: :receiver_cell) do |bug_report| %>
      <% if bug_report.receiver.present? %>
        <small><%= BugReport.display_receiver(bug_report.receiver) %></small>
        <%= link_to search_emoji, admin_bug_reports_path(search_receiver: bug_report.receiver), class: "display-sortable-link tw:text-sm" %>
      <% end %>
    <% end %>

    <% table.column(hideable: :subject_cell) do |bug_report| %>
      <%= bug_report.display_subject %>

      <%= render(UI::Tooltip::Component.new) do |tooltip| %>
        <% tooltip.with_body do %>
          <div>
            <%= content_tag(:strong, bug_report.display_subject) %>

            <%# truncated because the tooltip has no scroll container %>
            <%= content_tag(:div, bug_report.body_stripped.truncate(1000), class: "tw:mt-1 tw:whitespace-pre-wrap") %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% table.column(sortable: "status", hideable: :status_cell) do |bug_report| %>
      <%= BugReport.status_display(bug_report.status) %>
    <% end %>

    <% table.column(hideable: :replied_cell, classes: "tw:text-center") do |bug_report| %>
      <%= check_mark if bug_report.reply_notifications.any? %>
    <% end %>

    <% table.column(hideable: :tags_cell) do |bug_report| %>
      <div class="tw:flex tw:flex-wrap tw:gap-1">
        <% bug_report.tags.each do |tag_name| %>
          <%= render(Atoms::Admin::Badges::BugReportTag::Component.new(tag: tag_name)) %>
        <% end %>
      </div>
    <% end %>

    <% table.column(hideable: :member_cell, classes: "tw:text-center") do |bug_report| %>
      <%= check_mark if bug_report.is_member %>
    <% end %>

    <% table.column(hideable: :invoiced_cell) do |bug_report| %>
      <%= check_mark if bug_report.is_invoiced_organization %>

      <% if bug_report.is_invoiced_organization_staff %>
        <small>staff</small>
      <% end %>
    <% end %>
  <% end %>
</div>
