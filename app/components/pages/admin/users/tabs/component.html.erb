<%= render(Pages::Admin::Headers::Tabs::Component.new(title: @user.display_name, tabs:,
      nav_label: "User sections")) do |header| %>
  <% header.with_nav_item { non_admin_view_link } if non_admin_view_link %>

  <% if alerts? %>
    <% header.with_alert do %>
      <% if @user.deleted? %>
        <%= render(UI::Alerts::Base::Component.new(kind: :error, header: "User deleted")) do %>
          <%= render(UI::Time::Component.new(time: @user.deleted_at, format: :localize_time_precise, preposition: true)) %>
        <% end %>
      <% end %>

      <% if @user.banned? %>
        <% user_ban = @user.user_ban %>
        <%= render(UI::Alerts::Base::Component.new(kind: :error, header: "User banned")) do %>
          <%= render(UI::TableList::Component.new(classes: "tw:mb-0!")) do |list| %>
            <% list.with_row(label: "Banned at", value: render(UI::Time::Component.new(time: user_ban&.created_at || @user.updated_at, format: :localize_time_precise))) %>
            <% list.with_row(label: "By", value: render(Atoms::Admin::TableCells::User::Component.new(user: user_ban&.creator, user_id: user_ban&.creator_id))) %>
            <% list.with_row(label: "Reason", value: user_ban&.reason_humanized) %>
            <% list.with_row(label: "Notes", value: user_ban&.description) %>
          <% end %>
        <% end %>
      <% end %>

      <% if last_email_errored.any? %>
        <%= render(UI::Alerts::Base::Component.new(kind: :error, header: "Last email to user errored!")) do %>
          Check the
          <%= link_to "notifications", admin_notifications_path(user_id: @user.id), class: "twlink" %>
          for the delivery errors
        <% end %>
      <% end %>

      <% if @user.email_bans_active.any? %>
        <%= render(UI::Alerts::Base::Component.new(kind: :error, header: "User's email banned (not delivered)")) do %>
          Reasons:
          <% @user.email_bans_active.each do |email_ban| %>
            <strong><%= email_ban.email %></strong>
            <%= email_ban.reason_humanized %>

            <small class="twless-strong">
              <% if email_ban.reason == "email_domain" %>
                - the
                <%= link_to "email domain", admin_email_domain_path(email_ban.email_domain), class: "twlink" %>
                was banned.
              <% elsif email_ban.reason == "email_duplicate" %>
                - the email looks like a duplicate of another email. In 2025, we
                were getting a lot of user sign up spam with emails that just
                had extra periods added in (which still deliver to gmail)
              <% elsif email_ban.reason == "delivery_failure" %>
                - a recent email to them failed to be delivered. Have them check
                their spam folder!
              <% end %>
            </small>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% header.with_summary { content } if content? %>
<% end %>
