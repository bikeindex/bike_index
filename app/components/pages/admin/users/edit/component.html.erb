<h4>Edit</h4>

<%= form_for @user, url: admin_user_path(@user), method: :patch, html: {data: {controller: "admin--user-edit-form"}} do |f| %>
  <%= render(UI::Alerts::ObjectError::Component.new(object: @user)) %>

  <div class="row mt-4">
    <div class="col-md-6">
      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :name)) %>
    </div>

    <div class="col-md-6">
      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :email, required: true)) do %>
        <%= render(UI::Forms::Email::Component.new(form_builder: f, required: true)) %>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :username)) %>
    </div>

    <div class="col-md-6">
      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :secondary_emails, kind: :text_area,
        optional_badge: false, html_options: {value: @user.secondary_emails.join(", "), disabled: true, rows: 1})) %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :phone)) %>
    </div>

    <div class="col-lg-3 col-6 tw:mb-4">
      <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :confirmed, label: "Confirmed",
        html_options: {disabled: @user.confirmed})) %>

      <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :can_send_many_stolen_notifications,
        label: "Can send many stolen notifications")) %>

      <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :can_send_many_marketplace_messages,
        label: "Can send many marketplace messages")) %>

      <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :dark_mode, label: "Dark mode")) %>
    </div>

    <div class="col-lg-3 col-6 tw:mb-4">
      <%= render(UI::Forms::Checkbox::Component.new(name: "user[superuser]", label: "superuser", checked: @user.superuser?)) %>

      <% if @display_dev_info %>
        <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :developer, label: "Developer",
          class_name: "only-dev-visible")) %>
      <% end %>
    </div>
  </div>

  <div class="row mt-3">
    <div class="col-6">
      <%= render(UI::Button::Component.new(text: "Save", color: :primary, type: "submit")) %>
    </div>

    <div class="col-6 pt-2">
      <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :banned, label: "Banned",
        html_options: {data: {"admin--user-edit-form-target": "banned", action: "change->admin--user-edit-form#bannedChanged"}})) %>
    </div>
  </div>

  <% if ban_fields? %>
    <%= f.fields_for :user_ban do |user_ban| %>
      <div
        <%# hidden! because .row sets display in unlayered admin.css, which tw:hidden loses to %>
        class="row <%= "tw:hidden!" unless @user.banned? %>"
        data-admin--user-edit-form-target="banFields"
      >
        <div class="col-md-8 offset-md-2 mt-3">
          <div class="card bg-light">
            <div class="card-body">
              <div class="row">
                <div class="col-sm-6">
                  <h4>Ban information</h4>
                </div>

                <div class="col-sm-6">
                  <%= render(UI::Forms::Group::Component.new(form_builder: user_ban, attribute: :reason, required: true)) do %>
                    <%= render(UI::Forms::Select::Component.new(form_builder: user_ban, attribute: :reason,
                      option_tags: user_ban_reason_options, options: {prompt: "Reason for ban"}, required: @user.banned?,
                      html_options: {data: {"admin--user-edit-form-target": "banReason"}})) %>
                  <% end %>
                </div>
              </div>

              <%= render(UI::Forms::Group::Component.new(form_builder: user_ban, attribute: :description, kind: :text_area,
                label_text: "Description/notes")) %>

              <p><em class="small"> Banning a user will: </em></p>

              <ul class="tw:mt-0 tw:ml-4 tw:list-disc">
                <li>
                  Log them out and prevent them from logging back in
                </li>

                <li>
                  (soft) delete all their bikes - which will remove all their
                  marketplace listings
                </li>

                <li>
                  Show any user they were messaging with a message telling them
                  that they're banned
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
