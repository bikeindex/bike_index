<% if @mailchimp_datum.blank? %>
  <h4>No Mailchimp data</h4>
<% else %>
  <div data-controller="ui--collapse">
    <h4>
      Mailchimp data
      <em class="small"><%= render(UI::Collapse::Component.new(text: "show raw data", color: :link, html_class: "small")) %></em>
    </h4>

    <div class="row">
      <div class="col-md-6">
        <table class="table-list">
          <tbody>
            <tr
              class="only-dev-visible tw:hidden"
              data-ui--collapse-target="content"
            >
              <td class="small">ID</td>
              <td class="small"><%= @mailchimp_datum.id %></td>
            </tr>

            <tr>
              <td>Status</td>
              <td><%= @mailchimp_datum.status %></td>
            </tr>

            <tr>
              <td>Lists</td>
              <td><%= @mailchimp_datum.lists.join(", ") %></td>
            </tr>

            <tr>
              <td>Mailchimp updated</td>

              <td>
                <% if @mailchimp_datum.mailchimp_updated_at.present? %>
                  <span class="localizeTime">
                    <%= l(@mailchimp_datum.mailchimp_updated_at, format: :convert_time) %>
                  </span>
                <% end %>
              </td>
            </tr>

            <tr class="small tw:hidden" data-ui--collapse-target="content">
              <td>Feedbacks</td>

              <td>
                <%= safe_join(@mailchimp_datum.feedbacks.map { |f| link_to(f.kind_humanized, admin_feedback_path(f), class: "small") }, ", ") %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="col-md-6">
        <div class="tw:hidden" data-ui--collapse-target="content">
          <%= render UI::JsonDisplay::Component.new(data: @mailchimp_datum.data, small: true) %>
        </div>
      </div>
    </div>
  </div>
<% end %>
