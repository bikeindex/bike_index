<% if @mailchimp_datum.blank? %>
  <h4>No Mailchimp data</h4>
<% else %>
  <div data-controller="ui--collapse">
    <h4>
      Mailchimp data
      <em class="small"><%= render(UI::Collapse::Component.new(text: "show raw data", color: :link, html_class: "small")) %></em>
    </h4>

    <div class="twwiderow tw:items-start">
      <%= render(UI::TableList::Component.new) do |list| %>
        <% list.with_row(label: "ID", value: tag.span(@mailchimp_datum.id, class: "small"), class: "only-dev-visible tw:hidden", data: {"ui--collapse-target": "content"}) %>
        <% list.with_row(label: "Status", value: @mailchimp_datum.status) %>
        <% list.with_row(label: "Lists", value: @mailchimp_datum.lists.join(", ")) %>
        <% list.with_row(label: "Mailchimp updated", value: render(UI::Time::Component.new(time: @mailchimp_datum.mailchimp_updated_at))) %>
        <% list.with_row(label: "Feedbacks", value: safe_join(@mailchimp_datum.feedbacks.map { |f| link_to(f.kind_humanized, admin_feedback_path(f), class: "small") }, ", "), class: "small tw:hidden", data: {"ui--collapse-target": "content"}) %>
      <% end %>

      <div class="tw:hidden" data-ui--collapse-target="content">
        <%= render UI::JsonDisplay::Component.new(data: @mailchimp_datum.data, small: true) %>
      </div>
    </div>
  </div>
<% end %>
