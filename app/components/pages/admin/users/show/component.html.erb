<% case @active_tab %>
<% when :organization_roles %>
  <p class="tw:mb-4 tw:text-sm">
    <%= link_to admin_user_registration_organizations_path(user_id: @user.id), class: "twlink" do %>
      <%= number_display(registration_organizations_count) %>
      <%= "registration organization".pluralize(registration_organizations_count) %>
    <% end %>
  </p>

  <%= render partial: "/admin/organization_roles/table", locals: {organization_roles: records.reorder(id: :desc)} %>
<% when :emails %>
  <%= render(UI::Table::Component.new(records: records.reorder(id: :desc))) do |table| %>
    <% table.column(label: "Created", lower_right: ->(user_email) { user_email.id }) do |user_email| %>
      <%= render UI::Time::Component.new(time: user_email.created_at) %>
    <% end %>

    <% table.column(label: "") do |user_email| %>
      <%= user_email.email %>
    <% end %>

    <% table.column(label: "Confirmed") do |user_email| %>
      <% if user_email.confirmed? %>
        <%= check_mark %>
      <% else %>
        <small class="twless-strong">false</small>
      <% end %>
    <% end %>

    <% table.column(label: "Primary") do |user_email| %>
      <% if user_email.primary? %>
        <%= check_mark %>
      <% else %>
        <small class="twless-strong">false</small>
      <% end %>
    <% end %>

    <% table.column(label: "Old User Id") do |user_email| %>
      <%= user_email.old_user_id %>
    <% end %>
  <% end %>
<% when :ambassador_tasks %>
  <% if @user.ambassador? %>
    <p class="tw:mb-4">
      <strong><%= Ambassador.find(@user.id).progress_count %> complete</strong>
    </p>
  <% else %>
    <p class="tw:mb-4">Not an ambassador</p>
  <% end %>

  <%= render(UI::Table::Component.new(records: records.task_ordered)) do |table| %>
    <% table.column(label: "Task") do |assignment| %>
      <strong><%= assignment.title %></strong>
    <% end %>

    <% table.column(label: "Completed at") do |assignment| %>
      <% if assignment.completed_at.present? %>
        <%= render UI::Time::Component.new(time: assignment.completed_at) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
