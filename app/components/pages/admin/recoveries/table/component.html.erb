<% bulk_actions = capture do %>
  <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2">
    <%= render(UI::Button::Component.new(text: "Display selected", color: :primary, size: :sm, type: :submit, name: :bulk_action, value: :display)) %>
    <%= render(UI::Button::Component.new(text: "Mark not displayable", size: :sm, type: :submit, name: :bulk_action, value: :not_displayed)) %>
  </div>
<% end %>

<%# twfullbleed reads the twwiderow container %>
<div class="twwiderow tw:mb-4">
  <%= form_with(url: bulk_update_admin_recoveries_path, method: :post,
  class: "tw:col-span-full tw:min-w-0 tw:rounded-xl tw:twfullbleed #{UI::Card::Component::BASE_CLASSES}",
  data: form_data) do %>
    <%# Full bleed drops the card's gutter, so the header meets the page's %>
    <div
      class="
        tw:flex tw:flex-wrap tw:items-center tw:justify-end tw:gap-x-4
        tw:gap-y-2 tw:py-3 tw:@min-[672px]/twwiderow:px-4
      "
    >
      <p class="tw:m-0 tw:text-xs tw:text-gray-500">
        Edit the story, name and location to match our guidelines, then display.
        Display names are first name only. Edits are saved to the display, not
        the recovery.
      </p>

      <div class="tw:ml-auto tw:flex tw:flex-wrap tw:items-center tw:gap-2">
        <%# The footer's copy is the one a phone reaches after checking rows %>
        <div class="tw:hidden tw:sm:block"><%= bulk_actions %></div>
        <%= render(UI::Collapse::Component.new(text: "Column settings", chevron: :trailing, size: :sm)) %>
      </div>
    </div>

    <%= render(UI::ColumnSettings::Component.new(columns: COLUMNS, defaults: DEFAULT_COLUMNS, narrow_hidden: %i[photo_cell recovered_at_cell])) %>

    <% editable = method(:editable?) %>
    <% display_defaults = method(:display_defaults) %>

    <%# Full bleed takes the table over the admin gutter, past the card, so it's clipped here %>
    <div
      class="
        tw:overflow-hidden
        tw:@max-[672px]/twwiderow:mx-[calc(var(--gutter)*-1)]
      "
      data-action="input->table-multi-checkbox#selectRow"
    >
      <%= render(UI::CardTable::Component.new(records: rows, render_sortable: true, sort_state: @sort_state)) do |table| %>
        <% table.column(label: button_tag(check_mark, type: "button", class: "twlink tw:cursor-pointer tw:border-0 tw:bg-transparent tw:p-0",
      title: "Toggle all checked", aria: {label: "Toggle all checked"}, data: {action: "click->table-multi-checkbox#toggleAll"})) do |(recovery)| %>
          <div class="tw:flex tw:items-center tw:gap-3">
            <%= check_box_tag "sr_selected[#{recovery.id}]", recovery.id, false, disabled: !editable.call(recovery),
          aria: {label: "Select recovery #{recovery.id}"}, data: {"table-multi-checkbox-target" => "checkbox"} %>

            <%= render(UI::ButtonLink::Component.new(text: "View", href: edit_admin_recovery_path(recovery), size: :sm)) %>
          </div>
        <% end %>

        <% table.column(label: COLUMNS[:photo_cell], classes: "hideableColumn photo_cell") do |(_recovery, bike)| %>
          <%= render(Atoms::BikeThumbnail::Component.new(bike:)) %>
        <% end %>

        <% table.column(sortable: "recovered_at", label: COLUMNS[:recovered_at_cell], classes: "hideableColumn recovered_at_cell") do |(recovery)| %>
          <%= link_to edit_admin_recovery_path(recovery), class: "twlink tw:font-bold tw:whitespace-nowrap" do %>
            <% if recovery.recovered_at.blank? %>
              <span class="tw:text-red-600">no recovery date</span>
            <% end %>

            <%= render(UI::Time::Component.new(time: recovery.recovered_at || recovery.created_at)) %>
          <% end %>
        <% end %>

        <% table.column(sortable: "date_stolen", label: COLUMNS[:date_stolen_cell], classes: "hideableColumn date_stolen_cell tw:whitespace-nowrap") do |(recovery)| %>
          <%= render(UI::Time::Component.new(time: recovery.date_stolen)) %>
        <% end %>

        <% table.column(sortable: "recovery_display_status", label: COLUMNS[:status_cell], classes: "hideableColumn status_cell tw:text-xs") do |(recovery)| %>
          <%= recovery.recovery_display_status.humanize %>

          <% if recovery.recovery_display.present? %>
            <%= link_to check_mark, edit_admin_recovery_display_path(recovery.recovery_display), class: "twlink" %>
          <% end %>
        <% end %>

        <% table.column(label: COLUMNS[:bike_cell], classes: "hideableColumn bike_cell") do |(recovery, bike)| %>
          <% if bike.present? %>
            <%= link_to edit_admin_bike_path(bike), class: "twlink" do %>
              <strong><%= bike.title_string %></strong>
            <% end %>
            <% if recovery.estimated_value.present? %>
              <small class="tw:text-gray-500">$<%= number_display(recovery.estimated_value) %></small>
            <% end %>
            <%= render(Atoms::Admin::Badges::BikeHiddenExplanation::Component.new(bike:)) %>
          <% else %>
            <span class="tw:text-amber-600">no bike</span>
          <% end %>
        <% end %>

        <% table.column(label: COLUMNS[:owner_cell], classes: "hideableColumn owner_cell tw:leading-none") do |(recovery, bike)| %>
          <% if bike.present? %>
            <%= bike.owner_email %>
            <%= render(Atoms::Admin::Badges::User::Component.new(user: bike.user)) %>
          <% end %>

          <% if recovery.recovering_user.present? %>
            <br>
            <small class="tw:text-gray-500">
              Recovered by
              <%= link_to recovery.recovering_user.display_name, admin_user_path(recovery.recovering_user.to_param), class: "twlink" %>
              <% unless recovery.recovering_user_owner? %>
                <span class="tw:text-amber-600">not owner!</span>
              <% end %>
            </small>
          <% end %>
        <% end %>

        <% table.column(label: COLUMNS[:theft_description_cell], classes: "hideableColumn theft_description_cell tw:min-w-56 tw:text-xs tw:text-gray-500") do |(recovery)| %>
          <%= recovery.theft_description %>
        <% end %>

        <% table.column(label: COLUMNS[:story_cell], classes: "hideableColumn story_cell tw:min-w-72") do |(recovery)| %>
          <% if editable.call(recovery) %>
            <div
              data-controller="admin--character-count"
              data-admin--character-count-max-value="<%= RecoveryDisplay::QUOTE_MAX_LENGTH %>"
            >
              <%= text_area_tag "display[#{recovery.id}][quote]", display_defaults.call(recovery)[:quote], rows: 5, maxlength: RecoveryDisplay::QUOTE_MAX_LENGTH,
          class: "twinput", aria: {label: "Recovery story for recovery #{recovery.id}"},
          data: {"admin--personal-info-target" => "field", "admin--character-count-target" => "field", action: "input->admin--character-count#update"} %>

              <div
                class="
                  tw:mt-1 tw:flex tw:items-start tw:justify-between tw:gap-2
                  tw:text-xs
                "
              >
                <p
                  class="tw:m-0 tw:text-amber-700 tw:empty:hidden"
                  data-admin--personal-info-target="warning"
                ></p>

                <span
                  class="tw:ml-auto tw:text-gray-500 tw:tabular-nums"
                  data-admin--character-count-target="total"
                ></span>
              </div>
            </div>
          <% else %>
            <%= recovery.recovery_display&.quote || recovery.recovered_description %>
          <% end %>
        <% end %>

        <% table.column(label: COLUMNS[:quote_by_cell], classes: "hideableColumn quote_by_cell tw:min-w-32") do |(recovery)| %>
          <% if editable.call(recovery) %>
            <%= text_field_tag "display[#{recovery.id}][quote_by]", display_defaults.call(recovery)[:quote_by], class: "twinput", autocomplete: "off",
          aria: {label: "Display name for recovery #{recovery.id}"} %>
          <% else %>
            <%= recovery.recovery_display&.quote_by %>
          <% end %>
        <% end %>

        <% table.column(label: COLUMNS[:location_string_cell], classes: "hideableColumn location_string_cell tw:min-w-32") do |(recovery)| %>
          <% if editable.call(recovery) %>
            <%= text_field_tag "display[#{recovery.id}][location_string]", display_defaults.call(recovery)[:location_string], class: "twinput", autocomplete: "off",
          aria: {label: "Display location for recovery #{recovery.id}"} %>
          <% else %>
            <%= recovery.recovery_display&.location_string %>
          <% end %>
        <% end %>

        <% table.column(label: COLUMNS[:location_cell], classes: "hideableColumn location_cell") do |(recovery)| %>
          <%= render(Atoms::Admin::TableCells::AddressRecord::Component.new(address_record: recovery)) %>
        <% end %>

        <% table.column(label: COLUMNS[:helped_cell], classes: "hideableColumn helped_cell tw:text-center") do |(recovery)| %>
          <%= check_mark if recovery.index_helped_recovery %>
        <% end %>

        <% table.column(label: COLUMNS[:shareable_cell], classes: "hideableColumn shareable_cell tw:text-center") do |(recovery)| %>
          <%= check_mark if recovery.can_share_recovery %>
        <% end %>
      <% end %>
    </div>

    <div class="tw:border-t tw:border-gray-100 tw:px-4 tw:py-3 tw:dark:border-gray-700">
      <%= bulk_actions %>
    </div>
  <% end %>
</div>
