<nav
  class="
    tw:flex! tw:flex-wrap tw:items-center tw:justify-between tw:bg-gray-50
    tw:px-4 tw:py-2 tw:md:flex-nowrap tw:md:justify-start
  "
>
  <span class="tw:mr-4 tw:py-1.25">
    <%= link_to image_tag("logo.svg", class: "tw:h-9 tw:dark:invert"), @user_root_url %>
  </span>

  <% if @current_user.superuser? %>
    <ul class="tw:m-0 tw:hidden tw:list-none tw:p-0 tw:lg:flex">
      <% shortcut_links.each do |link| %>
        <li>
          <%= render UI::ActiveLink::Component.from_item(link, html_class: NAV_LINK_CLASS,
                text: link[:title]) %>
        </li>
      <% end %>

      <% if mailer_links.any? %>
        <li>
          <%= render(UI::Dropdown::Component.new(name: "Mailers",
                button_class: "#{NAV_LINK_CLASS} tw:mr-1 tw:cursor-pointer")) do |dropdown| %>
            <% mailer_links.each do |title, path| %>
              <% dropdown.with_entry_item { link_to title, path } %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if display_view_all? %>
      <%= link_to current_nav_link[:path], class: "tw:block tw:py-2 tw:px-4 tw:no-underline tw:text-gray-500 tw:italic" do %>
        All
        <div class="tw:hidden tw:sm:inline-block tw:lg:hidden tw:xl:inline-block">
          <%= view_all_title %>
        </div>
      <% end %>
    <% end %>
    <div
      class="tw:mt-1 tw:min-w-75 tw:max-sm:min-w-60"
      data-controller="admin--navbar"
      data-action="hw-combobox:selection->admin--navbar#navigate"
    >
      <%= render(UI::Forms::Combobox::Component.new(name: :admin_navigation, options: combobox_options, html_options: {placeholder:})) %>
    </div>
  <% end %>

  <%= render(UI::ButtonLink::Component.new(text: "Exit Admin", href: root_path, html_class: "tw:ml-auto tw:max-lg:hidden")) %>
</nav>
