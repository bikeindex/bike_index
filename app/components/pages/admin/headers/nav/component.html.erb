<div class="<%= wrapper_classes %>">
  <%# A wrapper, so a heading and its subtitle are one flex item rather than two %>
  <div class="tw:mr-auto">
    <%= render(UI::Header::Component.new(text: @title, subtitle: @subtitle)) %>
  </div>

  <% if items? %>
    <ul
      class="
        tw:mb-6 tw:flex tw:flex-row tw:flex-wrap tw:items-baseline tw:gap-1
        tw:text-sm
      "
    >
      <% items.each do |item| %>
        <li><%= item %></li>
      <% end %>
    </ul>
  <% end %>
</div>
