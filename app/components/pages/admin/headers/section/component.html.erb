<h3 class="tw:mt-6 tw:mb-3 tw:text-2xl tw:leading-tight tw:font-medium tw:first:mt-0">
  <%= @title %>

  <% unless @count.nil? %>
    <small class="twless-strong tw:ml-2"><%= count_display %></small>
  <% end %>

  <% if @parenthetical.present? %>
    <small class="twless-strong tw:ml-2"><%= wrapped_parenthetical %></small>
  <% end %>

  <%= content %>
</h3>
