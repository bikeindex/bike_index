<div class="tw:mt-6">
  <% if show_user? %>
    <p>
      <% if @index.user_subject.present? %>
        <%= @viewing.pluralize %> for
        <%= link_to @index.user_subject.display_name, admin_user_path(@index.user_subject), class: "twlink" %>
      <% else %>
        <span class="<%= error_text_class %>">
          User #<%= @index.params[:user_id] %> <em>missing</em>
        </span>
      <% end %>

      <%= view_all_link("view for all users", :user_id) %>
    </p>
  <% end %>

  <% if show_bike? %>
    <p>
      <% if bike_subject.present? %>
        <%= @viewing.pluralize %> for
        <%= link_to bike_subject.title_string, admin_bike_path(bike_subject), class: "twlink" %>
      <% else %>
        <span class="<%= error_text_class %>">
          Bike #<%= @index.params[:search_bike_id] %> <em>missing</em>
        </span>
      <% end %>

      <%= view_all_link("view for all bikes", :search_bike_id) %>

      <%= render(Pages::Admin::Bikes::DeletedAlert::Component.new(bike: bike_subject)) %>
    </p>
  <% end %>

  <% if show_marketplace_listing? %>
    <p>
      <% if marketplace_listing_subject.present? %>
        <%= @viewing.pluralize %> for
        <em>Marketplace Listing <%= render(Atoms::Admin::Badges::MarketplaceListing::Component.new(status: marketplace_listing_subject.status, status_humanized: marketplace_listing_subject.status_humanized, kind: :marketplace_listing)) %> #<%= marketplace_listing_subject.id %>,</em>


        <%= render Atoms::Admin::TableCells::Bike::Component.new(bike: marketplace_listing_subject.item, bike_id: marketplace_listing_subject.item_id) %>
      <% else %>
        <span class="<%= error_text_class %>">
          Marketplace #<%= @index.params[:search_marketplace_listing_id] %>
          <em>missing</em>
        </span>
      <% end %>

      <%= view_all_link("view for all marketplace listings", :search_marketplace_listing_id) %>
    </p>
  <% end %>

  <% if show_organization? %>
    <p>
      <%= @viewing.pluralize %> for
      <% if organization_subject.present? %>
        <em>
          <%= link_to organization_subject.short_name, admin_organization_path(organization_subject), class: "twlink" %>
        </em>
      <% else %>
        <strong>no organization</strong>
      <% end %>

      <%= view_all_link("view for all organizations", :organization_id) %>
      <% if organization_subject&.deleted? %>
        <em class="d-block twless-strong tw:mt-1">
          (<%= organization_subject.short_name %> is
          <em class="<%= error_text_class %>">deleted</em>) - at
          <%= render UI::Time::Component.new(time: organization_subject.deleted_at, format: :localize_time_precise) %>
        </em>
      <% end %>
    </p>
  <% end %>

  <% if show_membership? %>
    <p>
      <%= @viewing.pluralize %> for
      <%= link_to "Membership #{membership_id}", admin_membership_path(membership_id), class: "twlink" %>
      <%= view_all_link("view for all memberships", :search_membership_id) %>
    </p>
  <% end %>

  <% if show_strava_integration? %>
    <p>
      <%= @viewing.pluralize %> for
      <%= link_to "Strava Integration #{strava_integration_id}", admin_strava_integration_path(strava_integration_id), class: "twlink" %>
      <% if strava_integration.present? %>
        <small>
          for
          <%= render(Atoms::Admin::TableCells::User::Component.new(user: strava_integration.user, user_id: strava_integration.user_id,
            user_link_path: admin_strava_integration_path(strava_integration_id))) %>
        </small>
      <% end %>
      <%= view_all_link("view for all Strava integrations", :search_strava_integration_id) %>
    </p>
  <% end %>

  <% if show_kind? %>
    <p>
      <%= @viewing.pluralize %> for <strong><%= kind_humanized %></strong>
      <%= view_all_link("view for all kinds", :search_kind) %>
    </p>
  <% end %>

  <% if show_primary_activity? %>
    <p>
      <%= @viewing.pluralize %> for
      <% if primary_activity_subject.present? %>
        <%= link_to primary_activity_subject.name, admin_primary_activity_path(primary_activity_subject), class: "twlink" %>
      <% else %>
        <span class="<%= error_text_class %>">
          unknown primary activity "<%= @index.params[:primary_activity] %>"
        </span>
      <% end %>

      <%= view_all_link("view for all primary activities", :primary_activity) %>
    </p>
  <% end %>
</div>
