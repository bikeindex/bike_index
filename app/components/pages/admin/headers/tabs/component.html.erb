<%# UI::Tabs draws the line under itself, so the nav's own border would double it %>
<%= render(Pages::Admin::Headers::Nav::Component.new(title: @title, subtitle: @subtitle, border: false)) do %>
  <% @links.each do |link| %>
    <li><%= link %></li>
  <% end %>
<% end %>

<% if alert? %>
  <div class="tw:mb-4 tw:md:w-1/2"><%= alert %></div>
<% end %>

<%= render(UI::Tabs::Component.new(tabs: @tabs, nav_label: @nav_label, margin_classes: tabs_classes)) %>

<% if summary? %>
  <%# inverted flips tw:dark: inside it, so what it holds styles itself as for a dark page %>
  <div
    class="
      inverted twgutter-bleed tw:mb-6 tw:bg-linear-160 tw:from-white
      tw:to-gray-100 tw:pt-6 tw:pb-1 tw:text-slate-900
      tw:dark:from-slate-900 tw:dark:to-[#233140] tw:dark:text-white
    "
  >
    <%= summary %>
  </div>
<% end %>
