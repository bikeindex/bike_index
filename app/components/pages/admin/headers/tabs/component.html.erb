<%# UI::Tabs draws the line under itself, so the nav's own border would double it %>
<%= render(Pages::Admin::Headers::Nav::Component.new(title: @title, subtitle: @subtitle, border: false)) do |nav| %>
  <% nav_items.each do |nav_item| %>
    <% nav.with_item { nav_item.to_s } %>
  <% end %>
<% end %>

<% if alert? %>
  <div class="tw:mb-4 tw:md:w-1/2"><%= alert %></div>
<% end %>

<%= render(UI::Tabs::Component.new(tabs: @tabs, nav_label: @nav_label, margin_classes: tabs_classes)) %>

<% if summary? %>
  <div class="twgutter-bleed tw:mb-6 tw:pt-6 tw:pb-4 <%= SharedBlocks::Marketing::InvertedBlock::Component::BAND_CLASSES %>">
    <%= summary %>
  </div>
<% end %>
