<%# UI::Tabs draws the line under itself, so the nav's own border would double it %>
<%= render(Pages::Admin::Headers::Nav::Component.new(title: @title, subtitle: @subtitle, border: false)) do %>
  <% @links.each do |link| %>
    <li><%= link %></li>
  <% end %>
<% end %>

<% if alert? %>
  <div class="tw:mb-4 tw:md:w-1/2"><%= alert %></div>
<% end %>

<%= render(UI::Tabs::Component.new(tabs: @tabs, nav_label: @nav_label, margin_classes: tabs_classes)) %>

<% if summary? %>
  <div
    class="
      twgutter-bleed tw:mb-6 tw:bg-[#212529] tw:pt-6 tw:pb-1 tw:text-white
      tw:[&_:is(h1,h2,h3,h4)]:text-white tw:[&_table]:bg-white
    "
  >
    <%= summary %>
  </div>
<% end %>
