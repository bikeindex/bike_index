<%= render(UI::TableList::Component.new) do |list| %>
  <% list.with_row(label: "Active:") do %>
    <strong>
      <% if @invoice.active? %>
        "Yes"
      <% elsif @invoice.expired? %>
        <em class="tw:text-sm <%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">Expired</em>
      <% elsif @invoice.future? %>
        <em class="tw:text-sm <%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">Starts in the future</em>
      <% else %>
        no
      <% end %>
    </strong>
  <% end %>

  <% list.with_row(label: @invoice.expired? ? "Expired:" : "Expires:") do %>
    <% if @invoice.endless? %>
      <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">Endless</span>
      (invoice never ends)
    <% else %>
      <%= render(UI::Time::Component.new(time: @invoice.subscription_end_at, format: :localize_time_precise_seconds)) %>
    <% end %>
  <% end %>
<% end %>
