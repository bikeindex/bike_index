<%= render(Pages::Admin::Headers::Tabs::Component.new(title: @organization.name, subtitle: @subtitle,
      tabs:, nav_label: "Organization sections")) do |header| %>
  <% top_right_links.each do |link| %>
    <% header.with_nav_item { link } %>
  <% end %>

  <% if @organization.deleted? %>
    <% header.with_alert do %>
      <%= render(UI::Alerts::Base::Component.new(kind: :error, header: "Organization deleted")) do %>
        <%= render(UI::Time::Component.new(time: @organization.deleted_at, format: :localize_time_precise, preposition: true)) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
