<%= render(UI::TableList::Component.new) do |list| %>
  <% list.with_row(label: "ID", value: @organization.id, class: "tw:text-sm only-dev-visible", if: @display_dev_info) %>

  <% list.with_row(label: "Short Name") do %>
    <%= @organization.short_name %>

    <% if CredibilityScorer.organization_trusted?(@organization) %>
      <%= render(UI::Badge::Component.new(text: "Trusted credibility", color: :success, size: :sm)) %>
    <% elsif CredibilityScorer.organization_suspicious?(@organization) %>
      <%= render(UI::Badge::Component.new(text: "Suspicious credibility", color: :warning, size: :sm)) %>
    <% end %>

    <% if @organization.spam_registrations %>
      <small class="ml-1 <%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">high spam registrations</small>
    <% end %>
  <% end %>

  <% list.with_row(label: "Map") do %>
    <% unless @organization.approved %>
      <strong>Not approved</strong>
      <small>therefor hidden</small>
      <em>Would be</em>
    <% end %>

    <% if @organization.show_on_map %>
      <span class="twless-strong">Shown on map</span>
    <% else %>
      <strong>Not Shown</strong>
    <% end %>
  <% end %>

  <% list.with_row(label: "Kind") do %>
    <%= @organization.kind_humanized %>

    <% if @organization.enabled?("official_manufacturer") %>
      <% unless @organization.kind == "bike_manufacturer" %>
        <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">
          Kind should be "Bike Manufacturer"
        </span>
      <% end %>
      <br>
      <% if @organization.manufacturer_id.present? %>
        <strong><%= @organization.manufacturer.name %></strong>
        <em class="twless-strong">Manufacturer official account of</em>
      <% else %>
        <strong class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">No Manufacturer assigned</strong>
        <span class="twless-strong">
          <%= link_to "edit organization", edit_admin_organization_path(@organization) %>
          to add
        </span>
      <% end %>
    <% end %>
  <% end %>

  <% list.with_row(label: "Slug") do %>
    <%= @organization.slug %> |
    <%= link_to "embed", embed_registrations_url(organization_id: @organization.to_param) %>
  <% end %>

  <% list.with_row(label: "Created") do %>
    <%= render(UI::Time::Component.new(time: @organization.created_at, format: :localize_time_precise)) %>

    <small class="localizeTimezone"></small>
  <% end %>

  <% list.with_row(label: "Updated", value: render(UI::Time::Component.new(time: @organization.updated_at, format: :localize_time_precise))) %>
<% end %>
