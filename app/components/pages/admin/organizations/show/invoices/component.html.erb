<p class="tw:mb-4">
  <% if @organization.invoices.count > 0 %>
    <strong><%= @organization.invoices.active.count %> active</strong> and
  <% end %>

  <em class="twless-strong">
    <%= link_to "#{pluralize(@organization.invoices.count, 'invoice')} total", admin_organization_invoices_path(organization_id: @organization), class: "twlink" %>
  </em>

  <% if OrgServices::Displayer.subscription_expired_alert?(@organization) %>
    <span
      class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>"
      title="the subscription expired message will be shown to them in their portal"
    >
      Subscription expired
    </span>
  <% end %>
</p>

<% if @organization.parent_organization.present? %>
  <p class="tw:mb-4">
    Parent
    <strong class="tw:italic"><%= @organization.parent_organization.short_name %></strong>
    has
    <%= link_to admin_organization_invoices_path(organization_id: @organization.parent_organization.to_param), class: "twlink" do %>
      <%= pluralize(@organization.parent_organization.invoices.count, "invoice") %>
    <% end %>
    <small class="twless-strong">
      which may add features to this organization
    </small>
  </p>
<% end %>

<%= render(Pages::Admin::Invoices::Table::Component.new(invoices: @organization.invoices.order(id: :desc).limit(3), skip_discount_due: true)) %>
