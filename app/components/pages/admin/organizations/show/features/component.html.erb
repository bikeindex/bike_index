<%= render(UI::TableList::Component.new) do |list| %>
  <% list.with_row(label: "Invoiced") do %>
    <% if @organization.is_invoiced? %>
      <strong>True</strong>
    <% else %>
      <% if LandingPageOrganizations::SLUGS.include?(@organization.slug) %>
        <p class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">
          IS NOT MARKED INVOICED BUT HAS A LANDING PAGE
        </p>
      <% elsif @organization.paid_previously? %>
        <strong class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">Previously paid!</strong>
      <% else %>
        False
      <% end %>
    <% end %>

    <em class="twless-strong tw:text-sm">
      Set this via
      <%= link_to "invoices", admin_organization_invoices_path(organization_id: @organization.to_param) %>
    </em>
  <% end %>

  <% if @organization.is_invoiced? %>
    <% list.with_row(label: "Bike Search") do %>
      <% if @organization.enabled?("bike_search") %>
        Yes
      <% else %>
        <small class="twless-strong">no</small>
      <% end %>
    <% end %>
    <% list.with_row(label: "Templates") do %>
      <% if @organization.mail_snippets.any? %>
        <%= @organization.mail_snippets.pluck(:kind).to_sentence %>
      <% else %>
        <small class="twless-strong">none</small>
      <% end %>
    <% end %>
    <% list.with_row(label: "Landing Page") do %>
      <% if @organization.organization_landing_page&.body? %>
        <% if LandingPageOrganizations::SLUGS.include?(@organization.slug) %>
          <%= link_to 'public landing page', "#{ENV['BASE_URL']}/#{@organization.slug}" %>
        <% else %>
          landing page is not public -
          <%= link_to 'landing page', organization_landing_path(organization_id: @organization.to_param) %>
        <% end %>
      <% else %>
        <small class="twless-strong">no</small>
      <% end %>
    <% end %>
    <% list.with_row(label: "Additional Fields") do %>
      <% additional_fields = @organization.additional_registration_fields.map { |i| OrganizationFeature.reg_field_to_bike_attrs(i)&.titleize(keep_id_suffix: true) } %>

      <% if additional_fields.none? %>
        <small class="twless-strong">none</small>
      <% else %>
        <small><%= additional_fields.join(", ") %></small>
        <br>
        <% if @organization.registration_field_labels.values.none? %>
          <em class="twless-strong tw:text-sm">No custom labels</em>
        <% else %>
          <em class="twless-strong tw:text-sm">Custom Labels:</em>
          <ul class="mb-0 tw:text-sm">
            <% @organization.registration_field_labels.each do |field, label| %>
              <li>
                <strong>
                  <%= OrganizationFeature.reg_field_to_bike_attrs(field).titleize(keep_id_suffix: true) %>:
                </strong>

                <%= label %>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>
    <% list.with_row(label: "Hot Sheet", if: @organization.enabled?("hot_sheet")) do %>
      <% if @organization.hot_sheet_on? %>
        Enabled
        <em class="twless-strong"><%= "recipient".pluralize(@organization.hot_sheet_configuration.current_recipients.count) %></em>
      <% else %>
        <small class="twless-strong">not enabled</small>
      <% end %>

      <small>
        <%= link_to "configuration", edit_organization_hot_sheet_path(organization_id: @organization.to_param) %>
      </small>
    <% end %>
    <% if @organization.enabled?("organization_stolen_message") %>
      <% organization_stolen_message = OrganizationStolenMessage.for(@organization) %>
      <% list.with_row(label: "Stolen Message") do %>
        <% if organization_stolen_message.is_enabled %>
          <%= link_to "Enabled", edit_organization_email_path("organization_stolen_message", organization_id: @organization.to_param) %>
        <% elsif organization_stolen_message.body.present? %>
          has content, not enabled
        <% else %>
          <small class="twless-strong">no</small>
        <% end %>

        <% if organization_stolen_message.report_url.present? %>
          <small>Report URL present</small>
        <% end %>
      <% end %>
    <% end %>
    <% list.with_row(label: "Stickers") do %>
      <% if @organization.enabled?("bike_stickers") %>
        <%= link_to admin_bike_stickers_path(organization_id: @organization.to_param) do %>
          <%= number_display(@organization.bike_stickers.count) %> stickers
        <% end %>
      <% else %>
        <small class="twless-strong">no</small>
      <% end %>
    <% end %>
    <% list.with_row(label: "Graduated bikes", if: @organization.enabled?("graduated_notifications")) do %>
      <% if @organization.deliver_graduated_notifications? %>
        Delivering notifications
        <small><%= @organization.graduated_notification_interval_days %> day interval</small>
      <% else %>
        <em class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">Not delivering</em>
        <small>notification interval is not set</small>
      <% end %>
    <% end %>
    <% list.with_row(label: "Enabled features", value: tag.span(safe_join(@organization.enabled_feature_slugs.map { |slug| tag.code(slug) }, ", "), class: "tw:text-sm")) %>
  <% end %>

  <% list.with_row(label: "Child of", if: @organization.parent_organization.present?) do %>
    <%= link_to @organization.parent_organization.name, admin_organization_path(@organization.parent_organization) %>

    <small class="twless-strong tw:block">
      Parent organization should be part of the same organization. Use
      "regional" feature otherwise
    </small>
  <% end %>

  <% list.with_row(label: "Child organizations", if: @organization.parent?) do %>
    <ul class="mb-2 tw:text-sm">
      <% @organization.child_organizations.each do |org| %>
        <li><%= link_to org.name, admin_organization_url(org) %></li>
      <% end %>
    </ul>

    <small class="twless-strong tw:block">
      Parent organization should be part of the same organization. Use
      "regional" feature otherwise
    </small>
  <% end %>

  <% if @organization.regional? %>
    <% list.with_row(label: "Regional Sub-Organizations") do %>
      <ul class="mb-2 tw:text-sm">
        <% @organization.nearby_organizations.each do |suborg| %>
          <li>
            <%= link_to suborg.name, admin_organization_path(suborg) %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% list.with_row(label: "Regional address", value: render(UI::AddressDisplay::Component.new(address_record: @organization.default_address_record, visible_attribute: :street, kind: :single_line))) %>
    <% list.with_row(label: "Search radius") do %>
      <%= @organization.search_radius_display %>

      <small class="twless-strong">
        This controls which organizations are regional sub organizations
      </small>
    <% end %>
  <% end %>

  <% list.with_row(label: "Regional overview organization", if: regional_parents.any?) do %>
    <% if regional_parents.count == 1 %>
      <% regional_parent = regional_parents.first %>
      <%= link_to regional_parent.name, admin_organization_path(regional_parent) %>
    <% else %>
      <ul class="mb-2 tw:text-sm">
        <% regional_parents.each do |regional_parent| %>
          <li>
            <%= link_to regional_parent.name, admin_organization_path(regional_parent) %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <small class="twless-strong tw:block">
      Search radius includes this organization
    </small>
  <% end %>

  <% list.with_row(label: "Associated orgs", if: !associated_organizations?) do %>
    <em class="twless-strong tw:text-sm">No associated organizations</em>
  <% end %>
<% end %>
