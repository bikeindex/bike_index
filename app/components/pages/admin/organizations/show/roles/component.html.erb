<div class="tw:mt-6 tw:flex tw:flex-wrap tw:items-baseline tw:gap-2">
  <% title = capture do %>
    <%= number_with_delimiter(organization_roles_count) %>

    <% if @deleted %>
      <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">Deleted</span>
    <% end %>

    <%= "OrganizationRole".pluralize(organization_roles_count) %>
  <% end %>

  <%= render(UI::Header::Component.new(tag: :h2, html_class: "twsection")) do %>
    <%= title %>

    <span class="tw:font-normal">
      <small>
        <% if @deleted %>
          <small>
            <%= number_with_delimiter(organization_roles.claimed.count) %>
            claimed
          </small>
          <% unless @organization.deleted? %>
            -
            <small class="twless-strong"><%= render(UI::ButtonLink::Component.new(href: admin_organization_path(@organization, deleted_organization_roles: false), color: :link_gray)) do %>              <%= number_with_delimiter(@organization.organization_roles.count) %>              <strong>NOT</strong> deleted organization role<% end %></small>
          <% end %>
        <% else %>
          <small><%= number_with_delimiter(@organization.organization_roles.claimed.count) %> claimed</small>
          -
          <small class="twless-strong"><%= render(UI::ButtonLink::Component.new(href: admin_organization_path(@organization, deleted_organization_roles: true), color: :link_gray)) do %>            <%= number_with_delimiter(@organization.organization_roles.deleted.count) %>            deleted<% end %></small>


          <%= render(UI::ButtonLink::Component.new(text: "new organization role", href: new_admin_organization_role_url(organization_id: @organization.to_param), size: :sm, html_class: "tw:ml-3")) %>
        <% end %>
      </small>
    </span>
  <% end %>

  <%# ml-auto rather than justify-between, which drops the link to the left once it wraps %>
  <%= link_to "View all organization_roles", admin_organization_roles_path(organization_id: @organization.to_param), class: "twlink tw:ml-auto" %>
</div>

<% if organization_roles_count > 0 %>
  <%= render partial: "/admin/organization_roles/table", locals: { organization_roles: organization_roles.limit(25), skip_organization: true, render_deleted: @deleted} %>
<% end %>
