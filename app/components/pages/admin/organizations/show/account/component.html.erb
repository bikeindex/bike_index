<%= render(UI::TableList::Component.new) do |list| %>
  <% list.with_row(label: "Auto user email", value: (@organization.auto_user.email if @organization.auto_user.present?)) %>

  <% if @display_dev_info %>
    <% list.with_row(label: "API V1 token", class: "tw:text-sm", dev_only: true) do %>
      <div id="stupidLegacyToken" style="overflow-x: scroll;">
        <%= render(UI::Code::Inline::Component.new(text: @organization.access_token)) %>
      </div>
    <% end %>
    <% list.with_row(label: "User Reg all bikes?", value: @organization.user_registration_all_bikes?, class: "tw:text-sm", dev_only: true) %>
  <% end %>

  <% list.with_row(label: "Users", value: link_to(@organization.users.count, admin_users_path(organization_id: @organization.to_param), class: "twlink")) %>

  <% list.with_row(label: "Sent Invites", value: number_with_delimiter(@organization.sent_invitation_count)) %>

  <% list.with_row(label: "Remaining invites") do %>
    <% if @organization.restrict_invitations? %>
      <%= number_with_delimiter @organization.remaining_invitation_count %>
    <% else %>
      <em>permitted domain, no invite restrictions</em>
    <% end %>
  <% end %>

  <% list.with_row(label: "Website") do %>
    <%= @organization.website %>

    <% if @organization.website.present? %>
      <%= link_to @organization.website, class: "strong" do %>
        &#128279;
      <% end %>
    <% end %>
  <% end %>

  <% list.with_row(label: "POS integration:") do %>
    <% if @organization.no_pos? %>
      <em class="twless-strong tw:text-sm">no integration</em>
    <% elsif @organization.ascend_or_broken_ascend? %>
      <%= link_to "Ascend POS", organization_bulk_imports_path(organization_id: @organization.to_param), class: "twlink" %>
      <small>Ascend name: <em><%= @organization.ascend_name %></em></small>
    <% elsif @organization.broken_pos? %>
      <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">POS Integration broken!</span>
      <%= @organization.pos_kind.humanize %>
    <% elsif @organization.does_not_need_pos? %>
      <small class="twless-strong">Does not need POS integration</small>
    <% end %>

    <% if @organization.lightspeed_pos? || @organization.broken_pos? && @organization.bikes.lightspeed_pos.any? %>
      <%= link_to "Lightspeed POS", "https://posintegration.bikeindex.org/admin/organizations/#{@organization.id}", class: "twlink" %>
    <% end %>

    <% if @display_dev_info && @organization.manual_pos_kind.present? %>
      <small class="only-dev-visible tw:ml-2 tw:inline-block">
        <em class="twless-strong">manual POS kind set:</em>
        <%= @organization.manual_pos_kind %>
      </small>
    <% end %>

    <% if !@organization.no_pos? || @organization.opted_into_theft_survey_2023 %>
      <small class="tw:ml-4">
        <span class="twless-strong">theft survey?</span>
        <%= @organization.opted_into_theft_survey_2023 %>
      </small>
    <% end %>
  <% end %>
<% end %>
