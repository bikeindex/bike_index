<%= render(UI::Alerts::ObjectError::Component.new(object: @landing_page)) %>

<%= form_for @landing_page, url: form_url, html: {method: :patch} do |f| %>
  <%= render(UI::Container::Component.new(width: :wide)) do %>
    <%= hidden_field_tag :kind, "landing_page" %>

    <% if @landing_page.persisted? %>
      <div class="mb-2">
        <%= link_to "Version history", version_history_path, class: "twlink" %>
      </div>
    <% end %>

    <div>
      <% enabled_mismatch_error = @landing_page.enabled_mismatch_error %>

      <% if enabled_mismatch_error.present? %>
        <%= render(UI::Alerts::Base::Component.new(kind: :error, margin_classes: "tw:mb-2", text: enabled_mismatch_error)) %>
      <% end %>

      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :body, kind: :text_area,
        label_text: "Landing page (html)", html_options: {rows: 20})) %>

      <% if @suggested_button_hover.present? %>
        <%= render(UI::Alerts::Base::Component.new(kind: :notice, margin_classes: "tw:mt-2")) do %>
          The register frame names a button color but no hover color. Add
          <code><%= hover_param %></code> to its src to set the shade it
          currently derives.
        <% end %>
      <% end %>
    </div>

    <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2">
      <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :enabled, label: "Enabled")) %>
      <%= render(UI::Button::Component.new(text: "Save", color: :primary, type: "submit", html_class: "tw:ml-auto")) %>
    </div>
  <% end %>
<% end %>

<%# Because somewhere, there is overflow hidden and it cuts off the bottom of the save button %>
<%= render(UI::Forms::FileUploadMulti::Component.new(url: public_images_path, file_param: "public_image[image]",
      params: {organization_id: @organization.to_param}, accept: ImageUploader.permitted_extensions,
      list_html_options: {id: "public_images", class: "list-unstyled mt-4 not-blog-public-images",
        data: {order_url: order_public_images_url}})) do %>
  <%= render partial: "public_images/admin_public_image", collection: @organization.public_images, as: :public_image, locals: {skip_order: true} %>
<% end %>
