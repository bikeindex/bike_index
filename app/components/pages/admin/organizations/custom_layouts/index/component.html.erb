<div class="twwiderow tw:items-start">
  <p>
    <%= link_to "Custom layouts version history", version_history_url %>
  </p>

  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "Invoiced") do %>
      <strong><%= @organization.is_invoiced? %></strong>
    <% end %>
  <% end %>
</div>

<%= render(Pages::Admin::Organizations::CustomLayouts::Table::Component.new(organization: @organization)) %>

<div class="mt-4">
  <strong>Note:</strong> Custom Layouts (other than landing pages), are
  <%= link_to "Mail Snippets", admin_mail_snippets_path %>. You can view and
  edit all the active ones there.
</div>
