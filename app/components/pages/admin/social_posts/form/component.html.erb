<div data-controller="admin--social-post-form">
  <%= render(UI::Alerts::ObjectError::Component.new(object: @social_post)) %>

  <%= form_for [:admin, @social_post] do |f| %>
    <%= render(UI::Container::Component.new) do %>
      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :kind, required: true)) do %>
        <%= render(UI::Forms::Select::Component.new(form_builder: f, attribute: :kind, option_tags: kind_options,
          options: {prompt: "Choose kind"}, required: true,
          html_options: {data: {"admin--social-post-form-target": "kind", action: "change->admin--social-post-form#kindChanged"}})) %>
      <% end %>
    <% end %>

    <div
      class="<%= kind_hidden_class("app_post") %>"
      data-admin--social-post-form-target="kindFields"
      data-kind="app_post"
    >
      <%= render(UI::Card::Component.new) do %>
        <div class="twwiderow">
          <div>
            <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :social_account_id, label_text: "Account")) do |group| %>
              <% group.with_label_note { "will send the original post" } %>

              <%= render UI::Forms::Combobox::Component.new(name: :social_account_id, options: account_options, include_blank: true, html_options: {form: f, placeholder: "Choose  "}) %>
            <% end %>

            <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :image, label_text: "Post photo")) do %>
              <%= render(UI::Forms::Files::Upload::Component.new(form_builder: f, attribute: :image, accept: ImageUploader.permitted_extensions)) %>
            <% end %>
          </div>

          <div
            data-controller="admin--character-count"
            data-admin--character-count-max-value="<%= Integrations::SocialPoster::TWEET_LENGTH %>"
          >
            <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :body, kind: :text_area, label_text: "Post",
              html_options: {rows: 4, data: {"admin--character-count-target": "field", action: "input->admin--character-count#update"}})) do |group| %>
              <% group.with_label_note { "Make sure the text is under the character count" } %>
            <% end %>

            <p
              class="tw:mb-4 tw:text-right <%= UI::Alerts::Base::Component::TEXT_CLASSES[:notice] %>"
              style="margin-top: -0.4rem; font-size: 150%;"
            >
              <span data-admin--character-count-target="total"></span>
            </p>
          </div>
        </div>

        <%= render(UI::Button::Component.new(text: "Send post!", color: :primary, type: "submit")) %>

        <div class="tw:mt-6">
          <strong>Repost:</strong>

          <%= render(UI::Button::Component.new(text: "select all", size: :sm, html_class: "tw:ml-6",
                data: {action: "admin--social-post-form#checkAll"})) %>

          <%= render(UI::Button::Component.new(text: "unselect", size: :sm, html_class: "tw:ml-2",
                data: {action: "admin--social-post-form#uncheckAll"})) %>
        </div>

        <div class="tw:mt-2 tw:mb-4 tw:flex tw:flex-wrap tw:gap-x-4">
          <% SocialAccount.active.each do |social_account| %>
            <%= render(UI::Forms::Checkbox::Component.new(name: "social_account_ids[]", value: social_account.id, checked: true,
              label: social_account.screen_name,
              html_options: {id: "social_account_ids_#{social_account.id}", data: {"admin--social-post-form-target": "accountCheckbox"}})) %>
          <% end %>
        </div>

        <em class="twless-strong tw:text-sm">
          Even if checked, original account won't repost itself (so feel free to
          leave it checked)
        </em>
      <% end %>
    </div>

    <div
      class="<%= kind_hidden_class("imported_post") %>"
      data-admin--social-post-form-target="kindFields"
      data-kind="imported_post"
    >
      <%= render(UI::Card::Component.new) do %>
        <p class="tw:mb-4"><strong>Import a post</strong></p>

        <p class="tw:mb-4">
          <em>This is primarily for adding a post to a landing page.</em>
        </p>

        <p class="tw:mb-4">
          Get the post ID from the URL of the post. It's the final number at the
          end of the url
        </p>

        <p class="tw:mb-4">
          e.g. for
          <code class="twcode">https://twitter.com/stolenbikereg/status/874644243737751553</code>
          - 874644243737751553
        </p>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :platform_id, label_text: "Platform id")) %>

        <div class="tw:mt-6">
          <%= render(UI::Button::Component.new(text: "Create post!", color: :primary, type: "submit")) %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
