<%= render(UI::Header::Component.new(tag: :h2, html_class: "twsection")) do %>
  <%= tag.span("Recovery Information", class: UI::Alerts::Base::Component::TEXT_CLASSES[:success]) %>

  <span class="tw:font-normal">
    <%= link_to "view", admin_recovery_path(@stolen_record.to_param), class: "twlink tw:ml-2 tw:text-sm" %>
  </span>
<% end %>

<div class="tw:flex tw:flex-wrap">
  <div class="tw:w-full tw:lg:w-1/2 tw:lg:pr-4">
    <%= render(UI::TableList::Component.new) do |list| %>
      <% list.with_row(label: "Recovered at", value: render(UI::Time::Component.new(time: @stolen_record.recovered_at))) %>

      <% list.with_row(label: "Recovered by", value: recovering_user_cell) %>

      <% list.with_row(label: "We Helped", value: (check_mark if @stolen_record.index_helped_recovery)) %>

      <% list.with_row(label: "Can Share", value: (check_mark if @stolen_record.can_share_recovery)) %>
    <% end %>
  </div>

  <div class="tw:w-full tw:lg:w-1/2">
    <%= render(UI::TableList::Component.new) do |list| %>
      <% list.with_row(label: "Description", value: @stolen_record.recovered_description) %>
    <% end %>
  </div>
</div>
