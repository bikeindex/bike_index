<div
  class="tw:mt-8"
  data-controller="ui--collapse"
  data-ui--collapse-param-value="creation_data"
>
  <%# With dev info on this always shows, so the trigger would only ever close it %>
  <% unless @display_dev_info %>
    <%= render(UI::Collapse::Component.new(text: "Creation data & developer information", chevron: true, color: :link)) %>
  <% end %>

  <div
    class="<%= "tw:hidden" unless @display_dev_info %>"
    data-ui--collapse-target="content"
  >
    <div class="twwiderow tw:mt-4">
      <% ownerships.each do |ownership| %>
        <div>
          <%= render(UI::DefinitionList::Container::Component.new) do %>
            <%= render(UI::DefinitionList::Row::Component.new(label: "Kind")) do %>
              Ownership <%= ownership_kind(ownership) %>
            <% end %>

            <%= render(UI::DefinitionList::Row::Component.new(label: "Created")) do %>
              <%= render(UI::Time::Component.new(time: ownership.created_at)) %>

              <% if @display_dev_info %>
                <span class="tw:ml-2"><%= render(UI::Code::Inline::Component.new(text: "ID: #{ownership.id}", small: true)) %></span>
              <% end %>
            <% end %>

            <%= render(UI::DefinitionList::Row::Component.new(label: "Updated")) do %>
              <%= render(UI::Time::Component.new(time: ownership.updated_at)) %>
            <% end %>

            <%= render(UI::DefinitionList::Row::Component.new(label: "Organization",
                  value: organization_link(ownership))) %>

            <%= render(UI::DefinitionList::Row::Component.new(label: "Creator", value: creator_link(ownership))) %>

            <% ownership.registration_info&.each do |key, value| %>
              <%= render(UI::DefinitionList::Row::Component.new(label: key, value:)) %>
            <% end %>
          <% end %>
        </div>

        <%= render UI::Code::Json::Component.new(data: ownership_attributes(ownership), skip_blank: true) %>
      <% end %>
    </div>

    <% if b_params.none? %>
      <p class="tw:my-4">
        No <%= render(UI::Code::Inline::Component.new(text: "BParams")) %> exist
      </p>
    <% else %>
      <div class="twwiderow tw:mt-4">
        <% b_params.each do |b_param| %>
          <div>
            <%= render(UI::DefinitionList::Container::Component.new) do %>
              <%= render(UI::DefinitionList::Row::Component.new(label: "Kind", value: "BParam")) %>

              <%= render(UI::DefinitionList::Row::Component.new(label: "Created")) do %>
                <%= render(UI::Time::Component.new(time: b_param.created_at)) %>

                <% if @display_dev_info %>
                  <span class="tw:ml-2"><%= render(UI::Code::Inline::Component.new(text: "ID: #{b_param.id}", small: true)) %></span>
                <% end %>
              <% end %>

              <%= render(UI::DefinitionList::Row::Component.new(label: "Updated")) do %>
                <%= render(UI::Time::Component.new(time: b_param.updated_at)) %>
              <% end %>
            <% end %>
          </div>

          <%= render UI::Code::Json::Component.new(data: b_param.params, skip_blank: true) %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
