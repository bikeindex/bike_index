<%= render(UI::Header::Component.new(tag: :h2, html_class: "twsection")) do %>
  Notifications
  <%= render(Pages::Admin::Headers::Count::Component.new(count: notifications.size, href: admin_notifications_path(search_bike_id: @bike.id))) %>
<% end %>

<% if notifications.any? %>
  <%= render partial: "/admin/notifications/table",
        locals: {notifications:, skip_bike: true, show_message_preview: true} %>
<% end %>

