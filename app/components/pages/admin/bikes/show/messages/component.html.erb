<%= render(Pages::Admin::Headers::Section::Component.new(title: "Notifications", count: notifications.size,
      href: admin_notifications_path(search_bike_id: @bike.id))) %>

<% if notifications.any? %>
  <%= render partial: "/admin/notifications/table",
        locals: {notifications:, skip_bike: true, show_message_preview: true} %>
<% end %>

<%= render(Pages::Admin::Headers::Section::Component.new(title: "Organization messages", count: organization_messages.size,
      href: admin_organization_messages_path(search_bike_id: @bike.id))) %>

<% if organization_messages.any? %>
  <%= render partial: "/admin/organization_messages/table", locals: {collection: organization_messages, skip_bike: true} %>
<% end %>

