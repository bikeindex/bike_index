<div class="tw:mt-6">
  <div
    class="
      tw:mb-3 tw:flex tw:flex-wrap tw:items-baseline tw:justify-between
      tw:gap-2
    "
  >
    <h3 class="tw:mb-0 tw:text-lg tw:font-bold">
      Serial match <code><%= @duplicate_group.segment %></code>
    </h3>

    <%= render(UI::ButtonLink::Component.new(text: "Ignore - they're all legitimate", method: :put, size: :sm,
      href: ignore_duplicate_toggle_admin_bikes_path(id: @duplicate_group.id))) %>
  </div>

  <div class="tw:grid tw:grid-cols-1 tw:gap-4 tw:sm:grid-cols-2 tw:lg:grid-cols-3">
    <% bikes.each do |bike| %>
      <div class="<%= card_classes(bike) %>">
        <% thumb_url = BikeServices::Displayer.thumb_image_url(bike) %>

        <% if thumb_url.present? %>
          <%= image_tag(thumb_url, alt: "", loading: "lazy", skip_pipeline: true, class: "#{THUMB_CLASSES} tw:object-cover") %>
        <% else %>
          <div class="tw:flex tw:items-center tw:justify-center tw:bg-gray-100 tw:text-sm tw:text-gray-400 tw:dark:bg-gray-900 <%= THUMB_CLASSES %>">
            No photo
          </div>
        <% end %>

        <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2">
          <%= link_to title(bike), edit_admin_bike_path(bike), class: "twlink tw:font-bold" %>
          <%= render(Atoms::RegistrationStatusBadge::Component.new(bike:, skip_with_owner: true, size: :xs)) %>

          <% if current?(bike) %>
            <span class="tw:text-xs tw:font-semibold tw:text-blue-600">This bike</span>
          <% end %>
        </div>

        <%= render(UI::DefinitionList::Container::Component.new) do %>
          <%= render(UI::DefinitionList::Row::Component.new(label: "Serial", render_with_no_value: true)) do %>
            <code><%= bike.serial_number %></code>
          <% end %>

          <%= render(UI::DefinitionList::Row::Component.new(label: "Colors", value: bike.frame_colors.to_sentence, render_with_no_value: true)) %>

          <%= render(UI::DefinitionList::Row::Component.new(label: "Registered", render_with_no_value: true)) do %>
            <%= render(UI::Time::Component.new(time: bike.created_at)) %>

            <% if bike.creation_organization.present? %>
              by
              <%= link_to bike.creation_organization.short_name, admin_organization_path(bike.creation_organization.to_param), class: "twlink" %>
            <% end %>
          <% end %>

          <%= render(UI::DefinitionList::Row::Component.new(label: "Owner", render_with_no_value: true)) do %>
            <%= link_to bike.owner_email, admin_bikes_path(search_email: bike.owner_email), class: "twlink" %>
            <span class="tw:font-normal tw:text-gray-500"><%= bike.claimed? ? "claimed" : "unclaimed" %></span>
          <% end %>

          <%= render(UI::DefinitionList::Row::Component.new(label: "Credibility", render_with_no_value: true)) do %>
            <% if bike.credibility_score.present? %>
              <span
                style="color: <%= helpers.credibility_scorer_color_table(bike.credibility_score) %>;"
              >
                <%= bike.credibility_score %>
              </span>
            <% end %>
          <% end %>

          <% if bike.current_stolen_record.present? %>
            <%= render(UI::DefinitionList::Row::Component.new(label: "Stolen", value: stolen_text(bike.current_stolen_record))) %>
          <% end %>
        <% end %>

        <div class="tw:mt-auto tw:flex tw:flex-wrap tw:gap-2">
          <%= render(UI::ButtonLink::Component.new(text: "Edit", href: edit_admin_bike_path(bike), size: :sm)) %>

          <%= render(UI::ButtonLink::Component.new(text: "Delete", href: admin_bike_path(bike, return_to: request.fullpath), method: :delete,
            color: :error, size: :sm, confirm: "Delete #{title(bike)} (#{bike.serial_number})?")) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
