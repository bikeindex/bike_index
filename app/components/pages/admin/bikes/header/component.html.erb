<% if @bike.blank? %>
  <%= render(UI::Alerts::Base::Component.new(kind: :error, header: "No registration present",
        text: "This screen is scoped to a registration, and it no longer exists")) %>
<% else %>
  <%= render(Pages::Admin::Bikes::Tabs::Component.new(bike: @bike, active: @active, stolen_record: @stolen_record,
        display_recovery: @display_recovery)) %>

  <div class="twgutter-bleed admin-bike-summary">
    <%= render(Pages::Admin::Bikes::Summary::Details::Component.new(bike: @bike, user: @user,
          stolen_record: @stolen_record, display_dev_info: @display_dev_info)) %>

    <%= render(Pages::Admin::Bikes::Summary::Theft::Component.new(stolen_record: @stolen_record, bike: @bike,
          display_dev_info: @display_dev_info)) %>

    <%= render(Pages::Admin::Bikes::Summary::Recovery::Component.new(stolen_record: @stolen_record,
          display_recovery: @display_recovery)) %>
  </div>
<% end %>
