<%# require inline CSS setting because of caching %>
<% if @skip_manufacturer_link %>
  <style>.display-mnfg-link {display: none !important;}</style>
<% end %>

<% unless @render_sortable %>
  <style>.display-sortable-link {display: none !important;}</style>
<% end %>

<% if @no_show_header %>
  <style>.ui-table thead {display: none !important;}</style>
<% end %>

<%# A column only some callers render is in the cached rows, so it keys them %>
<%= render(UI::CardTable::Component.new(records: @bikes, cache_key: [self.class.cache_digest, (:multi_check if @render_multi_check), (:skip_user if @skip_user)].compact,
  render_sortable: @render_sortable, sort_state: @sort_state, **card_options,
  data: {controller: "update-cached-sortable-links", "update-cached-sortable-links-base-url-value": url_for(@sort_state.search_params)})) do |table| %>
  <% if @render_multi_check %>
    <% table.with_actions do %>
      <%= render(UI::Button::Component.new(text: "Delete selected", color: :error, size: :sm, type: :submit)) %>
    <% end %>

    <% table.column(label: table.toggle_all_button) do |bike| %>
      <%= check_box_tag "bikes_selected[#{bike.id}]", bike.id, false, aria: {label: "Select bike #{bike.id}"}, data: {"table-multi-checkbox-target" => "checkbox"} %>
    <% end %>
  <% end %>

  <% table.column(sortable: "id", label: "Added", classes: "tw:whitespace-nowrap", lower_right: ->(bike) { content_tag(:span, bike.id, class: "only-dev-visible") }) do |bike| %>
    <%= link_to render(UI::Time::Component.new(time: bike.created_at)), edit_admin_bike_url(bike), class: "tw:text-xs" %>
  <% end %>

  <% table.column(sortable: "updated_by_user_at", label: COLUMNS[:updated_cell], classes: "hideableColumn updated_cell tw:text-xs") do |bike| %>
    <%= render UI::Time::Component.new(time: bike.updated_by_user_fallback) %>
  <% end %>

  <% unless @skip_user %>
    <% table.column(sortable: "owner_email", label: COLUMNS[:user_cell], classes: "hideableColumn user_cell") do |bike| %>
      <div class="tw:relative">
        <%# Pass in search_url because caching breaks with url_for %>
        <% search_url = bike.user.present? ? admin_bikes_path(user_id: bike.user.id) : admin_bikes_path(search_email: bike.owner_email) %>
        <%= render Atoms::Admin::TableCells::User::Component.new(email: bike.owner_email, user: bike.user, search_url:, render_search: true) %>

        <% if bike.claimed? %>
          <span
            class="tw:absolute tw:top-0 tw:right-0 <%= UI::Alerts::Base::Component::TEXT_CLASSES[:notice] %>"
            title="<%= bike.type %> is claimed"
            style="cursor: default"
          >
            <%= check_mark %>
          </span>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% table.column(sortable: "manufacturer_id", label: COLUMNS[:manufacturer_cell], classes: "hideableColumn manufacturer_cell") do |bike| %>
    <% if bike.manufacturer_other.present? %>
      <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">
        <%= bike.manufacturer_other %>
      </span>
    <% else %>
      <%= bike.mnfg_name %>
    <% end %>

    <small>
      <%= link_to search_emoji, admin_bikes_path(search_manufacturer: bike.mnfg_name), class: "display-mnfg-link display-sortable-link" %>
    </small>
  <% end %>

  <% table.column(label: COLUMNS[:info_cell], classes: "hideableColumn info_cell") do |bike| %>
    <div>
      <%= render Atoms::Admin::Badges::BikeHiddenExplanation::Component.new(bike:) %>
      <%= [bike.year, bike.frame_model_truncated].join(' ') %>
      <%= "(#{bike.type})" unless bike.type == 'bike' %>

      <% if bike.stolen_recovery? %>
        <small class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:success] %>">
          <%= link_to "recovery!", edit_admin_recovery_url(bike.recovered_records.first.id), class: "twlink-underlined" %>
        </small>
      <% end %>

      <% if bike.thumb_path.present? %>
        <small>📷</small>
      <% end %>

      <span class="tw:hidden tw:text-gray-400 tw:lg:inline">
        <%= bike.frame_colors.to_sentence %>
      </span>

      <% if BikeServices::Displayer.paint_description?(bike) %>
        <small class="tw:hidden tw:text-gray-400 tw:lg:inline">
          <%= link_to bike.paint_description, edit_admin_paint_url(bike.paint) %>
        </small>
      <% end %>

      <span class="tw:float-right">
        <%= render(Atoms::RegistrationStatusBadge::Component.new(bike:, skip_with_owner: true, size: :xs)) %>
      </span>
    </div>
  <% end %>

  <% table.column(label: COLUMNS[:serial_cell], classes: "hideableColumn serial_cell") do |bike| %>
    <small class="tw:text-gray-400"><%= bike.serial_number %></small>
  <% end %>

  <% table.column(label: COLUMNS[:created_by_cell], classes: "hideableColumn created_by_cell") do |bike| %>
    <% if bike.creation_organization.present? %>
      <%= link_to bike.creation_organization.name, admin_organization_path(bike.creation_organization.to_param) %>
      <%= link_to search_emoji, admin_bikes_path(organization_id: bike.creation_organization.to_param), class: "small display-sortable-link" %>
    <% end %>

    <% if bike.creation_kind %>
      <span class="tw:block tw:text-xs tw:text-gray-400">
        <%= render(Atoms::Org::OriginDisplay::Component.new(ownership: bike.current_ownership)) %>

        <% if bike.bulk_import.present? %>
          <%= render(UI::ButtonLink::Component.new(href: admin_bulk_import_path(bike.bulk_import), text: "import", color: :link_gray)) %>
        <% end %>
      </span>
    <% end %>
  <% end %>

  <% table.column(label: COLUMNS[:cred_cell], classes: "hideableColumn cred_cell tw:text-right tw:text-xs") do |bike| %>
    <% if bike.credibility_score.present? %>
      <small
        style="color: <%= helpers.credibility_scorer_color_table(bike.credibility_score) %>;"
      >
        <%= bike.credibility_score %>
      </small>
    <% end %>
  <% end %>
<% end %>
