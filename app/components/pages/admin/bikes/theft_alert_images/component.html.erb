<h3 class="tw:mt-6">
  <%= @bike.type_titleize %> images

  <% if public_images.any? %>
    <%= link_to "user edit", edit_bike_path(@bike, edit_template: "photos", return_to: @return_to),
          class: "twlink tw:ml-2 tw:text-sm" %>
  <% else %>
    <%= render(UI::ButtonLink::Component.new(text: "remove alert", href: regenerate_path(nil),
          method: :put, size: :sm, html_class: "tw:ml-2")) %>
  <% end %>
</h3>

<%# A row that scrolls sideways rather than wrapping - the widths the legacy JS summed %>
<ul class="tw:flex tw:list-none tw:gap-4 tw:overflow-x-auto tw:p-0">
  <% public_images.each do |image| %>
    <li class="tw:w-44 tw:shrink-0 tw:text-center">
      <%= link_to "Delete image", delete_path(image.id), method: :put,
            data: {confirm: "Are you sure you want to delete this image? This can not be undone"},
            class: "#{UI::Alerts::Base::Component::TEXT_CLASSES[:error]} tw:text-sm" %>

      <%= link_to image_tag(image.image_url(:small), class: "tw:mx-auto"), image.image_url, target: "_blank",
            rel: "noopener" %>

      <div class="tw:mt-2">
        <%= render(UI::ButtonLink::Component.new(text: "Regenerate alert using this image",
              href: regenerate_path(image.id), method: :put, size: :sm)) %>
      </div>
    </li>
  <% end %>
</ul>

<h3 class="tw:mt-6">Promoted alert images</h3>

<% if !alert_images? %>
  <div class="tw:mb-4">None</div>
<% else %>
  <ul class="tw:mb-4 tw:flex tw:list-none tw:gap-4 tw:overflow-x-auto tw:p-0">
    <% alert_image_versions.each do |name, image_url| %>
      <li class="tw:w-72 tw:shrink-0 tw:text-center">
        <%= link_to image_tag(image_url, class: "tw:mx-auto"), image_url, target: "_blank", rel: "noopener" %>

        <div class="tw:mt-2"><%= name %></div>
      </li>
    <% end %>
  </ul>
<% end %>
