<%#
  UI::Table instance_execs its cell blocks, so this component's own methods are out of
  reach inside them - each one it needs comes across as a local
%>

<% other_name_search = ->(bike) { other_name_search_path(bike) } %>
<% describe = ->(bike) { description(bike) } %>
<% paint_for = ->(bike) { unmatched_paint(bike) } %>
<% searched_other_name = @searched_other_name %>

<%= render(UI::CardTable::Component.new(records: @bikes,
  column_settings: {storage_key: "adminMissingManufacturerColumns", columns: COLUMNS, defaults: COLUMNS.keys, narrow_hidden: %i[created_by_cell]},
  form: {url: update_manufacturers_admin_bikes_path, method: :post})) do |table| %>
  <% table.with_description do %>
    <div class="tw:flex tw:flex-wrap tw:items-end tw:gap-2">
      <%= render(UI::Forms::Group::Component.new(attribute: :manufacturer_id, label_text: Manufacturer.model_name.human, wrapper_class: "tw:mb-0 tw:min-w-64")) do %>
        <%= render UI::Forms::ComboboxManufacturer::Component.new(frame_maker: true, no_manufacturer_other: true) %>
      <% end %>

      <%= render(UI::Button::Component.new(text: "Update selected", color: :primary, size: :sm, type: :submit)) %>
    </div>
  <% end %>

  <% table.column(label: table.toggle_all_button) do |bike| %>
    <%= check_box_tag "bikes_selected[#{bike.id}]", bike.id, false, aria: {label: "Select bike #{bike.id}"},
          data: {"table-multi-checkbox-target": "checkbox"} %>
  <% end %>

  <% table.column(label: "Date indexed") do |bike| %>
    <%= link_to edit_admin_bike_url(bike), class: "twlink" do %>
      <%= render(UI::Time::Component.new(time: bike.created_at)) %>
    <% end %>

    <span class="twless-strong tw:ml-2">
      <% if bike.example %>
        <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>"><%= bike.id %></span>
      <% else %>
        <%= bike.id %>
      <% end %>
    </span>
  <% end %>

  <% table.column(label: "Manufacturer") do |bike| %>
    <% if bike.manufacturer_other.present? %>
      <%= bike.manufacturer_other %>

      <% if searched_other_name.blank? %>
        <%= link_to "search", other_name_search.call(bike), class: "twlink tw:text-sm" %>
      <% end %>
    <% else %>
      <em class="twless-strong"><%= bike.mnfg_name %></em>
    <% end %>
  <% end %>

  <% table.column(label: COLUMNS[:info_cell], classes: "hideableColumn info_cell") do |bike| %>
    <%= describe.call(bike) %>

    <% if paint_for.call(bike).present? %>
      <div class="twless-strong">
        <%= link_to bike.paint_description, edit_admin_paint_url(bike.paint), class: "twlink" %>
        <%= bike.frame_colors.to_sentence %>
      </div>
    <% end %>

    <span class="tw:ml-2">
      <%= render(Atoms::RegistrationStatusBadge::Component.new(bike:, skip_with_owner: true, size: :xs)) %>
    </span>
  <% end %>

  <% table.column(label: COLUMNS[:created_by_cell], classes: "hideableColumn created_by_cell") do |bike| %>
    <% if bike.creation_organization.present? %>
      <%= link_to bike.creation_organization.name, admin_organization_path(bike.creation_organization), class: "twlink" %>
    <% end %>

    <% if bike.pos? %>
      <span class="twless-strong tw:ml-2">pos</span>
    <% end %>
  <% end %>
<% end %>
