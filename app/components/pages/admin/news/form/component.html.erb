<%= form_for [:admin, @blog], url: admin_news_path(@blog), html: {data: {controller: "admin--news-form"}} do |f| %>
  <%= render(UI::Alerts::ObjectError::Component.new(object: @blog)) %>

  <div class="tw:grid tw:items-start tw:gap-6 tw:lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="tw:flex tw:min-w-0 tw:flex-col tw:gap-6">
      <%= render(UI::Card::Component.new) do %>
        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :title, required: true,
          html_options: {placeholder: "Post title", class: "tw:text-xl tw:font-bold"})) %>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :secondary_title, label_text: "Subtitle",
          html_options: {placeholder: "Shown under the title"})) %>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :body, kind: :text_area, required: true,
          html_options: {rows: 24, class: "tw:font-mono tw:text-sm tw:leading-relaxed"})) do |group| %>
          <% group.with_label_note do %>
            Markdown or HTML &middot;
            <%= link_to "cheat sheet", "https://github.com/adam-p/markdown-here/wiki/Markdown-Cheatsheet", target: "_blank", class: "twlink" %>
          <% end %>
        <% end %>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :description_abbr, kind: :text_area,
          label_text: "Summary", wrapper_class: "",
          html_options: {rows: 2, placeholder: "Shown on the homepage and in link previews"})) do |group| %>
          <% group.with_helper_text do %>
            Leave blank to use the start of the post:
            <em class="less-strong"><%= @blog.body_abbr %></em>
          <% end %>
        <% end %>
      <% end %>

      <%= render(UI::Card::Component.new) do %>
        <%= render(UI::Header::Component.new(text: "Images", tag: :h3, html_class: "tw:mb-1!")) %>

        <p class="less-strong tw:mb-2 tw:text-sm">
          Upload, then paste an image's tag into the body. Pick one as the
          primary image to show it on the homepage.
        </p>

        <label
          class="
            tw:mb-2 tw:inline-flex tw:cursor-pointer tw:items-center
            tw:gap-1 tw:text-sm
          "
        >
          <%= f.radio_button :index_image_id, 0 %> No primary image
        </label>

        <%= render(UI::Forms::Files::UploadMultiple::Component.new(url: public_images_path, file_param: "public_image[image]",
          params: {blog_id: @blog.id}, accept: ImageUploader.permitted_extensions,
          list_html_options: {class: "twwiderow tw:text-left"})) do %>
          <%= render partial: "public_images/admin_public_image", collection: @blog.public_images.with_attached_file, as: :public_image %>
        <% end %>
      <% end %>
    </div>

    <div class="tw:flex tw:flex-col tw:gap-6 tw:lg:sticky tw:lg:top-4">
      <%= render(UI::Card::Component.new) do %>
        <div class="tw:mb-4 tw:flex tw:items-center tw:justify-between tw:gap-2">
          <%= render(UI::Header::Component.new(text: "Publish", tag: :h3, html_class: "tw:mb-0!")) %>
          <%= render(status_badge) %>
        </div>

        <div class="tw:mb-3">
          <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :published, label: "Published")) %>
        </div>

        <div class="tw:mb-3">
          <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :info_kind, checked: @blog.info?,
            html_options: {data: {"admin--news-form-target": "infoKind", action: "change->admin--news-form#kindChanged"}})) do %>
            Info post
            <small class="less-strong tw:block">static content that's updated</small>
          <% end %>
        </div>

        <div
          class="tw:mb-3 <%= info_only_class %>"
          data-admin--news-form-target="infoOnly"
        >
          <small class="less-strong">Info posts are published at the most recent edit time</small>
        </div>

        <div
          class="tw:mb-3 <%= blog_only_class %>"
          data-admin--news-form-target="blogOnly"
        >
          <div data-controller="ui--collapse">
            <div class="tw:text-sm">
              <span class="less-strong">Publish date:</span>
              <%= render(UI::Time::Component.new(time: @blog.published_at)) %>
            </div>

            <div class="tw:mt-1 tw:flex tw:flex-wrap tw:items-center tw:gap-2">
              <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :post_now, label: "Publish now")) %>

              <%= render(UI::Collapse::Component.new(text: "change date", color: :link, html_class: "tw:text-sm")) %>
            </div>

            <div class="tw:mt-2 tw:hidden" data-ui--collapse-target="content">
              <%= f.hidden_field :timezone, value: "", class: "hiddenFieldTimezone" %>

              <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :post_date, kind: :datetime_local_field,
                wrapper_class: "", html_options: {value: post_date, max: Time.current + 1.week, step: 60, required: true})) %>
            </div>
          </div>
        </div>

        <div
          class="
            tw:mt-4 tw:flex tw:gap-2 tw:border-t tw:border-gray-200 tw:pt-4
            tw:dark:border-gray-700
          "
        >
          <%= render(UI::ButtonLink::Component.new(text: "Preview", href: news_url(@blog.to_param), color: :secondary, target: "_blank")) %>
          <%= render(UI::Button::Component.new(text: "Save", color: :primary, type: "submit", html_class: "tw:grow")) %>
        </div>
      <% end %>

      <%= render(UI::Card::Component.new) do %>
        <%= render(UI::Header::Component.new(text: "Details", tag: :h3, html_class: "tw:mb-3!")) %>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :content_tag_names, label_text: "Tags",
          required: true)) do |group| %>
          <% group.with_label_note { "at least one" } %>

          <%= render UI::Forms::Combobox::Component.new(name: :content_tag_names, options: content_tag_options,
            dialog_label: "Tags", multiselect_chip_src: content_tag_chips_admin_news_index_path,
            html_options: {form: f, placeholder: "Add tag", required: true}) %>
        <% end %>

        <div
          class="<%= blog_only_class %>"
          data-admin--news-form-target="blogOnly"
        >
          <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :user_email, label_text: "Author email",
            required: true)) do |group| %>
            <% if author_needs_personal_page? %>
              <% group.with_helper_text do %>
                Please
                <%= link_to "turn on your personal page", edit_my_account_url, target: "_blank", class: "twlink" %>,
                or link your twitter!
              <% end %>
            <% end %>

            <%= render(UI::Forms::Email::Component.new(form_builder: f, attribute: :user_email, required: true,
              html_options: {placeholder: "your email", value: @blog.user.email,
                             "aria-describedby" => (group.helper_text_id if author_needs_personal_page?)})) %>
          <% end %>
        </div>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :language, wrapper_class: "")) do %>
          <%= render(UI::Forms::Select::Component.new(form_builder: f, attribute: :language,
            option_tags: helpers.language_choices)) %>
        <% end %>
      <% end %>

      <div
        class="<%= blog_only_class %>"
        data-admin--news-form-target="blogOnly"
      >
        <%= render(UI::Card::Component.new) do %>
          <div data-controller="ui--collapse">
            <%= render(UI::Collapse::Component.new(text: "Advanced", chevron: true, color: :link_gray)) %>

            <div class="tw:mt-3 tw:hidden" data-ui--collapse-target="content">
              <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :canonical_url,
                label_text: "Canonical URL")) do |group| %>
                <% group.with_helper_text { "If this was first published elsewhere, e.g. https://blogspot.com/post/1" } %>
              <% end %>

              <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :update_title, label: "Update URL to match the title")) %>
              <small class="tw:block <%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">This will break existing links!</small>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
