<div data-controller="admin--news-form">
  <%= render(UI::Card::Component.new) do %>
    <div class="twwiderow">
      <div data-controller="ui--collapse">
        <div class="tw:grid tw:gap-x-8 tw:sm:grid-cols-2">
          <div class="tw:mb-4">
            <%= render(UI::Forms::Checkbox::Component.new(form_builder: @form_builder, attribute: :published, label: "Published")) %>

            <div
              class="<%= info_only_class %>"
              data-admin--news-form-target="infoOnly"
            >
              <small class="twless-strong">info posts are published at the most recent edit time</small>
            </div>
          </div>

          <% unless @blog.listicle? %>
            <div class="tw:mb-4">
              <%= render(UI::Forms::Checkbox::Component.new(form_builder: @form_builder, attribute: :info_kind, checked: @blog.info?,
                html_options: {data: {"admin--news-form-target": "infoKind", action: "change->admin--news-form#kindChanged"}})) do %>
                Info post
                <small class="twless-strong">static content that's updated</small>
              <% end %>
            </div>
          <% end %>

          <div
            class="tw:mb-4 <%= blog_only_class %>"
            data-admin--news-form-target="blogOnly"
          >
            <span class="twless-strong">Publish Date:</span>
            <%= render(UI::Time::Component.new(time: @blog.published_at)) %>
          </div>

          <div
            class="<%= blog_only_class %>"
            data-admin--news-form-target="blogOnly"
          >
            <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2">
              <%= render(UI::Forms::Checkbox::Component.new(form_builder: @form_builder, attribute: :post_now, label: "Publish now")) %>

              <%= render(UI::Collapse::Component.new(text: "manually edit date", color: :link, html_class: "tw:text-sm")) %>
            </div>
          </div>
        </div>

        <div class="tw:hidden" data-ui--collapse-target="content">
          <%= @form_builder.hidden_field :timezone, value: "", class: "hiddenFieldTimezone" %>

          <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :post_date, kind: :datetime_local_field,
            html_options: {value: post_date, max: Time.current + 1.week, step: 60, required: true})) %>
        </div>
      </div>

      <div>
        <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :content_tag_names, label_text: "Tags",
          required: true)) do |group| %>
          <% group.with_label_note { "at least one required" } %>

          <%= render UI::Forms::Combobox::Component.new(name: :content_tag_names, options: content_tag_options,
            dialog_label: "Tags", multiselect_chip_src: content_tag_chips_admin_news_index_path,
            html_options: {form: @form_builder, placeholder: "Add tag", required: true}) %>
        <% end %>
      </div>

      <div
        class="<%= blog_only_class %>"
        data-admin--news-form-target="blogOnly"
      >
        <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :user_email, label_text: "Author email",
          required: true)) do |group| %>
          <% if author_needs_personal_page? %>
            <% group.with_helper_text do %>
              Please
              <%= link_to "turn on your personal page", edit_my_account_url, target: "_blank" %>,
              or link your twitter!
            <% end %>
          <% end %>

          <%= render(UI::Forms::Email::Component.new(form_builder: @form_builder, attribute: :user_email, required: true,
            html_options: {placeholder: "your email", value: @blog.user.email,
                           "aria-describedby" => (group.helper_text_id if author_needs_personal_page?)})) %>
        <% end %>
      </div>

      <div
        class="<%= blog_only_class %>"
        data-admin--news-form-target="blogOnly"
      >
        <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :canonical_url,
          label_text: "Canonical URL")) do |group| %>
          <% group.with_label_note { "(e.g. https://blogspot.com/post/1)" } %>
        <% end %>
      </div>
    </div>

    <div class="twwiderow tw:mt-2">
      <div class="tw:mb-4">
        <label>
          <%= @form_builder.radio_button :index_image_id, 0 %> No primary image
          <small class="twless-strong">Otherwise, select a primary image with the radio button next to the image</small>
        </label>
      </div>

      <div
        class="tw:mb-4 <%= blog_only_class %>"
        data-admin--news-form-target="blogOnly"
      >
        <%= render(UI::Forms::Checkbox::Component.new(form_builder: @form_builder, attribute: :update_title, label: "Update URL")) %>

        <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">This will break existing links!</span>
      </div>
    </div>

    <div class="twwiderow tw:mt-2">
      <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :title, required: true,
        html_options: {placeholder: "Blog title"})) %>

      <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :secondary_title)) %>
    </div>

    <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :description_abbr,
      label_text: "Abbreviated description",
      html_options: {placeholder: "Description/subtitle shown on the homepage - will be the text below unless you enter something."})) do |group| %>
      <% group.with_helper_text do %>
        Default: <em class="twless-strong"><%= @blog.body_abbr %></em>
      <% end %>
    <% end %>

    <div class="tw:mt-2 tw:grid tw:grid-cols-2 tw:gap-x-8 tw:sm:grid-cols-4">
      <div class="tw:col-span-2 tw:sm:col-span-1">
        <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :language)) do %>
          <%= render(UI::Forms::Select::Component.new(form_builder: @form_builder, attribute: :language,
            option_tags: helpers.language_choices)) %>
        <% end %>
      </div>

      <div>
        <%= render(UI::ButtonLink::Component.new(text: "Preview", href: news_url(@blog.to_param), target: "_blank")) %>
      </div>

      <div class="tw:text-right tw:sm:col-span-2">
        <%= render(UI::Button::Component.new(text: "Save", color: :primary, type: "submit")) %>
      </div>
    </div>
  <% end %>
</div>
