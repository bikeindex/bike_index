<%= render(Pages::Admin::Headers::Nav::Component.new(title: index_title)) do |nav| %>
  <% nav_items.each do |nav_item| %>
    <% nav.with_item { nav_item.to_s } %>
  <% end %>

  <% if show_deleted_link? %>
    <% nav.with_item do %>
      <%= render(UI::Dropdown::Component.new(
        name: deleted_label,
        button_size: :sm,
        active: deleted_active?
      )) do |dropdown|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Only not deleted", path: url_for(sortable_search_params.merge(search_deleted: nil)), match_params: {search_deleted: nil}) }
        dropdown.with_entry_divider
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Including deleted", path: url_for(sortable_search_params.merge(search_deleted: "including")), match_params: {search_deleted: "including"}) }
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Only deleted", path: url_for(sortable_search_params.merge(search_deleted: "only")), match_params: {search_deleted: "only"}) }
      end %>
    <% end %>
  <% end %>

  <% unless @skip_charting %>
    <% nav.with_item do %>
      <%= render(UI::ButtonLink::Component.new(text: "graph", size: :sm, active: @index.render_chart,
            href: url_for(sortable_search_params.merge(render_chart: !@index.render_chart)))) %>
    <% end %>
  <% end %>
<% end %>

<%= render(index_info_component) %>

<%= @header_content %>

<% if show_chart? %>
  <% if @rendered_chart.nil? %>
    <%= default_chart %>
  <% else %>
    <%= @rendered_chart %>
  <% end %>
<% end %>

<div class="tw:mt-2 tw:mb-6 tw:flex tw:justify-end">
  <%= render UI::PeriodSelect::Component.new(period: @index.period, start_time: @index.start_time, end_time: @index.end_time, sortable_search_params:) %>
</div>

<% if @admin_search_form.present? %>
  <%= @admin_search_form %>
<% end %>

<%= render(pagination_component) %>

<%= @table_view || default_table_view %>

<%= render(pagination_component(skip_total: true)) %>
