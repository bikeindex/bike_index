<%# locals, because the cell blocks below are instance_exec'd and can't see the component's ivars %>
<% render_search = @render_search %>
<% sort_state = @sort_state %>

<%= render(UI::Table::Component.new(records: @b_params, render_sortable: @render_sortable, sort_state: @sort_state)) do |table| %>
  <% table.column(sortable: "created_at") do |b_param| %>
    <%= link_to admin_b_param_path(b_param.id), class: "twlink" do %>
      <%= render UI::Time::Component.new(time: b_param.created_at, format: :localize_time_precise) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |b_param| %>
    <%= render UI::Time::Component.new(time: b_param.updated_at, format: :localize_time_precise) %>
  <% end %>

  <% table.column(sortable: "email") do |b_param| %>
    <%= b_param.email %>
  <% end %>

  <% table.column(sortable: "creator_id") do |b_param| %>
    <%= render Pages::Admin::Users::Cell::Component.new(user: b_param.creator, user_id: b_param.creator_id, sort_state:) %>
  <% end %>

  <% table.column(sortable: "created_bike_id", label: "Bike") do |b_param| %>
    <% if b_param.created_bike_id.present? %>
      <%= link_to b_param.created_bike_id, admin_bike_path(b_param.created_bike_id), class: "twlink" %>
    <% end %>
  <% end %>

  <% table.column(sortable: "origin") do |b_param| %>
    <small><%= b_param.origin&.humanize %></small>
  <% end %>

  <% table.column(label: "Organization") do |b_param| %>
    <%= render Pages::Admin::Organizations::Cell::Component.new(organization: b_param.organization, organization_id: b_param.organization_id, sort_state:, render_search:) %>
  <% end %>

  <% table.column(label: "Errors") do |b_param| %>
    <% if b_param.bike_errors.present? %>
      <small class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">
        <%= Array(b_param.bike_errors).map { |error| error.to_s.humanize }.to_sentence %>
      </small>
    <% end %>
  <% end %>

  <% table.column(label: "Data") do |b_param| %>
    <%= render UI::JsonDisplay::Component.new(data: b_param.params, max_width: 450, small: true) %>
  <% end %>
<% end %>
