<div
  class="tw:group/membership tw:bg-white tw:text-gray-500"
  data-controller="memberships--new"
>
  <section class="tw:border-b tw:border-gray-200">
    <div
      class="
        tw:mx-auto tw:flex tw:max-w-6xl tw:flex-col tw:gap-10 tw:px-5
        tw:pt-8 tw:pb-8 tw:lg:flex-row tw:lg:items-center tw:lg:gap-16
        tw:lg:px-14 tw:lg:pt-16 tw:lg:pb-14
      "
    >
      <div class="tw:flex tw:min-w-0 tw:flex-1 tw:flex-col tw:gap-5">
        <p class="tw:m-0 tw:text-purple-500 <%= eyebrow_classes %>">
          <%= translation(".bike_index_membership") %>
        </p>

        <h1
          class="
            tw:m-0 tw:font-header tw:text-[36px] tw:leading-[1.04]
            tw:font-extrabold tw:tracking-tight tw:text-slate-900
            tw:sm:text-[44px] tw:lg:text-[54px]
          "
        >
          <%= translation(".keep_bike_index_free") %>
        </h1>

        <p
          class="
            tw:m-0 tw:max-w-150 tw:text-base tw:leading-[1.55]
            tw:lg:text-[19px]
          "
        >
          <%= translation(".lede") %>
        </p>

        <div
          class="
            tw:mt-2 tw:flex tw:flex-col tw:gap-3.5 tw:sm:flex-row
            tw:sm:items-center tw:sm:gap-5
          "
        >
          <%= render(UI::ButtonLink::Component.new(href: "#membership-plans", text: translation(".become_a_member"),
            color: :primary, size: :callout, data: {action: "memberships--new#scrollToPlans"})) %>

          <span class="tw:text-[15px]">
            <%= translation(".plans_from", price: price(:basic, :monthly)) %>
          </span>
        </div>

        <p
          class="
            tw:m-0 tw:flex tw:max-w-150 tw:items-start tw:gap-2
            tw:text-[14.5px]
          "
        >
          <%= helpers.inline_svg_tag("icons/badge-check.svg", class: "tw:mt-0.5 tw:size-4.5 tw:shrink-0 tw:text-green-700", aria_hidden: true) %>
          <%= translation(".tax_deductible_ein") %>
        </p>
      </div>

      <dl
        class="
          tw:m-0 tw:grid tw:grid-cols-2 tw:gap-x-8 tw:gap-y-7 tw:lg:w-95
          tw:lg:shrink-0
        "
      >
        <% stats.each do |stat| %>
          <div class="tw:flex tw:flex-col tw:border-t-3 tw:border-blue-600 tw:pt-3.5">
            <dt class="tw:text-[14.5px] tw:font-normal">
              <%= stat[:label] %>
            </dt>

            <dd
              class="
                tw:order-first tw:m-0 tw:font-header tw:text-[26px]
                tw:font-extrabold tw:text-slate-900 tw:lg:text-[32px]
              "
            >
              <%= stat[:value] %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>

  <section
    id="membership-plans"
    class="tw:scroll-mt-10 tw:border-b tw:border-gray-200 tw:bg-gray-50"
    data-memberships--new-target="plans"
  >
    <%= form_for @membership, url: membership_path, method: :post,
      html: {class: "#{section_inner} tw:flex tw:flex-col tw:gap-7",
             data: {action: "change->memberships--new#update"}} do |f| %>
      <%= hidden_field_tag :currency, @currency.slug %>
      <%= hidden_field_tag :referral_source, @referral_source %>

      <div
        class="
          tw:flex tw:flex-col tw:gap-4 tw:md:flex-row tw:md:items-end
          tw:md:justify-between
        "
      >
        <div>
          <h2 id="membership-plans-heading" class="<%= h2_classes %>">
            <%= translation(".choose_your_membership") %>
          </h2>

          <p class="tw:m-0 tw:mt-2 tw:text-[17px]">
            <%= translation(".every_tier_keeps_it_free") %>
          </p>
        </div>

        <%= render(UI::Forms::RadioButtonGroup::Component.new(name: "membership[set_interval]",
          entries: interval_entries, selected: selected_interval, kind: :toggle)) %>
      </div>

      <div
        class="tw:grid tw:gap-5 tw:md:grid-cols-3"
        role="radiogroup"
        aria-labelledby="membership-plans-heading"
      >
        <% tiers.each do |tier| %>
          <% level = tier[:level] %>

          <label
            class="
              tw:group/tier tw:mb-0 tw:flex tw:cursor-pointer tw:flex-col
              tw:gap-4 tw:rounded-lg tw:border tw:border-gray-200
              tw:bg-white tw:p-6.5 tw:font-normal tw:transition-all
              tw:duration-300 tw:hover:-translate-y-1.25
              tw:hover:shadow-[0_10px_30px_rgba(44,62,80,.16)]
              tw:has-checked:border-2 tw:has-checked:border-blue-600
              tw:has-checked:p-6.25
              tw:has-checked:shadow-[0_4px_12px_rgba(44,62,80,.12)]
              tw:has-[:focus-visible]:ring-3
              tw:has-[:focus-visible]:ring-blue-500/40
            "
          >
            <%= f.radio_button :level, level, class: "tw:sr-only",
              data: {labels: interval_labels(level)} %>

            <span class="tw:flex tw:items-center tw:gap-2.5">
              <span
                class="
                  tw:font-header tw:text-[22px] tw:font-extrabold
                  tw:text-slate-900
                "
              >
                <%= level_name(level) %>
              </span>

              <% if tier[:recommended] %>
                <span class="tw:tracking-wider tw:uppercase">
                  <%= render(UI::Badge::Component.new(text: translation(".recommended"), color: :yellow, size: :xs)) %>
                </span>
              <% end %>

              <span
                class="
                  tw:ml-auto tw:flex tw:size-6 tw:shrink-0 tw:items-center
                  tw:justify-center tw:rounded-full tw:border-[1.5px]
                  tw:border-gray-300 tw:bg-white tw:text-white
                  tw:group-has-checked/tier:border-blue-600
                  tw:group-has-checked/tier:bg-blue-600
                "
                aria-hidden="true"
              >
                <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:size-3.5", aria_hidden: true) %>
              </span>
            </span>

            <span class="tw:flex tw:items-baseline tw:gap-1.5">
              <span
                class="
                  tw:font-header tw:text-[40px] tw:leading-none
                  tw:font-extrabold tw:tracking-tight tw:text-slate-900
                  tw:group-has-checked/tier:text-blue-600
                "
              >
                <span class="<%= MONTHLY_ONLY %>"><%= price(level, :monthly) %></span>
                <span class="<%= YEARLY_ONLY %>"><%= price(level, :yearly) %></span>
              </span>

              <span class="tw:text-[15px]">
                <span class="<%= MONTHLY_ONLY %>"><%= translation(".per_month") %></span>
                <span class="<%= YEARLY_ONLY %>"><%= translation(".per_year") %></span>
              </span>
            </span>

            <span
              class="
                tw:-mt-3 tw:block tw:min-h-5 tw:text-[13.5px] tw:font-bold
                tw:text-green-700
              "
            >
              <span class="<%= YEARLY_ONLY %>"><%= translation(".two_months_free") %></span>
            </span>

            <ul
              class="
                tw:m-0 tw:flex tw:list-none tw:flex-col tw:gap-2.75
                tw:border-t tw:border-gray-200 tw:p-0 tw:pt-4
              "
            >
              <% tier[:perks].each do |perk| %>
                <li
                  class="
                    tw:flex tw:gap-2.5 tw:text-[15px] tw:leading-normal
                    tw:text-gray-700
                  "
                >
                  <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:mt-0.5 tw:size-4.5 tw:shrink-0 tw:text-blue-600", aria_hidden: true) %>
                  <%= perk %>
                </li>
              <% end %>
            </ul>
          </label>
        <% end %>
      </div>

      <div
        class="
          tw:flex tw:flex-col tw:gap-4 tw:rounded-lg tw:border
          tw:border-gray-200 tw:bg-white tw:px-6.5 tw:py-5.5 tw:md:flex-row
          tw:md:items-center tw:md:gap-7
        "
      >
        <div class="tw:flex-1">
          <p
            class="tw:m-0 tw:text-[17px] tw:font-extrabold tw:text-slate-900"
            data-memberships--new-target="summary"
          >
            <%= summary_label(selected_level, selected_interval) %>
          </p>

          <p class="tw:m-0 tw:mt-1 tw:text-sm">
            <%= translation(".tax_deductible_cancel_any_time") %>
          </p>
        </div>

        <%= render(UI::Button::Component.new(color: :primary, size: :callout, type: "submit", html_class: "tw:shrink-0")) do %>
          <span data-memberships--new-target="join">
            <%= join_label(selected_level, selected_interval) %>
          </span>
        <% end %>
      </div>

      <%= link_to(translation(".or_make_a_one_time_donation"), donate_path,
        class: "twlink tw:self-start tw:text-[15px] tw:font-bold") %>
    <% end %>
  </section>

  <section class="tw:border-b tw:border-gray-200">
    <div class="tw:grid tw:gap-12 tw:lg:grid-cols-2 <%= section_inner %>">
      <div class="tw:flex tw:flex-col tw:gap-4.5">
        <p class="tw:m-0 tw:text-blue-600 <%= eyebrow_classes %>">
          <%= translation(".keeps_free") %>
        </p>

        <h2 class="<%= h3_classes %>">
          <%= translation(".the_registry_open_to_everyone") %>
        </h2>

        <% keeps_free.each do |row| %>
          <div class="tw:flex tw:gap-4">
            <span
              class="
                tw:flex tw:size-10 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-full tw:text-white
                <%= row[:circle] %>
              "
            >
              <%= helpers.inline_svg_tag(row[:icon], class: "tw:size-5", aria_hidden: true) %>
            </span>

            <div>
              <h3 class="tw:m-0 tw:text-[17px] tw:font-extrabold tw:text-slate-900">
                <%= row[:title] %>
              </h3>

              <p class="tw:m-0 tw:mt-1 tw:text-[15px] tw:leading-[1.55]">
                <%= row[:body] %>
              </p>
            </div>
          </div>
        <% end %>
      </div>

      <div class="tw:flex tw:flex-col tw:gap-4.5">
        <p class="tw:m-0 tw:text-purple-500 <%= eyebrow_classes %>">
          <%= translation(".builds_next") %>
        </p>

        <h2 class="<%= h3_classes %>">
          <%= translation(".new_tools_for_bike_owners") %>
        </h2>

        <ul class="tw:m-0 tw:list-none tw:border-t tw:border-gray-200 tw:p-0">
          <% builds_next.each do |row| %>
            <li
              class="
                tw:flex tw:items-center tw:gap-4 tw:border-b
                tw:border-gray-200 tw:py-3.5
              "
            >
              <div class="tw:flex-1">
                <h3 class="tw:m-0 tw:text-base tw:font-extrabold tw:text-slate-900">
                  <%= row[:title] %>
                </h3>

                <p class="tw:m-0 tw:text-sm"><%= row[:body] %></p>
              </div>

              <span class="tw:tracking-wider tw:uppercase">
                <% if row[:live] %>
                  <%= render(UI::Badge::Component.new(text: translation(".live"), color: :success, size: :xs)) %>
                <% else %>
                  <%= render(UI::Badge::Component.new(text: translation(".next"), color: :purple, size: :xs)) %>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </section>

  <% if @recovery_displays.any? %>
    <section class="tw:border-b tw:border-gray-200 tw:bg-gray-50">
      <div class="<%= section_inner %>">
        <div
          class="
            tw:flex tw:flex-wrap tw:items-end tw:justify-between tw:gap-x-6
            tw:gap-y-1
          "
        >
          <div>
            <h2 class="<%= h2_classes %>">
              <%= translation(".what_members_make_possible") %>
            </h2>

            <p class="tw:m-0 tw:mt-1 tw:text-[17px]">
              <%= translation(".recoveries_reported_by_owners") %>
            </p>
          </div>

          <%= link_to(translation(".read_more_recovery_stories"), recovery_stories_path,
            class: "twlink tw:text-[15.5px] tw:font-bold") %>
        </div>

        <ul
          class="
            tw:m-0 tw:mt-6 tw:grid tw:list-none tw:gap-4 tw:p-0
            tw:sm:grid-cols-2 tw:lg:grid-cols-4
          "
        >
          <% @recovery_displays.each do |recovery_display| %>
            <%= render(Atoms::RecoveryDisplayCard::Component.new(recovery_display:)) %>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <section class="tw:border-b tw:border-gray-200">
    <div class="tw:mx-auto tw:max-w-6xl tw:px-5 tw:py-8 tw:lg:px-14 tw:lg:py-11">
      <h2 class="tw:m-0 tw:text-center tw:text-[15px] tw:font-bold tw:text-slate-900">
        <%= translation(".official_registry") %>
      </h2>

      <ul
        class="
          tw:m-0 tw:mt-6 tw:grid tw:list-none tw:grid-cols-3 tw:gap-6 tw:p-0
          tw:lg:grid-cols-6
        "
      >
        <% partner_logos.each do |file, name| %>
          <li>
            <%= image_tag("landing_pages/partners/#{file}", alt: name,
              class: "tw:h-16 tw:w-full tw:object-contain", loading: "lazy") %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <section class="tw:border-b tw:border-gray-200 tw:bg-gray-50">
    <div class="tw:flex tw:flex-col tw:gap-8 tw:lg:flex-row tw:lg:gap-12 <%= section_inner %>">
      <div class="tw:lg:w-85 tw:lg:shrink-0">
        <p class="tw:m-0 tw:text-purple-500 <%= eyebrow_classes %>">
          <%= translation(".member_gear") %>
        </p>

        <h2 class="tw:mt-2 <%= h2_classes %>">
          <%= translation(".wear_the_shield") %>
        </h2>

        <p class="tw:m-0 tw:mt-3 tw:text-base tw:leading-relaxed">
          <%= translation(".member_gear_body") %>
        </p>
      </div>

      <ul
        class="
          tw:m-0 tw:grid tw:flex-1 tw:list-none tw:gap-5 tw:p-0
          tw:sm:grid-cols-2
        "
      >
        <% gear.each do |item| %>
          <li
            class="
              tw:overflow-hidden tw:rounded-lg tw:border tw:border-gray-200
              tw:bg-white
            "
          >
            <%= image_tag(item[:src], alt: item[:name],
              class: "tw:h-65 tw:w-full tw:bg-gray-100 tw:object-cover", loading: "lazy") %>

            <div
              class="
                tw:flex tw:items-center tw:justify-between tw:gap-3 tw:px-4
                tw:py-3.5
              "
            >
              <span class="tw:text-[15px] tw:font-extrabold tw:text-slate-900">
                <%= item[:name] %>
              </span>

              <span class="tw:tracking-wider tw:uppercase">
                <%= render(UI::Badge::Component.new(text: level_name(item[:level]), color: :purple)) %>
              </span>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <section class="tw:border-b tw:border-gray-200">
    <div class="tw:flex tw:flex-col tw:gap-4 tw:lg:flex-row tw:lg:gap-14 <%= section_inner %>">
      <h2 class="tw:lg:w-85 tw:lg:shrink-0 <%= h2_classes %>">
        <%= translation(".questions") %>
      </h2>

      <div class="tw:flex-1 tw:border-t tw:border-gray-200">
        <% faqs.each_with_index do |(question, answer), index| %>
          <%= tag.details(name: "membership-faq", open: index.zero?, class: "tw:group tw:border-b tw:border-gray-200") do %>
            <summary
              class="
                tw:flex tw:cursor-pointer tw:list-none tw:items-center
                tw:justify-between tw:gap-4 tw:px-2 tw:py-4.5 tw:text-[17px]
                tw:font-bold tw:text-slate-900 tw:hover:bg-gray-50
                tw:[&::-webkit-details-marker]:hidden
              "
            >
              <%= question %>

              <%= render(UI::IconChevron::Component.new(direction: :down, size: :md,
                html_class: "tw:shrink-0 tw:text-blue-600 tw:transition-transform tw:group-open:-rotate-90")) %>
            </summary>

            <p
              class="
                tw:m-0 tw:max-w-160 tw:px-2 tw:pb-5 tw:text-[15.5px]
                tw:leading-relaxed
              "
            >
              <%= answer %>
            </p>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="tw:bg-blue-600 tw:text-white">
    <div
      class="
        tw:mx-auto tw:flex tw:max-w-6xl tw:flex-col tw:gap-6 tw:px-5 tw:py-8
        tw:md:flex-row tw:md:items-center tw:md:gap-9 tw:lg:px-14
        tw:lg:py-11
      "
    >
      <%= image_tag("membership/bike-love.png", alt: "", class: "tw:hidden tw:w-30 tw:shrink-0 tw:md:block") %>

      <h2
        class="
          tw:m-0 tw:flex-1 tw:font-header tw:text-[22px] tw:font-extrabold
          tw:text-white tw:lg:text-[32px]
        "
      >
        <%= translation(".members_keep_it_free") %>
      </h2>

      <%= render(UI::ButtonLink::Component.new(href: "#membership-plans", color: :yellow, size: :callout,
        html_class: "tw:shrink-0", data: {action: "memberships--new#scrollToPlans"})) do %>
        <span data-memberships--new-target="join">
          <%= join_label(selected_level, selected_interval) %>
        </span>
      <% end %>
    </div>
  </section>
</div>
