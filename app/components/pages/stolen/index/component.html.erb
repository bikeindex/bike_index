<section class="tw:border-b tw:border-gray-200">
  <div class="tw:flex tw:flex-col tw:gap-6 tw:pt-7 tw:pb-6 tw:lg:flex-row tw:lg:gap-14 tw:lg:pt-13 tw:lg:pb-12 <%= SharedBlocks::Marketing::Wrapper::Component::CONTAINER_CLASSES %>">
    <div class="tw:flex tw:min-w-0 tw:flex-1 tw:flex-col tw:gap-3.5 tw:lg:gap-5">
      <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-3">
        <span class="tw:tracking-wider tw:uppercase">
          <%= render(UI::Badge::Component.new(text: translation(".bike_stolen"), color: :error, size: :lg, indicator: true)) %>
        </span>

        <span class="tw:text-xs tw:text-gray-500">
          <%= translation(".act_in_the_first_24_hours") %>
        </span>
      </div>

      <h1
        class="
          tw:m-0 tw:font-header tw:text-[32px] tw:leading-[1.07]
          tw:font-extrabold tw:tracking-tight tw:sm:text-[44px]
          tw:lg:text-[54px] tw:lg:leading-[1.03]
        "
      >
        <%= translation(".your_bike_is_gone") %>
        <br class="tw:hidden tw:sm:inline">
        <%= translation(".here_is_the_next_hour") %>
      </h1>

      <p
        class="
          tw:m-0 tw:max-w-160 tw:text-base tw:leading-normal
          tw:text-gray-500 tw:lg:text-[19px]
        "
      >
        <%= translation(".lede_register_first") %>
      </p>

      <div
        class="
          tw:flex tw:flex-col tw:gap-3.5 tw:sm:flex-row tw:sm:flex-wrap
          tw:sm:items-center
        "
      >
        <%= render(UI::ButtonLink::Component.new(href: register_stolen_path,
            text: translation(".register_your_stolen_bike_free"), color: :primary, size: :callout)) %>

        <%= render(UI::ButtonLink::Component.new(href: search_registrations_path,
            text: translation(".search_the_registry"), color: :purple,
            html_class: "#{PILL} tw:px-6! tw:py-3.5! tw:text-[15.5px]! tw:border-2! tw:bg-white! tw:text-purple-500! tw:hover:bg-purple-500! tw:hover:text-white!")) %>
      </div>

      <p class="tw:m-0 tw:text-[14.5px] tw:text-gray-500">
        <%= translation(".no_account_yet") %>
      </p>
    </div>

    <div
      class="
        tw:-mx-5 tw:-mb-6 tw:flex tw:flex-col tw:gap-4 tw:border-t
        tw:border-gray-200 tw:bg-gray-50 tw:px-5 tw:py-4 tw:lg:m-0
        tw:lg:w-75 tw:lg:shrink-0 tw:lg:self-start tw:lg:rounded-lg
        tw:lg:border tw:lg:p-5.5
      "
    >
      <h2 class="tw:m-0 <%= SharedBlocks::Marketing::SectionHeading::Component.eyebrow_classes(:gray) %>">
        <%= translation(".recovery_record") %>
      </h2>

      <%= render(SharedBlocks::Marketing::NumberBlocks::Component.new(items: stats, layout: :stack_from_lg)) %>
    </div>
  </div>
</section>

<section class="tw:border-b tw:border-gray-200 tw:bg-gray-50">
  <div class="<%= section_inner %>">
    <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(heading: translation(".the_first_24_hours"), intro: translation(".work_top_to_bottom"),
      html_class: "tw:mb-4 tw:lg:mb-6")) %>

    <ol class="tw:m-0 tw:flex tw:list-none tw:flex-col tw:gap-2.5 tw:p-0 tw:lg:gap-3">
      <% steps.each_with_index do |step, index| %>
        <% priority = index < 3 %>

        <li
          class="
            tw:flex tw:gap-4.5 tw:rounded-lg tw:border tw:p-4 tw:transition-colors tw:lg:items-center tw:lg:px-5.5 tw:lg:py-5
            <%= step_classes(priority) %>
          "
        >
          <span
            class="
              tw:hidden tw:w-8.5 tw:shrink-0 tw:self-start tw:font-header
              tw:text-xl tw:font-extrabold tw:text-gray-500 tw:lg:block
            "
            aria-hidden="true"
          >
            <%= number_display(index + 1) %>
          </span>

          <div
            class="
              tw:flex tw:min-w-0 tw:flex-1 tw:flex-col tw:gap-2.5
              tw:lg:flex-row tw:lg:items-center tw:lg:gap-6
            "
          >
            <div class="tw:min-w-0 tw:flex-1">
              <h3
                class="
                  tw:m-0 tw:flex tw:flex-wrap tw:items-center tw:gap-x-2.5
                  tw:gap-y-1 tw:font-header tw:text-[17px] tw:font-extrabold
                  tw:lg:text-[21px]
                "
              >
                <span>
                  <span class="tw:lg:sr-only"><%= number_display(index + 1) %>.</span>
                  <%= step[:title] %>
                </span>

                <span class="tw:hidden tw:font-sans tw:uppercase tw:sm:inline-flex">
                  <%= render(UI::Badge::Component.new(text: step[:tag], color: priority ? :notice : :gray)) %>
                </span>
              </h3>

              <% Array(step[:body]).each do |paragraph| %>
                <p
                  class="
                    tw:m-0 tw:mt-1.5 tw:max-w-190 tw:text-[14.5px]
                    tw:leading-[1.55] tw:text-gray-500 tw:lg:text-base
                  "
                >
                  <%= paragraph %>
                </p>
              <% end %>
            </div>

            <div class="tw:shrink-0">
              <%= render(step_action(step, priority)) %>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<section class="tw:border-b tw:border-gray-200">
  <div class="<%= section_inner %>">
    <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(heading: translation(".why_registering_changes_the_odds"),
      intro: translation(".why_registering_subhead"), html_class: "tw:mb-4 tw:max-w-190 tw:lg:mb-6")) %>

    <div class="tw:grid tw:gap-3 tw:md:grid-cols-3 tw:md:gap-4.5">
      <% pillars.each do |pillar| %>
        <%= render(SharedBlocks::Marketing::IconFeature::Component.new(**pillar, card: true)) %>
      <% end %>
    </div>

    <div
      class="
        tw:mt-4.5 tw:flex tw:flex-col tw:items-start tw:gap-4 tw:rounded-lg
        tw:border tw:border-gray-200 tw:bg-purple-100 tw:p-4 tw:lg:flex-row
        tw:lg:items-center tw:lg:gap-7.5 tw:lg:p-6.5
      "
    >
      <div class="tw:flex-1">
        <div class="<%= SharedBlocks::Marketing::SectionHeading::Component.eyebrow_classes(:purple) %>">
          <%= translation(".promoted_alerts") %>
        </div>

        <h3
          class="
            tw:m-0 tw:mt-1.5 tw:font-header tw:text-[19px] tw:font-extrabold
            tw:lg:text-[26px]
          "
        >
          <%= translation(".promoted_alerts_title") %>
        </h3>

        <p
          class="
            tw:m-0 tw:mt-2 tw:max-w-190 tw:text-[14.5px] tw:text-gray-700
            tw:lg:text-base
          "
        >
          <%= translation(".promoted_alerts_body") %>
        </p>
      </div>

      <%= render(UI::ButtonLink::Component.new(href: promoted_alerts_path,
          text: translation(".how_alerts_work"), color: :purple, size: :callout, html_class: "tw:shrink-0")) %>
    </div>
  </div>
</section>

<section class="tw:bg-gray-50">
  <div class="<%= section_inner %>">
    <%= render(SharedBlocks::Marketing::RecoveryStories::Component.new(heading: translation(".bikes_that_came_home"),
      recovery_displays: @recovery_displays)) %>
  </div>
</section>

<section class="tw:bg-gray-50">
  <div class="tw:flex tw:flex-col tw:gap-10 tw:pt-6 tw:pb-6 tw:lg:flex-row tw:lg:pt-2.5 tw:lg:pb-12 <%= SharedBlocks::Marketing::Wrapper::Component::CONTAINER_CLASSES %>">
    <div class="tw:flex-1">
      <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(heading: translation(".questions_people_ask_at_2am"), html_class: "tw:mb-2")) %>

      <div class="tw:text-gray-500">
        <%= render(UI::Accordion::Component.new(items: faqs)) %>
      </div>
    </div>

    <nav
      class="tw:w-full tw:shrink-0 tw:lg:w-80"
      aria-labelledby="stolen-more-resources"
    >
      <h2
        id="stolen-more-resources"
        class="tw:m-0 tw:mt-2 tw:mb-4 <%= SharedBlocks::Marketing::SectionHeading::Component.eyebrow_classes(:gray) %>"
      >
        <%= translation(".more_resources") %>
      </h2>

      <ul class="tw:m-0 tw:flex tw:list-none tw:flex-col tw:gap-2.5 tw:p-0">
        <% resources.each do |label, href| %>
          <li>
            <%= link_to(label, href,
                class: "tw:block tw:rounded-lg tw:border tw:border-gray-200 tw:bg-white tw:px-4 tw:py-3.25 tw:text-[15px] tw:font-semibold tw:text-gray-700 tw:no-underline tw:transition-colors tw:hover:border-blue-200 tw:hover:bg-blue-100") %>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</section>

<section class="tw:border-t tw:border-gray-200">
  <div class="<%= section_inner %>">
    <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(heading: translation(".report_bike_theft_issues"))) %>

    <div
      class="
        tw:mt-1 tw:mb-4 tw:flex tw:max-w-190 tw:flex-col tw:gap-2
        tw:text-[15px] tw:text-gray-500 tw:lg:mb-6 tw:lg:text-[17px]
      "
    >
      <p class="tw:m-0">
        <%= translation(".report_bike_theft_issues_subhead") %>
        <%= translation(".reporting_your_own_bike_html", register_it_link: link_to(translation(".register_it"), register_stolen_path, class: "twlink")) %>
      </p>

      <p class="tw:m-0">
        <%= translation(".report_on_the_stolen_bike_page") %>
      </p>
    </div>

    <% if @current_user.present? %>
      <%= form_for @feedback, html: {class: "tw:max-w-3xl"} do |f| %>
        <%= f.hidden_field :feedback_type, value: "stolen_information" %>

        <div class="tw:mb-4">
          <%= render(UI::Forms::RadioButtonGroup::Component.new(name: "feedback[title]", entries: report_title_entries,
              selected: @feedback.title.presence || report_title_entries.first[:value])) %>
        </div>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :body, kind: :text_area,
            label_text: translation(".where_is_this_happening"), required: true,
            html_options: {rows: 5})) %>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :email, label_text: translation(".email"), required: true)) do %>
          <%= render(UI::Forms::Email::Component.new(form_builder: f, required: true)) %>
        <% end %>

        <%= render(UI::Button::Component.new(text: translation(".send_report"), color: :primary, type: "submit")) %>
      <% end %>
    <% else %>
      <p class="tw:m-0 tw:text-[15px] tw:text-gray-500">
        <%= translation(".sign_in_to_report_html", sign_in_link: link_to(translation(".sign_in"), new_session_path, class: "twlink")) %>
      </p>
    <% end %>
  </div>
</section>

<%= render(SharedBlocks::Marketing::CallToActionBanner::Component.new(heading: translation(".every_hour_it_sits_unregistered"),
    subheading: translation(".three_minutes_and_no_cost"), illustration: false)) do %>
  <%= render(UI::ButtonLink::Component.new(href: register_stolen_path,
      text: translation(".register_your_stolen_bike"), color: :yellow, size: :callout)) %>
<% end %>
