<div
  data-controller="registrations--show--map"
  data-registrations--show--map-latitude-value="<%= @latitude %>"
  data-registrations--show--map-longitude-value="<%= @longitude %>"
  data-registrations--show--map-radius-meters-value="<%= radius_meters %>"
  class="
    tw:relative tw:mt-3 tw:mb-4 tw:h-80 tw:w-full tw:overflow-hidden
    tw:rounded-sm tw:bg-gray-100 tw:dark:bg-gray-900
  "
>
  <div
    data-registrations--show--map-target="canvas"
    class="tw:h-full tw:w-full"
  ></div>

  <% if @point %>
    <%# The tip is 21/24 down the icon; translate composes with the marker's transform %>
    <template data-registrations--show--map-target="pin">
      <%= helpers.inline_svg_tag("kelsey/registration_show/map-pin.svg", class: "tw:pointer-events-none tw:h-9 tw:w-9 tw:translate-y-[12.5%] tw:fill-purple-500 tw:text-purple-500 tw:[&_circle]:fill-purple-800 tw:[&_circle]:stroke-none tw:drop-shadow-md", aria_hidden: true) %>
    </template>
  <% end %>

  <p
    hidden
    data-registrations--show--map-target="unavailable"
    class="
      tw:absolute tw:inset-0 tw:flex tw:items-center tw:justify-center
      tw:p-8 tw:text-center tw:text-sm tw:opacity-65
    "
  >
    <%= translation(".unavailable") %>
  </p>
</div>
