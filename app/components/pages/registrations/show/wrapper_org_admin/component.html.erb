<div
  class="
    tw:mx-auto tw:flex tw:w-full tw:max-w-[1440px] tw:flex-col tw:gap-6
    tw:px-2
  "
>
  <div class="tw:flex tw:flex-wrap tw:items-start tw:justify-between tw:gap-4">
    <div>
      <div class="tw:mb-2 tw:flex tw:flex-wrap tw:items-center tw:gap-2">
        <%= render(Pages::Registrations::Show::ViewSwitcher::Component.new(bike: @bike, current_view: [@org_role, @organization], available_views: @available_views, label: @organization.short_name, color: org_chip_color, solid: false, role_label: role_label, current_user: @current_user)) %>
      </div>

      <h1 class="tw:text-2xl tw:font-bold"><%= title %></h1>

      <p class="tw:opacity-65">
        <%= render(Pages::Registrations::Show::Subtitle::Component.new(bike: @bike)) %>
      </p>

      <div class="tw:mt-2 tw:flex tw:flex-wrap tw:gap-2">
        <%= render(Atoms::RegistrationStatusBadge::Component.new(bike: @bike)) %>
      </div>
    </div>
  </div>

  <%= render(current_alerts_component) %>

  <%= render(Pages::Registrations::Show::OrgTopActions::Wrapper::Component.new(bike: @bike, organization: @organization, org_role: @org_role, current_user: @current_user, display_dev_info: @display_dev_info)) %>

  <%# tw:contents collapses the column wrappers on mobile, so tw:order can interleave them %>

  <div class="tw:grid tw:gap-6 tw:lg:grid-cols-3">
    <div class="tw:contents tw:lg:col-span-2 tw:lg:flex tw:lg:flex-col tw:lg:gap-6">
      <% archive_images = @bike.public_images.select(&:image_url) %>

      <% if archive_images.any? %>
        <%= render(UI::Card::Component.new) do %>
          <h2
            class="
              tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
              tw:uppercase
            "
          >
            <%= translation(".photo_archive") %>
          </h2>

          <ul class="tw:mt-3 tw:flex tw:flex-wrap tw:gap-3">
            <% archive_images.each do |public_image| %>
              <li>
                <a
                  href="<%= public_image.image_url %>"
                  target="_blank"
                  rel="noopener"
                  class="
                    tw:block tw:size-24 tw:overflow-hidden tw:rounded-lg
                    tw:border tw:border-gray-200 tw:transition
                    tw:hover:border-[#715eb2] tw:dark:border-gray-700
                  "
                >
                  <%= image_tag(public_image.image_url(:small), alt: public_image.image_alt, class: "tw:size-full tw:object-cover") %>
                </a>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <%= render(Pages::Registrations::Show::StolenDetails::Component.new(bike: @bike, current_user: @current_user)) %>
      <%= render(Pages::Registrations::Show::ImpoundDetails::Component.new(bike: @bike, organization: @organization)) %>

      <%= render(Pages::Registrations::Show::MarketplaceListingCard::Component.new(bike: @bike, current_user: @current_user, term: :below)) %>

      <%= render(Pages::Registrations::Show::BikeIndexCard::Component.new(bike: @bike, term: :below)) %>

      <div class="tw:order-5 tw:lg:order-none">
        <%= render(Pages::Registrations::Show::BikeDetails::Component.new(bike: @bike, serial_user: @current_user)) %>
      </div>

      <% if @bike.description.present? %>
        <%= render(UI::Card::Component.new(additional_classes: "tw:order-6 tw:lg:order-none")) do %>
          <h2
            class="
              tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
              tw:uppercase
            "
          >
            <%= translation(".about_this_bike", bike_type: @bike.type) %>
          </h2>

          <p class="tw:mt-2"><%= @bike.description %></p>
        <% end %>
      <% end %>

      <% if show_notes? %>
        <div class="tw:order-4 tw:lg:order-none">
          <%= render(Pages::Registrations::Show::InternalNotes::Component.new(notes: notes_thread, url: notes_url, current_user: @current_user)) %>
        </div>
      <% end %>

      <% component_list = Pages::Registrations::Show::ComponentList::Component.new(bike: @bike, collapsed: true) %>

      <% if component_list.render? %>
        <div class="tw:order-7 tw:lg:order-none">
          <%= render(component_list) %>
        </div>
      <% end %>
    </div>

    <div class="tw:contents tw:lg:flex tw:lg:flex-col tw:lg:gap-6">
      <%= render(UI::Card::Component.new(additional_classes: "tw:order-1 tw:lg:order-none")) do %>
        <h2
          class="
            tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
            tw:uppercase
          "
        >
          <%= translation(".owner_access") %>
        </h2>

        <div class="tw:mt-3">
          <% if unregistered? %>
            <p class="tw:text-sm tw:opacity-65">
              <%= translation(".unregistered_owner", bike_type: @bike.type) %>
            </p>
          <% else %>
            <%= render(UI::DefinitionList::Container::Component.new(term: :right_align)) do %>
              <% if organization_registered? %>
                <%= info_row(translation(".owner_name"), @bike.owner_name) %>
              <% end %>

              <% if show_contact? %>
                <%= info_row(translation(".owner_email")) do %>
                  <% if @bike.owner_email.present? %>
                    <%= link_to(@bike.owner_email, "mailto:#{@bike.owner_email}", class: "twlink") %>
                  <% end %>
                <% end %>
                <%= info_row(translation(".owner_phone")) { render Atoms::Phone::Component.new(phone: owner_phone) } %>
                <% if @organization.additional_registration_fields.include?("reg_address") %>
                  <%= info_row(OrgServices::RegistrationFields.label(organization: @organization, reg_field: "reg_address")) { render(UI::AddressDisplay::Component.new(address_record: @bike.mailing_address_record, visible_attribute: :street, kind: :single_line)) } %>
                <% end %>
                <% owner_reg_field_rows.each do |label, value| %>
                  <%= info_row(label, value) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <% if staff? && (unregistered? || show_contact?) %>
          <div
            class="
              tw:mt-3 tw:flex tw:items-center tw:justify-between tw:gap-3
              tw:rounded-lg tw:bg-purple-50 tw:p-3 tw:dark:bg-purple-950
            "
          >
            <div class="tw:min-w-0">
              <p class="tw:text-sm tw:font-bold">
                <%= translation(".org_can_edit", org_name: @organization.short_name, bike_type: @bike.type) %>
              </p>

              <p class="tw:mt-1 tw:text-xs tw:opacity-65">
                <%= translation(".org_can_edit_sub", bike_type: @bike.type) %>
              </p>
            </div>

            <%= render(UI::ButtonLink::Component.new(href: edit_access_path, text: translation(".edit"), color: :secondary, size: :sm, html_class: "tw:flex-none")) %>
          </div>
        <% elsif !show_contact? && !unregistered? %>
          <div
            class="
              tw:mt-3 tw:rounded-lg tw:border tw:border-dashed
              tw:border-gray-300 tw:p-4 tw:dark:border-gray-700
            "
          >
            <p class="tw:font-bold"><%= contact_blocked_title %></p>

            <p class="tw:mt-1 tw:text-sm tw:opacity-65">
              <%= contact_blocked_message %>
            </p>
          </div>
        <% end %>
      <% end %>

      <div class="tw:order-2 tw:lg:order-none">
        <%= render(Pages::Registrations::Show::RegistrationInformation::Component.new(bike: @bike, organization: @organization, org_role: @org_role)) %>
      </div>
    </div>
  </div>

  <% if show_other_registrations? %>
    <%= render(UI::Card::Component.new) do %>
      <div class="tw:flex tw:items-baseline tw:justify-between">
        <h2
          class="
            tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
            tw:uppercase
          "
        >
          <%= translation(".other_registrations") %>
        </h2>

        <span class="tw:text-xs tw:opacity-65">
          <% if other_registrations_count.positive? %>
            <%= translation(".other_registrations_count_html", count: helpers.number_display(other_registrations_count)) %>
          <% else %>
            <%= translation(".no_other_registrations") %>
          <% end %>
        </span>
      </div>

      <% if other_registrations_count.positive? %>
        <%= tag.div(class: "org-search-component tw:mt-3", data: Pages::Org::Search::Settings::Component.column_toggle_data_attributes(other_registrations_settings)) do %>
          <%= render(Pages::Org::Search::Settings::Component.new(settings: other_registrations_settings, skip_search_and_filters: true)) %>

          <div class="tw:mt-3">
            <%= render(Pages::Org::SearchResults::BikesTable::Component.new(organization: @organization, bikes: recent_other_registrations, current_user: @current_user, settings: other_registrations_settings)) %>
          </div>
        <% end %>
      <% end %>

      <% if more_other_registrations? %>
        <p class="tw:mt-3 tw:text-xs tw:opacity-65">
          <%= translation(".showing_recent", count: recent_other_registrations.size) %>
          ·
          <%= link_to translation(".view_all_registrations"), other_registrations_search_path, class: "twlink", data: {turbo_frame: "_top"} %>
        </p>
      <% end %>
    <% end %>
  <% end %>

  <% if @organization.enabled?("bike_stickers") %>
    <%= render(UI::Modal::Component.new(id: "link-sticker-modal", title: translation(".link_sticker"))) do |modal| %>
      <% modal.with_body do %>
        <%= form_with model: BikeSticker.new, url: organization_sticker_path(id: "code", organization_id: @organization.to_param), method: :put, class: "tw:flex tw:flex-col tw:gap-3" do |form| %>
          <%= form.hidden_field :bike_id, value: @bike.id %>

          <div>
            <%= form.label :code, translation(".sticker_code"), class: "twlabel" %>
            <%= form.text_field :code, required: true, class: "twinput" %>
          </div>

          <%= render(UI::Button::Component.new(text: translation(".assign_sticker"), color: :purple, type: "submit")) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Pages::Registrations::Show::LegacyViewLink::Component.new(bike: @bike, current_user: @current_user)) %>
</div>
