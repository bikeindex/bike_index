<div
  data-registrations--show--action-panels-target="panel"
  data-panel-name="message"
  class="tw:hidden"
>
  <%= render(UI::Card::Component.new) do %>
    <h2
      class="
        tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
        tw:uppercase
      "
    >
      <%= heading %>
    </h2>

    <% if @owner_notifications_off %>
      <p class="tw:mt-3">
        <%= translation(".owner_turned_off_non_stolen_notifications") %>
      </p>
    <% elsif parking_notification_only? %>
      <p class="tw:mt-3">
        <%= translation(".has_active_parking_notification") %>
      </p>
      <p class="tw:mt-4">
        <%= translation(".send_a_new_parking_notification_to_message_the_owner") %>
      </p>

      <div class="tw:mt-3">
        <%= render(UI::Button::Component.new(text: translation(".send_parking_notification"), color: :secondary, data: {"panel-name": "parking", action: "registrations--show--action-panels#toggle"})) %>
      </div>
    <% else %>
      <div data-controller="registrations--show--message-owner">
        <div class="tw:mt-3 tw:flex tw:items-center tw:gap-2">
          <%= render(UI::Forms::RadioButtonGroup::Component.new(name: message_kind_name, selected: organization_message? ? "general" : "theft", entries: [{value: "theft", label: translation(".message_about_theft")}, {value: "general", label: translation(".general_message"), disabled: !organization_message?}], html_options: {data: {action: "registrations--show--message-owner#select"}})) %>

          <% if unavailable_reason_text %>
            <%= render(UI::Tooltip::Component.new(text: unavailable_reason_text)) %>
          <% end %>
        </div>

        <% if organization_message? %>
          <div
            class="tw:mt-3"
            data-registrations--show--message-owner-target="organizationMessage"
          >
            <%= render(Pages::Registrations::Show::OrgTopActions::OrganizationMessageForm::Component.new(bike: @bike, organization: @organization)) %>
          </div>
        <% end %>

        <div
          class="tw:mt-3 <%= "tw:hidden" if organization_message? %>"
          data-registrations--show--message-owner-target="stolenNotification"
        >
          <%= render(Pages::Registrations::Show::StolenNotificationForm::Component.new(bike: @bike, placeholder: (translation(".what_do_you_need_to_ask", bike_type: @bike.type) if impounded?))) %>
        </div>
      </div>

      <%= render(Pages::Registrations::Show::OwnerPhone::Component.new(phone: owner_phone)) %>
    <% end %>
  <% end %>
</div>
