<div
  class="tw:flex tw:flex-col tw:gap-3"
  data-controller="registrations--show--action-panels"
>
  <div class="tw:grid tw:grid-cols-2 tw:gap-3 tw:lg:flex">
    <%= action_button("message", icon: "mail", title: translation(".message_owner")) if contactable? %>

    <%= action_button("impound", icon: "lock", title: translation(".impound")) if show_create_impound? %>

    <%= action_button("impound_update", icon: "lock", tile: :amber, title: translation(".update_impound_record")) if show_update_impound? %>

    <%= action_button("parking", icon: "map-pin", title: translation(".new_parking_notice")) if show_create_parking_notification? %>

    <% if show_parking_notifications? %>
      <%= action_button("notifications_show", icon: "bell", tile: :blue, title: translation(".view_notifications"), subtitle: notifications_activity) %>
    <% end %>
  </div>

  <% if contactable? %>
    <%= render(Pages::Registrations::Show::OrgTopActions::MessageOwner::Component.new(bike: @bike, current_user: @current_user)) %>
  <% end %>

  <% if show_create_parking_notification? || show_create_impound? %>
    <%= render(Pages::Registrations::Show::OrgTopActions::ParkingNotificationForm::Component.new(bike: @bike, organization: @organization)) %>
  <% end %>

  <% if show_update_impound? %>
    <%= render(Pages::Registrations::Show::OrgTopActions::ImpoundUpdate::Component.new(bike: @bike, organization: @organization)) %>
  <% end %>

  <% if show_parking_notifications? %>
    <%= render(Pages::Registrations::Show::OrgTopActions::ParkingNotificationShow::Component.new(bike: @bike, organization: @organization, display_dev_info: @display_dev_info)) %>
  <% end %>
</div>
