<div
  data-registrations--show--action-panels-target="panel"
  data-panel-name="parking impound"
  data-controller="org--parking-notification-form"
  data-org--parking-notification-form-notification-heading-value="<%= translation(".create_parking_notification") %>"
  data-org--parking-notification-form-impound-heading-value="<%= translation(".impound_this_bike_type", bike_type: @bike.type) %>"
  data-org--parking-notification-form-default-kind-value="<%= new_parking_notification.kind %>"
  data-org--parking-notification-form-org-latitude-value="<%= org_map_coordinates[:latitude] %>"
  data-org--parking-notification-form-org-longitude-value="<%= org_map_coordinates[:longitude] %>"
  data-action="registrations--show--action-panels:shown->org--parking-notification-form#panelShown"
  class="tw:hidden"
>
  <%= render(UI::Card::Component.new) do %>
    <h2
      data-org--parking-notification-form-target="heading"
      class="
        tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
        tw:uppercase
      "
    >
      <%= translation(".create_parking_notification") %>
    </h2>

    <div class="tw:mt-3">
      <%= form_with(model: new_parking_notification, url: create_parking_notifications_path, data: {controller: "csrf-refresh form-persist", "form-persist-key-value": "parking-notification-#{@bike.id}", action: "input->form-persist#save submit->form-persist#clear"}) do |form| %>
        <%= form.hidden_field :bike_id %>

        <% if new_parking_notification.can_be_repeat? %>
          <div class="tw:mb-4">
            <%= render(UI::Forms::RadioButtonGroup::Component.new(name: "parking_notification[is_repeat]", selected: new_parking_notification.is_repeat, entries: [{value: true, label: "Repeat ##{new_parking_notification.earlier_bike_notifications.count} of earlier notification"}, {value: false, label: "First notice"}], html_options: {data: {action: "org--parking-notification-form#selectRepeat"}})) %>
          </div>
        <% end %>

        <%= render(Pages::Org::ParkingNotificationLocation::Component.new(form:)) %>

        <%= render(UI::Forms::Group::Component.new(form_builder: form, attribute: :message, kind: :text_area, label_text: "Optional message to send to the owner", html_options: {rows: 3, placeholder: "Optional"})) %>

        <div
          class="tw:mb-4"
          data-org--parking-notification-form-target="kindGroup"
        >
          <p class="twlabel">Notification because</p>
          <%= render(UI::Forms::RadioButtonGroup::Component.new(name: "parking_notification[kind]", selected: new_parking_notification.kind, entries: ::ParkingNotification.kinds.map { |kind| {value: kind, label: ::ParkingNotification.kinds_humanized[kind.to_sym]} })) %>
        </div>

        <div class="tw:mb-4">
          <p class="twlabel">Photo</p>
          <%= render(UI::Forms::Files::Upload::Component.new(form_builder: form, attribute: :image, accept: ImageUploader.permitted_extensions)) %>
          <%= form.hidden_field :image_cache %>
        </div>

        <%= render(UI::Forms::Group::Component.new(form_builder: form, attribute: :internal_notes, kind: :text_area, label_text: translation(".parking_notification_notes", org_name: @organization.short_name), html_options: {rows: 2})) do |group| %>
          <% group.with_label_note { translation(".not_shown_to_user") } %>
        <% end %>

        <%= render(UI::Button::Component.new(text: "Create parking notification", color: :primary, type: "submit", disabled: true, data: {"org--parking-notification-form-target": "submit"})) %>
      <% end %>
    </div>
  <% end %>
</div>
