<div
  data-controller="registrations--show--action-panels"
  data-registrations--show--action-panels-open-value="parking"
>
  <button
    type="button"
    data-registrations--show--action-panels-target="trigger"
    data-panel-name="parking"
    data-action="registrations--show--action-panels#toggle"
    aria-expanded="false"
    class="twbtn"
  >
    Parking notification
  </button>

  <button
    type="button"
    data-registrations--show--action-panels-target="trigger"
    data-panel-name="impound"
    data-action="registrations--show--action-panels#toggle"
    aria-expanded="false"
    class="twbtn"
  >
    Impound
  </button>

  <%= render(Pages::Registrations::Show::OrgTopActions::ParkingNotificationForm::Component.new(bike:, organization:)) %>
</div>
