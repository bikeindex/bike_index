<%# Keyed per bike, so a half-typed message doesn't surface on another bike's form %>
<%= form_with(model: [@organization, OrganizationMessage.new], data: {controller: "csrf-refresh form-persist", "form-persist-key-value": "organization-message-#{@bike.id}", action: "input->form-persist#save submit->form-persist#clear"}) do |form| %>
  <%= form.hidden_field :bike_id, value: @bike.id %>

  <%= form.text_area :message, required: true, rows: 6, placeholder: translation(".what_do_you_want_to_tell_the_owner", bike_type: @bike.type), class: "twinput tw:w-full" %>

  <div class="tw:mt-3">
    <%= render(UI::Button::Component.new(text: translation(".send_message"), color: :primary, type: "submit")) %>
  </div>
<% end %>
