<%= render(UI::Card::Component.new) do %>
  <h2 class="tw:tweyebrow">
    <%= heading %>
  </h2>

  <%= render(Pages::Registrations::Show::Map::Component.new(latitude: map_latitude, longitude: map_longitude, precise: map_precise?, point: org_record?)) %>

  <% if org_record? %>
    <%= render(Pages::Registrations::Show::ImpoundRecordFields::Component.new(impound_record:)) %>
  <% else %>
    <%= render(UI::DefinitionList::Container::Component.new(term: :below)) do %>
      <%= render(UI::DefinitionList::Row::Component.new(label: translation(".location"), value: impound_record.impounded_from_address&.formatted_address_string)) %>

      <%= render(UI::DefinitionList::Row::Component.new(label: found? ? translation(".found_at") : translation(".impounded_at"), value: impound_record.impounded_at, time_localizer_settings: %i[preciseTime originalTimeZone])) %>
    <% end %>
  <% end %>
<% end %>
