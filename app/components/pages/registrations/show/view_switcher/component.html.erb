<%= render(UI::Dropdown::Component.new(name: @label, button_class: button_class)) do |dropdown| %>
  <% dropdown.with_button do %>
    <%= display_label %>
  <% end %>

  <% if superuser? %>
    <% dropdown.with_entry_item do %>
      <%= super_admin_link %>
    <% end %>
    <% dropdown.with_entry_divider %>
  <% end %>

  <% org_view_groups.each_with_index do |group, index| %>
    <% dropdown.with_entry_divider if index.positive? %>

    <% group.each do |view| %>
      <% dropdown.with_entry_item do %>
        <%= entry_link(view) %>
      <% end %>
    <% end %>
  <% end %>

  <% if org_views.any? && other_views.any? %>
    <% dropdown.with_entry_divider %>
  <% end %>

  <% other_views.each do |view| %>
    <% dropdown.with_entry_item do %>
      <%= entry_link(view) %>
    <% end %>
  <% end %>

  <% dropdown.with_entry_divider %>

  <% dropdown.with_entry_item do %>
    <%= render(UI::ButtonLink::Component.new(href: legacy_view_path, method: :post, color: :link_gray, html_class: "tw:w-full tw:justify-start tw:rounded-t-none tw:px-4 tw:pt-1 tw:pb-2 tw:text-left tw:text-base tw:text-gray-700 tw:no-underline tw:hover:bg-gray-100 tw:hover:text-gray-900 tw:dark:text-gray-200 tw:dark:hover:bg-gray-700 tw:dark:hover:text-gray-100", form: {class: "tw:block", data: {controller: "csrf-refresh"}})) do %>
      <span>View in <span class="tw:font-bold">Legacy Viewer</span></span>
    <% end %>
  <% end %>
<% end %>
