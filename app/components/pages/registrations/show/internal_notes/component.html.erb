<%= render(UI::Card::Component.new) do %>
  <h2 class="tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2] tw:uppercase">
    <%= translation(".internal_notes") %>
  </h2>

  <% @notes.each do |note| %>
    <div class="tw:mt-3 tw:border-b tw:border-gray-100 tw:pb-3 tw:dark:border-gray-800">
      <p class="tw:text-sm"><%= note.body %></p>

      <p class="tw:mt-1 tw:text-xs tw:opacity-65">
        <%= translation(".note_by", user: note.user&.display_name) %>

        <%= render(UI::Time::Component.new(time: note.updated_at)) %>
      </p>
    </div>
  <% end %>

  <%= form_with(url: @url, method: :patch, class: "tw:mt-3", data: {controller: "csrf-refresh"}) do |f| %>
    <%= f.text_area :notes, name: "notes", rows: 3, class: "twinput tw:w-full", placeholder: translation(".notes_placeholder") %>

    <div class="tw:mt-2 tw:flex tw:items-center tw:justify-between">
      <small class="tw:opacity-65">
        <%= translation(".posts_as", user: @current_user.display_name) %>
      </small>

      <%= f.submit translation(".post_note"), class: UI::Button::Component.build_classes(color: :primary, size: :sm) %>
    </div>
  <% end %>
<% end %>
