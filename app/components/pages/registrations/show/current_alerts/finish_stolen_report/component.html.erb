<%= render(UI::Alerts::Base::Component.new(kind: :warning, margin_classes: "")) do %>
  <p class="tw:mb-2">
    <%= translation(".not_reported_yet", bike_type: @bike.type) %>
  </p>

  <%= render UI::ButtonLink::Component.new(href: new_bike_stolen_report_path(@bike), text: translation(".finish_report"),
      color: :error, size: :sm) %>
<% end %>
