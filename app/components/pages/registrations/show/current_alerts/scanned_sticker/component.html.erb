<%= render(UI::Alerts::Base::Component.new(kind: :success, margin_classes: "", icon: qr_icon)) do %>
  <p>
    <%= translation(".you_scanned_this_sticker_html", sticker: render(Atoms::Sticker::Component.new(bike_sticker: @bike_sticker)), bike_type: @bike.type) %>
  </p>

  <% if relinkable? %>
    <div data-controller="ui--collapse" class="tw:mt-2 tw:text-sm">
      <%= translation(".is_this_linked_to_incorrect_bike", bike_type: @bike.type) %>

      <%= render(UI::Button::Component.new(
        color: :link,
        aria: {expanded: false},
        data: {"ui--collapse-target": "trigger", action: "ui--collapse#toggle"}
      )) do %>
        <span
          data-ui--collapse-target="chevron"
          class="tw:inline-block tw:transition-transform tw:duration-200"
        >
          <span class="tw:flex">
            <%= render UI::IconChevron::Component.new %>
          </span>
        </span>

        <%= translation(".change_the_bike_sticker_linked_to", bike_type: @bike.type) %>
      <% end %>

      <div data-ui--collapse-target="content" class="tw:hidden">
        <%= form_with(url: update_sticker_path, method: :put, class: "tw:mt-3 tw:max-w-lg", data: {controller: "csrf-refresh"}) do |form| %>
          <%= form.label :bike_id, translation(".switch_to_new_bike_id", bike_type: @bike.type), class: "twlabel" %>
          <%= form.text_field :bike_id, placeholder: bike_url(1234), class: "twinput tw:w-full" %>

          <div class="tw:mt-2">
            <%= render(UI::Button::Component.new(text: translation(".update"), color: :purple, type: "submit")) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
