<div class="tw:mt-2 tw:text-center">
  <%= render(UI::Alerts::Base::Component.new(kind: :purple)) do %>
    <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-3">
      <span class="tw:font-semibold">
        <%= translation(".using_new_view", bike_type: @bike.type) %>
      </span>

      <% if @show_legacy %>
        <%= link_to translation(".view_in_legacy", bike_type: @bike.type), bike_path(@bike), class: "twlink-underlined tw:text-sm" %>
      <% else %>
        <%= render(UI::ButtonLink::Component.new(text: translation(".switch_to_classic"), href: toggle_legacy_view_registration_path(@bike), method: :post, form: {data: {controller: "csrf-refresh"}}, color: :secondary, size: :sm)) %>
      <% end %>
    </div>
  <% end %>
</div>
