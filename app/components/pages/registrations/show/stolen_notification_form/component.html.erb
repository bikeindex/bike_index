<%# Keyed per bike, so a half-typed message doesn't surface on another bike's form %>
<%= form_with(model: StolenNotification.new(bike: @bike), url: stolen_notifications_path, data: {controller: "csrf-refresh form-persist", "form-persist-key-value": "contact-owner-#{@bike.id}", action: "input->form-persist#save submit->form-persist#clear"}) do |form| %>
  <%= form.hidden_field :bike_id, value: @bike.id %>

  <%= form.text_area :message, required: true, rows: 6, placeholder:, class: "twinput tw:w-full" %>

  <%= form.text_field :reference_url, placeholder: translation(".link_url"), class: "twinput tw:mt-2 tw:w-full" %>

  <div class="tw:mt-3">
    <%= render(UI::Button::Component.new(text: translation(".send_message"), color: :primary, type: "submit")) %>
  </div>
<% end %>
