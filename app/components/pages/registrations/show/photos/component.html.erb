<div class="tw:flex tw:flex-col tw:gap-3">
  <% if has_photos? %>
    <div
      data-controller="registrations--show--photos"
      class="tw:flex tw:flex-col tw:gap-3"
    >
      <a
        href="<%= bike_image_original_url %>"
        data-registrations--show--photos-target="link"
        class="
          tw:relative tw:-mx-2 tw:block tw:overflow-hidden tw:rounded-none
          tw:bg-gray-100 tw:lg:mx-0 tw:lg:rounded-2xl tw:dark:bg-gray-900
        "
      >
        <%= image_tag(
          bike_image_url,
          alt: bike_photo_alt,
          data: {"registrations--show--photos-target": "main", action: "error->registrations--show--photos#disableLink"},
          class: "tw:aspect-4/3 tw:w-full tw:object-contain",
        ) %>

        <%= hero_overlay(stock_badge(gallery: true)) %>
      </a>

      <% if photos.many? %>
        <ul class="tw:flex tw:flex-wrap tw:gap-2">
          <% photos.each_with_index do |photo, index| %>
            <%# A stock photo's badge goes beside the button rather than in it, as it's a tooltip's button %>
            <li class="tw:relative">
              <button
                type="button"
                data-registrations--show--photos-target="thumbnail"
                data-action="click->registrations--show--photos#select"
                data-large-url="<%= photo.large_url %>"
                data-original-url="<%= photo.url %>"
                data-photo-alt="<%= photo.alt || bike_photo_alt %>"
                data-stock="<%= photo.stock %>"
                aria-current="<%= index == 0 %>"
                class="
                  tw:cursor-pointer tw:overflow-hidden tw:rounded-sm
                  tw:border-2 tw:border-transparent
                  tw:aria-[current=true]:border-blue-500
                "
              >
                <%= image_tag photo.small_url, alt: photo.alt || bike_photo_alt, class: ["tw:h-16 tw:w-16", photo.stock ? "tw:bg-white tw:object-contain" : "tw:object-cover"] %>
              </button>

              <% if photo.stock %>
                <%= render(Atoms::StockPhotoBadge::Component.new(bike: @bike, display: :word, html_class: "tw:absolute tw:bottom-1 tw:left-1")) %>
              <% end %>
            </li>
          <% end %>

          <% if @owner %>
            <li><%= add_photo_box %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% elsif @bike.stock_photo_url.present? %>
    <div
      class="
        tw:relative tw:-mx-2 tw:overflow-hidden tw:rounded-none
        tw:bg-gray-100 tw:lg:mx-0 tw:lg:rounded-2xl tw:dark:bg-gray-900
      "
    >
      <%= image_tag(@bike.stock_photo_url, alt: bike_photo_alt, class: "tw:aspect-4/3 tw:w-full tw:object-contain") %>

      <%= hero_overlay(stock_badge) %>
    </div>
    <% if @owner %>
      <%= add_photo_box %>
    <% end %>
  <% else %>
    <div
      class="
        tw:relative tw:-mx-2 tw:overflow-hidden tw:rounded-none
        tw:bg-gray-100 tw:lg:mx-0 tw:lg:rounded-2xl tw:dark:bg-gray-900
      "
    >
      <%= helpers.bike_placeholder_image_tag(alt: bike_photo_alt, class: "tw:aspect-4/3 tw:w-full tw:object-contain") %>

      <%= hero_overlay %>
    </div>
    <% if @owner %>
      <%= add_photo_box %>
    <% end %>
  <% end %>
</div>
