<%= render(UI::Card::Component.new) do %>
  <div
    data-controller="ui--collapse"
    data-ui--collapse-param-value="contact_owner"
  >
    <h2
      class="
        tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
        tw:uppercase
      "
    >
      <%= translation(".know_something_about_this_bike_type", bike_type: @bike.type) %>
    </h2>

    <div class="tw:mt-3">
      <% if sign_in_redirect %>
        <%= render(UI::ButtonLink::Component.new(href: sign_in_redirect, text: translation(".contact_the_owner"), color: :purple)) %>
      <% else %>
        <%= render(UI::Button::Component.new(
          text: translation(".contact_the_owner"),
          color: :purple,
          aria: {expanded: false},
          data: {"ui--collapse-target": "trigger", action: "ui--collapse#toggle"}
        )) %>
        <div data-ui--collapse-target="content" class="tw:hidden">
          <%= form_with(model: stolen_notification, url: stolen_notifications_path, data: {controller: "csrf-refresh"}) do |form| %>
            <%= form.hidden_field :bike_id, value: @bike.id %>

            <%= form.text_area :message,
              required: true,
              rows: 6,
              placeholder: translation(".where_did_you_see_this_bike", bike_type: @bike.type),
              class: "twinput tw:w-full" %>

            <%= form.text_field :reference_url,
              placeholder: translation(".link_url"),
              class: "twinput tw:mt-2 tw:w-full" %>

            <div class="tw:mt-3">
              <%= render(UI::Button::Component.new(text: translation(".send_message"), color: :purple, type: "submit")) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= render(Pages::Registrations::Show::OwnerPhone::Component.new(phone: owner_phone)) %>
  </div>
<% end %>
