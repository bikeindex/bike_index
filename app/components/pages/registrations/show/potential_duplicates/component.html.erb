<%= render(UI::Card::Component.new) do %>
  <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-2">
    <h2 class="tw:mb-0 tw:tweyebrow">
      <%= translation(".potential_duplicates") %>
    </h2>

    <span class="tw:text-xs tw:opacity-65">
      <%= translation(".count_html", count: helpers.number_display(duplicate_bikes_count)) %>
    </span>
  </div>

  <p class="tw:mt-2 tw:text-sm">
    <%= translation(".matching_segments", bike_type: @bike.type) %>

    <% matching_segments.each do |segment| %>
      <%= render(UI::Code::Inline::Component.new(text: segment)) %>
    <% end %>
  </p>

  <% current_user = @current_user %>

  <div class="tw:mt-3">
    <%= render(UI::Table::Base::Component.new(records: recent_duplicate_bikes)) do |table| %>
      <% table.column(label: translation(".registered")) do |duplicate_bike| %>
        <%= render(UI::Time::Component.new(time: duplicate_bike.created_at)) %>
      <% end %>

      <% table.column(label: translation(".registration")) do |duplicate_bike| %>
        <%= link_to helpers.organized_bike_text(duplicate_bike), bike_path(duplicate_bike), class: "twlink" %>
      <% end %>

      <% table.column(label: translation(".serial")) do |duplicate_bike| %>
        <%= render(Atoms::Serial::Component.new(bike: duplicate_bike, user: current_user)) %>
      <% end %>
    <% end %>
  </div>

  <% if more_duplicate_bikes? %>
    <p class="tw:mt-3 tw:text-xs tw:opacity-65">
      <%= translation(".showing_recent", count: LIMIT) %>
    </p>
  <% end %>
<% end %>
