<%= render(UI::Card::Component.new) do %>
  <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-2">
    <h2 class="tw:mb-0 tw:tweyebrow">
      <%= translation(".potential_duplicates") %>
    </h2>

    <div class="tw:flex tw:items-center tw:gap-3">
      <span class="tw:text-xs tw:opacity-65">
        <%= translation(".count_html", count: helpers.number_display(duplicate_bikes_count)) %>
      </span>

      <% if @column_settings %>
        <%= render(Pages::Org::Search::ColumnSettingsToggle::Component.new) %>
      <% end %>
    </div>
  </div>

  <p class="tw:mt-2 tw:text-sm">
    <%= translation(".matching_segments", bike_type: @bike.type) %>

    <% matching_segments.each do |segment| %>
      <%= render(UI::Code::Inline::Component.new(text: segment)) %>
    <% end %>
  </p>

  <% if @column_settings %>
    <div class="tw:mt-3">
      <%= render(Pages::Org::Search::ColumnSettings::Component.new(settings: @settings)) %>
    </div>
  <% end %>

  <div class="tw:mt-3">
    <%= render(Pages::Org::SearchResults::BikesTable::Component.new(organization: @organization, bikes: recent_duplicate_bikes, settings: @settings)) %>
  </div>

  <% if more_duplicate_bikes? %>
    <p class="tw:mt-3 tw:text-xs tw:opacity-65">
      <%= translation(".showing_recent", count: LIMIT) %>
    </p>
  <% end %>
<% end %>
