<%= render Pages::Register::Page::Component.new do %>
  <%# Not always the last step: a report waiting on the confirmation email comes after %>
  <%= render Pages::Register::Progress::Component.new(steps: @steps, step: "review") %>

  <%# The last acknowledgment step, not a finished one - the acknowledgment is still unsigned %>
  <%= render Pages::Register::AcknowledgmentProgress::Component.new(number: acknowledgment_step_count,
      total: acknowledgment_step_count) %>

  <%= render Pages::Register::ReviewSummary::Component.new(pages:, page_path: method(:page_path)) %>

  <%= form_with(url: acknowledge_register_path, method: :patch,
      data: {turbo: true, controller: "register--acknowledgment register--retry"}) do %>
    <%= hidden_field_tag :b_param_token, @b_param.id_token %>
    <%= hidden_field_tag :step, "review" %>

    <%= render Pages::Register::AcknowledgmentCheck::Component.new(sequence: @sequence,
        registrant_name:, checkbox_name: :acknowledged_all) %>

    <%# Enabled as rendered - see the note in Pages::Register::StepAcknowledgment %>
    <%= render UI::Button::Component.new(text: translation(".complete_registration", cycle_type: @b_param.type_titleize),
        color: :primary, size: :lg, type: "submit", spinner: true, html_class: "tw:w-full",
        data: {"register--acknowledgment-target": "submit"}) %>

    <%= render Pages::Register::BackLink::Component.new(href: previous_path) %>
  <% end %>
<% end %>
