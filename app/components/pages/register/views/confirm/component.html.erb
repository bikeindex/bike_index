<%= render Pages::Register::Parts::Shell::Component.new do %>
  <div class="tw:px-1 tw:py-6 tw:text-center">
    <%= render UI::Header::Component.new(text: translation(".confirming_your_email"),
        subtitle: translation(".continue_where_you_left_off")) %>

    <% if @signed_in_as.present? %>
      <div class="tw:text-left">
        <%= render UI::Alerts::Base::Component.new(kind: :warning) do %>
          <dl class="tw:space-y-2">
            <div>
              <dt><%= translation(".signed_in_as") %></dt>

              <dd class="tw:font-bold tw:wrap-anywhere">
                <%= @signed_in_as %>
              </dd>
            </div>

            <div>
              <dt><%= translation(".link_is_for") %></dt>

              <dd class="tw:font-bold tw:wrap-anywhere">
                <%= @b_param.owner_email %>
              </dd>
            </div>
          </dl>

          <p class="tw:mt-2">
            <%= @sign_out_to_agree ? translation(".sign_out_to_agree") : translation(".continuing_keeps_you_signed_in") %>
          </p>
        <% end %>
      </div>
    <% end %>

    <% unless @sign_out_to_agree %>
      <%= form_with(url: confirm_email_register_path, method: :post,
        data: {turbo: true, controller: "register--retry"}) do %>
        <%= hidden_field_tag :b_param_token, @b_param.id_token %>
        <%= hidden_field_tag :confirmation_token, @token %>

        <% if @accept_terms %>
          <div class="tw:my-4">
            <%= render UI::Forms::Checkbox::Component.new(name: :terms_of_service, required: true, checked: @terms_checked,
              class_name: "tw:justify-center tw:text-left", label: translation(".i_agree_to_terms")) %>

            <p class="tw:mt-1 tw:text-sm">
              <%= link_to(translation(".read_terms"), terms_path, target: "_blank", class: "twlink") %>
            </p>
          </div>
        <% end %>

        <%= render UI::Button::Component.new(text: translation(".continue"), color: :primary, size: :lg,
          type: "submit", spinner: true, html_class: "tw:w-full") %>
      <% end %>
    <% end %>
  </div>
<% end %>
