<%= render Pages::Register::Parts::Shell::Component.new(embed: @embed, data: {controller: "register--heading",
    "register--heading-names-value": CycleType.slug_translation_hash_lowercase_short.to_json,
    action: "hw-combobox:selection->register--heading#update " \
      "form-persist:restored@window->register--heading#update"}) do %>
  <%# The single page's steps turn on what it's asking, so their count isn't known yet %>
  <% unless @flow.single_page? %>
    <%= render Pages::Register::Parts::Progress::Component.new(flow: @flow, step: 1) %>
  <% end %>

  <% unless @skip_heading %>
    <%= render UI::Header::Component.new(text: heading_text, subtitle:) %>
  <% end %>

  <% if @b_param.errors.any? %>
    <%= render UI::Alerts::Base::Component.new(kind: :error, text: @b_param.errors.full_messages.to_sentence) %>
  <% end %>

  <%= form_with(model: @b_param, url: register_path, method: :post, scope: :b_param, **form_options) do |f| %>
    <%= hidden_field_tag :b_param_token, @b_param.id_token %>

    <%# So the organization survives a submission that has to build a registration %>
    <%= hidden_field_tag :organization_id, organization.id if organization.present? %>

    <%= render UI::Forms::Honeypot::Component.new %>

    <%= render Pages::Register::Parts::Step1Fields::Component.new(b_param: @b_param, form: f,
        current_user: @current_user, organization:) %>

    <%= render Pages::Register::Parts::Step1Submit::Component.new(b_param: @b_param, flow: @flow, organization:,
        current_user: @current_user, button_color: @button_color, button_hover_color: @button_hover_color) %>

    <%= render Pages::Register::Parts::SinglePageStep2::Component.new(b_param: @b_param, flow: @flow, organization:,
        current_user: @current_user, motorized_review: @motorized_review) %>
  <% end %>
<% end %>
