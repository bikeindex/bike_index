<%= render Pages::Register::Page::Component.new(embed: @embed, data: {controller: "register--heading",
    "register--heading-names-value": CycleType.slug_translation_hash_lowercase_short.to_json,
    action: "hw-combobox:selection->register--heading#update " \
      "form-persist:restored@window->register--heading#update"}) do %>
  <%= render Pages::Register::Progress::Component.new(steps: @steps, step: 1) %>

  <% unless @skip_heading %>
    <%= render UI::Header::Component.new(text: heading_text, subtitle: translation(".just_the_essentials")) %>
  <% end %>

  <% if @b_param.errors.any? %>
    <%= render UI::Alerts::Base::Component.new(kind: :error, text: @b_param.errors.full_messages.to_sentence) %>
  <% end %>

  <%= form_with(model: @b_param, url: register_path, method: :post, scope: :b_param, **form_options) do |f| %>
    <%= hidden_field_tag :b_param_token, @b_param.id_token %>

    <%# So the organization survives a submission that has to build a registration %>
    <%= hidden_field_tag :organization_id, organization.id if organization.present? %>

    <%= render UI::Forms::Honeypot::Component.new %>

    <%= render Pages::Register::Step1::Fields::Component.new(b_param: @b_param, form: f, organization:) %>

    <%= render UI::Button::Component.new(text: translation(".next"), color: :primary, size: :lg,
        type: "submit", spinner: true, **button_options) %>

    <% if BikeServices::Register.confirmation_email_pending?(@b_param, user: @current_user) %>
      <p
        class="
          tw:mt-3 tw:text-center tw:text-xs tw:text-gray-500
          tw:dark:text-gray-400
        "
      >
        <%= translation(".no_need_to_wait") %>
      </p>
    <% end %>

    <% if returned_from_step_2? %>
      <p class="tw:mt-3 tw:mb-0 tw:text-center">
        <%= render UI::Button::Component.new(text: translation(".start_over"), color: :link,
            html_class: "tw:text-sm tw:font-medium tw:text-gray-500 tw:hover:text-gray-700 tw:hover:no-underline tw:dark:text-gray-400",
            commandfor: "start-over-modal", command: "show-modal") %>
      </p>
      <%= render UI::Modal::Component.new(id: "start-over-modal", title: translation(".start_over_certain")) do |modal| %>
        <% modal.with_body do %>
          <p class="tw:mb-0">
            <%= translation(".start_over_discards") %>
          </p>

          <div class="tw:mt-5 tw:text-center">
            <%= render UI::ButtonLink::Component.new(text: translation(".yes_start_over"), color: :error,
                href: start_over_path) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
