<%= render Pages::Register::StartPage::Component.new(b_param: @b_param, steps: @steps, organization:,
    current_user: @current_user, subtitle: translation(".just_the_essentials"), embed: @embed,
    skip_heading: @skip_heading) do %>
  <%= fields_for(:b_param, @b_param) do |f| %>
    <%= render Pages::Register::Step1Fields::Component.new(b_param: @b_param, form: f,
        current_user: @current_user, organization:) %>
  <% end %>

  <%= render UI::Button::Component.new(text: translation(".next"), color: :primary, size: :lg,
      type: "submit", spinner: true, **button_options) %>

  <% if BikeServices::Register.confirmation_email_pending?(@b_param, user: @current_user) %>
    <p
      class="
        tw:mt-3 tw:text-center tw:text-xs tw:text-gray-500
        tw:dark:text-gray-400
      "
    >
      <%= translation(".no_need_to_wait") %>
    </p>
  <% end %>

  <% if returned_from_step_2? %>
    <p class="tw:mt-3 tw:mb-0 tw:text-center">
      <%= render UI::Button::Component.new(text: translation(".start_over"), color: :link,
          html_class: "tw:text-sm tw:font-medium tw:text-gray-500 tw:hover:text-gray-700 tw:hover:no-underline tw:dark:text-gray-400",
          commandfor: "start-over-modal", command: "show-modal") %>
    </p>
    <%= render UI::Modal::Component.new(id: "start-over-modal", title: translation(".start_over_certain")) do |modal| %>
      <% modal.with_body do %>
        <p class="tw:mb-0">
          <%= translation(".start_over_discards") %>
        </p>

        <div class="tw:mt-5 tw:text-center">
          <%= render UI::ButtonLink::Component.new(text: translation(".yes_start_over"), color: :error,
              href: start_over_path) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
