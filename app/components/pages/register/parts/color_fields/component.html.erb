<% options = color_options %>

<div data-controller="register--additional-colors">
  <%= render UI::Forms::Group::Component.new(form_builder: @form, attribute: :primary_frame_color_id,
      label_text: translation(".color"), required: true) do |group| %>
    <% group.with_label_note { render UI::Badge::Component.new(text: translation(".up_to_3"), size: :xs) } %>

    <%= render UI::Forms::Combobox::Component.new(name: :primary_frame_color_id, options:,
      rich_display: :inline, no_js: true,
      dialog_label: translation(".color"),
      html_options: {form: @form, value: @primary_frame_color_id, placeholder: translation(".primary_color_blank"), required: true}) %>

    <% additional_color_blanks.each do |field, blank_label| %>
      <% value = @additional_colors[field] %>

      <div
        class="tw:mt-2 tw:flex tw:items-center tw:gap-3 <%= "tw:hidden" if value.blank? %>"
        data-register--additional-colors-target="row"
      >
        <div class="tw:flex-1">
          <%= render UI::Forms::Combobox::Component.new(name: field, options:,
            rich_display: :inline, no_js: true,
            dialog_label: blank_label, html_options: {form: @form, value:, placeholder: blank_label}) %>
        </div>

        <%= render UI::Button::Component.new(text: "×", color: :link,
          html_class: "tw:shrink-0 tw:text-xl tw:leading-none tw:font-bold",
          aria: {label: translation(".remove_additional_color")},
          data: {action: "register--additional-colors#remove"}) %>
      </div>
    <% end %>

    <div
      class="tw:mt-2 <%= "tw:hidden" if @additional_colors.values.all?(&:present?) %>"
      data-register--additional-colors-target="addButton"
    >
      <%= render UI::Button::Component.new(text: "+ #{translation(".add_another_color")}",
        color: :link, html_class: "tw:text-xs tw:font-bold",
        data: {action: "register--additional-colors#add"}) %>
    </div>
  <% end %>
</div>
