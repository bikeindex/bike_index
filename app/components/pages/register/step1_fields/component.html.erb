<%= render Pages::Register::SectionLabel::Component.new(text: translation(".bike_info_html", cycle_type: cycle_type_tag)) %>

<%= render(UI::Forms::Group::Component.new(form_builder: @form, attribute: :manufacturer_id,
    label_text: Manufacturer.model_name.human, required: true)) do %>
  <%# The async combobox reads f.object.manufacturer to display the saved value %>
  <%= render UI::Forms::ComboboxManufacturer::Component.new(frame_maker: true, no_js: true,
      html_options: {form: @form, required: true}) %>
<% end %>

<div
  class="tw:mb-4"
  data-controller="register--propulsion"
  data-action="
    hw-combobox:selection->register--propulsion#update
    form-persist:restored@window->register--propulsion#update
  "
  data-register--propulsion-always-motorized-value="<%= CycleType::ALWAYS_MOTORIZED.to_json %>"
  data-register--propulsion-never-motorized-value="<%= CycleType::NEVER_MOTORIZED.to_json %>"
>
  <% cycle_type_options = CycleType.select_options(traditional_bike: true).map do |label, slug|
      base, parens = label.split(" (", 2)
      content = if parens
        safe_join([base, " ", content_tag(:span, "(#{parens}", class: "tw:text-[#9a9aa2] tw:dark:text-gray-500")])
      else
        label
      end
      {display: label, value: slug, content:}
    end %>

  <%= render(UI::Forms::Group::Component.new(form_builder: @form, attribute: :cycle_type,
      label_text: translation(".vehicle_type"), required: true, wrapper_class: "tw:mb-0")) do %>
    <%= render UI::Forms::Combobox::Component.new(name: :cycle_type, options: cycle_type_options,
        rich_display: :inline, no_js: true, dialog_label: translation(".vehicle_type"),
        html_options: {form: @form, required: true, value: @b_param.cycle_type}) %>
  <% end %>

  <%= render UI::Forms::Checkbox::Component.new(name: :propulsion_type_motorized, value: true,
      checked: @b_param.motorized?, label: translation(".electric_motorized"), class_name: "tw:mt-3",
      data: {"register--propulsion-target": "motorizedWrapper"},
      html_options: {data: {"register--propulsion-target": "motorized", action: "change->register--propulsion#update"}}) %>

  <p class="tw:mt-1.5 tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">
    <%= translation(".electric_helper") %>
  </p>
</div>

<%= render Pages::Register::SectionLabel::Component.new(text: translation(".your_info"), divider: true) %>

<%= render(UI::Forms::Group::Component.new(form_builder: @form, attribute: :owner_email,
    label_text: email_label, required: true, wrapper_class: "tw:mb-6")) do %>
  <%= render UI::Forms::Email::Component.new(form_builder: @form, attribute: :owner_email, required: true,
      html_options: {value: @b_param.owner_email, placeholder: email_placeholder}) %>
<% end %>

<%= render UI::Forms::Turnstile::Component.new(email: @b_param.owner_email, user: @current_user) %>
