<div
  data-controller="search--marketplace-intro"
  data-action="turbo:submit-start@document->search--marketplace-intro#collapse"
>
  <div
    data-search--marketplace-intro-target="expanded"
    class="<%= "tw:hidden" if @collapsed %>"
  >
    <div
      class="
        tw:relative tw:grid tw:items-center tw:gap-10 tw:pb-4
        tw:md:grid-cols-[minmax(0,1fr)_300px] tw:md:pb-6
      "
    >
      <div class="tw:flex tw:flex-col tw:gap-3 tw:sm:gap-4.5">
        <h1
          tabindex="-1"
          data-search--marketplace-intro-target="heading"
          class="
            tw:pr-10 tw:font-header tw:text-[clamp(24px,4vw,42px)]
            tw:leading-[1.1] tw:font-extrabold tw:tracking-[-.01em]
            tw:text-slate-900 tw:outline-none tw:dark:text-gray-100
          "
        >
          <%= translation(".heading") %>
        </h1>

        <p
          class="
            tw:m-0 tw:hidden tw:max-w-[620px] tw:text-[17px]
            tw:leading-[1.55] tw:text-gray-600 tw:sm:block
            tw:dark:text-gray-300
          "
        >
          <%= translation(".description") %>
        </p>

        <ul
          class="
            tw:m-0 tw:flex tw:list-none tw:flex-wrap tw:gap-1.5 tw:p-0
            tw:sm:gap-2.5
          "
        >
          <% trust_chips.each do |chip| %>
            <li
              class="
                tw:inline-flex tw:items-center tw:gap-1.5 tw:rounded-full
                tw:bg-blue-100 tw:px-2.5 tw:py-1 tw:text-[13px]
                tw:font-semibold tw:text-blue-600 tw:sm:gap-2 tw:sm:px-3.5
                tw:sm:py-1.5 tw:sm:text-sm tw:dark:bg-blue-950
                tw:dark:text-blue-300
              "
            >
              <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:size-3.5", aria_hidden: true) %>
              <%= chip %>
            </li>
          <% end %>
        </ul>

        <div
          class="
            tw:flex tw:flex-wrap tw:gap-x-5 tw:gap-y-2 tw:text-[15px]
            tw:font-semibold
          "
        >
          <%= link_to marketplace_how_it_works_path(anchor: "buying"), class: "twlink" do %>
            <%= translation(".how_buying_works") %>
            <span aria-hidden="true">→</span>
          <% end %>

          <%= link_to marketplace_how_it_works_path(anchor: "selling"), class: "twlink" do %>
            <%= translation(".how_selling_works") %>
            <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </div>

      <%# Lazy, so it isn't fetched where it's hidden - below md, or while the intro is collapsed %>
      <%= image_tag "kelsey/illustrations/comic-assets_bike-hero.png", alt: "", loading: "lazy", width: 1768, height: 1320,
        class: "tw:hidden tw:h-auto tw:w-full tw:md:block" %>

      <%# After the content, so tabbing reaches the intro before the control that hides it %>
      <%= render(UI::Button::Component.new(color: :secondary, aria: {label: translation(".hide_intro")},
        data: {action: "search--marketplace-intro#hide"},
        html_class: "tw:absolute tw:top-0 tw:right-0 tw:size-8 tw:rounded-full! tw:border-0! tw:bg-gray-100! tw:p-0! tw:text-slate-900 tw:hover:bg-gray-200! tw:dark:bg-gray-800! tw:dark:text-gray-100 tw:dark:hover:bg-gray-700!")) do %>
        <%= helpers.inline_svg_tag("icons/x.svg", class: "tw:size-3", aria_hidden: true) %>
      <% end %>
    </div>
  </div>

  <div
    data-search--marketplace-intro-target="collapsed"
    class="<%= "tw:hidden" unless @collapsed %>"
  >
    <div
      class="
        tw:mb-4 tw:flex tw:flex-wrap tw:items-center tw:justify-between
        tw:gap-x-6 tw:gap-y-2
      "
    >
      <h1
        class="
          tw:font-header tw:text-[28px] tw:leading-tight tw:font-extrabold
          tw:text-slate-900 tw:dark:text-gray-100
        "
      >
        <%= translation(".marketplace_title") %>
      </h1>

      <%= render(UI::Button::Component.new(text: translation(".what_makes_this_different"), color: :link,
        data: {action: "search--marketplace-intro#show", "search--marketplace-intro-target": "showButton"},
        html_class: "tw:text-[15px] tw:font-semibold")) %>
    </div>
  </div>
</div>
