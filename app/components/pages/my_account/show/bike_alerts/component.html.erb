<div class="tw:-mt-3 tw:flex tw:flex-col tw:gap-4">
  <% @user_alerts.each_with_index do |user_alert, index| %>
    <%= render(UI::Alerts::Base::Component.new(margin_classes: index.zero? ? "tw:mb-0 tw:pt-5!" : "tw:mb-0")) do %>
      <%= translation(".connect_to_org", org_name: user_alert.organization&.short_name, bike_title: @bike.title_string) %>

      <%= render(UI::ButtonLink::Component.new(text: translation(".add_it_now"), href: user_alert_path(id: user_alert.id, add_bike_organization: true), method: :patch, color: :primary, size: :sm, form: {class: "tw:ml-1 tw:inline-block"})) %>

      <div class="tw:mt-2 tw:text-sm">
        <%= render(UI::ButtonLink::Component.new(text: translation(".ignore_this_suggestion"), href: user_alert_path(id: user_alert.id, alert_action: "dismiss"), method: :patch, color: :link_gray, html_class: "tw:py-1")) %>
      </div>
    <% end %>
  <% end %>
</div>
