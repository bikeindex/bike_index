<li class="<%= class_names("tw:flex tw:flex-col", "tw:min-w-0": grid?) %>">
  <% if @unfinished_b_param && !grid? %>
    <div class="tw:mb-2">
      <%= render(Pages::MyAccount::Show::BikeAlerts::Component.new(bike: @bike, current_user: @current_user, unfinished_b_param: @unfinished_b_param)) %>
    </div>
  <% end %>

  <% cache(cache_key) do %>
    <% if grid? %>
      <div
        class="
          tw:flex tw:h-full tw:flex-col tw:overflow-hidden tw:rounded-[10px]
          tw:border tw:border-gray-200 tw:bg-white tw:dark:border-gray-700
          tw:dark:bg-gray-900
        "
      >
        <%= link_to photo_path, class: "tw:relative tw:flex tw:h-[170px] tw:items-center tw:justify-center tw:bg-gray-100 tw:text-gray-300 tw:dark:bg-gray-800 tw:dark:text-gray-600", aria: {label: photo_label} do %>
          <% if thumb_image_url %>
            <%= image_tag(thumb_image_url, alt: @bike.title_string, skip_pipeline: true, class: "tw:size-full tw:object-cover") %>
          <% else %>
            <%= helpers.inline_svg_tag("icons/lucide-bike.svg", class: "tw:size-[72px]", aria_hidden: true) %>
          <% end %>

          <span class="tw:absolute tw:top-3 tw:right-3"><%= render(Atoms::RegistrationStatusBadge::Component.new(bike: @bike, size: :lg, time: status_time)) %></span>
        <% end %>

        <div class="tw:flex tw:flex-1 tw:flex-col tw:gap-2 tw:px-4 tw:py-3.5">
          <%= link_to title_html, bike_path(@bike), class: "tw:text-[17px] tw:text-pretty tw:text-slate-700 tw:no-underline tw:dark:text-gray-100" %>

          <div
            class="
              tw:flex tw:items-center tw:gap-2 tw:text-[15px]
              tw:text-gray-500 tw:dark:text-gray-400
            "
          >
            <%= render(UI::ColorSwatch::Component.new(display: @bike.primary_frame_color&.display, name: @bike.primary_frame_color&.name, size: :sm)) %>
            <%= @bike.frame_colors.to_sentence %>
          </div>

          <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2.5">
            <%= render(UI::Badge::Component.new(text: @bike.type_titleize, color: :gray)) %>

            <span class="tw:font-mono tw:text-sm tw:text-gray-500 tw:dark:text-gray-400">
              <%= render(Atoms::Serial::Component.new(bike: @bike, user: @current_user, explanation: :tooltip)) %>
            </span>
          </div>
        </div>

        <div
          class="
            tw:flex tw:flex-wrap tw:gap-x-3 tw:gap-y-1 tw:border-t
            tw:border-gray-100 tw:px-4 tw:py-3 tw:text-sm tw:font-semibold
            tw:dark:border-gray-800
          "
        >
          <%= link_to translation(".edit"), edit_bike_path(@bike, edit_template: @bike.default_edit_template), class: "twlink tw:py-1" %>

          <% if @bike.status_with_owner? %>
            <%= link_to sale_link_text, edit_bike_path(@bike, edit_template: "marketplace"), class: "tw:py-1 tw:text-purple-600 tw:dark:text-purple-300" %>
            <%= link_to translation(".report_stolen"), edit_bike_path(@bike, edit_template: "report_stolen"), class: "tw:ml-auto tw:py-1 tw:text-red-600 tw:dark:text-red-400" %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="<%= class_names("tw:flex tw:flex-wrap tw:items-stretch tw:gap-[18px] tw:rounded-[10px] tw:border tw:border-l-[5px] tw:border-gray-200 tw:bg-white tw:p-3.5 tw:dark:border-gray-700 tw:dark:bg-gray-900", accent_classes) %>">
        <%= link_to photo_path, class: "tw:flex tw:h-[124px] tw:flex-none tw:basis-[180px] tw:items-center tw:justify-center tw:overflow-hidden tw:rounded-lg tw:bg-gray-100 tw:text-gray-300 tw:dark:bg-gray-800 tw:dark:text-gray-600", aria: {label: photo_label} do %>
          <% if thumb_image_url %>
            <%= image_tag(thumb_image_url, alt: @bike.title_string, skip_pipeline: true, class: "tw:size-full tw:object-cover") %>
          <% else %>
            <%= helpers.inline_svg_tag("icons/lucide-bike.svg", class: "tw:size-16", aria_hidden: true) %>
          <% end %>
        <% end %>

        <div
          class="
            tw:flex tw:min-w-0 tw:flex-1 tw:basis-70 tw:flex-col
            tw:justify-center tw:gap-2.5
          "
        >
          <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2.5">
            <%= render(Atoms::RegistrationStatusBadge::Component.new(bike: @bike, size: :lg, time: status_time)) %>
            <%= link_to title_html, bike_path(@bike), class: "tw:text-lg tw:text-slate-700 tw:no-underline tw:dark:text-gray-100" %>
          </div>

          <div
            class="
              tw:flex tw:flex-wrap tw:items-center tw:gap-3 tw:text-[15px]
              tw:text-gray-500 tw:dark:text-gray-400
            "
          >
            <span class="tw:flex tw:items-center tw:gap-[7px]">
              <%= render(UI::ColorSwatch::Component.new(display: @bike.primary_frame_color&.display, name: @bike.primary_frame_color&.name, size: :sm)) %>
              <%= @bike.frame_colors.to_sentence %>
            </span>

            <%= render(UI::Badge::Component.new(text: @bike.type_titleize, color: :gray)) %>
          </div>

          <div class="tw:flex">
            <span
              class="
                tw:rounded-[5px] tw:border tw:border-gray-200 tw:bg-gray-50
                tw:px-2.5 tw:py-1 tw:font-mono tw:text-[15px]
                tw:dark:border-gray-700 tw:dark:bg-gray-800
              "
            >
              <%= render(Atoms::Serial::Component.new(bike: @bike, user: @current_user, explanation: :tooltip)) %>
            </span>
          </div>
        </div>

        <div
          class="
            tw:flex tw:flex-none tw:flex-col tw:items-start
            tw:justify-center tw:gap-2 tw:px-2 tw:text-[15px]
            tw:font-semibold
          "
        >
          <%= link_to translation(".edit_registration", bike_type: @bike.type_titleize&.downcase), edit_bike_path(@bike, edit_template: @bike.default_edit_template), class: "twlink tw:py-1" %>

          <% if @bike.status_with_owner? %>
            <%= link_to sale_link_text, edit_bike_path(@bike, edit_template: "marketplace"), class: "tw:py-1 tw:text-purple-600 tw:dark:text-purple-300" %>
            <%= link_to translation(".report_stolen"), edit_bike_path(@bike, edit_template: "report_stolen"), class: "tw:py-1 tw:text-red-600 tw:dark:text-red-400" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if @user_alerts.any? && !grid? %>
    <div class="tw:mt-2">
      <%= render(Pages::MyAccount::Show::BikeAlerts::Component.new(bike: @bike, current_user: @current_user, user_alerts: @user_alerts)) %>
    </div>
  <% end %>
</li>
