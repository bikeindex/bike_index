<li class="tw:flex tw:flex-col tw:gap-2">
  <%= render(Pages::MyAccount::Show::BikeAlerts::Component.new(bike: @bike, current_user: @current_user, unfinished_b_param: @unfinished_b_param)) %>

  <% cache(cache_key) do %>
    <%= render(UI::Card::Component.new(additional_classes: class_names("tw:relative tw:z-10 tw:flex tw:flex-wrap tw:items-stretch tw:gap-[18px] tw:border-l-[5px]", accent_classes))) do %>
      <%= link_to photo_path, class: "tw:relative tw:flex tw:h-[124px] tw:flex-none tw:basis-[180px] tw:items-center tw:justify-center tw:overflow-hidden tw:rounded-lg tw:bg-gray-100 tw:dark:bg-gray-900" do %>
        <% if thumb_image_url %>
          <%= image_tag(thumb_image_url, alt: @bike.title_string, skip_pipeline: true, class: "tw:size-full tw:object-cover") %>
        <% else %>
          <%= image_tag(helpers.bike_placeholder_image_path, alt: @bike.title_string, class: "tw:size-full tw:object-contain tw:p-4") %>
        <% end %>

        <%= add_photo_prompt %>
      <% end %>

      <div
        class="
          tw:flex tw:min-w-0 tw:flex-1 tw:basis-70 tw:flex-col
          tw:justify-center tw:gap-2.5
        "
      >
        <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2.5">
          <%= render(Atoms::RegistrationStatusBadge::Component.new(bike: @bike, size: :lg, time: @bike.occurred_at)) %>
          <%= link_to title_html, bike_path(@bike), class: "tw:text-lg tw:text-slate-700 tw:no-underline tw:dark:text-gray-100" %>
        </div>

        <div
          class="
            tw:flex tw:flex-wrap tw:items-center tw:gap-3 tw:text-[15px]
            tw:text-gray-500 tw:dark:text-gray-400
          "
        >
          <span class="tw:flex tw:items-center tw:gap-[7px]">
            <%= render(UI::ColorSwatch::Component.new(display: @bike.primary_frame_color&.display, name: @bike.primary_frame_color&.name, size: :sm)) %>
            <%= @bike.frame_colors.to_sentence %>
          </span>

          <%= render(UI::Badge::Component.new(text: @bike.type_titleize, color: :gray)) %>

          <% if @bike.user_hidden %>
            <%= render(UI::Badge::Component.new(text: translation(".user_hidden"), color: :warning)) %>
          <% end %>

          <%= strava_gear_link %>
        </div>

        <div class="tw:flex">
          <span
            class="
              tw:rounded-[5px] tw:border tw:border-gray-200 tw:bg-gray-50
              tw:px-2.5 tw:py-1 tw:font-mono tw:text-[15px]
              tw:dark:border-gray-700 tw:dark:bg-gray-900
            "
          >
            <%= render(Atoms::Serial::Component.new(bike: @bike, user: @current_user, explanation: :tooltip)) %>
          </span>
        </div>

        <div
          class="
            tw:flex tw:flex-wrap tw:gap-x-3 tw:gap-y-1 tw:text-sm
            tw:text-gray-500 tw:dark:text-gray-400
          "
        >
          <span><%= translation(".registered") %> <%= render(UI::Time::Component.new(time: @bike.created_at)) %></span>
          <span><%= translation(".updated") %> <%= render(UI::Time::Component.new(time: @bike.updated_by_user_fallback)) %></span>

          <% if bike_sticker_codes.any? %>
            <span>
              <%= translation(".bike_sticker").pluralize(bike_sticker_codes.size) %>:
              <%= safe_join(bike_sticker_codes.map { tag.code(it) }, ", ") %>
            </span>
          <% end %>

          <% if location.present? %>
            <span><%= translation(".location") %>: <%= location %></span>
          <% end %>
        </div>

        <%= impound_claim_note %>
      </div>

      <div
        class="
          tw:flex tw:flex-none tw:flex-col tw:items-start tw:justify-center
          tw:gap-2 tw:px-2 tw:text-[15px] tw:font-semibold
        "
      >
        <%= link_to translation(".edit_registration", bike_type: @bike.type), edit_bike_path(@bike, edit_template: @bike.default_edit_template), class: "twlink tw:py-1" %>

        <% if @bike.status_with_owner? %>
          <%= link_to sale_link_text, edit_bike_path(@bike, edit_template: "marketplace"), class: "tw:py-1 tw:text-purple-600 tw:dark:text-purple-300" %>
          <%= link_to translation(".report_stolen"), edit_bike_path(@bike, edit_template: "report_stolen"), class: "tw:py-1 tw:text-red-600 tw:dark:text-red-400" %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render(Pages::MyAccount::Show::BikeAlerts::Component.new(bike: @bike, current_user: @current_user, user_alerts: @user_alerts, under_card: true)) %>
</li>
