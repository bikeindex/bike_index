<div class="twgutter tw:py-8 tw:lg:py-12">
  <%= render(UI::Container::Component.new) do %>
    <%= render(UI::Header::Component.new(text: translation(".is_this_the_same", bike_type:))) %>

    <p>
      <% if shop_name.present? %>
        <%= translation(".shop_registered_it", shop_name:, bike_type:) %>
      <% else %>
        <%= translation(".pos_registered_it", bike_type:) %>
      <% end %>
    </p>

    <div class="tw:my-6 tw:grid tw:gap-6 tw:md:grid-cols-2">
      <div>
        <h3 class="tw:mb-2 tw:font-bold">
          <%= translation(".registered_when_you_bought_it") %>
        </h3>

        <%= render(UI::DefinitionList::Container::Component.new) do %>
          <%= render(UI::DefinitionList::Row::Component.new(label: translation(".registration"),
            value: link_to(@pos_bike.title_string, bike_path(@pos_bike), class: "twlink"))) %>

          <%= render(UI::DefinitionList::Row::Component.new(label: translation(".serial"),
            value: render(Atoms::Serial::Component.new(bike: @pos_bike)))) %>

          <%= render(UI::DefinitionList::Row::Component.new(label: translation(".registered"),
            value: render(UI::Time::Component.new(time: @pos_bike.created_at)))) %>
        <% end %>
      </div>

      <div>
        <h3 class="tw:mb-2 tw:font-bold">
          <%= translation(".your_registration") %>
        </h3>

        <%= render(UI::DefinitionList::Container::Component.new) do %>
          <%= render(UI::DefinitionList::Row::Component.new(label: translation(".registration"),
            value: link_to(@bike.title_string, bike_path(@bike), class: "twlink"))) %>

          <%= render(UI::DefinitionList::Row::Component.new(label: translation(".serial"),
            value: render(Atoms::Serial::Component.new(bike: @bike)))) %>

          <%= render(UI::DefinitionList::Row::Component.new(label: translation(".registered"),
            value: render(UI::Time::Component.new(time: @bike.created_at)))) %>
        <% end %>
      </div>
    </div>

    <p><%= translation(".combining_keeps", bike_type:) %></p>

    <%= form_with(url: my_account_pos_registration_match_path(@pos_registration_match), method: :patch,
      class: "tw:mt-4 tw:flex tw:flex-wrap tw:gap-3") do %>
      <%= render(UI::Button::Component.new(text: translation(".yes_combine_them"), color: :primary, type: "submit",
        name: "same_bike", value: "true")) %>

      <%= render(UI::Button::Component.new(text: translation(".no_theyre_different", bike_type:), type: "submit",
        name: "same_bike", value: "false")) %>
    <% end %>
  <% end %>
</div>
