<div class="tw:mx-auto tw:max-w-6xl tw:px-5 tw:py-10 tw:twtext-color">
  <%= render(UI::Header::Component.new(text: translation(".title"), subtitle: translation(".subtitle_html",
    document: render(UI::Code::Inline::Component.new(text: @document)),
    url: link_to(url, url, class: "twlink tw:break-all tw:underline"), version: @viewer["schema_version"]))) %>

  <%= render(UI::Tabs::Component.new(nav_label: translation(".documents"), tabs:)) %>

  <div
    class="tw:overflow-x-auto tw:font-mono tw:text-sm tw:leading-6"
    data-controller="bikebook--schema-fields"
  >
    <div>{</div>

    <div class="tw:pl-4">
      <%= render(Pages::Bikebook::SchemaFields::Component.new(fields: @viewer.dig("documents", @document, "fields"),
        open: @open, by_count: @by_count, representative_ids: @viewer["representative_ids"], cache_key: [@viewer["digest"], @document])) %>
    </div>

    <div>}</div>
  </div>

  <p class="tw:mt-8 tw:text-sm tw:text-gray-600 tw:dark:text-gray-400">
    <strong><%= translation(".versioning") %></strong> <%= @viewer["versioning"] %>
  </p>
</div>
