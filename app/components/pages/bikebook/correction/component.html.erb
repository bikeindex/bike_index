<% cache(@user.present?) do %>
  <div
    data-controller="bikebook--correction"
    data-bikebook--correction-modal-param-value="modal_<%= MODAL_ID %>"
  >
    <p class="twgutter tw:mx-auto tw:max-w-screen-xl tw:pb-6 tw:text-sm">
      <%= translation(".see_something_wrong") %>
      <%= trigger(translation(".submit_a_correction"), color: :link, data: {"bikebook--correction-target": "link"}) %>
    </p>

    <div
      class="
        tw:fixed tw:right-4 tw:bottom-4 tw:z-40 tw:flex tw:hidden!
        tw:items-center tw:gap-2 tw:print:hidden
      "
      data-bikebook--correction-target="floating"
    >
      <%= render(UI::Button::Component.new(color: :secondary, size: :sm, html_class: "tw:shadow-lg", aria: {label: translation(".hide")},
        data: {action: "bikebook--correction#dismiss"})) do %>
        <%= helpers.inline_svg_tag("icons/x.svg", class: "tw:size-3", aria_hidden: true) %>
      <% end %>

      <%= trigger(safe_join([helpers.inline_svg_tag("icons/chat.svg", class: "tw:size-4", aria_hidden: true), translation(".submit_a_correction")]),
        color: :primary, size: :callout_sm, html_class: "tw:shadow-lg") %>
    </div>

    <% if @user %>
      <%= render(UI::Modal::Component.new(id: MODAL_ID, title: translation(".submit_a_correction"))) do |modal| %>
        <% modal.with_body do %>
          <p class="tw:mb-4 tw:text-sm">
            <%= translation(".description") %>
          </p>

          <%= form_with scope: :correction, url: bikebook_corrections_path, id: FORM_ID, authenticity_token: false,
            data: {action: "bikebook--correction#submit"} do |f| %>
            <%= f.hidden_field :page_url, data: {"bikebook--correction-target": "pageUrl"} %>

            <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :body, kind: :text_area, required: true,
              label_text: translation(".whats_wrong"), html_options: {rows: 5})) %>

            <%= render(UI::Button::Component.new(text: translation(".send"), color: :primary, type: "submit",
              html_class: "tw:w-full")) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @user %>
  <%# Each session's, which the cached form can't hold %>
  <%= hidden_field_tag(helpers.request_forgery_protection_token, helpers.form_authenticity_token, form: FORM_ID, id: nil, autocomplete: "off") %>
<% end %>
