<div class="tw:px-1 tw:py-6">
  <div class="tw:flex tw:items-start tw:gap-4">
    <div
      class="
        tw:flex tw:h-16 tw:w-16 tw:flex-none tw:items-center
        tw:justify-center tw:rounded-full tw:bg-green-100 tw:text-green-600
        tw:dark:bg-green-950 tw:dark:text-green-400
      "
    >
      <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:h-7.5 tw:w-7.5", aria_hidden: true) %>
    </div>

    <div>
      <%= render UI::Header::Component.new(text: translation(".org_is_active", name: @organization.name), html_class: "uncap",
          subtitle: (translation(".organization_set_up_next_steps") if @few_registrations || @few_members)) %>
    </div>
  </div>

  <div class="tw:flex tw:max-w-md tw:flex-col tw:gap-2.5">
    <% if @return_to.present? %>
      <%= render UI::ButtonLink::Component.new(text: translation(".continue_where_you_were"), href: @return_to,
          color: :primary, size: :lg, html_class: "tw:w-full") %>
    <% end %>

    <% if @few_registrations %>
      <%= render UI::ButtonLink::Component.new(text: translation(".add_a_registration"), size: :lg, html_class: "tw:w-full",
          color: @return_to.present? ? :secondary : :primary,
          href: new_organization_registration_path(organization_id:)) %>
    <% end %>

    <% if admin? && @few_members %>
      <%= render UI::ButtonLink::Component.new(text: translation(".invite_your_team"), size: :lg, html_class: "tw:w-full",
          href: new_organization_user_path(organization_id:)) %>
    <% end %>
  </div>

  <%= render(UI::Card::Component.new(additional_classes: "tw:mt-10 tw:max-w-md")) do %>
    <p class="twlabel tw:mb-1 tw:text-sm tw:font-semibold">
      <%= translation(".your_public_registration_link") %>
    </p>

    <%= render Atoms::CopyableCode::Component.new(value: registration_url, label: translation(".copy_registration_link")) %>

    <p class="tw:mt-2 tw:mb-0 tw:text-sm tw:text-gray-500 tw:dark:text-gray-400">
      <%= translation(".associated_with_org_html", org_name: @organization.name) %>
    </p>

    <p class="tw:mt-4 tw:mb-0 tw:text-sm tw:text-gray-500 tw:dark:text-gray-400">
      <%= translation(".get_qr_code_html",
            qr_code_link: link_to(translation(".qr_code"), register_organization_path(@organization, format: :png), class: "twlink")) %>
    </p>
  <% end %>

  <%# is_invoiced? rather than paid_money?, which a $0 invoice - the usual endless one - leaves false %>
  <% if @organization.is_invoiced? %>
    <p class="tw:mt-6 tw:mb-0 tw:text-gray-500 tw:dark:text-gray-400">
      <%= translation(".has_paid_functionality") %>

      <% if (due_at = next_invoice_due_at) %>
        <%= translation(".next_invoice_due_html", time: render(UI::Time::Component.new(time: due_at, preposition: true))) %>
      <% elsif endless_invoice? %>
        <%= translation(".no_invoices_upcoming") %>
      <% end %>
    </p>
  <% end %>

  <% if new_passwordless_user? %>
    <p class="tw:mt-4 tw:mb-0 tw:text-gray-500 tw:dark:text-gray-400">
      <%= translation(".no_password_yet") %>
      <%= link_to translation(".set_a_password"), update_password_form_with_reset_token_users_path, class: "twlink" %>
    </p>
  <% end %>
</div>
