<%= tag.div(class: "org-search-component tw:rounded-xl #{UI::Card::Component::BASE_CLASSES}", data:) do %>
  <div class="tw:flex tw:items-center tw:justify-end tw:px-4 tw:py-3">
    <%= render(UI::Button::Component.new(size: :sm, aria: {expanded: false},
      data: {action: "click->ui--collapse#toggle", "ui--collapse-target": "trigger"})) do %>
      column settings
      <span data-ui--collapse-target="chevron" class="tw:inline-flex tw:transition-transform"><%= render(UI::IconChevron::Component.new) %></span>
    <% end %>
  </div>

  <div class="tw:px-4">
    <%= render(Pages::Org::Search::Settings::Component.new(settings:, toggle_button: false)) %>
  </div>
<% end %>
