<%= tag.div(data: collapse_data_attributes) do %>
  <div
    class="
      tw:my-4 tw:hidden! tw:rounded-lg tw:border tw:border-gray-300/70
      tw:bg-gray-100 tw:px-3 tw:pt-4 tw:pb-3 tw:dark:border-gray-700
      tw:dark:bg-gray-900
    "
    data-ui--collapse-target="content"
  >
    <div class="tw:mb-3 tw:flex tw:flex-wrap tw:items-baseline tw:gap-2">
      <%= render(UI::Header::Component.new(text: translation(".visible_columns"), tag: :h3, html_class: "header-font-alt uncap tw:mb-0! tw:pr-1")) %>

      <%= render UI::Button::Component.new(text: translation(".all"), color: :link,
          data: { action: "click->org--search-column-toggle#selectAll" }) %>

      <%= render UI::Button::Component.new(text: translation(".none"), color: :link,
          data: { action: "click->org--search-column-toggle#selectNone" }) %>

      <%= render UI::Button::Component.new(text: translation(".default"), color: :link,
          data: { action: "click->org--search-column-toggle#selectDefault" }) %>
    </div>

    <% column_rows = (enabled_columns.size / 3.0).ceil %>

    <div
      class="
        tw:grid tw:grid-cols-2 tw:gap-x-1 tw:gap-y-3 tw:md:grid-flow-col
        tw:md:grid-cols-3
      "
      style="grid-template-rows: repeat(<%= column_rows %>, auto)"
      data-org--search-column-toggle-target="checkboxes"
    >
      <% enabled_columns.each do |cell_name| %>
        <label
          class="
            tw:mb-0! tw:flex tw:cursor-pointer tw:items-center tw:gap-1
            tw:leading-[1.25]!
          "
        >
          <%= check_box_tag cell_name, cell_name, false,
            data: { action: "change->org--search-column-toggle#columnToggled" } %>

          <%= column_renames[cell_name.to_sym] %>
        </label>
      <% end %>
    </div>

    <% if render_export? %>
      <div
        class="
          tw:mt-4 tw:border-t tw:border-gray-300/70 tw:pt-3 tw:text-right
          tw:dark:border-gray-700
        "
      >
        <%= render(UI::ButtonLink::Component.new(text: translation(".export_csv"), href: export_path,
          color: :purple, size: :sm, data: {turbo_frame: "_top", "org--search-target": "exportLink"})) %>
      </div>
    <% end %>
  </div>

  <% if @toggle_button %>
    <div class="tw:mt-2 tw:flex tw:items-center tw:justify-end tw:gap-4">
      <%= render(UI::Button::Component.new(color: :primary, size: :sm, aria: {expanded: false}, data: {action: "click->ui--collapse#toggle", "ui--collapse-target": "trigger"})) do %>
        <%= translation(".settings") %>
        <%= helpers.inline_svg_tag "icons/settings_slider.svg", class: "tw:inline", alt: "settings icon" %>
      <% end %>
    </div>
  <% end %>
<% end %>
