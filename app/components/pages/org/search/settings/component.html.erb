<div
  class="[&_.form-group]:tw:mb-0 tw:my-4 tw:border tw:border-gray-300/70 tw:bg-gray-100 tw:px-3 tw:pt-4 tw:pb-3 <%= 'tw:hidden!' unless @settings.default_open? %>"
  data-org--search-target="settings"
>
  <div class="tw:mb-1 tw:flex tw:items-baseline tw:gap-2">
    <%= render(UI::Header::Component.new(text: translation(".visible_columns"), tag: :h3, html_class: "header-font-alt tw:mb-4! tw:pr-1")) %>

    <%= render UI::Button::Component.new(text: translation(".all"), color: :link,
          data: { action: "click->org--search-column-toggle#selectAll" }) %>

    <%= render UI::Button::Component.new(text: translation(".none"), color: :link,
          data: { action: "click->org--search-column-toggle#selectNone" }) %>

    <%= render UI::Button::Component.new(text: translation(".default"), color: :link,
          data: { action: "click->org--search-column-toggle#selectDefault" }) %>
  </div>

  <% column_rows = (@settings.enabled_columns.size / 3.0).ceil %>

  <div
    class="
      tw:grid tw:grid-cols-2 tw:gap-x-1 tw:gap-y-3 tw:pb-6
      tw:md:grid-flow-col tw:md:grid-cols-3
    "
    style="grid-template-rows: repeat(<%= column_rows %>, auto)"
    data-org--search-column-toggle-target="checkboxes"
  >
    <% @settings.enabled_columns.each do |cell_name| %>
      <label
        class="
          tw:mb-0! tw:flex tw:cursor-pointer tw:items-center tw:gap-1
          tw:leading-[1.25]!
        "
      >
        <%= check_box_tag cell_name, cell_name, false,
            data: { action: "change->org--search-column-toggle#columnToggled" } %>

        <%= @settings.column_renames[cell_name.to_sym] %>
      </label>
    <% end %>
  </div>

  <% unless @skip_search_and_filters %>
    <% @settings.filter_groups.each do |group| %>
      <div class="tw:mb-3 tw:flex tw:flex-wrap tw:items-baseline tw:gap-1">
        <span class="sort-group-label"><%= group[:label] %></span>

        <%= render UI::Forms::RadioButtonGroup::Component.new(
          name: group[:name],
          selected: group[:selected],
          entries: group[:entries],
          form: "Search_Form",
          data: {action: "change->org--search#filterChanged"}
        ) %>
      </div>
    <% end %>
    <div
      class="
        tw:mt-6 tw:mb-3 tw:flex tw:flex-wrap tw:items-center
        tw:justify-between tw:gap-2
      "
    >
      <% if @settings.organization.enabled?("registration_notes") %>
        <button
          type="button"
          class="btn btn-sm btn-outline-secondary uncap"
          data-action="click->org--search#toggleNotesSearch"
          data-org--search-target="notesButton"
        >
          <%= translation(".show_notes_search") %>
        </button>
      <% end %>

      <% if @settings.organization.enabled?("csv_exports") %>
        <div class="tw:ml-auto tw:text-right">
          <%= link_to translation(".create_export_of_vehicles", cycle_type: @settings.cycle_type.pluralize(2)),
              organization_registrations_path(@settings.search_params.merge(create_export: true)),
              class: "gray-link", data: {turbo_frame: "_top", "org--search-target": "exportLink"} %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="tw:mt-2 tw:flex tw:items-center tw:justify-end tw:gap-4">
  <%= render(UI::Button::Component.new(color: :primary, size: :sm, active: @settings.default_open?, aria: {expanded: @settings.default_open?}, data: {action: "click->org--search#toggleSettings", "org--search-target": "settingsButton"})) do %>
    <%= translation(".settings") %>
    <%= helpers.inline_svg_tag "icons/settings_slider.svg", class: "tw:inline", alt: "settings icon" %>
  <% end %>
</div>
