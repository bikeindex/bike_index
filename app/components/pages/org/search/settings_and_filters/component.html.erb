<div
  data-controller="ui--collapse"
  data-ui--collapse-storage-key-value="orgRegistrationFiltersOpen"
>
  <div class="tw:mt-3 tw:flex tw:flex-wrap tw:items-center tw:gap-2">
    <%= render(UI::Collapse::Component.new(chevron: :trailing, size: :sm,
      title: translation(".search_settings_and_filters"))) do %>
      <span class="tw:sm:hidden"><%= translation(".filters") %></span>
      <span class="tw:hidden tw:sm:inline"><%= translation(".search_settings_and_filters") %></span>

      <%# aria_hidden, not aria: - inline_svg drops the hash and leaves role="img" unlabelled %>
      <%= helpers.inline_svg_tag "icons/gear.svg", class: "tw:inline tw:h-4 tw:w-4", aria_hidden: true %>
    <% end %>

    <span class="tw:text-sm">
      <%= translation(".date_range") %>
      <span class="tw:font-bold" data-org--search-target="periodLabel"><%= period_label %></span>
    </span>

    <%#
      Rebuilt by org--search on every filter change: this row renders outside the results
      frame, so a search doesn't bring a fresh one back from the server
    %>

    <% descriptions = active_search_filter_descriptions %>

    <%# The separator is a ::before so it hides along with the summary %>
    <%= tag.em(safe_join(descriptions, " · "), class: "less-strong tw:text-sm tw:before:mr-2 tw:before:content-['·']",
      hidden: descriptions.none?, data: {"org--search-target": "filterSummary"}) %>
  </div>

  <div
    class="
      tw:mt-3 tw:flex tw:hidden! tw:flex-col tw:gap-3 tw:rounded-xl
      tw:border tw:border-gray-200 tw:bg-gray-50 tw:p-4
      tw:dark:border-gray-700 tw:dark:bg-gray-900
    "
    data-ui--collapse-target="content"
  >
    <%= render(UI::Header::Component.new(text: translation(".search_settings_and_filters"), tag: :h3, html_class: "uncap tw:mb-0!")) %>

    <div class="tw:flex tw:flex-col tw:gap-6">
      <% filter_groups.each do |group| %>
        <div class="tw:flex tw:flex-wrap tw:items-baseline tw:gap-x-4 tw:gap-y-2">
          <span class="tw:text-sm tw:font-bold tw:text-gray-500"><%= group[:label] %></span>

          <%# flex-1: the chips shrink and wrap beside their label rather than below it %>
          <div class="tw:min-w-0 tw:flex-1">
            <%= render(group_chips(group)) %>
          </div>
        </div>
      <% end %>

      <div class="tw:flex tw:flex-wrap tw:items-baseline tw:gap-x-4 tw:gap-y-2">
        <span class="tw:text-sm tw:font-bold tw:text-gray-500"><%= translation(".date_range") %></span>

        <%#
          PeriodSelect right-aligns for the page corner it sits in everywhere else;
          here its rows line up with the chip groups above
        %>

        <div class="tw:min-w-0 tw:flex-1">
          <%= render(UI::PeriodSelect::Component.new(period: @period, start_time: @start_time,
            end_time: @end_time, sortable_search_params: @sortable_search_params, size: :md,
            form: "Search_Form")) %>
        </div>
      </div>
    </div>

    <div
      class="
        tw:flex tw:flex-col tw:gap-2 tw:border-t tw:border-gray-200 tw:pt-3
        tw:dark:border-gray-700
      "
    >
      <% if notes_search? %>
        <label class="tw:mb-0! tw:flex tw:cursor-pointer tw:items-center tw:gap-2">
          <%= check_box_tag :show_notes_search, "1", false, data: {field: "notes",
            action: "change->org--search#toggleOptionalField", "org--search-target": "optionalFieldCheckbox"} %>

          <%= notes_search_label %>
        </label>
      <% end %>

      <div class="tw:flex tw:items-center tw:gap-2">
        <label
          class="
            tw:mb-0! tw:flex tw:cursor-pointer tw:items-center tw:gap-2
            tw:has-disabled:cursor-not-allowed tw:has-disabled:opacity-50
          "
        >
          <%= check_box_tag :show_location_search, "1", false, disabled: location_search_disabled?,
            data: {field: "location", reg_address: organization.enabled?("reg_address"),
              action: "change->org--search#toggleOptionalField", "org--search-target": "optionalFieldCheckbox"} %>

          <%= location_search_label %>
        </label>

        <%= tag.span(render(UI::Tooltip::Component.new(text: location_search_disabled_hint)),
          class: "tw:leading-none", hidden: !location_search_disabled?,
          data: {"org--search-target": "locationSearchHint"}) %>
      </div>
    </div>
  </div>
</div>
