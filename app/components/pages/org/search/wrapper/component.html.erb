<%= tag.div(class: card_classes, data: card_data_attributes) do %>
  <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-x-4 tw:gap-y-2 tw:py-3 <%= padding_x_class %>">
    <%#
      Sized to its content, so the count grows only once the toggle wraps under it - which
      puts the toggle at the right
    %>

    <div
      class="
        tw:flex tw:flex-wrap tw:items-baseline tw:justify-end tw:gap-x-4
        tw:gap-y-2
      "
    >
      <p class="tw:mb-0 tw:grow">
        <%= count_html %>
      </p>

      <% if @search_page %>
        <div class="tw:flex tw:items-baseline tw:gap-2">
          <span
            class="
              tw:text-2xs tw:font-bold tw:tracking-wider tw:text-gray-400
              tw:uppercase
            "
          >
            <%= translation(".view_as") %>
          </span>

          <%= render(UI::ButtonGroup::Component.new(entries: result_view_entries, kind: :toggle)) %>
        </div>
      <% end %>
    </div>

    <% if result_component %>
      <%# Without ml-auto, justify-between leaves it at the left once it wraps %>
      <% if ordered_by_text %>
        <p class="tw:mb-0 tw:text-sm tw:text-gray-500 tw:dark:text-gray-400">
          <%= ordered_by_text %>
          <%= render(UI::Tooltip::Component.new(text: translation(".ordered_by_tooltip"))) %>
        </p>
      <% end %>
    <% else %>
      <%# Columns and the export are the table's alone %>
      <div class="tw:ml-auto tw:flex tw:flex-wrap tw:items-center tw:gap-2">
        <%= render(Pages::Org::Search::ColumnSettingsToggle::Component.new) %>

        <%# Only the search's own params describe an export of what's on the page %>
        <% if @search_page && settings.render_export? %>
          <div class="tw:hidden tw:sm:block">
            <% if settings.export_disabled? %>
              <%= render(UI::Tooltip::Component.new) do |tooltip| %>
                <%# The checkbox it names reads the same way %>
                <% tooltip.with_body { translation(".export_unavailable_search_all") } %>

                <%= render(UI::ButtonLink::Component.new(text: translation(".export_csv"), href: nil,
                  color: :primary, size: :sm, disabled: true)) %>
              <% end %>
            <% else %>
              <%= render(UI::ButtonLink::Component.new(text: translation(".export_csv"), href: export_path,
                color: :primary, size: :sm, data: {turbo_frame: "_top"})) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% unless result_component %>
    <%= render(Pages::Org::Search::ColumnSettings::Component.new(settings:)) %>
  <% end %>

  <%# Only on the search: the model audit's own page already names the audit above this %>
  <% if @search_page && @model_audit.present? %>
    <p class="tw:px-4 tw:pt-3">
      <%= translation(".e_vehicles_for_audit") %>
      <a class="gray-link" href="<%= organization_model_audit_path(@model_audit.to_param, organization_id: @organization.to_param) %>"><%= helpers.model_audit_display(@model_audit) %></a>
      &nbsp;
      <%= link_to translation(".view_matching_any_audit"),
          url_for(@sort_state.search_params.merge(search_model_audit_id: nil)),
          class: "gray-link small" %>
    </p>
  <% end %>

  <% if @search_page %>
    <div class="tw:hidden tw:min-h-48 tw:group-[[busy]]:block">
      <%= render(UI::LoadingSpinner::Component.new(text: translation(".loading_results"))) %>
    </div>
  <% end %>

  <% if result_component %>
    <ul class="tw:m-0 tw:list-none tw:py-4 <%= results_swap_class %> <%= result_component::LIST_CLASSES %> <%= padding_x_class %>">
      <% @bikes.each do |bike| %>
        <%= render(result_component.new(bike:, organization: @organization, search_all: @search_all)) %>
      <% end %>
    </ul>
  <% else %>
    <%#
      The table bleeds a gutter past each side; clipping it here rather than on the card
      leaves the header's tooltips free to open over the card's edge
    %>
    <div class="<%= table_clip_classes %>">
      <%= render(Pages::Org::SearchResults::BikesTable::Component.new(
        organization: @organization,
        bikes: @bikes,
        render_sortable: true,
        sort_state: @sort_state,
        bike_sticker: @bike_sticker,
        settings:
      )) %>
    </div>
  <% end %>

  <div
    class="
      tw:flex tw:flex-wrap tw:items-center tw:gap-x-4 tw:gap-y-2 tw:border-t
      tw:border-gray-100 tw:px-4 tw:py-3 tw:dark:border-gray-700
    "
  >
    <% if show_pagination? %>
      <%# Pagination's nav is full-width and centred, so it needs a box to share the row %>
      <div class="tw:w-auto">
        <%= render(UI::Pagination::Component.new(pagy: @pagy, page_params: @params, data: {turbo_action: "advance"})) %>
      </div>
    <% end %>

    <span class="tw:text-sm tw:text-gray-400">
      <%= translation(".showing_html", from: number_display(@pagy.from),
          to: number_display(@pagy.to), count: number_display(@pagy.count)) %>
    </span>

    <div class="tw:ml-auto">
      <%= select_tag :per_page_select,
          options_for_select(
            [10, 25, 50, 100].map { |i| ["#{i} registrations per page", i] },
            selected: @per_page
          ),
          class: "form-control tw:m-0! tw:w-auto!",
          aria: {label: translation(".per_page")},
          data: {
            org__search_target: "perPage",
            action: "change->org--search#perPageChanged"
          } %>
    </div>
  </div>
<% end %>
