<%= tag.div(class: "org-search-component tw:mt-4 tw:overflow-hidden tw:rounded-xl #{UI::Card::Component::BASE_CLASSES}", data: card_data_attributes) do %>
  <div
    class="
      tw:flex tw:flex-wrap tw:items-center tw:gap-x-4 tw:gap-y-2 tw:border-b
      tw:border-gray-100 tw:px-4 tw:py-3 tw:dark:border-gray-700
    "
  >
    <p class="tw:mb-0">
      <% bikes_count = number_display(@pagy.count) %>

      <% if show_search_query_summary? %>
        <%= translation(".matching_bikes_html",
            count: bikes_count, cycle_type: cycle_type.pluralize(@pagy.count)) %>
      <% else %>
        <%= translation(".registered_bikes_html",
            count: bikes_count, cycle_type: cycle_type.pluralize(@pagy.count),
            org_name: @organization.short_name) %>
      <% end %>

      <% if active_search_filter_descriptions.any? %>
        <em>— <%= safe_join(active_search_filter_descriptions, " · ") %></em>
      <% end %>

      <em><%= @humanized_time_range %></em>
    </p>

    <% if @search_page %>
      <div class="tw:flex tw:items-center tw:gap-2">
        <span
          class="
            tw:text-2xs tw:font-bold tw:tracking-wider tw:text-gray-400
            tw:uppercase
          "
        >
          <%= translation(".view_as") %>
        </span>

        <%= render(UI::ButtonGroup::Component.new(entries: result_view_entries)) %>
      </div>

      <div class="tw:ml-auto tw:flex tw:flex-wrap tw:items-center tw:gap-2">
        <%= render(UI::Button::Component.new(size: :sm, aria: {expanded: false},
          data: {action: "click->ui--collapse#toggle", "ui--collapse-target": "trigger"})) do %>
          <%= translation(".column_settings") %>

          <span
            data-ui--collapse-target="chevron"
            class="tw:inline-block tw:transition-transform"
          >
            <%= render(UI::IconChevron::Component.new(direction: :down)) %>
          </span>
        <% end %>

        <% if render_export? %>
          <%= render(UI::ButtonLink::Component.new(text: translation(".export_csv"), href: export_path,
            color: :purple, size: :sm, data: {turbo_frame: "_top", "org--search-target": "exportLink"})) %>
        <% end %>

        <%= render(UI::ButtonLink::Component.new(text: t("shared.menu_items_org.add_a_bike"), href: add_bike_path,
          color: :primary, size: :sm, data: {turbo_frame: "_top"})) %>
      </div>
    <% end %>
  </div>

  <div class="tw:px-4">
    <%= render(settings_component) %>
  </div>

  <%# Only on the search: the model audit's own page already names the audit above this %>
  <% if @search_page && @model_audit.present? %>
    <p class="tw:px-4 tw:pt-3">
      <%= translation(".e_vehicles_for_audit") %>
      <a class="gray-link" href="<%= organization_model_audit_path(@model_audit.to_param, organization_id: @organization.to_param) %>"><%= helpers.model_audit_display(@model_audit) %></a>
      &nbsp;
      <%= link_to translation(".view_matching_any_audit"),
          url_for(@sort_state.search_params.merge(search_model_audit_id: nil)),
          class: "gray-link small" %>
    </p>
  <% end %>

  <%= render(Pages::Org::SearchResults::BikesTable::Component.new(
    organization: @organization,
    bikes: @bikes,
    current_user: @current_user,
    render_sortable: true,
    sort_state: @sort_state,
    bike_sticker: @bike_sticker,
    settings_component:
  )) %>

  <div
    class="
      tw:flex tw:flex-wrap tw:items-center tw:gap-x-4 tw:gap-y-2 tw:border-t
      tw:border-gray-100 tw:px-4 tw:py-3 tw:dark:border-gray-700
    "
  >
    <% if show_pagination? %>
      <%# Pagination's nav is full-width and centred, so it needs a box to share the row %>
      <div class="tw:w-auto">
        <%= render(UI::Pagination::Component.new(pagy: @pagy, page_params: @params, data: {turbo_action: "advance"})) %>
      </div>
    <% end %>

    <span class="tw:text-sm tw:text-gray-400">
      <%= translation(".showing_html", from: number_display(@pagy.from),
          to: number_display(@pagy.to), count: number_display(@pagy.count)) %>
    </span>

    <div class="tw:ml-auto">
      <%= select_tag :per_page_select,
          options_for_select(
            [10, 25, 50, 100].map { |i| ["#{i} #{cycle_type.pluralize(10)} per page", i] },
            selected: @per_page
          ),
          class: "form-control tw:m-0! tw:w-auto!",
          aria: {label: translation(".per_page")},
          data: {
            org__search_target: "perPage",
            action: "change->org--search#perPageChanged"
          } %>
    </div>
  </div>
<% end %>
