<div class="tw:hidden! <%= PANEL_CLASSES %>" data-ui--collapse-target="content">
  <div class="tw:mb-3 tw:flex tw:flex-wrap tw:items-baseline tw:gap-2">
    <%= render(UI::Header::Component.new(text: translation(".visible_columns"), tag: :h3, html_class: "header-font-alt uncap tw:mb-0! tw:pr-1")) %>

    <%= render UI::Button::Component.new(text: translation(".all"), color: :link,
        data: { action: "click->org--search-column-settings#selectAll" }) %>

    <%= render UI::Button::Component.new(text: translation(".none"), color: :link,
        data: { action: "click->org--search-column-settings#selectNone" }) %>

    <%= render UI::Button::Component.new(text: translation(".default"), color: :link,
        data: { action: "click->org--search-column-settings#selectDefault" }) %>
  </div>

  <% column_rows = (@settings.enabled_columns.size / 3.0).ceil %>

  <div
    class="
      tw:grid tw:grid-cols-2 tw:gap-x-1 tw:gap-y-3 tw:md:grid-flow-col
      tw:md:grid-cols-3
    "
    style="grid-template-rows: repeat(<%= column_rows %>, auto)"
    data-org--search-column-settings-target="checkboxes"
  >
    <% @settings.enabled_columns.each do |cell_name| %>
      <label
        class="
          tw:mb-0! tw:flex tw:cursor-pointer tw:items-center tw:gap-1
          tw:leading-[1.25]!
        "
      >
        <%= check_box_tag cell_name, cell_name, false,
          data: { action: "change->org--search-column-settings#columnToggled" } %>

        <%= @settings.column_renames[cell_name.to_sym] %>
      </label>
    <% end %>
  </div>
</div>
