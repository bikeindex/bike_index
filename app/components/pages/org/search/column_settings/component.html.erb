<%= tag.div(class: [("tw:hidden!" unless @open), PANEL_CLASSES],
  data: ({ "ui--collapse-target": "content" } unless export?)) do %>
  <%= tag.div(class: "tw:flex tw:flex-col tw:gap-8", data: checkboxes_data) do %>
    <% column_groups.each do |group| %>
      <div data-controller="org--column-checkboxes">
        <div
          class="
            tw:mb-5 tw:flex tw:flex-wrap tw:items-baseline tw:gap-x-3
            tw:gap-y-2
          "
        >
          <%= render(UI::Header::Component.new(text: group[:title], tag: :h3, html_class: "uncap tw:mb-0! tw:pr-1")) %>

          <%= render UI::Button::Component.new(text: translation(".all"), color: :link,
              data: { action: "click->org--column-checkboxes#selectAll" }) %>

          <%= render UI::Button::Component.new(text: translation(".none"), color: :link,
              data: { action: "click->org--column-checkboxes#selectNone" }) %>

          <%= render UI::Button::Component.new(text: translation(".default"), color: :link,
              data: { action: "click->org--column-checkboxes#selectDefault" }) %>
        </div>

        <div
          class="
            tw:grid tw:grid-cols-2 tw:gap-x-7 tw:gap-y-2.5
            tw:md:grid-flow-col tw:md:grid-cols-3
          "
          style="grid-template-rows: repeat(<%= column_rows(group[:columns]) %>, auto)"
        >
          <% group[:columns].each do |column| %>
            <%# Unchecked columns read quieter than the ones showing %>
            <%= render(UI::Forms::Checkbox::Component.new(name: column[:name], value: column[:value],
              checked: column[:checked], label: checkbox_label(column),
              class_name: "tw:mb-0! tw:leading-[1.25]! tw:text-gray-400 tw:has-checked:text-gray-900 tw:dark:has-checked:text-gray-100",
              html_options: { id: "#{column[:name]}_#{column[:value]}".parameterize(separator: "_"),
                              class: "tw:accent-blue-600", disabled: column[:disabled],
                              data: { default: column[:default] } })) %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
