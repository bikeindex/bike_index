<%= render(UI::Card::Component.new(full_bleed: true, additional_classes: "tw:h-full")) do %>
  <%# .organized-body h2 carries a 40px top margin, unlayered, so a plain mt-0 loses %>
  <%= render(UI::Header::Component.new(text: @heading, tag: :h2, html_class: "uncap tw:mt-0! tw:mb-3!")) %>

  <%# search--form only needs to hold the form; the card is the outer element %>
  <div data-controller="<%= turbo? ? "search--form" : "" %>">
    <%= form_with(url: @target_search_path,
      builder: BikeIndexFormBuilder,
      method: :get,
      id: "Search_Form",
      data: form_data) do |f| %>
      <% if turbo? %>
        <%= hidden_field_tag :search_no_js, true %>
      <% end %>

      <div class="tw:flex tw:flex-nowrap tw:gap-4">
        <div class="search-fields tw:flex-grow">
          <%= render(
            Pages::Search::EverythingCombobox::Component.new(
              selected_query_items_options: @selected_query_items_options,
              query: @interpreted_params[:query],
            ),
          ) %>

          <div class="tw:mt-2 tw:flex tw:flex-col tw:gap-2 tw:lg:flex-row">
            <%= label_tag :search_email,
              translation(".search_owner_email_or_name"),
              class: "twlabel tw:sr-only" %>

            <%= text_field_tag :search_email,
              @interpreted_params[:search_email],
              placeholder: translation(".search_owner_email_or_name"),
              class: "twinput tw:flex-1 fieldResetsCounts #{EMAIL_FOLDS_WITH_SEARCH_ALL}" %>

            <%= label_tag :serial,
              translation(".search_for_serial_number"),
              class: "twlabel tw:sr-only" %>

            <%= text_field_tag :serial,
              @interpreted_params[:raw_serial],
              placeholder: translation(".search_for_serial_number"),
              class: "twinput tw:flex-1 fieldResetsCounts" %>

            <% if render_notes_field? %>
              <div
                class="tw:hidden tw:flex-1"
                data-org--search-target="optionalField"
                data-field="notes"
              >
                <%= label_tag :search_notes,
                  translation(".search_notes"),
                  class: "twlabel tw:sr-only" %>

                <%= text_field_tag :search_notes,
                  @interpreted_params[:search_notes],
                  placeholder: translation(".search_notes"),
                  class: "twinput tw:w-full fieldResetsCounts" %>
              </div>
            <% end %>
          </div>

          <% if render_location_fields? %>
            <div
              class="tw:hidden"
              data-org--search-target="optionalField"
              data-field="location"
            >
              <div class="tw:mt-2 tw:flex tw:flex-wrap tw:items-center tw:gap-2">
                <span><%= translation(".within") %></span>

                <%= label_tag :distance, translation(".search_distance"), class: "twlabel tw:sr-only" %>

                <%= number_field_tag :distance, distance, placeholder: GeocodeHelper::DEFAULT_DISTANCE,
                  min: GeocodeHelper::MIN_DISTANCE, class: "twinput tw:w-24 fieldResetsCounts" %>

                <span><%= translation(".miles_of") %></span>

                <%= label_tag :location, translation(".search_location"), class: "twlabel tw:sr-only" %>

                <%= text_field_tag :location, @interpreted_params[:location],
                  placeholder: translation(".search_location"),
                  class: "twinput tw:min-w-50 tw:flex-1 fieldResetsCounts" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <% if serial_looks_like_not_a_serial? %>
        <%= render(
          UI::Alerts::Base::Component.new(
            text: translation(".doesnt_look_like_serial"),
            kind: :warning,
            margin_classes: "tw:my-2",
          ),
        ) %>
      <% end %>

      <%= content %>

      <%= render partial: "/shared/hidden_search_fields", locals: {kind: "organized_bike_search",
        skip_organization: true, skip_period: @settings_and_filters_component.present?} %>

      <% unless @settings_and_filters_component %>
        <%= hidden_field_tag :search_stickers, @interpreted_params[:search_stickers] %>
        <%= hidden_field_tag :search_address, @interpreted_params[:search_address] %>
        <%= hidden_field_tag :search_status, @interpreted_params[:search_status] %>
      <% end %>

      <%= hidden_field_tag :search_secondary, @interpreted_params[:search_secondary] %>
      <%= hidden_field_tag :search_model_audit_id, @interpreted_params[:search_model_audit_id] %>
    <% end %>
  </div>

  <%# Outside the form: the settings panel holds the custom date range, which is a form of its own %>
  <%= render(@settings_and_filters_component) if @settings_and_filters_component %>

  <%#
    data-turbo: Drive is off app-wide, and a submitter outside the form it submits carries
    its own opt-in - without it the search is a full page load rather than a frame one
  %>

  <%= render(UI::Button::Component.new(text: @submit_text, color: :primary, size: :lg, type: "submit",
    form: "Search_Form", data: ({turbo: true} if turbo?), spinner: turbo?,
    html_class: "tw:mt-3 tw:w-full#{" tw:disabled:cursor-wait" if turbo?}")) %>

  <%= below_submit %>
<% end %>
