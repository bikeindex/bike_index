<%= tag.div(class: wrapper_classes, data: wrapper_data) do %>
  <div data-slot="active">
    <%= render(UI::Card::Component.new(divided: true)) do %>
      <div class="tw:flex tw:items-center tw:justify-between tw:gap-3 tw:px-5 tw:py-4">
        <div class="tw:flex tw:min-w-0 tw:flex-wrap tw:items-center tw:gap-2.5">
          <span
            class="tw:text-lg tw:font-bold tw:text-gray-900 tw:dark:text-gray-100"
            data-slot="title"
            data-fallback="<%= translation(".new_location") %>"
          >
            <%= display_name %>
          </span>

          <span class="<%= hidden_unless(on_map?) %>" data-slot="badge-map">
            <%= render(UI::Badge::Component.new(text: translation(".on_map"), color: :notice)) %>
          </span>

          <span
            class="<%= hidden_unless(impound? && !default_impound?) %>"
            data-slot="badge-impound"
          >
            <%= render(UI::Badge::Component.new(text: translation(".impound"), color: :purple)) %>
          </span>

          <span
            class="<%= hidden_unless(default_impound?) %>"
            data-slot="badge-default-impound"
          >
            <%= render(UI::Badge::Component.new(text: translation(".default_impound"), color: :purple)) %>
          </span>

          <span
            class="<%= hidden_unless(new_record?) %>"
            data-slot="badge-dirty"
          >
            <%= render(UI::Badge::Component.new(text: new_record? ? translation(".new") : translation(".unsaved"), color: :yellow)) %>
          </span>
        </div>

        <% if @location.destroy_forbidden? %>
          <small class="tw:shrink-0 tw:text-gray-500 tw:italic tw:dark:text-gray-400">
            <%= translation(".required_for_impounded_bikes") %>
          </small>
        <% else %>
          <%= @form_builder.hidden_field :_destroy, data: {slot: "destroy"} %>
          <%= render(UI::Button::Component.new(text: translation(".remove"), color: :error, size: :sm,
                html_class: "tw:shrink-0", data: {slot: "remove", action: "click->org--locations#remove"})) %>
        <% end %>
      </div>

      <div class="tw:px-5 tw:pt-5 tw:pb-1">
        <div class="twfieldrow">
          <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :name,
                label_text: translation(".location_name"), required: true,
                html_options: {placeholder: translation(".name"), value: name_value, data: {slot: "name"}})) %>

          <%= render(UI::Forms::Group::Component.new(form_builder: @form_builder, attribute: :phone,
                kind: :telephone_field, label_text: translation(".phone_number"))) %>
        </div>

        <span
          class="
            tw:mb-2 tw:block tw:text-xs tw:font-bold tw:tracking-wider
            tw:text-gray-500 tw:uppercase tw:dark:text-gray-400
          "
        >
          <%= translation(".address") %>
        </span>

        <%= @form_builder.fields_for :address_record, address_record do |address_form| %>
          <%= render(UI::Forms::AddressGroup::Component.new(form_builder: address_form, street_label: translation(".street"))) %>
        <% end %>
      </div>

      <div
        class="
          tw:flex tw:flex-col tw:gap-3 tw:rounded-b-xl tw:bg-gray-50 tw:px-5
          tw:py-4 tw:dark:bg-gray-900/50
        "
      >
        <div
          class="<%= hidden_unless(@organization.show_on_map) %>"
          data-slot="public-row"
        >
          <%= checkbox(:publicly_visible, slot: "public", label: translation(".publicly_visible")) %>
        </div>

        <% if impound_enabled? %>
          <%= checkbox(:impound_location, slot: "impound-check") do %>
            <span class="tw:flex tw:flex-col tw:gap-0.5">
              <span><%= translation(".impound_location") %></span>

              <small class="tw:font-normal tw:text-gray-500 tw:dark:text-gray-400">
                <%= translation(".impound_location_help", org_name: @organization.short_name) %>
              </small>
            </span>
          <% end %>

          <div
            class="tw:ml-7 <%= hidden_unless(impound?) %>"
            data-slot="default-row"
          >
            <%= checkbox(:default_impound_location, slot: "default-check", label: translation(".default_impound_location")) %>
          </div>
        <% end %>
      </div>

      <div
        class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-3 tw:px-5 tw:py-3 <%= hidden_unless(new_record?) %>"
        data-slot="unsaved-row"
      >
        <span class="tw:text-sm tw:text-gray-500 tw:dark:text-gray-400"><%= translation(".unsaved_changes") %></span>

        <div class="tw:flex tw:items-center tw:gap-2">
          <%= render(UI::Button::Component.new(text: translation(".discard"), color: :link_gray,
                data: {action: "click->org--locations#discard"})) %>

          <%= render(UI::Button::Component.new(text: translation(".save"), color: :primary, size: :callout_sm, type: "submit")) %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="tw:hidden" data-slot="removed">
    <%= render(UI::Card::Component.new(additional_classes: "tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-3 tw:border-dashed")) do %>
      <span class="tw:text-gray-500 tw:dark:text-gray-400">
        <%= translation(".will_be_removed_html", name: tag.strong(display_name, class: "tw:text-gray-900 tw:dark:text-gray-100", data: {slot: "removed-name"})) %>
      </span>

      <div class="tw:flex tw:items-center tw:gap-2">
        <%= render(UI::Button::Component.new(text: translation(".undo"), color: :link,
              data: {action: "click->org--locations#undo"})) %>

        <%= render(UI::Button::Component.new(text: translation(".save"), color: :primary, size: :callout_sm, type: "submit")) %>
      </div>
    <% end %>
  </div>
<% end %>
