<%= render UI::Header::Component.new(text: translation(".registration_form_settings"), html_class: "uncap") %>

<%= form_with(url: switches_organization_registrations_path(organization_id: @organization.to_param),
    data: {turbo: false, controller: "org--register-settings"}) do %>
  <div class="tw:mb-6 tw:gap-x-8 tw:sm:grid tw:sm:grid-cols-3">
    <span class="twlabel tw:sm:text-right"><%= translation(".registration_page") %></span>

    <div class="tw:sm:col-span-2">
      <%= render UI::Forms::Checkbox::Component.new(name: :old_view, checked: @old_view,
          label: translation(".old_view"), html_options: {data: {"org--register-settings-target": "oldView",
            action: "org--register-settings#apply"}}) %>
    </div>
  </div>

  <div
    class="
      tw:mb-6 tw:gap-x-8 tw:has-disabled:opacity-50 tw:sm:grid
      tw:sm:grid-cols-3
    "
  >
    <span class="twlabel tw:sm:text-right"><%= translation(".form_options") %></span>

    <div class="tw:sm:col-span-2">
      <%= render UI::Forms::Checkbox::Component.new(name: :single_page, checked: @single_page,
          label: translation(".single_page"),
          html_options: {data: {"org--register-settings-target": "oldViewShown"}}) %>

      <% if safety_rules? %>
        <%= render UI::Forms::Checkbox::Component.new(name: :separate_attestation, checked: @separate_attestation,
            class_name: "tw:mt-2", label: translation(".separate_attestation"),
            html_options: {data: {"org--register-settings-target": "oldViewShown", old_view_checked: true}}) %>
        <p
          class="
            tw:mt-1 tw:mb-0 tw:pl-6 tw:text-xs tw:text-gray-500
            tw:dark:text-gray-400
          "
        >
          <%= translation(".separate_attestation_helper") %>
        </p>
      <% end %>
    </div>
  </div>

  <div class="tw:gap-x-8 tw:sm:grid tw:sm:grid-cols-3">
    <div class="tw:sm:col-span-2 tw:sm:col-start-2">
      <%= render UI::Button::Component.new(text: translation(".update"), color: :primary, size: :lg,
          type: "submit") %>

      <p
        class="
          tw:mt-3 tw:mb-0 tw:text-sm tw:text-gray-500 tw:italic
          tw:dark:text-gray-400
        "
      >
        <%= translation(".browser_only") %>
      </p>
    </div>
  </div>
<% end %>
