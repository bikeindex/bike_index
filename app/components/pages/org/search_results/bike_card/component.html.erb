<%#
  No overflow-hidden, which would clip the status tooltip - so the photos round their own
  corners, and the hovered card or row rises over the next for the tooltip to show
%>

<% cache(cache_key) do %>
  <% if row? %>
    <li class="tw:relative tw:flex tw:flex-wrap tw:items-center tw:gap-3 tw:rounded-xl tw:border tw:border-l-4 tw:border-gray-200 tw:bg-white tw:p-3 tw:transition tw:focus-within:z-10 tw:hover:z-10 tw:hover:-translate-y-0.5 tw:hover:shadow-lg tw:@xl:flex-nowrap tw:@xl:gap-4 tw:dark:border-gray-700 tw:dark:bg-gray-800 <%= row_border_class %>">
      <div
        class="
          tw:h-16 tw:w-24 tw:flex-none tw:rounded-lg tw:bg-gray-100
          tw:@xl:h-24 tw:@xl:w-36 tw:dark:bg-gray-900
        "
      >
        <% if thumb_image_url.present? %>
          <%= image_tag(thumb_image_url, alt: @bike.title_string, skip_pipeline: true, class: "tw:h-full tw:w-full tw:rounded-lg tw:object-cover") %>
        <% else %>
          <%= image_tag(bike_placeholder_image_path, alt: @bike.title_string, class: "tw:h-full tw:w-full tw:object-contain tw:p-4") %>
        <% end %>
      </div>

      <div class="tw:flex tw:min-w-0 tw:flex-1 tw:flex-col tw:gap-1.5">
        <h3 class="tw:m-0 tw:font-sans tw:text-base tw:leading-snug tw:normal-case">
          <%= link_to bike_path_for_org, class: "tw:twtext-color tw:hover:underline", data: {turbo_frame: "_top"} do %>
            <strong><%= [@bike.year, @bike.mnfg_name].compact.join(" ") %></strong>
            <%= @bike.frame_model_truncated %>
            <span class="tw:absolute tw:inset-0 tw:z-10"></span>
          <% end %>
        </h3>

        <div
          class="
            tw:flex tw:flex-wrap tw:items-center tw:gap-x-3 tw:gap-y-1.5
            tw:text-sm tw:text-gray-500
          "
        >
          <% if colors.any? %>
            <span class="tw:flex tw:items-center tw:gap-1.5">
              <span class="tw:flex tw:gap-0.5">
                <% colors.each do |color| %>
                  <%= render(UI::ColorSwatch::Component.new(display: color.display, name: color.name, size: :sm)) %>
                <% end %>
              </span>

              <%= colors.map(&:name).join(" / ") %>
            </span>
          <% end %>

          <% if location.present? %>
            <span><%= location %></span>
          <% end %>

          <%# Above the row's link, for the e-vehicle tooltip %>
          <span class="tw:relative tw:z-20 tw:inline-flex tw:items-center tw:gap-1.5">
            <% if @bike.motorized? %>
              <%= render(UI::Badge::Component.new(text: "⚡", title: translation(".e_vehicle"), color: :purple)) %>
            <% end %>

            <%= render(UI::Badge::Component.new(text: @bike.type_titleize, color: @bike.motorized? ? :purple : :gray)) %>
          </span>
        </div>

        <div class="tw:relative tw:z-20 tw:flex tw:flex-wrap tw:items-center tw:gap-2">
          <span
            class="
              tw:rounded-md tw:border tw:border-gray-100 tw:bg-gray-50
              tw:px-1.5 tw:py-0.5 tw:font-mono tw:text-xs
              tw:dark:border-gray-700 tw:dark:bg-gray-900
            "
          >
            <%= render(Atoms::Serial::Component.new(bike: @bike, user: @current_user, explanation: :tooltip)) %>
          </span>

          <% if @search_all %>
            <%= render(UI::Badge::Component.new(text: org_badge_text, color: organized? ? :notice : :gray)) %>
          <% end %>
        </div>
      </div>

      <%# Beside the photo on narrow screens, where it wraps to its own line %>
      <div
        class="
          tw:flex tw:w-full tw:flex-none tw:items-center tw:justify-between
          tw:gap-2 tw:@xl:w-auto tw:@xl:flex-col tw:@xl:items-end
        "
      >
        <span
          class="
            tw:font-mono tw:text-lg tw:font-semibold tw:text-gray-900
            tw:dark:text-gray-100
          "
        >
          <%= amount_display(for_sale_listing) if for_sale_listing&.amount_cents.present? %>
        </span>

        <%# Above the row's link, so its tooltip opens rather than the bike %>
        <span class="tw:relative tw:z-20">
          <%= render(Atoms::RegistrationStatusBadge::Component.new(bike: @bike, time: status_time)) %>
        </span>
      </div>
    </li>
  <% else %>
    <li
      class="
        tw:relative tw:flex tw:flex-col tw:rounded-xl tw:border
        tw:border-gray-200 tw:bg-white tw:transition tw:focus-within:z-10
        tw:hover:z-10 tw:hover:-translate-y-0.5 tw:hover:shadow-lg
        tw:dark:border-gray-700 tw:dark:bg-gray-800
      "
    >
      <div
        class="
          tw:relative tw:h-40 tw:rounded-t-[11px] tw:bg-gray-100
          tw:dark:bg-gray-900
        "
      >
        <% if thumb_image_url.present? %>
          <%= image_tag(thumb_image_url, alt: @bike.title_string, skip_pipeline: true, class: "tw:h-full tw:w-full tw:rounded-t-[11px] tw:object-cover") %>
        <% else %>
          <%= image_tag(bike_placeholder_image_path, alt: @bike.title_string, class: "tw:h-full tw:w-full tw:object-contain tw:p-8") %>
        <% end %>

        <% if for_sale_listing&.amount_cents.present? %>
          <span
            class="
              tw:absolute tw:top-2 tw:left-2 tw:rounded-full
              tw:bg-gray-900/80 tw:px-2 tw:py-1 tw:text-xs tw:font-extrabold
              tw:text-white
            "
          >
            <%= amount_display(for_sale_listing) %>
          </span>
        <% end %>

        <%# Above the card's link, so its tooltip opens rather than the bike %>
        <span class="tw:absolute tw:top-2 tw:right-2 tw:z-20">
          <%= render(Atoms::RegistrationStatusBadge::Component.new(bike: @bike, time: status_time)) %>
        </span>
      </div>

      <div class="tw:flex tw:flex-col tw:gap-2 tw:px-3 tw:pt-3 tw:pb-3.5">
        <h3 class="tw:m-0 tw:font-sans tw:text-base tw:leading-snug tw:normal-case">
          <%= link_to bike_path_for_org, class: "tw:twtext-color tw:hover:underline", data: {turbo_frame: "_top"} do %>
            <strong><%= [@bike.year, @bike.mnfg_name].compact.join(" ") %></strong>
            <%= @bike.frame_model_truncated %>
            <span class="tw:absolute tw:inset-0 tw:z-10"></span>
          <% end %>
        </h3>

        <% if colors.any? %>
          <div
            class="
              tw:flex tw:flex-wrap tw:items-center tw:gap-2 tw:text-sm
              tw:text-gray-500
            "
          >
            <span class="tw:flex tw:gap-0.5">
              <% colors.each do |color| %>
                <%= render(UI::ColorSwatch::Component.new(display: color.display, name: color.name, size: :sm)) %>
              <% end %>
            </span>

            <%= colors.map(&:name).join(" / ") %>
          </div>
        <% end %>

        <%# Above the card's link too, for the e-vehicle tooltip %>
        <div
          class="
            tw:relative tw:z-20 tw:flex tw:flex-wrap tw:items-center
            tw:gap-1.5
          "
        >
          <% if @bike.motorized? %>
            <%= render(UI::Badge::Component.new(text: "⚡", title: translation(".e_vehicle"), color: :purple)) %>
          <% end %>

          <%= render(UI::Badge::Component.new(text: @bike.type_titleize, color: @bike.motorized? ? :purple : :gray)) %>
        </div>

        <% if location.present? %>
          <p class="tw:m-0 tw:text-xs tw:text-gray-400"><%= location %></p>
        <% end %>

        <%= render(Atoms::Serial::Component.new(bike: @bike, user: @current_user, explanation: :tooltip,
        html_class: "tw:text-xs! tw:text-gray-400!")) %>

        <% if @search_all %>
          <div>
            <%= render(UI::Badge::Component.new(text: org_badge_text, color: organized? ? :notice : :gray)) %>
          </div>
        <% end %>
      </div>
    </li>
  <% end %>
<% end %>
