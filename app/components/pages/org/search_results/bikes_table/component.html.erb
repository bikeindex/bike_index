<%# Locals, not @ivars: UI::Table instance_execs cell blocks against itself, %>
<%# so instance variables resolve to nil inside them — closures capture these. %>
<% organization = @organization %>
<% current_user = @current_user %>

<%= tag.div(data: table_wrapper_data_attributes) do %>
  <%= render(UI::Table::Component.new(records: @bikes, cache_key: "org-#{@organization.id}-#{self.class.cache_digest}", render_sortable: @render_sortable, sort_state: @sort_state)) do |table| %>
    <%# A lambda, because a cell block is instance_exec'd against the table %>
    <% hidden_html = -> { hidden_not_registered_tag } %>
    <% email_hidden = translation(".email_hidden") %>

    <% table.column(label: settings.column_renames[:url_cell], classes: "hideableColumn url_cell") do |bike| %>
      <code class="tw:p-0 tw:text-xs!" style="word-break: normal">
        <%= bike.html_url %>
      </code>
    <% end %>

    <% table.column(sortable: "id", label: settings.column_renames[:created_at_cell], classes: "hideableColumn created_at_cell") do |bike| %>
      <a
        class="twlink localizeTime"
        href="<%= bike_path(bike, organization_id: organization.to_param) %>"
        data-turbo-frame="_top"
        aria-label="View bike"
      >
        <%= l bike.created_at, format: :convert_time %>
      </a>
    <% end %>

    <% table.column(sortable: "updated_by_user_at", label: settings.column_renames[:updated_at_cell], classes: "hideableColumn updated_at_cell") do |bike| %>
      <small class="localizeTime">
        <%= l bike.updated_by_user_fallback, format: :convert_time %>
      </small>
    <% end %>

    <% table.column(label: settings.column_renames[:stolen_cell], classes: "hideableColumn stolen_cell") do |bike| %>
      <%= check_mark if bike.status_stolen? %>
    <% end %>

    <% table.column(label: settings.column_renames[:serial_number_cell], classes: "hideableColumn serial_number_cell") do |bike| %>
      <%= render(Atoms::Serial::Component.new(bike:, user: current_user)) %>
    <% end %>

    <% table.column(sortable: "propulsion_type", label: settings.column_renames[:propulsion_type_cell], classes: "hideableColumn propulsion_type_cell") do |bike| %>
      <span class="<%= 'tw:text-gray-400' if bike.propulsion_type == 'foot-pedal' %>">
        <%= bike.propulsion_titleize %>
      </span>
    <% end %>

    <% table.column(sortable: "cycle_type", label: settings.column_renames[:cycle_type_cell], classes: "hideableColumn cycle_type_cell") do |bike| %>
      <span class="<%= 'tw:text-gray-400' if bike.cycle_type == 'bike' %>">
        <%= bike.type_titleize %>
      </span>
    <% end %>

    <% table.column(sortable: "mnfg_name", label: settings.column_renames[:manufacturer_cell], classes: "hideableColumn manufacturer_cell") do |bike| %>
      <%= bike.mnfg_name %>
    <% end %>

    <% table.column(sortable: "frame_model", label: settings.column_renames[:model_cell], classes: "hideableColumn model_cell") do |bike| %>
      <%= bike.frame_model %>
    <% end %>

    <% table.column(label: settings.column_renames[:color_cell], classes: "hideableColumn color_cell") do |bike| %>
      <span class="tw:text-gray-400"><%= bike.frame_colors.join(", ") %></span>
    <% end %>

    <% table.column(sortable: "owner_email", label: settings.column_renames[:owner_email_cell], classes: "hideableColumn owner_email_cell tw:leading-none") do |bike| %>
      <% if !bike.organized?(organization) %>
        <%= hidden_html.call %>
      <% elsif bike.email_visible_for?(organization) %>
        <%= bike.owner_email %>
        <small>
          <%= link_to "\u{1F50E}", organization_registrations_path(organization_id: organization.to_param, search_email: bike.owner_email), class: "display-sortable-link", data: {turbo_frame: "_top"} %>
        </small>
      <% else %>
        <em class="tw:text-gray-400"><%= email_hidden %></em>
      <% end %>
    <% end %>

    <% table.column(label: settings.column_renames[:creation_description_cell], classes: "hideableColumn creation_description_cell tw:leading-none") do |bike| %>
      <% if bike.creation_kind %>
        <small class="tw:text-gray-400">
          <%= render(Atoms::Org::OriginDisplay::Component.new(ownership: bike.current_ownership)) %>
        </small>
      <% end %>
    <% end %>

    <% table.column(label: settings.column_renames[:owner_name_cell], classes: "hideableColumn owner_name_cell tw:leading-none") do |bike| %>
      <% if bike.organized?(organization) %>
        <% if bike.owner_name.present? %>
          <em><%= bike.owner_name %></em>
        <% end %>
      <% else %>
        <%= hidden_html.call %>
      <% end %>
    <% end %>

    <% table.column(label: settings.column_renames[:status_cell], classes: "hideableColumn status_cell tw:text-xs") do |bike| %>
      <%= render(Atoms::RegistrationStatusBadge::Component.new(bike:, skip_with_owner: true, size: :xs)) %>
    <% end %>

    <% if organization.enabled?("registration_notes") %>
      <% table.column(label: settings.column_renames[:notes_cell], classes: "hideableColumn notes_cell tw:leading-none") do |bike| %>
        <small>
          <%= BikeOrganizationNote.find_by(bike_id: bike.id, organization_id: organization.id)&.body %>
        </small>
      <% end %>
    <% end %>

    <% settings.additional_registration_fields.each do |reg_field| %>
      <% table.column(label: settings.column_renames[:"#{reg_field}_cell"], classes: "hideableColumn #{reg_field}_cell tw:leading-none") do |bike| %>
        <% if !bike.organized?(organization) %>
          <%= hidden_html.call %>
        <% elsif reg_field != "reg_address" %>
          <%= OrgServices::RegistrationFields.value(bike:, organization:, reg_field:) %>
        <% else %>
          <small>
            <%= render UI::AddressDisplay::Component.new(address_record: bike.mailing_address_record, visible_attribute: :street) %>
          </small>
        <% end %>
      <% end %>
    <% end %>

    <% if organization.enabled?("impound_bikes") %>
      <% table.column(label: settings.column_renames[:impound_id_cell], classes: "hideableColumn impound_id_cell tw:leading-none") do |bike| %>
        <% if bike.organized?(organization) %>
          <% if bike.status_impounded? && bike.current_impound_record.present? %>
            <%= number_display(bike.current_impound_record.id) %>
          <% end %>
        <% else %>
          <%= hidden_html.call %>
        <% end %>
      <% end %>
      <% table.column(label: settings.column_renames[:impounded_cell], classes: "hideableColumn impounded_cell tw:leading-none") do |bike| %>
        <% if bike.organized?(organization) %>
          <% if bike.status_impounded? && bike.current_impound_record&.created_at&.present? %>
            <small class="localizeTime">
              <%= l bike.current_impound_record.created_at, format: :convert_time %>
            </small>
          <% end %>
        <% else %>
          <%= hidden_html.call %>
        <% end %>
      <% end %>
    <% end %>

    <% if organization.enabled?("avery_export") %>
      <% table.column(label: settings.column_renames[:avery_cell], classes: "hideableColumn avery_cell") do |bike| %>
        <% check_mark if bike.organized?(organization) && bike.avery_exportable? %>
      <% end %>
    <% end %>

    <% if organization.enabled?("registration_sequences") %>
      <% table.column(sortable: "acknowledged_at", label: settings.column_renames[:acknowledgment_cell], classes: "hideableColumn acknowledgment_cell tw:leading-none") do |bike| %>
        <% if bike.motorized? %>
          <% if bike.organized?(organization) %>
            <small>
              <%= render(UI::Time::Component.new(time: RegistrationSequenceAcknowledgment.find_for(bike:, organization:)&.acknowledged_at)) %>
            </small>
          <% else %>
            <%= hidden_html.call %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if organization.enabled?("bike_stickers") %>
      <% table.column(label: settings.column_renames[:sticker_cell], classes: "hideableColumn sticker_cell tw:pt-0", header_classes: "tw:pt-1") do |bike| %>
        <% bike.bike_stickers.each do |bs| %>
          <% if bs.organization.present? && bs.organization_id == organization.id %>
            <%= link_to bs.pretty_code, edit_organization_sticker_path(id: bs.code, organization_id: bs.organization&.to_param), class: "tw:text-xs tw:block tw:mt-1", data: {turbo_frame: "_top"} %>
          <% else %>
            <small class="tw:mt-1 tw:block tw:text-xs">
              <%= bs.pretty_code %>
            </small>
          <% end %>
        <% end %>
      <% end %>
      <% table.column(label: translation(".assign_bike_sticker"), classes: "assign_bike_sticker_cell tw:hidden") do |bike| %>
        <small>
          <a data-bike-id="<%= bike.id %>">
            <%= t("components.pages.org.search_results.bikes_table.link_sticker") %>
          </a>
        </small>
      <% end %>
    <% end %>
  <% end %>
<% end %>
