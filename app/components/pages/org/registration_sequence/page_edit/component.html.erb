<div class="tw:flex tw:flex-col tw:gap-4">
  <div>
    <%= @form_builder.label :title, "Title", class: "twlabel" %>
    <%= @form_builder.text_field :title, class: "twinput tw:w-full" %>

    <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-500">
      Labels this page's rules, and names it on the final review.
    </p>
  </div>

  <div>
    <%= @form_builder.label :heading, "Heading", class: "twlabel" %>
    <%= @form_builder.text_field :heading, class: "twinput tw:w-full", placeholder: @form_builder.object.title %>

    <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-500">
      The large text at the top of the page. Defaults to the title.
    </p>
  </div>

  <div>
    <%= @form_builder.label :subtitle, "Subtitle", class: "twlabel" %>
    <%= @form_builder.text_area :subtitle, rows: 2, class: "twinput tw:w-full" %>
  </div>

  <div>
    <%= @form_builder.label :image, "Image", class: "twlabel" %>

    <%= render UI::Forms::FileUpload::Component.new(form_builder: @form_builder, attribute: :image, accept: "image/*") %>
  </div>

  <% if badge_name.present? %>
    <div>
      <%= render UI::Forms::Checkbox::Component.new(form_builder: @form_builder, attribute: :organization_specific,
          label: "Specific to #{badge_name}") %>

      <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-500">
        Badges the page with that name, so registrants can tell it apart from
        the standard rules.
      </p>
    </div>
  <% end %>

  <div data-controller="bullet-editors">
    <label
      class="twlabel tw:cursor-pointer"
      data-action="mousedown->bullet-editors#focusFirst"
    >
      Bullets
    </label>

    <%= @form_builder.hidden_field :body, data: {bullet_editors_target: "field"} %>

    <div data-bullet-editors-target="list" class="tw:flex tw:flex-col tw:gap-2">
      <% bullets.each_with_index do |value, index| %>
        <%= render Pages::Org::RegistrationSequence::PageEditBullet::Component.new(index:, value:) %>
      <% end %>
    </div>

    <template data-bullet-editors-target="template">
      <%= render Pages::Org::RegistrationSequence::PageEditBullet::Component.new(index: "__INDEX__") %>
    </template>

    <div class="tw:mt-1">
      <%= render UI::Button::Component.new(text: "+ Add bullet", color: :link, html_class: "tw:text-sm", data: {action: "bullet-editors#add"}) %>
    </div>
  </div>
</div>
