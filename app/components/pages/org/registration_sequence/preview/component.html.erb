<%= render Pages::Register::Page::Component.new do %>
  <%= render Pages::Register::Progress::Component.new(steps: progress_steps, step: progress_step) %>

  <%= render Pages::Register::AcknowledgmentProgress::Component.new(number: @index + 1, total: acknowledgment_step_count) %>

  <% if reviewing? %>
    <%= render Pages::Register::ReviewSummary::Component.new(pages:) %>
    <%# The acknowledgment gates Finish, via the same register--acknowledgment controller the flow uses %>
    <%= form_with url: exit_path, method: :get, data: {controller: "register--acknowledgment"} do %>
      <%= render Pages::Register::AcknowledgmentCheck::Component.new(sequence: @registration_sequence) %>

      <%= render UI::Button::Component.new(text: "Finish preview", color: :primary, size: :lg, type: "submit",
        spinner: true, disabled: true, html_class: "tw:w-full", data: {"register--acknowledgment-target": "submit"}) %>
    <% end %>
  <% else %>
    <%# Continue is gated on checking every rule, the same as the real flow %>
    <%= form_with url: sequence_path, method: :get, data: {controller: "register--acknowledgment"} do %>
      <%= hidden_field_tag :page, page_param(@index + 1) %>

      <%= render Pages::Register::PageContent::Component.new(page: current_page, first: @index.zero?) %>

      <%= render UI::Button::Component.new(text: "Continue", color: :primary, size: :lg, type: "submit",
        spinner: true, disabled: true, html_class: "tw:mt-5 tw:w-full", data: {"register--acknowledgment-target": "submit"}) %>
    <% end %>
  <% end %>

  <%= render Pages::Register::BackLink::Component.new(href: back_path) %>
<% end %>
