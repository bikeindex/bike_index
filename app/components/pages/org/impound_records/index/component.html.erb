<% multi_update_open_label = translation(".hide_update") %>
<% multi_update_closed_label = translation(".update_multiple_records") %>

<div
  data-controller="org--impound-update-multi table-multi-checkbox"
  data-org--impound-update-multi-open-label-value="<%= multi_update_open_label %>"
  data-org--impound-update-multi-closed-label-value="<%= multi_update_closed_label %>"
  data-org--impound-update-multi-disabled-title-value="<%= translation(".cannot_update_with_kind") %>"
>
  <%= render(Pages::Org::Search::Wrapper::Component.new(
    organization: @current_organization,
    pagy: @pagy,
    per_page: @per_page,
    params: @params,
    bikes: @impound_records.map(&:bike),
    impound_records: @impound_records,
    multiselect_visible: @multi_update_open,
    sort_state: @sort_state,
    result_view: @result_view,
    search_page: true
  )) do |wrapper| %>
    <% wrapper.with_actions do %>
      <%= render(UI::Button::Component.new(
        text: @multi_update_open ? multi_update_open_label : multi_update_closed_label,
        color: :primary,
        size: :sm,
        data: {"org--impound-update-multi-target": "toggle", action: "org--impound-update-multi#toggle"}
      )) %>
    <% end %>

    <% wrapper.with_below_header do %>
      <%= render(Pages::Org::ImpoundRecords::UpdateForm::Component.new(current_organization: @current_organization, multi_update_open: @multi_update_open)) %>
    <% end %>
  <% end %>
</div>
