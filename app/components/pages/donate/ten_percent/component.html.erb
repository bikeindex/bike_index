<div
  class="
    tw:flex tw:flex-col tw:rounded-lg tw:border tw:border-[#a9d2f0]
    tw:bg-[#e8f3fc] tw:px-3.75 tw:py-3.25 tw:dark:border-blue-900
    tw:dark:bg-blue-950
  "
  data-controller="ui--collapse donate--ten-percent"
  data-donate--ten-percent-currency-symbol-value="<%= @currency_symbol %>"
  data-action="donate--page:open-ten-percent@window->ui--collapse#show donate--page:open-ten-percent@window->donate--ten-percent#focus donate--form:change@window->donate--ten-percent#formChanged"
>
  <%= render UI::Collapse::Component.new(color: :link, chevron: :trailing, html_class: "tw:w-full tw:justify-between tw:gap-2.5 tw:text-left tw:text-[14.5px]") do %>
    <span class="tw:flex tw:items-center tw:gap-2.5">
      <%= helpers.inline_svg_tag("icons/bike.svg", class: "tw:size-5 tw:shrink-0", aria_hidden: true) %>
      <%= translation(".heading") %>
    </span>
  <% end %>

  <div
    class="<%= "tw:hidden" unless @open %>"
    data-ui--collapse-target="content"
  >
    <div class="tw:flex tw:flex-col tw:gap-2 tw:pt-2.5">
      <label
        class="
          tw:flex tw:items-center tw:gap-1.5 tw:rounded-[5px] tw:border
          tw:border-[#e0e0e0] tw:bg-white tw:px-3.5
          tw:has-focus:border-blue-500 tw:has-focus:ring-3
          tw:has-focus:ring-blue-500/25 tw:dark:border-gray-700
          tw:dark:bg-gray-800
        "
      >
        <span
          class="tw:font-bold tw:text-[#666] tw:dark:text-gray-400"
          aria-hidden="true"
        >
          <%= @currency_symbol %>
        </span>

        <span class="tw:sr-only"><%= translation(".bike_value") %></span>

        <input
          type="number"
          min="1"
          inputmode="decimal"
          autocomplete="off"
          placeholder="<%= translation(".bike_value") %>"
          class="
            tw:w-full tw:border-0 tw:bg-transparent tw:py-3 tw:text-base
            tw:outline-none tw:focus:ring-0
          "
          data-donate--ten-percent-target="value"
          data-action="input->donate--ten-percent#fill"
        >
      </label>

      <p
        class="
          tw:m-0 tw:hidden tw:text-[13.5px] tw:text-[#444]
          tw:dark:text-gray-200
        "
        data-donate--ten-percent-target="result"
      >
        <%= translation(".result_html", amount: tag.strong(class: "tw:text-blue-600 tw:dark:text-blue-400", data: {donate__ten_percent_target: "amount"})) %>
      </p>
    </div>
  </div>
</div>
