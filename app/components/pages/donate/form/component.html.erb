<% ink = "tw:text-[#2c3e50] tw:dark:text-gray-100" %>
<% muted = "tw:text-[#666] tw:dark:text-gray-400" %>
<% card = "tw:rounded-lg tw:border tw:border-[#e0e0e0] tw:bg-white tw:dark:border-gray-700 tw:dark:bg-gray-800" %>
<% selectable = "tw:transition-colors tw:hover:border-[#a9d2f0] tw:is-active:border-blue-600 tw:is-active:ring-1 tw:is-active:ring-blue-600" %>
<% row = "tw:group/row tw:flex tw:cursor-pointer tw:items-center tw:gap-3 tw:px-3.5 tw:py-4 tw:xs:gap-4 tw:xs:px-4.5 tw:has-focus-visible:ring-3 tw:has-focus-visible:ring-blue-500/40 #{card} #{selectable}" %>
<% amount_classes = "tw:font-header tw:text-[19px] tw:font-extrabold tw:group-has-checked/row:text-blue-600 tw:lg:text-[22px] tw:dark:group-has-checked/row:text-blue-400 #{ink}" %>

<%# the callout's 40px padding and 16px type don't fit a label in the 404px card %>
<% submit_button = ->(text) { render UI::Button::Component.new(text:, color: :primary, size: :callout, type: "submit", html_class: "tw:mt-2 tw:w-full tw:px-4! tw:text-xs! tw:xs:text-sm!", data: {donate__form_target: "submit"}) } %>

<div
  class="tw:group/donate tw:flex tw:flex-col tw:gap-4"
  data-controller="donate--form"
  data-donate--form-monthly-label-value="<%= monthly_label("%{amount}") %>"
  data-donate--form-one-time-label-value="<%= one_time_label("%{amount}") %>"
  data-donate--form-currency-symbol-value="<%= @currency.symbol %>"
  data-action="donate--page:select-amount@window->donate--form#selectAmount donate--page:submit@window->donate--form#submitActive"
>
  <% if monthly? %>
    <div
      class="tw:flex tw:border-b tw:border-[#e0e0e0] tw:dark:border-gray-700"
      role="radiogroup"
      aria-label="<%= translation(".cadence") %>"
    >
      <% [["monthly", translation(".monthly")], ["one-time", translation(".one_time")]].each do |cadence, label| %>
        <label
          class="
            tw:-mb-px tw:flex-1 tw:cursor-pointer tw:border-b-3
            tw:border-transparent tw:py-2.75 tw:text-center tw:text-sm
            tw:font-semibold tw:tracking-wider tw:text-[#666] tw:uppercase
            tw:has-checked:border-blue-500 tw:has-checked:text-blue-500
            tw:has-focus-visible:bg-blue-50 tw:lg:text-[15px]
            tw:dark:text-gray-400 tw:dark:has-focus-visible:bg-gray-700
          "
        >
          <%= radio_button_tag :donate_cadence,
        cadence,
        (cadence == "one-time") == one_time?,
        id: "donate-cadence-#{cadence}",
        class: "tw:sr-only",
        autocomplete: "off",
        data: {
          donate__form_target: "cadence",
          action: "donate--form#update",
        } %>

          <%= label %>
        </label>
      <% end %>
    </div>
  <% end %>

  <div
    class="
      tw:flex tw:flex-col tw:gap-4
      tw:group-has-[#donate-cadence-one-time:checked]/donate:hidden
    "
  >
    <div
      class="
        tw:rounded-lg tw:border tw:border-[#a9d2f0] tw:bg-[#e8f3fc]
        tw:px-3.75 tw:py-3.25 tw:text-[14.5px] tw:text-[#444]
        tw:dark:border-blue-900 tw:dark:bg-blue-950 tw:dark:text-gray-200
      "
    >
      <% if @member %>
        <p class="tw:mb-1"><%= translation(".already_member") %></p>
        <%= link_to translation(".manage_membership"),
        edit_membership_path,
        class: "twlink tw:font-bold" %>
      <% else %>
        <p class="tw:mb-1">
          <%= translation(".membership_note",
          amounts: tiers.map { |level, _, _| tier_amount(level) }.to_sentence) %>
        </p>
        <%= link_to translation(".membership_link"),
        membership_path,
        class: "twlink tw:font-bold" %>
      <% end %>
    </div>

    <% if monthly? %>
      <%= form_tag membership_path, method: :post, class: "tw:flex tw:flex-col tw:gap-2.25", data: {donate__form_target: "monthlyForm"} do %>
        <%= hidden_field_tag "membership[set_interval]", "monthly", id: nil %>
        <%= hidden_field_tag :currency, @currency.slug, id: nil %>
        <%= hidden_field_tag :referral_source, @referral_source, id: nil %>

        <fieldset class="tw:flex tw:flex-col tw:gap-2.25">
          <legend class="tw:sr-only">
            <%= translation(".monthly") %>
          </legend>

          <% tiers.each do |level, name, benefit| %>
            <label class="<%= row %>">
              <%= radio_button_tag "membership[level]",
              level,
              level == :plus,
              class: "tw:sr-only",
              autocomplete: "off",
              data: {
                amount: tier_amount(level),
                action: "donate--form#update",
              } %>

              <span class="tw:min-w-12 tw:shrink-0 <%= amount_classes %>">
                <%= tier_amount(level) %>
              </span>

              <span class="tw:flex tw:flex-col">
                <span class="tw:text-[15.5px] tw:font-extrabold <%= ink %>">
                  <%= name %>
                </span>

                <span class="tw:text-[13.5px] tw:leading-snug <%= muted %>">
                  <%= benefit %>
                </span>
              </span>

              <%= radio_mark %>
            </label>
          <% end %>
        </fieldset>

        <%= submit_button.(monthly_submit) %>
      <% end %>
    <% end %>
  </div>

  <%= form_tag payments_path,
  method: :post,
  class:
    class_names(
      "tw:flex-col tw:gap-2.25",
      monthly? ? "tw:hidden tw:group-has-[#donate-cadence-one-time:checked]/donate:flex" : "tw:flex",
    ),
  data: {
    donate__form_target: "oneTimeForm",
  } do %>
    <%= hidden_field_tag "payment[kind]", "donation", id: nil %>
    <%= hidden_field_tag "payment[currency]", @currency.name, id: nil %>
    <%= hidden_field_tag "payment[email]", @email, id: nil %>
    <%= hidden_field_tag "payment[referral_source]", @referral_source, id: nil %>

    <fieldset class="tw:flex tw:flex-col tw:gap-2.25">
      <legend class="tw:sr-only"><%= translation(".one_time") %></legend>

      <% ONE_TIME_AMOUNTS.each do |amount| %>
        <label class="<%= row %>">
          <%= radio_button_tag "payment[amount_cents]",
          amount * 100,
          amount == selected_one_time,
          class: "tw:sr-only",
          autocomplete: "off",
          data: {
            amount: money(amount),
            donate__form_target: "oneTimeAmount",
            action: "donate--form#selectPreset",
          } %>

          <span class="<%= amount_classes %>"><%= money(amount) %></span>

          <%= radio_mark %>
        </label>
      <% end %>
    </fieldset>

    <label
      class="
        tw:flex tw:items-center tw:gap-1.5 tw:rounded-[5px] tw:border
        tw:border-[#e0e0e0] tw:bg-white tw:px-3.5
        tw:has-focus:border-blue-500 tw:has-focus:ring-3
        tw:has-focus:ring-blue-500/25 tw:dark:border-gray-700
        tw:dark:bg-gray-800
      "
    >
      <span class="tw:font-bold <%= muted %>" aria-hidden="true"><%= @currency.symbol %></span>
      <span class="tw:sr-only"><%= translation(".other_amount") %></span>

      <input
        type="number"
        min="1"
        step="0.01"
        inputmode="decimal"
        autocomplete="off"
        name="payment[amount]"
        value="<%= custom_amount %>"
        placeholder="<%= translation(".other_amount") %>"
        class="
          tw:w-full tw:border-0 tw:bg-transparent tw:py-3.5 tw:text-[15.5px]
          tw:outline-none tw:focus:ring-0
        "
        data-donate--form-target="customAmount"
        data-action="input->donate--form#customInput"
      >
    </label>

    <%= submit_button.(one_time_submit) %>
  <% end %>

  <p class="tw:mb-0 tw:text-[13.5px] <%= muted %>">
    <span class="tw:lg:hidden"><%= translation(".fine_print_short") %></span>
    <span class="tw:hidden tw:lg:inline"><%= translation(".fine_print") %></span>
  </p>
</div>
