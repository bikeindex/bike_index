<% container = SharedBlocks::Marketing::Wrapper::Component::CONTAINER_CLASSES %>
<% eyebrow = "tw:text-[10.5px] tw:font-extrabold tw:tracking-widest tw:uppercase tw:lg:text-[11.5px]" %>
<% muted = "tw:text-[#666] tw:dark:text-gray-400" %>
<% card = "tw:rounded-lg tw:border tw:border-[#e0e0e0] tw:bg-white tw:dark:border-gray-700 tw:dark:bg-gray-800" %>
<% band = "tw:border-[#e0e0e0] tw:bg-[#f8f8f8] tw:dark:border-gray-700 tw:dark:bg-gray-800/60" %>
<% selectable = "tw:transition-colors tw:hover:border-[#a9d2f0] tw:is-active:border-blue-600 tw:is-active:ring-1 tw:is-active:ring-blue-600" %>

<div
  data-controller="donate--page"
  data-action="donate--form:change@window->donate--page#formChanged"
>
  <div class="tw:grid tw:grid-cols-3 tw:gap-[3px] tw:bg-[#2c3e50] tw:md:grid-cols-7">
    <% WALL_PHOTOS.each do |url| %>
      <%= image_tag url,
      alt: translation(".wall_photo_alt"),
      class: "tw:h-26 tw:w-full tw:object-cover tw:max-md:last:hidden tw:md:h-40 tw:lg:h-55" %>
    <% end %>
  </div>

  <section class="tw:pt-6.5 tw:md:pb-10 tw:lg:pt-11.5 <%= container %>">
    <div class="tw:flex tw:flex-col tw:gap-6 tw:lg:flex-row tw:lg:gap-14">
      <div class="tw:flex tw:flex-1 tw:flex-col tw:gap-4.5">
        <p class="tw:mb-0 tw:text-[#cc0000] <%= eyebrow %>">
          <%= translation(".eyebrow") %>
        </p>

        <h1
          class="
            tw:mb-0 tw:font-header tw:text-[31px] tw:leading-[1.07]
            tw:font-extrabold tw:tracking-[-.01em] tw:md:text-[42px]
            tw:xl:text-[52px] tw:xl:leading-[1.04]
          "
        >
          <%= translation(".headline") %>
        </h1>

        <p
          class="
            tw:mb-0 tw:max-w-160 tw:text-base tw:leading-[1.55] tw:xl:text-[19px]
            <%= muted %>
          "
        >
          <span class="tw:lg:hidden"><%= translation(".lede_short") %></span>
          <span class="tw:hidden tw:lg:inline"><%= translation(".lede") %></span>
        </p>

        <%= render(SharedBlocks::Marketing::NumberBlocks::Component.new(items: stats, html_class: "tw:max-w-150 tw:lg:my-auto")) %>
      </div>

      <div
        id="donate-form"
        class="tw:-mx-5 tw:flex tw:scroll-mt-4 tw:flex-col tw:gap-4 tw:border-y tw:px-5 tw:py-6.5 tw:md:mx-auto tw:md:w-full tw:md:max-w-xl tw:md:rounded-lg tw:md:border tw:md:p-6.5 tw:lg:mx-0 tw:lg:w-101 tw:lg:shrink-0 tw:lg:self-start <%= band %>"
      >
        <h2
          class="
            tw:mb-0 tw:font-header tw:text-[22px] tw:font-extrabold
            tw:lg:text-2xl
          "
        >
          <%= translation(".form_title") %>
        </h2>

        <%= render(@form) %>
      </div>
    </div>
  </section>

  <section class="tw:border-y tw:py-5.5 tw:lg:border-b-0 tw:lg:py-11 <%= band %>">
    <div class="<%= container %>">
      <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(eyebrow: translation(".major_eyebrow"), eyebrow_color: :purple,
        heading: translation(".major_title"), intro: translation(".major_body"), html_class: "tw:mb-6 tw:max-w-180")) %>

      <div
        class="
          tw:mt-4 tw:flex tw:flex-col tw:gap-4 tw:md:flex-row
          tw:md:flex-wrap tw:lg:flex-nowrap
        "
      >
        <% major_gifts.each do |amount, label| %>
          <a
            href="<%= donate_path(initial_amount: amount, source: @referral_source, anchor: "donate-form") %>"
            class="tw:flex tw:flex-col tw:gap-1 tw:p-5.5 tw:text-inherit tw:no-underline tw:focus-visible:ring-3 tw:focus-visible:ring-blue-500/40 tw:focus-visible:outline-none tw:md:flex-1 tw:lg:w-59 tw:lg:flex-none <%= card %> <%= selectable %>"
            data-amount="<%= amount %>"
            data-donate--page-target="majorGift"
            data-active="<%= amount == @form.custom_amount %>"
            data-action="donate--page#selectMajor"
          >
            <span
              class="
                tw:font-header tw:text-[28px] tw:font-extrabold
                tw:lg:text-[38px]
              "
            >
              <%= @form.money(amount) %>
            </span>

            <span class="tw:text-xs tw:font-bold tw:uppercase <%= muted %>">
              <%= label %>
            </span>
          </a>
        <% end %>

        <div
          class="
            tw:py-1 tw:md:basis-full tw:md:rounded-lg tw:md:border
            tw:md:border-[#e0e0e0] tw:md:bg-white tw:md:p-5.5 tw:lg:flex-1
            tw:lg:basis-auto tw:dark:md:border-gray-700
            tw:dark:md:bg-gray-800
          "
        >
          <h3 class="tw:mb-2 tw:hidden tw:text-[17px] tw:font-extrabold tw:md:block">
            <%= translation(".other_ways_title") %>
          </h3>

          <ul class="tw:mb-2 tw:flex tw:list-none tw:flex-col tw:gap-2 tw:pl-0">
            <% [translation(".other_ways_daf"), translation(".other_ways_stock"), translation(".other_ways_match")].each do |way| %>
              <li class="tw:flex tw:gap-2.5 tw:text-[15px] <%= muted %>">
                <span
                  class="
                    tw:mt-2.5 tw:size-1.25 tw:shrink-0 tw:rounded-full
                    tw:bg-purple-500
                  "
                ></span>

                <%= way %>
              </li>
            <% end %>
          </ul>

          <%= mail_to "donate@bikeindex.org",
          translation(".larger_gift_link"),
          class: "twlink tw:text-[15px] tw:font-bold" %>
        </div>
      </div>
    </div>
  </section>

  <section
    class="
      tw:border-b tw:border-[#e0e0e0] tw:py-5.5 tw:lg:py-11
      tw:dark:border-gray-700
    "
  >
    <div class="<%= container %>">
      <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(heading: translation(".uses_title"), html_class: "tw:mb-5")) %>

      <div class="tw:grid tw:gap-3.5 tw:md:grid-cols-2 tw:lg:grid-cols-4">
        <% money_uses.each do |use| %>
          <%= render(SharedBlocks::Marketing::IconFeature::Component.new(**use, card: true)) %>
        <% end %>
      </div>
    </div>
  </section>

  <section class="tw:border-b tw:py-11 <%= band %>">
    <div class="<%= container %>">
      <%= render(SharedBlocks::Marketing::RecoveryStories::Component.new(heading: translation(".stories_title"),
        recovery_displays: @recovery_displays)) %>
    </div>
  </section>

  <%= render(SharedBlocks::Marketing::CallToActionBanner::Component.new(heading: translation(".cta_headline"),
    subheading: translation(".cta_sub"))) do %>
    <%= render UI::Button::Component.new(
      text: submit_label,
      color: :yellow,
      size: :callout,
      html_class: "tw:w-full tw:md:w-auto tw:max-md:px-4! tw:max-xs:text-xs!",
      data: {
        donate__page_target: "submit",
        action: "donate--page#submitActive"
      }
    ) %>
  <% end %>
</div>
