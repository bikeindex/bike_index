<%= render Pages::Bikes::StolenReport::Shell::Component.new(bike: @bike, status: :stolen) do %>
  <%= link_to bike_stolen_report_path(@bike), class: "twlink tw:text-sm tw:font-semibold" do %>
    <span aria-hidden="true">←</span> <%= translation(".back_to_next_steps") %>
  <% end %>

  <h2 class="tw:mt-4 tw:mb-2 tw:text-3xl tw:font-extrabold">
    <%= translation(".title") %>
  </h2>

  <p class="tw:mb-6 tw:max-w-2xl tw:text-gray-600 tw:dark:text-gray-400">
    <%= translation(".intro", bike_type: cycle_type) %>
  </p>

  <%= form_tag bike_theft_alert_path(@bike), method: :post,
      data: {controller: "bikes--promoted-alert", action: "change->bikes--promoted-alert#update"} do %>
    <%= hidden_field_tag :currency, @currency %>
    <%= hidden_field_tag :description, translation(".description") %>

    <div class="tw:grid tw:gap-8 tw:lg:grid-cols-[1fr_420px]">
      <fieldset>
        <legend class="tw:sr-only"><%= translation(".choose_plan") %></legend>

        <div class="tw:grid tw:gap-4 tw:sm:grid-cols-2 tw:xl:grid-cols-3">
          <% @plans.each do |plan| %>
            <label
              class="
                tw:relative tw:mb-0 tw:flex tw:cursor-pointer tw:flex-col
                tw:gap-2 tw:rounded-lg tw:border tw:border-gray-200
                tw:bg-white tw:p-5 tw:font-normal tw:has-checked:border-2
                tw:has-checked:border-blue-600 tw:has-focus-visible:ring-3
                tw:has-focus-visible:ring-blue-500/40
                tw:dark:border-gray-700 tw:dark:bg-gray-800
              "
            >
              <% if plan == best_value_plan && @plans.many? %>
                <span class="tw:absolute tw:-top-3 tw:left-1/2 tw:-translate-x-1/2">
                  <%= render UI::Badge::Component.new(text: translation(".best_value"), color: :notice, size: :sm) %>
                </span>
              <% end %>

              <span class="tw:flex tw:items-center tw:justify-between">
                <strong class="tw:text-lg"><%= plan.name %></strong>

                <%= radio_button_tag :theft_alert_plan_id, plan.id, plan == @selected_plan,
                    class: "tw:size-4 tw:accent-blue-600", data: {purchase_text: purchase_text(plan)} %>
              </span>

              <span class="tw:text-3xl tw:font-extrabold"><%= amount_display(plan) %></span>

              <span class="tw:text-sm">
                <%= translation(".views_html", views: tag.strong(number_display(plan.views)), bike_type: cycle_type) %>
              </span>

              <span class="tw:text-sm">
                <%= translation(".days_html", days: tag.strong(number_display(plan.duration_days))) %>
              </span>

              <% if plan.description.present? %>
                <span
                  class="
                    tw:text-sm tw:text-gray-700 tw:dark:text-gray-300
                    tw:[&_p]:mb-1 tw:[&_ul]:mb-0 tw:[&_ul]:pl-4
                  "
                >
                  <%= sanitize plan.description_html %>
                </span>
              <% end %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <%= render UI::Card::Component.new(additional_classes: "tw:rounded-lg! tw:p-5! tw:self-start") do %>
        <h3 class="tw:mb-3 tw:text-sm tw:font-bold">
          <%= translation(".preview") %>
        </h3>

        <div
          class="
            tw:flex tw:aspect-[1.9/1] tw:overflow-hidden tw:rounded-sm
            tw:bg-gray-100 tw:dark:bg-gray-700
          "
        >
          <div
            class="
              tw:flex tw:w-12 tw:shrink-0 tw:items-center tw:justify-center
              tw:bg-black
            "
          >
            <span
              class="
                tw:-rotate-90 tw:text-sm tw:font-extrabold
                tw:whitespace-nowrap tw:text-white tw:italic
              "
            >
              <%= translation(".stolen_bike") %>
              <span class="tw:text-red-500"><%= translation(".alert") %></span>
            </span>
          </div>

          <div class="tw:relative tw:flex-1">
            <% if preview_url.present? %>
              <%= image_tag preview_url, alt: "", class: "tw:size-full tw:object-cover", data: {"bikes--promoted-alert-target": "previewImage"} %>
            <% else %>
              <div
                class="
                  tw:flex tw:size-full tw:items-center tw:justify-center
                  tw:text-gray-400
                "
              >
                <%= helpers.inline_svg_tag("icons/bike.svg", class: "tw:size-12", aria_hidden: true) %>
              </div>
            <% end %>

            <% if location.present? %>
              <span
                class="
                  tw:absolute tw:right-0 tw:bottom-2 tw:bg-black tw:px-3
                  tw:py-1 tw:text-sm tw:font-bold tw:text-white
                "
              >
                <%= location %>
              </span>
            <% end %>
          </div>
        </div>

        <% if images.any? %>
          <fieldset class="tw:mt-4">
            <legend class="tw:mb-2 tw:text-sm tw:text-gray-600 tw:dark:text-gray-400">
              <%= translation(".choose_image") %>
            </legend>

            <div class="tw:flex tw:flex-wrap tw:gap-2">
              <% images.each_with_index do |image, index| %>
                <label
                  class="
                    tw:mb-0 tw:size-16 tw:cursor-pointer tw:overflow-hidden
                    tw:rounded-md tw:border-2 tw:border-transparent
                    tw:has-checked:border-blue-600
                    tw:has-focus-visible:ring-3
                  "
                >
                  <%= radio_button_tag :selected_bike_image_id, image.id, index.zero?, class: "tw:sr-only",
                      data: {image_url: image.image_url(:medium)} %>

                  <%= image_tag image.image_url(:small), alt: translation(".photo_number", number: index + 1), class: "tw:size-full tw:object-cover" %>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% elsif stock_only? %>
          <p
            class="
              tw:mt-4 tw:mb-0 tw:text-sm tw:text-gray-600
              tw:dark:text-gray-400
            "
          >
            <%= translation(".using_stock_photo", bike_type: cycle_type) %>
          </p>
        <% else %>
          <div class="tw:mt-4">
            <%= render UI::Alerts::Base::Component.new(kind: :warning, margin_classes: "") do %>
              <%= translation(".add_photo_first_html", bike_type: cycle_type,
                  link: link_to(translation(".add_a_photo"), edit_bike_stolen_report_path(@bike, step: "photos"), class: "twlink-underlined")) %>
            <% end %>
          </div>
        <% end %>

        <% if @selected_plan.present? %>
          <%= render UI::Button::Component.new(color: :primary, size: :lg, type: "submit", spinner: true,
              html_class: "tw:mt-5 tw:w-full tw:rounded-full! tw:py-3!") do %>
            <span data-bikes--promoted-alert-target="purchaseText"><%= purchase_text(@selected_plan) %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @theft_alerts.present? %>
    <div class="tw:mt-10">
      <%= helpers.render partial: "bikes/theft_alerts/table", locals: {theft_alerts: @theft_alerts, first_form_well: true} %>
    </div>
  <% end %>
<% end %>
