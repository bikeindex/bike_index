<%= render Pages::Bikes::StolenReport::Shell::Component.new(bike: @bike, status: :recovered, donation_strip: false) do %>
  <%= render UI::Card::Component.new(additional_classes: "tw:rounded-lg! tw:px-6! tw:py-7! tw:sm:px-9!") do %>
    <h2 class="tw:mb-3 tw:text-3xl tw:font-extrabold">
      <%= translation(".welcome_home", name: bike_name) %>
    </h2>

    <p class="tw:mb-0 tw:max-w-2xl tw:text-gray-700 tw:dark:text-gray-300">
      <%= translation(".marked_recovered", bike_type: cycle_type) %>
    </p>

    <% if @stolen_record.can_share_recovery %>
      <p class="tw:mt-3 tw:mb-0 tw:text-sm">
        <%= translation(".thanks_for_sharing") %>
      </p>
    <% end %>
  <% end %>

  <h2 class="tw:mt-8 tw:mb-1 tw:text-2xl tw:font-bold">
    <%= translation(".ways_to_support") %>
  </h2>

  <p class="tw:mb-5 tw:max-w-2xl tw:text-gray-600 tw:dark:text-gray-400">
    <%= translation(".ways_to_support_sub", bike_type: cycle_type) %>
  </p>

  <div class="twwiderow twwiderow-3">
    <%= form_with url: donate_path, method: :get, class: "tw:flex tw:flex-col tw:rounded-lg tw:border-2 tw:border-[#ffd660] tw:bg-white tw:p-6 tw:dark:bg-gray-800" do %>
      <%= hidden_field_tag :source, "stolen_report_recovered", id: nil %>

      <p
        class="
          tw:mb-2 tw:text-xs tw:font-bold tw:tracking-wide tw:text-[#9a7400]
          tw:uppercase
        "
      >
        <%= translation(".donate") %>
      </p>

      <h3 class="tw:mb-2 tw:text-lg tw:font-bold">
        <%= translation(".donate_title") %>
      </h3>

      <p class="tw:mb-4 tw:text-sm"><%= translation(".donate_body") %></p>

      <fieldset class="tw:mt-auto tw:mb-4">
        <legend class="tw:sr-only"><%= translation(".amount") %></legend>

        <div class="tw:flex tw:flex-wrap tw:gap-2">
          <% DONATION_AMOUNTS.each do |amount| %>
            <label
              class="
                tw:mb-0 tw:cursor-pointer tw:rounded-full tw:border-[1.5px]
                tw:border-gray-300 tw:px-3.5 tw:py-1.5 tw:text-sm
                tw:font-bold tw:has-checked:border-[#ffd660]
                tw:has-checked:bg-[#ffd660] tw:has-focus-visible:ring-3
                tw:has-focus-visible:ring-[#ffd660]/60
                tw:dark:border-gray-600 tw:dark:has-checked:text-gray-900
              "
            >
              <%= radio_button_tag :initial_amount, amount, amount == DEFAULT_DONATION, class: "tw:sr-only" %>
              <%= translation(".amount_option_html", amount: number_display(amount)) %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <%= render UI::Button::Component.new(text: translation(".donate"), color: :yellow, size: :callout_sm, type: "submit",
          html_class: "tw:w-full tw:py-3!") %>
    <% end %>

    <div
      class="
        tw:flex tw:flex-col tw:rounded-lg tw:border tw:border-gray-200
        tw:bg-white tw:p-6 tw:dark:border-gray-700 tw:dark:bg-gray-800
      "
    >
      <p
        class="
          tw:mb-2 tw:text-xs tw:font-bold tw:tracking-wide
          tw:text-purple-500 tw:uppercase
        "
      >
        <%= translation(".membership") %>
      </p>

      <h3 class="tw:mb-2 tw:text-lg tw:font-bold">
        <%= translation(".membership_title") %>
      </h3>

      <p class="tw:mb-4 tw:text-sm"><%= translation(".membership_body") %></p>

      <%= render UI::ButtonLink::Component.new(href: new_membership_path, text: translation(".membership_title"), color: :purple,
          size: :lg, html_class: "tw:mt-auto tw:w-full tw:rounded-full! tw:py-2.5!") %>
    </div>

    <div
      class="
        tw:flex tw:flex-col tw:rounded-lg tw:border tw:border-gray-200
        tw:bg-white tw:p-6 tw:dark:border-gray-700 tw:dark:bg-gray-800
      "
    >
      <p
        class="
          tw:mb-2 tw:text-xs tw:font-bold tw:tracking-wide tw:text-blue-600
          tw:uppercase
        "
      >
        <%= translation(".spread_the_word") %>
      </p>

      <h3 class="tw:mb-2 tw:text-lg tw:font-bold">
        <%= translation(".spread_title") %>
      </h3>

      <p class="tw:mb-4 tw:text-sm"><%= translation(".spread_body") %></p>

      <div class="tw:mt-auto">
        <%= render Pages::Bikes::StolenReport::ShareButtons::Component.new(url: new_register_url) %>
      </div>
    </div>
  </div>
<% end %>
