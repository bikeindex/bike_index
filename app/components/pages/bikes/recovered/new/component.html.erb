<%= render Pages::Bikes::StolenReport::Shell::Component.new(bike: @bike, status: :stolen) do %>
  <div class="tw:mx-auto tw:max-w-3xl">
    <%= link_to @back_path, class: "twlink tw:text-sm tw:font-semibold" do %>
      <span aria-hidden="true">←</span> <%= translation(".back") %>
    <% end %>

    <h2 class="tw:mt-4 tw:mb-1 tw:text-3xl tw:font-extrabold">
      <%= translation(".so_glad", bike_type: cycle_type) %>
    </h2>

    <p class="tw:mb-5 tw:text-gray-600 tw:dark:text-gray-400">
      <%= translation(".tell_us_how") %>
    </p>

    <%# novalidate: the story's own message says why it's asked, which the browser's wouldn't %>
    <%= form_with url: bike_recovered_path(@bike), scope: :recovery, method: :post, html: {novalidate: true} do |f| %>
      <%= render UI::Card::Component.new(additional_classes: "tw:rounded-lg! tw:p-6! tw:sm:px-8! tw:sm:py-7!") do %>
        <fieldset class="tw:mb-5">
          <legend class="twlabel">
            <%= translation(".how_did_you_get_it_back") %>
          </legend>

          <div class="tw:flex tw:flex-wrap tw:gap-2.5">
            <% how_options.each do |option| %>
              <label class="<%= Pages::Bikes::StolenReport::Wizard::Component::CHIP_CLASS %>">
                <%= radio_button_tag "recovery[how]", option, @submitted[:how] == option, class: "tw:sr-only" %>
                <%= option %>
              </label>
            <% end %>
          </div>
        </fieldset>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :story, label_text: translation(".tell_us_the_story"), required: true)) do %>
          <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :story, kind: :text_area, required: true,
              html_options: {rows: 4, value: @submitted[:story], "aria-invalid": missing_story? || nil,
                             class: Pages::Bikes::StolenReport::Wizard::Component::INVALID_CLASS}) %>

          <% if missing_story? %>
            <p class="tw:mt-1 tw:mb-0 tw:text-xs tw:text-red-600">
              <%= translation(".story_required") %>
            </p>
          <% end %>
        <% end %>

        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :recovered_at, label_text: translation(".date_recovered"),
            optional_badge: false, wrapper_class: "tw:mb-5 tw:max-w-xs")) do %>
          <%= date_field_tag "recovery[recovered_at]", recovered_at, id: "recovery_recovered_at", class: "twinput", max: Time.current.to_date + 1 %>
        <% end %>

        <fieldset class="tw:mb-5">
          <legend class="twlabel">
            <%= translation(".did_we_help", bike_type: cycle_type) %>
          </legend>

          <div class="tw:flex tw:flex-wrap tw:gap-2.5">
            <% helped_options.each do |value, label| %>
              <label class="<%= Pages::Bikes::StolenReport::Wizard::Component::CHIP_CLASS %>">
                <%= radio_button_tag "recovery[index_helped_recovery]", value, helped_checked?(value), class: "tw:sr-only" %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </fieldset>

        <hr class="twhr tw:my-5">

        <%= render UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :can_share_recovery, checked: can_share?) do %>
          <span class="tw:flex tw:flex-col">
            <strong><%= translation(".you_can_share") %></strong>
            <span class="tw:text-sm tw:text-gray-600 tw:dark:text-gray-400"><%= translation(".you_can_share_sub") %></span>
          </span>
        <% end %>
      <% end %>

      <div class="tw:mt-5 tw:flex tw:items-center tw:justify-end tw:gap-5">
        <%= link_to translation(".never_mind"), @back_path, class: "tw:text-sm tw:font-semibold tw:text-gray-600 tw:dark:text-gray-400" %>

        <%= render UI::Button::Component.new(text: translation(".mark_recovered"), color: :primary, size: :lg, type: "submit", spinner: true,
            html_class: "tw:rounded-full! tw:px-8! tw:py-2.5!") %>
      </div>
    <% end %>
  </div>
<% end %>
