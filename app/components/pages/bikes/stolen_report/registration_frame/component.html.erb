<%= render Pages::Register::Parts::Shell::Component.new(bare: true, data: @data) do %>
  <%= render Pages::Bikes::StolenReport::Shell::Component.new(b_param: @b_param) do %>
    <div class="tw:grid tw:gap-10 tw:lg:grid-cols-[280px_1fr]">
      <aside class="tw:flex tw:flex-col tw:gap-5 tw:self-start tw:lg:sticky tw:lg:top-5">
        <%# On a phone the steps fold behind the one being shown %>
        <div data-controller="ui--collapse">
          <div class="tw:lg:hidden">
            <%= render UI::Collapse::Component.new(text: position_text, chevron: :trailing,
                html_class: "tw:w-full tw:justify-between tw:py-2.5!") %>
          </div>

          <nav
            class="
              tw:mt-2 tw:hidden tw:rounded-lg tw:border tw:border-gray-200
              tw:bg-white tw:p-2 tw:lg:mt-0 tw:lg:block!
              tw:dark:border-gray-700 tw:dark:bg-gray-800
            "
            aria-label="<%= translation(".steps") %>"
            data-ui--collapse-target="content"
          >
            <% [[REGISTRATION_STEPS, translation(".register_group", bike_type: @b_param.type)],
              [STEPS - REGISTRATION_STEPS, translation(".report_group")]].each do |steps, group| %>
              <h2
                class="
                  tw:mx-3 tw:mt-2 tw:mb-1 tw:text-2xs tw:font-bold
                  tw:tracking-widest tw:text-gray-600 tw:uppercase
                  tw:dark:text-gray-400
                "
              >
                <%= group %>
              </h2>

              <ol
                class="tw:m-0 tw:list-none tw:p-0"
                start="<%= step_number(steps.first) %>"
              >
                <% steps.each do |step| %>
                  <%= tag.li class: "tw:flex tw:items-center tw:gap-3 tw:rounded-md tw:px-3 tw:py-2.5 tw:aria-[current=step]:bg-blue-50 tw:dark:aria-[current=step]:bg-blue-950",
                    aria: {current: ("step" if current?(step))} do %>
                    <% if done?(step) %>
                      <span
                        class="
                          tw:flex tw:size-6.5 tw:shrink-0 tw:items-center
                          tw:justify-center tw:rounded-full tw:bg-blue-600
                          tw:text-white
                        "
                      >
                        <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:size-3.5", aria_hidden: true) %>
                      </span>
                    <% else %>
                      <span class="tw:flex tw:size-6.5 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-full tw:border-[1.5px] tw:text-xs tw:font-bold <%= current?(step) ? "tw:border-blue-600 tw:bg-white tw:text-blue-600" : "tw:border-gray-300 tw:text-gray-400" %>">
                        <%= step_number(step) %>
                      </span>
                    <% end %>

                    <span class="tw:flex tw:flex-col">
                      <span class="tw:text-sm <%= current?(step) ? "tw:font-bold" : "tw:font-medium" %>"><%= step_label(step) %></span>

                      <% if current?(step) || done?(step) %>
                        <span class="tw:text-xs tw:text-gray-600 tw:dark:text-gray-400">
                          <%= current?(step) ? translation(".in_progress") : translation(".done") %>
                        </span>
                      <% end %>
                    </span>
                  <% end %>
                <% end %>
              </ol>
            <% end %>
          </nav>
        </div>

        <div class="tw:hidden tw:lg:block">
          <%= render Pages::Bikes::StolenReport::SafetyCard::Component.new(bike_type: @b_param.type) %>
        </div>
      </aside>

      <div class="tw:min-w-0">
        <div class="tw:mb-5">
          <div class="tw:flex tw:gap-1.5" aria-hidden="true">
            <% STEPS.each do |step| %>
              <span class="tw:h-1.5 tw:flex-1 tw:rounded-sm <%= step_number(step) <= step_number ? "tw:bg-purple-500" : "tw:bg-gray-200 tw:dark:bg-gray-700" %>"></span>
            <% end %>
          </div>

          <p
            class="
              tw:mt-2 tw:mb-0 tw:text-sm tw:font-semibold tw:text-gray-600
              tw:dark:text-gray-400
            "
          >
            <%= confirming? ? @title : safe_join([step_label(@step), translation(".step_of", number: step_number, total: STEPS.count)], " · ") %>
          </p>
        </div>

        <%= render UI::Card::Component.new(additional_classes: "tw:p-6! tw:sm:px-8! tw:sm:py-7! tw:rounded-lg!") do %>
          <% unless confirming? %>
            <p
              class="
                tw:mb-1 tw:text-xs tw:font-bold tw:tracking-wide
                tw:text-blue-600 tw:uppercase tw:dark:text-blue-400
              "
            >
              <%= translation(".step_of", number: step_number, total: STEPS.count) %>
            </p>
          <% end %>

          <h2 class="tw:mb-1 tw:text-2xl tw:font-bold"><%= @title %></h2>

          <p class="tw:mb-5 tw:text-sm tw:text-gray-600 tw:dark:text-gray-400">
            <%= @helper %>
          </p>

          <%= content %>
        <% end %>
      </div>

      <div class="tw:lg:hidden">
        <%= render Pages::Bikes::StolenReport::SafetyCard::Component.new(bike_type: @b_param.type) %>
      </div>
    </div>
  <% end %>
<% end %>
