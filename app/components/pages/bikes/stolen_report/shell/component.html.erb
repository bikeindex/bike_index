<div class="tw:-mt-(--nav-gap) tw:-mb-18 tw:bg-gray-50 tw:dark:bg-gray-900">
  <div
    class="
      tw:border-b tw:border-gray-200 tw:bg-white tw:dark:border-gray-700
      tw:dark:bg-gray-800
    "
  >
    <div
      class="
        twgutter tw:mx-auto tw:flex tw:max-w-7xl tw:flex-wrap
        tw:items-center tw:gap-x-5 tw:gap-y-2 tw:py-5
      "
    >
      <div
        class="
          tw:hidden tw:h-15 tw:w-21 tw:shrink-0 tw:items-center
          tw:justify-center tw:overflow-hidden tw:rounded-md tw:bg-gray-100
          tw:text-blue-600 tw:sm:flex tw:dark:bg-gray-700
        "
      >
        <% if (image_url = @bike.image_url(:small)).present? %>
          <%= image_tag image_url, alt: "", class: "tw:size-full tw:object-cover" %>
        <% else %>
          <%= helpers.inline_svg_tag("icons/bike.svg", class: "tw:size-7", aria_hidden: true) %>
        <% end %>
      </div>

      <div class="tw:min-w-60 tw:flex-1">
        <% case @status %>
        <% when :stolen %>
          <%= render UI::Badge::Component.new(text: translation(".stolen"), color: :error, indicator: true) %>
        <% when :recovered %>
          <%= render UI::Badge::Component.new(text: translation(".recovered"), color: :success) %>
        <% else %>
          <p
            class="
              tw:mb-0 tw:text-xs tw:font-bold tw:tracking-wide
              tw:text-gray-600 tw:uppercase tw:dark:text-gray-400
            "
          >
            <%= translation(".report_stolen_or_missing") %>
          </p>
        <% end %>

        <h1 class="tw:mt-1 tw:mb-0 tw:text-2xl tw:leading-tight tw:sm:text-3xl">
          <strong class="tw:font-extrabold"><%= heading %></strong>
          <span class="tw:font-medium"><%= @bike.frame_model %></span>
        </h1>

        <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:text-gray-600 tw:dark:text-gray-400">
          <%= subtitle %>
        </p>
      </div>

      <div
        class="
          tw:flex tw:shrink-0 tw:gap-x-4 tw:gap-y-1 tw:text-sm tw:font-bold
          tw:sm:flex-col tw:sm:items-end
        "
      >
        <%= link_to translation(".view_bike", bike_type: @bike.type), bike_path(@bike), class: "twlink" %>
        <%= link_to translation(".edit_bike", bike_type: @bike.type), edit_bike_path(@bike, edit_template: "bike_details"), class: "twlink" %>
      </div>
    </div>
  </div>

  <div class="twgutter tw:mx-auto tw:max-w-7xl tw:pt-8 tw:pb-16">
    <%= content %>
  </div>

  <% if @donation_strip %>
    <%= render Pages::Bikes::StolenReport::DonationStrip::Component.new %>
  <% end %>
</div>
