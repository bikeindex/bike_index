<%= helpers.turbo_frame_tag Pages::Bikes::StolenReport::StockPhotos::Component::FRAME_ID do %>
  <% if @searched %>
    <p class="tw:mt-4 tw:mb-2 tw:text-sm tw:text-gray-600 tw:dark:text-gray-400">
      <%= @results.any? ? translation(".matches", count: @results.count) : translation(".no_matches") %>
    </p>
  <% end %>

  <% if @results.any? %>
    <div class="tw:grid tw:grid-cols-2 tw:gap-3 tw:md:grid-cols-3">
      <% @results.each do |result| %>
        <label
          class="
            tw:group tw:mb-0 tw:flex tw:cursor-pointer tw:flex-col
            tw:overflow-hidden tw:rounded-md tw:border tw:border-gray-200
            tw:bg-white tw:font-normal tw:has-checked:border-blue-600
            tw:has-checked:ring-1 tw:has-checked:ring-blue-600
            tw:has-focus-visible:ring-3
            tw:has-focus-visible:ring-blue-500/40 tw:dark:border-gray-700
            tw:dark:bg-gray-800
          "
        >
          <%= radio_button_tag "stolen_record[stock_photo_id]", result[:id], result[:image_url] == @selected_url,
              id: nil, class: "tw:sr-only", data: {url: result[:image_url]} %>

          <span class="tw:aspect-16/10 tw:bg-gray-100 tw:dark:bg-gray-700">
            <%= image_tag result[:image_url], alt: "", loading: "lazy", class: "tw:size-full tw:object-contain" %>
          </span>

          <span class="tw:flex tw:flex-1 tw:flex-col tw:gap-2 tw:p-3">
            <span>
              <strong class="tw:block tw:text-sm"><%= result[:title] %></strong>
              <span class="tw:text-xs tw:text-gray-600 tw:dark:text-gray-400"><%= years(result) %></span>
            </span>

            <span
              class="
                tw:mt-auto tw:rounded-full tw:border-[1.5px]
                tw:border-blue-600 tw:px-3 tw:py-1.5 tw:text-center
                tw:text-sm tw:font-bold tw:text-blue-600
                tw:group-has-checked:bg-blue-600
                tw:group-has-checked:text-white
              "
            >
              <span class="tw:group-has-checked:hidden"><%= translation(".use_this_image") %></span>
              <span class="tw:hidden tw:group-has-checked:inline"><%= translation(".using_this_image") %></span>
            </span>
          </span>
        </label>
      <% end %>
    </div>
  <% end %>
<% end %>
