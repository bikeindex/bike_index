<%= render Pages::Bikes::StolenReport::Shell::Component.new(bike: @bike, status: editing? ? :stolen : :report) do %>
  <%= form_with(model: @stolen_record, scope: :stolen_record, url: bike_stolen_report_path(@bike),
      method: editing? ? :patch : :post, html: {novalidate: true}, data: form_data) do |f| %>
    <%= f.hidden_field :timezone, value: "", data: {"stolen-report--wizard-target": "timezone"} %>
    <%= hidden_field_tag :registered, true if @registered %>

    <%# Without JavaScript nothing moves between steps, so the report is one long form %>
    <noscript>
      <style>
        [data-stolen-report--wizard-target~="panel"] { display: block !important; margin-bottom: 1.25rem; }
        [data-stolen-report--wizard-target~="continueButton"], [data-stolen-report--wizard-target~="backButton"],
        [data-stolen-report--wizard-target~="skipButton"], [data-step="review"], [aria-label="<%= translation(".steps") %>"], [data-ui--collapse-target="trigger"] { display: none !important; }
      </style>
    </noscript>

    <div class="tw:grid tw:gap-10 tw:lg:grid-cols-[280px_1fr]">
      <aside class="tw:flex tw:flex-col tw:gap-5 tw:self-start tw:lg:sticky tw:lg:top-5">
        <%# On a phone the steps fold behind the one being shown %>
        <div data-controller="ui--collapse">
          <div class="tw:lg:hidden">
            <%= render UI::Collapse::Component.new(chevron: :trailing, html_class: "tw:w-full tw:justify-between tw:py-2.5!") do %>
              <span data-stolen-report--wizard-target="mobileStep">
                <%= safe_join([translation(".step_of", number: step_number(@step), total: total_steps), step_label(@step)], " · ") %>
              </span>
            <% end %>
          </div>

          <nav
            class="
              tw:mt-2 tw:hidden tw:rounded-lg tw:border tw:border-gray-200
              tw:bg-white tw:p-2 tw:lg:mt-0 tw:lg:block!
              tw:dark:border-gray-700 tw:dark:bg-gray-800
            "
            aria-label="<%= translation(".steps") %>"
            data-ui--collapse-target="content"
          >
            <% if @registered %>
              <h2
                class="
                  tw:mx-3 tw:mt-2 tw:mb-1 tw:text-2xs tw:font-bold
                  tw:tracking-widest tw:text-gray-600 tw:uppercase
                  tw:dark:text-gray-400
                "
              >
                <%= translation(".register_group", bike_type: cycle_type) %>
              </h2>
              <ol class="tw:m-0 tw:list-none tw:p-0">
                <% REGISTRATION_STEPS.each_with_index do |step, index| %>
                  <li class="tw:flex tw:items-center tw:gap-3 tw:px-3 tw:py-2.5">
                    <span
                      class="
                        tw:flex tw:size-6.5 tw:shrink-0 tw:items-center
                        tw:justify-center tw:rounded-full tw:bg-blue-600
                        tw:text-white
                      "
                    >
                      <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:size-3.5", aria_hidden: true) %>
                      <span class="tw:sr-only"><%= index + 1 %></span>
                    </span>

                    <span class="tw:flex tw:flex-col">
                      <span class="tw:text-sm tw:font-medium"><%= step_label(step) %></span>
                      <span class="tw:text-xs tw:text-gray-600 tw:dark:text-gray-400"><%= translation(".done") %></span>
                    </span>
                  </li>
                <% end %>
              </ol>
              <h2
                class="
                  tw:mx-3 tw:mt-3 tw:mb-1 tw:text-2xs tw:font-bold
                  tw:tracking-widest tw:text-gray-600 tw:uppercase
                  tw:dark:text-gray-400
                "
              >
                <%= translation(".report_group") %>
              </h2>
            <% end %>

            <ol
              class="tw:m-0 tw:list-none tw:p-0"
              start="<%= step_offset + 1 %>"
            >
              <% STEPS.each do |step| %>
                <li>
                  <%= render UI::Button::Component.new(color: :link,
                    html_class: "tw:group tw:w-full tw:justify-start tw:gap-3 tw:rounded-md! tw:px-3! tw:py-2.5! tw:text-left " \
                      "tw:twtext-color! tw:no-underline! tw:aria-[current=step]:bg-blue-50 tw:dark:aria-[current=step]:bg-blue-950",
                    aria: {current: (current?(step) ? "step" : nil)},
                    data: {"stolen-report--wizard-target": "railItem", step:,
                           action: "stolen-report--wizard#goto", "stolen-report--wizard-step-param": step}) do %>
                    <span
                      class="
                        tw:flex tw:size-6.5 tw:shrink-0 tw:items-center
                        tw:justify-center tw:rounded-full tw:border-[1.5px]
                        tw:border-gray-300 tw:bg-white tw:text-xs
                        tw:font-bold tw:text-gray-400
                        tw:group-aria-[current=step]:border-blue-600
                        tw:group-aria-[current=step]:text-blue-600
                        tw:group-data-[done=true]:border-blue-600
                        tw:group-data-[done=true]:bg-blue-600
                        tw:group-data-[done=true]:text-white
                        tw:group-aria-[current=step]:group-data-[done=true]:bg-white
                        tw:group-aria-[current=step]:group-data-[done=true]:text-blue-600
                      "
                      data-stolen-report--wizard-target="railMarker"
                    >
                      <%= step_number(step) %>
                    </span>

                    <span class="tw:flex tw:flex-col">
                      <span
                        class="
                          tw:text-sm tw:font-medium
                          tw:group-aria-[current=step]:font-bold
                        "
                        data-step-label
                      >
                        <%= step_label(step) %>
                      </span>

                      <span
                        class="
                          tw:text-xs tw:font-normal tw:text-gray-600
                          tw:data-[skipped=true]:text-[#9a7400]
                          tw:dark:text-gray-400
                        "
                        data-stolen-report--wizard-target="railNote"
                      >
                        <%= translation(".in_progress") if current?(step) %>
                      </span>
                    </span>
                  <% end %>
                </li>
              <% end %>
            </ol>
          </nav>
        </div>

        <div class="tw:hidden tw:lg:block">
          <%= render Pages::Bikes::StolenReport::SafetyCard::Component.new(bike_type: cycle_type) %>
        </div>
      </aside>

      <div class="tw:min-w-0">
        <div class="tw:mb-5">
          <div class="tw:flex tw:gap-1.5" aria-hidden="true">
            <% total_steps.times do |index| %>
              <span
                class="
                  tw:h-1.5 tw:flex-1 tw:rounded-sm tw:bg-gray-200
                  tw:transition-colors tw:duration-300
                  tw:data-[filled=true]:bg-purple-500 tw:dark:bg-gray-700
                "
                data-filled="<%= index < step_number(@step) %>"
                data-stolen-report--wizard-target="progressSegment"
              ></span>
            <% end %>
          </div>

          <p
            class="
              tw:mt-2 tw:mb-0 tw:flex tw:items-center tw:gap-1.5 tw:text-sm
              tw:font-semibold tw:text-gray-600 tw:dark:text-gray-400
            "
          >
            <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:size-4 tw:text-green-600", aria_hidden: true) %>

            <span
              data-stolen-report--wizard-target="progressLabel"
              aria-live="polite"
            >
              <%= safe_join([progress_saved_text, step_label(@step),
                translation(".step_of", number: step_number(@step), total: total_steps)].compact, " · ") %>
            </span>
          </p>
        </div>

        <% if @missing.any? %>
          <%= render UI::Alerts::Base::Component.new(kind: :error, text: translation(".missing_required")) %>
        <% end %>

        <%# When and where %>
        <section
          class="<%= panel_class("where") %>"
          data-stolen-report--wizard-target="panel"
          data-step="where"
        >
          <% if @registered %>
            <%= render UI::Alerts::Base::Component.new(kind: :success,
                text: translation(".registered_html", registered: tag.strong(translation(".registered_strong", bike_type: cycle_type)))) %>
          <% end %>

          <%= render UI::Card::Component.new(additional_classes: "tw:p-6! tw:sm:px-8! tw:sm:py-7! tw:rounded-lg!") do %>
            <%= step_heading("where", title: translation(".where_title"), helper: translation(".where_helper")) %>

            <div class="twfieldrow">
              <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :date, label_text: translation(".date"), required: true)) do %>
                <%= date_field_tag "stolen_record[date]", date_value, id: "stolen_record_date", required: true, max: Time.current.to_date + 1,
                    class: "twinput #{INVALID_CLASS}", "aria-invalid": invalid?(:date) || nil,
                    data: {"stolen-report--wizard-target": "date", initial: date_stolen_iso} %>

                <p
                  class="tw:mt-1 tw:mb-0 tw:text-xs tw:text-red-600 <%= "tw:hidden" if future_date? %> <%= "tw:hidden" unless invalid?(:date) %>"
                  data-error-for="date"
                >
                  <%= translation(".required") %>
                </p>

                <p
                  class="tw:mt-1 tw:mb-0 tw:text-xs tw:text-red-600 <%= "tw:hidden" unless future_date? %>"
                  data-error-for="date"
                  data-problem="future"
                >
                  <%= translation(".date_in_future") %>
                </p>
              <% end %>

              <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :time, label_text: translation(".approximate_time"))) do |group| %>
                <%= time_field_tag "stolen_record[time]", time_value, id: "stolen_record_time", class: "twinput", "aria-describedby": group.helper_text_id,
                    data: {"stolen-report--wizard-target": "time"} %>

                <% group.with_helper_text { translation(".best_guess") } %>
              <% end %>
            </div>

            <div class="twfieldrow">
              <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :country_id, label_text: translation(".country"))) do %>
                <%= render(UI::Forms::Select::Component.new(form_builder: f, attribute: :country_id,
                    option_tags: Country.select_options, options: {selected: @stolen_record.country_id},
                    html_options: {class: "tw:w-full", data: {action: "change->ui--forms--address-group#toggleCountry",
                                                             "ui--forms--address-group-target": "country"}})) %>
              <% end %>

              <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :street, label_text: translation(".address_or_intersection"),
                  html_options: {placeholder: translation(".street_placeholder"), autocomplete: "off"}) do |group| %>
                <% group.with_helper_text { translation(".never_shown") } %>
              <% end %>
            </div>

            <div class="tw:grid tw:gap-x-4 tw:sm:grid-cols-[2fr_1fr_1fr]">
              <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :city, label_text: translation(".city"), required: true)) do %>
                <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :city, required: true,
                    html_options: {class: INVALID_CLASS, "aria-invalid": invalid?(:city) || nil, autocomplete: "address-level2"}) %>

                <p
                  class="tw:mt-1 tw:mb-0 tw:hidden tw:text-xs tw:text-red-600"
                  data-error-for="city"
                >
                  <%= translation(".city_required") %>
                </p>
              <% end %>

              <div
                class="<%= "tw:hidden" unless @stolen_record.country_id == Country.united_states_id %>"
                data-ui--forms--address-group-target="state"
              >
                <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :region_record_id, label_text: translation(".state"))) do %>
                  <%= render(UI::Forms::ComboboxState::Component.new(name: :region_record_id, ids: true, html_options: {form: f})) %>
                <% end %>
              </div>

              <div
                class="<%= "tw:hidden" if @stolen_record.country_id == Country.united_states_id %>"
                data-ui--forms--address-group-target="region"
              >
                <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :region_string, label_text: translation(".region")) %>
              </div>

              <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :postal_code, label_text: translation(".postal_code"), required: true)) do %>
                <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :postal_code, required: true,
                    html_options: {class: INVALID_CLASS, "aria-invalid": invalid?(:postal_code) || nil, autocomplete: "postal-code"}) %>

                <p
                  class="tw:mt-1 tw:mb-0 tw:hidden tw:text-xs tw:text-red-600"
                  data-error-for="postal_code"
                >
                  <%= translation(".required") %>
                </p>
              <% end %>
            </div>
          <% end %>
        </section>

        <%# How it was locked, and what happened %>
        <section
          class="<%= panel_class("lock") %>"
          data-stolen-report--wizard-target="panel"
          data-step="lock"
        >
          <%= render UI::Card::Component.new(additional_classes: "tw:p-6! tw:sm:px-8! tw:sm:py-7! tw:rounded-lg!") do %>
            <%= step_heading("lock", title: translation(".lock_title"), helper: translation(".lock_helper")) %>

            <fieldset class="tw:mb-5">
              <legend class="twlabel"><%= translation(".what_lock") %></legend>

              <div class="tw:flex tw:flex-wrap tw:gap-2.5">
                <% lock_options.each do |label, value| %>
                  <label class="<%= CHIP_CLASS %>">
                    <%= f.radio_button :locking_description, value, class: "tw:sr-only" %>
                    <%= label %>
                  </label>
                <% end %>
              </div>
            </fieldset>

            <fieldset class="tw:mb-5">
              <legend class="twlabel">
                <%= translation(".what_happened_to_lock") %>
              </legend>

              <div class="tw:grid tw:gap-2.5 tw:sm:grid-cols-2">
                <% lock_defeat_options.each do |label, value| %>
                  <label class="<%= CARD_CLASS %>">
                    <%= f.radio_button :lock_defeat_description, value, class: "tw:mt-0.5 tw:accent-blue-600" %>
                    <span><%= label %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>

            <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :theft_description, label_text: translation(".what_happened"),
                required: true, wrapper_class: "tw:mb-0")) do |group| %>
              <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :theft_description, kind: :text_area, required: true,
                  html_options: {rows: 4, placeholder: translation(".what_happened_placeholder"), class: INVALID_CLASS,
                                 "aria-invalid": invalid?(:theft_description) || nil, "aria-describedby": group.helper_text_id}) %>

              <p
                class="tw:mt-1 tw:mb-0 tw:hidden tw:text-xs tw:text-red-600"
                data-error-for="theft_description"
              >
                <%= translation(".what_happened_required") %>
              </p>

              <% group.with_helper_text { translation(".what_happened_helper") } %>
            <% end %>
          <% end %>
        </section>

        <%# Photos, or a stock photo in their place %>
        <section
          class="<%= panel_class("photos") %>"
          data-stolen-report--wizard-target="panel"
          data-step="photos"
        >
          <%= render UI::Card::Component.new(additional_classes: "tw:p-6! tw:sm:px-8! tw:sm:py-7! tw:rounded-lg!") do %>
            <%= step_heading("photos", title: translation(".photos_title", bike_type: cycle_type), helper: translation(".photos_helper", bike_type: cycle_type)) %>

            <div class="twwiderow tw:mb-5">
              <%= render Pages::Bikes::StolenReport::PhotoShot::Component.new(bike: @bike, kind: :drive_side, public_image: photos.first,
                  title: translation(".drive_side"), badge: translation(".required_badge"), badge_color: :notice,
                  hint: translation(".drive_side_hint", bike_type: cycle_type)) %>

              <%= render Pages::Bikes::StolenReport::PhotoShot::Component.new(bike: @bike, kind: :unique_marks, public_image: photos.second,
                  title: translation(".unique_marks"), badge: translation(".recommended_badge"), badge_color: :gray,
                  hint: translation(".unique_marks_hint")) %>
            </div>

            <p
              class="
                tw:-mt-2 tw:mb-4 tw:text-xs tw:text-gray-600
                tw:dark:text-gray-400
              "
            >
              <%= translation(".photos_saved_right_away", bike_type: cycle_type) %>
            </p>

            <div
              class="<%= "tw:hidden" if photos.none? %>"
              data-stolen-report--wizard-target="photoAdded"
            >
              <%= render UI::Alerts::Base::Component.new(kind: :success, text: translation(".drive_side_added"), margin_classes: "tw:mb-0") %>
            </div>

            <div
              class="tw:rounded-lg tw:border tw:border-gray-200 tw:bg-gray-50 tw:p-5 tw:dark:border-gray-700 tw:dark:bg-gray-900 <%= "tw:hidden" if photos.any? %>"
              data-stolen-report--wizard-target="stockPhotos"
            >
              <h3 class="tw:mb-1 tw:text-base tw:font-bold">
                <%= translation(".stock_photo_title") %>
              </h3>

              <p class="tw:mb-4 tw:text-sm tw:text-gray-600 tw:dark:text-gray-400">
                <%= translation(".stock_photo_helper", bike_type: cycle_type) %>
              </p>

              <div class="tw:flex tw:flex-wrap tw:items-end tw:gap-3">
                <%# Unnamed: they search, they aren't part of the report %>
                <label class="tw:mb-0 tw:min-w-32 tw:flex-1">
                  <span class="twlabel"><%= translation(".make") %></span>

                  <input
                    type="text"
                    class="twinput"
                    value="<%= @bike.mnfg_name %>"
                    autocomplete="off"
                    data-stolen-report--wizard-target="stockManufacturer"
                  >
                </label>

                <label class="tw:mb-0 tw:min-w-32 tw:flex-1">
                  <span class="twlabel"><%= translation(".model") %></span>

                  <input
                    type="text"
                    class="twinput"
                    value="<%= @bike.frame_model %>"
                    autocomplete="off"
                    data-stolen-report--wizard-target="stockModel"
                  >
                </label>

                <label class="tw:mb-0 tw:w-24">
                  <span class="twlabel"><%= translation(".year") %></span>

                  <input
                    type="number"
                    class="twinput"
                    value="<%= @bike.year %>"
                    inputmode="numeric"
                    autocomplete="off"
                    data-stolen-report--wizard-target="stockYear"
                  >
                </label>

                <%= render UI::Button::Component.new(text: translation(".search_bike_book"), color: :primary, size: :lg,
                    html_class: "tw:rounded-full! tw:px-6!",
                    data: {action: "stolen-report--wizard#searchStockPhotos"}) %>
              </div>

              <%= helpers.turbo_frame_tag "stolen_report_stock_photos", src: (stock_photos_src if @bike.mnfg_name.present?), loading: :lazy,
                  data: {"stolen-report--wizard-target": "stockPhotosFrame"} %>
            </div>
          <% end %>
        </section>

        <%# Police report %>
        <section
          class="<%= panel_class("police") %>"
          data-stolen-report--wizard-target="panel"
          data-step="police"
        >
          <%= render UI::Card::Component.new(additional_classes: "tw:p-6! tw:sm:px-8! tw:sm:py-7! tw:rounded-lg!") do %>
            <%= step_heading("police", title: translation(".police_title"), helper: translation(".police_helper", bike_type: cycle_type)) %>

            <%# Not part of the report - it only says which half of the step to show %>
            <div
              class="
                tw:mb-5 tw:inline-flex tw:rounded-full tw:bg-gray-100 tw:p-1
                tw:dark:bg-gray-700
              "
              role="radiogroup"
            >
              <% {"have" => translation(".have_report"), "none" => translation(".no_report_yet")}.each do |value, label| %>
                <label
                  class="
                    tw:mb-0 tw:cursor-pointer tw:rounded-full tw:px-4
                    tw:py-2 tw:text-sm tw:font-semibold tw:text-gray-600
                    tw:has-checked:bg-white tw:has-checked:text-gray-900
                    tw:has-checked:shadow-sm tw:has-focus-visible:ring-3
                    tw:has-focus-visible:ring-blue-500/40
                    tw:dark:text-gray-300 tw:dark:has-checked:bg-gray-900
                    tw:dark:has-checked:text-white
                  "
                >
                  <%= radio_button_tag :police_report_status, value, value == "have", class: "tw:sr-only" %>
                  <%= label %>
                </label>
              <% end %>
            </div>

            <div class="twfieldrow" data-show-when="police_report_status=have">
              <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :police_report_number,
                  label_text: translation(".report_number"), html_options: {autocomplete: "off"}) %>

              <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :police_report_department,
                  label_text: translation(".department_and_city")) %>
            </div>

            <div
              class="
                tw:hidden tw:rounded-lg tw:bg-gray-50 tw:p-5
                tw:dark:bg-gray-900
              "
              data-show-when="police_report_status=none"
            >
              <h3 class="tw:mb-3 tw:text-base tw:font-bold">
                <%= translation(".how_to_file") %>
              </h3>

              <ol
                class="
                  tw:m-0 tw:flex tw:list-none tw:flex-col tw:gap-3 tw:p-0
                  tw:text-sm
                "
              >
                <% [translation(".how_to_file_search", bike_type: cycle_type),
                    serial ? translation(".how_to_file_call_html", serial: tag.strong(serial)) : translation(".how_to_file_call_no_serial"),
                    translation(".how_to_file_come_back")].each_with_index do |instruction, index| %>
                  <li class="tw:flex tw:items-start tw:gap-3">
                    <span
                      class="
                        tw:flex tw:size-6 tw:shrink-0 tw:items-center
                        tw:justify-center tw:rounded-full tw:bg-slate-900
                        tw:text-xs tw:font-bold tw:text-white
                      "
                    >
                      <%= index + 1 %>
                    </span>

                    <span><%= instruction %></span>
                  </li>
                <% end %>
              </ol>
            </div>
          <% end %>
        </section>

        <%# Contact and who sees it %>
        <section
          class="<%= panel_class("contact") %>"
          data-stolen-report--wizard-target="panel"
          data-step="contact"
        >
          <%= render UI::Card::Component.new(additional_classes: "tw:p-6! tw:sm:px-8! tw:sm:py-7! tw:rounded-lg!") do %>
            <%= step_heading("contact", title: translation(".contact_title"), helper: translation(".contact_helper", bike_type: cycle_type)) %>

            <div class="twfieldrow">
              <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :phone, kind: :telephone_field,
                  label_text: translation(".phone"), html_options: {autocomplete: "tel"}) %>

              <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :secondary_phone, kind: :telephone_field,
                  label_text: translation(".secondary_phone")) %>
            </div>

            <fieldset class="tw:flex tw:flex-col tw:gap-2">
              <legend class="twlabel tw:mb-2">
                <%= translation(".who_can_see_phone") %>
              </legend>

              <% phone_visibility_entries.each do |attribute, label| %>
                <%= render UI::Forms::Checkbox::Component.new(form_builder: f, attribute:, label:, checked: checked?(attribute)) %>
              <% end %>
            </fieldset>

            <hr class="twhr tw:my-5">

            <%= render UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :receive_notifications,
                checked: checked?(:receive_notifications)) do %>
              <span class="tw:flex tw:flex-col">
                <strong><%= translation(".receive_notifications", bike_type: cycle_type) %></strong>
                <span class="tw:text-sm tw:text-gray-600 tw:dark:text-gray-400"><%= translation(".receive_notifications_helper") %></span>
              </span>
            <% end %>
          <% end %>
        </section>

        <%# Value and proof of ownership %>
        <section
          class="<%= panel_class("extra") %>"
          data-stolen-report--wizard-target="panel"
          data-step="extra"
        >
          <%= render UI::Card::Component.new(additional_classes: "tw:p-6! tw:sm:px-8! tw:sm:py-7! tw:rounded-lg!") do %>
            <%= step_heading("extra", title: translation(".extra_title"), helper: translation(".extra_helper")) %>

            <div class="tw:flex tw:flex-wrap tw:items-end tw:gap-x-6">
              <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :estimated_value, kind: :number_field,
                  label_text: translation(".estimated_value", currency: t("number.currency.format.unit")),
                  wrapper_class: "tw:mb-4 tw:w-full tw:max-w-xs",
                  html_options: {min: 1, inputmode: "numeric", disabled: value_unknown?,
                                 data: {"stolen-report--wizard-target": "estimatedValue"}}) %>

              <%= render UI::Forms::Checkbox::Component.new(name: "stolen_record[value_unknown]", label: translation(".not_sure_value"),
                  checked: value_unknown?, class_name: "tw:mb-6", html_options: {data: {"stolen-report--wizard-target": "valueUnknown"}}) %>
            </div>

            <fieldset>
              <legend class="twlabel tw:mb-0">
                <%= translation(".proof_of_ownership") %>
              </legend>

              <p class="tw:mb-2 tw:text-sm tw:text-gray-600 tw:dark:text-gray-400">
                <%= translation(".proof_of_ownership_helper", bike_type: cycle_type) %>
              </p>

              <div class="tw:flex tw:flex-wrap tw:gap-2.5">
                <% proof_entries.each do |value, label| %>
                  <label class="<%= CHIP_CLASS %>">
                    <%= f.radio_button :proof_of_ownership, value, checked: proof_checked?(value), class: "tw:sr-only" %>
                    <%= label %>
                  </label>
                <% end %>
              </div>
            </fieldset>
          <% end %>
        </section>

        <%# Review %>
        <section
          class="<%= panel_class("review") %>"
          data-stolen-report--wizard-target="panel"
          data-step="review"
        >
          <%= render UI::Card::Component.new(additional_classes: "tw:p-6! tw:sm:px-8! tw:sm:py-7! tw:rounded-lg!") do %>
            <%= step_heading("review", title: translation(".review_title"), helper: translation(".review_helper")) %>

            <dl class="tw:m-0">
              <% (STEPS - ["review"]).each do |step| %>
                <div
                  class="
                    tw:grid tw:grid-cols-[1fr_auto] tw:items-center
                    tw:gap-x-6 tw:gap-y-1 tw:border-t tw:border-gray-200
                    tw:py-3.5 tw:sm:grid-cols-[180px_1fr_auto]
                    tw:dark:border-gray-700
                  "
                >
                  <dt class="tw:text-sm tw:font-bold">
                    <%= step_label(step) %>
                  </dt>

                  <dd
                    class="
                      tw:col-span-2 tw:row-start-2 tw:m-0 tw:text-sm
                      tw:data-[missing=true]:text-[#9a7400] tw:sm:col-span-1
                      tw:sm:row-start-auto
                    "
                    data-stolen-report--wizard-target="summary"
                    data-step="<%= step %>"
                  ></dd>

                  <dd class="tw:col-start-2 tw:row-start-1 tw:m-0 tw:sm:col-start-3">
                    <%= render UI::Button::Component.new(text: translation(".edit"), color: :link, html_class: "tw:text-sm tw:font-bold",
                        data: {action: "stolen-report--wizard#goto", "stolen-report--wizard-step-param": step,
                               "stolen-report--wizard-target": "summaryLink", step:}) %>
                  </dd>
                </div>
              <% end %>
            </dl>
          <% end %>
        </section>

        <div class="tw:mt-5 tw:flex tw:items-center tw:gap-4">
          <%= render UI::Button::Component.new(text: translation(".back"), color: :link, html_class: "tw:px-4 tw:font-bold #{"tw:invisible" if current?(STEPS.first)}",
              data: {action: "stolen-report--wizard#back", "stolen-report--wizard-target": "backButton"}) %>

          <span class="tw:flex-1"></span>

          <%= render UI::Button::Component.new(text: translation(".skip_for_now"), color: :link,
              html_class: "tw:text-gray-600! tw:font-semibold tw:hidden!",
              data: {action: "stolen-report--wizard#skip", "stolen-report--wizard-target": "skipButton"}) %>

          <%= render UI::Button::Component.new(text: translation(".continue"), color: editing? ? :secondary : :primary, size: :lg,
              html_class: "tw:rounded-full! tw:px-8! tw:py-2.5! #{"tw:hidden!" if current?("review")}",
              data: {action: "stolen-report--wizard#next", "stolen-report--wizard-target": "continueButton"}) %>

          <%= render UI::Button::Component.new(text: submit_text, color: editing? ? :primary : :danger, size: :lg, type: "submit", spinner: true,
              html_class: "tw:rounded-full! tw:px-8! tw:py-2.5! #{"tw:hidden!" unless current?("review") || editing?}",
              data: {"stolen-report--wizard-target": "submitButton"}) %>

          <%# The one above is shown on the review, which only JavaScript reaches %>
          <noscript>
            <%= render UI::Button::Component.new(text: submit_text, color: :danger, size: :lg, type: "submit",
                html_class: "tw:rounded-full! tw:px-8! tw:py-2.5!") %>
          </noscript>
        </div>
      </div>

      <div class="tw:lg:hidden">
        <%= render Pages::Bikes::StolenReport::SafetyCard::Component.new(bike_type: cycle_type) %>
      </div>
    </div>
  <% end %>
<% end %>
