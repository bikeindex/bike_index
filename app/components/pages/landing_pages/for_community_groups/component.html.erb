<section class="tw:border-b tw:border-gray-200 tw:dark:border-gray-700">
  <div class="tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] tw:items-center tw:gap-10 tw:pt-10 tw:pb-15 tw:sm:pt-16 <%= SECTION_CLASSES %>">
    <div>
      <span class="tw:mb-4.5 tw:inline-block tw:tracking-wider tw:uppercase">
        <%= render(UI::Badge::Component.new(text: translation(".eyebrow"), color: :notice, size: :lg)) %>
      </span>

      <h1
        class="
          tw:m-0 tw:mb-4 tw:font-header tw:text-[clamp(38px,5vw,54px)]
          tw:leading-[1.05] tw:font-black tw:tracking-[-.01em]
          tw:text-balance
        "
      >
        <%= translation(".help_your_riders") %>
      </h1>

      <p class="tw:m-0 tw:mb-7 tw:max-w-120 tw:text-[19px] tw:leading-[1.55] tw:text-pretty <%= MUTED %>">
        <%= translation(".lede") %>
      </p>

      <div class="tw:flex tw:flex-col tw:gap-4 tw:sm:flex-row tw:sm:flex-wrap">
        <%= render(UI::ButtonLink::Component.new(href: @sign_up_path, text: translation(".sign_up_for_free"),
          color: :primary, size: :callout)) %>

        <%= render(UI::ButtonLink::Component.new(href: recovery_stories_path, text: translation(".recovery_stories"),
          color: :secondary, size: :callout, html_class: OUTLINE)) %>
      </div>

      <p class="tw:m-0 tw:mt-6 <%= CALLOUT %>">
        <%= helpers.inline_svg_tag("icons/bolt.svg", class: "tw:size-5.5 tw:shrink-0 tw:text-purple-500", aria_hidden: true) %>

        <span class="tw:flex-1">
          <%= translation(".ask_about_ebike_education") %>

          <%= link_to(translation(".new_for_ebike_riders"), "#ebikes", class: "twlink tw:py-2.5 tw:font-semibold tw:whitespace-nowrap") %>
        </span>
      </p>
    </div>

    <div class="tw:flex tw:justify-center">
      <%= image_tag("kelsey/illustrations/comic-assets_bike-hero.png", alt: "", width: 420, height: 314, class: "tw:h-auto tw:w-full tw:max-w-105") %>
    </div>
  </div>

  <div
    class="
      tw:border-t tw:border-gray-200 tw:bg-gray-50 tw:dark:border-gray-700
      tw:dark:bg-gray-800
    "
  >
    <ul class="tw:m-0 tw:grid tw:list-none tw:grid-cols-[repeat(auto-fit,minmax(200px,1fr))] tw:gap-4 tw:py-5 <%= SECTION_CLASSES %>">
      <% trust_items.each do |icon, text| %>
        <li class="tw:flex tw:items-center tw:gap-2.5 tw:text-[15px] tw:font-semibold">
          <%= helpers.inline_svg_tag(icon, class: "tw:size-5 tw:shrink-0 tw:text-blue-600", aria_hidden: true) %>
          <%= text %>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<section class="tw:@container tw:pt-18 tw:pb-16 <%= SECTION_CLASSES %>">
  <div
    class="
      tw:mb-12 tw:grid
      tw:grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))]
      tw:items-center tw:gap-12
    "
  >
    <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(eyebrow: translation(".why_it_matters"), eyebrow_color: :red,
      heading: translation(".a_registered_bike_can_come_home"), intro: translation(".most_stolen_bikes_are_never_returned"))) %>

    <%= render(SharedBlocks::Marketing::NumberBlocks::Component.new(items: stats)) %>
  </div>

  <ol
    class="
      tw:m-0 tw:grid tw:list-none tw:grid-cols-1 tw:gap-5 tw:p-0
      tw:@lg:grid-cols-2 tw:@4xl:grid-cols-4
    "
  >
    <% steps.each_with_index do |(color, title, body), index| %>
      <li class="tw:flex">
        <%= render(UI::Card::Component.new(shadow: true, additional_classes: "tw:w-full tw:rounded-lg! tw:p-6!")) do %>
          <span class="tw:mb-2.5 tw:block tw:font-header tw:text-[34px] tw:leading-none tw:font-black <%= color %>">
            <%= index + 1 %>
          </span>

          <h3 class="tw:m-0 tw:mb-1.5 tw:font-header tw:text-lg tw:font-bold">
            <%= title %>
          </h3>

          <p class="tw:m-0 tw:text-[15px] tw:leading-[1.6] <%= MUTED %>">
            <%= body %>
          </p>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>

<section class="tw:pb-18 <%= SECTION_CLASSES %>">
  <%= render(SharedBlocks::Marketing::RecoveryStories::Component.new(heading: translation(".recovered_in_their_own_words"),
    recovery_displays: @recovery_displays)) %>
</section>

<section
  id="ebikes"
  class="
    tw:scroll-mt-6 tw:border-y tw:border-gray-200 tw:bg-gray-50
    tw:dark:border-gray-700 tw:dark:bg-gray-800
  "
>
  <div class="tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] tw:items-center tw:gap-12 tw:py-18 <%= SECTION_CLASSES %>">
    <div>
      <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(eyebrow: translation(".new_for_ebike_riders"), eyebrow_color: :purple,
        heading: translation(".we_love_ebikes"), intro: translation(".ebikes_bring_new_riders"))) %>

      <p
        class="
          tw:m-0 tw:mt-3 tw:text-[15px] tw:leading-relaxed tw:text-pretty
          tw:text-gray-500 tw:lg:text-[17px] tw:dark:text-gray-400
        "
      >
        <%= translation(".ebike_registration_education") %>
      </p>

      <%= link_to(ebike_rules_path, class: "tw:mt-3 tw:inline-flex tw:items-center tw:gap-2 tw:py-2.5 tw:text-base tw:font-semibold twlink") do %>
        <%= helpers.inline_svg_tag("icons/map.svg", class: "tw:size-5", aria_hidden: true) %>
        <%= translation(".check_ebike_rules") %>

        <span aria-hidden="true">→</span>
      <% end %>
    </div>

    <div class="tw:p-7 <%= COMIC_CARD %>">
      <div class="tw:mb-4 tw:flex tw:items-baseline tw:justify-between tw:gap-4">
        <h3 class="tw:m-0 tw:font-header tw:text-xl tw:font-extrabold">
          <%= translation(".ebike_education") %>
        </h3>

        <span
          aria-hidden="true"
          class="
            tw:font-header tw:text-2xl tw:font-black tw:text-purple-500
            tw:italic
          "
        >
          <%= translation(".zoom") %>
        </span>
      </div>

      <ul class="tw:m-0 tw:flex tw:list-none tw:flex-col tw:gap-3.5 tw:p-0">
        <% ebike_topics.each do |icon, title, detail| %>
          <li class="tw:flex tw:items-start tw:gap-3">
            <%= helpers.inline_svg_tag(icon, class: "tw:size-5.5 tw:shrink-0 tw:text-blue-600", aria_hidden: true) %>

            <span class="<%= MUTED %>">
              <strong class="tw:text-slate-900 tw:dark:text-gray-100"><%= title %></strong>
              <%= detail %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</section>

<section class="tw:pt-18 tw:pb-16 <%= SECTION_CLASSES %>">
  <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(eyebrow: translation(".free_tools_for_your_group"),
    heading: translation(".everything_you_need"), html_class: "tw:mb-8 tw:max-w-[720px]")) %>

  <div
    class="
      tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))]
      tw:gap-5
    "
  >
    <% tools.each do |icon, circle, title, body| %>
      <%= render(SharedBlocks::Marketing::IconFeature::Component.new(icon:, circle:, title:, body:, card: true)) %>
    <% end %>
  </div>

  <p class="tw:m-0 tw:mt-7 <%= CALLOUT %>">
    <%= helpers.inline_svg_tag("icons/lucide-store.svg", class: "tw:size-5.5 tw:shrink-0 tw:text-blue-600", aria_hidden: true) %>

    <span class="tw:flex-1">
      <%= translation(".we_also_work_with_bike_shops") %>
      <%= link_to(translation(".bike_index_for_bike_shops"), for_bike_shops_path, class: "tw:py-2.5 tw:font-semibold tw:whitespace-nowrap twlink") %>
    </span>
  </p>
</section>

<section class="tw:pb-16 <%= SECTION_CLASSES %>">
  <figure class="tw:m-0 tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] tw:overflow-hidden <%= COMIC_CARD %>">
    <%= image_tag("https://files.bikeindex.org/uploads/Tw/5/DCX27h8XkAQ9zOo.jpg", alt: "", loading: "lazy",
      class: "tw:block tw:size-full tw:min-h-65 tw:object-cover") %>

    <div class="tw:p-9">
      <%= helpers.inline_svg_tag("icons/quote.svg", class: "tw:mb-3 tw:size-8 tw:text-purple-500", aria_hidden: true) %>

      <blockquote
        class="
          tw:m-0 tw:border-0 tw:p-0 tw:font-header tw:text-[22px]
          tw:leading-[1.4] tw:font-bold
        "
      >
        <%= TESTIMONIAL %>
      </blockquote>

      <figcaption class="tw:mt-4 tw:text-[15px] <%= MUTED %>">
        <%= translation(".testimonial_attribution_html",
          link: link_to("@GOBuffalo", "https://twitter.com/GOBuffalo", class: "tw:py-2.5 tw:font-semibold twlink")) %>
      </figcaption>
    </div>
  </figure>
</section>

<section class="tw:pb-18 <%= SECTION_CLASSES %>">
  <%= render(SharedBlocks::Marketing::SectionHeading::Component.new(heading: translation(".get_started"), html_class: "tw:mb-5")) %>

  <ul
    class="
      tw:m-0 tw:grid tw:list-none
      tw:grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] tw:gap-4
      tw:p-0
    "
  >
    <% get_started_links.each do |text, path| %>
      <li>
        <%= link_to(path, class: "tw:flex tw:items-center tw:justify-between tw:gap-4 tw:rounded-lg tw:border tw:border-gray-200 tw:px-5 tw:py-4.5 tw:font-semibold tw:text-inherit tw:transition-colors tw:hover:border-blue-600 tw:dark:border-gray-700") do %>
          <%= text %>
          <span aria-hidden="true" class="tw:text-blue-600">→</span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>

<%= render(SharedBlocks::Marketing::CallToActionBanner::Component.new(heading: translation(".join_us"),
  subheading: translation(".create_an_organization_account"))) do %>
  <%= render(UI::ButtonLink::Component.new(href: @sign_up_path, text: translation(".sign_up_for_free"),
    color: :yellow, size: :callout)) %>
<% end %>
