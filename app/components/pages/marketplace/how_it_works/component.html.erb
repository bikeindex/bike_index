<div
  class="
    tw:-mt-(--nav-gap) tw:-mb-18 tw:text-base tw:leading-normal
    tw:text-slate-900 tw:dark:text-gray-100
  "
>
  <section class="tw:bg-linear-160 tw:from-slate-900 tw:to-[#233140] tw:text-white">
    <div class="tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] tw:items-center tw:gap-12 tw:py-16 <%= SECTION_CLASSES %>">
      <div class="tw:flex tw:flex-col tw:items-start tw:gap-5">
        <%= link_to search_marketplace_path, class: "tw:text-sm tw:text-[#c9d3dc] tw:no-underline tw:hover:text-white tw:hover:underline" do %>
          <span aria-hidden="true">←</span>
          <%= translation(".back_to_marketplace") %>
        <% end %>

        <h1
          class="
            tw:font-header tw:text-[clamp(34px,4.5vw,52px)]
            tw:leading-[1.08] tw:font-extrabold tw:tracking-[-.01em]
          "
        >
          <%= translation(".heading") %>
        </h1>

        <p
          class="
            tw:m-0 tw:max-w-[560px] tw:text-lg tw:leading-[1.6]
            tw:text-[#dfe6ec]
          "
        >
          <%= translation(".intro") %>
        </p>

        <div class="tw:flex tw:flex-wrap tw:gap-3">
          <%= call_to_action_buttons %>
        </div>
      </div>

      <%= image_tag "kelsey/illustrations/comic-assets_bike-hero.png", alt: "",
        class: "tw:h-auto tw:w-full tw:max-w-[420px] tw:justify-self-center" %>
    </div>
  </section>

  <section class="tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] tw:gap-12 tw:py-16 <%= SECTION_CLASSES %>">
    <div class="tw:flex tw:flex-col tw:gap-3.5">
      <span
        class="
          tw:text-[13px] tw:font-bold tw:tracking-[.08em] tw:text-purple-500
          tw:uppercase tw:dark:text-purple-300
        "
      >
        <%= translation(".why_a_marketplace") %>
      </span>

      <h2
        class="
          tw:font-header tw:text-[clamp(26px,3.5vw,32px)] tw:leading-[1.15]
          tw:font-extrabold
        "
      >
        <%= translation(".why_heading") %>
      </h2>
    </div>

    <div
      class="
        tw:flex tw:flex-col tw:gap-4 tw:text-[17px] tw:leading-[1.65]
        tw:text-gray-700 tw:dark:text-gray-300
      "
    >
      <p class="tw:m-0"><%= translation(".why_registry") %></p>
      <p class="tw:m-0"><%= translation(".why_we_know") %></p>
    </div>
  </section>

  <section class="tw:bg-gray-50 tw:dark:bg-gray-900">
    <div class="tw:flex tw:flex-col tw:gap-8 tw:py-16 <%= SECTION_CLASSES %>">
      <h2 class="<%= HEADING_CLASSES %>">
        <%= translation(".what_we_check") %>
      </h2>

      <div
        class="
          tw:grid
          tw:grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))]
          tw:gap-5
        "
      >
        <% checks.each do |title, body| %>
          <div class="tw:p-6 <%= CARD_CLASSES %>">
            <span
              class="
                tw:flex tw:size-9 tw:items-center tw:justify-center
                tw:rounded-full tw:bg-blue-100 tw:text-blue-600
                tw:dark:bg-blue-950 tw:dark:text-blue-300
              "
            >
              <%= helpers.inline_svg_tag("icons/check.svg", class: "tw:size-4", aria_hidden: true) %>
            </span>

            <h3 class="tw:text-lg tw:leading-[1.3] tw:font-bold">
              <%= title %>
            </h3>

            <p class="tw:m-0 tw:text-[15px] tw:leading-[1.55] <%= BODY_CLASSES %>">
              <%= body %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,460px),1fr))] tw:gap-14 tw:py-16 <%= SECTION_CLASSES %>">
    <div id="buying" class="tw:flex tw:scroll-mt-4 tw:flex-col tw:gap-6">
      <h2 class="<%= HEADING_CLASSES %>">
        <%= translation(".buying_a_bike") %>
      </h2>

      <ol class="tw:m-0 tw:flex tw:list-none tw:flex-col tw:gap-6 tw:p-0">
        <% buying_steps.each.with_index(1) do |(title, body), number| %>
          <li class="tw:grid tw:grid-cols-[40px_minmax(0,1fr)] tw:gap-4">
            <span
              class="
                tw:flex tw:size-10 tw:items-center tw:justify-center
                tw:rounded-full tw:bg-blue-600 tw:font-header
                tw:font-extrabold tw:text-white
              "
            >
              <%= number %>
            </span>

            <div class="tw:flex tw:flex-col tw:gap-1">
              <h3 class="tw:text-lg tw:font-bold"><%= title %></h3>

              <p class="tw:m-0 tw:leading-[1.55] <%= BODY_CLASSES %>">
                <%= body %>
              </p>
            </div>
          </li>
        <% end %>
      </ol>
    </div>

    <div id="selling" class="tw:flex tw:scroll-mt-4 tw:flex-col tw:gap-6">
      <h2 class="<%= HEADING_CLASSES %>">
        <%= translation(".selling_a_bike") %>
      </h2>

      <ol class="tw:m-0 tw:flex tw:list-none tw:flex-col tw:gap-6 tw:p-0">
        <% selling_steps.each.with_index(1) do |(title, body), number| %>
          <li class="tw:grid tw:grid-cols-[40px_minmax(0,1fr)] tw:gap-4">
            <span
              class="
                tw:flex tw:size-10 tw:items-center tw:justify-center
                tw:rounded-full tw:bg-purple-500 tw:font-header
                tw:font-extrabold tw:text-white
              "
            >
              <%= number %>
            </span>

            <div class="tw:flex tw:flex-col tw:gap-1">
              <h3 class="tw:text-lg tw:font-bold"><%= title %></h3>

              <p class="tw:m-0 tw:leading-[1.55] <%= BODY_CLASSES %>">
                <%= body %>
              </p>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
  </section>

  <section class="tw:bg-gray-50 tw:dark:bg-gray-900">
    <div class="tw:flex tw:flex-col tw:gap-8 tw:py-16 <%= SECTION_CLASSES %>">
      <div class="tw:flex tw:max-w-[760px] tw:flex-col tw:gap-3">
        <h2 class="<%= HEADING_CLASSES %>">
          <%= translation(".across_town_heading") %>
        </h2>

        <p
          class="
            tw:m-0 tw:text-[17px] tw:leading-[1.65] tw:text-gray-700
            tw:dark:text-gray-300
          "
        >
          <%= translation(".across_town_intro") %>
        </p>
      </div>

      <div
        class="
          tw:grid
          tw:grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))]
          tw:gap-5
        "
      >
        <div class="tw:p-7 <%= CARD_CLASSES %>">
          <h3 class="tw:text-xl tw:font-bold">
            <%= translation(".local_pickup") %>
          </h3>

          <p class="tw:m-0 tw:leading-[1.6] <%= BODY_CLASSES %>">
            <%= translation(".local_pickup_body") %>
          </p>
        </div>

        <div class="tw:p-7 <%= CARD_CLASSES %>">
          <h3 class="tw:text-xl tw:font-bold">
            <%= translation(".shipping") %>
          </h3>

          <p class="tw:m-0 tw:leading-[1.6] <%= BODY_CLASSES %>">
            <%= translation(".shipping_body") %>
          </p>
        </div>
      </div>

      <div class="tw:flex tw:max-w-[760px] tw:flex-col tw:gap-2 tw:pt-2">
        <h3 class="tw:text-xl tw:font-bold">
          <%= translation(".trust_not_guarantee") %>
        </h3>

        <p class="tw:m-0 tw:leading-[1.65] tw:text-gray-700 tw:dark:text-gray-300">
          <%= translation(".trust_not_guarantee_body") %>
        </p>
      </div>
    </div>
  </section>

  <section class="tw:py-16 <%= SECTION_CLASSES %>">
    <div
      class="
        tw:grid tw:grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))]
        tw:items-start tw:gap-6 tw:rounded-lg tw:border-3 tw:border-[#111]
        tw:px-8 tw:py-7 tw:shadow-[4px_4px_0_#111] tw:dark:border-gray-300
        tw:dark:shadow-[4px_4px_0_var(--color-gray-300)]
      "
    >
      <div class="tw:flex tw:flex-col tw:gap-2">
        <h2
          class="
            tw:font-header tw:text-3xl tw:font-black tw:tracking-[.03em]
            tw:text-purple-500 tw:uppercase tw:italic
            tw:dark:text-purple-300
          "
        >
          <%= translation(".pro_tip") %>
        </h2>

        <p class="tw:m-0 tw:text-xl tw:leading-[1.3] tw:font-bold">
          <%= translation(".pro_tip_heading") %>
        </p>
      </div>

      <ul
        class="
          tw:m-0 tw:flex tw:list-disc tw:flex-col tw:gap-2 tw:pl-5
          tw:leading-[1.55] tw:text-gray-700 tw:dark:text-gray-300
        "
      >
        <% safety_tips.each do |tip| %>
          <li><%= tip %></li>
        <% end %>
      </ul>
    </div>
  </section>

  <section class="tw:bg-slate-900 tw:text-white">
    <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-6 tw:py-12 <%= SECTION_CLASSES %>">
      <h2 class="tw:font-header tw:text-[26px] tw:font-extrabold">
        <%= translation(".ready_heading") %>
      </h2>

      <div class="tw:flex tw:flex-wrap tw:gap-3">
        <%= call_to_action_buttons %>
      </div>
    </div>
  </section>
</div>
