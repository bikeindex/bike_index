<%= render(UI::Card::Component.new) do %>
  <div data-controller="registration-show--contact-owner">
    <h2
      class="
        tw:text-xs tw:font-bold tw:tracking-wider tw:text-[#715eb2]
        tw:uppercase
      "
    >
      <%= t("bikes.show.know_something_about_this_bike_type", bike_type: @bike.type) %>
    </h2>

    <div class="tw:mt-3">
      <% if sign_in_redirect %>
        <%= render(UI::ButtonLink::Component.new(href: sign_in_redirect, text: t("bikes.show.contact_the_owner"), color: :purple)) %>
      <% else %>
        <%= render(UI::Button::Component.new(
          text: t("bikes.show.contact_the_owner"),
          color: :purple,
          data: {"registration-show--contact-owner-target": "trigger", action: "registration-show--contact-owner#reveal"}
        )) %>
        <div
          data-registration-show--contact-owner-target="form"
          class="tw:hidden"
        >
          <%= form_with(model: stolen_notification, url: stolen_notifications_path, data: {controller: "csrf-refresh"}) do |form| %>
            <%= form.hidden_field :bike_id, value: @bike.id %>

            <%= form.text_area :message,
              required: true,
              rows: 6,
              placeholder: t("bikes.show.where_did_you_see_this_bike", bike_type: @bike.type),
              class: "twinput tw:w-full" %>

            <%= form.text_field :reference_url,
              placeholder: t("bikes.show.link_url"),
              class: "twinput tw:mt-2 tw:w-full" %>

            <div class="tw:mt-3">
              <%= render(UI::Button::Component.new(text: t("bikes.show.send_message"), color: :purple, kind: :submit)) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if owner_phone.present? %>
      <p class="tw:mt-3 tw:text-sm">
        <span class="tw:italic tw:opacity-65">
          <%= t("bikes.show.or_call") %>
        </span>

        <%= phone_link(owner_phone, class: "twlink tw:font-mono") %>
      </p>
    <% end %>
  </div>
<% end %>
