<div
  class="
    tw:mx-auto tw:-mt-9 tw:flex tw:w-full tw:max-w-[1440px] tw:flex-col
    tw:gap-6 tw:px-2 tw:lg:mt-0
  "
>
  <div class="tw:grid tw:gap-6 tw:lg:grid-cols-3">
    <div class="tw:lg:col-span-2">
      <div
        class="
          tw:lg:rounded-sm tw:lg:border tw:lg:border-gray-200 tw:lg:bg-white
          tw:lg:p-4 tw:lg:dark:border-gray-700 tw:lg:dark:bg-gray-800
        "
      >
        <%= render(RegistrationShow::Photos::Component.new(bike: @bike, owner: @owner, title: title, subtitle: subtitle)) %>
      </div>
    </div>

    <div class="tw:flex tw:flex-col tw:gap-4">
      <div>
        <div class="tw:mb-1">
          <%= render(UI::Badge::Component.new(text: audience_label, color: audience_color, size: :sm, solid: true)) %>
        </div>

        <div class="tw:hidden tw:lg:block">
          <h1 class="tw:text-2xl tw:font-bold"><%= title %></h1>

          <p class="tw:opacity-65"><%= subtitle %></p>
        </div>
      </div>

      <div class="tw:flex tw:flex-wrap tw:items-center tw:gap-2">
        <% if @bike.status_with_owner? && !@bike.user_hidden %>
          <%= render(UI::Badge::Component.new(text: translation(".registered_protected"), color: :notice, icon: "registration_show/shield")) %>
        <% end %>

        <%= render(UI::Badge::Component.new(text: status_label, color: status_color, indicator: true)) %>
      </div>

      <div class="tw:mt-auto tw:flex tw:flex-col tw:gap-2">
        <% if @owner %>
          <% if show_marketplace_button? %>
            <%= render(UI::ButtonLink::Component.new(href: edit_bike_path(@bike, edit_template: "marketplace"), text: translation(".sell_on_marketplace"), color: :purple, size: :lg, class: "tw:justify-center")) %>
          <% end %>
          <% if @bike.status_with_owner? %>
            <div class="tw:grid tw:grid-cols-2 tw:gap-2">
              <%= render(RegistrationShow::Share::Component.new(text: translation(".share_my_page"), url: bike_url(@bike))) %>

              <%= render(UI::ButtonLink::Component.new(href: edit_bike_path(@bike, edit_template: "report_stolen"), text: translation(".mark_stolen"), color: :danger_outline, class: "tw:justify-center")) %>
            </div>
          <% else %>
            <%= render(RegistrationShow::Share::Component.new(text: translation(".share_my_page"), url: bike_url(@bike))) %>
          <% end %>
        <% else %>
          <%= render(RegistrationShow::Share::Component.new(text: translation(".share"), url: bike_url(@bike))) %>
        <% end %>
      </div>
    </div>
  </div>

  <dl
    class="
      tw:grid tw:grid-cols-2 tw:gap-px tw:overflow-hidden tw:rounded-lg
      tw:border tw:border-gray-200 tw:bg-gray-200 tw:sm:grid-cols-5
      tw:dark:border-gray-700 tw:dark:bg-gray-700
    "
  >
    <div class="tw:bg-white tw:p-4 tw:dark:bg-gray-950">
      <dt class="tw:text-xs tw:opacity-65"><%= translation(".frame") %></dt>

      <dd class="tw:mt-0.5 tw:font-semibold">
        <%= frame_spec.presence || "—" %>
      </dd>
    </div>

    <div class="tw:bg-white tw:p-4 tw:dark:bg-gray-950">
      <dt class="tw:text-xs tw:opacity-65"><%= translation(".activity") %></dt>

      <dd class="tw:mt-0.5 tw:font-semibold">
        <%= activity_name.presence || "—" %>
      </dd>
    </div>

    <div class="tw:bg-white tw:p-4 tw:dark:bg-gray-950">
      <dt class="tw:text-xs tw:opacity-65"><%= translation(".color") %></dt>

      <dd class="tw:mt-0.5 tw:flex tw:items-center tw:gap-1.5 tw:font-semibold">
        <% if primary_color_hex.present? %>
          <span
            class="
              tw:inline-block tw:h-3 tw:w-3 tw:rounded-xs tw:border
              tw:border-gray-300
            "
            style="background-color: <%= primary_color_hex %>"
          ></span>
        <% end %>

        <%= primary_color_name.presence || "—" %>
      </dd>
    </div>

    <div class="tw:bg-white tw:p-4 tw:dark:bg-gray-950">
      <dt class="tw:text-xs tw:opacity-65"><%= translation(".year") %></dt>
      <dd class="tw:mt-0.5 tw:font-semibold"><%= @bike.year || "—" %></dd>
    </div>

    <div class="tw:bg-white tw:p-4 tw:dark:bg-gray-950">
      <dt class="tw:text-xs tw:opacity-65"><%= translation(".status") %></dt>

      <dd class="tw:mt-0.5 tw:font-semibold <%= status_text_class %>">
        <%= status_label %>
      </dd>
    </div>
  </dl>

  <%= render(RegistrationShow::StolenDetails::Component.new(bike: @bike)) %>

  <% if @bike.description.present? %>
    <%= render(UI::Card::Component.new) do %>
      <h2 class="tw:text-xs tw:font-bold tw:uppercase tw:opacity-65">
        <%= translation(".about_this_bike") %>
      </h2>

      <p class="tw:mt-2"><%= @bike.description %></p>

      <p class="tw:mt-2 tw:text-xs tw:opacity-65">
        <%= translation(".registered") %>
        <%= render(UI::Time::Component.new(time: @bike.created_at)) %> ·
        <%= @bike.short_id %>
      </p>
    <% end %>
  <% end %>

  <%= render(RegistrationShow::ComponentList::Component.new(bike: @bike)) %>
</div>
