<div class="doorkeeper-container">
  <% if current_user&.superuser? && @application&.owner.present? %>
    Application by <strong><%= @application.owner.display_name %></strong>
  <% end %>

  <% if action_name != "index" %>
    <%= link_to "Your applications", oauth_applications_url, class: "pull-right" %>
  <% end %>

  <%= yield %>
</div>
