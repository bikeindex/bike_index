<% if flash[:notice].present? && @pagy.page == 1 %>
  <div class="tw:mx-auto tw:max-w-7xl tw:px-4">
    <%= render(UI::Alerts::Base::Component.new(text: flash[:notice], kind: :warning, dismissable: true)) %>
  </div>
<% end %>

<div class="tw:mx-auto tw:mt-8 tw:mb-6 tw:max-w-7xl tw:px-4 tw:lg:mt-12">
  <% component_class = SearchResults::Container::Component.component_class_for_result_view(@result_view) %>

  <%= render(SearchResults::Container::Component.new(result_view: @result_view, search_kind: @search_kind, no_results: t("search.registrations.results.no_matched", search_obj_name: @search_obj_name))) do %>
    <% @bikes.each do |bike| %>
      <% cache(["search_results", @search_kind, @result_view, bike]) do %>
        <%= render(component_class.new(bike:, search_kind: @search_kind)) %>
      <% end %>
    <% end %>
  <% end %>
</div>

<% if @pagy.pages > 1 %>
  <div data-controller="search--pagination-fallback">
    <%# The links are the non-JS path - with JS the next page lazy-loads on scroll instead %>
    <div data-search--pagination-fallback-target="links">
      <%= render(UI::Pagination::Component.new(pagy: @pagy, page_params: params)) %>
    </div>

    <% if @pagy.next %>
      <%= turbo_frame_tag "page_#{@pagy.next}", src: search_marketplace_path(page: @pagy.next, **params.except(:page, :controller, :action).permit!), loading: :lazy do %>
        <%# Ships hidden so a non-JS user isn't left watching a fetch that never happens %>
        <div
          hidden
          data-search--pagination-fallback-target="spinner"
          class="tw:py-4 tw:text-center"
        >
          <%= render UI::LoadingSpinner::Component.new(text: "Loading more...") %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
