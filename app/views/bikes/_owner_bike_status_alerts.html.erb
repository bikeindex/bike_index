<% if @bike.impounded? && @bike.current_impound_record.organized? %>
  <% impound_record = @bike.current_impound_record %>
  <% organization = impound_record.organization.name %>
  <% address = impound_record.parking_notification&.formatted_address_string %>
  <% time = capture do %>
    <em><%= render(UI::Time::Component.new(time: impound_record.impounded_at)) %></em>
    <em class="small localizeTimezone"></em>
  <% end %>

  <%= render(UI::Alerts::Base::Component.new(kind: :error, header: t(".currently_impounded", bike_type: @bike.type), margin_classes: "tw:my-4")) do %>
    <% if address.present? %>
      <%= t(".impounded_by_from_html", time:, organization:, address:) %>
    <% else %>
      <%= t(".impounded_by_html", time:, organization:) %>
    <% end %>
  <% end %>
<% end %>

<% if @bike.parking_notifications.active.any? %>
  <% parking_notifications = @bike.parking_notifications.active.reorder(created_at: :desc) %>
  <%= render(UI::Alerts::Base::Component.new(kind: :warning, header: t(".current_notifications", count: parking_notifications.count, bike_type: @bike.type), margin_classes: "tw:my-4")) do %>
    <table
      class="
        table table-striped table-bordered table-sm without-exterior-border
        text-dark
      "
      style="color: #666;"
    >
      <thead class="small-header hidden-md-down">
        <tr>
          <th>
            <%= t(".created") %>
            <small class="localizeTimezone"></small>
          </th>

          <th><%= t(".address") %></th>
          <th><%= t(".kind") %></th>
          <th><%= t(".by") %></th>
          <th><small><%= t(".notification") %></small></th>
        </tr>
      </thead>

      <tbody>
        <% parking_notifications.each do |parking_notification| %>
          <tr>
            <td>
              <% if current_user.superuser? || @bike.authorized_by_organization?(u: current_user, org: parking_notification.organization) %>
                <%= link_to l(parking_notification.created_at, format: :convert_time), organization_parking_notification_path(parking_notification.id, organization_id: parking_notification.organization_id), class: "localizeTime preciseTime" %>
              <% else %>
                <span class="localizeTime preciseTime">
                  <%= l(parking_notification.created_at, format: :convert_time) %>
                </span>
              <% end %>

              <span class="extended-col-info small">
                <%= t(".kind_by_organization_html", kind: parking_notification.kind_humanized, organization: parking_notification.organization.short_name) %>

                <small class="less-strong">(<%= parking_notification.user&.display_name %>)</small>
              </span>

              <% if parking_notification.repeat_number > 0 %>
                <strong class="extended-col-info">
                  <%= t(".notification_number", number: parking_notification.repeat_number) %>
                </strong>
              <% end %>
            </td>

            <td class="hidden-sm-cells">
              <small>
                <%= parking_notification.formatted_address_string %>
              </small>
            </td>

            <td class="hidden-sm-cells">
              <em><%= parking_notification.kind_humanized %></em>
            </td>

            <td class="hidden-sm-cells">
              <strong>
                <%= parking_notification.organization.short_name %>
              </strong>

              <small class="less-strong">
                (<%= parking_notification.user&.display_name %>)
              </small>
            </td>

            <td class="small hidden-sm-cells">
              <% if parking_notification.repeat_record? %>
                <%= parking_notification.notification_number %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% current_parking_notification = @bike.current_parking_notification %>

    <% if current_parking_notification.present? %>
      <h3 class="uncap text-center mt-4 mb-2">
        <strong>
          <% if @bike.unregistered_parking_notification? %>
            <%= t(".was_this_retrieved", bike_type: @bike.type) %>
          <% else %>
            <%= t(".have_you_retrieved", bike_type: @bike.type) %>
          <% end %>
        </strong>
      </h3>
      <p class="text-center">
        <% unless @bike.unregistered_parking_notification? %>
          <em><%= t(".let_organization_know", organization: current_parking_notification.organization&.short_name) %></em>
        <% end %>

        <%= render(UI::ButtonLink::Component.new(text: t(".mark_retrieved"), href: bike_path(@bike.to_param, user_recovery: true, parking_notification_retrieved: current_parking_notification.retrieval_link_token), color: :primary, size: :sm)) %>
      </p>
    <% end %>
  <% end %>
<% end %>
