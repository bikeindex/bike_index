- first_form_well ||= false

- if theft_alerts.present?
  - show_creator = theft_alerts.pluck(:user_id).uniq != [current_user.id]
  .form-wrap{ class: first_form_well ? "" : "secondary-form-wrap" }
    .form-well-form-header-always-visible
      %h3
        = t(".existing_theft_alerts")
    .row
      .col-sm-12
        = render(UI::Table::Base::Component.new(records: theft_alerts)) do |table|
          - table.column(label: t(".created")) do |theft_alert|
            = render(UI::Time::Component.new(time: theft_alert.created_at))
          - table.column(label: t(".plan")) do |theft_alert|
            = theft_alert.theft_alert_plan.name
          - table.column(label: t(".status")) do |theft_alert|
            = theft_alert.status
          - table.column(label: t(".start")) do |theft_alert|
            = render(UI::Time::Component.new(time: theft_alert.start_at))
          - table.column(label: t(".end")) do |theft_alert|
            = render(UI::Time::Component.new(time: theft_alert.end_at))
          - if show_creator
            - table.column(label: t(".creator"), header_classes: "tw:text-xs") do |theft_alert|
              %small= theft_alert.user&.display_name
