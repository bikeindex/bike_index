<div class="sign-in-up <%= sign_in_partner.present? ? "with-partner" : "not-partner" %>">
  <% unless sign_in_partner.present? %>
    <div class="sign-in-up-header container">
      <div class="row">
        <h1 class="tw:pl-4 tw:md:pl-0">
          <%= t("sessions.new.get_on_bike_index") %>
        </h1>
      </div>
    </div>
  <% end %>

  <div class="container">
    <div class="sign-in-up-wrap">
      <div class="row">
        <div class="main-form">
          <h3 class="sign-in-up-main-form-header">
            <%= t("sessions.new.log_in") %>
          </h3>

          <% email_display = tag.p(tag.strong(@email), class: "sign-in-up-identity tw:mb-4!") %>
          <% different_email_link = link_to t(".different_email"), new_session_path(email: @email, partner: sign_in_partner, return_to: params[:return_to]) %>

          <% if @login_method == "magic_link" %>
            <%= email_display %>
            <p><%= t("sessions.new.org_uses_passwordless") %></p>
            <p class="tw:mb-4! tw:text-sm! tw:text-gray-500!">
              <%= t("sessions.new.passwordless_help") %>
            </p>
            <%= form_tag create_magic_link_session_path, method: "post" do %>
              <%= hidden_field_tag :email, @email %>
              <%= hidden_field_tag :remember_me, @remember_me %>
              <%= submit_tag t("sessions.new.email_me_the_link"), class: "btn btn-primary btn-lg tw:mx-0!" %>
            <% end %>
            <p class="forgot-password-link"><%= different_email_link %></p>
          <% else %>
            <%#
              Separate form (button_to renders its own <form>) so it can't nest in the
              password form; sits above the password input as an alternative sign-in.
            %>
            <%= button_to t("sessions.new.sign_in_without_password"), create_magic_link_session_path, params: {email: @email, remember_me: @remember_me}, form: {class: "tw:mb-0!"}, class: "twlink tw:bg-transparent! tw:border-0! tw:p-0! tw:font-bold! tw:cursor-pointer!" %>
            <p class="tw:mt-1! tw:mb-8! tw:text-sm! tw:text-gray-500!">
              <%= t("sessions.new.passwordless_help") %>
            </p>
            <%= email_display %>
            <%= form_for :session, url: session_url(params.permit(:return_to)) do |f| %>
              <% if sign_in_partner %>
                <%= hidden_field_tag :partner, sign_in_partner %>
              <% end %>

              <%#
                The email shows as text above; this hidden field keeps password managers
                associating the username with the password for autofill.
              %>
              <%= f.hidden_field :email, value: @email, autocomplete: "username" %>
              <%= f.hidden_field :remember_me, value: @remember_me %>

              <div class="form-group">
                <%= f.label :password, class: "sr-only" %>
                <%= f.password_field :password, placeholder: t("sessions.new.password"), autocomplete: "current-password", autofocus: true, class: "form-control" %>
              </div>

              <%= f.submit t("sessions.new.log_in"), class: "btn btn-primary btn-lg tw:mx-0!" %>
            <% end %>
            <p class="forgot-password-link">
              <%= link_to t("sessions.new.forgot_your_password"), request_password_reset_form_users_path %>
            </p>
            <p class="forgot-password-link tw:mt-2!">
              <%= different_email_link %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
