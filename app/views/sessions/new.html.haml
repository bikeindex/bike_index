.sign-in-up{ class: (sign_in_partner.present? ? "with-partner" : "not-partner") }
  - unless sign_in_partner.present?
    .sign-in-up-header.container
      .row
        %h1{ class: "tw:pl-4 tw:md:pl-0" }= t(".get_on_bike_index")
  .container
    .sign-in-up-wrap
      .row
        .main-form
          - company = session[:company] if sign_in_partner.present? && session[:company].present?
          %h3.sign-in-up-main-form-header{ class: (company.present? ? "mb-1" : "") }
            - if company.present?
              - image_path = company.match?(/metro/i) ? "bikehub/metro_logo.png" : "bikehub/bikehub_logo_nosubtitle.png"
              = image_tag image_path, alt: "", class: "company-logo"
              = t(".log_in")
              %span.company-text.uncap
                for
                %em= company
            - else
              = t(".log_in_or_sign_up")

          = form_for :session, url: identify_session_path(params.permit(:return_to)) do |f|
            - if sign_in_partner
              = hidden_field_tag :partner, sign_in_partner

            .form-group
              = f.label :email, class: 'sr-only'
              = render(UI::Forms::Email::Component.new(form_builder: f, required: true,
              html_options: {value: @email, placeholder: t(".email"), autocomplete: "username", autofocus: true}))

            .checkbox{ class: "tw:mt-4!" }
              %label
                = f.check_box :remember_me, value: '1', checked: true
                = t(".keep_me_logged_in")

            = f.submit t(".continue"), class: 'btn btn-primary btn-lg tw:mx-0! tw:mt-4!'
