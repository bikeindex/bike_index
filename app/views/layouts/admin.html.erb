<!DOCTYPE html>

<html>
  <head>
    <%= render(SharedBlocks::HeaderTags::Component.new(**header_tags_component_options)) %>
    <%= csrf_meta_tags %>

    <link
      href="https://fonts.googleapis.com/css?family=Open+Sans:400,400italic,300italic,700"
      rel="stylesheet"
      type="text/css"
    >

    <link
      href="https://fonts.googleapis.com/css?family=Montserrat:400,700"
      rel="stylesheet"
      type="text/css"
    >

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= hw_combobox_style_tag %>
    <%= javascript_importmap_tags %>

    <%# = hotwire_livereload_tags if Rails.env.development? %>
  </head>

  <%= body_tag(html_class: class_names(dark: current_user&.dark_mode_dark?), data: {turbo: true}) do %>
    <% if current_user&.dark_mode_system? %>
      <%# Before anything paints, so the page doesn't flash light. A block, because Turbo re-runs it on each visit %>
      <script>
        {
          const darkQuery = matchMedia("(prefers-color-scheme: dark)")
          const setDark = () => document.body.classList.toggle("dark", darkQuery.matches)
          setDark()
          darkQuery.addEventListener("change", setDark)
        }
      </script>
    <% end %>

    <%= render(SharedBlocks::ReviewAppBanner::Component.from_env(current_user:, return_to: request.fullpath)) %>

    <%= render(Pages::Admin::Navbar::Component.new(current_user:, user_root_url:, search_filtered: admin_search_filtered?)) %>

    <%= render(UI::Alerts::FlashMessage::Component.new(flash:)) %>

    <section id="admin-content" class="twgutter tw:mt-6 tw:pb-16">
      <%= yield %>
    </section>
  <% end %>
</html>
