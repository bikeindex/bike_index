<!DOCTYPE html>

<html>
  <head>
    <%= render(PageBlock::HeaderTags::Component.new(**header_tags_component_options)) %>
    <%= csrf_meta_tags %>

    <link
      href="https://fonts.googleapis.com/css?family=Open+Sans:400,400italic,300italic,700"
      rel="stylesheet"
      type="text/css"
    >

    <link
      href="https://fonts.googleapis.com/css?family=Montserrat:400,700"
      rel="stylesheet"
      type="text/css"
    >

    <script src="/vendored_assets/application_standalone.js"></script>

    <%= stylesheet_link_tag "tailwind", "admin", "data-turbo-track": "reload" %>
    <%= hw_combobox_style_tag %>
    <%= javascript_importmap_tags %>

    <%# = hotwire_livereload_tags if Rails.env.development? %>
    <%# assets are vendored, lazy solution %>
    <style>
      .for-sale-color {color: #2ecc71;}
      .stolen-color, .impounded-color {color: #e74c3c;}
      .found-color {color: oklch(59.1% 0.293 322.896);}
      .unregistered-color { color: #f0ad4e; }
    </style>
  </head>

  <%# manually override body_class in a few situations :/ %>
  <% admin_body_class = "welcome-page" if current_page?(root_path) and controller_name == "welcome" %>
  <% admin_body_class = "vendor-signup-page" if current_page?(:vendor_signup) %>
  <% admin_body_class = "news-page" if controller_name == "news" %>

  <%= body_tag(html_class: admin_body_class) do %>
    <%= render(PageBlock::ReviewAppBanner::Component.from_env(current_user:, return_to: request.fullpath)) %>

    <%= render(Admin::Navbar::Component.new(current_user:)) %>

    <%= render(UI::Alerts::FlashMessage::Component.new(flash:)) %>

    <section id="admin-content" class="pb-4 mb-4">
      <div class="container-fluid mt-4 pb-4"><%= yield %></div>
    </section>
  <% end %>
</html>
