<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <%= render(PageBlock::HeaderTags::Component.new(**header_tags_component_options)) %>

    <%# The frame's src is crawlable from the embedding page, and it self-canonicalizes %>
    <%= tag.meta name: "robots", content: "noindex" %>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= hw_combobox_style_tag %>

    <link
      href="https://fonts.googleapis.com/css?family=Open+Sans:400,400italic,300italic,700"
      rel="stylesheet"
      type="text/css"
    >

    <%= javascript_importmap_tags %>
    <%= yield :header %>
  </head>

  <%# The embedding page supplies the background, and its analytics count the pageview %>
  <body class="tw:bg-transparent"><%= yield %></body>
</html>
