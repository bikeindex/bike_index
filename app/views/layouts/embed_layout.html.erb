<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <%= render(SharedBlocks::HeaderTags::Component.new(**header_tags_component_options)) %>
    <%= stylesheet_link_tag "tailwind", "embed_styles", media: "all" %>
    <%= javascript_include_tag "embed" %>
    <%= javascript_importmap_tags %>
    <%= csrf_meta_tags %>
  </head>

  <body id="bi_embed">
    <%= render(UI::Alerts::FlashMessage::Component.new(flash:)) %>

    <% if @b_param && @b_param.bike_errors.present? %>
      <div id="alert-block">
        <%= render(UI::Alerts::Base::Component.new(kind: :error, dismissable: true, header: "#{t(".please_fix_the_following")} #{pluralize(@b_param.bike_errors.count, t(".error"))}")) do %>
          <ul class="tw:list-inside tw:list-disc">
            <% @b_param.bike_errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>

    <%= yield %>

    <%= render "/shared/analytics" %>
  </body>
</html>
