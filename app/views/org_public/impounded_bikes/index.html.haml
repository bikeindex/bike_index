-# TODO: add translations

.container.public-impounded-bikes
  %h1.cleafix.impounded-bikes-header{ class: (OrgServices::Displayer.avatar?(current_organization) ? "with-avatar" : "") }
    - if OrgServices::Displayer.avatar?(current_organization)
      = image_tag current_organization.avatar.url(:large)
    %strong.uncap= current_organization.name
    Impounded bikes

  %div{class: "tw:flex tw:justify-end"}
    = render UI::PeriodSelect::Component.new(period: @period, start_time: @start_time, end_time: @end_time, sortable_search_params:, prepend_text: "Impounded during:")

  .mt-4
    = render partial: "/shared/bike_search_form", locals: {include_hidden_search_fields: true, search_path: organization_impounded_bikes_path(organization_id: current_organization.to_param)}

  .mt-4.mb-4
    = pluralize(number_with_delimiter(@pagy.count), "matching impound record")
    %em
      = render(UI::TimeRange::Component.new(time_range: @time_range, period: @period))

  - skip_location ||= !current_organization&.enabled?("impound_bikes_locations")
  = render(UI::Table::Base::Component.new(records: @impound_records, render_sortable: true, sort_state:)) do |table|
    - table.column(sortable: "display_id", label: "Impound&nbsp;ID".html_safe, header_classes: "tw:text-xs") do |impound_record|
      = impound_record.display_id
    - table.column(sortable: "created_at", label: "Impounded&nbsp;at".html_safe) do |impound_record|
      = render(UI::Time::Component.new(time: impound_record.created_at, format: :localize_time_precise))
    - table.column(label: "Bike") do |impound_record|
      - if impound_record.bike.present?
        - bike = impound_record.bike
        %a.twlink{ href: bike_path(bike.to_param) }
          = bike.frame_colors.to_sentence
          %strong
            = bike.mnfg_name
          - if bike.frame_model.present?
            %em
              = bike.frame_model_truncated
          - unless bike.cycle_type == "bike"
            %small= bike.type
    - unless skip_location
      - table.column(sortable: "location_id") do |impound_record|
        %small
          = impound_record.location&.name
    - table.column(label: "Impounded from") do |impound_record|
      = impound_record.formatted_address_string(visible_attribute: :street)

  .pt-4.pb-4
    = render(UI::Pagination::Component.new(pagy: @pagy, page_params: params, size: :lg))
