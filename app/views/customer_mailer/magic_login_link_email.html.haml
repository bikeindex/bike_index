%h4{ style: 'margin-bottom: 2em;' }
  = t(".html.click_the_button")

- tokenized_url = @email_preview ? @email_preview_tokenized_url : @url
= render(Emails::Partials::TokenLink::Component.new(href: tokenized_url, text: t(".html.sign_in")))

%p
  %em.less-strong
    = t(".html.only_valid_once")

%hr{ style: 'margin-top: 40px;' }

%p.center-text.less-strong
  = t(".html.if_you_did_not_request")
