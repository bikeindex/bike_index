<% filters = {
  search_bucket: [@searched_bucket, "All buckets", PosRegistrationMatch.buckets.keys.index_with { PosRegistrationMatch.bucket_display(it) }],
  search_reason: [@searched_reason, "All review reasons", PosRegistrationMatch::REVIEW_REASONS],
  search_status: [@searched_status, "All statuses", PosRegistrationMatch.statuses.keys.index_with(&:humanize)]
} %>

<% nav_header_list_items = capture do %>
  <% filters.each do |param, (searched, all_label, options)| %>
    <li>
      <%= render(UI::Dropdown::Component.new(name: searched.present? ? options[searched] : all_label, button_size: :sm, active: searched.present?)) do |dropdown|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: all_label, path: url_for(sortable_search_params.merge(param => nil)), match_params: {param => nil}) }
        dropdown.with_entry_divider
        options.each do |value, label|
          dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: label, path: url_for(sortable_search_params.merge(param => value)), match_params: {param => value}) }
        end
      end %>
    </li>
  <% end %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: "POS Registration Matches",
  nav_header_list_items:,
  table_view: render(Pages::Admin::PosRegistrationMatches::Table::Component.new(collection: @collection, sort_state:, render_sortable: true)),
  chart_collection: @render_chart && matching_pos_registration_matches
)) %>
