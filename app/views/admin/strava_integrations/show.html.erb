<%= render(Pages::Admin::Headers::Nav::Component.new(title: "Strava Integration")) %>

<div class="twwiderow tw:mt-6 tw:items-start">
  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "ID", dev_only: true, if: display_dev_info?) do %>
      <%= render(UI::Code::Inline::Component.new(text: @strava_integration.id)) %>

      <small class="less-strong tw:ml-2">
        Strava ID:
        <%= render(UI::Code::Inline::Component.new(text: @strava_integration.strava_id, small: true)) %>
      </small>
    <% end %>

    <% list.with_row(label: "User", value: render(Atoms::Admin::TableCells::User::Component.new(user: @strava_integration.user, user_id: @strava_integration.user_id))) %>

    <% list.with_row(label: "Strava ID", value: number_display(@strava_integration.strava_id)) %>

    <% list.with_row(label: "Created", value: render(UI::Time::Component.new(time: @strava_integration.created_at, format: :localize_time_precise))) %>

    <% list.with_row(label: "Updated", class: "tw:text-sm", value: render(UI::Time::Component.new(time: @strava_integration.updated_at, format: :localize_time_precise))) %>

    <% list.with_row(label: "Last Page 1 request", value: render(UI::Time::Component.new(time: @strava_integration.last_updated_activities_at, format: :localize_time_precise))) %>

    <% list.with_row(label: "Deleted", class: "tw:text-sm", if: @strava_integration.deleted_at.present?) do %>
      <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">
        <%= render(UI::Time::Component.new(time: @strava_integration.deleted_at, format: :localize_time_precise)) %>
      </span>
    <% end %>
  <% end %>

  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "Status") do %>
      <%# duplicated in strava_integrations/table %>
      <% if @strava_integration.synced? %>
        <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:success] %>"><%= @strava_integration.status %></span>
      <% elsif @strava_integration.error? %>
        <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>"><%= @strava_integration.status %></span>
      <% else %>
        <small><%= @strava_integration.status %></small>
      <% end %>
    <% end %>

    <% list.with_row(label: "Activities") do %>
      <%= link_to admin_strava_activities_path(search_strava_integration_id: @strava_integration.id), class: "twlink" do %>
        <%= number_display(@strava_integration.activities_downloaded_count) %>
      <% end %>

      <% if @strava_integration.athlete_activity_count %>
        /
        <small title="Strava Athlete Activity count"><%= number_display(@strava_integration.athlete_activity_count) %></small>
      <% end %>
    <% end %>

    <% list.with_row(label: "Sync Progress") do %>
      <%= @strava_integration.sync_progress_percent %>%
      <span class="less-strong tw:ml-2"><%= number_display(@strava_integration.strava_activities.enriched.count) %> / <%= number_display(@strava_integration.activities_downloaded_count) %> enriched</span>
    <% end %>

    <% list.with_row(label: "Most recent proxy") do %>
      <% most_recent_proxy_at = StravaRequest.most_recent_proxy_at(@strava_integration.id) %>

      <% if most_recent_proxy_at.present? %>
        <%= render(UI::Time::Component.new(time: most_recent_proxy_at, format: :localize_time_precise)) %>
      <% else %>
        <small class="less-strong">no proxy requests</small>
      <% end %>

      <small class="tw:ml-1">
        priority multiplier:
        <%= render(UI::Code::Inline::Component.new(text: StravaJobs::ScheduledRequestPriorityUpdator.priority_multiplier(@strava_integration.id), small: true)) %>
      </small>
    <% end %>

    <% list.with_row(label: "Permissions") do %>
      <%= render(UI::Code::Inline::Component.new(text: @strava_integration.strava_permissions)) %>

      <% if @strava_integration.permissions_less? %>
        <%= render UI::Badge::Component.new(text: "less than default", color: :error, size: :sm) %>
      <% elsif @strava_integration.permissions_strava_search_default? %>
        <%= render UI::Badge::Component.new(text: "Strava Search default", color: :success, size: :sm) %>
      <% elsif @strava_integration.permissions_more? %>
        <%= render UI::Badge::Component.new(text: "more than default", color: :notice, size: :sm) %>
      <% end %>
    <% end %>

    <% list.with_row(label: "Requests") do %>
      <%= link_to admin_strava_requests_path(search_strava_integration_id: @strava_integration.id), class: "twlink" do %>
        <% strava_requests_count = @strava_integration.strava_requests.count %>
        <%= number_display(strava_requests_count) %>
        <%= "Strava Requests".pluralize(strava_requests_count) %>
      <% end %>

      <small class="tw:ml-2">
        Last successful request:
        <%= render(UI::Time::Component.new(time: @strava_integration.strava_requests.maximum(:requested_at), format: :localize_time_precise)) %>
      </small>
    <% end %>
  <% end %>
</div>

<% unknown_gear = @strava_integration.unknown_gear_ids %>

<% if @strava_integration.strava_gears.any? || unknown_gear %>
  <div class="tw:mt-6">
    <% gear_title = capture do %>
      <%= link_to admin_strava_gears_path(search_strava_integration_id: @strava_integration.id), class: "twlink" do %>
        Strava Gear
        (<%= number_display(@strava_integration.strava_gears.count) %>)
      <% end %>
    <% end %>

    <%= render(UI::Header::Component.new(tag: :h2)) do %>
      <%= gear_title %>

      <% if unknown_gear.present? %>
        <small class="tw:mt-2 tw:mb-4 tw:block">
          <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">Unknown gear IDs:</span>
          <%= unknown_gear.join(", ") %>
        </small>
      <% end %>
    <% end %>

    <% {bike: "Bikes", shoe: "Shoes"}.each do |gear_type, gear_type_label| %>
      <% gears = @strava_integration.strava_gears.select { |g| g.gear_type == gear_type.to_s }.sort_by { |g| g.strava_gear_display_name.downcase } %>
      <% next if gears.empty? %>

      <%= render(UI::Header::Component.new(text: gear_type_label, tag: :h3)) %>

      <%= render partial: "admin/strava_gears/table", locals: {collection: gears, skip_strava_integration: true} %>
    <% end %>
  </div>
<% end %>
