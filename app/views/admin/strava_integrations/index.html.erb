<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(name: (@search_permissions.blank?) ? "All Strava permissions" : @search_permissions.humanize, button_size: :sm,
          active: @search_permissions.present?)) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All permissions", path: url_for(sortable_search_params.merge(search_permissions: nil)), match: :query, query: {search_permissions: nil}) } %>
      <% dropdown.with_entry_divider %>

      <% permission_levels.each do |permissions_level| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{permissions_level.humanize} permissions", path: url_for(sortable_search_params.merge(search_permissions: permissions_level)), match: :query, query: {search_permissions: permissions_level}) } %>
      <% end %>
    <% end %>
  </li>
<% end %>

<% table_view = render(partial: "table", locals: {collection: @collection, render_sortable: true, render_deleted: @render_deleted}) %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  nav_header_list_items:, chart_collection: @render_chart && matching_strava_integrations, table_view:,
)) %>
