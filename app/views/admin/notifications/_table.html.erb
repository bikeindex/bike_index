<%# locals: (notifications:, render_sortable: false, skip_user: false, skip_bike: false, skip_sender: false, skip_error: false, show_message_preview: false) %>

<% unless display_dev_info? %>
  <style>.only-dev-visible {display: none !important;}</style>
<% end %>

<div
  data-controller="update-cached-sortable-links"
  data-update-cached-sortable-links-base-url-value="<%= url_for(sortable_search_params) %>"
>
  <%= render(UI::Table::Component.new(records: notifications, render_sortable:, sort_state:, cache_key: cache_fragment_name(["admin_notifications_table", render_sortable, skip_user, skip_bike, skip_sender, skip_error, show_message_preview]))) do |table| %>
    <% table.column(sortable: "created_at", lower_right: ->(notification) { content_tag(:code, notification.id, class: "only-dev-visible") }) do |notification| %>
      <%= render UI::Time::Component.new(time: notification.created_at) %>
    <% end %>

    <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |notification| %>
      <%= render UI::Time::Component.new(time: notification.updated_at) %>
    <% end %>

    <% table.column(label: "Object", header_classes: "tw:font-normal") do |notification| %>
      <% if notification.notifiable.present? %>
        <%= link_to helpers.admin_path_for_object(notification.notifiable), class: "twlink" do %>
          <%= notification.notifiable.class.to_s.titleize %>
          <code class="small">#<%= notification.notifiable_id %></code>
        <% end %>
        <%# TODO: include more previews %>
        <% if show_message_preview && notification.notifiable.is_a?(MarketplaceMessage) %>
          <% notification_text = notification.notifiable.body %>
          <small class="d-block" title="<%= notification_text %>">
            <%= notification_text.truncate(100) %>
          </small>
        <% end %>
      <% end %>
    <% end %>

    <% unless skip_user %>
      <% table.column(sortable: "user_id") do |notification| %>
        <% if notification.user_id.present? %>
          <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: notification.user, email: notification.message_channel_target || notification.user&.email, render_search: render_sortable) %>
        <% else %>
          <%= notification.message_channel_target %>
          <small class="less-strong">no user</small>
        <% end %>
      <% end %>
    <% end %>

    <% unless skip_bike %>
      <% table.column(sortable: "bike_id") do |notification| %>
        <% if notification.bike_id.present? %>
          <%= render Pages::Admin::Bikes::Cell::Component.new(sort_state:, bike: notification.bike, bike_id: notification.bike_id, bike_link_path: admin_bike_path(notification.bike_id, active_tab: "messages"), render_search: true) %>
        <% end %>
      <% end %>
    <% end %>

    <% table.column(sortable: "kind") do |notification| %>
      <%= notification.kind_humanized&.titleize %>
    <% end %>

    <% table.column(label: "Method", header_classes: "tw:font-normal", classes: "tw:text-xs") do |notification| %>
      <span class="less-strong"><%= notification.message_channel %></span>
    <% end %>

    <% table.column(label: "Delivered?", header_classes: "tw:font-normal", classes: "tw:text-center") do |notification| %>
      <%= helpers.notification_delivery_display(notification.delivery_status) %>
    <% end %>

    <% unless skip_sender %>
      <% table.column(label: "Sender", header_classes: "tw:font-normal") do |notification| %>
        <% sender_display_name = notification.sender_display_name %>

        <% if notification.sender.is_a?(User) %>
          <%= link_to sender_display_name, admin_user_path(notification.sender&.id), class: "twlink" %>
        <% else %>
          <span class="<%= "less-strong" if sender_display_name == "auto" %>"><%= sender_display_name %></span>
        <% end %>
      <% end %>
    <% end %>

    <% unless skip_error %>
      <% table.column(label: "Delivery Errors", header_classes: "tw:font-normal") do |notification| %>
        <% if notification.delivery_error_spam? %>
          An Email sent to this address was marked as spam
        <% elsif notification.delivery_error_invalid? %>
          Invalid email address
        <% else %>
          <%= notification.delivery_error %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
