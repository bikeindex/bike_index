<% show_error_column = Binxtils::InputNormalizer.boolean(params[:search_show_error]) %>

<% colors = %w[#B60205 #D93F0B #FBCA04 #0E8A16 #006B75 #1D76DB #0052CC #5319E7 #D4C5F9 #2C3E50 #F9D0C4 #C2E0C6 #C5DEF5 #7DCABB #3f3a44 #d54692 #168124 #9b6b3b #e0b70f #a79be8] %>

<% rendered_chart = nil %>

<% if @render_chart %>
  <% rendered_chart = capture do %>
    <% if @render_kind_counts %>
      <% active_colors = colors.dup
      series = Notification.kinds.each_with_index.filter_map do |k, i|
        if matching_notifications.where(kind: k).any?
          {name: Notification.kind_humanized(k).titleize, data: UI::Chart::Component.time_range_counts(collection: matching_notifications.where(kind: k), time_range: @time_range, column: @time_range_column)}
        else
          active_colors -= [colors[i]]
          nil
        end
      end %>
      <%= render(UI::Chart::Component.new(series:, time_range: @time_range, stacked: true, colors: active_colors)) %>
    <% else %>
      <% series = [{name: "Notifications", data: UI::Chart::Component.time_range_counts(collection: matching_notifications, time_range: @time_range, column: @time_range_column)}] %>
      <%= render(UI::Chart::Component.new(series:, time_range: @time_range, stacked: true, colors:)) %>
    <% end %>
  <% end %>
<% end %>

<% admin_search_form = capture do %>
  <%= form_with(url: admin_notifications_path, method: :get, html: {class: "twsearchrow"}) do |f| %>
    <%= render partial: "/shared/hidden_search_fields" %>
    <%= hidden_field_tag :search_with_bike, params[:search_with_bike] %>
    <%= hidden_field_tag :search_undelivered, params[:search_undelivered] %>

    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :query,
      html_options: {value: params[:query], placeholder: "Search email/phone"}) %>

    <%= render UI::Button::Component.new(text: "Search", color: :primary, type: "submit", name: "search") %>
  <% end %>
<% end %>

<% table_view = capture do %>
  <% if @render_kind_counts %>
    <%= render(UI::Container::Component.new) do %>
      <%= render(UI::Card::Component.new(additional_classes: "tw:my-6")) do %>
        <%= render(UI::Header::Component.new(text: "Kinds", tag: :h2)) %>

        <%= render(UI::TableList::Component.new(wide_definition: true)) do |list| %>
          <% Notification.kinds.each_with_index do |kind, index| %>
            <% count = matching_notifications.where(kind: kind).count %>
            <% next unless count > 0 %>

            <% label = capture do %>
              <div
                style="width: 1em; height: 1em; background: <%= colors[index] %>; float: right; margin-left: 0.4rem;"
              ></div>

              <%= link_to Notification.kind_humanized(kind).titleize, url_for(sortable_search_params.merge(search_kind: kind)), class: "twlink" %>
            <% end %>

            <% list.with_row(label:, value: number_display(count)) %>
          <% end %>

          <% nil_count = matching_notifications.where(kind: nil).count %>

          <% list.with_row(label: "Nil", value: number_display(nil_count), if: nil_count > 0) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render partial: "/admin/notifications/table", locals: {notifications: @notifications, render_sortable: true, skip_error: !show_error_column} %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @notifications,
  viewing: "Notifications",
  rendered_chart:,
  admin_search_form:,
  table_view:,
)) do |skeleton| %>
  <% skeleton.with_nav_item do %>
    <%= render(UI::ButtonLink::Component.new(text: "show errors", href: url_for(sortable_search_params.merge(search_show_error: !show_error_column)), size: :sm, active: show_error_column)) %>
  <% end %>

  <% skeleton.with_nav_item do %>
    <%= render(UI::Dropdown::Component.new(name: "#{@kind.titleize} #{(special_kind_scopes + ["all"]).include?(@kind) ? "kinds" : ""}", button_size: :sm,
          active: @kind != "all")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All kinds", path: url_for(sortable_search_params.merge(search_kind: nil)), match_params: {search_kind: nil}) } %>

      <% special_kind_scopes.each do |kind| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{kind.titleize} kinds", path: url_for(sortable_search_params.merge(search_kind: kind)), match_params: {search_kind: kind}) } %>
      <% end %>

      <% dropdown.with_entry_divider %>

      <% Notification.kinds.each do |kind| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: Notification.kind_humanized(kind).titleize, path: url_for(sortable_search_params.merge(search_kind: kind)), match_params: {search_kind: kind}) } %>
      <% end %>
    <% end %>
  <% end %>

  <% skeleton.with_nav_item do %>
    <%= render(UI::ButtonLink::Component.new(text: "Only undelivered", href: url_for(sortable_search_params.merge(search_undelivered: !@undelivered)), size: :sm, active: @undelivered)) %>
  <% end %>

  <% skeleton.with_nav_item do %>
    <%= render(UI::ButtonLink::Component.new(text: "With bike", href: url_for(sortable_search_params.merge(search_with_bike: !@with_bike)), size: :sm, active: @with_bike)) %>
  <% end %>

  <% skeleton.with_nav_item do %>
    <%= render(UI::ButtonLink::Component.new(text: "Render kind counts", href: url_for(sortable_search_params.merge(search_kind_counts: !@render_kind_counts)), size: :sm, active: @render_kind_counts)) %>
  <% end %>
<% end %>
