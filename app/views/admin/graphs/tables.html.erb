<% sortable_params = graphs_sortable_params %>

<% if current_user.superuser? %>
  <%= render partial: "admin/graphs/graphs_subnav", locals: {location_count: true, sortable_params: sortable_params} %>
<% end %>

<div class="mb-4">
  <%= form_with(url: tables_admin_graphs_path, method: :get, html: {class: "twsearchrow"}) do |f| %>
    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :location,
      html_options: {value: params[:location], placeholder: "Location", class: "tw:w-full tw:sm:w-64"}) %>

    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :location_radius,
      html_options: {value: params[:location_radius], placeholder: "Proximity in miles", class: "tw:w-full tw:sm:w-48"}) %>

    <%= hidden_field_tag :tables, true %>
    <%= render UI::Button::Component.new(text: "Load", color: :primary, type: "submit", name: "search") %>
  <% end %>
</div>

<h2>Records everywhere</h2>

<p>
  The <span class="less-strong">data in this color</span> is (simplified, not
  accounting for seasonalness) projections for the end of the current year
</p>

<%= render(Pages::Admin::Graphs::YearCounts::Component.new) %>

<div class="mt-4"></div>

<% if @bounding_box.present? %>
  <h4 class="mt-4">
    Records <em>within <%= @location_radius %> miles of</em>
    <strong><%= params[:location] %></strong>
  </h4>

  <div class="mt-3">
    <%= render(Pages::Admin::Graphs::YearCounts::Component.new(bounding_box: @bounding_box)) %>
  </div>
<% else %>
  <h2>
    <em>Add a location to the search section at the top of the page to see stats about that location</em>
  </h2>

  <% if params[:location].present? %>
    <h4>The location and proximity you entered weren't useable. Try again.</h4>
  <% end %>
<% end %>
