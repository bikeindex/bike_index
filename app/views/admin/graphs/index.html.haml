- sortable_params = graphs_sortable_params
= render partial: "admin/graphs/graphs_subnav", locals: {sortable_params: sortable_params}

- if @kind == "general"

  = render(UI::Header::Component.new(text: "Users past week", tag: :h2, html_class: "twsection"))
  = render(UI::Chart::Component.new(series: variable_admin_graphs_path(search_kind: "users", period: "week"), stacked: true))

  = render(UI::Header::Component.new(text: "Users past year", tag: :h2, html_class: "twsection"))
  = render(UI::Chart::Component.new(series: variable_admin_graphs_path(search_kind: "users", period: "year"), stacked: true))


  = render(UI::Header::Component.new(text: "Bikes past year", tag: :h2, html_class: "twsection"))
  = render(UI::Chart::Component.new(series: variable_admin_graphs_path(search_kind: "bikes", period: "year"), stacked: true))

- elsif @kind == "bikes"
  = render(Pages::Admin::Graphs::Bikes::Component.new(index: admin_index_state,
    sortable_params:, total_count: @total_count, ignored_only: @ignored_only, manufacturer: @manufacturer,
    searched_statuses: @searched_statuses, default_statuses: @default_statuses, not_default_statuses: @not_default_statuses))

- else
  - if @total_count.present?
    %p{class: "tw:mt-6 tw:mb-4"}
      #{number_display(@total_count)} matching #{@kind}
      %em
        = render(UI::TimeRange::Component.new(time_range: @time_range, period: @period))
  %div{class: "tw:mt-6"}
  = render(UI::Chart::Component.new(series: variable_admin_graphs_path(sortable_params)))
