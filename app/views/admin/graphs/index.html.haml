-# Make sure that period is passed - because it's a different period than other places
- sortable_params = {period: default_period}.merge(sortable_search_params).symbolize_keys
= render partial: "admin/graphs/graphs_subnav", locals: {sortable_params: sortable_params}

- if @kind == "general"

  %h2.mt-4 Users past week
  = render(UI::Chart::Component.new(series: variable_admin_graphs_path(search_kind: "users", period: "week"), time_range: @time_range, stacked: true))

  %h2.mt-4
    Users past year
  = render(UI::Chart::Component.new(series: variable_admin_graphs_path(search_kind: "users", period: "year"), time_range: @time_range, stacked: true))


  %h2.mt-4
    Bikes past year
  = render(UI::Chart::Component.new(series: variable_admin_graphs_path(search_kind: "bikes", period: "year"), time_range: @time_range, stacked: true))

- elsif @kind == "bikes"
  = render partial: "bikes_graphs", locals: {sortable_params:}

- else
  - if @total_count.present?
    %p.mt-4
      #{number_display(@total_count)} matching #{@kind}
      %em
        = humanized_time_range(@time_range)
  .mt-4
  = render(UI::Chart::Component.new(series: variable_admin_graphs_path(sortable_params), time_range: @time_range))
