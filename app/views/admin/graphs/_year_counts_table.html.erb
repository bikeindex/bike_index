<%# locals: (rows:) %>

<%= render(UI::Table::Component.new(records: rows)) do |table| %>
  <% table.column(label: "") do |year, _counts| %>
    <%= year %>
  <% end %>

  <% ["Stolen in year", "Total stolen by eoy", "Recovered in year", "Recovered by eoy", "Stolen & non, in year", "Total Stolen & non by eoy", "Users in year"].each_with_index do |label, index| %>
    <% table.column(label:) do |_year, counts| %>
      <% if counts[index] %>
        <% count, projection = counts[index] %>
        <%= number_with_delimiter(count) %>
        <% if projection %>
          <span class="less-strong ml-1"><%= number_with_delimiter(projection) %></span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
