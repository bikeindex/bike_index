-# TODO: make this better. Leaves much to be desired

= render(Pages::Admin::Headers::Nav::Component.new(title: "Customer Contact"))
.twwiderow{class: "tw:items-start"}
  = render(UI::TableList::Component.new) do |list|
    - list.with_row(label: "Created", value: render(UI::Time::Component.new(time: @customer_contact.created_at, format: :localize_time_precise)))
    - list.with_row(label: "Updated", value: tag.span(render(UI::Time::Component.new(time: @customer_contact.updated_at, format: :localize_time_precise)), class: "tw:text-sm"))
    - list.with_row(label: "Sender") do
      %em
        = @customer_contact.creator&.display_name
    - list.with_row(label: "Kind") do
      %em
        = @customer_contact.kind.humanize
    - list.with_row(label: "Bike") do
      - if @customer_contact.bike.present?
        = link_to organized_bike_text(@customer_contact.bike), edit_admin_bike_path(@customer_contact.bike)
      - else
        %small.twless-strong Bike ID: #{@customer_contact.bike_id}
  = render(UI::TableList::Component.new) do |list|
    - list.with_row(label: "Title", value: @customer_contact.title)
    - list.with_row(label: "Body", value: @customer_contact.body)
