%h1.mt-4
  Edit Superuser Ability

.row.mb-4
  .col-md-6
    = render(UI::TableList::Component.new) do |list|
      - list.with_row(label: "Created", value: render(UI::Time::Component.new(time: @superuser_ability.created_at)))
      - list.with_row(label: "Updated", value: tag.span(render(UI::Time::Component.new(time: @superuser_ability.updated_at)), class: "small"))
      - list.with_row(label: "Deleted") do
        - if @superuser_ability.deleted_at.present?
          %strong.text-danger
            = render(UI::Time::Component.new(time: @superuser_ability.deleted_at))
      - list.with_row(label: "User") do
        = cache(@superuser_ability.user) do
          = render Atoms::Admin::TableCells::User::Component.new(user_id: @superuser_ability.user_id, user: @superuser_ability.user, render_search: false)
  .col-md-6
    = render(UI::TableList::Component.new) do |list|
      - list.with_row(label: "Kind", value: @superuser_ability.kind.titleize)
      - list.with_row(label: "controller name", value: @superuser_ability.controller_name)
      - list.with_row(label: "Action name", value: @superuser_ability.action_name)

  .col-md-6
    .card.bg-light
      .card-body
        = form_for [:admin, @superuser_ability] do |f|
          = render(UI::Alerts::ObjectError::Component.new(object: @superuser_ability))

          %div{class: "tw:mb-4"}
            - SuperuserAbility::SU_OPTIONS.each do |ability|
              = render(UI::Forms::Checkbox::Component.new(name: ability, label: "#{ability.to_s.humanize}?", value: true, checked: @superuser_ability.su_option?(ability)))

          %div{class: "tw:flex tw:justify-end"}
            = render(UI::Button::Component.new(text: "Update", color: :primary, type: "submit"))
    - unless @superuser_ability.deleted?
      .mt-4.text-right
        = render(UI::ButtonLink::Component.new(text: "Delete superuser ability", href: admin_superuser_ability_path(@superuser_ability), method: :delete, color: :error, confirm: "Are you sure you want to delete this superuser ability?"))
