- payment ||= @payment

.twwiderow{class: "tw:items-start"}
  = render(UI::TableList::Component.new) do |list|
    - list.with_row(label: "Method") do
      %span.less-strong= payment.payment_method
    - list.with_row(label: "Amount", value: payment.amount_formatted)
    - list.with_row(label: "Currency") do
      %span{class: (payment.currency_enum == Currency.default.slug ? "less-strong" : UI::Alerts::Base::Component::TEXT_CLASSES[:notice])}
        = payment.currency_name
    - list.with_row(label: "Stripe ID", if: payment.stripe_id.present?) do
      = link_to(payment.stripe_id.truncate(20), payment.stripe_admin_url, title: payment.stripe_id, class: "twlink")
    - list.with_row(label: "For") do
      - if payment.theft_alert.present?
        = link_to "Promoted alert", edit_admin_theft_alert_path(payment.theft_alert), class: "twlink"
      - elsif payment.invoice_id.present?
        = render partial: "payment_invoice_cell", locals: {payment:}
      - elsif payment.membership_id.present?
        = link_to "Membership", admin_membership_path(payment.membership_id), class: "twlink"
      %small.less-strong
        (#{payment.kind_humanized})

      - if payment.stripe? && payment.membership_id.present?
        = link_to "membership's payments", admin_payments_path(search_membership_id: payment.membership_id), class: "twlink less-strong tw:ml-1 tw:text-sm"
  = render(UI::TableList::Component.new) do |list|
    - list.with_row(label: "Created", value: render(UI::Time::Component.new(time: payment.created_at, format: :localize_time_precise)))
    - list.with_row(label: "Paid") do
      - if payment.paid?
        = render(UI::Time::Component.new(time: payment.paid_at, format: :localize_time_precise))
      - else
        %span{class: UI::Alerts::Base::Component::TEXT_CLASSES[:error]} Incomplete!
    - list.with_row(label: "Stripe Status", dev_only: true, value: render(UI::Code::Inline::Component.new(text: payment.stripe_status)), if: payment.stripe? && display_dev_info?)
    - list.with_row(label: "User") do
      - search_url = payment.user_id.present? ? admin_payments_path(user_id: payment.user_id) : admin_payments_path(search_email: payment.email)
      = render Atoms::Admin::TableCells::User::Component.new(user: payment.user, email: payment.email, search_url: search_url, render_search: true)
      - if payment.user_id.blank? && payment.email.present?
        = render(UI::Code::Inline::Component.new(text: payment.email))
    - list.with_row(label: "Referral source") do
      - if payment.referral_source.present?
        = render(UI::Code::Inline::Component.new(text: payment.referral_source))
