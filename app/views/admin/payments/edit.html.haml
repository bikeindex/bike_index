%h1{class: "tw:mb-6"}
  Edit Payment

= render partial: "/admin/payments/display", locals: {payment: @payment}

%div{class: "tw:pb-6"}

- if @payment.can_assign_to_membership?
  = render(UI::Container::Component.new) do
    .card{class: "tw:mt-6 tw:mb-12"}
      .card-body
        %p
          You can give this user a Bike Index membership by clicking
          %em assign to membership
          \- which will give this user a membership if they don't have one, or extend their current membership if they do.
        = render(UI::ButtonLink::Component.new(text: "assign to membership", href: admin_payment_path(id: @payment.id, assign_to_membership: true), method: :patch, color: :primary))

- if @payment.can_assign_to_invoice?
  = render(UI::Container::Component.new) do
    = form_for [:admin, @payment] do |f|
      = render(UI::Alerts::ObjectError::Component.new(object: @payment))

      .twwiderow
        = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :organization_id, label_text: Payment.human_attribute_name(:organization_id))) do
          = render UI::Forms::Combobox::Component.new(name: :organization_id, options: Organization.approved.pluck(:name, :id), include_blank: true, html_options: {form: f, placeholder: "Choose organization"})
        = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :invoice_id, label_text: "Invoice #"))

      %div{class: "tw:flex tw:justify-end"}
        = render(UI::Button::Component.new(text: "Submit", color: :primary, type: "submit"))

