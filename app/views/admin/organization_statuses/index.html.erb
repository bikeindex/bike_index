<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(name: @kind == "all" ? "All org kinds" : Organization.kind_humanized(@kind), button_size: :sm,
          active: @kind != "all")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All kinds", path: url_for(sortable_search_params.merge(search_kind: nil)), match_params: {search_kind: nil}) } %>
      <% not_bike_shop_active = @kind == "not_bike_shop" %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "NOT bike shops", path: url_for(sortable_search_params.merge(search_kind: not_bike_shop_active ? "" : "not_bike_shop")), match_params: {search_kind: "not_bike_shop"}) } %>
      <% dropdown.with_entry_divider %>

      <% Organization.kinds.each do |kind| %>
        <% kind_active = @kind == kind %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: Organization.kind_humanized(kind), path: url_for(sortable_search_params.merge(search_kind: kind_active ? nil : kind)), match_params: {search_kind: kind}) } %>
      <% end %>
    <% end %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(name: humanize_pos_kind(@pos_kind), button_size: :sm,
          active: @pos_kind != "all")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: humanize_pos_kind("all"), path: url_for(sortable_search_params.merge(search_pos_kind: nil)), match_params: {search_pos_kind: nil}) } %>

      <% grouped_pos_kinds.each do |pos_kind| %>
        <% pos_kind_active = @pos_kind == pos_kind %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: humanize_pos_kind(pos_kind), path: url_for(sortable_search_params.merge(search_pos_kind: pos_kind_active ? nil : pos_kind)), match_params: {search_pos_kind: pos_kind}) } %>
      <% end %>

      <% dropdown.with_entry_divider %>

      <% Organization.pos_kinds.each do |pos_kind| %>
        <% pos_kind_active = @pos_kind == pos_kind %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: pos_kind.humanize, path: url_for(sortable_search_params.merge(search_pos_kind: pos_kind_active ? nil : pos_kind)), match_params: {search_pos_kind: pos_kind}) } %>
      <% end %>
    <% end %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "current", href: url_for(sortable_search_params.merge(search_current: !@current)), size: :sm, active: @current)) %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "ended", href: url_for(sortable_search_params.merge(search_ended: !@ended)), size: :sm, active: @ended)) %>
  </li>
<% end %>

<% rendered_chart = nil %>

<% if @render_chart %>
  <% rendered_chart = capture do %>
    <% if sort_column != "created_at" %>
      <%= render(Pages::Admin::OrganizationStatusesChart::Component.new(
        matching_organization_statuses:,
        matching_organization_statuses_untimed:,
        time_range: @time_range,
        pos_kind: @pos_kind,
        ended: @ended || false,
        current: @current || false
      )) %>
    <% else %>
      <%# ALMOST ALWAYS we want to see fancy graphs for the start/end. %>
      <%# But, in case you want to see created_at (probably for bug hunting), graph that %>
      <%= render(UI::Chart::Component.new(series: time_range_counts(collection: matching_organization_statuses, column: @time_range_column), time_range: @time_range, stacked: true)) %>
    <% end %>
  <% end %>
<% end %>

<% show_created_at = sort_state.sort == "created_at" || Binxtils::InputNormalizer.boolean(params[:search_show_created_at]) %>

<% render_search = params[:organization_id].blank? %>

<% table_view = capture do %>
  <%= render(UI::Table::Component.new(records: @organization_statuses, render_sortable: true, sort_state:)) do |table| %>
    <% table.column(sortable: "start_at", lower_right: ->(record) { tag.span(record.id, class: "only-dev-visible") }) do |organization_status| %>
      <%= render UI::Time::Component.new(time: organization_status.start_at, format: :localize_time_precise) %>
    <% end %>

    <% if show_created_at %>
      <% table.column(sortable: "created_at", classes: "tw:text-xs") do |organization_status| %>
        <%= render UI::Time::Component.new(time: organization_status.created_at) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "end_at") do |organization_status| %>
      <%= render UI::Time::Component.new(time: organization_status.end_at, format: :localize_time_precise) %>
    <% end %>

    <% table.column(label: "Duration") do |organization_status| %>
      <% if organization_status.end_at.present? %>
        <%= helpers.period_in_words(organization_status.end_at - organization_status.start_at) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "organization_id") do |organization_status| %>
      <%= render Pages::Admin::Organizations::Cell::Component.new(sort_state:, organization: organization_status.organization, organization_id: organization_status.organization_id, render_search:) %>
    <% end %>

    <% table.column(sortable: "pos_kind", label: "POS kind") do |organization_status| %>
      <% status_class = organization_status.pos_kind.match?(/broken/) ? "text-danger" : "" %>
      <% status_class = "less-strong" if organization_status.pos_kind == "no_pos" %>

      <span class="<%= status_class %>">
        <%= organization_status.pos_kind&.humanize %>
      </span>
    <% end %>

    <% table.column(sortable: "kind") do |organization_status| %>
      <%= Organization.kind_humanized(organization_status.kind) %>
    <% end %>

    <% table.column(sortable: "organization_deleted_at", label: "Deleted", classes: "tw:text-xs") do |organization_status| %>
      <% if organization_status.organization_deleted_at.present? %>
        <span class="text-danger">
          <%= render UI::Time::Component.new(time: organization_status.organization_deleted_at, format: :localize_time_precise) %>
        </span>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @organization_statuses,
  viewing: "Organization Statuses",
  index_title: "Organization Statuses",
  nav_header_list_items:,
  rendered_chart:,
  table_view:,
)) %>
