= render(Pages::Admin::Headers::Nav::Component.new(title: "Edit Primary Activity"))

.row.mt-4
  .col-md-6
    = render(UI::TableList::Component.new) do |list|
      - list.with_row(label: "Created", class: "small", value: render(UI::Time::Component.new(time: @primary_activity.created_at, format: :localize_time_precise)))
      - list.with_row(label: "Updated", class: "small", value: render(UI::Time::Component.new(time: @primary_activity.updated_at, format: :localize_time_precise)))
      - list.with_row(label: "Name", value: @primary_activity.name)
      - list.with_row(label: "Short name", class: "small", value: @primary_activity.short_name)
      - list.with_row(label: "Display name", class: "small", value: @primary_activity.display_name)

  .col-md-6
    = render(UI::TableList::Component.new) do |list|
      - list.with_row(label: "Top level?", value: (check_mark if @primary_activity.top_level?))
      - list.with_row(label: "Family", value: (check_mark if @primary_activity.family))
      - list.with_row(label: "Family", value: @primary_activity.family_name)
      - list.with_row(label: "Bike count", value: link_to(number_display(Bike.where(primary_activity_id: @primary_activity.id).count), admin_bikes_path(primary_activity: @primary_activity.id)))

- if @primary_activity.family?
  .mt-5.mb-5
    %h4 Flavors
    = render(partial: "table", locals: {collection: @primary_activity_flavors, render_sortable: false})

.row
  .col-sm-6
    = form_for [:admin, @primary_activity] do |f|
      = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :priority, kind: :number_field))
      %div{class: "tw:mt-4"}
        = render(UI::Button::Component.new(text: "Save", color: :primary, size: :lg, type: "submit"))
