= render(Pages::Admin::Headers::Nav::Component.new(title: "Credibility Badges"))

%p
  Bikes start out with a score of
  %strong
    = CredibilityScorer::BASE_SCORE
%p
  Badges add or subtract value from that score (max of #{CredibilityScorer::MAX_SCORE}, min of 0)

= render(UI::Container::Component.new) do
  %table.table.table-striped.table-bordered.table-sm
    %thead.thead-light
      %th.small
        Category
      %th
        Name
      %th
        Value
    %tbody
      - CredibilityScorer::BADGES.each do |category, badges|
        - CredibilityScorer::BADGES[category].each do |key, value|
          %tr
            %td
              %small.twless-strong
                = category.to_s.humanize
            %td
              = key.to_s.humanize
            %td
              = value
