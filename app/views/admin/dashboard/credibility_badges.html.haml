= render(Pages::Admin::Headers::Nav::Component.new(title: "Credibility Badges"))

%p{class: "tw:mb-4"}
  Bikes start out with a score of
  %strong
    = CredibilityScorer::BASE_SCORE
%p{class: "tw:mb-4"}
  Badges add or subtract value from that score (max of #{CredibilityScorer::MAX_SCORE}, min of 0)

= render(UI::Container::Component.new) do
  = render(UI::Table::Component.new(records: CredibilityScorer::BADGES.flat_map { |category, badges| badges.map { |key, value| [category, key, value] } })) do |table|
    - table.column(label: "Category") do |(category, _key, _value)|
      %small.less-strong= category.to_s.humanize
    - table.column(label: "Name") do |(_category, key, _value)|
      = key.to_s.humanize
    - table.column(label: "Value") do |(_category, _key, value)|
      = value
