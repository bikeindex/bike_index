<%= render(Pages::Admin::Headers::Nav::Component.new(title: "Maintaining things")) %>

<%= render(UI::Header::Component.new(text: "Component manufacturer other", tag: :h2, html_class: "twsection")) %>

<%= render partial: "/admin/components/table", locals: {collection: @component_mnfgs} %>

<%= render(UI::Header::Component.new(text: "Component type other", tag: :h2, html_class: "twsection")) %>

<%= render partial: "/admin/components/table", locals: {collection: @component_types} %>

<%= render(UI::Header::Component.new(text: "Handlebar Types other", tag: :h2, html_class: "twsection")) %>

<%= render(UI::Table::Component.new(records: @bikes_other_handlebar_type)) do |table| %>
  <% table.column(label: "Date") do |bike| %>
    <%= render UI::Time::Component.new(time: bike.created_at) %>
  <% end %>

  <% table.column(label: "Bike") do |bike| %>
    <%= render Atoms::Admin::TableCells::Bike::Component.new(bike:) %>
  <% end %>
<% end %>

<%= render(UI::Header::Component.new(tag: :h2, html_class: "twsection")) do %>
  Recent example bikes
  <span class="tw:font-normal"><%= link_to "Delete example bikes", admin_destroy_example_bikes_url, class: "twlink" %></span>
<% end %>

<% if @bikes.any? %>
  <%= render Pages::Admin::Bikes::Table::Component.new(bikes: @bikes, sort_state:) %>

  <p class="tw:mb-4 tw:text-right">
    <%= Bike.unscoped.where(example: true).count %> example bikes total
  </p>
<% else %>
  No example bikes right now!
<% end %>
