<% cache("admin/dashboard/index", expires_in: 1.minute) do %>
  <h1 class="text-center">Go Hard</h1>

  <% if Organization.example.blank? %>
    <div class="alert alert-danger">
      <h4>Example organization is broken!</h4>
      <p>This breaks things. Tell Seth.</p>
    </div>
  <% end %>

  <h2 class="mb-4 mt-4">
    Recent <%= link_to "Bikes", admin_bikes_url %>
  </h2>

  <%= render Pages::Admin::Bikes::Table::Component.new(bikes: @bikes, sort_state:) %>

  <% today = Bike.where("created_at >= ?", Time.current.beginning_of_day).count %>
  <% yesterday = (Bike.where("created_at >= ?", Time.current.beginning_of_day - 1.day).count) - today %>
  <% bikes = [{name: "Registrations", data: UI::Chart::Component.time_range_counts(collection: Bike.unscoped.current.not_stolen.where(created_at: @time_range), time_range: @time_range, column: "bikes.created_at")}, {name: "Stolen", data: UI::Chart::Component.time_range_counts(collection: Bike.unscoped.current.status_stolen.where(created_at: @time_range), time_range: @time_range, column: "bikes.created_at")}] %>

  <div class="row justify-content-end">
    <div class="col-auto">
      <p>
        <%= number_with_delimiter(Bike.count) %> bikes total
        <em>(<%= number_with_delimiter(yesterday) %> yesterday, <%= number_with_delimiter(today) %> today)</em>
      </p>
    </div>
  </div>

  <%= render(UI::Chart::Component.new(series: bikes, time_range: @time_range, stacked: true)) %>

  <hr>

  <% cache(User.maximum(:created_at)) do %>
    <h2 class="mt-4">
      Recent <%= link_to "Users", admin_users_url %>
    </h2>

    <%= render Pages::Admin::Users::Table::Component.new(users: @users) %>

    <div class="row justify-content-end">
      <div class="col-auto">
        <p>
          <%= number_with_delimiter(@users_count) %> users total
          <em>(<%= number_with_delimiter(@users_yesterday) %> yesterday, <%= number_with_delimiter(@users_today) %> today)</em>
        </p>
      </div>
    </div>
  <% end %>

  <hr>

  <h2 class="mt-4">
    Recent <%= link_to "Organizations", admin_organizations_url %>
  </h2>

  <%= render(Pages::Admin::Organizations::Table::Component.new(organizations: @organizations, sort_state:)) %>

  <div class="row justify-content-end">
    <div class="col-auto">
      <p>
        <%= number_with_delimiter(Organization.count) %> Organizations total
        <% today = Organization.where("created_at >= ?", Time.current.beginning_of_day).count %>

        <% yesterday = (Organization.where("created_at >= ?", Time.current.beginning_of_day - 1.day).count) - today %>

        <em>(<%= number_with_delimiter(yesterday) %> yesterday, <%= number_with_delimiter(today) %> today)</em>
      </p>
    </div>
  </div>

  <hr>

  <% week_searches = Counts.logged_searches(@time_range.first.to_date..Date.current).values.reduce { |sum, day| sum.merge(day) { |_kind, a, b| a + b } } %>

  <div class="row">
    <div class="col-md-6">
      <h2 class="mt-4">
        Index searches
      </h2>

      <p>
        <%= number_display(week_searches.values_at("organized", "organized_serial", "user", "user_serial", "web_marketplace").sum) %>
        past week
        <em>(<%= number_display(week_searches["organized"] + week_searches["organized_serial"]) %> org, <%= number_display(week_searches["organized_serial"] + week_searches["user_serial"]) %> with serial, <%= number_display(week_searches["web_marketplace"]) %> marketplace)</em>
      </p>

      <%= render(UI::Chart::Component.new(series: logged_searches_admin_graphs_path(search_endpoint: "not_web_bikebook", period: "week"), stacked: true)) %>
    </div>

    <div class="col-md-6">
      <h2 class="mt-4">
        BikeBook searches
      </h2>

      <p>
        <%= number_display(week_searches["web_bikebook"] + week_searches["web_ebike_rules"]) %>
        past week
        <em>(<%= number_display(week_searches["web_ebike_rules"]) %> from e-bike rules)</em>
      </p>

      <%= render(UI::Chart::Component.new(series: logged_searches_admin_graphs_path(search_endpoint: "web_bikebook", period: "week"), stacked: true)) %>
    </div>
  </div>
<% end %>
