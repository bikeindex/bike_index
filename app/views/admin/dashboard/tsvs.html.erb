<%= render(Pages::Admin::Headers::Nav::Component.new(title: "TSV Exports!", subtitle: "TSVs are generated every night.")) %>

<h4>Tsv reports:</h4>

<% if @tsvs.none? %>
  <p class="text-warning">No TSVs</p>
<% else %>
  <%= render(UI::Table::Component.new(records: @tsvs.sort_by { |a| a[:updated_at] })) do |table| %>
    <% table.column(label: "Updated") do |tsv_info| %>
      <%= render UI::Time::Component.new(time: Time.at(tsv_info[:updated_at].to_i)) %>
    <% end %>

    <% table.column(label: "File") do |tsv_info| %>
      <%= link_to tsv_info[:filename], tsv_info[:path], class: "twlink" %>
    <% end %>

    <% table.column(label: "description") do |tsv_info| %>
      <%= tsv_info[:description] %>
    <% end %>

    <% table.column(label: "Daily") do |tsv_info| %>
      <%= check_mark if tsv_info[:daily] %>
    <% end %>
  <% end %>
<% end %>

<%= render(UI::Container::Component.new(alignment: :left)) do %>
  <%= form_with(url: admin_update_tsv_blocklist_path, method: :put, multipart: true, class: "tw:mt-6") do |f| %>
    <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :blocklist, kind: :text_area,
      label_text: "Blocklist Bike Urls", optional_badge: false,
      html_options: {value: @blocklist.map { |i| "#{ENV["BASE_URL"]}/bikes/#{i}" }.join("\n"), rows: 10})) do |group| %>
      <% group.with_helper_text do %>
        <strong>1 per line</strong>. These can be the id (the number in the
        url), the bike url, admin url or edit url
      <% end %>
    <% end %>

    <%= render UI::Button::Component.new(text: "Save changes", color: :primary, type: "submit") %>
  <% end %>
<% end %>
