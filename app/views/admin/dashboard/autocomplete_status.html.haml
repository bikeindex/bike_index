= render(Pages::Admin::Headers::Nav::Component.new(title: "Autocomplete status"))

= render(UI::Container::Component.new(alignment: :left)) do
  %div{class: "tw:mb-4"}
    = render(Pages::Admin::Headers::Section::Component.new(title: "Autocomplete info"))
  = render(UI::TableList::Component.new) do |list|
    - list.with_row(label: "Category Keys") do
      = number_display(@autocomplete_info[:category_keys])
      %small.twless-strong{class: "tw:ml-1"}
        should be > 100k
    - list.with_row(label: "Cache Keys") do
      = number_display(@autocomplete_info[:cache_keys])
      %small.twless-strong{class: "tw:ml-1"}
        they should expire every 10 minutes...
    - @autocomplete_info.except(:category_keys, :cache_keys).each do |key, value|
      - list.with_row(label: key.to_s.humanize, value: value.is_a?(Integer) ? number_display(value) : value)
