<div class="admin-subnav">
  <div class="col-12">
    <h1>Scheduled jobs</h1>
  </div>
</div>

<% env_skipped_jobs = ENV.keys.grep(/\ASIDEKIQ_SKIP_/).select { |k| Binxtils::InputNormalizer.boolean(ENV.fetch(k, nil)) } %>

<% if env_skipped_jobs.any? %>
  <%= render UI::Alerts::Base::Component.new(kind: :warning, header: "Skipped via ENV SIDEKIQ_SKIP_*") do %>
    <ul class="tw:mb-0">
      <% env_skipped_jobs.each do |env_key| %>
        <li>
          <code>
            <%= env_key.sub(/\ASIDEKIQ_SKIP_/, "").downcase.camelize %>
          </code>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<% jobs = ScheduledJobRunner.scheduled_jobs.sort_by { |klass| klass.name.downcase }.map do |klass|
  [klass, klass.last_started && Time.parse(klass.last_started), klass.last_finished.presence && Time.parse(klass.last_finished)]
end %>

<div class="mt-4">
  <%= render(UI::Table::Component.new(records: jobs)) do |table| %>
    <% if display_dev_info? %>
      <% table.column(label: "", classes: "only-dev-visible") do |(klass)| %>
        <code class="small"><%= klass %></code>
      <% end %>
    <% end %>

    <% table.column(label: "Job") do |(klass)| %>
      <%= klass.to_s.gsub(/\Ascheduled/i, "").gsub(/worker\z/i, "").underscore.humanize %>
    <% end %>

    <% table.column(label: "Frequency") do |(klass)| %>
      <%= helpers.period_in_words(klass.frequency) %>
    <% end %>

    <% table.column(label: "Next run") do |klass, last_started| %>
      <% if klass.new.skip_scheduling? %>
        <%= render UI::Alerts::Base::Component.new(text: "Skipped", kind: :warning, margin_classes: "") %>
      <% elsif last_started.blank? || (last_started + klass.frequency) < Time.current %>
        <span class="less-strong">now</span>
      <% else %>
        <%= helpers.period_in_words((last_started + klass.frequency) - Time.current) %>
      <% end %>
    <% end %>

    <% table.column(label: "Last started") do |_klass, last_started| %>
      <%= render UI::Time::Component.new(time: last_started, format: :localize_time_precise) %>
    <% end %>

    <% table.column(label: "Last finished") do |_klass, _last_started, last_finished| %>
      <%= render UI::Time::Component.new(time: last_finished, format: :localize_time_precise) %>
    <% end %>

    <% table.column(label: "Duration") do |_klass, last_started, last_finished| %>
      <% if last_finished.present? && last_started.present? %>
        <%= helpers.period_in_words(last_finished - last_started) %>
      <% end %>
    <% end %>
  <% end %>
</div>
