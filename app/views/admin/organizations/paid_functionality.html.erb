<%= render(Admin::OrganizationTabs::Component.new(organization: @organization, active: :paid_functionality)) %>

<% if @organization.paid? %>
  <%= render(Admin::OrganizationForm::TabForm::Component.new(organization: @organization, tab: "paid_functionality",
        fields_component: Admin::OrganizationForm::FeatureSettings::Component, fields_args: {current_user:})) %>
<% else %>
  <p class="less-strong">
    This organization has no paid functionality to configure. Features are
    enabled through
    <%= link_to "its invoices", admin_organization_invoices_path(organization_id: @organization.to_param) %>.
  </p>
<% end %>
