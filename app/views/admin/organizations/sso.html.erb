<%= render(Admin::OrganizationTabs::Component.new(organization: @organization, active: :sso)) %>

<% if @organization.enabled?("saml_sso") %>
  <%= render(Admin::OrganizationForm::TabForm::Component.new(organization: @organization, tab: "sso",
        fields_component: Admin::OrganizationForm::SamlSso::Component)) %>
<% else %>
  <p class="less-strong">
    SAML SSO is not enabled for this organization. Enable it through
    <%= link_to "its invoices", admin_organization_invoices_path(organization_id: @organization.to_param) %>.
  </p>
<% end %>
