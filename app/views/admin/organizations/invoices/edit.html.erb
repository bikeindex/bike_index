<% if @invoice.payments.none? %>
  <% additional_link = link_to("Delete invoice", admin_organization_invoice_path(organization_id: @organization.to_param, id: @invoice.to_param), method: :delete, data: {confirm: "Are you sure you want to delete this? This can't be undone"}, class: "btn btn-danger btn-sm float-right") %>
<% end %>

<%= render(Admin::OrganizationTabs::Component.new(organization: @organization, active: :invoices,
      subtitle: "Edit #{@invoice.display_name}", additional_link: defined?(additional_link) ? additional_link : nil)) %>

<div class="row">
  <%= render(Admin::InvoiceShow::Associated::Component.new(invoice: @invoice)) %>

  <%= render(Admin::InvoiceShow::Status::Component.new(invoice: @invoice)) %>
</div>

<%= render(Admin::InvoiceForm::Component.new(organization: @organization, invoice: @invoice, organization_features: @organization_features)) %>
