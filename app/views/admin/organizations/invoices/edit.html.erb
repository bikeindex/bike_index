<% additional_link = render(UI::ButtonLink::Component.new(text: "Delete invoice", href: admin_organization_invoice_path(organization_id: @organization.to_param, id: @invoice.to_param), method: :delete, color: :error, size: :sm,
      form: {onsubmit: "return confirm('#{j "Are you sure you want to delete this? This can't be undone"}')"})) if @invoice.payments.none? %>

<%= render(Pages::Admin::Organizations::Tabs::Component.new(organization: @organization, active: :invoices, display_dev_info: display_dev_info?,
      subtitle: "Edit #{@invoice.display_name}", additional_link:)) %>

<div class="twwiderow tw:items-start">
  <%= render(Pages::Admin::Invoices::Show::Associated::Component.new(invoice: @invoice)) %>
  <%= render(Pages::Admin::Invoices::Show::Status::Component.new(invoice: @invoice)) %>
</div>

<%= render(Pages::Admin::Invoices::Form::Component.new(organization: @organization, invoice: @invoice,
      organization_features: @organization_features, display_dev_info: display_dev_info?)) %>
