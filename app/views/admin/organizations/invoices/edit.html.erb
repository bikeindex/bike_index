<% additional_link = link_to("Delete invoice", admin_organization_invoice_path(organization_id: @organization.to_param, id: @invoice.to_param), method: :delete, data: {confirm: "Are you sure you want to delete this? This can't be undone"}, class: "btn btn-danger btn-sm float-right") if @invoice.payments.none? %>

<%= render(Admin::OrganizationTabs::Component.new(organization: @organization, active: :invoices,
      subtitle: "Edit #{@invoice.display_name}", additional_link:)) %>

<div class="tw:grid tw:gap-x-8 tw:sm:grid-cols-2">
  <%= render(Admin::InvoiceShow::Associated::Component.new(invoice: @invoice)) %>
  <%= render(Admin::InvoiceShow::Status::Component.new(invoice: @invoice)) %>
</div>

<%= render(Admin::InvoiceForm::Component.new(organization: @organization, invoice: @invoice, organization_features: @organization_features)) %>
