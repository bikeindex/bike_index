<% additional_link = link_to("Delete invoice", admin_organization_invoice_path(organization_id: @organization.to_param, id: @invoice.to_param), method: :delete, data: {confirm: "Are you sure you want to delete this? This can't be undone"}, class: "btn btn-danger btn-sm") if @invoice.payments.none? %>

<%= render(Admin::Organizations::Tabs::Component.new(organization: @organization, active: :invoices,
      subtitle: "Edit #{@invoice.display_name}", additional_link:)) %>

<div class="twwiderow tw:items-start">
  <%= render(Admin::Invoices::Show::Associated::Component.new(invoice: @invoice)) %>
  <%= render(Admin::Invoices::Show::Status::Component.new(invoice: @invoice)) %>
</div>

<%= render(Admin::Invoices::Form::Component.new(organization: @organization, invoice: @invoice, organization_features: @organization_features)) %>
