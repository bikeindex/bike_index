%h1 New Organizaton


= form_for [:admin, @organization], html: {data: {controller: "admin--organization-form"}} do |f|
  = render(Admin::Organizations::Form::Wrapper::Component.new(form_builder: f, current_user:))

  .row
    .col-sm-10
    .col-sm-2
      = f.submit "Create", class: 'btn btn-success mb-4 mt-4 float-right'
