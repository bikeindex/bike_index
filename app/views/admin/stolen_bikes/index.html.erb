<% rendered_chart = nil %>

<% if @render_chart %>
  <% rendered_chart = capture do %>
    <div class="tw:mt-2 tw:mb-4">
      <% sorted_by_created = sort_column == "created_at" %>
      <% time_range_column = sorted_by_created ? "stolen_records.created_at" : "stolen_records.date_stolen" %>

      <%= render(UI::Header::Component.new(text: sorted_by_created ? "Stolen records created" : "Date stolen", tag: :h2)) %>

      <%= render(UI::Chart::Component.new(series: time_range_counts(collection: available_stolen_records, column: time_range_column), time_range: @time_range, stacked: true)) %>
    </div>
  <% end %>
<% end %>

<% table_view = capture do %>
  <%= render partial: "/admin/social_accounts/errored" %>

  <% if @unapproved_only %>
    <p class="tw:mt-6">
      Showing only unapproved records
      <em><% if @only_without_location %><strong>without location</strong><small class="twless-strong">        view        <%= link_to "records with location", url_for(sortable_search_params.merge(search_without_location: false)), class: "twlink" %>      </small><% else %><small class="twless-strong">        <%= number_display(@unapproved_without_location_count) %> unapproved        records        <%= link_to "without location", url_for(sortable_search_params.merge(search_without_location: true)), class: "twlink" %>      </small><% end %></em>
    </p>
  <% end %>

  <%= render(Pages::Admin::StolenBikes::Table::Component.new(stolen_records: @stolen_records, sort_state:)) %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @stolen_records,
  viewing: "Stolen Bikes",
  rendered_chart:,
  table_view:,
)) do |skeleton| %>
  <% skeleton.with_nav_item do %>
    <%= render(UI::ButtonLink::Component.new(text: "promoted alerts", href: admin_stolen_bikes_url(sortable_search_params.merge(search_with_promoted_alert: !@with_promoted_alert)), size: :sm, active: @with_promoted_alert)) %>
  <% end %>

  <% skeleton.with_nav_item do %>
    <%= render(UI::ButtonLink::Component.new(size: :sm,
          text: @unapproved_only ? "All stolen (not just unverified)" : "Only unverified bikes",
          href: admin_stolen_bikes_url(sortable_search_params.merge(search_unapproved: @unapproved_only)))) %>
  <% end %>
<% end %>
