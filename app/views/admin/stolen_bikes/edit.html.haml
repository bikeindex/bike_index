= render Pages::Admin::Bikes::Header::Component.new(bike: @bike, active: :stolen, stolen_record: @stolen_record, user: current_user, display_dev_info: display_dev_info?)

= render partial: "/admin/social_accounts/errored"

= render Pages::Admin::Bikes::TheftAlertImages::Component.new(bike: @bike, stolen_record: @stolen_record, return_to: request.fullpath)

%hr.twhr

- if @stolen_record.blank?
  = render(Pages::Admin::Headers::Section::Component.new(title: "Stolen record not created yet."))
  %p{class: "tw:mb-4"}
    If this bike has just been marked stolen, wait a minute or two and it will be here!

- elsif @bike.present? && !@current_stolen_record
  = render(Pages::Admin::Headers::Section::Component.new(title: tag.span("This Stolen record is not the current stolen record for the Bike!", class: UI::Alerts::Base::Component::TEXT_CLASSES[:warning])))
  %p{class: "tw:mb-4"}
    Either you're viewing a recovered bike or there is a new stolen record.
  = render(Pages::Admin::Headers::Section::Component.new(title: link_to("View the current stolen record", edit_admin_stolen_bike_url(@bike.id), class: "twlink"), tag: :h3))
  %p{class: "tw:mt-6 tw:mb-4 #{UI::Alerts::Base::Component::TEXT_CLASSES[:error]}"}
    You Probably don't want to do anything on this page

- elsif @stolen_record.present? && !@stolen_record.approved
  .twwiderow{class: "tw:my-6 tw:items-start"}
    %div
      = render(Pages::Admin::Headers::Section::Component.new(title: "Stolen Record approval process", tag: :h3))
      %ol{class: "tw:mb-4 tw:list-decimal tw:ml-4"}
        %li
          Delete anything that's egregiously wrong (like Motorcycles), or spam
        %li
          #{link_to "Edit Bike", admin_bike_path(@bike), class: "twlink"} if there is a 40 word descriptions in the "Bike Model" field and move it to the description field
        %li
          #{link_to "Edit Bike", admin_bike_path(@bike), class: "twlink"} & check "Unknown Serial" if:
          %ul{class: "tw:list-disc tw:ml-4"}
            %li
              The serial is "idk" or other similar stupid shit (rather than <span class="twless-strong">absent</span>)
            %li
              The serial is <em>only</em> a frame numbers like <code class="twcode">EN14761</code> or <code class="twcode">EN14****</code>
        %li
          #{link_to "Edit Bike", admin_bike_path(@bike, anchor: "edit-stolen-record"), class: "twlink"} and fix the stolen city name if:
          %ul{class: "tw:list-disc tw:ml-4"}
            %li
              City is abbreviated: e.g. "SLC" and not "Salt Lake City"
            %li
              The recurring new-bikes bug where city names like "San Francisco" need fixed because they just say "San"

        %li
          Determine if bike is <em>Special</em> - here are some reasons/actions taken
          %ul{class: "tw:list-disc tw:ml-4"}
            %li
              Super distinct, in a city we are strong in? We tweet highlight it, even though its getting auto tweeted
            %li
              A real distinct cargo bike in PDX? I can post to "PDX Cargo Bike Gang"
            %li
              Is it a bike dressed up as a unicorn in New Orleans? post to "Stolen bikes nola"
            %li
              Is the person using a photo from instagram? Connect with them on IG
            %li
              Is the person well-known/VIP? we email them / tweet them etc
            %li
              Did the person say "I have security video" but didn't include it? Email them for it.
            %li
              Did the person say "I have photos of the thief"  - same
          %em.twless-strong
            If you believe the bike is <em>Special</em>, and don't know what to do, ping Bryan with it

    = render(UI::Alerts::Base::Component.new(kind: :notice, header: "Approving will:")) do
      %ul
        %li
          Send out a tweet
        %li
          The #{@bike.type} will be posted to any pertinent blogs.
        %li
          It <strong class="tw:italic">can NOT</strong> be effectively reversed
      %div{class: "tw:mt-6 tw:text-center"}
        = render(UI::ButtonLink::Component.new(text: "Approve listing", href: approve_admin_stolen_bike_url(@bike), method: :post, color: :primary, size: :lg))

- social_posts = @stolen_record&.social_posts
= render(Pages::Admin::Headers::Section::Component.new(title: "Posts", tag: :h3))
- if social_posts&.any?
  = render partial: "/admin/social_posts/table", locals: { social_posts: social_posts, render_sortable: false, skip_stolen_record: true }

%hr.twhr{class: "tw:my-6"}

- if @customer_contact.present?
  = form_for [:admin, @customer_contact] do |f|
    #contact-owner
      = render(Pages::Admin::Headers::Section::Component.new(title: "Send bike owner an email", tag: :h3))

    - if @customer_contact.errors.any?
      = render(UI::Alerts::ObjectError::Component.new(object: @customer_contact))
    %div{class: "tw:grid tw:gap-x-8 tw:lg:grid-cols-12"}
      %div{class: "tw:lg:col-span-4"}
        .twfieldrow
          = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :creator_email)) do
            = render(UI::Forms::Email::Component.new(form_builder: f, attribute: :creator_email, html_options: {value: current_user.email}))
          = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :user_email)) do
            = render(UI::Forms::Email::Component.new(form_builder: f, attribute: :user_email, html_options: {value: @bike.owner_email}))
        = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :title, label_text: "Your stolen bike", html_options: {value: "Your stolen #{@bike.title_string}"}))
        = f.hidden_field :kind, value: 'stolen_contact'
        = f.hidden_field :creator_id, value: current_user.id
        = f.hidden_field :bike_id, value: @bike.id
      %div{class: "tw:lg:col-span-8"}
        = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :body, kind: :text_area, label_text: "Notification body", html_options: {placeholder: "You can write HTML in here. There will be a link to the #{@bike.type} included automatically.", rows: 7}))
      %div{class: "tw:mt-auto"}
        = render(UI::Button::Component.new(text: "Send it!", color: :primary, type: "submit", html_class: "tw:mb-4"))

  = render(UI::ButtonLink::Component.new(text: "Delete", href: admin_bike_url(@bike), method: :delete, color: :error, confirm: "Are you sure?", html_class: "tw:mb-4"))

- else
  = render(Pages::Admin::Headers::Section::Component.new(title: "Something is broken on this page"))
  = render(Pages::Admin::Headers::Section::Component.new(title: "This bike doesn't have an owner", tag: :h3))
  %p{class: "tw:mb-4"}
    Talk to a developer
