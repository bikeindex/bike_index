<%# locals: (collection:, render_sortable: true) %>

<% render_organization_search = params[:organization_id].blank? %>
<% render_user_search = params[:user_id].blank? %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at") do |user_registration_organization| %>
    <%= render UI::Time::Component.new(time: user_registration_organization.created_at) %>
  <% end %>

  <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |user_registration_organization| %>
    <%= render UI::Time::Component.new(time: user_registration_organization.updated_at) %>
  <% end %>

  <% table.column(sortable: "user_id") do |user_registration_organization| %>
    <%= render Pages::Admin::Users::Cell::Component.new(user: user_registration_organization.user, user_id: user_registration_organization.user_id, sort_state:, render_search: render_user_search) %>
  <% end %>

  <% table.column(sortable: "organization_id", label: "Organization") do |user_registration_organization| %>
    <%= render Pages::Admin::Organizations::Cell::Component.new(organization: user_registration_organization.organization, organization_id: user_registration_organization.organization_id, sort_state:, render_search: render_organization_search) %>
  <% end %>

  <% table.column(label: "Registration info", header_classes: "tw:font-normal") do |user_registration_organization| %>
    <%= render UI::JsonDisplay::Component.new(data: user_registration_organization.registration_info, small: true, table_cell: true) %>
  <% end %>

  <% table.column(label: "All bikes", classes: "tw:text-center") do |user_registration_organization| %>
    <%= check_mark if user_registration_organization.all_bikes? %>
  <% end %>

  <% table.column(label: "Can edit claimed", classes: "tw:text-center") do |user_registration_organization| %>
    <%= check_mark if user_registration_organization.can_edit_claimed %>
  <% end %>

  <%# UserRegistrationOrganization#bikes goes through the user, so a deleted one has none to count %>
  <% table.column(label: "Bikes") do |user_registration_organization| %>
    <% if user_registration_organization.user.present? %>
      <%= number_display(user_registration_organization.bikes.count) %>
    <% end %>
  <% end %>
<% end %>
