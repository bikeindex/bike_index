<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", lower_right: ->(record) { tag.span(record.id, class: "only-dev-visible") }) do |bike_organization_note| %>
    <%= link_to admin_bike_organization_note_path(bike_organization_note), class: "twlink" do %>
      <%= render UI::Time::Component.new(time: bike_organization_note.created_at) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |bike_organization_note| %>
    <%= render UI::Time::Component.new(time: bike_organization_note.updated_at) %>
  <% end %>

  <% table.column(sortable: "user_id") do |bike_organization_note| %>
    <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: bike_organization_note.user, user_id: bike_organization_note.user_id, render_search: render_sortable) %>
  <% end %>

  <% table.column(label: "Bike") do |bike_organization_note| %>
    <%= link_to bike_organization_note.bike_id, admin_bike_path(bike_organization_note.bike_id), class: "twlink" %>
  <% end %>

  <% table.column(label: "Organization") do |bike_organization_note| %>
    <%= link_to bike_organization_note.organization.short_name, admin_organization_path(bike_organization_note.organization), class: "twlink" %>
  <% end %>

  <% table.column(label: "Body", classes: "tw:text-xs") do |bike_organization_note| %>
    <span title="<%= bike_organization_note.body %>">
      <%= truncate(bike_organization_note.body, length: 80) %>
    </span>
  <% end %>
<% end %>
