<div class="admin-subnav">
  <div class="col-md-12">
    <h1>Bike Organization Note</h1>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-6">
    <%= render(UI::TableList::Component.new) do |list| %>
      <% list.with_row(label: "ID", dev_only: true, value: tag.code(@bike_organization_note.id), if: display_dev_info?) %>

      <% list.with_row(label: "User", value: render(Atoms::Admin::TableCells::User::Component.new(user: @bike_organization_note.user, user_id: @bike_organization_note.user_id))) %>

      <% list.with_row(label: "Bike", value: link_to(@bike_organization_note.bike_id, admin_bike_path(@bike_organization_note.bike_id))) %>

      <% list.with_row(label: "Organization", value: link_to(@bike_organization_note.organization.short_name, admin_organization_path(@bike_organization_note.organization))) %>

      <% list.with_row(label: "Created", value: render(UI::Time::Component.new(time: @bike_organization_note.created_at, format: :localize_time_precise))) %>

      <% list.with_row(label: "Updated", class: "small", value: render(UI::Time::Component.new(time: @bike_organization_note.updated_at, format: :localize_time_precise))) %>
    <% end %>
  </div>

  <div class="col-md-6">
    <h4>Body</h4>

    <p><%= @bike_organization_note.body %></p>
  </div>
</div>

<% versions = PaperTrail::Version.where(item_type: "BikeOrganizationNote", item_id: @bike_organization_note.id).order(created_at: :desc) %>

<% if versions.any? %>
  <div class="row mt-4">
    <div class="col-md-12">
      <h4>Paper Trail Versions</h4>

      <%= render "admin/paper_trail_versions/table", collection: versions, render_sortable: false %>
    </div>
  </div>
<% end %>
