<%= render(Pages::Admin::Headers::Nav::Component.new(title: "Bike Organization Note")) %>

<div class="twwiderow tw:mt-6 tw:items-start">
  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "ID", dev_only: true, value: render(UI::Code::Inline::Component.new(text: @bike_organization_note.id)), if: display_dev_info?) %>

    <% list.with_row(label: "User", value: render(Atoms::Admin::TableCells::User::Component.new(user: @bike_organization_note.user, user_id: @bike_organization_note.user_id))) %>

    <% list.with_row(label: "Bike", value: link_to(@bike_organization_note.bike_id, admin_bike_path(@bike_organization_note.bike_id), class: "twlink")) %>

    <% list.with_row(label: "Organization", value: link_to(@bike_organization_note.organization.short_name, admin_organization_path(@bike_organization_note.organization), class: "twlink")) %>

    <% list.with_row(label: "Created", value: render(UI::Time::Component.new(time: @bike_organization_note.created_at, format: :localize_time_precise))) %>

    <% list.with_row(label: "Updated", class: "tw:text-sm", value: render(UI::Time::Component.new(time: @bike_organization_note.updated_at, format: :localize_time_precise))) %>
  <% end %>

  <div>
    <%= render(Pages::Admin::Headers::Section::Component.new(title: "Body")) %>

    <p class="tw:mb-4"><%= @bike_organization_note.body %></p>
  </div>
</div>

<% versions = PaperTrail::Version.where(item_type: "BikeOrganizationNote", item_id: @bike_organization_note.id).order(created_at: :desc) %>

<% if versions.any? %>
  <div class="tw:mt-6">
    <%= render(Pages::Admin::Headers::Section::Component.new(title: "Paper Trail Versions")) %>

    <%= render "admin/paper_trail_versions/table", collection: versions, render_sortable: false %>
  </div>
<% end %>
