<% admin_search_form = capture do %>
  <%= form_with(url: admin_bug_reports_path, method: :get,
    html: {class: "twsearchrow"}) do |f| %>
    <%= hidden_field_tag :search_receiver, params[:search_receiver] %>
    <%= hidden_field_tag :search_user_status, params[:search_user_status] %>
    <%= hidden_field_tag :search_status, params[:search_status] %>

    <div class="tw:w-full tw:sm:w-72">
      <%= render UI::Forms::Combobox::Component.new(name: :search_tag, options: tag_combobox_options,
        multiselect_chip_src: tag_chips_admin_bug_reports_path,
        html_options: {value: @searched_tags.join(","), placeholder: "Tags"}) %>
    </div>

    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :search_email,
      html_options: {value: params[:search_email], placeholder: "Sender email", class: "tw:w-full tw:sm:w-72"}) %>

    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :search_pull_request,
      html_options: {value: params[:search_pull_request], placeholder: "PR #", class: "tw:w-full tw:sm:w-24"}) %>

    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :query,
      html_options: {value: params[:query], placeholder: "Search subject and body", class: "tw:w-full tw:sm:w-[32rem]"}) %>

    <%= render UI::Button::Component.new(text: "Search", color: :primary, type: "submit", name: "search") %>
  <% end %>
<% end %>

<% searched_terms = {"receiver" => @searched_receiver, "tags" => @searched_tags.join(", "), "sender email" => params[:search_email],
  "user" => params[:user_id], "PR" => params[:search_pull_request], "text" => params[:query]}
  .filter_map { |label, value| safe_join(["#{label}: ", render(UI::Code::Inline::Component.new(text: value))]) if value.present? } %>

<% count_detail = capture do %>
  &mdash; with <%= safe_join(searched_terms, ", ") %>
<% end if searched_terms.any? %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  admin_search_form:, count_detail:,
  table_view: render(Pages::Admin::BugReports::Table::Component.new(collection: @collection, searchable_tags:, sort_state:, render_sortable: true)),
  chart_collection: @render_chart && matching_bug_reports,
)) do |skeleton| %>
  <% skeleton.with_nav_item do %>
    <%= render(UI::Dropdown::Component.new(
      name: @searched_receiver.present? ? "To: #{BugReport.display_receiver(@searched_receiver)}" : "All receivers",
      button_size: :sm,
      active: @searched_receiver.present?
    )) do |dropdown|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All receivers", path: url_for(sortable_search_params.merge(search_receiver: nil)), match_params: {search_receiver: nil}) }
      dropdown.with_entry_divider
      searchable_receivers.each do |receiver|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: BugReport.display_receiver(receiver), path: url_for(sortable_search_params.merge(search_receiver: receiver)), match_params: {search_receiver: receiver}) }
      end
    end %>
  <% end %>

  <% skeleton.with_nav_item do %>
    <%= render(UI::Dropdown::Component.new(
      name: @searched_user_status.present? ? user_status_filters[@searched_user_status] : "All user status",
      button_size: :sm,
      active: @searched_user_status.present?
    )) do |dropdown|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All user status", path: url_for(sortable_search_params.merge(search_user_status: nil)), match_params: {search_user_status: nil}) }
      dropdown.with_entry_divider
      user_status_filters.each do |value, label|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: label, path: url_for(sortable_search_params.merge(search_user_status: value)), match_params: {search_user_status: value}) }
      end
    end %>
  <% end %>

  <% skeleton.with_nav_item do %>
    <%= render(UI::Dropdown::Component.new(
      name: status_filters[@searched_status],
      button_size: :sm,
      active: @searched_status != "investigate"
    )) do |dropdown|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: status_filters["investigate"], path: url_for(sortable_search_params.merge(search_status: "investigate")), match_params: {search_status: ["investigate", nil]}) }
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: status_filters["all"], path: url_for(sortable_search_params.merge(search_status: "all")), match_params: {search_status: "all"}) }
      dropdown.with_entry_divider
      status_only_filters.each do |value, label|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: label, path: url_for(sortable_search_params.merge(search_status: value)), match_params: {search_status: value}) }
      end
    end %>
  <% end %>
<% end %>
