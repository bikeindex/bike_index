<% render_sortable ||= false %>

<div class="full-screen-table">
  <table class="table table-striped table-bordered table-sm">
    <thead class="thead-light">
      <th class="table-cell-check">
        <button
          type="button"
          class="twlink tw:cursor-pointer tw:border-0 tw:bg-transparent tw:p-0"
          title="Toggle all checked"
          aria-label="Toggle all checked"
          data-action="click->table-multi-checkbox#toggleAll"
        >
          <%= check_mark %>
        </button>
      </th>

      <th><%= sortable "received_at", "Received", render_sortable: %></th>
      <th><%= sortable "email", "Sender", render_sortable: %></th>
      <th><%= sortable "receiver", "Receiver", render_sortable: %></th>
      <th>Subject</th>
      <th><%= sortable "status", "Status", render_sortable: %></th>
      <th>Tags</th>
      <th>Member</th>
      <th>Paid org</th>
      <th><%= sortable "github_pull_request", "PR", render_sortable: %></th>
    </thead>

    <tbody>
      <% collection.each do |bug_report| %>
        <tr>
          <td class="display-multi-check table-cell-check">
            <%= check_box_tag "bug_reports_selected[#{bug_report.id}]", bug_report.id, false, data: {"table-multi-checkbox-target" => "checkbox"} %>
          </td>

          <td>
            <%= link_to admin_bug_report_path(bug_report) do %>
              <%= render UI::Time::Component.new(time: bug_report.received_at || bug_report.created_at) %>
            <% end %>

            <% if display_dev_info? %>
              <code class="only-dev-visible small"><%= bug_report.id %></code>
            <% end %>
          </td>

          <td>
            <% if bug_report.user_id.present? %>
              <%= render Admin::UserCell::Component.new(user: bug_report.user, user_id: bug_report.user_id) %>
            <% else %>
              <span class="tw:block tw:xl:inline"><%= bug_report.from_name %></span>
              <%= content_tag(:code, bug_report.email, class: "small") %>
            <% end %>

            <%= link_to search_emoji, url_for(sortable_search_params.merge(search_email: bug_report.email)), class: "display-sortable-link small" %>
          </td>

          <td>
            <% if bug_report.receiver.present? %>
              <small>
                <%= BugReport.display_receiver(bug_report.receiver) %>
              </small>
              <%= link_to search_emoji, url_for(sortable_search_params.merge(search_receiver: bug_report.receiver)), class: "display-sortable-link small" %>
            <% end %>
          </td>

          <td>
            <%= bug_report.display_subject %>

            <%= render(UI::Tooltip::Component.new) do |tooltip| %>
              <% tooltip.with_body do %>
                <div class="tw:w-96 tw:text-left">
                  <%= content_tag(:strong, bug_report.display_subject) %>

                  <%# truncated because the tooltip can't be scrolled - it has no pointer events %>
                  <%= content_tag(:div, bug_report.body_stripped.truncate(1000), class: "tw:mt-1 tw:whitespace-pre-wrap") %>
                </div>
              <% end %>
            <% end %>
          </td>

          <td><%= BugReport.status_display(bug_report.status) %></td>

          <td>
            <% bug_report.tags.each do |tag| %>
              <code class="tw:text-xs tw:text-black"><%= tag %></code>
            <% end %>
          </td>

          <td><%= check_mark if bug_report.is_member %></td>

          <td>
            <%= check_mark if bug_report.is_paid_organization %>

            <% if bug_report.is_paid_organization_staff %>
              <small>staff</small>
            <% end %>
          </td>

          <td>
            <% if bug_report.github_pull_request.present? %>
              <%= link_to bug_report.github_pull_request_url do %>
                #<%= bug_report.github_pull_request %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
