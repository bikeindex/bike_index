
= form_for [:admin, @manufacturer] do |f|
  = render(UI::Alerts::ObjectError::Component.new(object: @manufacturer))

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :name)) do |group|
    - if @manufacturer.id.present?
      - group.with_helper_text do
        %span.less-strong Secondary name (name in parentheses):
        = @manufacturer.secondary_name.presence

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :website))

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :twitter_name, label_text: "Twitter handle"))

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :open_year))

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :close_year))

  %div{class: "tw:mb-4"}
    = render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :frame_maker, label: "Frame maker"))
    = render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :motorized_only, label: "Motorized only"))

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :logo)) do
    = render(UI::Forms::Files::Upload::Component.new(form_builder: f, attribute: :logo, accept: ImageUploader.permitted_extensions))
    = f.hidden_field :logo_cache

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :description, kind: :text_area, html_options: {rows: 7}))

  = render(UI::Button::Component.new(text: "Submit", color: :primary, type: "submit", html_class: "tw:mb-4"))
