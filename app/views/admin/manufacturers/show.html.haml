.admin-subnav
  .col-md-12
    %h1
      = @manufacturer.name
      %small.less-strong
        %small simple:

        = @manufacturer.short_name

.row
  .col-6
    = render(UI::TableList::Component.new) do |list|
      - list.with_row(label: "ID", value: @manufacturer.id)
      - list.with_row(label: "Created", value: render(UI::Time::Component.new(time: @manufacturer.created_at, format: :localize_time_precise)))
      - if display_dev_info?
        - list.with_row(label: "Updated", class: "only-dev-visible", value: render(UI::Time::Component.new(time: @manufacturer.updated_at, format: :localize_time_precise)))
      - list.with_row(label: "Slug") do
        = @manufacturer.slug
        %small
          %span.less-strong.ml-1 secondary:
          = @manufacturer.secondary_slug
      - list.with_row(label: "Frame Maker?", value: (check_mark if @manufacturer.frame_maker))
      - list.with_row(label: "Motorized only?", value: (check_mark if @manufacturer.motorized_only))
      - list.with_row(label: "Bikes") do
        = number_display(@manufacturer.bikes.count)
        %a{ href: admin_bikes_path(search_manufacturer: @manufacturer.slug) }
          view
      - list.with_row(label: "Components", value: @manufacturer.components.count)
  .col-6
    = render(UI::TableList::Component.new) do |list|
      - if display_dev_info?
        - list.with_row(label: "Autocomplete priority", class: "only-dev-visible", value: @manufacturer.priority)
      - list.with_row(label: "Official Org") do
        - if @manufacturer.official_organization.present?
          = link_to @manufacturer.official_organization.name, admin_organization_path(@manufacturer.official_organization.to_param)
      - list.with_row(label: "Open Year", value: @manufacturer.open_year)
      - list.with_row(label: "Close Year", value: @manufacturer.close_year)
      - list.with_row(label: "Website") do
        - if @manufacturer.website.present?
          = link_to @manufacturer.website, @manufacturer.website
      - list.with_row(label: "Twitter") do
        - if @manufacturer.twitter_name.present?
          = link_to "#{@manufacturer.twitter_name}", "https://twitter.com/#{@manufacturer.twitter_name}"
      - list.with_row(label: "Description", value: @manufacturer.description)
      - list.with_row(label: "Logo", value: link_to(image_tag(@manufacturer.logo.url(:thumb)), @manufacturer.logo_url))
  .col-6
    = link_to "Edit", edit_admin_manufacturer_url(@manufacturer), class: "btn btn-success"
    = render(UI::ButtonLink::Component.new(text: "Delete", href: admin_manufacturer_url(@manufacturer), method: :delete, color: :error, confirm: "Are you sure?"))
