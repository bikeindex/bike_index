<% count_detail = capture do %>
  &mdash; <%= number_display(Manufacturer.with_websites.count) %> with
  <%= link_to "websites", url_for(sortable_search_params.merge(search_with_websites: !@with_websites)), class: @with_websites ? "twlink active" : "twlink" %>,
  <%= number_display(Manufacturer.with_logos.count) %> with
  <%= link_to "logos", url_for(sortable_search_params.merge(search_with_logos: !@with_logos)), class: @with_logos ? "twlink active" : "twlink" %>.
<% end if request.query_parameters.blank? %>

<% table_view = capture do %>
  <%= render partial: "/admin/manufacturers/table", locals: {collection: @manufacturers, render_sortable: true} %>

  <%= form_with(url: import_admin_manufacturers_path, multipart: true) do |form| %>
    <%= render(UI::Forms::Group::Component.new(form_builder: form, attribute: :file, label_text: "Upload CSV of Manufacturers list")) do %>
      <%= render(UI::Forms::Files::Upload::Component.new(form_builder: form, attribute: :file)) %>
    <% end %>

    <div class="tw:mb-4 tw:flex tw:justify-end">
      <%= render(UI::Button::Component.new(text: "Import CSV of Manufacturers", color: :primary, type: "submit")) %>
    </div>
  <% end %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @manufacturers,
  viewing: "Manufacturers",
  table_view:,
  count_detail:,
  skip_charting: true,
)) do |skeleton| %>
  <% skeleton.with_nav_item do %>
    <%= render(UI::ButtonLink::Component.new(text: "New Manufacturer", href: new_admin_manufacturer_url, color: :primary, size: :sm)) %>
  <% end %>
<% end %>
