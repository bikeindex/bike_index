<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "name") do |manufacturer| %>
    <%= link_to manufacturer.name, admin_manufacturer_url(manufacturer), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "frame_maker", label: "frame", classes: "tw:text-center") do |manufacturer| %>
    <%= check_mark if manufacturer.frame_maker %>
  <% end %>

  <% table.column(sortable: "motorized_only", label: "motorized", classes: "tw:text-center") do |manufacturer| %>
    <%= check_mark if manufacturer.motorized_only %>
  <% end %>

  <% table.column(label: "Website") do |manufacturer| %>
    <% if manufacturer.website %>
      <%= link_to "Company website", manufacturer.website, class: "twlink" %>
    <% end %>
  <% end %>

  <% table.column(sortable: "created_at") do |manufacturer| %>
    <%= render UI::Time::Component.new(time: manufacturer.created_at) %>
  <% end %>

  <% if display_dev_info? %>
    <% table.column(sortable: "priority", classes: "only-dev-visible", header_classes: "tw:text-xs") do |manufacturer| %>
      <%= number_display(manufacturer.priority) %>
    <% end %>
  <% end %>
<% end %>
