<div class="tw:mx-auto tw:max-w-3xl tw:py-4">
  <%= render Pages::Admin::RegistrationSequence::Header::Component.new(registration_sequence: @registration_sequence, mode: :view) %>

  <h2 class="uncap tw:mb-3 tw:text-xl tw:font-normal tw:text-gray-500">
    <%= number_display(@registration_sequence.registration_sequence_pages.size) %>
    <%= "page".pluralize(@registration_sequence.registration_sequence_pages.size) %>
  </h2>

  <%= render Pages::Org::RegistrationSequence::PageList::Component.new(registration_sequence: @registration_sequence, admin: true, editable: false) %>

  <%= render Pages::Admin::RegistrationSequence::DiscardDraft::Component.new(registration_sequence: @registration_sequence) %>
</div>
