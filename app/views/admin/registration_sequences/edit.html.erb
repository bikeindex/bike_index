<div class="tw:mx-auto tw:max-w-3xl tw:py-4">
  <p class="tw:mb-4">
    <%= link_to "← All registration sequences", admin_registration_sequences_path, class: "twlink tw:text-sm" %>

    <% if @registration_sequence.organization.present? %>
      ·
      <%= link_to @registration_sequence.organization.short_name, admin_organization_path(@registration_sequence.organization.to_param), class: "twlink tw:text-sm" %>
    <% end %>
  </p>

  <%= render Org::RegistrationSequence::Edit::Component.new(registration_sequence: @registration_sequence, admin: true) %>
</div>
