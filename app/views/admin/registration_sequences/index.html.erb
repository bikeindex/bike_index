<% nav_header_list_items = capture do %>
  <li class="nav-item tw:text-sm">
    <%= render(UI::Dropdown::Component.new(
      name: @status.present? ? "#{@status.titleize} only" : "All statuses",
      button_size: :sm,
      active: @status.present?
    )) do |dropdown|
      dropdown.with_entry_item(active: @status.blank?) { link_to "All statuses", url_for(sortable_search_params.merge(search_status: nil)) }
      dropdown.with_entry_divider
      searchable_statuses.each do |kind|
        dropdown.with_entry_item(active: @status == kind) { link_to "#{kind.titleize} only", url_for(sortable_search_params.merge(search_status: kind)) }
      end
    end %>
  </li>

  <li class="nav-item tw:text-sm">
    <% if @template.present? %>
      <%= link_to "#{@template.display_name} sequence", RegistrationSequencePaths.sequence(@template, admin: true), class: "nav-link" %>
    <% else %>
      <%# Nothing for organizations to clone yet - the first template is drafted here %>
      <%= render UI::ButtonLink::Component.new(text: "Create template", href: RegistrationSequencePaths.create_draft(nil), method: :post, color: :primary, size: :sm) %>
    <% end %>
  </li>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  nav_header_list_items:, chart_collection: @render_chart && matching_registration_sequences,
)) %>
