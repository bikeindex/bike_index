<% nav_header_list_items = capture do %>
  <li class="nav-item tw:text-sm">
    <%= render(UI::Dropdown::Component.new(
      name: @status.present? ? "#{@status.titleize} only" : "All statuses",
      button_size: :sm,
      active: @status.present?
    )) do |dropdown|
      dropdown.with_entry_item(active: @status.blank?) { link_to "All statuses", url_for(sortable_search_params.merge(search_status: nil)) }
      dropdown.with_entry_divider
      searchable_statuses.each do |status|
        dropdown.with_entry_item(active: @status == status) { link_to "#{status.titleize} only", url_for(sortable_search_params.merge(search_status: status)) }
      end
    end %>
  </li>

  <li class="nav-item tw:text-sm">
    <%= render(UI::Dropdown::Component.new(
      name: @kind.present? ? "#{RegistrationSequence.kind_display(@kind)} only" : "All kinds",
      button_size: :sm,
      active: @kind.present?
    )) do |dropdown|
      dropdown.with_entry_item(active: @kind.blank?) { link_to "All kinds", url_for(sortable_search_params.merge(search_kind: nil)) }
      dropdown.with_entry_divider
      searchable_kinds.each do |kind|
        dropdown.with_entry_item(active: @kind == kind) { link_to "#{RegistrationSequence.kind_display(kind)} only", url_for(sortable_search_params.merge(search_kind: kind)) }
      end
    end %>
  </li>

  <%# One template per kind - organizations clone whichever matches what they're registering %>
  <% @templates.each do |kind, template| %>
    <li class="nav-item tw:text-sm">
      <% if template.present? %>
        <%= link_to "#{template.display_name} sequence", RegistrationSequencePaths.sequence(template, admin: true), class: "nav-link" %>
      <% else %>
        <%# Nothing for organizations to clone yet - the first template is drafted here %>
        <%= render UI::ButtonLink::Component.new(text: "Create #{RegistrationSequence.kind_display(kind)} template", href: RegistrationSequencePaths.create_draft(nil, kind:, admin: true), method: :post, color: :primary, size: :sm) %>
      <% end %>
    </li>
  <% end %>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(nav_header_list_items:, chart_collection: @render_chart && matching_registration_sequences)) %>
