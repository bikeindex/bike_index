<% if current_organization.present? %>
  <%= render(Pages::Admin::Organizations::Tabs::Component.new(organization: current_organization, active: :registration_sequences, display_dev_info: display_dev_info?)) %>
<% end %>

<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(
      name: @status.present? ? "#{@status.titleize} only" : "All statuses",
      button_size: :sm,
      active: @status.present?
    )) do |dropdown|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All statuses", path: url_for(sortable_search_params.merge(search_status: nil)), match_params: {search_status: nil}) }
      dropdown.with_entry_divider
      searchable_statuses.each do |kind|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{kind.titleize} only", path: url_for(sortable_search_params.merge(search_status: kind)), match_params: {search_status: kind}) }
      end
    end %>
  </li>

  <li>
    <% if @template.present? %>
      <%= render(UI::ButtonLink::Component.new(text: "#{@template.display_name} sequence", href: RegistrationSequencePaths.sequence(@template, admin: true), size: :sm)) %>
    <% else %>
      <%# Nothing for organizations to clone yet - the first template is drafted here %>
      <%= render UI::ButtonLink::Component.new(text: "Create template", href: RegistrationSequencePaths.create_draft(nil), method: :post, color: :primary, size: :sm) %>
    <% end %>
  </li>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  nav_header_list_items:, chart_collection: @render_chart && matching_registration_sequences,
  table_view: render(Pages::Admin::RegistrationSequence::Table::Component.new(registration_sequences: @collection, sort_state:, render_sortable: true)),
)) %>
