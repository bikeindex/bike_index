<div class="tw:mx-auto tw:max-w-3xl tw:py-4">
  <%= render Pages::Admin::RegistrationSequence::Header::Component.new(registration_sequence: @registration_sequence, mode: :preview) %>

  <%# pt cancels the flow shell's negative top margin; padding doesn't collapse %>
  <div class="tw:pt-(--nav-gap)">
    <%= render Pages::Org::RegistrationSequence::Preview::Component.new(registration_sequence: @registration_sequence, index: @preview_pagy.page - 1, admin: true) %>
  </div>

  <%# Below the gray. mt-24 clears the flow shell's -mb-18 pull-up. %>
  <div class="tw:mt-24">
    <%= render UI::Pagination::Component.new(pagy: @preview_pagy, page_params: {id: @registration_sequence.id}) %>
  </div>

  <%= render Pages::Admin::RegistrationSequence::DiscardDraft::Component.new(registration_sequence: @registration_sequence) %>
</div>
