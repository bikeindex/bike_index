<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::ButtonLink::Component.new(text: "New batch", href: new_admin_bike_sticker_path, color: :primary, size: :sm)) %>
  </li>

  <li>
    <small>
      <%= render(UI::ButtonLink::Component.new(text: "reassign", href: reassign_admin_bike_stickers_path, color: :link, html_class: "twless-strong")) %>
    </small>
  </li>
<% end %>

<% admin_search_form = capture do %>
  <div class="tw:mt-6">
    <% unless @bike_sticker_batch.present? %>
      <h5>
        <%= number_display(@bike_sticker_batches.count) %>

        <% if @matching_batches %>
          matching <%= "batch".pluralize(@bike_sticker_batches.count) %>
        <% elsif @all_batches %>
          batches
          <small class="twless-strong">- show <%= link_to "only most recent", url_for(sortable_search_params.merge(search_all_batches: false)) %></small>
        <% else %>
          most recent batches
          <small class="twless-strong">- <%= number_display(BikeStickerBatch.count) %> <%= link_to "total batches", url_for(sortable_search_params.merge(search_all_batches: true)), class: "twless-strong" %></small>
        <% end %>
      </h5>
    <% end %>

    <%= render partial: "batches_table", locals: {bike_sticker_batches: @bike_sticker_batches, render_sortable: false, matching_count: @matching_batches} %>
  </div>

  <% if @bike_sticker_batch.present? %>
    <% if Binxtils::InputNormalizer.boolean(params[:search_show_problems]) %>
      <div class="tw:my-6">
        <h4>
          Showing Problem stickers
          <small><%= link_to "hide", url_for(sortable_search_params.merge(search_show_problems: false)), class: "twless-strong" %></small>
        </h4>

        <% duplicated = @bike_sticker_batch.duplicated_integers %>
        <span class="d-block strong">Duplicates:</span>

        <% if duplicated.any? %>
          <ul>
            <% duplicated.each do |int| %>
              <li class="small"><code><%= int %></code></li>
            <% end %>
          </ul>
        <% else %>
          <em class="twless-strong">None</em>
        <% end %>

        <span class="d-block strong">Non-sequential stickers:</span>

        <% if @bike_sticker_batch.non_sequential_integers.any? %>
          <ul>
            <% @bike_sticker_batch.non_sequential_integers.each do |arr| %>
              <li class="small"><%= arr[0] %> &gt; <%= arr[1] %></li>
            <% end %>
          </ul>
        <% else %>
          <em class="twless-strong">none</em>
        <% end %>
      </div>
      <hr>
    <% else %>
      <div class="text-center tw:pt-6">
        <%= link_to "Show problem stickers for Batch ##{@bike_sticker_batch.id}", url_for(sortable_search_params.merge(search_show_problems: true)), class: "btn btn-outline-warning btn-sm" %>

        <em class="twless-strong tw:ml-2">
          (duplicates and non-sequential stickers)
        </em>
      </div>
    <% end %>
  <% end %>

  <div class="twwiderow tw:mt-6">
    <div>
      <p>
        <%= number_display(matching_bike_stickers.size) %> matching
        <%= "sticker".pluralize(matching_bike_stickers.size) %>
        <% unless @search_claimed %>
          <span class="twless-strong">
            <%= number_with_delimiter(matching_bike_stickers.claimed.count) %>
            claimed
          </span>
        <% end %>
        <% unless @period == "all" %>
          were
          <em><%= UI::PeriodSelect::Component.column_label(@time_range_column) %> <%= render(UI::TimeRange::Component.new(time_range: @time_range, period: @period)) %></em>
        <% end %>
        <% if sortable_search_params? %>
          - <em><%= link_to "view all stickers", url_for %></em>
        <% end %>
      </p>

      <% if @bike_sticker_batch.present? %>
        <p>
          <strong>Viewing Just Batch #<%= @bike_sticker_batch.id %></strong>

          <small>
            <%= link_to "view all batches", url_for(sortable_search_params.except(:search_bike_sticker_batch_id)) %>
          </small>
        </p>
      <% end %>
    </div>

    <div class="tw:mt-2">
      <%= form_with(url: admin_bike_stickers_path, method: :get, html: {class: "twsearchrow"}) do |form| %>
        <%= render partial: "/shared/hidden_search_fields" %>
        <%= hidden_field_tag :search_bike_sticker_batch_id, params[:search_bike_sticker_batch_id] %>

        <%= render(UI::Forms::Checkbox::Component.new(name: :search_claimed, value: true, checked: @search_claimed, label: "Claimed only")) %>

        <%= render(UI::Forms::Input::Component.new(form_builder: form, attribute: :search_query,
          html_options: {value: params[:search_query], placeholder: "search sticker"})) %>

        <%= render(UI::Button::Component.new(text: "Search", color: :primary, type: "submit", name: "search")) %>
      <% end %>
    </div>
  </div>
<% end %>

<% table_view = capture do %>
  <%= render partial: "table", locals: {bike_stickers: @bike_stickers, render_sortable: true} %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @bike_stickers,
  viewing: "Stickers",
  chart_collection: @render_chart && matching_bike_stickers,
  nav_header_list_items:,
  admin_search_form:,
  table_view:,
)) %>
