= render(Pages::Admin::Headers::Nav::Component.new(title: "New Bike Sticker Batch"))

.twwiderow
  = render(UI::Card::Component.new(full_bleed: true, additional_classes: "tw:col-span-full")) do
    = render(UI::Header::Component.new(text: "Examples", tag: :h2))
    %p{class: "tw:mb-4"} Here are the values for a few example sticker batches.
    - examples = [{id: 9, name: "#9 (EPS 2)", stickers: ["ED 010 133", "ED 061 132"], prefix: "ED", initial: 10133, count: 51000, length: 6},
      {id: 21, name: "#21 (3rd internal)", stickers: ["A 250 0", "A 309 8"], prefix: "A", initial: 2500, count: 599, length: 4}]
    = render(UI::Table::Component.new(records: examples)) do |table|
      - table.column(label: "Batch") do |batch|
        = link_to batch[:name], admin_bike_stickers_path(search_bike_sticker_batch_id: batch[:id]), class: "twlink"
      - table.column(label: "First & Last Sticker") do |batch|
        - batch[:stickers].each do |sticker|
          %strong{class: "tw:block tw:text-sm"}= sticker
      - table.column(label: tag.em("Code Prefix")) do |batch|
        = render(UI::Code::Inline::Component.new(text: batch[:prefix]))
      - table.column(label: tag.em("Initial Sticker number")) do |batch|
        = render(UI::Code::Inline::Component.new(text: batch[:initial]))
      - table.column(label: tag.em("Number of stickers to create")) do |batch|
        = render(UI::Code::Inline::Component.new(text: batch[:count]))
      - table.column(label: tag.em("Code Number Length")) do |batch|
        = render(UI::Code::Inline::Component.new(text: batch[:length]))

= form_for [:admin, @bike_sticker_batch], url: {action: "create", controller: "bike_stickers"} do |f|
  = render(UI::Alerts::ObjectError::Component.new(name: "Sticker Batch", object: @bike_sticker_batch))

  %div{class: "tw:mt-6 tw:grid tw:gap-x-8 tw:md:grid-cols-2 tw:lg:grid-cols-4"}
    %div
      = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :organization_id, label_text: BikeStickerBatch.human_attribute_name(:organization_id), required: true)) do
        = render UI::Forms::Combobox::Component.new(name: :organization_id, options: @organizations.pluck(:name, :id), include_blank: true, html_options: {form: f, placeholder: "Choose organization", required: true})
    %div{class: "tw:lg:col-span-3"}
      = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :notes))
  .twfieldrow{class: "tw:mt-2 tw:items-end"}
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :prefix, label_text: "Code letter prefix", required: true))
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :initial_code_integer, kind: :number_field, label_text: "Initial sticker number", required: true))
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :code_number_length, kind: :number_field, label_text: "Code Number Length")) do |group|
      - group.with_label_note { "Leave blank unless you want extra zeros" }
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :stickers_to_create_count, kind: :number_field, label_text: "Number of stickers to create", required: true))
  %div{class: "tw:mt-2"}
    = render(UI::Button::Component.new(text: "Create", color: :primary, type: "submit"))
