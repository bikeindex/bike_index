<%# locals: (collection:, render_sortable: true) %>

<% if collection.present? %>
  <%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
    <% table.column(sortable: "created_at") do |paint| %>
      <%= link_to admin_paint_url(paint), class: "twlink" do %>
        <%= render UI::Time::Component.new(time: paint.created_at) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |paint| %>
      <%= render UI::Time::Component.new(time: paint.updated_at) %>
    <% end %>

    <% table.column(sortable: "manufacturer") do |paint| %>
      <% if paint.manufacturer_id.present? %>
        <%= paint.manufacturer.name %>
      <% end %>
    <% end %>

    <% table.column(sortable: "bikes_count", label: "Bikes") do |paint| %>
      <%= paint.bikes_count %>
    <% end %>

    <% table.column(label: "Description") do |paint| %>
      <%= paint.name %>
    <% end %>

    <% table.column(label: "Color") do |paint| %>
      <ul class="small">
        <% if paint.color_id.present? %>
          <li><%= paint.color.name %></li>
        <% end %>

        <% if paint.secondary_color_id.present? %>
          <li><%= paint.secondary_color.name %></li>
        <% end %>

        <% if paint.tertiary_color_id.present? %>
          <li><%= paint.tertiary_color.name %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% else %>
  <h1 class="mb-4">No paints found!</h1>
<% end %>
