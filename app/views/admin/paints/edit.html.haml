.admin-subnav
  .col-lg-6.col-sm-12
    %h1
      Edit paint

  - if @paint.id.present?
    .col-md-6.offset-md-3.mt-2
      %table.table-list
        %tbody
          %tr
            %td
              Created
            %td
              %span.localizeTime.preciseTime
                = l @paint.created_at, format: :convert_time
          %tr
            %td
              Updated
            %td
              %span.localizeTime.preciseTime
                = l @paint.updated_at, format: :convert_time
          %tr
            %td
              Manufacturer
            %td
              = @paint.manufacturer&.name
          %tr
            %td
              Bike cache count
            %td
              = @paint.bikes_count


= form_for [:admin, @paint] do |f|
  = render(UI::Alerts::ObjectError::Component.new(object: @paint))

  .row
    .col-lg-3.col-md-6.col-sm-12
      = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :name, html_options: {disabled: true}))
    - %i[color_id secondary_color_id tertiary_color_id].each do |attribute|
      .col-lg-3.col-md-6.col-sm-12
        = render(UI::Forms::Group::Component.new(form_builder: f, attribute:)) do
          = render(UI::Forms::Select::Component.new(form_builder: f, attribute:, option_tags: Color.pluck(:name, :id), options: {prompt: "Choose color"}))

  = render(UI::Button::Component.new(text: "Update the paint", color: :primary, type: "submit"))
  .alert.alert-info.mt-2
    %p
      %strong You can't edit the name.
      Otherwise future bikes posted with this paint won't be able to find this paint, and will recreate it.

%hr.mt-2

- if @bikes.present?
  %p
    = number_with_delimiter(@bikes_count)
    Bikes with this paint

  = render(Atoms::Admin::PaginationWithCount::Component.new(collection: @bikes, index: admin_index_state))

  = render Pages::Admin::Bikes::Table::Component.new(bikes: @bikes, sort_state:)

- else
  = render(UI::ButtonLink::Component.new(text: "Delete!", href: admin_paint_url(@paint), method: :delete, color: :error))
