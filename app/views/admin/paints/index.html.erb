<% count_detail = capture do %>
  &mdash;
  <%= number_display(matching_paints.where("created_at >= ?", Time.current.beginning_of_day).count) %>
  today, <%= number_display(Paint.unlinked.count) %> unlinked
<% end if request.query_parameters.blank? %>

<% admin_search_form = capture do %>
  <%= form_with(url: admin_paints_path, method: :get, html: {class: "twsearchrow"}) do |form| %>
    <%= render partial: "/shared/hidden_search_fields" %>

    <%= render(UI::Forms::Input::Component.new(form_builder: form, attribute: :search_name,
      html_options: {value: params[:search_name], placeholder: "Search paints by name"})) %>

    <%= render(UI::Button::Component.new(text: "Search", color: :primary, type: "submit", name: "search")) %>
  <% end %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @paints,
  viewing: "Paints",
  chart_collection: @render_chart && matching_paints,
  admin_search_form:,
  count_detail:,
)) do |skeleton| %>
  <% skeleton.with_nav_item { render(UI::ButtonLink::Component.new(text: "unlinked", href: admin_paints_path(sortable_search_params.merge(search_unlinked: !@search_unlinked)), size: :sm, active: @search_unlinked)) } %>
<% end %>
