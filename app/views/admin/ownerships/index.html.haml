- nav_header_list_items = capture_haml do
  %li
    = render(UI::Dropdown::Component.new(name: @search_organization_kind.blank? ? "with and without organization" : @search_organization_kind.humanize, button_size: :sm, active: @search_organization_kind.present?)) do |dropdown|
      - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "with and without organizations", path: url_for(sortable_search_params.merge(search_organization_kind: nil)), match_params: {search_organization_kind: UI::ActiveLink::Component::BLANK}) }
      - organization_kind_options.each do |search_organization_kind|
        - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: search_organization_kind.humanize, path: url_for(sortable_search_params.merge(search_organization_kind:)), match_params: {search_organization_kind:}) }

  %li
    - origin_name = {"all" => "All origins", "only_initial" => "Only initial"}[@search_origin]
    - origin_name ||= Ownership.origin_humanized(@search_origin).titleize
    = render(UI::Dropdown::Component.new(name: origin_name, button_size: :sm, active: @search_origin != "all")) do |dropdown|
      - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All origins", path: url_for(sortable_search_params.merge(search_origin: nil)), match_params: {search_origin: UI::ActiveLink::Component::BLANK}) }
      - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Only initial", path: url_for(sortable_search_params.merge(search_origin: "only_initial")), match_params: {search_origin: "only_initial"}) }
      - dropdown.with_entry_divider
      - Ownership.origins.each do |origin|
        - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: Ownership.origin_humanized(origin).titleize, path: url_for(sortable_search_params.merge(search_origin: origin)), match_params: {search_origin: origin}) }

- table_view = render partial: "/admin/ownerships/table", locals: {ownerships: @ownerships, render_sortable: true}

= render(Admin::IndexSkeleton::Component.new(index: admin_index_state, viewing: controller_name.humanize, collection: @ownerships, nav_header_list_items:, table_view:, chart_collection: @render_chart && matching_ownerships))
