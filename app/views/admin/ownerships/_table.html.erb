<%# locals: (ownerships:, render_sortable: false, skip_bike: false) %>

<% render_dev_info = display_dev_info? %>

<div class="tw:mt-4">
  <%= render(UI::Table::Component.new(records: ownerships, render_sortable:, sort_state:)) do |table| %>
    <% table.column(sortable: "created_at", lower_right: ->(ownership) { content_tag(:code, ownership.id, class: "tw:hidden tw:md:inline") }) do |ownership| %>
      <%= link_to edit_admin_ownership_url(ownership.id), class: "twlink" do %>
        <%= render UI::Time::Component.new(time: ownership.created_at) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |ownership| %>
      <%= render UI::Time::Component.new(time: ownership.updated_at) %>
    <% end %>

    <% unless skip_bike %>
      <% table.column(label: "Bike", header_classes: "tw:font-normal", classes: "tw:text-xs") do |ownership| %>
        <% if ownership.bike.present? %>
          <%= link_to helpers.bike_title_html(ownership.bike), admin_bike_path(ownership.bike), class: "twlink" %>
        <% else %>
          <span class="text-danger">Missing Bike #<%= ownership.bike_id %></span>
        <% end %>
      <% end %>
    <% end %>

    <% table.column(label: "Creator", header_classes: "tw:font-normal") do |ownership| %>
      <% creator = ownership.creator %>

      <% if creator.blank? %>
        <em class="text-warning">user deleted</em>
        <% if render_dev_info %>
          <span class="only-dev-visible">#<%= ownership.creator_id %></span>
        <% end %>
      <% else %>
        <%= creator.display_name %>
      <% end %>
    <% end %>

    <% table.column(sortable: "origin") do |ownership| %>
      <small><%= render Atoms::Org::OriginDisplay::Component.new(ownership:) %></small>
    <% end %>

    <% table.column(sortable: "owner_email") do |ownership| %>
      <%= ownership.owner_email %>
    <% end %>

    <% if render_dev_info %>
      <% table.column(label: "send email?", classes: "only-dev-visible", header_classes: "tw:font-normal tw:text-xs") do |ownership| %>
        <%= check_mark if ownership.send_email %>
      <% end %>
    <% end %>

    <% table.column(sortable: "organization_id") do |ownership| %>
      <%= ownership.organization&.name %>
    <% end %>

    <% table.column(label: "Current?", header_classes: "tw:font-normal tw:text-xs", classes: "tw:text-center") do |ownership| %>
      <%= check_mark if ownership.current %>
    <% end %>

    <% table.column(label: "Claimed", header_classes: "tw:font-normal tw:text-xs") do |ownership| %>
      <% if ownership.claimed %>
        <% if ownership.claimed_at.present? %>
          <%= render UI::Time::Component.new(time: ownership.claimed_at) %>
        <% else %>
          <small class="less-strong">unknown time</small>
        <% end %>
      <% end %>
    <% end %>

    <% table.column(label: "User hidden", header_classes: "tw:font-normal tw:text-xs", classes: "tw:hidden tw:md:table-cell tw:text-center") do |ownership| %>
      <%= check_mark if ownership.user_hidden %>
    <% end %>
  <% end %>
</div>
