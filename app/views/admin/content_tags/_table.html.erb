<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", label: "Added", lower_right: ->(record) { content_tag(:span, record.id, class: "only-dev-visible") }) do |content_tag| %>
    <%= render UI::Time::Component.new(time: content_tag.created_at) %>
  <% end %>

  <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |content_tag| %>
    <%= render UI::Time::Component.new(time: content_tag.updated_at) %>
  <% end %>

  <% table.column(sortable: "name") do |content_tag| %>
    <%= link_to content_tag.name, edit_admin_content_tag_url(content_tag), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "priority") do |content_tag| %>
    <small><%= content_tag.priority %></small>
  <% end %>

  <% table.column(label: "Blogs", header_classes: "tw:font-normal") do |content_tag| %>
    <%= number_display(content_tag.blogs.count) %>
  <% end %>
<% end %>
