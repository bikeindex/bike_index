= form_for [:admin, @content_tag] do |f|
  = render(UI::Alerts::ObjectError::Component.new(object: @content_tag))

  .twfieldrow
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :name))
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :description, kind: :text_area))
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :priority, kind: :number_field))

  = render(UI::Button::Component.new(text: @content_tag.id.present? ? "Update" : "Create", color: :primary, type: "submit"))
