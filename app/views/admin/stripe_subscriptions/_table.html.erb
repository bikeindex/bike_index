<%# locals: (collection:, render_sortable: false) %>

<div
  data-controller="update-cached-sortable-links"
  data-update-cached-sortable-links-base-url-value="<%= url_for(sort_state.search_params) %>"
>
  <%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:,
        cache_key: cache_fragment_name(["admin_stripe_subscriptions", render_sortable]),
        cache_records: ->(stripe_subscription) { [stripe_subscription.stripe_price, *stripe_subscription.payments] })) do |table| %>
    <% table.column(sortable: "created_at", lower_right: ->(stripe_subscription) { stripe_subscription.id }) do |stripe_subscription| %>
      <% if stripe_subscription.membership_id.present? %>
        <%= link_to render(UI::Time::Component.new(time: stripe_subscription.created_at)), admin_membership_path(stripe_subscription.membership_id), class: "twlink" %>
      <% else %>
        <%= render UI::Time::Component.new(time: stripe_subscription.created_at) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "stripe_price_stripe_id", label: "Stripe Price") do |stripe_subscription| %>
      <% stripe_price = stripe_subscription.stripe_price %>

      <% if stripe_price.present? %>
        <%= stripe_price.membership_level %>
        <span class="less-strong"><%= stripe_price.interval %></span>
        <% unless stripe_price.currency_enum == "usd" %>
          <small><%= stripe_price.currency_name %></small>
        <% end %>
      <% end %>
    <% end %>

    <% table.column(sortable: "start_at") do |stripe_subscription| %>
      <%= render UI::Time::Component.new(time: stripe_subscription.start_at) %>
    <% end %>

    <% table.column(sortable: "end_at") do |stripe_subscription| %>
      <%= render UI::Time::Component.new(time: stripe_subscription.end_at) %>
    <% end %>

    <% table.column(sortable: "user_id") do |stripe_subscription| %>
      <% if stripe_subscription.user_id.present? %>
        <%= render Atoms::Admin::TableCells::User::Component.new(sort_state:, user: stripe_subscription.user, render_search: true) %>
      <% else %>
        <%= stripe_subscription.email %>
      <% end %>
    <% end %>

    <% table.column(sortable: "stripe_status") do |stripe_subscription| %>
      <%= stripe_subscription.stripe_status %>
    <% end %>

    <% table.column(label: "Referral Source") do |stripe_subscription| %>
      <%= stripe_subscription.referral_source %>
    <% end %>

    <% table.column(label: "Stripe") do |stripe_subscription| %>
      <% if stripe_subscription.stripe_id.present? %>
        <%= link_to stripe_subscription.stripe_id.truncate(20), stripe_subscription.stripe_admin_url, title: stripe_subscription.stripe_id, class: "twlink" %>
      <% end %>
    <% end %>

    <% table.column(label: "Payments") do |stripe_subscription| %>
      <% payment_count = stripe_subscription.payments.count %>
      <small><%= number_display(payment_count) %></small>

      <% stripe_subscription.payments.order(id: :desc).limit(1).pluck(:id, :stripe_status).each do |id, stripe_status| %>
        <%= link_to admin_payment_path(id), class: "twlink small" do %>
          <% if stripe_status.blank? || payment_count > 1 %>
            last
          <% end %>

          <% if stripe_status.present? %>
            <code><%= stripe_status %></code>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
