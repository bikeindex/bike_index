= render(Pages::Admin::Headers::Nav::Component.new(title: "Edit #{@organization_feature.name}"))

- if @organization_feature.locked?
  = render(UI::Alerts::Base::Component.new(kind: :error, margin_classes: "tw:my-10")) do
    %p
      This Feature is used to enable and disable functionality for organizations in Bike Index
    %p
      If you need to update it, talk to Seth
= render partial: "form"

= render(Pages::Admin::Headers::Section::Component.new(title: "Invoices with this feature"))
%p{class: "tw:my-6"}
  = number_display(@invoices.count)
  total,
  %span.twless-strong
    = number_display(@invoices.active.count)
    active
= render(Pages::Admin::Invoices::Table::Component.new(invoices: @invoices, display_organization: true))
