<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", label: "Added", classes: "tw:text-sm") do |organization_feature| %>
    <%= render UI::Time::Component.new(time: organization_feature.created_at) %>
  <% end %>

  <% table.column(sortable: "name") do |organization_feature| %>
    <%= link_to organization_feature.name, edit_admin_organization_feature_url(organization_feature), class: "twlink" %>

    <% if organization_feature.description.present? %>
      <br>
      <small><%= organization_feature.description %></small>
    <% end %>

    <% if organization_feature.details_link.present? %>
      <br>
      <small>
        <%= link_to organization_feature.details_link, organization_feature.details_link, class: "twlink" %>
      </small>
    <% end %>

    <% if organization_feature.feature_slugs_string.present? %>
      <br>
      <small class="less-strong">
        <span>
          Feature slugs:
          <span style="color: purple;"><%= organization_feature.feature_slugs_string %></span>
        </span>
      </small>
    <% end %>
  <% end %>

  <% table.column(sortable: "kind") do |organization_feature| %>
    <small><%= organization_feature.kind.humanize %></small>
  <% end %>

  <% table.column(sortable: "amount_cents", label: "Amount") do |organization_feature| %>
    <%= organization_feature.amount_formatted %>
  <% end %>
<% end %>
