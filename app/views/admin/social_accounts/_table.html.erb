<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at") do |social_account| %>
    <%= link_to admin_social_account_path(social_account), class: "twlink" do %>
      <%= render UI::Time::Component.new(time: social_account.created_at) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "screen_name", label: "Handle") do |social_account| %>
    <%= social_account.screen_name %>
  <% end %>

  <% table.column(sortable: "last_error_at", label: "Errored?") do |social_account| %>
    <%= cross_mark if social_account.errored? %>
  <% end %>

  <% table.column(label: "Active?", header_classes: "tw:font-normal") do |social_account| %>
    <%= check_mark if social_account.active? %>
  <% end %>

  <% table.column(label: "Default?", header_classes: "tw:font-normal") do |social_account| %>
    <%= check_mark if social_account.default? %>
  <% end %>

  <% table.column(sortable: "national", label: "National?") do |social_account| %>
    <%= check_mark if social_account.national? %>
  <% end %>

  <% table.column(sortable: "language") do |social_account| %>
    <%= social_account.language %>
  <% end %>

  <% table.column(label: "Address", header_classes: "tw:font-normal") do |social_account| %>
    <small class="less-strong"><%= social_account.address %></small>
  <% end %>

  <% table.column(label: "Neighborhood", header_classes: "tw:font-normal") do |social_account| %>
    <small class="less-strong"><%= social_account.neighborhood %></small>
  <% end %>

  <% table.column(sortable: "city") do |social_account| %>
    <small class="less-strong"><%= social_account.city %></small>
  <% end %>

  <% table.column(label: "State", header_classes: "tw:font-normal") do |social_account| %>
    <small class="less-strong"><%= social_account.state&.abbreviation %></small>
  <% end %>

  <% table.column(sortable: "country") do |social_account| %>
    <small class="less-strong"><%= social_account.country&.name %></small>
  <% end %>

  <% table.column(label: "Posts", header_classes: "tw:font-normal") do |social_account| %>
    <%= number_with_delimiter(social_account.social_posts.count) %>
  <% end %>
<% end %>
