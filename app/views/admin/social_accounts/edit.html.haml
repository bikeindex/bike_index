= render(Pages::Admin::Headers::Nav::Component.new(title: "Update Social Account: #{@social_account.screen_name}")) do |nav|
  - nav.with_item do
    = render(UI::ButtonLink::Component.new(text: "View account data", href: admin_social_account_path(@social_account), size: :sm))
  - nav.with_item do
    = render(UI::ButtonLink::Component.new(text: "Log in to refresh credentials", href: "/auth/twitter", size: :sm))
  - nav.with_item do
    = render(UI::ButtonLink::Component.new(text: "Delete account", href: admin_social_account_path(@social_account), method: :delete, color: :error, size: :sm, confirm: "Are you sure you want to delete this? This can't be undone"))

= render "form",
  social_account: @social_account,
  action: admin_social_account_path(@social_account),
  method: :patch,
  submit_label: "Save"
