- if SocialAccount.active.errored.any?
  = render(UI::Container::Component.new) do
    = render(UI::Alerts::Base::Component.new(kind: :error, margin_classes: "tw:my-6")) do
      - errors_title = capture do
        %strong
          = pluralize(SocialAccount.active.errored.count, "Social account")
        with errors
        %em{class: UI::Alerts::Base::Component::TEXT_CLASSES[:success]}
          = link_to "review errors", admin_social_accounts_path(sort: "last_error_at"), class: "twlink"
      = render(UI::Header::Component.new(text: errors_title, tag: :h2, html_class: "twsection"))
      %p
        This will prevent posting for areas served by:
        %br
        %em
          = SocialAccount.active.errored.pluck(:screen_name).sort.join(", ")

      = render(UI::ButtonLink::Component.new(text: "Log in with any of these accounts to refresh their credentials", href: "/auth/twitter", color: :primary))
