<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", label: "Created", lower_right: ->(education_course) { education_course.id }) do |education_course| %>
    <%= link_to render(UI::Time::Component.new(time: education_course.created_at)),
      admin_education_course_path(education_course), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "updated_at", label: "Updated") do |education_course| %>
    <small><%= render(UI::Time::Component.new(time: education_course.updated_at, format: :localize_time_precise)) %></small>
  <% end %>

  <% table.column(sortable: "organization_id", label: "Organization") do |education_course| %>
    <% if education_course.template? %>
      <span class="less-strong"><%= education_course.badge_name %></span>
    <% else %>
      <%= render(Atoms::Admin::TableCells::Organization::Component.new(organization: education_course.organization,
        organization_id: education_course.organization_id, render_search: true,
        search_url: admin_education_courses_path(sort_state.search_params.to_h.merge(organization_id: education_course.organization_id)))) %>
    <% end %>
  <% end %>

  <% table.column(label: "Status") do |education_course| %>
    <%= render UI::Badge::Component.new(text: education_course.status.titleize, color: education_course.active? ? :success : :gray, size: :sm) %>
  <% end %>

  <% table.column(label: "Pages") do |education_course| %>
    <%= number_display(education_course.education_course_pages.size) %>
  <% end %>
<% end %>
