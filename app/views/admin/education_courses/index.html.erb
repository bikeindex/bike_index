<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  chart_collection: @render_chart && matching_education_courses,
)) do |skeleton| %>
  <% skeleton.with_nav_item do %>
    <%= render(UI::Dropdown::Component.new(
      name: @status.present? ? "#{@status.titleize} only" : "All statuses",
      button_size: :sm,
      active: @status.present?
    )) do |dropdown|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All statuses", path: url_for(sortable_search_params.merge(search_status: nil)), match_params: {search_status: nil}) }
      dropdown.with_entry_divider
      searchable_statuses.each do |kind|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{kind.titleize} only", path: url_for(sortable_search_params.merge(search_status: kind)), match_params: {search_status: kind}) }
      end
    end %>
  <% end %>

  <% skeleton.with_nav_item do %>
    <% if @default_course.present? %>
      <%= render(UI::ButtonLink::Component.new(text: "#{@default_course.display_name} course", href: EducationCoursePaths.course(@default_course, admin: true), size: :sm)) %>
    <% else %>
      <%# Nothing for organizations to clone yet - the first default course is drafted here %>
      <%= render UI::ButtonLink::Component.new(text: "Create default course", href: EducationCoursePaths.create_draft(nil), method: :post, color: :primary, size: :sm) %>
    <% end %>
  <% end %>
<% end %>
