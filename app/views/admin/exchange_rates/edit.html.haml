= render(UI::Container::Component.new(width: :wide)) do
  = render(Pages::Admin::Headers::Nav::Component.new(title: "Edit Exchange Rate")) do |nav|
    - nav.with_item { render(UI::ButtonLink::Component.new(text: "Delete exchange rate", href: admin_exchange_rate_path(@exchange_rate), method: :delete, color: :error, size: :sm, confirm: "Are you sure you want to delete this? This can't be undone")) }

  = render "form",
    exchange_rate: @exchange_rate,
    action: admin_exchange_rate_path(@exchange_rate),
    method: :put,
    submit_label: "Save"
