= render(UI::Container::Component.new(width: :wide)) do
  %h1 Edit Exchange Rate
  %div{class: "tw:text-right"}
    = render(UI::ButtonLink::Component.new(text: "Delete exchange rate", href: admin_exchange_rate_path(@exchange_rate), method: :delete, color: :error, size: :sm, confirm: "Are you sure you want to delete this? This can't be undone"))

  = render "form",
    exchange_rate: @exchange_rate,
    action: admin_exchange_rate_path(@exchange_rate),
    method: :put,
    submit_label: "Save"
