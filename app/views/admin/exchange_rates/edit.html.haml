.container
  %h1 Edit Exchange Rate
  .text-right
    = render(UI::ButtonLink::Component.new(text: "Delete exchange rate", href: admin_exchange_rate_path(@exchange_rate), method: :delete, color: :error, size: :sm, form: {onsubmit: "return confirm('#{j "Are you sure you want to delete this? This can't be undone"}')"}))

  = render "form",
    exchange_rate: @exchange_rate,
    action: admin_ambassador_task_path(@exchange_rate),
    method: :put,
    submit_label: "Save"
