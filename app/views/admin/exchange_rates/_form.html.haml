= form_for exchange_rate,
  url: action,
  method: method,
  html: { class: "form" } do |f|

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :from, label_text: "From (iso)", required: true, html_options: {style: "text-transform: uppercase;"}))
  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :to, label_text: "To (iso)", required: true, html_options: {style: "text-transform: uppercase;"}))
  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :rate))

  %div{class: "tw:mt-6"}
    = render(UI::Button::Component.new(text: submit_label, color: :primary, size: :lg, type: "submit"))
