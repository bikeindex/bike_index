<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::ButtonLink::Component.new(text: "New Exchange Rate", href: new_admin_exchange_rate_path, color: :primary, size: :sm)) %>
  </li>
<% end %>

<% admin_search_form = capture do %>
  <div class="row">
    <div class="col-md-6">
      <% if filter_params.any? %>
        <p>
          <%= pluralize number_with_delimiter(@exchange_rates.count), "matching exchange rate" %>
          <em><%= link_to "view all", admin_exchange_rates_path %></em>
        </p>
      <% end %>
    </div>

    <div class="col-md-6">
      <%= form_with(url: admin_exchange_rates_path, method: :get, html: {class: "twsearchrow"}) do |form| %>
        <%= render partial: "/shared/hidden_search_fields" %>

        <%= render(UI::Forms::Select::Component.new(form_builder: form, attribute: :search_to,
          option_tags: ExchangeRate.pluck(:to).uniq, options: {prompt: "Filter by target currency"},
          html_options: {class: "tw:w-full tw:sm:w-64"})) %>

        <%= render(UI::Button::Component.new(text: "Filter", color: :primary, type: "submit", name: "search")) %>
      <% end %>
    </div>
  </div>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @exchange_rates,
  viewing: "Exchange Rates",
  skip_charting: true,
  nav_header_list_items:,
  admin_search_form:,
)) %>
