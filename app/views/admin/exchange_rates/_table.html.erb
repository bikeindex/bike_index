<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "from", label: "Source currency") do |xrate| %>
    <%= xrate.from %>
  <% end %>

  <% table.column(sortable: "to", label: "Target currency") do |xrate| %>
    <%= xrate.to %>
  <% end %>

  <% table.column(sortable: "rate") do |xrate| %>
    <%= link_to xrate.rate.truncate(2), edit_admin_exchange_rate_path(xrate), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "updated_at") do |xrate| %>
    <%= render UI::Time::Component.new(time: xrate.updated_at) %>
  <% end %>
<% end %>
