<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", lower_right: ->(record) { content_tag(:span, record.id, class: "only-dev-visible") }) do |version| %>
    <%= render UI::Time::Component.new(time: version.created_at) %>
  <% end %>

  <% table.column(sortable: "event") do |version| %>
    <%= version.event %>

    <% if render_sortable %>
      <%= link_to search_emoji, url_for(sort_state.search_params.merge(search_event: version.event)), class: "display-sortable-link small" %>
    <% end %>
  <% end %>

  <% table.column(sortable: "item_type") do |version| %>
    <%= link_to "#{version.item_type} ##{version.item_id}", helpers.admin_path_for_object(version), class: "twlink tw:mr-1" %>

    <% if render_sortable %>
      <%= link_to search_emoji, url_for(sort_state.search_params.merge(search_item_type: version.item_type, search_item_id: version.item_id)), class: "display-sortable-link small" %>
    <% end %>
  <% end %>

  <% table.column(label: "Whodunnit") do |version| %>
    <% if version.whodunnit.present? %>
      <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: User.find_by(id: version.whodunnit), user_id: version.whodunnit.to_i, render_search: render_sortable) %>
    <% end %>
  <% end %>

  <% table.column(label: "Changes") do |version| %>
    <%= render UI::JsonDisplay::Component.new(data: version.object_changes, small: true, max_width: :table_cell) %>
  <% end %>
<% end %>
