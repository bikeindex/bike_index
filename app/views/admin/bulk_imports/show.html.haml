= render(Pages::Admin::Headers::Nav::Component.new(title: safe_join(["Bulk Import ", tag.em("##{@bulk_import.id}")]))) do
  %li= render(UI::ButtonLink::Component.new(text: "All bulk imports", href: admin_bulk_imports_path, size: :sm))
  - if @bulk_import.organization_id.present?
    %li= render(UI::ButtonLink::Component.new(text: "All #{@bulk_import.organization.name} imports", href: admin_bulk_imports_path(organization_id: @bulk_import.organization.to_param), size: :sm))
.twwiderow{class: "tw:items-start"}
  = render(UI::TableList::Component.new) do |list|
    - list.with_row(label: "Created", value: render(UI::Time::Component.new(time: @bulk_import.created_at, format: :localize_time_precise)))
    - list.with_row(label: "Progress", value: render(partial: "/organized/bulk_imports/progress_display", locals: {bulk_import: @bulk_import, show_extended: true}))
    - list.with_row(label: "File") do
      %small
        - if @bulk_import.file_cleaned?
          %span{class: UI::Alerts::Base::Component::TEXT_CLASSES[:warning]} file removed
          %em.twless-strong{class: "tw:text-sm"} after a few days, we delete the uploaded file to save space
        - else
          = link_to @bulk_import.file_url, @bulk_import.file_url, class: "twlink"
    - list.with_row(label: "Send email?") do
      = @bulk_import.send_email ? check_mark : cross_mark
      %small.twless-strong Email is sent by default
    - list.with_row(label: "Allow duplicates?") do
      = @bulk_import.allow_duplicate ? check_mark : cross_mark
      %small.twless-strong Only true by default for stolen and impounded

  = render(UI::TableList::Component.new) do |list|
    - list.with_row(label: "User") do
      - if @bulk_import.user.present?
        = link_to @bulk_import.user.display_name, admin_user_path(@bulk_import.user), class: "twlink"
      - else
        None
    - list.with_row(label: "Organization") do
      - if @bulk_import.organization.present?
        = link_to @bulk_import.organization.name, admin_organization_path(@bulk_import.organization), class: "twlink twless-strong"
        \|
        %strong
          = link_to "Organization view of import", organization_bulk_import_path(@bulk_import, organization_id: @bulk_import.organization.to_param), class: "twlink"
      - else
        None
        - if @bulk_import.ascend?
          %div{class: "tw:text-sm"}
            Ascend name:
            %code.twcode= @bulk_import.ascend_name
    - list.with_row(label: "Kind", value: @bulk_import.kind_humanized)
    - list.with_row(label: "Headers") do
      - if @bulk_import.headers.present?
        %small
          = safe_join(@bulk_import.headers.map { |a| content_tag(:code, a, class: "twcode") }, ", ")
    - if display_dev_info?
      - data = @bulk_import.data || {}
      - list.with_row(label: "Data", dev_only: true) do
        - if data.blank?
          No data
        - elsif data.except("headers").blank?
          No data (except <code class="twcode">headers</code>)
        - else
          = render UI::JsonDisplay::Component.new(data: data.except("headers"), small: true)

%div{class: "tw:my-6"}
  = render(UI::Header::Component.new(text: "Errors", tag: :h3))
  - if @bulk_import.import_errors == {}
    %span.twless-strong No errors
  - else
    = render(Pages::Org::BulkImportError::Component.new(bulk_import: @bulk_import, in_admin: true, display_dev_info: display_dev_info?))


- if @bulk_import.ownerships.count < 1 || params[:show_reprocess]
  = render UI::ButtonLink::Component.new(text: "Reprocess Import", href: admin_bulk_import_path(@bulk_import, reprocess: true), method: :put, form: {class: "tw:float-right"})

= render(UI::Header::Component.new(tag: :h2)) do
  = safe_join(["Bikes - ", number_display(@bulk_import.bikes.count)])
  - if @bulk_import.matched_count.positive?
    %small
      and #{number_display(@bulk_import.matched_count)} #{"row".pluralize(@bulk_import.matched_count)} matching existing registrations
  - if @bulk_import.bikes.count > 25
    %small
      Last 25 shown
      - if @bulk_import.organization.present?
        %em
          use
          = link_to "organization view", organization_bulk_import_path(@bulk_import, organization_id: @bulk_import.organization.to_param), class: "twlink"
          for paginated list

= render Pages::Admin::Bikes::Table::Component.new(bikes: @bulk_import.bikes.reorder(id: :desc).limit(25), sort_state:)
