<%# locals: (collection:, render_sortable: false) %>

<%# A cell's own cache would digest UI::Table's template, not this one %>
<% user_cell_cache = cache_fragment_name("user_cell") %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", lower_right: ->(sale) { content_tag(:span, sale.id, class: "only-dev-visible") }) do |sale| %>
    <%= link_to render(UI::Time::Component.new(time: sale.created_at)), admin_sale_path(sale), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "sold_at", classes: "tw:text-xs") do |sale| %>
    <%= render UI::Time::Component.new(time: sale.sold_at) %>
  <% end %>

  <% table.column(sortable: "amount_cents", label: "amount") do |sale| %>
    <%= helpers.amount_display(sale, currency_name_suffix: :if_not_default) %>
  <% end %>

  <% table.column(sortable: "sold_via", classes: "tw:text-xs") do |sale| %>
    <%= sale.sold_via&.humanize %>
  <% end %>

  <% table.column(label: "Item") do |sale| %>
    <% bike = sale.ownership&.bike %>

    <% if bike.present? %>
      <%= render Pages::Admin::Bikes::Cell::Component.new(bike:, bike_id: bike.id) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "seller_id", label: "Seller") do |sale| %>
    <% cache([user_cell_cache, sale.seller], skip_digest: true) do %>
      <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: sale.seller, render_search: true) %>
    <% end %>
  <% end %>

  <% table.column(label: "Buyer") do |sale| %>
    <% if sale.buyer.present? %>
      <% cache([user_cell_cache, sale.buyer], skip_digest: true) do %>
        <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: sale.buyer, render_search: true) %>
      <% end %>
    <% else %>
      <small class="less-strong">
        <%= sale.new_owner_email&.truncate(20) %>
      </small>
    <% end %>
  <% end %>
<% end %>
