<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection)) do |table| %>
  <% table.column(label: "Name") do |plan| %>
    <%= link_to plan.name, edit_admin_theft_alert_plan_path(plan), class: "twlink" %>
  <% end %>

  <% table.column(label: "Price") do |plan| %>
    <%= plan.amount_formatted %>
  <% end %>

  <% table.column(label: "Views Provided") do |plan| %>
    <%= number_display(plan.views) %>
  <% end %>

  <% table.column(label: "Duration (days)") do |plan| %>
    <%= plan.duration_days %>
  <% end %>

  <% table.column(label: "Description") do |plan| %>
    <%= plan.description_html.html_safe %>
  <% end %>

  <% table.column(label: "Language") do |plan| %>
    <%= t(plan.language, scope: [:locales]) %>
  <% end %>

  <% table.column(label: "Active?") do |plan| %>
    <%= check_mark if plan.active? %>
  <% end %>
<% end %>
