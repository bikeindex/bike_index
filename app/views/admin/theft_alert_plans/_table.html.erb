<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection)) do |table| %>
  <% table.column(label: "Name", header_classes: "tw:font-normal") do |plan| %>
    <%= link_to plan.name, edit_admin_theft_alert_plan_path(plan), class: "twlink" %>
  <% end %>

  <% table.column(label: "Price", header_classes: "tw:font-normal") do |plan| %>
    <%= plan.amount_formatted %>
  <% end %>

  <% table.column(label: "Views Provided", header_classes: "tw:font-normal") do |plan| %>
    <%= number_display(plan.views) %>
  <% end %>

  <% table.column(label: "Duration (days)", header_classes: "tw:font-normal") do |plan| %>
    <%= plan.duration_days %>
  <% end %>

  <% table.column(label: "Description", header_classes: "tw:font-normal") do |plan| %>
    <%= plan.description_html.html_safe %>
  <% end %>

  <% table.column(label: "Language", header_classes: "tw:font-normal") do |plan| %>
    <%= t(plan.language, scope: [:locales]) %>
  <% end %>

  <% table.column(label: "Active?", header_classes: "tw:font-normal") do |plan| %>
    <%= check_mark if plan.active? %>
  <% end %>
<% end %>
