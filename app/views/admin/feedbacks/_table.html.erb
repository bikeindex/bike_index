<%# locals: (feedbacks:, render_sortable: false, skip_bike: false, skip_user: false) %>

<% render_kind_search = render_sortable && params[:search_kind].blank? %>

<div
  data-controller="update-cached-sortable-links"
  data-update-cached-sortable-links-base-url-value="<%= url_for(sort_state.search_params) %>"
>
  <%= render(UI::Table::Component.new(records: feedbacks, render_sortable:, sort_state:,
        cache_key: cache_fragment_name(["admin_feedbacks", render_sortable, skip_bike, skip_user, render_kind_search]),
        cache_records: ->(feedback) { feedback.user })) do |table| %>
    <% table.column(sortable: "created_at") do |feedback| %>
      <%= link_to admin_feedback_url(feedback), class: "twlink" do %>
        <%= render UI::Time::Component.new(time: feedback.created_at) %>
      <% end %>
    <% end %>

    <% unless skip_user %>
      <% table.column(label: "User") do |feedback| %>
        <%= render Atoms::Admin::TableCells::User::Component.new(sort_state:, email: feedback.email, user: feedback.user, render_search: render_sortable) %>
      <% end %>

      <% table.column(label: "Name") do |feedback| %>
        <%= feedback.name %>
      <% end %>
    <% end %>

    <% table.column(sortable: "feedback_type", label: "Type") do |feedback| %>
      <%= feedback.humanized_type %>

      <% if render_kind_search %>
        <%= link_to search_emoji, admin_feedbacks_path(sort_state.search_params.merge(search_kind: feedback.feedback_type)), class: "display-sortable-link small" %>
      <% end %>
    <% end %>

    <% unless skip_bike %>
      <% table.column(label: "Bike") do |feedback| %>
        <% if feedback.bike_id.present? %>
          <%= render Atoms::Admin::TableCells::Bike::Component.new(sort_state:, bike: feedback.bike, bike_id: feedback.bike_id, bike_link_path: admin_bike_path(feedback.bike_id, active_tab: "messages"), render_search: true) %>
        <% end %>
      <% end %>
    <% end %>

    <% table.column(label: "Body", classes: "tw:w-1/4") do |feedback| %>
      <%= feedback.body.truncate(100) %>
    <% end %>
  <% end %>
</div>
