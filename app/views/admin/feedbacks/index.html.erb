<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(name: @search_kind == "all" ? "All kinds" : Feedback.kind_humanized(@search_kind), button_size: :sm,
          active: @search_kind != "all")) do |dropdown| %>
      <% permitted_kinds.each do |kind| %>
        <% kind_active = @search_kind == kind %>
        <% kind_display = kind == "all" ? "All kinds" : Feedback.kind_humanized(kind) %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: kind_display, path: url_for(sortable_search_params.merge(search_kind: (kind_active ? nil : kind))), match_params: {search_kind: kind}) } %>

        <% if kind == "stolen_tip" %>
          <% dropdown.with_entry_divider %>
        <% end %>
      <% end %>
    <% end %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "Render kind counts", href: url_for(sortable_search_params.merge(search_kind_counts: !@render_kind_counts)), size: :sm, active: @render_kind_counts)) %>
  </li>
<% end %>

<% colors = %w[#B60205 #D93F0B #FBCA04 #0E8A16 #006B75 #1D76DB #0052CC #5319E7 #D4C5F9 #2C3E50 #F9D0C4 #C2E0C6 #C5DEF5 #7DCABB] %>

<% rendered_chart = capture do %>
  <% if @render_kind_counts %>
    <% series = Feedback.kinds.map { |k| {name: Feedback.kind_humanized(k), data: UI::Chart::Component.time_range_counts(collection: available_feedbacks.where(kind: k), time_range: @time_range, column: @time_range_column.presence || "created_at")} } %>
  <% else %>
    <% series = [{name: "Feedback", data: UI::Chart::Component.time_range_counts(collection: available_feedbacks, time_range: @time_range, column: @time_range_column.presence || "created_at")}] %>
  <% end %>

  <%= render(UI::Chart::Component.new(series:, time_range: @time_range, stacked: true, colors:)) %>
<% end %>

<% admin_search_form = capture do %>
  <%= form_with(url: url_for, method: :get, html: {class: "twsearchrow"}) do |f| %>
    <%= render partial: "/shared/hidden_search_fields" %>

    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :search_bike_id,
      html_options: {value: params[:search_bike_id], placeholder: "Search Bike ID", class: "tw:w-full tw:sm:w-40"}) %>

    <%= render UI::Forms::Select::Component.new(form_builder: f, attribute: :search_kind,
      option_tags: Feedback.kinds.map { |kind| [Feedback.kind_humanized(kind), kind] },
      options: {selected: params[:search_kind], include_blank: "Search Kind"}, html_options: {class: "tw:w-full tw:sm:w-auto"}) %>

    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :search_email,
      html_options: {value: params[:search_email], placeholder: "Search email"}) %>

    <%= render UI::Button::Component.new(text: "Search", color: :primary, type: "submit", name: "search") %>
  <% end %>
<% end %>

<% table_view = capture do %>
  <% if @render_kind_counts %>
    <%= render(UI::Container::Component.new) do %>
      <%= render(UI::Card::Component.new(additional_classes: "tw:my-6")) do %>
        <h3>Kinds</h3>

        <% nil_count = available_feedbacks.where(kind: nil).count %>

        <%= render(UI::TableList::Component.new(wide_definition: true)) do |list| %>
          <% Feedback.kinds.each_with_index do |kind, index| %>
            <% count = available_feedbacks.where(kind: kind).count %>
            <% next unless count > 0 %>

            <% label = capture do %>
              <div
                style="width: 1em; height: 1em; background: <%= colors[index] %>; float: right; margin-left: 0.4rem;"
              ></div>

              <%= link_to Feedback.kind_humanized(kind), url_for(sortable_search_params.merge(search_kind: kind)) %>
            <% end %>

            <% list.with_row(label:, value: number_display(count)) %>
          <% end %>

          <% list.with_row(label: "Nil", value: number_display(nil_count), if: nil_count > 0) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render partial: "/admin/feedbacks/table", locals: {feedbacks: @feedbacks, render_sortable: true} %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @feedbacks,
  viewing: "Feedback & Messages",
  rendered_chart:,
  nav_header_list_items:,
  admin_search_form:,
  table_view:,
)) %>
