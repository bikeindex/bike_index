<% if @bike.present? %>
  <%= render Pages::Admin::Bikes::Header::Component.new(bike: @bike, active: :theft_alerts, display_recovery: true, user: current_user, display_dev_info: display_dev_info?) %>
  <h1 class="mt-5 mb-4">
    Promoted Alerts
    <%= render(UI::ButtonLink::Component.new(text: "New Promoted alert", href: new_admin_theft_alert_path(bike_id: @bike.id), color: :primary, size: :sm, html_class: "tw:ml-2")) %>
  </h1>
  <%= render partial: "table", locals: {render_sortable: true, theft_alerts: @theft_alerts, skip_bike: true} %>
<% else %>
  <% nav_header_list_items = capture do %>
    <li>
      <%= render(UI::Dropdown::Component.new(name: "#{@status.titleize} #{@status == "all" ? "statuses" : "alerts"}", button_size: :sm,
            active: @status != "all")) do |dropdown| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All statuses", path: url_for(sortable_search_params.merge(search_status: nil)), match_params: {search_status: nil}) } %>
        <% dropdown.with_entry_divider %>

        <% available_statuses.each do |status| %>
          <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{status.humanize} alerts", path: url_for(sortable_search_params.merge(search_status: status)), match_params: {search_status: status}) } %>
        <% end %>
      <% end %>
    </li>

    <li>
      <%= render(UI::Dropdown::Component.new(name: @search_paid_admin.humanize, button_size: :sm,
            active: @search_paid_admin.present?)) do |dropdown| %>
        <% available_paid_admin.each do |paid_admin| %>
          <% if paid_admin == "paid_and_unpaid" %>
            <% dropdown.with_entry_divider %>
          <% end %>

          <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: paid_admin.humanize, path: url_for(sortable_search_params.merge(search_paid_admin: paid_admin)), match_params: {search_paid_admin: paid_admin}) } %>
        <% end %>
      <% end %>
    </li>

    <li>
      <%= render(UI::ButtonLink::Component.new(text: "fbook data", href: url_for(sortable_search_params.merge(search_facebook_data: !@search_facebook_data)), size: :sm, active: @search_facebook_data)) %>
    </li>

    <li>
      <%= render(UI::ButtonLink::Component.new(text: "recovered", href: url_for(sortable_search_params.merge(search_recovered: !@search_recovered)), size: :sm, active: @search_recovered)) %>
    </li>

    <li>
      <%= render(UI::ButtonLink::Component.new(text: "location counts", href: admin_theft_alerts_path(sortable_search_params.merge(search_location_counts: !@location_counts)), size: :sm, active: @location_counts)) %>
    </li>
  <% end %>
  <% theft_alert_plans = TheftAlertPlan.price_ordered_desc.select { |plan| searched_theft_alerts.where(theft_alert_plan: plan).any? } %>
  <% stolen_records = StolenRecord.recovered.with_theft_alerts.where(theft_alerts: {id: searched_theft_alerts.pluck(:id)}) %>
  <% rendered_chart = nil %>
  <% if @render_chart %>
    <% rendered_chart = capture do %>
      <% theft_alerts_graph = theft_alert_plans.map do |theft_alert_plan|
          {
            name: theft_alert_plan.name,
            data: time_range_counts(collection: searched_theft_alerts.where(theft_alert_plan_id: theft_alert_plan.id))
          }
        end
        alerts_recoveries_graph = theft_alert_plans.map do |theft_alert_plan|
          {
            name: "#{theft_alert_plan.name} recoveries",
            data: time_range_counts(collection: stolen_records.where(theft_alerts: {theft_alert_plan_id: theft_alert_plan.id}), column: "theft_alerts.created_at")
          }
        end

        if @search_facebook_data
          facebook_reach_graph = theft_alert_plans.map do |theft_alert_plan|
            {
              name: theft_alert_plan.name,
              data: time_range_amounts(collection: searched_theft_alerts.where(theft_alert_plan_id: theft_alert_plan.id), amount_column: "reach")
            }
          end
        end %>

      <div class="col-12 mt-2">
        <%= render(UI::Chart::Component.new(series: theft_alerts_graph, time_range: @time_range, stacked: true)) %>
      </div>

      <% if @search_facebook_data %>
        <h3 class="mt-5">
          <em>Sum of Facebook reach for ads started in the period</em>
        </h3>
        <%= render(UI::Chart::Component.new(series: facebook_reach_graph, time_range: @time_range, stacked: true)) %>
        <div class="mt-5"></div>
      <% end %>

      <% unless @search_recovered %>
        <div class="col-12 mt-2">
          <%= render(UI::Chart::Component.new(series: alerts_recoveries_graph, time_range: @time_range, stacked: true)) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <% admin_search_form = capture do %>
    <div class="row mb-4 mt-4">
      <div class="col">
        <%= form_tag admin_theft_alerts_path, method: :get, class: "form-inline" do %>
          <%= hidden_field_tag :search_recovery_display_status, @search_recovered %>
          <%= hidden_field_tag :search_status, @status %>
          <%= hidden_field_tag :search_paid_admin, @search_paid %>
          <%= hidden_field_tag :search_facebook_data, @search_facebook_data %>
          <%= hidden_field_tag :search_recovered, @search_recovered %>
          <%= hidden_field_tag :search_location_counts, @location_counts %>
          <%= render partial: "/shared/hidden_search_fields" %>

          <div class="form-group ml-auto mr-1 mb-2">
            <em class="small less-strong mr-1 d-md-inline d-none">within</em>
            <%= number_field_tag :search_distance, @distance, class: "form-control", style: "width: 5rem;" %>

            <em class="small less-strong ml-1 mr-1 d-md-inline d-none">
              miles of
            </em>
          </div>

          <div class="form-group mr-2 mb-2">
            <%= text_field_tag :search_location, params[:search_location], placeholder: "anywhere", class: "form-control" %>
          </div>

          <%= submit_tag "Search", name: "search", class: "btn btn-primary mb-2" %>
        <% end %>
      </div>

      <% if theft_alert_plans.present? %>
        <% plan_rows = theft_alert_plans.map do |theft_alert_plan|
            plan_theft_alerts = searched_theft_alerts.where(theft_alert_plan:)
            {
              name: theft_alert_plan.name,
              amount_cents_facebook: theft_alert_plan.amount_cents_facebook,
              alert_count: plan_theft_alerts.count,
              fbook_reach: plan_theft_alerts.sum(:reach),
              fbook_cents: plan_theft_alerts.sum(:amount_cents_facebook_spent),
              revenue_cents: plan_theft_alerts.paid_cents,
              recovered_count: stolen_records.where(theft_alerts: {theft_alert_plan_id: theft_alert_plan.id}).count
            }
          end
          total = %i[alert_count fbook_reach fbook_cents revenue_cents recovered_count]
            .index_with { |key| plan_rows.sum { |row| row[key] } } %>
        <div class="col">
          <%= render(UI::Table::Component.new(records: plan_rows)) do |table| %>
            <% table.column(label: "", footer: "Total") do |row| %>
              <%= row[:name] %>
              <small><%= MoneyFormatter.money_format(row[:amount_cents_facebook]) %></small>
            <% end %>

            <% table.column(label: "Count", footer: number_display(total[:alert_count])) do |row| %>
              <%= number_display(row[:alert_count]) %>
            <% end %>

            <% table.column(label: "Fbook Reach", footer: number_display(total[:fbook_reach])) do |row| %>
              <%= number_display(row[:fbook_reach]) %>
            <% end %>

            <% table.column(label: "Fbook Spend", footer: MoneyFormatter.money_format(total[:fbook_cents])) do |row| %>
              <%= MoneyFormatter.money_format(row[:fbook_cents]) %>
            <% end %>

            <% table.column(label: "Revenue", classes: "tw:text-xs", footer: MoneyFormatter.money_format(total[:revenue_cents])) do |row| %>
              <%= MoneyFormatter.money_format(row[:revenue_cents]) %>
            <% end %>

            <% table.column(label: "Recovered", classes: "tw:text-xs", header_classes: "tw:font-normal", footer: number_display(total[:recovered_count])) do |row| %>
              <%= number_display(row[:recovered_count]) %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% table_view = capture do %>
    <% if @location_counts %>
      <div
        class="col-md-8 offset-md-2 mb-3"
        style="max-height: 500px; overflow-y: scroll;"
      >
        <%= render(UI::Table::Component.new(records: searched_theft_alerts.cities_count, sort_state:)) do |table| %>
          <% table.column(label: "Country", classes: "tw:text-xs") do |(country)| %>
            <%= country %>
          <% end %>

          <% table.column(label: "City") do |(country, city, state)| %>
            <%= link_to city.presence || "Blank location", admin_theft_alerts_path(sort_state.search_params.merge(search_location: "#{city}, #{state} #{country}")), class: "twlink" %>
          <% end %>

          <% table.column(label: "State", classes: "tw:text-xs") do |(_country, _city, state)| %>
            <%= state %>
          <% end %>

          <% table.column(label: "Count") do |(_country, _city, _state, count)| %>
            <%= number_display(count) %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= render partial: "table", locals: {render_sortable: true, theft_alerts: @theft_alerts, skip_bike: false} %>
  <% end %>
  <%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
    collection: @theft_alerts,
    viewing: "Promoted Alerts",
    nav_header_list_items:,
    rendered_chart:,
    admin_search_form:,
    table_view:,
  )) %>
<% end %>
