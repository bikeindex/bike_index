= render Pages::Admin::Bikes::Header::Component.new(bike: @bike, active: :theft_alerts, display_recovery: true, user: current_user, display_dev_info: display_dev_info?)

%h1.mt-5.mb-4
  New Promoted Alert

- if @theft_alerts.any?
  %h4 Existing alerts
  = render partial: "/admin/theft_alerts/table", locals: {render_sortable: true, theft_alerts: @theft_alerts, skip_bike: true}

.row.mt-5.mb-4
  .offset-md-2.col-md-8
    - if @theft_alert.activateable?
      .alert.alert-success
        %h4
          This alert will activate as soon as you create it.
    - else
      .alert.alert-warning
        %h4
          This alert won't activate,
          %small it's missing required stuff:
        %ul
          - if @theft_alert.missing_photo?
            %li.text-danger It doesn't have a photo
          - if @theft_alert.missing_location?
            %li.text-danger It doesn't have a location - "#{@theft_alert.latitude}"
          - unless @theft_alert.stolen_record_approved?
            %li.text-danger Stolen record isn't approved

= form_for @theft_alert, url: admin_theft_alerts_path, method: :post, html: {class: "m-0"} do |f|
  = f.hidden_field :stolen_record_id
  .row
    .col-md-6
      - plan_options = @theft_alert_plans.map { |e| ["#{theft_alert_plan_title(e)} - #{e.amount_formatted}", e.id] }
      = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :theft_alert_plan_id)) do
        = render(UI::Forms::Select::Component.new(form_builder: f, attribute: :theft_alert_plan_id, option_tags: plan_options))

    - @theft_alert.ad_radius_miles ||= @theft_alert.theft_alert_plan.ad_radius_miles
    .col-md-6
      = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :ad_radius_miles, kind: :number_field, html_options: {step: 1, min: 1}))

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :location, html_options: {value: @theft_alert.address_string, disabled: true}))

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :notes, kind: :text_area, html_options: {rows: 3}))

  = render(UI::Button::Component.new(text: "Create", color: :primary, type: "submit"))
