<%# locals: (collection:, render_sortable: false) %>

<%# Shown while "Toggle data" is expanded; the label stays a content target, since a ui--collapse with none never closes %>
<% data_column_classes = "tw:hidden tw:in-[[data-controller~=ui--collapse]:has([data-ui--collapse-target~=trigger][aria-expanded=true])]:table-cell" %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "email") do |mailchimp_datum| %>
    <%= render Atoms::Admin::TableCells::User::Component.new(user: mailchimp_datum.user, user_id: mailchimp_datum.user_id, email: mailchimp_datum.email) %>
  <% end %>

  <% table.column(label: "Feedbacks", header_classes: "tw:text-xs") do |mailchimp_datum| %>
    <%= safe_join(mailchimp_datum.feedbacks.map { |f| link_to(f.kind_humanized, admin_feedback_path(f), class: "small") }, ", ") %>
  <% end %>

  <% table.column(sortable: "created_at") do |mailchimp_datum| %>
    <%= render(UI::Time::Component.new(time: mailchimp_datum.created_at)) %>
  <% end %>

  <% table.column(sortable: "updated_at", header_classes: "tw:text-xs") do |mailchimp_datum| %>
    <small><%= render(UI::Time::Component.new(time: mailchimp_datum.updated_at)) %></small>
  <% end %>

  <% table.column(label: "Lists") do |mailchimp_datum| %>
    <%= mailchimp_datum.lists.join(", ") %>
  <% end %>

  <% table.column(label: safe_join(["Groups ", tag.small("AKA interests", class: "only-dev-visible d-none d-xl-inline-block")])) do |mailchimp_datum| %>
    <%= mailchimp_datum.interests.map(&:humanize).join(", ") %>
  <% end %>

  <% table.column(sortable: "status", header_classes: "tw:text-xs") do |mailchimp_datum| %>
    <% unless mailchimp_datum.subscribed? %>
      <small><%= mailchimp_datum.status&.humanize %></small>
    <% end %>
  <% end %>

  <% table.column(sortable: "mailchimp_updated_at") do |mailchimp_datum| %>
    <% if mailchimp_datum.mailchimp_updated_at.present? %>
      <%= render(UI::Time::Component.new(time: mailchimp_datum.mailchimp_updated_at)) %>
    <% end %>
  <% end %>

  <% table.column(label: tag.span("Data", class: "tw:hidden", data: {"ui--collapse-target": "content"}), classes: data_column_classes) do |mailchimp_datum| %>
    <%= render UI::JsonDisplay::Component.new(data: mailchimp_datum.data, small: true, max_width: :table_cell) %>
  <% end %>
<% end %>
