<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(name: "#{@list.titleize} #{@list == "all" ? "lists" : "list"}", button_size: :sm,
          active: @list != "all")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All lists", path: url_for(sortable_search_params.merge(search_list: nil)), match: :query, query: {search_list: nil}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Organization list", path: url_for(sortable_search_params.merge(search_list: "organization")), match: :query, query: {search_list: "organization"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Individual list", path: url_for(sortable_search_params.merge(search_list: "individual")), match: :query, query: {search_list: "individual"}) } %>
    <% end %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(name: "#{@status.titleize} #{@status == "all" ? "statuses" : "status"}", button_size: :sm,
          active: @status != "all")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All statuses", path: url_for(sortable_search_params.merge(search_status: nil)), match: :query, query: {search_status: nil}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Not subscribed status", path: url_for(sortable_search_params.merge(search_status: "not_subscribed")), match: :query, query: {search_status: "not_subscribed"}) } %>
      <% dropdown.with_entry_divider %>

      <% MailchimpDatum.statuses.each do |status| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{status.humanize} status", path: url_for(sortable_search_params.merge(search_status: status)), match: :query, query: {search_status: status}) } %>
      <% end %>
    <% end %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(name: @search_users == "all" ? "With and without users" : @search_users.humanize, button_size: :sm,
          active: @search_users != "all")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "With and without users", path: url_for(sortable_search_params.merge(search_users: nil)), match: :query, query: {search_users: nil}) } %>
      <% dropdown.with_entry_divider %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "With user", path: url_for(sortable_search_params.merge(search_users: "with_user")), match: :query, query: {search_users: "with_user"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "No user", path: url_for(sortable_search_params.merge(search_users: "no_user")), match: :query, query: {search_users: "no_user"}) } %>
    <% end %>
  </li>

  <li>
    <%= render(UI::Button::Component.new(text: "Toggle data", size: :sm, aria: {expanded: false},
          data: {action: "ui--collapse#toggle", "ui--collapse-target": "trigger"})) %>
  </li>
<% end %>

<% admin_search_form = capture do %>
  <%= form_tag admin_mailchimp_data_path, method: :get, class: "form-inline" do %>
    <%= render partial: "/shared/hidden_search_fields" %>
    <%= hidden_field_tag :search_list, params[:search_list] %>
    <%= hidden_field_tag :search_users, params[:search_users] %>

    <div class="form-group ml-auto mb-0">
      <%= text_field_tag :query, params[:query], placeholder: "Search email", class: "form-control ml-auto" %>
    </div>

    <%= submit_tag "Search", name: "search", class: "btn btn-primary ml-2" %>
  <% end %>
<% end %>

<%#
  The trigger sits in the nav header and the data column in the table, so the
  controller wraps the whole skeleton to reach both
%>

<div data-controller="ui--collapse" data-ui--collapse-duration-value="0">
  <%= render(Admin::IndexSkeleton::Component.new(
    index: admin_index_state,
    collection: @mailchimp_data,
    viewing: "Mailchimp Data",
    nav_header_list_items:,
    admin_search_form:,
    chart_collection: @render_chart && matching_mailchimp_data,
  )) %>
</div>
