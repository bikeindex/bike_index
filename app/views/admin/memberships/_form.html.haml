= render(UI::Card::Component.new) do
  = form_for [:admin, @membership] do |f|
    - if @membership.errors.any?
      = render(UI::Alerts::ObjectError::Component.new(object: @membership, dismissable: true))

    - if @membership.id.blank?
      = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :user_email, required: true)) do
        = render(UI::Forms::Email::Component.new(form_builder: f, attribute: :user_email, required: true))

    = f.hidden_field :timezone, value: "", class: "hiddenFieldTimezone"
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :start_at, kind: :datetime_local_field, required: true, html_options: {step: 60}))

    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :end_at, kind: :datetime_local_field, html_options: {step: 60})) do |group|
      - group.with_helper_text do
        %em leave blank if you want to give a membership for forever. In general, set an end at

    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :level, label_text: "Membership Level")) do
      = render(UI::Forms::RadioButtonGroup::Component.new(name: f.field_name(:level), entries: Membership.levels.keys.map { |level| {value: level, label: Membership.level_humanized(level)} }, selected: @membership.level))

    %div{class: "tw:mt-4"}
      = render(UI::Button::Component.new(text: "Save", color: :primary, type: "submit"))
