<% nav_header_list_items = capture do %>
  <% if current_organization.present? %>
    <li>
      <span class="tw:px-2 tw:py-1">
        <%= link_to current_organization.name, admin_organization_path(current_organization) %>
        Exports
        <small><%= link_to "view orgs view", organization_exports_path(organization_id: current_organization.to_param), class: "less-strong" %></small>
      </span>
    </li>
  <% end %>

  <li>
    <%= render(UI::Dropdown::Component.new(name: (params[:search_kind].blank?) ? "All kinds" : params[:search_kind].humanize, button_size: :sm,
          active: params[:search_kind].present?)) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All kinds", path: url_for(sortable_search_params.merge(search_kind: nil)), match: :query, query: {search_kind: nil}) } %>
      <% dropdown.with_entry_divider %>

      <% Export::VALID_KINDS.each_key do |kind| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: kind.to_s.humanize, path: url_for(sortable_search_params.merge(search_kind: kind)), match: :query, query: {search_kind: kind}) } %>
      <% end %>

      <% dropdown.with_entry_divider %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Avery", path: url_for(sortable_search_params.merge(search_kind: "avery")), match: :query, query: {search_kind: "avery"}) } %>
    <% end %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "Dates", href: url_for(sortable_search_params.merge(search_with_dates: !@with_dates)), size: :sm, active: @with_dates)) %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(name: (params[:search_registrations].blank?) ? "All registrations" : params[:search_registrations].humanize, button_size: :sm,
          active: params[:search_registrations].present?)) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All registrations", path: url_for(sortable_search_params.merge(search_registrations: nil)), match: :query, query: {search_registrations: nil}) } %>
      <% dropdown.with_entry_divider %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Registered", path: url_for(sortable_search_params.merge(search_registrations: "registered")), match: :query, query: {search_registrations: "registered"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Incomplete", path: url_for(sortable_search_params.merge(search_registrations: "incomplete")), match: :query, query: {search_registrations: "incomplete"}) } %>

      <%# the component escapes the label, so writing &amp; here would double-escape %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Incompletes & registrations", path: url_for(sortable_search_params.merge(search_registrations: "incompletes_and_registrations")), match: :query, query: {search_registrations: "incompletes_and_registrations"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Specific", path: url_for(sortable_search_params.merge(search_registrations: "specific")), match: :query, query: {search_registrations: "specific"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Impounded", path: url_for(sortable_search_params.merge(search_registrations: "impounded")), match: :query, query: {search_registrations: "impounded"}) } %>
    <% end %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "Stickers", href: url_for(sortable_search_params.merge(search_stickers: !@stickers)), size: :sm, active: @stickers)) %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "Impounded", href: url_for(sortable_search_params.merge(search_impounded: !@impounded)), size: :sm, active: @impounded)) %>
  </li>
<% end %>

<% table_view = capture do %>
  <%= render(UI::Table::Component.new(records: @collection, render_sortable: true, sort_state:)) do |table| %>
    <% table.column(sortable: "created_at", label: "Date") do |export| %>
      <%= link_to organization_export_path(export, organization_id: export.organization.to_param) do %>
        <%= render UI::Time::Component.new(time: export.created_at) %>
      <% end %>
    <% end %>

    <% if @deleted %>
      <% table.column(sortable: "deleted_at") do |export| %>
        <%= render UI::Time::Component.new(time: export.deleted_at) %>
      <% end %>
    <% end %>

    <% table.column(label: "Progress", header_classes: "tw:font-normal") do |export| %>
      <% progress = export.calculated_progress %>

      <% color = case progress
        when "errored" then :red
        when "finished" then :green
        else :yellow
      end %>

      <%= render UI::Badge::Component.new(text: progress, color:, size: :sm) %>
    <% end %>

    <% table.column(label: "Creator", header_classes: "tw:font-normal") do |export| %>
      <% if export.user_id.present? %>
        <%= export.user.display_name %>
      <% end %>
    <% end %>

    <% table.column(label: "Organization", header_classes: "tw:font-normal") do |export| %>
      <%= render Admin::Organizations::Cell::Component.new(sort_state:, organization: export.organization, render_search: true) %>
    <% end %>

    <% table.column(label: "File", header_classes: "tw:font-normal") do |export| %>
      <% if export.file.url.present? %>
        <small title="<%= export.file.url %>">
          <%= truncate(export.file.url, length: 50) %>
        </small>
      <% end %>
    <% end %>

    <% table.column(label: "Kind", header_classes: "tw:font-normal") do |export| %>
      <% display_kind = export.avery_export? ? "avery" : export.kind %>
      <%= link_to display_kind, url_for(sort_state.search_params.merge(search_kind: display_kind)) %>

      <% if export.assign_bike_codes? %>
        <%= link_to url_for(sort_state.search_params.merge(search_stickers: true)) do %>
          <%= render UI::Badge::Component.new(text: "sticker", title: "Assigned stickers", color: :cyan, size: :sm) %>
        <% end %>
      <% end %>
    <% end %>

    <% table.column(label: "Rows", header_classes: "tw:font-normal") do |export| %>
      <% if export.finished? %>
        <%= number_display(export.rows) %>
      <% end %>
    <% end %>

    <% table.column(label: "Registrations", header_classes: "tw:font-normal") do |export| %>
      <% if export.only_custom_bike_ids %>
        <%= render UI::Badge::Component.new(text: "specific", title: "Only specified registrations", color: :purple, size: :sm) %>
      <% else %>
        <%= export.matching_kinds.map(&:to_s).join(", ") %>
      <% end %>

      <% if export.start_at.present? || export.end_at.present? %>
        <%= link_to url_for(sort_state.search_params.merge(search_with_dates: true)) do %>
          <%= render UI::Badge::Component.new(text: "dates", color: :yellow, size: :sm) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: "Exports",
  nav_header_list_items:,
  table_view:,
  chart_collection: @render_chart && matching_exports,
)) %>
