<%= render Pages::Admin::Bikes::Header::Component.new(bike: @bike, active: :recoveries, stolen_record: @recovery, display_recovery: true, user: current_user, display_dev_info: display_dev_info?) %>

<%= render(Pages::Admin::Headers::Section::Component.new(title: "Manage Recovery Display")) %>

<div class="row tw:text-center">
  <% if @recovery.waiting_on_decision? %>
    <div class="col-md-4">
      <h4>Choose what to do with this recovery:</h4>
    </div>
    <div class="col-6 col-md-4">
      <%= render(UI::ButtonLink::Component.new(text: "Display recovery", href: new_admin_recovery_display_path(stolen_record_id: @recovery.id), color: :primary, size: :lg, html_class: "tw:w-full")) %>
    </div>
    <div class="col-6 col-md-4">
      <%= render(UI::ButtonLink::Component.new(text: "Mark Not Displayable", href: admin_recovery_path(id: @recovery.id, stolen_record: {is_not_displayable: true}),
        method: :put, color: :yellow, size: :lg, html_class: "tw:w-full")) %>
    </div>
  <% elsif @recovery.recovery_displayed? %>
    <div class="col-6">
      <p>This recovery is displayed.</p>
    </div>
    <div class="col-6">
      <%= render(UI::ButtonLink::Component.new(text: "Edit Recovery Display", href: edit_admin_recovery_display_url(@recovery.recovery_display), color: :primary, size: :lg)) %>
    </div>
  <% elsif @recovery.not_displayed? %>
    <div class="col-12">
      <p>This recovery is not displayed.</p>

      <%= render(UI::ButtonLink::Component.new(text: "Mark Eligible for display", href: admin_recovery_path(id: @recovery.id, stolen_record: {mark_as_eligible: true}),
        method: :put, color: :primary, size: :lg)) %>
    </div>
  <% else %>
    <% if !@recovery.recovered? %>
      <div class="col-12">
        <h1 class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:error] %>">
          This <%= @bike.type %> has not been marked recovered
        </h1>
      </div>
      <div class="col-12 mb-4">
        <p class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">
          You're viewing this in error, you shouldn't be on this page
        </p>
      </div>
    <% end %>
    <div class="col-12">
      <h4>
        Display Status:
        <em><%= @recovery.recovery_display_status.humanize %></em>
      </h4>

      <p class="mt-4">
        Really want to display this recovery?
        <%= link_to "Display recovery here", new_admin_recovery_display_path(stolen_record_id: @recovery.id) %>
      </p>
    </div>
  <% end %>
</div>

<hr style="margin: 60px 0 30px;">

<h2>Edit recovery information</h2>

<p>
  You will have a chance to edit the text, when displaying the recovery.
  <em class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">Don't edit to make it displayable.</em>
</p>

<p>Only edit if you want to change what is stored about this recovery.</p>

<details data-controller="ui--details">
  <summary
    data-action="click->ui--details#toggle"
    class="<%= UI::Button::Component.build_classes(color: :link_gray, size: :md, html_class: "tw:cursor-pointer tw:list-none tw:[&::-webkit-details-marker]:hidden") %>"
  >
    show edit form
  </summary>

  <div data-ui--details-target="content" class="tw:hidden!">
    <hr class="mt-5 mb-4">

    <%= form_for([:admin, @recovery], url: { action: "update", controller: "recoveries" }) do |f| %>
      <%= render(UI::Alerts::ObjectError::Component.new(name: "Recovery", object: @recovery)) %>

      <div class="row mt-4">
        <div class="col-md-6">
          <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :recovered_description, kind: :text_area,
            label_text: "Recovery description", html_options: {rows: 4})) %>
        </div>

        <div class="col-md-6">
          <div class="tw:mb-4">
            <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :index_helped_recovery, label: "Index helped recovery")) %>
            <%= render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :can_share_recovery, label: "Can share recovery")) %>
          </div>

          <%= render(UI::Button::Component.new(text: "Update the recovery", color: :primary, type: "submit")) %>
        </div>
      </div>
    <% end %>
  </div>
</details>
