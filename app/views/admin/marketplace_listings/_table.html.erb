<%# locals: (collection:, render_sortable: false, skip_item: false) %>

<div
  data-controller="update-cached-sortable-links"
  data-update-cached-sortable-links-base-url-value="<%= url_for(sort_state.search_params) %>"
>
  <%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:, cache_key: cache_fragment_name(["admin_marketplace_listing", skip_item]))) do |table| %>
    <% table.column(sortable: "created_at", lower_right: ->(record) { tag.span(record.id, class: "only-dev-visible") }) do |marketplace_listing| %>
      <%= link_to admin_marketplace_listing_path(marketplace_listing), class: "twlink" do %>
        <%= render UI::Time::Component.new(time: marketplace_listing.created_at) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "updated_at", classes: "only-dev-visible tw:text-xs") do |marketplace_listing| %>
      <%= render UI::Time::Component.new(time: marketplace_listing.updated_at) %>
    <% end %>

    <% table.column(sortable: "status") do |marketplace_listing| %>
      <%= render Atoms::Admin::Badges::MarketplaceListing::Component.new(status: marketplace_listing.status, status_humanized: marketplace_listing.status_humanized, kind: :marketplace_listing) %>
    <% end %>

    <% table.column(sortable: "published_at") do |marketplace_listing| %>
      <%= render UI::Time::Component.new(time: marketplace_listing.published_at) %>
    <% end %>

    <% table.column(sortable: "end_at") do |marketplace_listing| %>
      <%= render UI::Time::Component.new(time: marketplace_listing.end_at) %>
    <% end %>

    <% unless skip_item %>
      <% table.column(label: "Item", header_classes: "tw:font-normal") do |marketplace_listing| %>
        <%= render Pages::Admin::Bikes::Cell::Component.new(bike: marketplace_listing.item, bike_id: marketplace_listing.item_id, bike_link_path: bike_path(marketplace_listing.item_id, view_as: "marketplace_preview"), search_url: admin_marketplace_listings_path(search_bike_id: marketplace_listing.item_id)) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "amount_cents", label: "Amount") do |marketplace_listing| %>
      <%= helpers.amount_display(marketplace_listing, currency_name_suffix: :if_not_default) %>
    <% end %>

    <% table.column(sortable: "condition") do |marketplace_listing| %>
      <%= marketplace_listing.condition %>
    <% end %>

    <% table.column(label: "City", header_classes: "tw:font-normal") do |marketplace_listing| %>
      <%= render Atoms::Admin::AddressRecordCell::Component.new(address_record: marketplace_listing.address_record) %>
    <% end %>

    <% table.column(sortable: "seller_id") do |marketplace_listing| %>
      <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: marketplace_listing.seller, render_search: true) %>
    <% end %>

    <% table.column(sortable: "buyer_id") do |marketplace_listing| %>
      <% if marketplace_listing.buyer_id.present? %>
        <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: marketplace_listing.buyer, user_id: marketplace_listing.buyer_id, render_search: true) %>
      <% end %>
    <% end %>

    <% table.column(label: "Messages #", header_classes: "tw:font-normal", classes: "tw:text-xs") do |marketplace_listing| %>
      <%= number_display(marketplace_listing.marketplace_messages.count) %>
    <% end %>
  <% end %>
</div>
