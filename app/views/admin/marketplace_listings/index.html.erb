<% if @bike.present? %>
  <%= render partial: "/admin/bikes/bike_tabs", locals: {bike: @bike, active_tab: "marketplace_listings-index"} %>
  <h1 class="mt-5 mb-4">Marketplace Listings</h1>
  <%= render(partial: "table", locals: {collection: @collection, render_sortable: false, skip_item: true}) %>
<% else %>
  <% nav_header_list_items = capture do %>
    <li>
      <% filter_name_1 = (@status.blank?) ? "All statuses" : (@status == "removed_or_sold") ? "Removed or sold" : "#{@status.titleize} only" %>

      <%= render(UI::Dropdown::Component.new(name: filter_name_1, button_size: :sm,
            active: @status.present?)) do |dropdown| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All statuses", path: url_for(sortable_search_params.merge(search_status: nil)), match: :query, query: {search_status: nil}) } %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Removed or sold", path: url_for(sortable_search_params.merge(search_status: "removed_or_sold")), match: :query, query: {search_status: "removed_or_sold"}) } %>
        <% dropdown.with_entry_divider %>

        <% (searchable_statuses - ['removed_or_sold']).each do |kind| %>
          <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{kind.titleize} only", path: url_for(sortable_search_params.merge(search_status: kind)), match: :query, query: {search_status: kind}) } %>
        <% end %>
      <% end %>
    </li>
  <% end %>
  <%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  chart_collection: @render_chart && matching_marketplace_listings, nav_header_list_items:,
)) %>
<% end %>
