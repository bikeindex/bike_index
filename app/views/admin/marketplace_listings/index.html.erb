<% if @bike.present? %>
  <%= render Pages::Admin::Bikes::Header::Component.new(bike: @bike, active: :listings, user: current_user, display_dev_info: display_dev_info?) %>
  <%= render(UI::Header::Component.new(tag: :h2)) do %>
    Marketplace listings
    <%= render(Pages::Admin::Headers::Count::Component.new(count: @pagy.count)) %>
  <% end %>
  <%= render(partial: "table", locals: {collection: @collection, render_sortable: false, skip_item: true}) %>
<% else %>
  <%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  chart_collection: @render_chart && matching_marketplace_listings,
)) do |skeleton| %>
    <% skeleton.with_nav_item do %>
      <% status_filter_name = @status.blank? ? "All statuses" : ({"removed_or_sold" => "Removed or sold"}[@status] || "#{@status.titleize} only") %>

      <%= render(UI::Dropdown::Component.new(name: status_filter_name, button_size: :sm,
            active: @status.present?)) do |dropdown| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All statuses", path: url_for(sortable_search_params.merge(search_status: nil)), match_params: {search_status: nil}) } %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Removed or sold", path: url_for(sortable_search_params.merge(search_status: "removed_or_sold")), match_params: {search_status: "removed_or_sold"}) } %>
        <% dropdown.with_entry_divider %>

        <% (searchable_statuses - ['removed_or_sold']).each do |kind| %>
          <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{kind.titleize} only", path: url_for(sortable_search_params.merge(search_status: kind)), match_params: {search_status: kind}) } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
