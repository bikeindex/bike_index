<%= render(Pages::Admin::Headers::Nav::Component.new(title: "Marketplace Listing")) %>

<div class="twwiderow tw:mt-6 tw:items-start">
  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "ID", dev_only: true, value: tag.code(@marketplace_listing.id, class: "twcode"), if: display_dev_info?) %>

    <% list.with_row(label: "Status", value: render(Atoms::Admin::Badges::MarketplaceListing::Component.new(status: @marketplace_listing.status, status_humanized: @marketplace_listing.status_humanized, kind: :marketplace_listing))) %>

    <% list.with_row(label: "Seller", value: render(Atoms::Admin::TableCells::User::Component.new(user: @marketplace_listing.seller, user_id: @marketplace_listing.seller_id))) %>

    <% list.with_row(label: "Buyer", value: render(Atoms::Admin::TableCells::User::Component.new(user: @marketplace_listing.buyer, user_id: @marketplace_listing.buyer_id)), if: @marketplace_listing.buyer.present?) %>

    <% list.with_row(label: "Price") do %>
      <%= amount_display(@marketplace_listing, currency_name_suffix: true) %>

      <% if @marketplace_listing.price_negotiable? %>
        <small class="twless-strong">(negotiable)</small>
      <% end %>
    <% end %>

    <% list.with_row(label: "Condition", value: @marketplace_listing.condition_humanized) %>

    <% list.with_row(label: "Created", class: "tw:text-sm", value: render(UI::Time::Component.new(time: @marketplace_listing.created_at, format: :localize_time_precise))) %>

    <% list.with_row(label: "Published", class: "tw:text-sm", value: render(UI::Time::Component.new(time: @marketplace_listing.published_at, format: :localize_time_precise)), if: @marketplace_listing.published_at.present?) %>

    <% list.with_row(label: "Ended", class: "tw:text-sm", value: render(UI::Time::Component.new(time: @marketplace_listing.end_at, format: :localize_time_precise)), if: @marketplace_listing.end_at.present?) %>
  <% end %>

  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "Item") do %>
      <% if @marketplace_listing.item.is_a?(Bike) %>
        <%= render Atoms::Admin::TableCells::Bike::Component.new(bike: @marketplace_listing.item, bike_id: @marketplace_listing.item_id, bike_link_path: bike_path(@marketplace_listing.item_id, view_as: "marketplace_preview")) %>
      <% elsif @marketplace_listing.item.is_a?(BikeVersion) %>
        BikeVersion
        <%= link_to @marketplace_listing.item_id, bike_version_path(@marketplace_listing.item_id), class: "twlink" %>


        <small>(bike: <%= link_to @marketplace_listing.item.bike_id, admin_bike_path(@marketplace_listing.item.bike_id), class: "twlink" %>)</small>
      <% end %>
    <% end %>

    <% list.with_row(label: "Sale", if: @marketplace_listing.sale.present?) do %>
      <%= link_to(@marketplace_listing.sale_id, admin_sale_path(@marketplace_listing.sale_id), class: "twlink") %>
    <% end %>

    <% list.with_row(label: "Location", value: render(Atoms::Admin::TableCells::AddressRecord::Component.new(address_record: @marketplace_listing.address_record))) %>

    <% list.with_row(label: "Description", value: render(UI::UserTextBlockDisplay::Component.new(text: @marketplace_listing.description, max_height_class: ""))) %>
  <% end %>
</div>

<div class="tw:mt-10">
  <% messages_count = @marketplace_listing.marketplace_messages.count %>

  <%= render(UI::Header::Component.new(tag: :h2, html_class: "twsection")) do %>
    <%= link_to(safe_join([number_display(messages_count), " ", "message".pluralize(messages_count)]), admin_marketplace_messages_path(search_marketplace_listing_id: @marketplace_listing.id), class: "twlink") %>

    <span class="tw:font-normal">
      <% if messages_count > @marketplace_messages.count %>
        <small>
          most recent <%= number_display(@marketplace_messages.count) %> shown
        </small>
      <% end %>
    </span>
  <% end %>

  <%= render partial: "/admin/marketplace_messages/table", locals: { collection: @marketplace_messages, render_sortable: false, skip_marketplace_listing: true } %>
</div>
