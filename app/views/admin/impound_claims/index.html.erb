<% nav_header_list_items = capture do %>
  <li>
    <% status_filter_name = if @search_status != "current" && ImpoundClaim.statuses.include?(@search_status)
         ImpoundClaim.status_humanized(@search_status.to_sym)
       else
         @search_status == "all" ? "All statuses" : "#{@search_status.titleize} records"
       end %>

    <%= render(UI::Dropdown::Component.new(name: status_filter_name, button_size: :sm,
          active: @search_status != available_statuses.first)) do |dropdown| %>
      <% available_statuses.each do |status| %>
        <% if status != "current" && ImpoundClaim.statuses.include?(status) %>
          <% display_status = ImpoundClaim.status_humanized(status) %>
        <% elsif status == "all" %>
          <% display_status = "All statuses" %>
        <% else %>
          <% display_status = "#{status.titleize} records" %>
        <% end %>

        <% status_active = @search_status == status %>
        <% status_link_params = sortable_search_params.merge(search_status: (status_active ? nil : status)) %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: display_status, path: admin_impound_claims_path(status_link_params), match_params: {search_status: status}) } %>

        <% if status == "resolved" %>
          <% dropdown.with_entry_divider %>
        <% end %>
      <% end %>
    <% end %>
  </li>
<% end %>

<% rendered_chart = nil %>

<% if @render_chart %>
  <% rendered_chart = capture do %>
    <% data = UI::Chart::Component.time_range_counts(collection: matching_impound_claims, time_range: @time_range, column: "created_at") %>
    <%= render(UI::Chart::Component.new(series: [{name: "Impound Claims", data:}], time_range: @time_range, stacked: true)) %>

    <% unless params[:organization_id].present? %>
      <%= render(UI::Container::Component.new) do %>
        <%= render(UI::TableList::Component.new(wide_definition: true, classes: "tw:mt-6")) do |list| %>
          <% matching_impound_claims.distinct.pluck(:organization_id).map { |id| [id, matching_impound_claims.where(organization_id: id).count] }.sort_by { |_id, number| number }.each do |id, number| %>
            <% organization = Organization.unscoped.find_by_id(id) if id.present? %>

            <% list.with_row(label: (organization.present? ? link_to(organization.short_name, admin_impound_claims_path(sortable_search_params.merge(organization_id: id)), class: (organization.deleted? ? "text-danger" : "")) : render(UI::ButtonLink::Component.new(href: admin_impound_claims_path(sortable_search_params.merge(organization_id: "none")), text: "no organization", color: :link_gray))), value: number_with_delimiter(number)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% table_view = capture do %>
  <%= render partial: "table", locals: {impound_claims: @impound_claims, render_sortable: true, skip_organization: current_organization.present?} %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @impound_claims,
  viewing: "Impound Claims",
  nav_header_list_items:,
  rendered_chart:,
  table_view:,
)) %>
