<%# locals: (impound_claims:, render_sortable: false, skip_organization: false) %>

<%= render(UI::Table::Component.new(records: impound_claims, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at") do |impound_claim| %>
    <%= link_to render(UI::Time::Component.new(time: impound_claim.created_at, format: :localize_time_precise)), admin_impound_claim_path(impound_claim), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "updated_at") do |impound_claim| %>
    <%= render(UI::Time::Component.new(time: impound_claim.updated_at, format: :localize_time_precise)) %>
  <% end %>

  <% unless skip_organization %>
    <% table.column(sortable: "organization_id") do |impound_claim| %>
      <% if impound_claim.organization_id.present? %>
        <%= link_to impound_claim.organization&.short_name || impound_claim.organization_id, admin_impound_claims_path(sort_state.search_params.merge(organization_id: impound_claim.organization_id)), class: "twlink" %>
      <% end %>
    <% end %>
  <% end %>

  <% table.column(sortable: "impound_record_id", label: "Impound ID", header_classes: "tw:text-xs") do |impound_claim| %>
    <% if impound_claim.impound_record %>
      <% if impound_claim.organization.present? %>
        <%= link_to "##{impound_claim.impound_record.display_id}", organization_impound_record_path(impound_claim.impound_record.display_id, organization_id: impound_claim.organization_id), class: "twlink" %>
      <% else %>
        <small class="only-dev-visible"><%= impound_claim.impound_record.id %></small>
      <% end %>
    <% end %>
  <% end %>

  <% table.column(label: "Claimed") do |impound_claim| %>
    <%= render Atoms::Admin::TableCells::Bike::Component.new(bike: impound_claim.bike_claimed, bike_id: impound_claim.bike_claimed_id) %>
  <% end %>

  <% table.column(label: "Submitted") do |impound_claim| %>
    <%= render Atoms::Admin::TableCells::Bike::Component.new(bike: impound_claim.bike_submitting, bike_id: impound_claim.bike_submitting_id) %>
  <% end %>

  <% table.column(sortable: "status") do |impound_claim| %>
    <em><%= helpers.status_display(impound_claim.status_humanized) %></em>
  <% end %>

  <% table.column(sortable: "user_id") do |impound_claim| %>
    <%= impound_claim.user&.display_name&.truncate(20) %>
  <% end %>

  <% table.column(sortable: "resolved_at") do |impound_claim| %>
    <% if impound_claim.resolved_at.present? %>
      <%= render(UI::Time::Component.new(time: impound_claim.resolved_at, format: :localize_time_precise)) %>
    <% end %>
  <% end %>
<% end %>
