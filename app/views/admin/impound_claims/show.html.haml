-# TODO: make this better. Leaves much to be desired

- impound_record_id = @impound_record.display_id || @impound_record.id
- @bike_claimed = @impound_claim.bike_claimed
- @bike_submitting = @impound_claim.bike_submitting
- organization_name = @impound_claim.organization.present? ? @impound_claim.organization.name : @impound_claim.organization_id

= render(Pages::Admin::Headers::Nav::Component.new(title: safe_join(["#{@impound_claim.claim_kind_humanized.titleize} for ", link_to("impound record ##{impound_record_id}", admin_impound_record_path("pkey-#{@impound_record.id}"), class: "twlink")]))) do |nav|
  - if organization_name.present?
    - nav.with_item do
      = link_to "View claim in organization", organization_impound_claim_path(@impound_claim.id, organization_id: @impound_claim.organization_id), class: "twlink"
.twwiderow{class: "tw:items-start"}
  = render(UI::TableList::Component.new) do |list|
    - list.with_row(label: "Created", value: render(UI::Time::Component.new(time: @impound_claim.created_at, format: :localize_time_precise)))
    - list.with_row(label: "Updated", value: render(UI::Time::Component.new(time: @impound_claim.updated_at, format: :localize_time_precise)))
    - list.with_row(label: "Status") do
      %em
        = status_display(@impound_claim.status_humanized)
    - list.with_row(label: "Organization") do
      - if organization_name.present?
        = link_to organization_name, admin_organization_path(@impound_claim.organization_id), class: "twlink"
      - else
        %small.twless-strong NO organization
    - list.with_row(label: "Bike claimed", value: (link_to(organized_bike_text(@bike_claimed), edit_admin_bike_path(@bike_claimed), class: "twlink") if @bike_claimed.present?))
  = render(UI::TableList::Component.new) do |list|
    - list.with_row(label: "Bike Submitted", value: (link_to(organized_bike_text(@bike_submitting), edit_admin_bike_path(@bike_submitting), class: "twlink") if @bike_submitting.present?))
    - list.with_row(label: "Impound record") do
      - if @impound_record.present?
        = link_to impound_record_id, admin_impound_record_path("pkey-#{@impound_record.id}"), class: "twlink"
        - if organization_name.present?
          %small.twless-strong= link_to "view in organization", organization_impound_record_path(impound_record_id, organization_id: @impound_claim.organization_id), class: "twlink"
    - list.with_row(label: "User", value: @impound_claim.user&.display_name&.truncate(20))
    - list.with_row(label: "Resolved", value: render(UI::Time::Component.new(time: @impound_claim.resolved_at, format: :localize_time_precise)))
