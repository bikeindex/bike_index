<%# locals: (user_alerts:, render_sortable: false, skip_user: false) %>
<%# render_message ||= false # Hidden by default, I don't think this is really a thing %>

<%= render(UI::Table::Component.new(records: user_alerts, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at") do |user_alert| %>
    <%= render UI::Time::Component.new(time: user_alert.created_at) %>
  <% end %>

  <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |user_alert| %>
    <%= render UI::Time::Component.new(time: user_alert.updated_at) %>
  <% end %>

  <% table.column(sortable: "kind") do |user_alert| %>
    <%= user_alert.kind_humanized %>
  <% end %>

  <% unless skip_user %>
    <% table.column(sortable: "user_id") do |user_alert| %>
      <% if user_alert.user_id.present? %>
        <% if user_alert.user.present? %>
          <%= link_to user_alert.user.email, admin_user_path(user_alert.user_id), class: "twlink" %>
        <% else %>
          <%# Handle deleted users %>
          <% user = User.unscoped.find_by_id(user_alert.user_id) %>
          <% if user.present? %>
            <%= link_to user.email, admin_user_path(user_alert.user_id), class: "twlink" %>
            <small class="text-danger">user deleted</small>
          <% else %>
            <small class="text-danger">missing user: <%= user_alert.user_id %></small>
          <% end %>
        <% end %>
        <%= link_to "alerts", url_for(sort_state.search_params.merge(user_id: user_alert.user_id)), class: "small gray-link" %>
      <% end %>
    <% end %>
  <% end %>

  <% table.column(label: "Object", header_classes: "tw:font-normal") do |user_alert| %>
    <% if user_alert.bike_id.present? %>
      <span class="d-block">
        <small>bike:</small>
        <%= link_to user_alert.bike_id, admin_bike_path(user_alert.bike_id), class: "twlink" %>
        <%= link_to "alerts", url_for(sort_state.search_params.merge(search_bike_id: user_alert.bike_id)), class: "small gray-link" %>
      </span>
    <% end %>

    <% if (alertable = user_alert.alertable) %>
      <span class="d-block">
        <small><%= alertable.class.polymorphic_name.underscore %>:</small>
        <%= link_to alertable.id, helpers.admin_path_for_object(alertable), class: "twlink" %>
      </span>
    <% end %>

    <% if user_alert.organization.present? %>
      <span class="d-block">
        <small>organization:</small>
        <%= link_to user_alert.organization&.short_name || user_alert.organization_id, admin_organization_path(user_alert.organization_id), class: "twlink" %>
        <%= link_to "alerts", url_for(sort_state.search_params.merge(organization_id: user_alert.organization_id)), class: "small gray-link" %>
      </span>
    <% end %>
  <% end %>

  <% table.column(sortable: "dismissed_at") do |user_alert| %>
    <% if user_alert.dismissed_at.present? %>
      <%= render UI::Time::Component.new(time: user_alert.dismissed_at) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "resolved_at") do |user_alert| %>
    <% if user_alert.resolved_at.present? %>
      <%= render UI::Time::Component.new(time: user_alert.resolved_at) %>
    <% end %>
  <% end %>

  <% table.column(label: "Notified", header_classes: "tw:font-normal tw:text-xs") do |user_alert| %>
    <%= check_mark if user_alert.notification.present? %>
  <% end %>

  <%# unless render_message %>
  <%# table.column(label: "Message", header_classes: "tw:font-normal tw:text-xs") do |user_alert| %>
  <%# <small>user_alert.message</small> %>
  <%# end %>
  <%# end %>
<% end %>
