<%= render Pages::Admin::Bikes::Header::Component.new(bike: @bike, active: @active_tab.to_sym,
      display_recovery: @active_tab == "recoveries", user: current_user, display_dev_info: display_dev_info?) %>

<% case @active_tab %>
<% when "ownerships" %>
  <%= render(UI::Header::Component.new(tag: :h2)) do %>
    Ownerships
    <%= render(Pages::Admin::Headers::Count::Component.new(count: @bike.ownerships.count)) %>
  <% end %>

  <%= render partial: "/admin/ownerships/table",
        locals: {ownerships: @bike.ownerships.reorder(created_at: :desc), skip_bike: true} %>
<% when "stickers" %>
  <%= render(UI::Header::Component.new(tag: :h2)) do %>
    Stickers
    <%= render(Pages::Admin::Headers::Count::Component.new(count: @bike.bike_stickers.count)) %>
  <% end %>

  <%= render partial: "/admin/bike_stickers/table", locals: {bike_stickers: @bike.bike_stickers} %>
<% when "duplicates" %>
  <%# The tab counts active groups; ignored ones still list here, to un-ignore %>
  <% grouped_segments = @bike.normalized_serial_segments.joins(:duplicate_bike_group)
       .includes(:duplicate_bike_group).order("duplicate_bike_groups.ignore, duplicate_bike_groups.id") %>

  <% grouped_segments.each do |grouped_segment| %>
    <% duplicate_group = grouped_segment.duplicate_bike_group %>

    <div
      class="
        tw:mt-4 tw:flex tw:flex-wrap tw:items-baseline tw:justify-between
        tw:gap-2
      "
    >
      <span>
        <strong><%= grouped_segment.segment %></strong>

        <% if duplicate_group.ignore? %>
          <%= render UI::Badge::Component.new(text: "Ignored", color: :gray, size: :sm) %>
        <% end %>
      </span>

      <span class="tw:flex tw:gap-3">
        <%= render(UI::ButtonLink::Component.new(text: "Review group", href: admin_duplicate_bike_path(duplicate_group), color: :link, html_class: "tw:text-sm")) %>

        <%= render(UI::ButtonLink::Component.new(text: "#{duplicate_group.ignore? ? "un-ignore" : "ignore"} #{grouped_segment.segment}", method: :put,
              href: ignore_duplicate_toggle_admin_bikes_path(id: duplicate_group.id), color: :link, html_class: "tw:text-sm",
              confirm: duplicate_group.ignore_toggle_confirm)) %>
      </span>
    </div>

    <%# An ignored group can be a placeholder serial shared by thousands, so only active ones list their bikes %>
    <% unless duplicate_group.ignore? %>
      <%= render Pages::Admin::Bikes::Table::Component.new(bikes: duplicate_group.bikes, sort_state:,
            no_show_header: true, show_serial: true) %>
    <% end %>
  <% end %>

  <% if grouped_segments.none? %>
    <%= render(UI::Header::Component.new(text: "No duplicates", tag: :h2)) %>
  <% end %>
<% when "messages" %>
  <%= render(Pages::Admin::Bikes::Show::Messages::Component.new(bike: @bike)) %>
<% when "recoveries" %>
  <%= render(UI::Header::Component.new(tag: :h2)) do %>
    Recoveries
    <%= render(Pages::Admin::Headers::Count::Component.new(count: @bike.recovered_records.count)) %>
  <% end %>

  <%= render(Pages::Admin::Recoveries::Table::Component.new(recoveries: @bike.recovered_records, sort_state:, editable: false)) %>

  <%= render(UI::Header::Component.new(tag: :h2)) do %>
    Other stolen records
    <%= render(Pages::Admin::Headers::Count::Component.new(count: @bike.stolen_records.count)) %>
  <% end %>

  <% if @bike.stolen_records.none? %>
    No other stolen records
  <% else %>
    <ul class="tw:mb-4">
      <% @bike.stolen_records.each do |stolen_record| %>
        <li>
          Stolen on
          <%= link_to edit_admin_stolen_bike_url(stolen_record, stolen_record_id: true), class: "twlink" do %>
            <%= render(UI::Time::Component.new(time: stolen_record.date_stolen)) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% when "impound" %>
  <%= render(UI::Header::Component.new(tag: :h2)) do %>
    Impound records for this <%= @bike.type %>
    <%= render(Pages::Admin::Headers::Count::Component.new(count: @bike.impound_records.count, href: admin_impound_records_path(search_bike_id: @bike.id))) %>
  <% end %>

  <%= render partial: "/admin/impound_records/table",
        locals: {impound_records: @bike.impound_records.reorder(created_at: :desc), skip_claims: true} %>

  <% impound_claims = ImpoundClaim.involving_bike_id(@bike.id).reorder(created_at: :desc) %>

  <%= render(UI::Header::Component.new(tag: :h2)) do %>
    Impound claims involving this <%= @bike.type %>
    <%= render(Pages::Admin::Headers::Count::Component.new(count: impound_claims.count, href: admin_impound_claims_path(search_bike_id: @bike.id))) %>
  <% end %>

  <%= render partial: "/admin/impound_claims/table", locals: {impound_claims:} %>
<% end %>
