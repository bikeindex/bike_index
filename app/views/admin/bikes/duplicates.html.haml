%h1
  Possible duplicate bikes

= render(Admin::PaginationWithCount::Component.new(collection: @duplicate_groups, index: admin_index_state, count: @duplicate_groups_count))

- @duplicate_groups.each do |duplicate_group|
  .row
    .col-lg-6
      %p
        %strong
          #{duplicate_group.segment}
    .col-lg-6
      = link_to "ignore #{duplicate_group.segment}", ignore_duplicate_toggle_admin_bikes_path(id: duplicate_group.id), method: 'PUT', class: 'float-right less-strong'

  = render Admin::BikesTable::Component.new(bikes: duplicate_group.bikes, sort_state:, display_dev_info: display_dev_info?, no_show_header: true, show_serial: true)


= render(Admin::PaginationWithCount::Component.new(collection: @duplicate_groups, index: admin_index_state, skip_total: true))
