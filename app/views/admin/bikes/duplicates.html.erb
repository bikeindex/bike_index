<h1>Possible duplicate bikes</h1>

<%= render(Pages::Admin::PaginationWithCount::Component.new(collection: @duplicate_groups, index: admin_index_state, count: @duplicate_groups_count)) %>

<% @duplicate_groups.each do |duplicate_group| %>
  <div
    class="
      tw:mt-4 tw:flex tw:flex-wrap tw:items-baseline tw:justify-between
      tw:gap-2
    "
  >
    <strong><%= duplicate_group.segment %></strong>

    <%= link_to "ignore #{duplicate_group.segment}", ignore_duplicate_toggle_admin_bikes_path(id: duplicate_group.id),
          method: :put, class: "twlink tw:text-sm" %>
  </div>

  <%= render Pages::Admin::Bikes::Table::Component.new(bikes: duplicate_group.bikes, sort_state:,
        display_dev_info: display_dev_info?, no_show_header: true, show_serial: true) %>
<% end %>

<%= render(Pages::Admin::PaginationWithCount::Component.new(collection: @duplicate_groups, index: admin_index_state, skip_total: true)) %>
