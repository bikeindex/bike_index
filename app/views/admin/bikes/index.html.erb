<% show_search_statuses = !@ignored_only %>

<% nav_header_list_items = capture do %>
  <% if show_search_statuses %>
    <li>
      <%#
        The legacy admin bundle toggles .active here as it opens the collapse, so that
        class is the only thing that can say whether the panel is open -- data-active
        would be stuck at whatever the server rendered. Fill mirrors ACTIVE_COLORS[:secondary].
      %>

      <%= render(UI::Button::Component.new(text: "Search statuses", size: :sm, id: "showStatusesSearch",
            html_class: "#{"active" if @not_default_statuses} tw:[&.active]:bg-purple-500 " \
              "tw:[&.active]:text-white tw:[&.active]:border-purple-500 " \
              "tw:[&.active]:ring-2 tw:[&.active]:ring-purple-500/40")) %>
    </li>
  <% end %>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "motorized", href: url_for(sortable_search_params.merge(search_motorized: !@motorized)), size: :sm, active: @motorized)) %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "multi-delete", href: url_for(sortable_search_params.merge(search_multi_delete: !@multi_delete)), size: :sm, active: @multi_delete)) %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "Unknown Mnfgs", href: missing_manufacturer_admin_bikes_path, size: :sm, active: @unknown)) %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(name: @origin_search_type.presence&.humanize || "Origin", button_size: :sm,
          active: @origin_search_type.present?)) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Any Origin", path: url_for(sortable_search_params.merge(search_origin: nil)), match: :query, query: {search_origin: nil}) } %>
      <% dropdown.with_entry_divider %>

      <% Ownership.origins.each do |origin| %>
        <% origin_active = @origin_search_type == origin %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: origin.humanize, path: url_for(sortable_search_params.merge(search_origin: origin_active ? nil : origin)), match: :query, query: {search_origin: origin}) } %>
      <% end %>
    <% end %>
  </li>

  <li>
    <% pos_filter_name = {"any_pos" => "POS of any type"}[@pos_search_type] || @pos_search_type.presence&.humanize || "POS" %>

    <%= render(UI::Dropdown::Component.new(name: pos_filter_name, button_size: :sm,
          active: @pos_search_type.present?)) do |dropdown| %>
      <% ascend_active = @pos_search_type == "ascend_pos" %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Ascend", path: url_for(sortable_search_params.merge(search_pos: ascend_active ? nil : "ascend_pos")), match: :query, query: {search_pos: "ascend_pos"}) } %>
      <% lightspeed_active = @pos_search_type == "lightspeed_pos" %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Lightspeed", path: url_for(sortable_search_params.merge(search_pos: lightspeed_active ? nil : "lightspeed_pos")), match: :query, query: {search_pos: "lightspeed_pos"}) } %>
      <% dropdown.with_entry_divider %>
      <% any_pos_active = @pos_search_type == "any_pos" %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "POS of any type", path: url_for(sortable_search_params.merge(search_pos: any_pos_active ? nil : "any_pos")), match: :query, query: {search_pos: "any_pos"}) } %>
      <% no_pos_active = @pos_search_type == "no_pos" %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: safe_join([tag.strong("Not"), " POS"]), path: url_for(sortable_search_params.merge(search_pos: no_pos_active ? nil : "no_pos")), match: :query, query: {search_pos: "no_pos"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "any (POS or not)", path: url_for(sortable_search_params.merge(search_pos: nil)), match: :query, query: {search_pos: nil}) } %>
    <% end %>
  </li>

  <li>
    <%# If looking at year or all period, graphs aren't detailed %>
    <% search_period = %w[all year].include?(@period) ? "month" : @period %>
    <%= render(UI::ButtonLink::Component.new(text: "Detailed graphs", href: admin_graphs_path(sortable_search_params.merge(search_kind: "bikes", period: search_period)), size: :sm)) %>
  </li>
<% end %>

<% rendered_chart = nil %>

<% if @render_chart %>
  <% rendered_chart = capture do %>
    <% series = [{name: "Bikes", data: UI::Chart::Component.time_range_counts(collection: available_bikes.reorder(nil), time_range: @time_range, column: "bikes.created_at")}] %>
    <%= render(UI::Chart::Component.new(series:, time_range: @time_range)) %>
  <% end %>
<% end %>

<% admin_search_form = capture do %>
  <div class="row mt-4">
    <div class="col-md-6 order-2 order-md-1">
      <% if current_organization.present? %>
        <p>
          <% if params[:search_only_creation_organization].present? %>
            Viewing only bikes created by
            <em><%= current_organization.name %></em>
            <%= link_to "view all associated bikes", url_for(sortable_search_params.merge(search_only_creation_organization: nil)) %>
          <% else %>
            Viewing all associated <em><%= current_organization.name %></em>
            bikes -
            <%= link_to "view only bikes created by", url_for(sortable_search_params.merge(search_only_creation_organization: true)) %>
          <% end %>
          |
          <%= link_to "org bikes view", organization_registrations_path(organization_id: current_organization.to_param) %>
        </p>
      <% end %>

      <% if @ignored_only %>
        <p>
          Viewing only <strong>ignored</strong> bikes
          <em>(deleted, test, spam)</em>
          <%= link_to "view not ignored bikes", url_for(sortable_search_params.merge(search_ignored: false)), class: "gray-link small" %>
        </p>
      <% end %>

      <% if @search_email.present? %>
        <p>
          Viewing only bikes <strong>sent to</strong>
          <code><%= @search_email %></code>
          <%= link_to "view sent to any emails", url_for(sortable_search_params.merge(search_email: nil)), class: "gray-link small" %>
        </p>
      <% end %>

      <% if @search_domain.present? %>
        <p>
          Viewing only bikes <strong>from the domain</strong>
          <code><%= @search_domain %></code>
          <%= link_to "view sent to any domain", url_for(sortable_search_params.merge(search_domain: nil)), class: "gray-link small" %>
        </p>
      <% end %>

      <% if params[:search_model_audit_id].present? %>
        <p>
          Viewing only for model audit
          <% if @model_audit.present? %>
            <%= model_audit_display(@model_audit, truncate: true) %>
          <% else %>
            <code>ID: <%= params[:search_model_audit_id] %></code>
          <% end %>
          <%= link_to "view for any model audit", url_for(sortable_search_params.merge(search_model_audit_id: nil)), class: "gray-link small" %>
        </p>
      <% end %>

      <% if params[:search_doorkeeper_app_id].present? %>
        <p>
          Viewing only for API Application
          <% if @doorkeeper_app.present? %>
            <%= link_to @doorkeeper_app.name, oauth_application_path(@doorkeeper_app) %>
          <% else %>
            <code>ID: <%= params[:search_doorkeeper_app_id] %></code>
            <span class="less-strong">(no app with that ID)</span>
          <% end %>
          <%= link_to "view for any API Application", url_for(sortable_search_params.merge(search_doorkeeper_app_id: nil)), class: "gray-link small" %>
          <em class="less-strong tw:text-xs">
            NOTE: only tracked since
            <span class="localizeTime"><%= START_TRACKING_REGISTRATION_APP_ID_AT %></span>
          </em>
        </p>
      <% end %>

      <% if params[:serial].present? %>
        <p>
          Viewing only bikes <strong>with normalized serials matching</strong>
          <code><%= @serial_normalized %></code>
          <%= link_to "view with any serial", url_for(sortable_search_params.merge(serial: nil)), class: "gray-link small" %>
        </p>
      <% end %>

      <% if params[:search_manufacturer].present? %>
        <p>
          <% if @manufacturer.present? %>
            Made by
            <%= link_to @manufacturer.name, admin_manufacturer_path(@manufacturer) %>
            <% if @manufacturer.official_organization.present? %>
              <small class="less-strong">
                (view
                <%= link_to "official org", admin_organization_path(@manufacturer.official_organization.to_param) %>)
              </small>
            <% end %>
          <% else %>
            No manufacturer found for
            <code><%= params[:search_manufacturer] %></code>
          <% end %>

          <%= link_to "view all manufacturer bikes", url_for(sortable_search_params.merge(search_manufacturer: nil)), class: "gray-link small" %>
        </p>
      <% end %>
    </div>

    <div class="col-md-6 order-1 order-md-2">
      <%= form_tag admin_bikes_path, method: :get do %>
        <%= render partial: "/shared/hidden_search_fields", locals: {include_primary_activity: true} %>

        <%= hidden_field_tag :search_pos, params[:search_pos] %>
        <%= hidden_field_tag :search_origin, params[:search_origin] %>
        <%= hidden_field_tag :search_only_creation_organization, params[:search_only_creation_organization] %>

        <% if show_search_statuses %>
          <%= render partial: "/admin/bikes/search_statuses" %>
        <% end %>

        <div class="form-inline">
          <div class="form-group ml-auto mr-1 mb-2">
            <%= text_field_tag :serial, params[:serial], placeholder: "Find by serial", class: "form-control" %>
          </div>

          <div class="form-group mr-1 mb-2">
            <%= text_field_tag :search_phone, params[:search_phone], placeholder: "Find by phone", class: "form-control" %>
          </div>

          <div class="form-group mr-1 mb-2">
            <% if @search_domain.present? %>
              <%= text_field_tag :search_domain, @search_domain, placeholder: "Search bikes by domain", class: "form-control" %>
            <% else %>
              <%= text_field_tag :search_email, params[:search_email], placeholder: "Search bikes by email", class: "form-control" %>
            <% end %>
          </div>

          <%= submit_tag "Search", name: "search", class: "btn btn-primary mb-2" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% count_detail = capture do %>
  &mdash; <%= number_display(Bike.count) %> publicly registered
  <em>(<%= number_display(Bike.where("created_at >= ?", Time.current.beginning_of_day).count) %> today)</em>,
  <%= number_display(Ownership.where(current: true, claimed: true).count) %>
  claimed, <%= number_display(PublicImage.count) %> bike images
  <em>(<%= number_display(PublicImage.where("created_at >= ?", Time.current.beginning_of_day).count) %> today)</em>
<% end unless admin_search_filtered? %>

<% table_view = capture do %>
  <%= render Admin::Bikes::Table::Component.new(bikes: @bikes, sort_state:, display_dev_info: display_dev_info?, show_serial: params[:show_serial].present?, skip_manufacturer_link: params[:search_manufacturer].present?, render_sortable: true, render_multi_check: @multi_delete) %>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @bikes,
  viewing: "Bikes",
  nav_header_list_items:,
  rendered_chart:,
  admin_search_form:,
  table_view:,
  count_detail:,
)) %>
