<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(
      name: @imageable_type.present? ? "#{@imageable_type} only" : "All types",
      button_size: :sm,
      active: @imageable_type.present?
    )) do |dropdown|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All types", path: url_for(sortable_search_params.merge(search_imageable_type: nil)), match_params: {search_imageable_type: UI::ActiveLink::Component::BLANK}) }
      dropdown.with_entry_divider
      PublicImage::IMAGEABLE_TYPES.each do |imageable_type|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{imageable_type} only", path: url_for(sortable_search_params.merge(search_imageable_type: imageable_type)), match_params: {search_imageable_type: imageable_type}) }
      end
    end %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(
      name: @kind.present? ? "#{@kind.titleize} only" : "All kinds",
      button_size: :sm,
      active: @kind.present?
    )) do |dropdown|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All kinds", path: url_for(sortable_search_params.merge(search_kind: nil)), match_params: {search_kind: UI::ActiveLink::Component::BLANK}) }
      dropdown.with_entry_divider
      PublicImage.kinds.each do |kind|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{kind.titleize} only", path: url_for(sortable_search_params.merge(search_kind: kind)), match_params: {search_kind: kind}) }
      end
    end %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(
      name: @storage.present? ? "Only #{storage_filters[@storage]}" : "All storage",
      button_size: :sm,
      active: @storage.present?
    )) do |dropdown|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All storage", path: url_for(sortable_search_params.merge(search_storage: nil)), match_params: {search_storage: UI::ActiveLink::Component::BLANK}) }
      dropdown.with_entry_divider
      storage_filters.each do |value, label|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Only #{label}", path: url_for(sortable_search_params.merge(search_storage: value)), match_params: {search_storage: value}) }
      end
    end %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "Private", href: url_for(sortable_search_params.merge(search_private: !@private)), size: :sm, active: @private)) %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "Show size", href: url_for(sortable_search_params.merge(search_size: !@render_size)), size: :sm, active: @render_size)) %>
  </li>
<% end %>

<% rendered_chart = capture do %>
  <% if @render_chart %>
    <% chart_types = @imageable_type.present? ? [@imageable_type] : PublicImage::IMAGEABLE_TYPES %>
    <% series = chart_types.map { {name: it, data: UI::Chart::Component.time_range_counts(collection: matching_public_images.where(imageable_type: it), time_range: @time_range, column: @time_range_column)} } %>
    <%= render(UI::Chart::Component.new(series:, time_range: @time_range, stacked: true)) %>
  <% end %>
<% end %>

<% table_view = capture do %>
  <%= render partial: "table", locals: {collection: @collection, render_sortable: true, render_size: @render_size} %>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  nav_header_list_items:, rendered_chart:, table_view:,
)) %>
