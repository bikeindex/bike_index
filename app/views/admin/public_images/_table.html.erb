<%# locals: (collection:, render_sortable: false, render_size: false) %>

<div
  data-controller="update-cached-sortable-links"
  data-update-cached-sortable-links-base-url-value="<%= url_for(sortable_search_params) %>"
>
  <%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:, cache_key: cache_fragment_name(["admin_public_image", render_sortable, render_size]))) do |table| %>
    <% table.column(sortable: "created_at", lower_right: ->(public_image) { content_tag(:span, public_image.id, class: "only-dev-visible") }) do |public_image| %>
      <%= render UI::Time::Component.new(time: public_image.created_at) %>
    <% end %>

    <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |public_image| %>
      <%= render UI::Time::Component.new(time: public_image.updated_at, format: :localize_time_precise) %>
    <% end %>

    <% table.column(label: "Image", header_classes: "tw:font-normal") do |public_image| %>
      <% image_url = public_image.image_url %>

      <% if image_url.present? %>
        <%= link_to image_url do %>
          <%= image_tag(public_image.image_url(:small), class: "tw:max-h-12", loading: "lazy", alt: public_image.image_alt,
            data: {controller: "image-fallback", action: "error->image-fallback#useOriginal", "image-fallback-url-value": image_url}) %>
        <% end %>
      <% end %>
    <% end %>

    <% if render_size %>
      <% table.column(label: "Size", header_classes: "tw:font-normal", classes: "tw:text-xs") do |public_image| %>
        <% image_size = public_image.image_size %>
        <%= number_to_human_size(image_size) if image_size %>
      <% end %>
    <% end %>

    <% table.column(label: safe_join(["AS ", render(UI::Tooltip::Component.new(text: "ActiveStorage (instead of legacy carrierwave)"))]), header_classes: "tw:font-normal") do |public_image| %>
      <%= check_mark if public_image.activestorage? %>
    <% end %>

    <% table.column(label: "Private", header_classes: "tw:font-normal") do |public_image| %>
      <%= check_mark if public_image.is_private? %>
    <% end %>

    <% table.column(sortable: "kind") do |public_image| %>
      <%= public_image.kind&.titleize %>

      <% if render_sortable %>
        <%= link_to search_emoji, url_for(sort_state.search_params.merge(search_kind: public_image.kind)), class: "display-sortable-link small" %>
      <% end %>
    <% end %>

    <% table.column(sortable: "imageable_type") do |public_image| %>
      <%= public_image.imageable_type %>

      <% if render_sortable %>
        <%= link_to search_emoji, url_for(sort_state.search_params.merge(search_imageable_type: public_image.imageable_type)), class: "display-sortable-link small" %>
      <% end %>
    <% end %>

    <% table.column(label: "Imageable", header_classes: "tw:font-normal") do |public_image| %>
      <% imageable_name = public_image.imageable_name.presence || "##{public_image.imageable_id}" %>
      <% imageable_path = helpers.admin_path_for_object(public_image.imageable) %>

      <%= imageable_path.present? ? link_to(imageable_name, imageable_path, class: "twlink") : imageable_name %>
    <% end %>
  <% end %>
</div>
