<%# locals: (collection:, render_sortable: false) %>

<%# Shown while "Toggle data" is expanded; the label stays a content target, since a ui--collapse with none never closes %>
<% data_column_classes = "tw:hidden tw:in-[[data-controller~=ui--collapse]:has([data-ui--collapse-target~=trigger][aria-expanded=true])]:table-cell" %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "name") do |mailchimp_value| %>
    <%= mailchimp_value.name %>
  <% end %>

  <% table.column(sortable: "slug", classes: "tw:text-sm") do |mailchimp_value| %>
    <%= mailchimp_value.slug %>
  <% end %>

  <% table.column(sortable: "list") do |mailchimp_value| %>
    <%= mailchimp_value.list %>
  <% end %>

  <% table.column(sortable: "kind") do |mailchimp_value| %>
    <%= mailchimp_value.kind %>
  <% end %>

  <% table.column(label: "Mailchimp ID") do |mailchimp_value| %>
    <%= mailchimp_value.mailchimp_id %>
  <% end %>

  <% table.column(sortable: "created_at") do |mailchimp_value| %>
    <small><%= render(UI::Time::Component.new(time: mailchimp_value.created_at, format: :localize_time_precise)) %></small>
  <% end %>

  <% table.column(sortable: "updated_at") do |mailchimp_value| %>
    <small><%= render(UI::Time::Component.new(time: mailchimp_value.updated_at, format: :localize_time_precise)) %></small>
  <% end %>

  <% table.column(label: tag.span("Data", class: "tw:hidden", data: {"ui--collapse-target": "content"}), classes: data_column_classes) do |mailchimp_value| %>
    <%= render UI::Code::Json::Component.new(data: mailchimp_value.data, small: true, max_width: :table_cell) %>
  <% end %>
<% end %>
