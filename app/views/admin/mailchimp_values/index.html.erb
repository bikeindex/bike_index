<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(name: "#{@list.titleize} #{@list == "all" ? "lists" : "list"}", button_size: :sm,
          active: @list != "all")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All lists", path: url_for(sortable_search_params.merge(search_list: nil)), match_params: {search_list: nil}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Organization list", path: url_for(sortable_search_params.merge(search_list: "organization")), match_params: {search_list: "organization"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Individual list", path: url_for(sortable_search_params.merge(search_list: "individual")), match_params: {search_list: "individual"}) } %>
    <% end %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "update values", href: admin_mailchimp_values_path, size: :sm, method: :post)) %>
  </li>

  <li>
    <a
      class="tw:px-2.5 tw:py-1 tw:text-xs"
      href=".data-cell-collapsed"
      aria-expanded="false"
      data-toggle="collapse"
    >
      Toggle data
    </a>
  </li>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @mailchimp_values,
  viewing: "Mailchimp Values",
  skip_charting: true,
  nav_header_list_items:,
)) %>
