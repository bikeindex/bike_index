<%# locals: (collection:, render_sortable: false) %>

<div
  data-controller="update-cached-sortable-links"
  data-update-cached-sortable-links-base-url-value="<%= url_for(sort_state.search_params) %>"
>
  <%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:,
        cache_key: cache_fragment_name(["admin_email_bans", render_sortable]),
        cache_records: ->(email_ban) { email_ban.user })) do |table| %>
    <% table.column(sortable: "created_at", lower_right: ->(email_ban) { email_ban.id }) do |email_ban| %>
      <%= render UI::Time::Component.new(time: email_ban.created_at) %>
    <% end %>

    <% table.column(sortable: "reason") do |email_ban| %>
      <%= email_ban.reason.humanize %>
    <% end %>

    <% table.column(sortable: "start_at") do |email_ban| %>
      <%= render UI::Time::Component.new(time: email_ban.start_at) %>
    <% end %>

    <% table.column(sortable: "end_at") do |email_ban| %>
      <%= render UI::Time::Component.new(time: email_ban.end_at) %>
    <% end %>

    <% table.column(sortable: "user_id") do |email_ban| %>
      <% if email_ban.user_id.present? %>
        <%= render Atoms::Admin::TableCells::User::Component.new(sort_state:, user: email_ban.user, render_search: true) %>
      <% end %>
    <% end %>
  <% end %>
</div>
