<% index_title = capture do %>
  <em class="strong"><%= @query.present? ? @query.titleize : "All" %></em>
  Invoices
<% end %>

<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(name: @query.present? ? "#{@query.titleize} only" : "All invoices", button_size: :sm,
          active: @query.present?)) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All", path: admin_invoices_path(sortable_search_params.merge(query: nil)), match_params: {query: nil}) } %>
      <% dropdown.with_entry_divider %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Active only", path: admin_invoices_path(sortable_search_params.merge(query: "active")), match_params: {query: "active"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Inactive only", path: admin_invoices_path(sortable_search_params.merge(query: "inactive")), match_params: {query: "inactive"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "First invoices only", path: admin_invoices_path(sortable_search_params.merge(query: "first_invoice")), match_params: {query: "first_invoice"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Renewal invoices only", path: admin_invoices_path(sortable_search_params.merge(query: "renewal_invoice")), match_params: {query: "renewal_invoice"}) } %>
    <% end %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(name: "#{UI::PeriodSelect::Component.column_label(@time_range_column)} in timerange", button_size: :sm,
          active: @time_range_column != "created_at")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Created in timerange", path: admin_invoices_path(sortable_search_params.merge(time_range_column: "created_at")), match_params: {time_range_column: "created_at"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Subscription ends in timerange", path: admin_invoices_path(sortable_search_params.merge(time_range_column: "subscription_end_at")), match_params: {time_range_column: "subscription_end_at"}) } %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Subscription starts in timerange", path: admin_invoices_path(sortable_search_params.merge(time_range_column: "subscription_start_at")), match_params: {time_range_column: "subscription_start_at"}) } %>
    <% end %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(name: @search_endless.present? ? @search_endless.humanize : "endless-ness", button_size: :sm,
          active: @search_endless.present?)) do |dropdown| %>
      <% endless_only_active = @search_endless == "endless_only" %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Endless only", path: admin_invoices_path(sortable_search_params.merge(search_endless: endless_only_active ? nil : "endless_only")), match_params: {search_endless: "endless_only"}) } %>
      <% not_endless_active = @search_endless == "not_endless" %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "Not Endless", path: admin_invoices_path(sortable_search_params.merge(search_endless: not_endless_active ? nil : "not_endless")), match_params: {search_endless: "not_endless"}) } %>
    <% end %>
  </li>
<% end %>

<% rendered_chart = nil %>

<% if @render_chart %>
  <% rendered_chart = capture do %>
    <% data = UI::Chart::Component.time_range_counts(collection: matching_invoices, time_range: @time_range, column: @time_range_column) %>
    <%= render(UI::Chart::Component.new(series: [{name: "Invoices", data:}], time_range: @time_range, stacked: true)) %>

    <% unless params[:query].present? %>
      <div class="row mb-4 mt-4">
        <div class="col-sm-8 offset-sm-2">
          <% invoice_row = ->(name, invoices) {
              {name:, count: number_display(invoices.count), amount_due: MoneyFormatter.money_format(invoices.sum(:amount_due_cents)),
               amount_paid: MoneyFormatter.money_format(invoices.sum(:amount_paid_cents))}
            }
            invoice_rows = [
              invoice_row.call("First invoice", matching_invoices.first_invoice),
              invoice_row.call("Renewals", matching_invoices.renewal_invoice),
              invoice_row.call("Free invoices", matching_invoices.free),
              invoice_row.call("Not free", matching_invoices.paid),
              invoice_row.call("All", matching_invoices).transform_values { |value| tag.strong(value) }
            ] %>

          <%= render(UI::Table::Component.new(records: invoice_rows)) do |table| %>
            <% table.column(label: "") { |row| row[:name] } %>
            <% table.column(label: "count") { |row| row[:count] } %>
            <% table.column(label: "amount due") { |row| row[:amount_due] } %>
            <% table.column(label: "amount paid") { |row| row[:amount_paid] } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<% table_view = capture do %>
  <p>
    Total paid:
    <strong><%= MoneyFormatter.money_format(matching_invoices.sum(:amount_paid_cents)) %></strong>
  </p>

  <p class="less-strong">
    Go to individual organizations to create new invoices
  </p>

  <%= render(Pages::Admin::Invoices::Table::Component.new(invoices: @invoices, render_sortable: true, display_organization: true)) %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  viewing: controller_name.humanize,
  collection: @invoices,
  index_title:,
  nav_header_list_items:,
  rendered_chart:,
  table_view:,
)) %>
