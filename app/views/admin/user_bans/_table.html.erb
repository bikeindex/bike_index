<%# locals: (collection:, render_sortable: false) %>
<% viewing_deleted ||= @viewing_deleted %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", lower_right: (->(user_ban) { content_tag(:span, user_ban.id, class: "only-dev-visible") } if display_dev_info?)) do |user_ban| %>
    <%= render UI::Time::Component.new(time: user_ban.created_at) %>
  <% end %>

  <% if viewing_deleted %>
    <% table.column(sortable: "deleted_at") do |user_ban| %>
      <span class="tw:text-red-500"><%= render UI::Time::Component.new(time: user_ban.deleted_at) %></span>
    <% end %>
  <% end %>

  <% table.column(sortable: "user_id") do |user_ban| %>
    <%= render Pages::Admin::Users::Cell::Component.new(user: user_ban.user, render_search: false) %>
  <% end %>

  <% table.column(sortable: "reason") do |user_ban| %>
    <%= user_ban.reason_humanized %>
  <% end %>

  <% table.column(sortable: "creator_id") do |user_ban| %>
    <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: user_ban.creator, render_search: render_sortable) %>
  <% end %>

  <% table.column(label: "Description", header_classes: "tw:font-normal") do |user_ban| %>
    <small title="<%= user_ban.description %>">
      <%= user_ban.description&.truncate(100) %>
    </small>
  <% end %>
<% end %>
