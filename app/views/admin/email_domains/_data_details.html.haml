- email_domain ||= nil
- subdomain_count = email_domain&.data&.dig("subdomain_count")&.to_i
- if subdomain_count.present? && subdomain_count > 0
  %a.text-info.mr-1{class: "tw:text-sm tw:underline", href: admin_email_domains_path(query: email_domain.tld)}
    = number_display(subdomain_count)
    %em subs
- if email_domain&.broader_domain_exists?
  %a.mr-1{class: "tw:text-sm tw:underline #{UI::Alerts::Base::Component::TEXT_CLASSES[:error]}", href: admin_email_domains_path(query: email_domain.tld)}
    broader exists
-#   = render(UI::ButtonLink::Component.new(text: "remove block", href: admin_email_domain_path(email_domain), method: :delete, color: :error, size: :sm, form: {class: "float-right"}))
