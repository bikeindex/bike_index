= render(UI::Container::Component.new) do
  = render(UI::Card::Component.new(additional_classes: "tw:my-6")) do
    = render(UI::Header::Component.new(text: "Be careful what you make banned!", tag: :h2))
    %p{class: "tw:mt-6 tw:mb-4"}
      There are some protections built in - you can't add a banned domain if there multiple bikes registered to that domain
    %p{class: "tw:mb-4"}
      %strong BUT STILL
      if you add a banned domain that is valid, it will prevent people from signing up with that domain.

= form_for email_domain,
  url: action,
  method: method do |f|

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :domain, html_options: {placeholder: "@something.com", disabled: email_domain.id.present?}))
  -# The status is ignored on create, processing has to happen first
  - if email_domain.id.present?
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :status)) do |group|
      = render(UI::Forms::RadioButtonGroup::Component.new(name: f.field_name(:status), entries: EmailDomain.statuses.keys.map { |status| {value: status, label: EmailDomain.status_humanized(status)} }, selected: email_domain.status, html_options: {"aria-describedby" => group.helper_text_id}))
      - group.with_helper_text do
        %strong= EmailDomain.status_humanized("ignored")
        is used to make sure super short top-level domains don't match everything
  %div{class: "tw:mt-6"}
    = render(UI::Button::Component.new(text: submit_label, color: :primary, size: :lg, type: "submit"))
