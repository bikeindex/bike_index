- admin_search_form = capture_haml do
  = form_with(url: admin_email_domains_path, method: :get, html: {class: "twsearchrow"}) do |form|
    = render partial: "/shared/hidden_search_fields"
    = hidden_field_tag :search_tld, params[:search_tld]
    = render(UI::Forms::Input::Component.new(form_builder: form, attribute: :query, html_options: {value: params[:query], placeholder: "Search domains"}))
    = render(UI::Button::Component.new(text: "Search", color: :primary, type: "submit", name: "search"))

- table_view = render partial: "table", locals: {collection: @email_domains, render_sortable: true}

= render(Pages::Admin::IndexSkeleton::Component.new(index: admin_index_state, viewing: controller_name.humanize, collection: @email_domains, admin_search_form:, chart_collection: @render_chart && matching_email_domains)) do |skeleton|
  - skeleton.with_nav_item { render(UI::ButtonLink::Component.new(text: "length", href: url_for(sortable_search_params.merge(sort: "domain_length")), size: :sm, active: sort_column == "domain_length")) }
  - skeleton.with_nav_item do
    = render(UI::Dropdown::Component.new(name: @status.blank? ? "All statuses except ignored" : "#{@status.titleize} only", button_size: :sm, active: @status.present?)) do |dropdown|
      - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All statuses except ignored", path: url_for(sortable_search_params.merge(search_status: nil)), match_params: {search_status: nil}) }
      - dropdown.with_entry_divider
      - searchable_statuses.each do |kind|
        - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{kind.titleize} only", path: url_for(sortable_search_params.merge(search_status: kind)), match_params: {search_status: kind}) }
  - skeleton.with_nav_item do
    = render(UI::Dropdown::Component.new(name: @tld.blank? ? "TLD and subs" : @tld.humanize, button_size: :sm, active: @tld.present?)) do |dropdown|
      - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "TLD and subs", path: url_for(sortable_search_params.merge(search_tld: nil)), match_params: {search_tld: nil}) }
      - dropdown.with_entry_divider
      - %w[only_tld only_subdomain].each do |kind|
        - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: kind.titleize, path: url_for(sortable_search_params.merge(search_tld: kind)), match_params: {search_tld: kind}) }
  - skeleton.with_nav_item { render(UI::ButtonLink::Component.new(text: "New Email Domain", href: new_admin_email_domain_path, color: :primary, size: :sm)) }
