- nav_header_list_items = capture_haml do
  %li
    = render(UI::ButtonLink::Component.new(text: "length", href: url_for(sortable_search_params.merge(sort: "domain_length")), size: :sm, active: sort_column == "domain_length"))
  %li
    = render(UI::Dropdown::Component.new(name: @status.blank? ? "All statuses except ignored" : "#{@status.titleize} only", button_size: :sm, active: @status.present?)) do |dropdown|
      - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All statuses except ignored", path: url_for(sortable_search_params.merge(search_status: nil)), match_params: {search_status: UI::ActiveLink::Component::BLANK}) }
      - dropdown.with_entry_divider
      - searchable_statuses.each do |kind|
        - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{kind.titleize} only", path: url_for(sortable_search_params.merge(search_status: kind)), match_params: {search_status: kind}) }
  %li
    = render(UI::Dropdown::Component.new(name: @tld.blank? ? "TLD and subs" : @tld.humanize, button_size: :sm, active: @tld.present?)) do |dropdown|
      - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "TLD and subs", path: url_for(sortable_search_params.merge(search_tld: nil)), match_params: {search_tld: UI::ActiveLink::Component::BLANK}) }
      - dropdown.with_entry_divider
      - %w[only_tld only_subdomain].each do |kind|
        - dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: kind.titleize, path: url_for(sortable_search_params.merge(search_tld: kind)), match_params: {search_tld: kind}) }
  %li
    = render(UI::ButtonLink::Component.new(text: "New Email Domain", href: new_admin_email_domain_path, color: :primary, size: :sm))

- admin_search_form = capture_haml do
  .row.mt-4
    .col
      = form_tag admin_email_domains_path, method: :get, class: "form-inline" do
        = render partial: "/shared/hidden_search_fields"
        = hidden_field_tag :search_tld, params[:search_tld]
        .form-group.ml-auto.mr-2.mb-2
          = text_field_tag :query, params[:query], placeholder: "Search domains", class: "form-control"
        = submit_tag "Search", name: "search", class: "btn btn-primary mb-2"

- table_view = render partial: "table", locals: {collection: @email_domains, render_sortable: true}

= render(Admin::IndexSkeleton::Component.new(index: admin_index_state, viewing: controller_name.humanize, collection: @email_domains, nav_header_list_items:, admin_search_form:, chart_collection: @render_chart && matching_email_domains))
