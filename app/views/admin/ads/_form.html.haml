= render(UI::Alerts::ObjectError::Component.new(object: @ad))

%div{class: "tw:md:w-1/2"}
  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :organization_id)) do
    = render(UI::Forms::Combobox::Component.new(name: :organization_id, options: @organizations.pluck(:name, :id), include_blank: true, html_options: {form: f, placeholder: "Please select org"}))
  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :target_url, label_text: "Url", html_options: {placeholder: "Target url"}))
  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :title, html_options: {placeholder: "Title"}))
  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :body, kind: :text_area, html_options: {placeholder: "Ad body copy"}))
