%h1
  Edit Ad

= render 'ad'


= form_for [:admin, @ad] do |f|
  = render partial: 'form', locals: { f: f }
  %label.w-100 Ad image
  - if @ad.image?
    = image_tag(@ad.image_url(:small))
  - else
    %p
      No picture!
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :image)) do
      = render(UI::Forms::Files::Upload::Component.new(form_builder: f, attribute: :image, accept: ImageUploader.permitted_extensions.join(",")))
      = f.hidden_field :image_cache
    %div{class: "tw:mb-4"}
      = render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :live, label: "Live"))
  %div{class: "tw:flex tw:justify-end"}
    = render(UI::Button::Component.new(text: "Update", color: :primary, type: "submit"))
