= render(Pages::Admin::Headers::Nav::Component.new(title: "Edit Ad"))

= render 'ad'


= form_for [:admin, @ad] do |f|
  = render partial: 'form', locals: { f: f }
  %label.twlabel{class: "tw:w-full"} Ad image
  - if @ad.image?
    = image_tag(@ad.image_url(:small))
  - else
    %p{class: "tw:mb-4"}
      No picture!
    = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :image)) do
      = render(UI::Forms::Files::Upload::Component.new(form_builder: f, attribute: :image, accept: ImageUploader.permitted_extensions))
      = f.hidden_field :image_cache
    = render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :live, label: "Live", class_name: "tw:mb-4"))
  %div{class: "tw:flex tw:justify-end"}
    = render(UI::Button::Component.new(text: "Update", color: :primary, type: "submit"))
