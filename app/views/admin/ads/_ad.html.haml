= render(UI::Card::Component.new(divided: true, additional_classes: "tw:mb-2")) do
  - if @ad.image.present?
    %div{class: "tw:px-5 tw:py-3"}
      %a{ href: @ad.target_url }
        = image_tag @ad.image_url(:large)
  %div{class: "tw:px-5 tw:py-3"}
    %a{href: @ad.target_url}
      %h3
        = @ad.title
  %div{class: "tw:px-5 tw:py-3"}
    %p
      = @ad.body
