<%= render(UI::DefinitionList::Container::Component.new(term: :right_align, multi_columns: true)) do %>
  <%= render(UI::DefinitionList::Row::Component.new(label: "ID", value: @b_param.id)) %>

  <%= render(UI::DefinitionList::Row::Component.new(label: "Creator", render_with_no_value: true, no_value_text: "No creator")) do %>
    <% if @b_param.creator.present? %>
      <%= link_to @b_param.creator.email, admin_user_path(@b_param.creator_id), class: "twlink" %>
    <% end %>
  <% end %>

  <%= render(UI::DefinitionList::Row::Component.new(label: "Organization")) do %>
    <% if @b_param.organization.present? %>
      <%= link_to @b_param.organization.name, admin_organization_path(@b_param.organization), class: "twlink" %>
    <% end %>
  <% end %>

  <%= render(UI::DefinitionList::Row::Component.new(label: "Created")) do %>
    <%= render(UI::Time::Component.new(time: @b_param.created_at, format: :localize_time_precise)) %>
  <% end %>

  <%= render(UI::DefinitionList::Row::Component.new(label: "Updated")) do %>
    <%= render(UI::Time::Component.new(time: @b_param.updated_at, format: :localize_time_precise)) %>
  <% end %>

  <%= render(UI::DefinitionList::Row::Component.new(label: "Created bike")) do %>
    <% if @b_param.created_bike_id.present? %>
      <%= link_to @b_param.created_bike_id, admin_bike_path(@b_param.created_bike_id), class: "twlink" %>
    <% end %>
  <% end %>
<% end %>

<h3 class="tw:mt-6">Bike</h3>

<%= render UI::JsonDisplay::Component.new(data: @b_param.params) %>

<% if @b_param.bike_errors.present? %>
  <h3 class="tw:mt-6">Bike Errors</h3>

  <%= render UI::JsonDisplay::Component.new(data: @b_param.bike_errors) %>
<% end %>
