<% ambassador_organizations = Organization.ambassador.to_a %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  viewing: controller_name.humanize,
  collection: @ambassador_task_assignments,
  index_title: "Completed Ambassador Activities",
  skip_charting: true,
)) do |skeleton| %>
  <% skeleton.with_nav_item do %>
    <%= render(UI::Dropdown::Component.new(name: ambassador_organizations.detect { |org| org.id.to_s == params[:search_organization_id].to_s }&.name || "Filter by organization", button_size: :sm,
          active: params[:search_organization_id].present?)) do |dropdown| %>
      <% if params[:search_organization_id].present? %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All organizations", path: admin_ambassador_task_assignments_path(sortable_search_params.except(:search_organization_id)), match_params: {search_organization_id: nil}) } %>
        <% dropdown.with_entry_divider %>
      <% end %>

      <% ambassador_organizations.each do |org| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: org.name, path: admin_ambassador_task_assignments_path(sortable_search_params.merge(search_organization_id: org.id)), match_params: {search_organization_id: org.id}) } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
