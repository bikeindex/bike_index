<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(name: (params[:search_organization_id].present?) ? Organization.friendly_find(params[:search_organization_id])&.name || "Organization" : "Filter by organization", button_size: :sm,
          active: params[:search_organization_id].present?)) do |dropdown| %>
      <% if params[:search_organization_id].present? %>
        <% dropdown.with_entry_item { link_to "All organizations", admin_ambassador_task_assignments_path(sortable_search_params.except(:search_organization_id)), data: {active: nil} } %>
        <% dropdown.with_entry_divider %>
      <% end %>

      <% Organization.ambassador.each do |org| %>
        <% org_active = params[:search_organization_id].to_s == org.id.to_s %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: org.name, path: admin_ambassador_task_assignments_path(sortable_search_params.merge(search_organization_id: org.id)), match: :query, query: {search_organization_id: org.id}) } %>
      <% end %>
    <% end %>
  </li>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  viewing: controller_name.humanize,
  collection: @ambassador_task_assignments,
  index_title: "Completed Ambassador Activities",
  nav_header_list_items:,
  skip_charting: true,
)) %>
