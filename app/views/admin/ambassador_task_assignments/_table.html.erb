<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "completed_at") do |assignment| %>
    <%= render UI::Time::Component.new(time: assignment.completed_at) %>
  <% end %>

  <% table.column(sortable: "organization_name") do |assignment| %>
    <% if assignment.organization.present? %>
      <%= link_to assignment.organization_name,
        admin_ambassador_task_assignments_path(sort_state.search_params.merge(search_organization_id: assignment.organization.id)), class: "twlink" %>
    <% else %>
      <small class="text-danger">missing org</small>
    <% end %>
  <% end %>

  <% table.column(sortable: "ambassador_task_title", label: "Activity Title") do |assignment| %>
    <%= link_to assignment.title,
      admin_ambassador_task_assignments_path(sort_state.search_params.merge(search_ambassador_task_id: assignment.ambassador_task_id)), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "ambassador_name") do |assignment| %>
    <% if assignment.ambassador.present? %>
      <%= link_to assignment.ambassador_name,
        admin_ambassador_task_assignments_path(sort_state.search_params.merge(search_ambassador_id: assignment.user_id)), class: "twlink" %>
    <% else %>
      <small class="text-danger">missing ambassador</small>
    <% end %>
  <% end %>
<% end %>
