= render(Pages::Admin::Headers::Nav::Component.new(title: "Stolen Notification")) do
  %li= render(UI::ButtonLink::Component.new(text: "Resend", href: resend_admin_stolen_notification_url(@stolen_notification, pretty_please: true), color: :primary, size: :sm))
= render(Pages::Admin::Headers::Section::Component.new(title: "Created", tag: :h3)) do
  = link_to render(UI::Time::Component.new(time: @stolen_notification.created_at, format: :localize_time_precise)), admin_stolen_notification_url(@stolen_notification), class: "twlink"
= render(UI::TableList::Component.new) do |list|
  - list.with_row(label: "Bike") do
    = link_to @bike.title_string, edit_admin_stolen_bike_url(@bike), class: "twlink"
    %small
      %em total messages sent to bike:
      = number_display(@bike.messages_count)
  - list.with_row(label: "Receiver Name", value: @stolen_notification.receiver_email)
  - list.with_row(label: "Bike phone", if: @bike.current_stolen_record.present?) do
    = @bike.current_stolen_record.phone
  - list.with_row(label: "Sent to owner") do
    = @stolen_notification.send_dates_parsed.count
    times
  - list.with_row(label: "Times:") do
    - if @stolen_notification.send_dates_parsed.any?
      %ul{class: "tw:mb-4"}
        - @stolen_notification.send_dates_parsed.each do |stamp|
          %li
            = link_to render(UI::Time::Component.new(time: Time.at(stamp), format: :localize_time_precise)), admin_stolen_notification_url(stamp), class: "twlink"
    - else
      %strong
        Has not been sent!
  - if @stolen_notification.sender.name.present?
    - list.with_row(label: "Sender", value: link_to(@stolen_notification.sender.name, edit_admin_user_url(@stolen_notification.sender_id), class: "twlink"))
  - else
    - list.with_row(label: "Sender", value: link_to(@stolen_notification.sender.email, edit_admin_user_url(@stolen_notification.sender_id), class: "twlink"))
  - list.with_row(label: "Sender sent count", value: @stolen_notification.sender.sent_stolen_notifications.count)


= render(UI::Card::Component.new(additional_classes: "tw:my-6")) do
  = render(Pages::Admin::Headers::Section::Component.new(title: "Notification Message", tag: :h3))
  = @stolen_notification.message

= render(Pages::Admin::Headers::Section::Component.new(title: "Notifications"))
= render partial: "/admin/notifications/table", locals: {notifications: @stolen_notification.notifications.order(created_at: :desc), skip_bike: true}
