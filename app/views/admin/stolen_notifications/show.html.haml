%div{class: "tw:grid tw:gap-x-8 tw:lg:grid-cols-12"}
  %h1{class: "tw:lg:col-span-11"}
    Stolen Notification
  %div{class: "tw:lg:col-span-1"}
    = link_to "Resend", resend_admin_stolen_notification_url(@stolen_notification, pretty_please: true), class: 'btn btn-success tw:my-6'
%h4
  Created
  %a.localizeTime.preciseTime{ href: admin_stolen_notification_url(@stolen_notification) }
    = l @stolen_notification.created_at, format: :convert_time
= render(UI::TableList::Component.new) do |list|
  - list.with_row(label: "Bike") do
    = link_to @bike.title_string, edit_admin_stolen_bike_url(@bike)
    %small
      %em total messages sent to bike:
      = number_display(@bike.messages_count)
  - list.with_row(label: "Receiver Name", value: @stolen_notification.receiver_email)
  - list.with_row(label: "Bike phone", if: @bike.current_stolen_record.present?) do
    = @bike.current_stolen_record.phone
  - list.with_row(label: "Sent to owner") do
    = @stolen_notification.send_dates_parsed.count
    times
  - list.with_row(label: "Times:") do
    - if @stolen_notification.send_dates_parsed.any?
      %ul{class: "tw:pl-0"}
        - @stolen_notification.send_dates_parsed.each do |stamp|
          %li.list-unstyled
            = link_to render(UI::Time::Component.new(time: Time.at(stamp), format: :localize_time_precise)), admin_stolen_notification_url(stamp)
    - else
      %strong
        Has not been sent!
  - if @stolen_notification.sender.name.present?
    - list.with_row(label: "Sender", value: link_to(@stolen_notification.sender.name, edit_admin_user_url(@stolen_notification.sender_id)))
  - else
    - list.with_row(label: "Sender", value: link_to(@stolen_notification.sender.email, edit_admin_user_url(@stolen_notification.sender_id)))
  - list.with_row(label: "Sender sent count", value: @stolen_notification.sender.sent_stolen_notifications.count)


.card.bg-light{class: "tw:mt-6 tw:mb-6!"}
  .card-header
    Notification Message
  .card-body
    = @stolen_notification.message

%h3
  Notifications
= render partial: "/admin/notifications/table", locals: {notifications: @stolen_notification.notifications.order(created_at: :desc), skip_bike: true}
