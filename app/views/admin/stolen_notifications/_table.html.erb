<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at") do |stolen_notification| %>
    <%= link_to admin_stolen_notification_url(stolen_notification), class: "twlink" do %>
      <%= render UI::Time::Component.new(time: stolen_notification.created_at) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |stolen_notification| %>
    <%= render UI::Time::Component.new(time: stolen_notification.updated_at) %>
  <% end %>

  <% table.column(sortable: "bike_id", lower_right: ->(stolen_notification) { link_to(stolen_notification.bike_id, edit_admin_stolen_bike_url(stolen_notification.bike), class: "twlink") if stolen_notification.bike }) do |stolen_notification| %>
    <%= stolen_notification.bike ? stolen_notification.bike.title_string : "Bike deleted!" %>
  <% end %>

  <% table.column(label: "Message") do |stolen_notification| %>
    <%= stolen_notification.message.truncate(120) %>
  <% end %>

  <% table.column(label: "Sent", classes: "tw:text-center") do |stolen_notification| %>
    <% sent_count = stolen_notification.send_dates_parsed.count %>

    <% if sent_count == 0 %>
      <span class="text-danger">no</span>
    <% elsif sent_count == 1 %>
      <%= check_mark %>
    <% else %>
      <%= sent_count %>
    <% end %>
  <% end %>
<% end %>
