- nav_header_list_items = capture_haml do
  - if current_organization.present?
    %li.nav-item
      = link_to "Organization view", organization_users_path(organization_id: current_organization.id), class: "nav-link less-strong"
  %li.nav-item
    = link_to "New Role", new_admin_organization_role_url(organization_id: current_organization&.to_param), class: "nav-link"

- table_view = render partial: "/admin/organization_roles/table", locals: {organization_roles: @collection, render_sortable: true, render_deleted: @render_deleted}

= render(Admin::IndexSkeleton::Component.new(collection: @collection, viewing: controller_name.humanize, sortable_search_params:, render_chart: @render_chart, render_deleted: @render_deleted, pagy: @pagy, per_page: @per_page, time_range: @time_range, period: @period, start_time: @start_time, end_time: @end_time, time_range_column: @time_range_column, user_subject: @user_subject, bike: @bike, marketplace_listing: @marketplace_listing, primary_activity: @primary_activity, current_organization:, params:, nav_header_list_items:, table_view:, chart_collection: @render_chart && matching_organization_roles))


