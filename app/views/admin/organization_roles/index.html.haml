- table_view = render partial: "/admin/organization_roles/table", locals: {organization_roles: @collection, render_sortable: true, render_deleted: @render_deleted}

= render(Pages::Admin::IndexSkeleton::Component.new(index: admin_index_state, collection: @collection, viewing: controller_name.humanize, table_view:, chart_collection: @render_chart && matching_organization_roles)) do |skeleton|
  - if current_organization.present?
    - skeleton.with_nav_item do
      = render(UI::ButtonLink::Component.new(text: "Organization view", href: organization_users_path(organization_id: current_organization.id), color: :link, html_class: "twless-strong"))
  - skeleton.with_nav_item do
    = render(UI::ButtonLink::Component.new(text: "New Role", href: new_admin_organization_role_url(organization_id: current_organization&.to_param), color: :primary, size: :sm))


