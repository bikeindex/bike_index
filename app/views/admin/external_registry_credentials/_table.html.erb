<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(label: "Registry") do |creds| %>
    <%= link_to creds.registry_name, edit_admin_external_registry_credential_path(creds), class: "twlink" %>
  <% end %>

  <% table.column(label: "Expires in") do |creds| %>
    <%= helpers.external_registry_credential_expires_in(creds) %>
  <% end %>

  <% table.column(label: "") do |creds| %>
    <% if creds.access_token_can_be_reset? %>
      <%= render(UI::ButtonLink::Component.new(text: "set / update access token",
        href: reset_admin_external_registry_credential_path(creds), method: :put, color: :primary, size: :sm)) %>
    <% end %>
  <% end %>
<% end %>
