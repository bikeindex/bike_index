<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", header_classes: "tw:text-xs", lower_right: (->(record) { tag.span(record.id, class: "only-dev-visible") } if display_dev_info?)) do |model_attestation| %>
    <%= render UI::Time::Component.new(time: model_attestation.created_at) %>
  <% end %>

  <% if sort_state.sort == "updated_at" %>
    <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |model_attestation| %>
      <%= render UI::Time::Component.new(time: model_attestation.updated_at) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "model_audit_id", classes: "tw:min-w-50") do |model_attestation| %>
    <% model_audit = model_attestation.model_audit %>
    <strong><%= model_audit.mnfg_name %></strong>
    <%= helpers.model_audit_frame_model_display(model_audit, truncate: true) %>

    <%= link_to search_emoji, url_for(sort_state.search_params.merge(search_model_audit_id: model_audit.id)), class: "display-sortable-link small" %>

    <% if model_attestation.organization_id.present? %>
      <%= link_to "view in org", organization_model_audit_path(model_attestation.model_audit_id, organization_id: model_attestation.organization&.to_param), class: "twlink tw:text-xs tw:inline-block less-strong" %>
    <% end %>
  <% end %>

  <% table.column(label: "Vehicles #", header_classes: "tw:font-normal tw:text-xs") do |model_attestation| %>
    <%= link_to number_display(model_attestation.model_audit.bikes_count), admin_bikes_path(search_model_audit_id: model_attestation.model_audit_id), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "kind") do |model_attestation| %>
    <%= model_attestation.kind_humanized %>
  <% end %>

  <% table.column(sortable: "organization_id") do |model_attestation| %>
    <% if model_attestation.organization %>
      <%= link_to model_attestation.organization.short_name || model_attestation.organization_id, organization_model_audits_path(organization_id: model_attestation.organization.to_param), class: "twlink" %>
      <%= link_to search_emoji, url_for(sort_state.search_params.merge(organization_id: model_attestation.organization.to_param)), class: "display-sortable-link small" %>
    <% end %>
  <% end %>

  <% table.column(sortable: "user_id") do |model_attestation| %>
    <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: model_attestation.user, render_search: true) %>
  <% end %>

  <% table.column(label: "File/URL", header_classes: "tw:font-normal") do |model_attestation| %>
    <% if model_attestation.file.present? %>
      <strong>
        <%= link_to "File", model_attestation.file.url, target: "_blank", class: "twlink" %>
      </strong>
    <% end %>

    <% if model_attestation.url.present? %>
      <small>
        <%= link_to truncate(model_attestation.url), model_attestation.url, class: "twlink" %>
      </small>
    <% end %>
  <% end %>

  <% table.column(label: "Info", header_classes: "tw:font-normal") do |model_attestation| %>
    <%= model_attestation.info %>
  <% end %>
<% end %>
