<% header_content = capture do %>
  <%= render partial: "cgroups_table", locals: {cgroups: @cgroups, ctype_counts: @ctype_counts} %>
<% end %>

<% table_view = capture do %>
  <%= render partial: "table", locals: {collection: @ctypes, render_sortable: true} %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @ctypes,
  viewing: "Component Types",
  skip_charting: true,
  header_content:,
  table_view:,
)) do |skeleton| %>
  <% skeleton.with_nav_item { render(UI::ButtonLink::Component.new(text: "New Component type", href: new_admin_ctype_url, color: :primary, size: :sm)) } %>
<% end %>
