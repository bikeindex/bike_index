<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "name") do |ctype| %>
    <%= link_to ctype.name, edit_admin_ctype_url(ctype), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "secondary_name", label: "Secondary name") do |ctype| %>
    <%= ctype.secondary_name %>
  <% end %>

  <% table.column(sortable: "slug") do |ctype| %>
    <%= ctype.slug %>
  <% end %>

  <% table.column(sortable: "cgroup", label: "Component group") do |ctype| %>
    <%= ctype.cgroup.name.titleize %>
  <% end %>

  <% table.column(sortable: "image", label: "Has image?", classes: "large-screens") do |ctype| %>
    <%= check_mark if ctype.image? %>
  <% end %>

  <% table.column(sortable: "created_at") do |ctype| %>
    <%= render UI::Time::Component.new(time: ctype.created_at) %>
  <% end %>

  <% table.column(sortable: "updated_at") do |ctype| %>
    <%= render UI::Time::Component.new(time: ctype.updated_at) %>
  <% end %>
<% end %>
