= form_for [:admin, @ctype] do |f|
  = render(UI::Alerts::ObjectError::Component.new(name: "Component Type", object: @ctype))

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :name))
  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :secondary_name, label_text: "Secondary Name"))
  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :cgroup_id, label_text: "Component Group", required: true)) do
    = render(UI::Forms::Select::Component.new(form_builder: f, attribute: :cgroup_id, option_tags: Cgroup.pluck(:name, :id), options: {prompt: "Select the component group"}, required: true))
  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :image, label_text: "Component type avatar")) do
    = render(UI::Forms::Files::Upload::Component.new(form_builder: f, attribute: :image, accept: ImageUploader.permitted_extensions))
    = f.hidden_field :image_cache

  %div{class: "tw:mt-6"}
    = render(UI::Button::Component.new(text: "Save", color: :primary, type: "submit"))
