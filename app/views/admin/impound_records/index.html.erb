<% nav_header_list_items = capture do %>
  <li>
    <% status_filter_name = if @search_status != "current" && ImpoundRecord.statuses.include?(@search_status)
         ImpoundRecord.statuses_humanized[@search_status.to_sym]
       else
         @search_status == "all" ? "All statuses" : "#{@search_status.titleize} records"
       end %>

    <%= render(UI::Dropdown::Component.new(name: status_filter_name, button_size: :sm,
          active: @search_status != available_statuses.first)) do |dropdown| %>
      <% available_statuses.each do |status| %>
        <% if status != "current" && ImpoundRecord.statuses.include?(status) %>
          <% display_status = ImpoundRecord.statuses_humanized[status.to_sym] %>
        <% elsif status == "all" %>
          <% display_status = "All statuses" %>
        <% else %>
          <% display_status = "#{status.titleize} records" %>
        <% end %>

        <% status_active = @search_status == status %>
        <% status_link_params = sortable_search_params.merge(search_status: (status_active ? nil : status)) %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: display_status, path: url_for(status_link_params), match: :query, query: {search_status: status}) } %>

        <% if status == "resolved" %>
          <% dropdown.with_entry_divider %>
        <% end %>
      <% end %>
    <% end %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "with claims", href: url_for(sortable_search_params.merge(search_with_claims: !@with_claims)), size: :sm, active: @with_claims)) %>
  </li>
<% end %>

<% rendered_chart = nil %>

<% if @render_chart %>
  <% rendered_chart = capture do %>
    <% data = UI::Chart::Component.time_range_counts(collection: matching_impound_records, time_range: @time_range, column: "created_at") %>
    <%= render(UI::Chart::Component.new(series: [{name: "Impound Records", data:}], time_range: @time_range, stacked: true)) %>

    <% unless params[:organization_id].present? %>
      <div class="row mt-4">
        <div class="col-md-6 offset-md-3">
          <table class="table-list wide-definition">
            <tbody>
              <% matching_impound_records.distinct.pluck(:organization_id).map { |id| [id, matching_impound_records.where(organization_id: id).count] }.sort_by { |_id, number| number }.each do |id, number| %>
                <% organization = Organization.unscoped.find_by_id(id) if id.present? %>

                <tr>
                  <td>
                    <% if organization.present? %>
                      <%= link_to organization.short_name, url_for(sortable_search_params.merge(organization_id: id)), class: (organization.deleted? ? "text-danger" : "") %>
                    <% else %>
                      <%= link_to "no organization", url_for(sortable_search_params.merge(organization_id: "none")), class: "gray-link" %>
                    <% end %>
                  </td>

                  <td><%= number_with_delimiter(number) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<% table_view = capture do %>
  <%= render partial: "table", locals: {impound_records: @impound_records, render_sortable: true, skip_organization: current_organization.present?} %>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @impound_records,
  viewing: "Impound Records",
  nav_header_list_items:,
  rendered_chart:,
  table_view:,
)) %>
