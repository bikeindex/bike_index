<%# locals: (impound_records:, render_sortable: false, skip_organization: false, skip_claims: false) %>

<%= render(UI::Table::Component.new(records: impound_records, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at") do |impound_record| %>
    <%= link_to render(UI::Time::Component.new(time: impound_record.created_at, format: :localize_time_precise)), admin_impound_record_path("pkey-#{impound_record.id}"), class: "twlink" %>
  <% end %>

  <% table.column(sortable: "updated_at", header_classes: "tw:text-xs") do |impound_record| %>
    <small><%= render(UI::Time::Component.new(time: impound_record.updated_at, format: :localize_time_precise)) %></small>
  <% end %>

  <% table.column(label: "Impounded") do |impound_record| %>
    <% if impound_record.impounded_at.present? %>
      <small><%= render(UI::Time::Component.new(time: impound_record.impounded_at, format: :localize_time_precise)) %></small>
    <% end %>
  <% end %>

  <% unless skip_organization %>
    <% table.column(sortable: "organization_id") do |impound_record| %>
      <% if impound_record.organization_id.present? %>
        <%= link_to impound_record.organization&.short_name || impound_record.organization_id, admin_impound_records_path(sort_state.search_params.merge(organization_id: impound_record.organization_id)), class: "twlink" %>
      <% end %>
    <% end %>
  <% end %>

  <% table.column(sortable: "location_id") do |impound_record| %>
    <small><%= impound_record.location&.name %></small>
  <% end %>

  <% table.column(label: "Bike", classes: "tw:whitespace-normal") do |impound_record| %>
    <%= render Atoms::Admin::TableCells::Bike::Component.new(bike: impound_record.bike, bike_id: impound_record.bike_id) %>
  <% end %>

  <% table.column(sortable: "status") do |impound_record| %>
    <em><%= helpers.status_display(impound_record.status_humanized_short) %></em>
  <% end %>

  <% table.column(sortable: "user_id", label: "last updator") do |impound_record| %>
    <%= render Atoms::Admin::TableCells::User::Component.new(sort_state:, user: impound_record.user, render_search: render_sortable) %>
  <% end %>

  <% table.column(sortable: "resolved_at") do |impound_record| %>
    <% if impound_record.resolved_at.present? %>
      <%= render(UI::Time::Component.new(time: impound_record.resolved_at, format: :localize_time_precise)) %>
    <% end %>
  <% end %>

  <% unless skip_claims %>
    <% table.column(label: "Claims", header_classes: "tw:text-xs") do |impound_record| %>
      <% if impound_record.bike_id.present? %>
        <%= link_to number_display(impound_record.impound_claims.count), admin_impound_claims_path(search_bike_id: impound_record.bike_id), class: "twlink" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
