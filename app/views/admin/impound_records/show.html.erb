<% impound_record_id = @impound_record.display_id || @impound_record.id %>
<% organization_name = @impound_record.organization.present? ? @impound_record.organization.name : @impound_record.organization_id %>

<% title = capture do %>
  Impound Record
  <% if @bike.present? && @bike.creator_unregistered_parking_notification? %>
    <%= render(Atoms::RegistrationStatusBadge::Component.new(bike: @bike, override_status: "unregistered")) %>
  <% end %>
<% end %>

<%= render(Pages::Admin::Headers::Nav::Component.new(title:)) do |nav| %>
  <% if organization_name.present? %>
    <% nav.with_item do %>
      <%= link_to "View record in organization", organization_impound_record_path(@impound_record.display_id, organization_id: @impound_record.organization_id), class: "twlink" %>
    <% end %>
  <% end %>
<% end %>

<div class="twwiderow tw:items-start">
  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "Created", value: render(UI::Time::Component.new(time: @impound_record.created_at, format: :localize_time_precise))) %>

    <% list.with_row(label: "Updated", value: render(UI::Time::Component.new(time: @impound_record.updated_at, format: :localize_time_precise))) %>

    <% list.with_row(label: "Status") do %>
      <em><%= status_display(@impound_record.status_humanized) %></em>
    <% end %>

    <% list.with_row(label: "Organization") do %>
      <% if organization_name.present? %>
        <%= link_to organization_name, admin_organization_path(@impound_record.organization_id), class: "twlink" %>
      <% else %>
        <small class="twless-strong">NO organization</small>
      <% end %>
    <% end %>

    <% list.with_row(label: "Bike", value: render(Atoms::Admin::TableCells::Bike::Component.new(bike: @impound_record.bike))) %>

    <% list.with_row(label: "User", value: render(Atoms::Admin::TableCells::User::Component.new(user: @impound_record.user))) %>
  <% end %>

  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "Impounded from") do %>
      <% if @impound_record.impounded_from_address_record.blank? %>
        <em class="twless-strong">No impounded from address</em>
      <% else %>
        <%= render(UI::AddressDisplay::Component.new(address_record: @impound_record.impounded_from_address_record, visible_attribute: :street)) %>
      <% end %>
    <% end %>

    <% list.with_row(label: "Current address") do %>
      <% if @impound_record.address_record_id.blank? %>
        <em class="twless-strong">No current address</em>
      <% elsif @impound_record.address_record_id == @impound_record.impounded_from_address_record_id %>
        <em class="twless-strong">same as impounded from</em>
      <% else %>
        <%= render(UI::AddressDisplay::Component.new(address_record: @impound_record.address_record, visible_attribute: :street)) %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= render(UI::Header::Component.new(text: "Impound record updates", tag: :h2, html_class: "tw:mt-12")) %>

<% if @impound_record.impound_record_updates.none? %>
  <p class="twless-strong tw:mb-4">no updates</p>
<% else %>
  <%= render(UI::Table::Component.new(records: @impound_record.impound_record_updates)) do |table| %>
    <% table.column(label: "Updated") do |impound_record_update| %>
      <%= render(UI::Time::Component.new(time: impound_record_update.created_at, format: :localize_time_precise)) %>
    <% end %>

    <% table.column(label: "By") do |impound_record_update| %>
      <%= render Atoms::Admin::TableCells::User::Component.new(user: impound_record_update.user) %>
    <% end %>

    <% table.column(label: "Kind") do |impound_record_update| %>
      <em><%= impound_record_update.kind_humanized %></em>
    <% end %>

    <% table.column(label: "Info") do |impound_record_update| %>
      <% if impound_record_update.move_location? %>
        Moved to <%= impound_record_update.location&.name %>
      <% elsif impound_record_update.transferred_to_new_owner? %>
        Sent to <strong><%= impound_record_update.transfer_email %></strong>
      <% end %>

      <% if !impound_record_update.note? && impound_record_update.notes.present? %>
        <br>
      <% end %>

      <small><%= impound_record_update.notes %></small>
    <% end %>
  <% end %>
<% end %>

<%= render(UI::Header::Component.new(text: "Impound claims", tag: :h2, html_class: "tw:mt-12")) %>

<% if @impound_record.impound_claims.none? %>
  <p class="twless-strong tw:mb-4">no claims</p>
<% else %>
  <%= render partial: "admin/impound_claims/table", locals: {impound_claims: @impound_record.impound_claims} %>
<% end %>
