<% admin_search_form = capture do %>
  <%= form_with(url: admin_model_audits_path, method: :get, html: {class: "twsearchrow"}) do |f| %>
    <%= render partial: "/shared/hidden_search_fields" %>

    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :search_mnfg_name,
      html_options: {value: params[:search_mnfg_name], placeholder: "Manufacturer"}) %>

    <%= render UI::Forms::Input::Component.new(form_builder: f, attribute: :search_frame_model,
      html_options: {value: params[:search_frame_model], placeholder: "Frame model"}) %>

    <%= render UI::Button::Component.new(text: "Search", color: :primary, type: "submit", name: "search") %>
  <% end %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @model_audits,
  viewing: "Model Audits",
  chart_collection: @render_chart && matching_model_audits,
  admin_search_form:,
)) do |skeleton| %>
  <% skeleton.with_nav_item { render(UI::ButtonLink::Component.new(text: "Mnfg Other", href: url_for(sortable_search_params.merge(search_mnfg_other: !@mnfg_other)), size: :sm, active: @mnfg_other)) } %>
<% end %>
