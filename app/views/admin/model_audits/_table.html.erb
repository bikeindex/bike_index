<%# locals: (collection:, render_sortable: true) %>

<% org_ids = OrganizationModelAudit.distinct.pluck(:organization_id) %>
<% org_names_hash = Organization.where(id: org_ids).pluck(:id, :short_name).to_h %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:, cache_key: cache_fragment_name(["admin_model_audit"]))) do |table| %>
  <% table.column(sortable: "created_at", header_classes: "tw:text-xs", lower_right: ->(record) { tag.span(record.id, class: "only-dev-visible") }) do |model_audit| %>
    <%= render UI::Time::Component.new(time: model_audit.created_at) %>
  <% end %>

  <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |model_audit| %>
    <%= render UI::Time::Component.new(time: model_audit.updated_at) %>
  <% end %>

  <% table.column(sortable: "mnfg_name", label: "Manufacturer") do |model_audit| %>
    <%= model_audit.mnfg_name %>

    <%= link_to search_emoji, url_for(sort_state.search_params.merge(search_mnfg_name: model_audit.mnfg_name)), class: "display-sortable-link small" %>
  <% end %>

  <% table.column(label: "Mnfg other", header_classes: "tw:text-xs", classes: "tw:text-center") do |model_audit| %>
    <%= check_mark if model_audit.manufacturer_other.present? %>
  <% end %>

  <% table.column(sortable: "frame_model", label: "Model") do |model_audit| %>
    <%= helpers.model_audit_frame_model_display(model_audit, truncate: true) %>
  <% end %>

  <% table.column(sortable: "bikes_count", label: "Vehicles #") do |model_audit| %>
    <%= link_to number_display(model_audit.bikes_count), admin_bikes_path(search_model_audit_id: model_audit.id), class: "twlink" %>
  <% end %>

  <% table.column(label: "Org vehicles") do |model_audit| %>
    <% model_audit.organization_model_audits.where.not(bikes_count: 0).pluck(:bikes_count, :organization_id).each do |bikes_count, org_id| %>
      <%= link_to organization_model_audits_path(organization_id: org_id, model_audit_id: model_audit.id), class: "twlink tw:text-xs" do %>
        <%= org_names_hash[org_id] %>: <%= number_display(bikes_count) %>
      <% end %>
    <% end %>
  <% end %>

  <% table.column(label: "Attestations") do |model_audit| %>
    <%= number_display(model_audit.model_attestations.count) %>
  <% end %>
<% end %>
