<% nav_header_list_items = capture do %>
  <% if current_organization.present? %>
    <li>
      <%= render(UI::ButtonLink::Component.new(text: "#{current_organization.short_name} view", href: organization_graduated_notifications_path({organization_id: current_organization.to_param}.merge(sortable_search_params)), size: :sm)) %>
    </li>
  <% end %>

  <li>
    <%= render(UI::Dropdown::Component.new(name: "#{@search_status.humanize} notifications", button_size: :sm,
          active: @search_status != 'all')) do |dropdown| %>
      <% (["all"] + GraduatedNotification.statuses).each do |kind| %>
        <% kind_active = @search_status == kind %>
        <% kind_display = "#{GraduatedNotification.status_humanized(kind)} notifications" %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: kind_display, path: url_for(sortable_search_params.merge(search_status: (kind_active ? nil : kind))), match: :query, query: {search_status: (kind_active ? nil : kind)}) } %>

        <% if kind == "all" %>
          <% dropdown.with_entry_divider %>
        <% end %>
      <% end %>
    <% end %>
  </li>
<% end %>

<% rendered_chart = capture do %>
  <% if @render_chart %>
    <% time_range_column = @search_status == "marked_remaining" ? "marked_remaining_at" : "created_at" %>
    <% data = UI::Chart::Component.time_range_counts(collection: matching_graduated_notifications, time_range: @time_range, column: time_range_column) %>
    <%= render(UI::Chart::Component.new(series: [{name: "Graduated Notifications", data:}], time_range: @time_range, stacked: true)) %>
  <% end %>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  viewing: controller_name.humanize,
  collection: @graduated_notifications,
  index_title: "Graduated notifications",
  nav_header_list_items:,
  rendered_chart:,
)) %>
