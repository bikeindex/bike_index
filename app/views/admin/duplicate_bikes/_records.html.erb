<%# locals: (bikes:, review:, test_bike_ids:, stolen_record_counts:, account_emails:) %>
<% muted = "tw:text-gray-600 tw:dark:text-gray-400" %>

<div class="tw:mt-2 tw:rounded-md tw:border tw:border-gray-200 tw:dark:border-gray-700">
  <div class="tw:hidden tw:grid-cols-[9rem_14rem_1fr_auto] tw:gap-4 tw:border-b tw:border-gray-200 tw:bg-gray-50 tw:px-3 tw:py-2 tw:text-xs tw:font-semibold tw:tracking-wide tw:uppercase tw:md:grid tw:dark:border-gray-700 tw:dark:bg-gray-700 <%= muted %>">
    <div>Record</div>
    <div>Contact · source</div>
    <div>Differs from the common value · to preserve</div>
    <div></div>
  </div>

  <% bikes.each do |bike| %>
    <% contact_group = review.contact_group(bike) %>
    <% differences = review.differences(bike) %>
    <% stolen_count = stolen_record_counts[bike.id] || 0 %>

    <div
      data-controller="ui--collapse"
      class="tw:border-b tw:border-gray-200 tw:px-3 tw:py-2 tw:last:border-b-0 tw:dark:border-gray-700 <%= "tw:bg-blue-50/50 tw:dark:bg-blue-950/40" if bike == review.reference_bike %>"
    >
      <div
        class="
          tw:grid tw:grid-cols-1 tw:gap-x-4 tw:gap-y-1
          tw:md:grid-cols-[9rem_14rem_1fr_auto]
        "
      >
        <div>
          <%= link_to "Bike ##{bike.id}", edit_admin_bike_path(bike), class: "twlink tw:font-semibold" %>

          <div class="tw:text-xs <%= muted %>">
            <%= render UI::Time::Component.new(time: bike.created_at) %>
          </div>

          <% if bike == review.reference_bike %>
            <%= render UI::Badge::Component.new(text: "Reference", color: :notice, size: :xs) %>
          <% end %>
        </div>

        <div class="tw:text-sm">
          <%= link_to "Contact #{contact_group.number}", url_for(request.query_parameters.except("page").merge("search_contact" => contact_group.number)), class: "twlink" %>

          <span class="<%= muted %>">
            ·
            <%= review.claim_status(review.initial_ownership(bike)).downcase %>
          </span>

          <div class="tw:truncate">
            <%= review.source(bike) || "Unknown source" %>
          </div>

          <div class="tw:truncate <%= muted %>">
            <%= review.organization(bike)&.name %>
          </div>
        </div>

        <div class="tw:text-sm">
          <% if differences.any? %>
            <div class="tw:flex tw:flex-wrap tw:gap-x-3">
              <% differences.each do |field| %>
                <span>
                  <span class="<%= muted %>"><%= field %>:</span>

                  <span
                    class="
                      tw:rounded-sm tw:bg-amber-50 tw:px-1 tw:break-all
                      tw:dark:bg-amber-950
                    "
                  >
                    <%= review.field_value(bike, field) || "Blank" %>
                  </span>
                </span>
              <% end %>
            </div>
          <% else %>
            <div class="<%= muted %>">Matches the common values</div>
          <% end %>

          <div class="tw:mt-1">
            <%= render "record_flags", bike:, review:, test_marked: test_bike_ids.include?(bike.id), stolen_count:, account_emails: %>
          </div>
        </div>

        <div class="tw:flex tw:items-start tw:gap-3 tw:text-sm">
          <% unless bike == review.reference_bike %>
            <%= link_to "Use as reference", url_for(request.query_parameters.merge("reference_bike_id" => bike.id)), class: "twlink tw:whitespace-nowrap" %>
          <% end %>

          <%= render UI::Collapse::Component.new(text: "Details", chevron: :trailing, color: :link) %>
        </div>
      </div>

      <div
        class="
          tw:mt-3 tw:mb-1 tw:hidden tw:rounded-sm tw:bg-gray-50 tw:p-3
          tw:dark:bg-gray-900
        "
        data-ui--collapse-target="content"
      >
        <p class="tw:mb-2 tw:text-sm">
          <%= link_to "Admin edit", edit_admin_bike_path(bike), class: "twlink" %>
          ·
          <%= link_to "Public registration", bike_path(bike), class: "twlink" %>
        </p>

        <%= render "record_detail", bike:, review:, stolen_count:, account_emails: %>
      </div>
    </div>
  <% end %>
</div>
