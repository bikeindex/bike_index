<%# locals: (bike:, review:, stolen_count:, account_emails:) %>
<% initial = review.initial_ownership(bike) %>
<% current = bike.current_ownership %>
<% muted = "tw:text-gray-600 tw:dark:text-gray-400" %>

<div class="twwiderow twwiderow-3 tw:text-sm">
  <div>
    <h4 class="tw:text-sm tw:font-semibold">Initial registration</h4>

    <div>
      <%= initial&.origin&.humanize || "Unavailable" %> <%= initial&.pos_kind&.humanize %>
    </div>

    <div><%= review.organization(bike)&.name %></div>
    <%= render UI::Time::Component.new(time: initial&.created_at) %>

    <div class="tw:break-all">
      Customer email: <%= review.contact_email(initial) || "Unavailable" %>
    </div>

    <% if initial&.user_id %>
      <div>
        <%= link_to "Account ##{initial.user_id}", admin_user_path(initial.user_id), class: "twlink" %>
      </div>
      <div class="tw:break-all">
        Account email: <%= account_emails[initial.user_id] || "Unavailable" %>
      </div>
    <% end %>

    <div>
      <%= review.claim_status(initial) %>
      <%= render UI::Time::Component.new(time: initial&.claimed_at) %>
    </div>

    <div class="tw:mt-1 <%= muted %>">
      vs reference: <%= review.account_match(bike, initial: true) %> ·
      <%= review.email_match(bike, initial: true) %> ·
      <%= review.email_evidence(bike, initial: true) %>
    </div>
  </div>

  <div>
    <h4 class="tw:text-sm tw:font-semibold">Current ownership</h4>

    <div class="tw:break-all">
      Ownership email: <%= review.contact_email(current) || "Unavailable" %>
    </div>

    <% if current&.user_id %>
      <div>
        <%= link_to "Account ##{current.user_id}", admin_user_path(current.user_id), class: "twlink" %>
      </div>
      <div class="tw:break-all">
        Account email: <%= account_emails[current.user_id] || "Unavailable" %>
      </div>
    <% end %>

    <div>
      <%= review.claim_status(current) %>
      <%= render UI::Time::Component.new(time: current&.claimed_at) %>
    </div>

    <div>
      <%= number_display(bike.ownerships.count(&:previous_ownership_id)) %>
      transfers ·
      <%= link_to "ownership history", admin_bike_path(bike, active_tab: "ownerships"), class: "twlink" %>
    </div>

    <div class="tw:mt-1 <%= muted %>">
      vs reference: <%= review.account_match(bike) %> ·
      <%= review.email_match(bike) %> · <%= review.email_evidence(bike) %>
    </div>
  </div>

  <div>
    <h4 class="tw:text-sm tw:font-semibold">
      Stored values and information to preserve
    </h4>

    <div>
      Stored serial:
      <%= render Atoms::Serial::Component.new(serial: bike.serial_number) %>
    </div>

    <div>
      Whole normalized:
      <span class="tw:font-mono"><%= bike.serial_normalized_no_space %></span>
    </div>

    <div class="<%= muted %>">
      <%= review.serial_match(bike) %> · <%= review.manufacturer_match(bike) %>
    </div>

    <div>
      <%= review.field_value(bike, "Manufacturer") %> · <%= bike.frame_model %>
      <%= bike.year %>
    </div>

    <div><%= bike.status&.humanize %></div>

    <% if stolen_count.positive? || bike.status_stolen? %>
      <strong class="tw:text-red-700 tw:dark:text-red-400">Stolen record/history: review required</strong>
    <% end %>

    <div class="tw:mt-1">
      <%= number_display(stolen_count) %> stolen/history records ·
      <%= number_display(bike.bike_organizations.size) %> organization links ·
      <%= number_display(bike.bike_stickers.size) %> stickers ·
      <%= number_display(bike.public_images.size) %> photos ·
      <%= number_display(bike.marketplace_listings.size) %> marketplace listings
    </div>
  </div>
</div>
