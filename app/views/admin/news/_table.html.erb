<%# locals: (blogs:, skip_kind: false, tags_no_link: false, render_sortable: true) %>

<% tags_param = params[:search_tags] || [] %>

<%= render(UI::Table::Component.new(records: blogs, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", lower_right: ->(record) { content_tag(:span, record.id, class: "only-dev-visible") }) do |blog| %>
    <small><%= render UI::Time::Component.new(time: blog.created_at) %></small>
  <% end %>

  <% table.column(sortable: "user_id", label: "Creator", classes: "tw:hidden tw:lg:table-cell") do |blog| %>
    <%= blog.user&.name || blog.user&.email %>
  <% end %>

  <% table.column(sortable: "updated_at", classes: "tw:text-xs tw:hidden tw:lg:table-cell") do |blog| %>
    <%= render UI::Time::Component.new(time: blog.updated_at) %>
  <% end %>

  <% table.column(sortable: "title", label: "Content") do |blog| %>
    <%= link_to blog.title, edit_admin_news_url(blog), class: "twlink" %>
    <br>
    <%= blog.body_abbr.html_safe if blog.body_abbr %>

    <% if blog.content_tag_names.any? %>
      <small class="d-block">
        <span class="less-strong">Topics:</span>

        <% if tags_no_link %>
          <%= blog.content_tag_names.join(", ") %>
        <% else %>
          <%= safe_join(blog.content_tags.name_ordered.map { |c| link_to(c.name, sort_state.search_params.merge(search_tags: tags_param + [c.to_param]), class: "less-strong") }, ", ") %>
        <% end %>
      </small>
    <% end %>

    <% if blog.canonical_url? %>
      <small class="d-block">Canonical: <%= link_to blog.pretty_canonical, blog.canonical_url, class: "gray-link" %></small>
    <% end %>
  <% end %>

  <% unless skip_kind %>
    <% table.column(label: "Kind", header_classes: "tw:font-normal") do |blog| %>
      <% if !blog.blog? %>
        <span class="text-info"><%= blog.kind.humanize %></span>
      <% end %>
    <% end %>
  <% end %>

  <% table.column(label: "Language", header_classes: "tw:font-normal") do |blog| %>
    <%= helpers.t(blog.language, scope: [:locales]) %>
  <% end %>

  <% table.column(sortable: "published_at") do |blog| %>
    <% if blog.published? && blog.published_at.present? %>
      <small><%= render UI::Time::Component.new(time: blog.published_at) %></small>
    <% end %>
  <% end %>
<% end %>
