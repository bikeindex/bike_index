%h1
  New #{@dignified_name}

- url = {action: "create", controller: "news"}
= form_for [:admin, @blog], :url => url do |f|
  = render(UI::Alerts::ObjectError::Component.new(object: @blog))

  .row
    .col-auto
      = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :title, required: true, html_options: {placeholder: "Blog title"}))

  .row.mt-2
    .col-auto
      = render(UI::Button::Component.new(text: "Create Blog!", color: :primary, type: "submit"))
