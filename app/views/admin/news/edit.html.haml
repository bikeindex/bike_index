= render(Pages::Admin::Headers::Nav::Component.new(title: "Editing #{@blog.blog? ? "Blog" : "Info piece"}")) do |nav|
  - nav.with_item { render(UI::ButtonLink::Component.new(text: "Delete", href: admin_news_url(@blog), method: :delete, color: :error, size: :sm, confirm: "Are you sure?")) }

- if params[:show_photos]
  %p{class: "tw:mb-4"}
    - if @blog.is_listicle
      - images = @blog.listicles.map(&:image_url)
    - else
      - images = @blog.public_images.map(&:image_url)
    - images.each do |i|
      %br
      = link_to i, i, class: "twlink"
    - images.each do |i|
      %br
      = image_tag i


- url = {action: "update", controller: "news"}
= form_for [:admin, @blog], :url => url do |f|
  = render(UI::Alerts::ObjectError::Component.new(object: @blog))

  - if @blog.is_listicle
    = render(UI::Header::Component.new(text: tag.span("Listicles are no longer actively maintained. Many things on this page are no longer working.", class: UI::Alerts::Base::Component::TEXT_CLASSES[:error]), tag: :h2))
    = render partial: "listicle_form", locals: { f: f }
  - else
    = render partial: "form", locals: { f: f }

  = render(Pages::Admin::News::Options::Component.new(form_builder: f, blog: @blog))

= render(UI::Alerts::Base::Component.new(kind: :notice, margin_classes: "tw:mt-2 tw:mb-4")) do
  %p
    The content blocks accept HTML or Markdown for styling and linking things. Check out this #{link_to "Markdown cheat sheet", "https://github.com/adam-p/markdown-here/wiki/Markdown-Cheatsheet", target: "_blank", class: "twlink"} if you're curious.

- unless @blog.is_listicle
  %div{class: "tw:mt-6"}
    = render(UI::Forms::Files::UploadMultiple::Component.new(url: public_images_path, file_param: "public_image[image]",
      params: { blog_id: @blog.id }, accept: ImageUploader.permitted_extensions, list_html_options: { class: "twwiderow twwiderow-3" })) do
      = render partial: "public_images/admin_public_image", collection: @blog.public_images.with_attached_file, as: :public_image
