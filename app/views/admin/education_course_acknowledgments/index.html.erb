<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  chart_collection: @render_chart && matching_education_course_acknowledgments,
)) do |skeleton| %>
  <% skeleton.with_nav_item do %>
    <%= render(UI::Dropdown::Component.new(
      name: @status.present? ? "#{@status.titleize} only" : "All statuses",
      button_size: :sm,
      active: @status.present?
    )) do |dropdown|
      dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All statuses", path: url_for(sortable_search_params.merge(search_status: nil)), match_params: {search_status: nil}) }
      dropdown.with_entry_divider
      searchable_statuses.each do |status|
        dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "#{status.titleize} only", path: url_for(sortable_search_params.merge(search_status: status)), match_params: {search_status: status}) }
      end
    end %>
  <% end %>
<% end %>
