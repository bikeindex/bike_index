<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::Dropdown::Component.new(name: @searched_gear_type.blank? ? "All types" : @searched_gear_type, button_size: :sm,
          active: @searched_gear_type.present?)) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All types", path: url_for(sortable_search_params.merge(search_gear_type: nil)), match_params: {search_gear_type: UI::ActiveLink::Component::BLANK}) } %>
      <% dropdown.with_entry_divider %>

      <% StravaGear::GEAR_TYPE_ENUM.each_key do |gear_type| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: gear_type.to_s.titleize, path: url_for(sortable_search_params.merge(search_gear_type: gear_type)), match_params: {search_gear_type: gear_type}) } %>
      <% end %>
    <% end %>
  </li>
<% end %>

<% table_view = render(partial: "table", locals: {collection: @collection, render_sortable: true}) %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  nav_header_list_items:, table_view:, chart_collection: @render_chart && matching_strava_gears,
)) %>
