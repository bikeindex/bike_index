<%= render(Pages::Admin::Headers::Nav::Component.new(title: "Bike Version")) %>

<div class="twwiderow tw:mt-6 tw:items-start">
  <% visibility_class = UI::Alerts::Base::Component::TEXT_CLASSES[:success] if @bike_version.all_visible? %>
  <% visibility_class = "twless-strong" if @bike_version.user_hidden? %>

  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "ID", dev_only: true, value: render(UI::Code::Inline::Component.new(text: @bike_version.id)), if: display_dev_info?) %>

    <% list.with_row(label: "Name", value: @bike_version.name) %>

    <% list.with_row(label: "Owner", value: render(Atoms::Admin::TableCells::User::Component.new(user: @bike_version.owner, user_id: @bike_version.owner_id))) %>

    <% list.with_row(label: "Visibility") do %>
      <span class="<%= visibility_class %>">
        <%= @bike_version.visibility&.humanize %>
      </span>
    <% end %>

    <% list.with_row(label: "Bike", value: render(Atoms::Admin::TableCells::Bike::Component.new(bike: @bike, bike_id: @bike_version.bike_id))) %>

    <% list.with_row(label: "Created", class: "tw:text-sm", value: render(UI::Time::Component.new(time: @bike_version.created_at, format: :localize_time_precise))) %>

    <% list.with_row(label: tag.span("Deleted", class: UI::Alerts::Base::Component::TEXT_CLASSES[:error]), class: "tw:text-sm", value: render(UI::Time::Component.new(time: @bike_version.deleted_at, format: :localize_time_precise)), if: @bike_version.deleted_at.present?) %>
  <% end %>

  <%= render(UI::TableList::Component.new) do |list| %>
    <% list.with_row(label: "Manufacturer", value: @bike_version.mnfg_name) %>
    <% list.with_row(label: "Frame model", value: @bike_version.frame_model) %>
    <% list.with_row(label: "Year", value: @bike_version.year) %>
    <% list.with_row(label: "Colors", value: @bike_version.frame_colors.join(", ")) %>
    <% list.with_row(label: "Cycle type", value: @bike_version.cycle_type_name) %>

    <% list.with_row(label: "Description", value: truncate(@bike_version.description, length: 200), if: @bike_version.description.present?) %>
  <% end %>
</div>

<% if @bike_version.public_images.any? %>
  <div class="tw:mt-6">
    <%= render(UI::Header::Component.new(text: "Images", tag: :h2)) %>

    <div class="tw:grid tw:gap-x-8 tw:md:grid-cols-4">
      <% @bike_version.public_images.each do |image| %>
        <%= image_tag image.image_url(:medium), alt: image.image_alt %>
      <% end %>
    </div>
  </div>
<% end %>
