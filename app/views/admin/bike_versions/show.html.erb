<div class="admin-subnav">
  <div class="col-md-12">
    <h1>Bike Version</h1>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-6">
    <% visibility_class = "text-success" if @bike_version.all_visible? %>
    <% visibility_class = "less-strong" if @bike_version.user_hidden? %>

    <%= render(UI::TableList::Component.new) do |list| %>
      <% if display_dev_info? %>
        <% list.with_row(label: "ID", dev_only: true, value: tag.code(@bike_version.id)) %>
      <% end %>

      <% list.with_row(label: "Name", value: @bike_version.name) %>

      <% list.with_row(label: "Owner", value: render(Atoms::Admin::TableCells::User::Component.new(user: @bike_version.owner, user_id: @bike_version.owner_id))) %>

      <% list.with_row(label: "Visibility") do %>
        <span class="<%= visibility_class %>">
          <%= @bike_version.visibility&.humanize %>
        </span>
      <% end %>

      <% list.with_row(label: "Bike", value: render(Atoms::Admin::TableCells::Bike::Component.new(bike: @bike, bike_id: @bike_version.bike_id))) %>

      <% list.with_row(label: "Created", class: "small", value: render(UI::Time::Component.new(time: @bike_version.created_at, format: :localize_time_precise))) %>

      <% if @bike_version.deleted_at.present? %>
        <% list.with_row(label: tag.span("Deleted", class: "text-danger"), class: "small", value: render(UI::Time::Component.new(time: @bike_version.deleted_at, format: :localize_time_precise))) %>
      <% end %>
    <% end %>
  </div>

  <div class="col-md-6">
    <%= render(UI::TableList::Component.new) do |list| %>
      <% list.with_row(label: "Manufacturer", value: @bike_version.mnfg_name) %>
      <% list.with_row(label: "Frame model", value: @bike_version.frame_model) %>
      <% list.with_row(label: "Year", value: @bike_version.year) %>
      <% list.with_row(label: "Colors", value: @bike_version.frame_colors.join(", ")) %>
      <% list.with_row(label: "Cycle type", value: @bike_version.cycle_type_name) %>

      <% if @bike_version.description.present? %>
        <% list.with_row(label: "Description", value: truncate(@bike_version.description, length: 200)) %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @bike_version.public_images.any? %>
  <div class="mt-4">
    <h3>Images</h3>

    <div class="row">
      <% @bike_version.public_images.each do |image| %>
        <div class="col-md-3">
          <%= image_tag image.image_url(:medium), class: "img-fluid", alt: image.image_alt %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
