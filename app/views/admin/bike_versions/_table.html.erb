<%# locals: (collection:, render_sortable: false) %>

<div
  data-controller="update-cached-sortable-links"
  data-update-cached-sortable-links-base-url-value="<%= url_for(sort_state.search_params) %>"
>
  <%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:,
        cache_key: cache_fragment_name(["admin_bike_versions", render_sortable]))) do |table| %>
    <% table.column(sortable: "created_at", lower_right: ->(record) { tag.span(record.id, class: "only-dev-visible") }) do |bike_version| %>
      <%= link_to admin_bike_version_path(bike_version), class: "twlink" do %>
        <%= render UI::Time::Component.new(time: bike_version.created_at) %>
      <% end %>
    <% end %>

    <% table.column(label: "Name", classes: "tw:text-xs") do |bike_version| %>
      <%= bike_version.name&.truncate(30) %>
    <% end %>

    <% table.column(sortable: "bike_id", label: "Bike") do |bike_version| %>
      <%= render Atoms::Admin::TableCells::Bike::Component.new(bike: bike_version.bike, bike_id: bike_version.bike_id) %>
    <% end %>

    <% table.column(sortable: "owner_id", label: "Owner") do |bike_version| %>
      <%= render Atoms::Admin::TableCells::User::Component.new(sort_state:, user: bike_version.owner, render_search: render_sortable) %>
    <% end %>

    <% table.column(sortable: "visibility") do |bike_version| %>
      <% if bike_version.user_hidden? %>
        <span class="less-strong">hidden</span>
      <% elsif bike_version.all_visible? %>
        <span class="text-success">visible</span>
      <% else %>
        <small><%= bike_version.visibility&.humanize %></small>
      <% end %>
    <% end %>

    <% table.column(label: "Details", classes: "tw:text-xs") do |bike_version| %>
      <%= bike_version.mnfg_name %>

      <% if bike_version.year.present? %>
        ( <%= bike_version.year %> )
      <% end %>
    <% end %>
  <% end %>
</div>
