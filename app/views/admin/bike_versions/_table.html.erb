<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", lower_right: (->(record) { tag.span(record.id, class: "only-dev-visible") } if display_dev_info?)) do |bike_version| %>
    <%= link_to admin_bike_version_path(bike_version), class: "twlink" do %>
      <%= render UI::Time::Component.new(time: bike_version.created_at) %>
    <% end %>
  <% end %>

  <% table.column(label: "Name", header_classes: "tw:font-normal", classes: "tw:text-xs") do |bike_version| %>
    <%= bike_version.name&.truncate(30) %>
  <% end %>

  <% table.column(sortable: "bike_id", label: "Bike") do |bike_version| %>
    <%= render Pages::Admin::Bikes::Cell::Component.new(bike: bike_version.bike, bike_id: bike_version.bike_id) %>
  <% end %>

  <% table.column(sortable: "owner_id", label: "Owner") do |bike_version| %>
    <% cache(bike_version.owner) do %>
      <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: bike_version.owner, render_search: render_sortable) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "visibility") do |bike_version| %>
    <% if bike_version.user_hidden? %>
      <span class="less-strong">hidden</span>
    <% elsif bike_version.all_visible? %>
      <span class="text-success">visible</span>
    <% else %>
      <small><%= bike_version.visibility&.humanize %></small>
    <% end %>
  <% end %>

  <% table.column(label: "Details", header_classes: "tw:font-normal", classes: "tw:text-xs") do |bike_version| %>
    <%= bike_version.mnfg_name %>

    <% if bike_version.year.present? %>
      ( <%= bike_version.year %> )
    <% end %>
  <% end %>
<% end %>
