<%# locals: (logged_searches:) %>

<%#
  Locals, not the conditions inline: each one both gates a column and keys the cells,
  and a column the cache_key misses shifts every cell after it
%>
<% render_created_at = sort_state.sort == "created_at" %>
<% render_serial = sort_state.sort == "serial_normalized" %>

<div
  data-controller="update-cached-sortable-links"
  data-update-cached-sortable-links-base-url-value="<%= url_for(sort_state.search_params) %>"
>
  <%= render(UI::Table::Component.new(records: logged_searches, render_sortable: true, sort_state:,
        cache_key: cache_fragment_name(["admin_logged_searches", render_created_at, render_serial]),
        cache_records: ->(logged_search) { logged_search.organization })) do |table| %>
    <% table.column(sortable: "request_at") do |logged_search| %>
      <%= render UI::Time::Component.new(time: logged_search.request_at, format: :localize_time_precise_seconds) %>
    <% end %>

    <% if render_created_at %>
      <% table.column(sortable: "created_at", classes: "tw:text-xs") do |logged_search| %>
        <%= render UI::Time::Component.new(time: logged_search.created_at) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "endpoint") do |logged_search| %>
      <code class="small" style="word-break: keep-all;">
        <%= logged_search.endpoint %>
        <%= link_to search_emoji, url_for(sort_state.search_params.merge(search_endpoint: logged_search.endpoint)), class: "display-sortable-link small" %>
      </code>
    <% end %>

    <% table.column(sortable: "ip_address") do |logged_search| %>
      <code class="small"><%= logged_search.ip_address %></code>
      <%= link_to search_emoji, url_for(sort_state.search_params.merge(search_ip_address: logged_search.ip_address)), class: "display-sortable-link small" %>
    <% end %>

    <% table.column(sortable: "city", label: "IP Location", classes: "tw:text-xs") do |logged_search| %>
      <%= logged_search.address(country: [:name, :skip_default]) %>
    <% end %>

    <% table.column(label: "Query") do |logged_search| %>
      <%= render UI::JsonDisplay::Component.new(data: logged_search.query_items, small: true, max_width: :table_cell) %>

      <% if logged_search.log_line.present? %>
        <div data-controller="ui--collapse">
          <%= render(UI::Collapse::Component.new(text: "↔️", color: :link, aria: {label: "Toggle the full log line"})) %>

          <code class="tw:hidden" data-ui--collapse-target="content">
            <%= logged_search.log_line %>
          </code>
        </div>
      <% end %>
    <% end %>

    <% table.column(sortable: "organization_id") do |logged_search| %>
      <%= render Pages::Admin::Organizations::Cell::Component.new(organization: logged_search.organization, organization_id: logged_search.organization_id, search_url: url_for(sort_state.search_params.merge(organization_id: logged_search.organization_id)), render_search: true, short_name: true) %>
    <% end %>

    <% table.column(sortable: "user_id") do |logged_search| %>
      <% if logged_search.user_id.present? %>
        <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: logged_search.user, render_search: true, user_id: logged_search.user_id) %>
      <% end %>
    <% end %>

    <% table.column(sortable: "stolenness") do |logged_search| %>
      <% unless logged_search.stolenness_all? %>
        <small><%= logged_search.stolenness %></small>
      <% end %>
    <% end %>

    <% table.column(sortable: "page") do |logged_search| %>
      <small><%= number_display(logged_search.page) %></small>
    <% end %>

    <% if render_serial %>
      <% table.column(sortable: "serial_normalized", label: "Serial") do |logged_search| %>
        <% if logged_search.serial_normalized.present? %>
          <small><code><%= logged_search.serial_normalized %></code></small>
        <% end %>
      <% end %>
    <% end %>

    <% table.column(sortable: "duration_ms", label: tag.span("Duration s", title: "Duration in seconds")) do |logged_search| %>
      <% if logged_search.duration_ms.present? %>
        <span title="<%= logged_search.duration_ms %> ms">
          <%= number_display((logged_search.duration_ms * 0.001).round(2)) %>
        </span>
      <% end %>
    <% end %>
  <% end %>
</div>
