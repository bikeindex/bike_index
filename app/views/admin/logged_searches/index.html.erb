<% rendered_chart = nil %>

<% if @render_chart %>
  <% rendered_chart = capture do %>
    <% if @endpoint.present? %>
      <% endpoints = matching_logged_searches.distinct.pluck(:endpoint).sort %>
      <% counts_by_endpoint = endpoints.map { |endpoint| {name: endpoint, data: time_range_counts(collection: matching_logged_searches.where(endpoint:), column: @time_range_column)} } %>
      <%= render(UI::Chart::Component.new(series: counts_by_endpoint, time_range: @time_range, stacked: true)) %>
    <% else %>
      <%= render(UI::Chart::Component.new(series: time_range_counts(collection: matching_logged_searches, column: @time_range_column), time_range: @time_range, stacked: true)) %>
    <% end %>
  <% end %>
<% end %>

<% table_view = capture do %>
  <% if params[:search_endpoint].present? %>
    <p class="tw:mb-4">
      Viewing only Searches <strong>to</strong>
      <% if special_endpoints.include?(params[:search_endpoint]) %>
        <em><%= params[:search_endpoint].humanize %></em>
      <% else %>
        <%= render(UI::Code::Inline::Component.new(text: params[:search_endpoint])) %>
      <% end %>
      <%= render(UI::ButtonLink::Component.new(href: url_for(sortable_search_params.merge(search_endpoint: nil)), text: "view for all endpoints", color: :link_gray, html_class: "tw:text-sm")) %>
    </p>
  <% end %>

  <% if params[:search_ip_address].present? %>
    <p class="tw:mb-4">
      Viewing only Searches <strong>from</strong>
      <%= render(UI::Code::Inline::Component.new(text: params[:search_ip_address])) %>

      <%= render(UI::ButtonLink::Component.new(href: url_for(sortable_search_params.merge(search_ip_address: nil)), text: "view from any ip address", color: :link_gray, html_class: "tw:text-sm")) %>
    </p>
  <% end %>

  <%= render partial: "table", locals: {logged_searches: @logged_searches} %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @logged_searches,
  viewing: "Logged Searches",
  rendered_chart:,
  table_view:,
)) do |skeleton| %>
  <% skeleton.with_nav_item do %>
    <% endpoint_filter_name = @endpoint == "all" ? "All endpoints" : special_endpoints.include?(@endpoint) ? @endpoint.humanize : @endpoint %>

    <%= render(UI::Dropdown::Component.new(name: endpoint_filter_name, button_size: :sm,
          active: @endpoint != "all")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All endpoints", path: url_for(sortable_search_params.merge(search_endpoint: nil)), match_params: {search_endpoint: nil}) } %>

      <% special_endpoints.each do |endpoint| %>
        <% endpoint_active = @endpoint == endpoint %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: endpoint.humanize, path: url_for(sortable_search_params.merge(search_endpoint: endpoint_active ? nil : endpoint)), match_params: {search_endpoint: endpoint}) } %>
      <% end %>

      <% dropdown.with_entry_divider %>

      <% LoggedSearch.endpoints.keys.each do |endpoint| %>
        <% endpoint_active = @endpoint == endpoint %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: endpoint, path: url_for(sortable_search_params.merge(search_endpoint: endpoint_active ? nil : endpoint)), match_params: {search_endpoint: endpoint}) } %>
      <% end %>
    <% end %>
  <% end %>

  <% skeleton.with_nav_item { render(UI::ButtonLink::Component.new(text: "serial", href: url_for(sortable_search_params.merge(search_serial: !@serial)), size: :sm, active: @serial)) } %>

  <% skeleton.with_nav_item { render(UI::ButtonLink::Component.new(text: "location", href: url_for(sortable_search_params.merge(search_with_location: !@with_location)), size: :sm, active: @with_location)) } %>

  <% skeleton.with_nav_item { render(UI::ButtonLink::Component.new(text: "include query", href: url_for(sortable_search_params.merge(search_includes_query: !@includes_query)), size: :sm, active: @includes_query)) } %>
<% end %>
