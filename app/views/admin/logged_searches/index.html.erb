<% nav_header_list_items = capture do %>
  <li>
    <% endpoint_filter_name = @endpoint == "all" ? "All endpoints" : special_endpoints.include?(@endpoint) ? @endpoint.humanize : @endpoint %>

    <%= render(UI::Dropdown::Component.new(name: endpoint_filter_name, button_size: :sm,
          active: @endpoint != "all")) do |dropdown| %>
      <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: "All endpoints", path: url_for(sortable_search_params.merge(search_endpoint: nil)), match: :query, query: {search_endpoint: nil}) } %>

      <% special_endpoints.each do |endpoint| %>
        <% endpoint_active = @endpoint == endpoint %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: endpoint.humanize, path: url_for(sortable_search_params.merge(search_endpoint: endpoint_active ? nil : endpoint)), match: :query, query: {search_endpoint: endpoint}) } %>
      <% end %>

      <% dropdown.with_entry_divider %>

      <% LoggedSearch.endpoints.keys.each do |endpoint| %>
        <% endpoint_active = @endpoint == endpoint %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: endpoint, path: url_for(sortable_search_params.merge(search_endpoint: endpoint_active ? nil : endpoint)), match: :query, query: {search_endpoint: endpoint}) } %>
      <% end %>
    <% end %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "serial", href: url_for(sortable_search_params.merge(search_serial: !@serial)), size: :sm, active: @serial)) %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "location", href: url_for(sortable_search_params.merge(search_with_location: !@with_location)), size: :sm, active: @with_location)) %>
  </li>

  <li>
    <%= render(UI::ButtonLink::Component.new(text: "include query", href: url_for(sortable_search_params.merge(search_includes_query: !@includes_query)), size: :sm, active: @includes_query)) %>
  </li>
<% end %>

<% rendered_chart = nil %>

<% if @render_chart %>
  <% rendered_chart = capture do %>
    <% if @endpoint.present? %>
      <% endpoints = matching_logged_searches.distinct.pluck(:endpoint).sort %>
      <% counts_by_endpoint = endpoints.map { |endpoint| {name: endpoint, data: time_range_counts(collection: matching_logged_searches.where(endpoint:), column: @time_range_column)} } %>
      <%= column_chart counts_by_endpoint, stacked: true, thousands: "," %>
    <% else %>
      <%= column_chart time_range_counts(collection: matching_logged_searches, column: @time_range_column), stacked: true, thousands: "," %>
    <% end %>
  <% end %>
<% end %>

<% table_view = capture do %>
  <% if params[:search_endpoint].present? %>
    <p>
      Viewing only Searches <strong>to</strong>
      <% if special_endpoints.include?(params[:search_endpoint]) %>
        <em><%= params[:search_endpoint].humanize %></em>
      <% else %>
        <code><%= params[:search_endpoint] %></code>
      <% end %>
      <%= link_to "view for all endpoints", url_for(sortable_search_params.merge(search_endpoint: nil)), class: "gray-link small" %>
    </p>
  <% end %>

  <% if params[:search_ip_address].present? %>
    <p>
      Viewing only Searches <strong>from</strong>
      <code><%= params[:search_ip_address] %></code>
      <%= link_to "view from any ip address", url_for(sortable_search_params.merge(search_ip_address: nil)), class: "gray-link small" %>
    </p>
  <% end %>

  <%= render partial: "table", locals: {logged_searches: @logged_searches} %>
<% end %>

<%= render(Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @logged_searches,
  viewing: "Logged Searches",
  rendered_chart:,
  nav_header_list_items:,
  table_view:,
)) %>
