<%# locals: (collection:, render_sortable: false, skip_marketplace_listing: false, truncate_length: 100) %>

<% render_id = display_dev_info? %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", lower_right: render_id ? ->(marketplace_message) { content_tag(:span, marketplace_message.id, class: "only-dev-visible") } : nil) do |marketplace_message| %>
    <%= link_to admin_marketplace_message_path(marketplace_message), class: "twlink" do %>
      <%= render UI::Time::Component.new(time: marketplace_message.created_at) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "amount_cents", label: "Amount", classes: "tw:text-xs") do |marketplace_message| %>
    <%= helpers.amount_display(marketplace_message.marketplace_listing, currency_name_suffix: :if_not_default) %>
  <% end %>

  <% unless skip_marketplace_listing %>
    <% table.column(sortable: "marketplace_listing") do |marketplace_message| %>
      <%= render Pages::Admin::Bikes::Cell::Component.new(bike: marketplace_message.item, bike_id: marketplace_message.item_id, bike_link_path: admin_bike_path(marketplace_message.item_id, active_tab: "messages"), search_url: url_for(sort_state.search_params.merge(search_marketplace_listing_id: marketplace_message.marketplace_listing_id)), render_search: render_sortable) %>
    <% end %>
  <% end %>

  <% table.column(label: "Body", header_classes: "tw:font-normal") do |marketplace_message| %>
    <% if marketplace_message.blocked? %>
      <small class="tw:text-red-500">
        Message blocked!
        <%= marketplace_message.blocked_reason&.to_s&.humanize %>
      </small>
    <% end %>

    <span title="<%= marketplace_message.body %>">
      <%= marketplace_message.body.truncate(truncate_length) %>
    </span>
  <% end %>

  <% table.column(sortable: "kind", label: "From") do |marketplace_message| %>
    <span class="<%= 'less-strong' if marketplace_message.sender_buyer? %>">
      <%= marketplace_message.kind_humanized %>
    </span>
  <% end %>

  <% table.column(sortable: "messages_prior_count", label: "Prior #", header_classes: "tw:text-xs") do |marketplace_message| %>
    <%= number_display(marketplace_message.messages_prior_count) %>
  <% end %>

  <% table.column(sortable: "sender_id") do |marketplace_message| %>
    <% cache(marketplace_message.sender) do %>
      <%= render Pages::Admin::Users::Cell::Component.new(sort_state:, user: marketplace_message.sender, render_search: render_sortable) %>
    <% end %>
  <% end %>
<% end %>
