<div class="tw:my-6">
  <%= render(UI::Container::Component.new) do %>
    <h4>Recovery display approval process</h4>

    <ol class="tw:list-decimal">
      <li>
        Remove last name from "Quote by" field
      </li>

      <li>
        Make sure there is a picture!
        <small class="twless-strong"> By default, if the bike has an image, it will use that image. click "upload a different image" if you want to use a different. </small>
      </li>

      <li>
        Edit the "Body" field and:
        <ul class="tw:ml-4 tw:list-disc">
          <li>
            Make sure the text is under the character count
            <small class="twless-strong"> there's a counter below that updates as you type </small>
          </li>

          <li>
            Remove any references to race, class, homelessness, etc. of the
            thief
          </li>

          <li>
            Fix typos and grammar
          </li>
        </ul>
      </li>
    </ol>
  <% end %>
</div>

<% if @bike&.manufacturer.present? %>
  <p class="tw:mt-6">
    <%= @bike.type_titleize %> manufacturer
    <%= link_to @bike.mnfg_name, admin_manufacturer_path(@bike.manufacturer), target: "_blank" %>
    - Twitter:
    <% if @bike.manufacturer.blank? || @bike.manufacturer.other? %>
      <em class="twless-strong">"other" manufacturer, no twitter</em>
    <% elsif @bike.manufacturer.twitter_name.present? %>
      <strong>@<%= @bike.manufacturer.twitter_name %></strong>
    <% else %>
      <em class="twless-strong tw:text-sm">Not stored</em>
      <%= link_to "Add one", edit_admin_manufacturer_path(@bike.manufacturer), target: "_blank" %>
    <% end %>
  </p>
<% end %>

<hr class="tw:mb-6">

<%# Toggle image initially if the recovery display hasn't been created, and there is an image to toggle %>
<% toggle_image_initially = @recovery_display.id.blank? && (@bike&.public_images&.present? || @bike&.stock_photo_url&.present?) %>

<%= form_for [:admin, @recovery_display], html: {
  data: {
    controller: "admin--recovery-display-form",
    "admin--recovery-display-form-toggle-image-value" => toggle_image_initially,
    "admin--recovery-display-form-remote-photo-url-value" => @bike&.image_url || ""
  }} do |f| %>
  <%= render(UI::Alerts::ObjectError::Component.new(object: @recovery_display, dismissable: true)) %>

  <% if @recovery_display.stolen_record_id.present? %>
    <%= f.hidden_field :stolen_record_id, value: @recovery_display.stolen_record_id %>
  <% end %>

  <div class="twwiderow twwiderow-3 tw:items-end">
    <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :quote_by, label_text: "Quote By")) do |group| %>
      <% group.with_label_note do %>
        (full name: <em><%= @recovery_display.calculated_owner_name %></em>)
      <% end %>
    <% end %>

    <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :location_string, label_text: "Location")) %>

    <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :link)) %>

    <% recovered_at = Binxtils::TimeParser.round(f.object.recovered_at || Time.current) %>

    <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :recovered_at, kind: :datetime_local_field, required: true,
      html_options: {value: recovered_at, max: Binxtils::TimeParser.round(Time.current + 1.day), class: "dateInputUpdateZone", "data-initialtime" => l(recovered_at, format: :convert_time)})) %>

    <% if @bike.present? %>
      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :bike_url,
        html_options: {value: bike_url(@recovery_display.bike), autocomplete: "off", disabled: true, class: "twless-strong"})) %>
    <% end %>
  </div>

  <div class="twwiderow">
    <div
      data-controller="admin--character-count"
      data-admin--character-count-max-value="<%= RecoveryDisplay::QUOTE_MAX_LENGTH %>"
    >
      <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :quote, kind: :text_area, label_text: "Body",
        html_options: {placeholder: "Quote about recovery", rows: 4,
                       data: {"admin--character-count-target" => "field", action: "input->admin--character-count#update"}})) %>

      <p
        class="text-info tw:-mt-2 tw:text-right tw:text-lg"
        data-admin--character-count-target="total"
      ></p>
    </div>

    <div>
      <div
        data-admin--recovery-display-form-target="notUsingBikeImage"
        class="tw:mt-6"
      >
        <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :photo, label_text: "Recovery photo")) do %>
          <%= render(UI::Forms::Files::Upload::Component.new(form_builder: f, attribute: :photo, accept: ImageUploader.permitted_extensions)) %>
        <% end %>
      </div>

      <% if @bike.present? && !@recovery_display.photo_processed? %>
        <div class="tw:mt-4">
          <% if @bike.public_images.present? || @bike.stock_photo_url.present? %>
            <% if @recovery_display.image_processing? %>
              <span class="<%= UI::Alerts::Base::Component::TEXT_CLASSES[:warning] %>">
                Image is still processing - please check back in a few minutes
                before re-uploading an image
              </span>
            <% end %>
            <%= f.hidden_field :remote_photo_url,
                data: { "admin--recovery-display-form-target" => "remotePhotoUrl" } %>
            <p data-admin--recovery-display-form-target="bikeImageText">
              <span data-admin--recovery-display-form-target="usingBikeImage">
                Using <%= @bike.type %> image
              </span>

              <span
                class="tw:hidden"
                data-admin--recovery-display-form-target="notUsingBikeImage"
              >
                <%= @bike.type_titleize %>

                <% if @bike.public_images.present? %>
                  has image
                <% else %>
                  has stock image
                <% end %>
              </span>

              <%= render(UI::Button::Component.new(html_class: "tw:ml-2",
                data: {"admin--recovery-display-form-target": "useImageButton", action: "click->admin--recovery-display-form#toggleImage"})) do %>
                <span
                  class="tw:hidden"
                  data-admin--recovery-display-form-target="notUsingBikeImage"
                >
                  Use first image
                </span>

                <span data-admin--recovery-display-form-target="usingBikeImage">
                  Upload a different image
                </span>
              <% end %>

              <% if (@bike.public_images.present? || @bike.stock_photo_url.present?) && @recovery_display.id.blank? %>
                <%= image_tag(@bike.image_url, class: "tw:mt-1 tw:w-24", alt: "Photo of the #{@bike.type}", data: { admin__recovery_display_form_target: "usingBikeImage" }) %>
              <% end %>
            </p>
          <% else %>
            Bike has no image
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="tw:my-6 tw:flex tw:justify-end">
    <%= render(UI::Button::Component.new(text: "Save", color: :primary, type: "submit")) %>
  </div>
<% end %>
