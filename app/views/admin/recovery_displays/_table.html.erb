<%# locals: (collection:, render_sortable: true) %>

<%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:)) do |table| %>
  <% table.column(sortable: "recovered_at", lower_right: ->(recovery_display) { content_tag(:code, recovery_display.id) }) do |recovery_display| %>
    <%= link_to edit_admin_recovery_display_url(recovery_display), class: "twlink" do %>
      <%= render UI::Time::Component.new(time: recovery_display.recovered_at) %>
    <% end %>
  <% end %>

  <% table.column(sortable: "created_at", classes: "tw:text-xs", header_classes: "less-strong") do |recovery_display| %>
    <%= render UI::Time::Component.new(time: recovery_display.created_at) %>
  <% end %>

  <% table.column(sortable: "updated_at", classes: "tw:text-xs") do |recovery_display| %>
    <span class="less-strong"><%= render UI::Time::Component.new(time: recovery_display.updated_at) %></span>
  <% end %>

  <% table.column(label: "Quote", header_classes: "tw:font-normal") do |recovery_display| %>
    <%= truncate(recovery_display.quote, length: 140) %>
  <% end %>

  <% table.column(label: "Quoter", header_classes: "tw:font-normal") do |recovery_display| %>
    <%= recovery_display.quote_by %>
  <% end %>

  <% table.column(label: "Location", header_classes: "tw:font-normal") do |recovery_display| %>
    <%= recovery_display.location_string %>
  <% end %>

  <% table.column(label: "image?", header_classes: "tw:font-normal tw:text-xs", classes: "tw:text-center") do |recovery_display| %>
    <%= check_mark if recovery_display.photo_processed? %>
  <% end %>

  <% table.column(label: "Association?", header_classes: "tw:font-normal tw:text-xs", classes: "tw:hidden tw:lg:table-cell tw:text-center") do |recovery_display| %>
    <%= check_mark if recovery_display.stolen_record_id.present? %>
  <% end %>
<% end %>
