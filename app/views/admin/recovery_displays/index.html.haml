- if @bike.present?
  = render Pages::Admin::Bikes::Header::Component.new(bike: @bike, active: :recovery_displays, display_recovery: true, user: current_user, display_dev_info: display_dev_info?)
  = render(UI::Header::Component.new(tag: :h2)) do
    Recovery displays
    = render(Pages::Admin::Headers::Count::Component.new(count: @pagy.count))
  = render partial: "table", locals: {collection: @recovery_displays}

- else
  = render(Pages::Admin::IndexSkeleton::Component.new(index: admin_index_state, viewing: controller_name.humanize, chart_collection: @render_chart && matching_recovery_displays, time_range_column: "recovery_displays.#{@time_range_column}", collection: @recovery_displays)) do |skeleton|
    - skeleton.with_nav_item do
      = render(UI::ButtonLink::Component.new(text: "New recovery display", href: new_admin_recovery_display_url, color: :primary, size: :sm))
    - skeleton.with_nav_item do
      = render(UI::ButtonLink::Component.new(text: "bust cache", href: admin_recovery_display_path("bust_cache"), color: :link, html_class: "twless-strong"))

