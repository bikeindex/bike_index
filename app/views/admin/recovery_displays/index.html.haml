- if @bike.present?
  = render Admin::Bikes::Header::Component.new(bike: @bike, active: :recovery_displays, display_recovery: true, user: current_user, display_dev_info: display_dev_info?)
  %h1.mt-5.mb-4 Recovery displays

- else
  - nav_header_list_items = capture_haml do
    %li
      = render(UI::ButtonLink::Component.new(text: "New recovery display", href: new_admin_recovery_display_url, color: :primary, size: :sm))
    %li
      = render(UI::ButtonLink::Component.new(text: "bust cache", href: admin_recovery_display_path("bust_cache"), color: :link, html_class: "twless-strong"))

  = render(Admin::IndexSkeleton::Component.new(index: admin_index_state, viewing: controller_name.humanize, chart_collection: @render_chart && matching_recovery_displays, nav_header_list_items:, time_range_column: "recovery_displays.#{@time_range_column}", collection: @recovery_displays))

