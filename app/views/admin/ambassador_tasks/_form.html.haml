= form_for ambassador_task,
  url: action,
  method: method,
  html: { class: "form" } do |f|

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :title, required: true))

  = render(UI::Forms::Group::Component.new(form_builder: f, attribute: :description, kind: :text_area)) do |group|
    - group.with_helper_text do
      [
      = link_to "Markdown",
        "https://www.markdownguide.org/getting-started",
        target: "_blank",
        tabindex: -1
      permitted
      ]

  = render(UI::Button::Component.new(text: submit_label, color: :primary, size: :lg, type: "submit"))
