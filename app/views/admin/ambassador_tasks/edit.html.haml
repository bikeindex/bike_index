.container
  %h1 Edit Ambassador Activity
  .text-right
    = render(UI::ButtonLink::Component.new(text: "Delete activity", href: admin_ambassador_task_path(@ambassador_task), method: :delete, color: :error, size: :sm, confirm: "Are you sure you want to delete this? This can't be undone"))

  = render "form",
    ambassador_task: @ambassador_task,
    action: admin_ambassador_task_path(@ambassador_task),
    method: :put,
    submit_label: "Save"
