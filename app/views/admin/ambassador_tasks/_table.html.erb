<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, classes: "ambassador-tasks-table")) do |table| %>
  <% table.column(label: "Title", header_classes: "tw:font-normal") do |task| %>
    <%= task.title %>
  <% end %>

  <% table.column(label: "Description", header_classes: "tw:font-normal") do |task| %>
    <%= task.description_html.html_safe %>
  <% end %>

  <% table.column(label: "") do |task| %>
    <%= link_to "Edit", edit_admin_ambassador_task_path(task), class: "twlink" %>
  <% end %>
<% end %>
