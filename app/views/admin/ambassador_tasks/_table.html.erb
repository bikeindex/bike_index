<%# locals: (collection:, render_sortable: false) %>

<%= render(UI::Table::Component.new(records: collection, classes: "tw:[&_td_p]:inline")) do |table| %>
  <% table.column(label: "Title") do |task| %>
    <%= task.title %>
  <% end %>

  <% table.column(label: "Description") do |task| %>
    <div class="tw:[&_a]:text-blue-600">
      <%= task.description_html.html_safe %>
    </div>
  <% end %>

  <% table.column(label: "") do |task| %>
    <%= link_to "Edit", edit_admin_ambassador_task_path(task), class: "twlink" %>
  <% end %>
<% end %>
