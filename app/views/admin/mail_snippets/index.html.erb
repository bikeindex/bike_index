<% nav_header_list_items = capture do %>
  <li>
    <%= render(UI::ButtonLink::Component.new(text: "new snippet", href: new_admin_mail_snippet_path, color: :primary, size: :sm)) %>
  </li>

  <li>
    <%= render(UI::Dropdown::Component.new(name: @search_kind == "all" ? "All kinds" : MailSnippet.kind_humanized(@search_kind), button_size: :sm,
          active: @search_kind != "all")) do |dropdown| %>
      <% (["all"] + MailSnippet.kinds).each do |kind| %>
        <% kind_active = @search_kind == kind %>
        <% kind_link_params = sortable_search_params.merge(search_kind: (kind_active ? nil : kind)) %>
        <% kind_humanized = kind == "all" ? "All kinds" : MailSnippet.kind_humanized(kind) %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: kind_humanized, path: admin_mail_snippets_path(kind_link_params), match_params: {search_kind: kind}) } %>

        <% if kind == "all" %>
          <% dropdown.with_entry_divider %>
        <% end %>
      <% end %>
    <% end %>
  </li>
<% end %>

<% table_view = capture do %>
  <%= render(UI::Table::Component.new(records: @mail_snippets, render_sortable: true, sort_state:)) do |table| %>
    <% table.column(sortable: "created_at") do |mail_snippet| %>
      <%= link_to render(UI::Time::Component.new(time: mail_snippet.created_at)), helpers.edit_mail_snippet_path_for(mail_snippet) %>
      <code class="small only-dev-visible"><%= mail_snippet.id %></code>
    <% end %>

    <% table.column(sortable: "updated_at", header_classes: "tw:text-xs") do |mail_snippet| %>
      <small><%= render(UI::Time::Component.new(time: mail_snippet.updated_at)) %></small>
    <% end %>

    <% unless current_organization.present? %>
      <% table.column(sortable: "organization_id") do |mail_snippet| %>
        <% if mail_snippet.organization.present? %>
          <%= link_to mail_snippet.organization&.short_name, admin_mail_snippets_path(sort_state.search_params.merge(organization_id: mail_snippet.organization_id)) %>
        <% end %>
      <% end %>
    <% end %>

    <% table.column(sortable: "kind") do |mail_snippet| %>
      <%= mail_snippet.kind_humanized %>
    <% end %>

    <% table.column(label: "Subject, Body") do |mail_snippet| %>
      <div class="d-block"><%= mail_snippet.subject %></div>
      <small><%= truncate(mail_snippet.body_stripped, length: 100) %></small>
    <% end %>

    <% table.column(label: "Enabled", header_classes: "tw:text-xs", classes: "table-cell-check") do |mail_snippet| %>
      <%= check_mark if mail_snippet.is_enabled %>
    <% end %>

    <% table.column(label: "Versions", header_classes: "tw:text-xs") do |mail_snippet| %>
      <% version_count = PaperTrail::Version.where(item_type: "MailSnippet", item_id: mail_snippet.id).count %>
      <%= link_to number_display(version_count), admin_paper_trail_versions_path(search_item_type: "MailSnippet", search_item_id: mail_snippet.id, period: "all") %>
    <% end %>
  <% end %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  viewing: controller_name.humanize,
  collection: @mail_snippets, nav_header_list_items:, table_view:, chart_collection: @render_chart && matching_mail_snippets,
)) %>
