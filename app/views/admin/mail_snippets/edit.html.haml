%h1{class: "tw:mt-6"}
  Edit Snippet

= render(UI::Container::Component.new(alignment: :left)) do
  = form_for [:admin, @mail_snippet] do |f|
    = render partial: 'form', locals: { f: f }

    = render(UI::Forms::Checkbox::Component.new(form_builder: f, attribute: :is_enabled, label: "Enabled?", class_name: "tw:mb-4"))

    %div{class: "tw:flex tw:justify-end"}
      = render(UI::Button::Component.new(text: "Update", color: :primary, type: "submit"))
