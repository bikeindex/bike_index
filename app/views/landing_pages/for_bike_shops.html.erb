<%# A template rather than a controller render: FeedbacksController re-renders it when a signup fails validation %>
<% total_bikes, recoveries_count, recoveries_value, organizations_count =
  Counts.retrieve_many("total_bikes", "recoveries", "recoveries_value", "organizations") %>

<%= render(SharedBlocks::Marketing::Wrapper::Component.new(page: Pages::LandingPages::ForBikeShops::Component.new(
  total_bikes:, recoveries_count:, recoveries_value:, organizations_count:,
  recovery_displays: RecoveryDisplay.where.not(quote_by: [nil, ""]),
  feedback: @feedback, current_user:))) %>
