<% settings = ComponentStructs::OrgSearchSettings.new(organization: current_organization) %>

<% search_kind = @search_kind %>

<% placeholders = {
  "serials" => "Enter multiple serial numbers, separated by commas or new lines",
  "stickers" => "Enter multiple sticker codes, separated by commas or new lines"
} %>

<% button_texts = {"serials" => "Search serials", "stickers" => "Search stickers"} %>

<% error_tooltip_template = capture do %>
  <%= render(UI::Tooltip::Component.new(text: "__MESSAGE__")) do %>
    <small class="tw:ml-3 tw:block tw:text-2xs tw:leading-none">error</small>
  <% end %>
<% end %>

<%# to_str on the two markup values: a SafeBuffer would land raw in the attribute %>
<%= tag.div(data: Pages::Org::Search::ColumnSettings::Component
  .column_settings_data_attributes(settings, controllers: "org--multi-search", collapse: true)
  .merge(
    "org--multi-search-url-value": multi_search_response_organization_registrations_path(organization_id: current_organization.to_param),
    "org--multi-search-search-kind-value": search_kind,
    "org--multi-search-serials-placeholder-value": placeholders["serials"],
    "org--multi-search-stickers-placeholder-value": placeholders["stickers"],
    "org--multi-search-serials-button-value": button_texts["serials"],
    "org--multi-search-stickers-button-value": button_texts["stickers"],
    "org--multi-search-empty-class-value": UI::Badge::Component.badge_classes(color: :empty, size: :md),
    "org--multi-search-success-class-value": UI::Badge::Component.badge_classes(color: :success, size: :md),
    "org--multi-search-gray-class-value": UI::Badge::Component.badge_classes(color: :gray, size: :md),
    "org--multi-search-error-class-value": UI::Badge::Component.badge_classes(color: :error, size: :md, cursor: "tw:cursor-help"),
    "org--multi-search-error-tooltip-value": error_tooltip_template.to_str,
    "org--multi-search-spinner-value": render(UI::LoadingSpinner::Component.new(size: :sm)).to_str
  )) do %>
  <div class="tw:mx-auto tw:mb-6 tw:max-w-2xl">
    <%= render(UI::Header::Component.new(text: "Multi Search", tag: :h3, html_class: "uncap tw:mb-4!")) %>

    <% if current_organization.enabled?("bike_stickers") %>
      <div class="tw:mb-4">
        <%= render UI::Forms::RadioButtonGroup::Component.new(
          name: :search_kind,
          kind: :toggle,
          selected: search_kind,
          entries: [
            {value: "serials", label: "Serials"},
            {value: "stickers", label: "Registration Stickers"}
          ],
          data: {action: "change->org--multi-search#switchKind"}
        ) %>
      </div>
    <% end %>

    <form data-action="submit->org--multi-search#submit">
      <%= text_area_tag :serials, nil,
        placeholder: placeholders[search_kind],
        class: "twinput tw:w-full tw:font-mono tw:h-32 tw:resize-none",
        data: {"org--multi-search-target": "textarea"} %>

      <div class="tw:mt-2 tw:flex tw:items-center tw:justify-between tw:gap-3">
        <div class="tw:flex tw:items-center tw:gap-2">
          <label class="tw:mb-0! tw:flex tw:cursor-pointer tw:items-center tw:gap-2">
            <%= check_box_tag :search_all, "1", false,
              data: {"org--multi-search-target": "searchAll"} %>

            <span>
              Search all bikes (not just <%= current_organization.short_name %>)
            </span>
          </label>

          <span
            data-org--multi-search-target="searchAllHint"
            class="tw:hidden tw:leading-none"
          >
            <%= render(UI::Tooltip::Component.new(text: "Sticker search always searches all bikes")) %>
          </span>
        </div>

        <%# Searching is JS-only, so org--multi-search enables this on connect %>
        <%= render UI::Button::Component.new(
          text: button_texts[search_kind],
          color: :primary,
          size: :lg,
          type: "submit",
          disabled: true,
          data: {"org--multi-search-target": "button"}
        ) %>
      </div>
    </form>
  </div>

  <div
    data-org--multi-search-target="serialChips"
    class="tw:mb-4 tw:flex tw:flex-wrap tw:gap-3"
  ></div>

  <div class="tw:mb-3 tw:flex tw:justify-end">
    <%= render(Pages::Org::Search::ColumnSettingsToggle::Component.new) %>
  </div>

  <div class="tw:mb-3">
    <%= render(Pages::Org::Search::ColumnSettings::Component.new(settings:)) %>
  </div>

  <div id="multi_serial_results" data-org--multi-search-target="results"></div>
<% end %>
