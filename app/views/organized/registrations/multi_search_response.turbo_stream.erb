<%= turbo_stream.append :multi_serial_results do %>
  <%= render Org::SearchResults::MultiResults::Component.new(
    organization: current_organization,
    query: @query,
    chip_id: @chip_id,
    pagy: @pagy,
    search_kind: @search_kind,
    bikes: @bikes,
    close_serials: @close_serials
  ) %>
<% end %>

<% if @chip_id %>
  <%= turbo_stream.replace @chip_id do %>
    <%= render Org::SearchResults::MultiResultChip::Component.new(
      chip_id: @chip_id,
      result_count: @pagy.count,
      label: @query,
      search_kind: @search_kind
    ) %>
  <% end %>
<% end %>
