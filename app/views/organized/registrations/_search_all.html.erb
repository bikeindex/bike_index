<%# locals: (search_all:, search_all_locked:, cycle_type:, org_name:) %>

<div class="tw:mt-3 tw:flex tw:items-center tw:gap-2">
  <label
    class="
      tw:mb-0! tw:flex tw:cursor-pointer tw:items-center tw:gap-2
      tw:has-disabled:cursor-not-allowed
    "
  >
    <%= check_box_tag :search_all, "true", search_all, form: "Search_Form",
      disabled: search_all_locked, class: "tw:disabled:cursor-not-allowed!",
      data: {action: "change->org--search#filterChanged", "org--search-target": "searchAll"} %>

    <span><%= t("organized.registrations.search.search_all_html", cycle_type: cycle_type.pluralize(2),
      org_name: org_name) %></span>
  </label>

  <%= tag.span(render(UI::Tooltip::Component.new(text: t("organized.registrations.search.search_all_email_disabled"))),
    class: "tw:leading-none", hidden: !search_all_locked,
    data: {"org--search-target": "searchAllHint"}) %>
</div>
