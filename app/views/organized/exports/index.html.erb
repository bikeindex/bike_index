<div class="organized-exports">
  <div class="organized-page-header">
    <%= render(UI::Header::Component.new(text: t(".org_exports_html", org_name: current_organization.name))) %>
  </div>

  <div class="text-right">
    <%= link_to t(".new_export"),
      new_organization_export_path(organization_id: current_organization.to_param),
      class: "btn btn-secondary" %>
  </div>

  <div class="mt-4">
    <p style="margin-bottom: 0;">
      <strong>
        <%= pluralize(number_with_delimiter(@pagy.count), t(".export")) %>
      </strong>
    </p>

    <% show_assigned_bike_codes = current_organization.enabled?("avery_export") || @exports.any? { |e| e.assign_bike_codes? } %>

    <% organization_id = current_organization.to_param %>
    <% download = t(".download") %>
    <% delete = t(".delete") %>

    <%= render(UI::Table::Base::Component.new(records: @exports)) do |table| %>
      <% table.column(label: safe_join([t(".created"), " ", tag.small(class: "localizeTimezone")])) do |export| %>
        <%= link_to render(UI::Time::Component.new(time: export.created_at)), organization_export_path(export, organization_id:), class: "twlink" %>
      <% end %>

      <% table.column(label: t(".creator")) do |export| %>
        <%= export&.user&.display_name %>
      <% end %>

      <% table.column(label: t(".progress")) do |export| %>
        <span class="<%= helpers.export_progress_class(export) %>">
          <%= export.calculated_progress %>
        </span>
      <% end %>

      <% table.column(label: "Matching registrations") do |export| %>
        <% if export.only_custom_bike_ids %>
          <em>only specified</em>
        <% else %>
          <%= export.matching_kinds.map(&:to_s).join(", ") %>
        <% end %>
      <% end %>

      <% if show_assigned_bike_codes %>
        <% table.column(label: current_organization.enabled?("avery_export") ? "Avery Export" : t(".stickers_assigned"), classes: "tw:text-center", header_classes: "tw:text-xs") do |export| %>
          <%= check_mark if export.avery_export? || export.assign_bike_codes? %>
        <% end %>
      <% end %>

      <% table.column(label: t(".bikes_in_export")) do |export| %>
        <%= number_display(export.rows) if export.finished? %>

        <% if export.assign_bike_codes? %>
          &nbsp;
          <%= render UI::Badge::Component.new(size: :sm, **helpers.export_stickers_badge_attributes(export)) %>
        <% end %>
      <% end %>

      <% table.column(label: download) do |export| %>
        <%= link_to(download, export.file.url, class: "twlink") if export.file.url.present? %>
      <% end %>

      <% table.column do |export| %>
        <small>
          <%= link_to delete,
            organization_export_path(export, organization_id:),
            method: :delete, class: "twlink" %>
        </small>
      <% end %>
    <% end %>
  </div>

  <div class="pb-4 pt-4">
    <%= render(UI::Pagination::Component.new(pagy: @pagy, page_params: params, size: :lg)) %>
  </div>
</div>
