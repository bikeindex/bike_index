<div class="organized-exports">
  <div class="organized-page-header">
    <%= render(UI::Header::Component.new) do %>
      <em><%= current_organization.name %></em> new export
    <% end %>
  </div>

  <%= form_for @export, url: organization_exports_path(organization_id: current_organization.to_param), html: { class: "organized-form", data: {controller: "org--export-form"} } do |f| %>
    <%= f.hidden_field :timezone, value: "", class: "hiddenFieldTimezone" %>

    <% if current_organization.enabled?("avery_export") %>
      <div class="form-group row">
        <%= f.label :avery_export, "Avery Label Export", class: "org-form-label" %>

        <div class="col-sm-4">
          <%= f.check_box :avery_export, checked: @export.avery_export?, data: {"org--export-form-target": "averyCheckbox", action: "org--export-form#update"} %>
        </div>
      </div>
    <% elsif current_organization.enabled?("bike_stickers") %>
      <div class="form-group row">
        <%= f.label :assign_bike_codes, "Assign bike stickers", class: "org-form-label" %>

        <div class="col-sm-4">
          <%= f.check_box :assign_bike_codes, data: {"org--export-form-target": "assignStickersCheckbox", action: "org--export-form#update"} %>
        </div>
      </div>
    <% end %>

    <% if current_organization.enabled?("avery_export") || current_organization.enabled?("bike_stickers") %>
      <div
        class="form-group row tw:hidden"
        data-org--export-form-target="stickerField"
      >
        <%= f.label :bike_code_start, "Initial Sticker #", class: "org-form-label" %>

        <div class="col-sm-6">
          <%= f.text_field :bike_code_start, value: current_organization.bike_stickers.next_unclaimed_code&.pretty_code, class: "form-control" %>

          <span class="below-input-help">
            Starting with given input, stickers will be incrementally assigned
            to bikes.
            <%# For avery, we assign bike stickers unless they leave blank. Otherwise, unselect "assign_bike_codes" %>
            <% if current_organization.enabled?("avery_export") %>
              Leave blank to skip assigning stickers to bikes
            <% end %>
          </span>
        </div>
      </div>
    <% end %>

    <% settings = ComponentStructs::OrgSearchSettings.new(organization: current_organization) %>

    <% expander_classes = "tw:mt-0.5 tw:justify-start tw:px-3 tw:py-2 tw:text-left tw:leading-tight tw:italic" %>

    <div class="mt-2 mb-4" data-org--export-form-target="hiddenOnAvery">
      <%= render(Pages::Org::Search::ColumnSettings::Component.new(settings:,
        export_headers: @export.headers.presence || settings.default_export_headers)) %>
    </div>

    <div
      class="form-group row mt-4"
      data-controller="org--field-expander"
      data-org--export-form-target="hiddenOnOnlyCustom"
    >
      <%= f.label :start_at, "Registered after", class: "org-form-label" %>

      <div class="col-sm-4">
        <% show_start = @export.start_at.present? %>

        <%= render(UI::Button::Component.new(text: "Set after time", color: :link,
          html_class: class_names(expander_classes, "tw:hidden!": show_start),
          data: {"org--field-expander-target": "collapsed", action: "org--field-expander#expand"})) %>

        <div
          class="<%= "tw:hidden" unless show_start %>"
          data-org--field-expander-target="expanded"
        >
          <%= f.datetime_local_field :start_at, step: 60, class: "form-control", data: {"org--field-expander-target": "time"} %>

          <div class="tw:text-right">
            <%= render(UI::Button::Component.new(text: "remove", color: :link, html_class: "tw:text-xs",
              data: {action: "org--field-expander#collapse"})) %>
          </div>
        </div>
      </div>
    </div>

    <div
      class="form-group row"
      data-controller="org--field-expander"
      data-org--export-form-target="hiddenOnOnlyCustom"
    >
      <%= f.label :end_at, "Registered before", class: "org-form-label" %>

      <div class="col-sm-4">
        <% show_end = @export.end_at.present? %>

        <%= render(UI::Button::Component.new(text: "Set before time", color: :link,
          html_class: class_names(expander_classes, "tw:hidden!": show_end),
          data: {"org--field-expander-target": "collapsed", action: "org--field-expander#expand"})) %>

        <div
          class="<%= "tw:hidden" unless show_end %>"
          data-org--field-expander-target="expanded"
        >
          <%= f.datetime_local_field :end_at, step: 60, class: "form-control", data: {"org--field-expander-target": "time"} %>

          <div class="tw:text-right">
            <%= render(UI::Button::Component.new(text: "remove", color: :link, html_class: "tw:text-xs",
              data: {action: "org--field-expander#collapse"})) %>
          </div>
        </div>
      </div>
    </div>

    <div class="form-group row" data-controller="org--field-expander">
      <%= f.label :custom_bike_ids, "Bikes to export", class: "org-form-label" %>

      <div class="col-sm-8">
        <% show_custom_bike_ids = @export.custom_bike_ids.present? || @export.only_custom_bike_ids %>

        <div class="row" data-org--export-form-target="hiddenOnOnlyCustom">
          <% if current_organization.enabled?("show_partial_registrations") %>
            <% include_full = @export.partial_registrations != "only" %>
            <% include_partial = @export.partial_registrations != false %>
            <div
              class="col-xs-4 mb-0"
              style="line-height: 1.25;"
              data-org--export-form-target="hiddenOnAvery"
            >
              <label class="checkbox">
                <%= check_box_tag :include_full_registrations, true, include_full %>
                Registered bikes
              </label>
            </div>
            <div
              class="col-xs-4 mb-0"
              style="line-height: 1.25;"
              data-org--export-form-target="hiddenOnAvery"
            >
              <label class="checkbox">
                <%= check_box_tag :include_partial_registrations, true, include_partial, data: {"org--export-form-target": "partialCheckbox"} %>
                Incomplete registrations
              </label>
            </div>
          <% end %>

          <% if current_organization.enabled?("impound_bikes") %>
            <div
              class="col-xs-4 mb-0"
              style="line-height: 1.25;"
              data-org--export-form-target="hiddenOnAvery"
            >
              <label class="checkbox">
                <%= check_box_tag :include_impounded_bikes, true, @export.impounded_bikes %>
                <em>Only</em> impounded bikes
              </label>
            </div>
          <% end %>

          <div class="col-xs-4 mb-0">
            <%= render(UI::Button::Component.new(text: "Add specific bikes to export", color: :link,
              html_class: class_names(expander_classes, "tw:hidden!": show_custom_bike_ids),
              data: {"org--field-expander-target": "collapsed", action: "org--field-expander#expand org--export-form#selectOnlyCustom"})) %>
          </div>
        </div>

        <div
          class="<%= "tw:hidden" unless show_custom_bike_ids %>"
          data-org--field-expander-target="expanded"
        >
          <%= f.text_area :custom_bike_ids, value: @export.custom_bike_ids&.join(", "), placeholder: "Put the Bike Index URLs for specific additional bikes to include in this export. Separate with newlines or commas", class: "form-control mt-1" %>

          <span class="below-input-help mt-2">
            For example:
            <%= render(UI::Code::Inline::Component.new(text: "https://bikeindex.org/bikes/123, https://bikeindex.org/bikes/4567")) %>
            <br>
            <span class="less-strong">(can also be just the IDs - e.g. for the above: <%= render(UI::Code::Inline::Component.new(text: "123, 4567")) %>)</span>
          </span>

          <label class="checkbox mt-0">
            <%= f.check_box :only_custom_bike_ids, data: {"org--export-form-target": "onlyCustomCheckbox", action: "org--export-form#update"} %>
            <em>Only</em> include specific bikes
          </label>
        </div>
      </div>
    </div>

    <div
      class="form-group row mt-2"
      data-org--export-form-target="hiddenOnAvery"
    >
      <%= f.label :format, "Export file format", class: "org-form-label" %>

      <div class="col-sm-4">
        <%= f.select :file_format, Export::VALID_FILE_FORMATS, {}, class: "form-control" %>
      </div>
    </div>

    <div class="row mt-4">
      <div class="form-submit-button">
        <%= f.submit "Create export", class: "btn btn-success btn-lg" %>
      </div>
    </div>
  <% end %>
</div>
