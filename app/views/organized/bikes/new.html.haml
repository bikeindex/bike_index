- if @unregistered_parking_notification
  - iframe_url = new_iframe_organization_bikes_path(organization_id: current_organization)
- else
  - iframe_url = embed_extended_organization_url(current_organization.slug)
  = render(UI::Header::Component.new(tag: :h2, html_class: "uncap tw:-mt-4 tw:mb-8! tw:pl-4 tw:font-semibold tw:italic tw:text-gray-900 tw:dark:text-gray-100")) do
    Try
    = link_to "the new registration flow", new_register_path(organization_id: current_organization.to_param), class: "twlink"
<iframe src="#{iframe_url}"></iframe>
