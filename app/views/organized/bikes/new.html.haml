- if @unregistered_parking_notification
  - iframe_url = new_iframe_organization_bikes_path(organization_id: current_organization)
- else
  - iframe_url = embed_extended_organization_url(current_organization.slug)
<iframe src="#{iframe_url}" data-controller="org--embed-iframe" data-action="load->org--embed-iframe#fit"></iframe>
- unless @unregistered_parking_notification
  %p{class: "tw:mt-8 tw:mb-8 tw:pl-4 tw:text-lg tw:font-semibold tw:text-gray-900 tw:italic tw:dark:text-gray-100"}
    = link_to t(".registration_form_settings"), settings_organization_registrations_path(organization_id: current_organization.to_param), class: "twlink"
