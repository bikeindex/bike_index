<div class="organized-page-header">
  <%= render(UI::Header::Component.new(text: t(".org_incomplete_registrations_html", org_name: current_organization.name))) %>
</div>

<% if @render_chart %>
  <%= render(UI::Chart::Component.new(series: time_range_counts(collection: @b_params_total, column: "b_params.created_at"), time_range: @time_range, stacked: true)) %>
<% end %>

<div class="text-right mb-2">
  <a
    class="btn btn-sm less-strong btn-outline-secondary <%= "active" if @render_chart %>"
    href="<%= incompletes_organization_bikes_path(sortable_search_params.merge(organization_id: current_organization.to_param, render_chart: !@render_chart)) %>"
  >
    Render chart
  </a>
</div>

<div class="tw:flex tw:justify-end">
  <%= render UI::PeriodSelect::Component.new(period: @period, start_time: @start_time, end_time: @end_time, sortable_search_params:) %>
</div>

<p class="mt-4">
  <strong>
    <%= @pagy.count %>
    <%= t(".matching") if params[:query].present? %>
  </strong>

  <%= t(".incomplete") %>
  <%= t(".registration").pluralize(@pagy.count) %>

  <em>
    <%= render(UI::TimeRange::Component.new(time_range: @time_range, period: @period)) %>
  </em>
</p>

<div class="mt-4 mb-2">
  <%= form_tag incompletes_organization_bikes_path(organization_id: current_organization.to_param), method: :get do %>
    <div class="row">
      <div class="col-sm-8 col-md-10">
        <div class="form-group">
          <%= text_field_tag :query, params[:query], placeholder: t(".search_emails"), class: "form-control" %>
        </div>
      </div>

      <div class="col-sm-4 col-md-2">
        <div class="actions">
          <%= submit_tag t(".search"), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% include_child_org = current_organization.child_ids.present? %>
<% organization = current_organization %>
<% show_dev_info = display_dev_info? %>
<% re_send = t(".re_send") %>
<% only_resend_with_permission = t(".only_resend_with_permission") %>

<%= render(UI::Table::Base::Component.new(records: @b_params, render_sortable: true, sort_state:)) do |table| %>
  <% table.column(sortable: "id", label: safe_join([t(".sent"), " ", tag.small(class: "localizeTimezone")])) do |b_param| %>
    <%= render(UI::Time::Component.new(time: b_param.created_at)) %>

    <% if show_dev_info %>
      <small class="only-dev-visible"><%= b_param.id %></small>
    <% end %>
  <% end %>

  <% table.column(label: t(".bike")) do |b_param| %>
    <strong>
      <%= b_param.primary_frame_color %>
    </strong>

    <%= b_param.mnfg_name %>
  <% end %>

  <% table.column(sortable: "cycle_type", label: t(".vehicle_type")) do |b_param| %>
    <% cycle_type = b_param.cycle_type %>

    <% if cycle_type.present? && cycle_type != "bike" %>
      <%= CycleType.slug_translation(cycle_type) %>
    <% else %>
      <span class="less-strong">bike</span>
    <% end %>
  <% end %>

  <% table.column(sortable: "motorized", label: t(".motorized")) do |b_param| %>
    <%= check_mark if b_param.motorized? %>
  <% end %>

  <% table.column(label: t(".step")) do |b_param| %>
    <%= render(Atoms::RegistrationStep::Component.new(b_param:)) %>
  <% end %>

  <% table.column(sortable: "email", label: t(".email")) do |b_param| %>
    <%= b_param.owner_email %>

    <% if include_child_org && b_param.organization != organization %>
      <small class="less-strong" style="display: block; line-height: 1;">
        <%= t("organized.bikes.incompletes.through_org", org_name: b_param.organization.short_name) %>
      </small>
    <% end %>
  <% end %>

  <% table.column do |b_param| %>
    <% resend_notifications = b_param.partial_notification_resends.pluck(:created_at, :delivery_status) %>

    <div class="less-strong-hold" style="min-width:2rem;">
      <% resend_notifications.each do |resend| %>
        <span class="d-block" style="line-height:1.2;">
          <small><%= render(UI::Time::Component.new(time: resend[0])) %></small>
          <%= helpers.notification_delivery_display(resend[1]) %>
        </span>
      <% end %>

      <%# Hacky restriction on the number of resends you can do %>
      <% unless resend_notifications.count > 3 %>
        <span class="less-strong-right less-strong">
          <%= render(UI::ButtonLink::Component.new(text: re_send,
            href: resend_incomplete_email_organization_bike_path(id: b_param.to_param, organization_id: organization.to_param),
            color: :link_gray,
            method: :post, confirm: only_resend_with_permission)) %>
        </span>
      <% end %>
    </div>
  <% end %>
<% end %>

<div class="pt-4 pb-4">
  <%= render(UI::Pagination::Component.new(pagy: @pagy, page_params: params, size: :lg)) %>
</div>
