.mb-4
  = render(UI::Header::Component.new(html_class: "uncap")) do
    - if @bulk_import.ascend?
      = t(".ascend_import")
    - elsif @bulk_import.impounded?
      = t(".bulk_import_impounded")
    - else
      = t(".bulk_import")
    = link_to "superadmin", admin_bulk_import_path(@bulk_import.to_param), class: "btn btn-outline-info less-strong float-right"
= render(UI::TableList::Component.new) do |list|
  - list.with_row(label: t(".created"), value: render(UI::Time::Component.new(time: @bulk_import.created_at)))
  - list.with_row(label: t(".progress"), value: render(partial: "/organized/bulk_imports/progress_display", locals: {bulk_import: @bulk_import, show_extended: true}))
  - list.with_row(label: t(".file")) do
    - if @bulk_import.file_cleaned?
      %span.text-warning= t(".file_removed")
      %em.small.less-strong= t(".file_removed_explanation")
    - else
      = link_to @bulk_import.file_url.truncate(100), @bulk_import.file_url
  - list.with_row(label: t(".matched_count"), value: number_with_delimiter(@bulk_import.matched_count), if: @bulk_import.matched_count.positive?)
  - list.with_row(label: t(".creator"), value: @bulk_import.user&.display_name || "-")
  - list.with_row(label: "Kind", value: @bulk_import.kind_humanized, if: permitted_kinds.count > 1)
  - list.with_row(label: "notes", if: @bulk_import.no_notify) do
    This import did <strong>not</strong> send emails

- if @bulk_import.import_errors?
  = render(UI::Header::Component.new(text: t(".errors"), tag: :h2, html_class: "mt-2 tw:mb-2!"))
  = render(Pages::Org::BulkImportError::Component.new(bulk_import: @bulk_import, display_dev_info: display_dev_info?))

= render(Pages::Org::Search::Wrapper::Component.new(organization: current_organization, pagy: @pagy, bikes: @bikes, per_page: @per_page, params: params))
