<div class="organized-page-header mb-4">
  <%= render(UI::Header::Component.new(html_class: "uncap")) do %>
    <% if current_organization.ascend_or_broken_ascend? %>
      <%= t(".org_ascend_imports_html", org_name: current_organization.name) %>
    <% else %>
      <%= t(".org_bulk_imports_html", org_name: current_organization.name) %>
    <% end %>
  <% end %>
</div>

<% if @render_chart %>
  <%= render(UI::Chart::Component.new(series: time_range_counts(collection: available_bulk_imports), time_range: @time_range, stacked: true)) %>
<% end %>

<div class="text-right mb-2">
  <a
    class="btn btn-sm less-strong btn-outline-secondary <%= 'active' if @render_chart %>"
    href="<%= organization_bulk_imports_path(sortable_search_params.merge(organization_id: current_organization.to_param, render_chart: !@render_chart)) %>"
  >
    Render chart
  </a>
</div>

<div class="mt-2 tw:flex tw:justify-end">
  <%= render UI::PeriodSelect::Component.new(period: @period, start_time: @start_time, end_time: @end_time, sortable_search_params:) %>
</div>

<div
  class="
    tw:mt-8 tw:mb-4 tw:flex tw:flex-wrap tw:items-center tw:justify-between
    tw:gap-2
  "
>
  <div>
    <%= pluralize(number_with_delimiter(@pagy.count), "matching import") %>
    <em><%= render(UI::TimeRange::Component.new(time_range: @time_range, period: @period)) %></em>
  </div>

  <div>
    <% search_filters = {
         "all" => t(".search_filter_all"),
         "without_errors" => t(".search_filter_without_errors"),
         "without_empty" => t(".search_filter_without_empty"),
         "only_empty" => t(".search_filter_only_empty"),
         "with_errors" => t(".search_filter_with_errors")
       } %>

    <%= render(UI::Dropdown::Component.new(name: search_filters[@search_filter], button_size: :sm, active: @search_filter != "all")) do |dropdown| %>
      <% search_filters.each do |filter, filter_name| %>
        <% dropdown.with_entry_item { render UI::ActiveLink::Component.new(text: filter_name, path: organization_bulk_imports_path(sortable_search_params.merge(organization_id: current_organization.to_param, search_filter: (@search_filter == filter) ? nil : filter)), match_params: {search_filter: (filter == "all") ? [filter, nil] : filter}) } %>

        <% dropdown.with_entry_divider if filter == "without_errors" %>
      <% end %>
    <% end %>

    <%= link_to t(".new_import"),
      new_organization_bulk_import_path(organization_id: current_organization.to_param),
      class: "btn btn-primary ml-2" %>
  </div>
</div>

<% organization_id = current_organization.to_param %>
<% display_dev_info = display_dev_info? %>
<% impounded = t(".impounded") %>

<%= render(UI::Table::Base::Component.new(records: @bulk_imports, render_sortable: true, sort_state:)) do |table| %>
  <% table.column(sortable: "created_at", label: t(".added")) do |bulk_import| %>
    <%= link_to render(UI::Time::Component.new(time: bulk_import.created_at)), organization_bulk_import_path(bulk_import, organization_id:), class: "twlink" %>
  <% end %>

  <% if @show_kind %>
    <% table.column(sortable: "kind", label: t(".kind")) do |bulk_import| %>
      <%= bulk_import.kind_humanized %>
    <% end %>
  <% end %>

  <% table.column(label: t(".progress")) do |bulk_import| %>
    <%= render partial: "/organized/bulk_imports/progress_display", locals: {bulk_import:} %>
  <% end %>

  <% table.column(label: t(".errors")) do |bulk_import| %>
    <%= render(Pages::Org::BulkImportError::Component.new(bulk_import:, short_display: true, display_dev_info:)) %>
  <% end %>

  <% table.column(sortable: "user_id", label: t(".creator")) do |bulk_import| %>
    <% if bulk_import.user.present? %>
      <%= bulk_import.user.display_name %>
    <% elsif bulk_import.ascend? %>
      <small class="less-strong">ascend</small>
    <% end %>
  <% end %>

  <% table.column(label: t(".registrations")) do |bulk_import| %>
    <%= number_display(bulk_import.ownerships.count) %>

    <% if bulk_import.impounded? %>
      <em class="small text-muted"><%= impounded %></em>
    <% end %>
  <% end %>
<% end %>

<div class="pb-4 pt-4">
  <%= render(UI::Pagination::Component.new(pagy: @pagy, page_params: params, size: :lg)) %>
</div>
