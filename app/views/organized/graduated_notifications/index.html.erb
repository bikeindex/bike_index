<%# TODO: add translations %>

<div class="organized-page-header">
  <%= render(UI::Header::Component.new(text: "Graduated notifications")) %>
</div>

<% unless current_organization.deliver_graduated_notifications? %>
  <div class="row mt-5 mb-5">
    <div class="col-md-6">
      <%= render(UI::Alerts::Base::Component.new(header: "Not delivering graduated notifications", margin_classes: "")) do %>
        <%= current_organization.name %> doesn't have a notification time period
        set, <strong>bikes are not being graduated.</strong>
        <br>
        Please email
        <%= link_to "gavin@bikeindex.org", "mailto:gavin@bikeindex.org", class: "twlink-underlined" %>
        to set up graduated notifications.
      <% end %>
    </div>
  </div>
<% end %>

<%#
  Preserve status/secondary in form's default hidden fields (@interpreted_params
  doesn't include them). Reads params, not @search_status, which is unset on
  non-turbo renders.
%>
<% form_interpreted_params = @interpreted_params.merge(search_status: params[:search_status], search_secondary: params[:search_secondary], search_email: params[:search_email]).compact %>

<%# Frame requests only need the results frame; skip the form (Turbo discards it) %>
<% unless turbo_frame_request? %>
  <%# twwiderow is what the cards' full_bleed reads to meet the gutter once it's one column %>
  <div class="twwiderow tw:mt-4 tw:gap-y-4">
    <div class="tw:min-w-0">
      <%= render(Pages::Org::Search::Form::Component.new(
        target_search_path: organization_graduated_notifications_path(organization_id: current_organization.to_param),
        target_frame: :graduated_notifications_results_frame,
        interpreted_params: form_interpreted_params,
        heading: "Find a graduated notification",
        submit_text: "Search graduated notifications",
      )) %>
    </div>

    <div class="tw:min-w-0">
      <%= render("organized/search_chart_card", id: :graduated_notifications_chart,
        src: organization_graduated_notifications_path(sortable_search_params.merge(organization_id: current_organization.to_param, chart_only: "1"))) %>
    </div>
  </div>
<% end %>

<%= render Pages::SearchResults::Frame::Component.new(frame_id: :graduated_notifications_results_frame,
  render_results: @render_results, current_path: request.original_fullpath) do %>
  <div class="tw:mt-4 tw:flex tw:justify-end">
    <%= render UI::PeriodSelect::Component.new(period: @period, start_time: @start_time, end_time: @end_time, sortable_search_params:) %>
  </div>

  <%= render partial: "results" %>
<% end %>
