<div class="tw:mx-auto tw:max-w-3xl tw:py-6">
  <%= render(UI::Header::Component.new(text: "Education courses", html_class: "uncap")) %>

  <%= render(UI::Header::Component.new(text: "Current", tag: :h2, html_class: "uncap tw:mb-2!")) %>

  <% if @active.present? %>
    <p class="tw:mb-2 tw:text-gray-600 tw:dark:text-gray-400">
      This is the active version your registrants see.
      <%= link_to "Preview", organization_education_course_path(organization_id: current_organization.to_param, id: @active.id), class: "twlink" %>
    </p>
    <div class="tw:mb-6">
      <%= render Pages::Org::EducationCourse::PageList::Component.new(education_course: @active) %>
    </div>
  <% else %>
    <p class="tw:mb-2 tw:text-gray-600 tw:dark:text-gray-400">
      There is no active education course.
    </p>
    <% if can_edit_education_courses? %>
      <p class="tw:mb-2 tw:text-gray-600 tw:dark:text-gray-400">
        Edit your draft course and contact Bike Index when you're ready to make
        it live.
      </p>
    <% end %>
  <% end %>

  <% if can_edit_education_courses? %>
    <%= render(UI::Header::Component.new(text: "Draft", tag: :h2, html_class: "uncap tw:mb-2!")) %>

    <%# POSTing opens the draft, cloning one if there isn't one %>
    <% draft_path = organization_education_courses_path(organization_id: current_organization.to_param) %>

    <% if @draft.present? %>
      <div
        class="
          tw:mb-2 tw:flex tw:flex-wrap tw:items-baseline tw:justify-between
          tw:gap-x-4 tw:gap-y-1
        "
      >
        <p class="tw:mb-0 tw:text-gray-600 tw:dark:text-gray-400">
          Your draft course, last edited
          <%= render UI::Time::Component.new(time: @draft.updated_at, format: :localize_time_precise) %>
        </p>

        <%= render UI::ButtonLink::Component.new(text: "Edit", href: draft_path, method: :post, color: :primary, form_class: "button_to tw:ml-auto") %>
      </div>
      <%# Read-only, like the active version above - the draft has its own screen %>
      <div class="tw:mb-6">
        <%= render Pages::Org::EducationCourse::PageList::Component.new(education_course: @draft, editable: false) %>
      </div>
      <div class="tw:mb-6 tw:flex">
        <%= render UI::ButtonLink::Component.new(text: "Discard draft", href: organization_education_course_path(organization_id: current_organization.to_param, id: @draft.id), method: :delete, color: :error, size: :sm,
          confirm: EducationCourse::DISCARD_DRAFT_CONFIRM, html_class: "tw:ml-auto") %>
      </div>
    <% else %>
      <p class="tw:mb-2 tw:text-gray-600 tw:dark:text-gray-400">
        You don't have a draft course
      </p>
      <div class="tw:mb-6">
        <%= render UI::ButtonLink::Component.new(text: @active.present? ? "Copy current course and edit" : "Create a course", href: draft_path, method: :post, color: :primary) %>
      </div>
    <% end %>
  <% end %>

  <% if @previous.any? %>
    <%= render(UI::Header::Component.new(text: "Previous", tag: :h2, html_class: "uncap tw:mb-2!")) %>
    <ul class="tw:list-none tw:text-gray-600 tw:dark:text-gray-400">
      <% @previous.each do |education_course| %>
        <li class="tw:mb-1">
          <%= link_to "Preview", organization_education_course_path(organization_id: current_organization.to_param, id: education_course.id), class: "twlink" %>
          ended
          <%= render UI::Time::Component.new(time: education_course.end_at) %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
