.organized-page-header.mb-4
  = render(UI::Header::Component.new(html_class: "text-center")) do
    %em= current_organization.name
    Dashboard

-# colors = { green: "#178813", red: "#d12310", orange: "#ffc281", blue: "#88a2e0" }
- org_manufacturer_counts = [{name: "#{current_organization.name} registrations", data: time_range_counts(collection: @manufacturer_bikes, column: "bikes.created_at")}]
= render(UI::Chart::Component.new(series: org_manufacturer_counts, time_range: @time_range, stacked: true, colors: ["#88a2e0"]))
.mt-4
-# Stolen records
- stolen_counts = [{name: "#{current_organization.name} Stolen reports", data: time_range_counts(collection: @stolen_records, column: "bikes.created_at")}]
= render(UI::Chart::Component.new(series: stolen_counts, time_range: @time_range, stacked: true, colors: ["#c0392b"]))

- if current_organization.enabled?("claimed_ownerships")
  :ruby
    claimed_ownerships = [
      # {name: "Registrations sent to new owner", data: time_range_counts(collection: @ownerships_to_new_owner, column: "ownerships.created_at")},
      {name: "Registrations claimed", data: time_range_counts(collection: @claimed_ownerships, column: "ownerships.claimed_at")}
    ]
  .mt-4
  = render(UI::Chart::Component.new(series: claimed_ownerships, time_range: @time_range, stacked: true, colors: ["#88a2e0", "#178813"]))

%div{ style: "margin-top: 50px;", class: "tw:flex tw:justify-end" }
  = render UI::PeriodSelect::Component.new(period: @period, start_time: @start_time, end_time: @end_time, sortable_search_params:)

= render(UI::Header::Component.new(tag: :h3, html_class: "uncap mt-4")) do
  Registrations
  = render(UI::TimeRange::Component.new(time_range: @time_range, period: @period))
.mt-4
  - organization_name = tag.em(current_organization.name)
  = render(UI::Table::List::Component.new(wide_definition: true)) do |list|
    - list.with_row(label: "Registered with #{current_organization.name} organization", value: number_display(@bikes_in_organization_count))
    - if current_organization.enabled?("claimed_ownerships")
      -# - list.with_row(label: "Registrations sent to new owners", value: number_display(@ownerships_to_new_owner.count))
      - list.with_row(label: "Registrations claimed by their owners", value: number_display(@claimed_ownerships.count))
    -# TODO: add shops visibility
    -# - list.with_row(label: "Registered by shops giving you visibility")
    - list.with_row(label: tag.strong(safe_join(["Total ", organization_name, " registrations"])), value: tag.strong(number_display(@manufacturer_bikes.count)))
    - list.with_row(label: safe_join(["Total Stolen ", organization_name, " bikes"]), value: number_display(@stolen_records.count))
    - list.with_row(label: safe_join(["Total Recovered ", organization_name, " bikes"]), value: number_display(@recovered_records.count))

  = render(UI::Header::Component.new(tag: :h3, html_class: "uncap mt-5")) do
    Registrations by organizations granting #{current_organization.name} visibility
    = render(UI::TimeRange::Component.new(time_range: @time_range, period: @period))
  .mt-4
    - time_range = @time_range
    = render(UI::Table::Base::Component.new(records: @child_organizations.reorder(:name))) do |table|
      - table.column(label: "Organization") do |organization|
        = link_to organization.name, organization_dashboard_index_path(organization_id: organization.to_param), class: "twlink"
      - table.column(label: "Signed up", header_classes: "tw:text-xs") do |organization|
        %small= render(UI::Time::Component.new(time: organization.created_at))
      - table.column(label: "Bikes") do |organization|
        = number_display(organization.bikes.where(created_at: time_range).count)
