- help_link = link_to "gavin@bikeindex.org", "mailto:gavin@bikeindex.org"

= render(UI::Header::Component.new(text: t(".welcome_to_your_ambassador_homepage"), html_class: "header-font-uncap"))

%p= t(".this_page_contains_the_resources_you_need")
%p= t(".being_a_bike_index_ambassador")
%p= t(".activities_for_registering_cyclists_html", help_link: help_link)

- if @suggested_activities.present?
  = render(UI::Header::Component.new(text: t(".suggested_activities"), tag: :h2))
  - user = current_user
  - organization = current_organization
  = render(UI::Table::Base::Component.new(records: @suggested_activities, classes: "tw:[&_td_p]:inline")) do |table|
    - table.column(label: t(".activity")) do |task|
      %strong= task.title
      %br
      = task.description_html.html_safe
    - table.column(label: t(".actions"), classes: "ambassador-toggle") do |task|
      - if task.is_a?(AmbassadorTaskAssignment)
        = helpers.button_to_toggle_task_completion_status(task, user, organization)

- if @completed_activities.present?
  = render(UI::Header::Component.new(text: t(".completed_activities"), tag: :h2))
  = render(UI::Table::Base::Component.new(records: @completed_activities, classes: "tw:[&_td_p]:inline")) do |table|
    - table.column(label: t(".activity")) do |task|
      %strong= task.title
      %br
      = task.description_html.html_safe
    - table.column(label: t(".completed")) do |task|
      = render(UI::Time::Component.new(time: task.completed_at))


= render(UI::Header::Component.new(text: t(".leaderboard"), tag: :h2))
= render(UI::Table::Base::Component.new(records: @ambassadors)) do |table|
  - table.column(label: t(".name")) do |ambassador|
    = ambassador.name
  - table.column(label: t(".activities")) do |ambassador|
    = number_display(ambassador.progress_count)
