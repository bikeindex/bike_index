- impound_claims ||= @impound_claims
- skip_impound_record ||= false
- skip_bike ||= false
- render_sortable ||= false
- render_resolved_at ||= false
- skip_status ||= false

- # TODO: add translations

- current_organization_id = current_organization.id
= render(UI::Table::Base::Component.new(records: impound_claims, render_sortable:, sort_state:)) do |table|
  - table.column(sortable: "created_at", label: "Created") do |impound_claim|
    = link_to render(UI::Time::Component.new(time: impound_claim.created_at, format: :localize_time_precise)), organization_impound_claim_path(impound_claim.id, organization_id: impound_claim.organization_id), class: "twlink"
  - table.column(sortable: "updated_at", label: "Updated") do |impound_claim|
    = render(UI::Time::Component.new(time: impound_claim.updated_at, format: :localize_time_precise))
  - unless skip_bike
    - table.column(label: "Claiming Bike") do |impound_claim|
      - if impound_claim.bike_submitting.present?
        = link_to helpers.organized_bike_text(impound_claim.bike_submitting), bike_path(impound_claim.bike_submitting, organization_id: current_organization_id), class: "twlink"
  - unless skip_impound_record
    - table.column(sortable: "impound_record_id", label: render_sortable ? "Impound record" : "Impound ID", header_classes: "tw:text-xs") do |impound_claim|
      - impound_record = impound_claim.impound_record
      - if impound_record.present?
        = link_to impound_record.display_id, organization_impound_record_path(impound_record.display_id, organization_id: impound_claim.organization_id), class: "twlink"
        %em.less-strong
          = link_to "view claims", organization_impound_claims_path(sort_state.search_params.merge(search_impound_record_id: impound_record.id)), class: "small gray-link"
  - unless skip_status
    - table.column(label: "Status") do |impound_claim|
      %em
        = helpers.status_display(impound_claim.status_humanized)
  - table.column(sortable: "user_id", label: "Claimant") do |impound_claim|
    = impound_claim.user&.display_name&.truncate(20)
  - if render_resolved_at
    - table.column(sortable: "resolved_at", label: "Resolved") do |impound_claim|
      = render(UI::Time::Component.new(time: impound_claim.resolved_at, format: :localize_time_precise))
