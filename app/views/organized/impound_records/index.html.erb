<div class="organized-page-header mb-4">
  <%= render(UI::Header::Component.new(text: t(".impound_records"), html_class: "uncap")) %>
</div>

<% form_interpreted_params = @interpreted_params.merge(search_email: params[:search_email]).compact %>

<%# org--search submits the settings panel's radios and keeps its summary in step %>
<div data-controller="org--search">
  <%# Frame requests only need the results frame; skip the form (Turbo discards it) %>
  <% unless turbo_frame_request? %>
    <%# twwiderow is what the cards' full_bleed reads to meet the gutter once it's one column %>
    <div class="twwiderow tw:mt-4 tw:gap-y-4">
      <div class="tw:min-w-0">
        <%= render(Pages::Org::Search::Form::Component.new(
          target_search_path: organization_impound_records_path(organization_id: current_organization.to_param),
          target_frame: :impound_records_results_frame,
          interpreted_params: form_interpreted_params,
          heading: t(".find_an_impound_record"),
          submit_text: t(".search_impound_records"),
          settings_and_filters_component: Pages::Org::Search::SettingsAndFilters::Component.new(
            settings: ComponentStructs::OrgImpoundSearchSettings.new(statuses: available_statuses,
              search_status: @search_status, search_unregisteredness: @search_unregisteredness),
            period: @period,
            start_time: @start_time,
            end_time: @end_time,
            sortable_search_params:
          )
        )) do %>
          <div class="tw:mt-2 tw:flex tw:items-center tw:justify-end tw:gap-2">
            <em class="tw:text-sm tw:text-gray-500">impounded within</em>
            <%= number_field_tag :search_proximity, @search_proximity, class: "twinput tw:w-20", step: 0.01 %>
            <em class="tw:text-sm tw:text-gray-500">miles of</em>
            <%= text_field_tag :search_location, params[:search_location], placeholder: "anywhere", class: "twinput tw:flex-1" %>
          </div>
        <% end %>
      </div>

      <div class="tw:min-w-0">
        <%= render("organized/search_chart_card", id: :impound_records_chart,
          src: organization_impound_records_path(sortable_search_params.merge(organization_id: current_organization.to_param))) %>
      </div>
    </div>
  <% end %>

  <%= render SharedBlocks::SearchResults::Frame::Component.new(frame_id: :impound_records_results_frame,
    render_results: @render_results, current_path: request.original_fullpath) do %>
    <%= render partial: "results" %>
  <% end %>
</div>
