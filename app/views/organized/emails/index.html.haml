-# TODO: add translations

.organized-page-header
  = render(UI::Header::Component.new(text: "Custom Emails"))

- all_snippet_kinds = current_organization.mail_snippets.where(kind: MailSnippet.organization_snippets_in_all).pluck(:kind)
- if all_snippet_kinds.any?
  = render(UI::Alerts::Base::Component.new(kind: :notice, margin_classes: 'tw:mt-4 mb-4')) do
    All of your emails include your custom #{all_snippet_kinds.map { MailSnippet.kind_humanized(_1)&.downcase }.to_sentence}.

:ruby
  organization = current_organization
  organization_id = organization.to_param
  email_rows = (viewable_email_kinds - ["organization_stolen_message"]).map do |kind|
    mail_snippets = if %w[finished_registration partial_registration].include?(kind)
      organization.mail_snippets.select { |mail_snippet| mail_snippet.in_email?(kind, exclude_all: true) }
    else
      organization.mail_snippets.where(kind:)
    end
    {kind:, title: MailSnippet.kind_humanized(kind), enabled: mail_snippets.any?(&:is_enabled),
     created_at: mail_snippets.first&.created_at, updated_at: mail_snippets.last&.updated_at, body: mail_snippets.first&.body_stripped}
  end
  stolen_message = OrganizationStolenMessage.for(organization) if organization.enabled?("organization_stolen_message")
  stolen_message_rows = [stolen_message].compact.map do |message|
    {kind: "organization_stolen_message", title: "Organization Stolen Message", enabled: message.is_enabled, created_at: message.content_added_at,
     updated_at: (message.updated_at if message.content_added_at.present?), body: message.body}
  end

= render(UI::Table::Base::Component.new(records: email_rows + stolen_message_rows)) do |table|
  - table.column(label: "Kind") do |row|
    = link_to row[:title], edit_organization_email_path(row[:kind], organization_id:), class: "twlink"
  - table.column(label: "Customized content enabled?", header_classes: "tw:text-xs") do |row|
    = check_mark if row[:enabled]
  - table.column(label: "Created") do |row|
    = render(UI::Time::Component.new(time: row[:created_at]))
  - table.column(label: "Last updated") do |row|
    = render(UI::Time::Component.new(time: row[:updated_at]))
  - table.column(label: "Body") do |row|
    %small= truncate(row[:body], length: 100)
