-# There is too much information to display using a flash notification, so use this template
- if @notifications_failed_resolved&.any?
  - failed_count = pluralize(@notifications_failed_resolved.count, "notification")
  - header = (@repeated_kind == "mark_retrieved") ? "Unable to mark #{failed_count} retrieved" : "Unable to send #{failed_count}"
  = render(UI::Alerts::Base::Component.new(kind: :warning, header:, margin_classes: "tw:mt-4 tw:mb-4")) do
    %ul
      - @notifications_failed_resolved.each do |parking_notification|
        %li{ class: "tw:mt-2 tw:leading-normal" }
          = link_to organization_parking_notification_path(parking_notification, organization_id: parking_notification.organization_id), class: "twlink-underlined" do
            %strong
              = parking_notification.kind_humanized
              notification
          created
          %span.localizeTime.preciseTime
            = l(parking_notification.created_at, format: :convert_time)
          %span.less-strong
            for the
            - if parking_notification.bike.present?
              %em
                = link_to organized_bike_text(parking_notification.bike), bike_path(parking_notification.bike), class: "twlink-underlined"
            - else
              Bike
            \- because it
            - if parking_notification.retrieved?
              was retrieved
              - if parking_notification.resolved_at.present?
                %span.localizeTime.preciseTime
                  = l(parking_notification.resolved_at, format: :convert_time)
            - elsif parking_notification.impounded?
              was impounded
              - if parking_notification.resolved_at.present?
                %span.localizeTime.preciseTime
                  = l(parking_notification.resolved_at, format: :convert_time)


-# We'll probably want to do something about these in the future as well, but skipping for now
-# @notifications_repeated
