<div class="tw:py-6">
  <div class="tw:mb-6 tw:flex tw:items-center tw:justify-between">
    <h1 class="uncap tw:text-2xl tw:font-semibold">
      <%= @page.persisted? ? "Edit page" : "Add page" %>
    </h1>

    <%= link_to "Back to pages", edit_organization_registration_sequence_path(organization_id: current_organization.to_param, id: @draft.id), class: "twlink" %>
  </div>

  <% form_url = @page.persisted? ?
    organization_registration_sequence_page_path(organization_id: current_organization.to_param, id: @page.id) :
    organization_registration_sequence_pages_path(organization_id: current_organization.to_param, registration_sequence_id: @draft.id) %>

  <%= form_with model: @page, url: form_url, method: @page.persisted? ? :patch : :post, html: {multipart: true} do |f| %>
    <%= render Org::RegistrationSequence::PageEdit::Component.new(form_builder: f) %>

    <div
      class="
        tw:mt-4 tw:flex tw:items-baseline tw:justify-between tw:pt-4
        tw:md:pt-8
      "
    >
      <%= render UI::Button::Component.new(text: @page.persisted? ? "Save page" : "Add page", color: :primary, kind: :submit) %>

      <% if @page.persisted? %>
        <%= render UI::ButtonLink::Component.new(text: "Delete page", href: organization_registration_sequence_page_path(organization_id: current_organization.to_param, id: @page.id), color: :error, size: :sm, data: {turbo: true, turbo_method: :delete, turbo_confirm: "This action can't be undone, you'll have to re-create the page"}) %>
      <% end %>
    </div>
  <% end %>
</div>
