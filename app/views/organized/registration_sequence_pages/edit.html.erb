<div class="tw:py-6" data-controller="page-preview">
  <% editing = @page.persisted? %>

  <div class="tw:mb-6 tw:flex tw:items-center tw:justify-between">
    <h1 class="uncap tw:text-2xl tw:font-semibold">
      <%= editing ? "Edit page" : "Add page" %>
    </h1>

    <%= link_to "Back to draft overview", edit_organization_registration_sequence_path(organization_id: current_organization.to_param, id: @draft.id), class: "twlink" %>
  </div>

  <% form_url = editing ?
    organization_registration_sequence_page_path(organization_id: current_organization.to_param, id: @page.id) :
    organization_registration_sequence_pages_path(organization_id: current_organization.to_param, registration_sequence_id: @draft.id) %>

  <%= form_with model: @page, url: form_url, html: {multipart: true} do |f| %>
    <%= render Org::RegistrationSequence::PageEdit::Component.new(form_builder: f) %>

    <div
      class="
        tw:mt-4 tw:flex tw:items-baseline tw:justify-between tw:pt-4
        tw:md:pt-8
      "
    >
      <%= render UI::Button::Component.new(text: editing ? "Save page" : "Add page", color: :primary, type: "submit") %>

      <% if editing %>
        <%= render UI::ButtonLink::Component.new(text: "Delete page", href: organization_registration_sequence_page_path(organization_id: current_organization.to_param, id: @page.id), color: :error, size: :sm, data: {turbo: true, turbo_method: :delete, turbo_confirm: "This action can't be undone, you'll have to re-create the page"}) %>
      <% end %>
    </div>
  <% end %>

  <% if editing %>
    <p
      data-page-preview-target="hint"
      hidden
      class="tw:mt-2 tw:mb-0 tw:text-sm tw:text-gray-500"
    >
      Save the page to see the updated preview.
    </p>
    <div data-page-preview-target="preview" class="tw:mt-8">
      <h2 class="uncap tw:mb-3 tw:text-xl">Preview</h2>

      <%= render Register::PageContent::Component.new(page: @page, first: @page.listing_order.to_i.zero?) %>
    </div>
  <% end %>
</div>
