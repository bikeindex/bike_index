-# TODO: add translations

.organized-page-header
  = render(UI::Header::Component.new(text: "E-Vehicle audits"))

%div{class: "tw:flex tw:justify-end"}
  = render UI::PeriodSelect::Component.new(period: @period, start_time: @start_time, end_time: @end_time, sortable_search_params:)

.mt-4.mb-4
  = pluralize(number_with_delimiter(@pagy.count), "matching models")
  %em
    = render(UI::TimeRange::Component.new(time_range: @time_range, period: @period))
  - if params[:search_mnfg_name].present?
    %span.less-strong
      for manufacturer
      %em
        = params[:search_mnfg_name]
      = link_to "view for all manufacturers", url_for(sortable_search_params.merge(search_mnfg_name: nil)), class: "gray-link small ml-1"

- render_sortable = true

- organization_model_audits ||= @organization_model_audits
- render_sortable ||= false
- manufacturer_other_id = Manufacturer.other.id
- skip_manufacturer_search ||= params[:search_mnfg_name].present?
- show_dev_info = display_dev_info?
- organization_id = current_organization.to_param
= render(UI::Table::Base::Component.new(records: organization_model_audits, render_sortable:, sort_state:)) do |table|
  - table.column(sortable: "mnfg_name", label: "Manufacturer") do |organization_model_audit|
    - model_audit = organization_model_audit.model_audit
    = model_audit.mnfg_name
    - unless skip_manufacturer_search
      %small= link_to "🔎", url_for(sort_state.search_params.merge(search_mnfg_name: model_audit.mnfg_name))
    - if model_audit.manufacturer_other.present? && show_dev_info
      %small.only-dev-visible other
  - table.column(sortable: "frame_model", label: "Model") do |organization_model_audit|
    - model_audit = organization_model_audit.model_audit
    = link_to helpers.model_audit_frame_model_display(model_audit), organization_model_audit_path(model_audit, organization_id:), class: "twlink"
    - if show_dev_info
      %small.only-dev-visible= organization_model_audit.id
  - table.column(sortable: "last_bike_created_at", label: "Most Recent registration") do |organization_model_audit|
    - if organization_model_audit.last_bike_created_at
      = render(UI::Time::Component.new(time: organization_model_audit.last_bike_created_at, format: :localize_time_precise))
    - else
      %span.less-strong= render(UI::Time::Component.new(time: organization_model_audit.updated_at, format: :localize_time_precise))
  - table.column(sortable: "bikes_count", label: "Vehicles #") do |organization_model_audit|
    %strong
      = number_display(organization_model_audit.bikes_count)
  - table.column(sortable: "certification_status") do |organization_model_audit|
    - model_audit = organization_model_audit.model_audit
    - if organization_model_audit.certification_status.present?
      %span{class: helpers.status_display_class(organization_model_audit.certification_status)}
        = organization_model_audit.certification_status_humanized
    - elsif model_audit.model_attestations.limit(1).present?
      %small.less-strong has attestation

    %a.btn.btn-sm.btn-secondary.float-right.updateModelCert{data: {toggle: "modal", target: "#update-model-cert-modal", modelauditid: model_audit.id, mnfgname: model_audit.mnfg_name, framemodel: model_audit.frame_model}}
      update

.pt-4.pb-4
  = render(UI::Pagination::Component.new(pagy: @pagy, page_params: params, size: :lg))

= render partial: "/organized/model_audits/submit_model_attestation"
