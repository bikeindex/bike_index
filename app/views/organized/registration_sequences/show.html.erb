<%# Full-bleed on mobile so the flow's gray runs edge to edge, past the org page's padding %>
<div class="tw:mx-[calc(50%_-_50vw)] tw:sm:mx-0">
  <%= render Org::RegistrationSequence::Preview::Component.new(registration_sequence: @registration_sequence, index: @preview_index) %>
</div>

<%# Below the gray. mt-24 clears the flow shell's -mb-18 pull-up. %>
<div class="tw:mt-24">
  <%= render UI::Pagination::Component.new(pagy: @preview_pagy,
    page_params: {organization_id: current_organization.to_param, id: @registration_sequence.id}) %>
</div>
