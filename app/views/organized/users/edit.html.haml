.mb-4
  = render(UI::Header::Component.new(text: t(".edit_organization_role_html", email: @organization_role.invited_email), html_class: "uncap"))

%p.text-right
  = render(UI::ButtonLink::Component.new(text: t(".remove_from_organization"),
    href: organization_user_path(id: @organization_role.id, organization_id: current_organization.to_param),
    method: :delete, color: :error,
    confirm: t(".confirmation", user_name: @name, org_name: current_organization.name)))

= render(UI::TableList::Component.new) do |list|
  - list.with_row(label: t(".invited"), value: render(UI::Time::Component.new(time: @organization_role.created_at, format: :localize_time_precise)))
  - list.with_row(label: t(".signed_up")) do
    - if @organization_role.claimed?
      = render(UI::Time::Component.new(time: @organization_role.claimed_at, format: :localize_time_precise))
    - else
      = t(".has_not_signed_up_html", name: @organization_role.invited_display_name)
  - list.with_row(label: t(".last_login"), value: render(UI::Time::Component.new(time: @organization_role.user&.last_login_at, format: :localize_time_precise)))
  - list.with_row(label: t(".last_login_ip"), value: (tag.code(@organization_role.user.last_login_ip) if @organization_role.user&.last_login_ip.present?))

= form_for @organization_role, { as: :organization_role, url: organization_user_path(id: @organization_role.id, organization_id: current_organization.to_param), action: 'update', html: { class: 'organized-form' } } do |f|
  .form-group.row
    %label.org-form-label= t(".email")
    .col-sm-4
      %p.static-form-control= @organization_role.user&.email

  = render partial: "organization_role_fields", locals: {f: f}

  .row.mt-4.form-group
    .form-submit-button
      = f.submit t(".update"), class: "btn btn-success btn-lg"
