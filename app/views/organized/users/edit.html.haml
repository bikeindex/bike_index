- organization_id = current_organization.to_param
- role_id = @organization_role.id
- name = @organization_role.invited_display_name
- own_role = @organization_role.user == current_user
%p
  = link_to organization_users_path(organization_id:), class: "twlink" do
    %span{"aria-hidden": "true"} ←
    = t(".back_to_users")

%div{class: "tw:mb-6 tw:flex tw:flex-wrap tw:items-start tw:justify-between tw:gap-4"}
  %div
    = render(UI::Header::Component.new(text: name, subtitle: (@organization_role.invited_email if name != @organization_role.invited_email), html_class: "uncap"))
  - unless own_role
    = render(UI::ButtonLink::Component.new(text: t(".remove_from_org"), href: organization_user_path(id: role_id, organization_id:),
      method: :delete, color: :error, size: :sm,
      confirm: t(".confirm_removal", user_name: name, org_name: current_organization.name)))

%div{class: "twwiderow tw:items-start"}
  - details = capture do
    = render(UI::Table::List::Component.new(classes: "tw:mb-0 tw:[&_th]:border-l-0 tw:[&_td]:border-l-0 tw:[&_tr:last-child_*]:border-b-0")) do |list|
      - list.with_row(label: t(".invited"), value: render(UI::Time::Component.new(time: @organization_role.created_at, format: :localize_time_precise)))
      - list.with_row(label: t(".invited_by"), value: (@organization_role.sender&.display_name || "—"))
      - list.with_row(label: t(".signed_up")) do
        - if @organization_role.claimed?
          = render(UI::Time::Component.new(time: @organization_role.claimed_at, format: :localize_time_precise))
        - else
          = t(".has_not_signed_up_html", name:)
      - list.with_row(label: t(".last_login"), if: @organization_role.user.present?, value: render(UI::Time::Component.new(time: @organization_role.user&.last_login_at, format: :localize_time_precise)))
      - list.with_row(label: t(".last_login_ip"), if: @organization_role.user.present?, value: (render(UI::Code::Inline::Component.new(text: @organization_role.user.last_login_ip)) if @organization_role.user&.last_login_ip.present?))
  = render partial: "card", locals: {title: t(".details"), body: details, padded: false}

  = form_for @organization_role, { as: :organization_role, url: organization_user_path(id: role_id, organization_id:), action: "update", html: {data: {controller: "org--role-form", action: "change->org--role-form#check"}} } do |f|
    - role = capture do
      = render partial: "organization_role_fields", locals: {f:, disabled: own_role}
      - unless own_role
        %div{class: "tw:mt-4"}
          = render(UI::Button::Component.new(text: t(".update_role"), color: :primary, size: :sm, type: "submit", disabled: true, data: {"org--role-form-target": "submit"}))
    = render partial: "card", locals: {title: t(".role"), body: role}
