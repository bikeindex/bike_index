- organization_id = current_organization.to_param
- restricted = current_organization.restrict_invitations?
- sent = current_organization.sent_invitation_count
- remaining = current_organization.remaining_invitation_count
= render partial: "back_link"

= render(UI::Header::Component.new(text: t(".invite_users_heading"), html_class: "uncap"))
- if restricted
  %p
    = t(".invited_so_far_html", count: sent, number: number_display(sent))
    = t(".invitations_remaining_html", count: number_display(remaining))
- if current_organization.enabled?("passwordless_users")
  %p= t(".automatic_passwordless")
- if current_organization.user_email_domain.present?
  = render(UI::Alerts::Base::Component.new(header: t(".you_have_a_permitted_domain"),
    text: t(".signing_in_with_permitted_domain_html", email_suffix: "@#{current_organization.user_email_domain}", org_name: current_organization.short_name)))

- form_data = {controller: "org--invite-form", "org--invite-form-emails-count-value": t(".emails_count").to_json,
  "org--invite-form-send-label-value": t(".send_invitation"), "org--invite-form-send-many-label-value": t(".send_invitations"),
  "org--invite-form-not-valid-value": t(".not_valid_email"), "org--invite-form-left-value": t(".only_invitations_left").to_json,
  "org--invite-form-remaining-value": (remaining if restricted)}
= form_for @organization_role, { as: :organization_role, url: organization_users_path(organization_id:), action: "create", html: {data: form_data} } do |f|
  = render(UI::Alerts::ObjectError::Component.new(object: @organization_role, name: t(".organization_role")))

  %div{class: "twwiderow tw:items-start"}
    - emails = capture do
      = render(UI::Forms::Group::Component.new(attribute: :multiple_emails_invited, label_text: t(".who_are_you_inviting"), optional_badge: false, wrapper_class: "tw:mb-0")) do
        = text_area_tag :multiple_emails_invited, params[:multiple_emails_invited], rows: 7, class: "twinput", "aria-describedby": "emails_help",
          placeholder: "alice@example.com\nquentin@example.com", data: {"org--invite-form-target": "emails", action: "input->org--invite-form#check"}
      %div{class: "tw:mt-2 tw:flex tw:flex-wrap tw:justify-between tw:gap-x-3 tw:text-sm tw:text-gray-500 tw:dark:text-gray-400"}
        %span#emails_help= t(".one_email_per_line")
        %span{class: "tw:font-semibold", data: {"org--invite-form-target": "count"}}
      %p{class: "tw:mt-1 tw:mb-0 tw:hidden tw:text-sm tw:text-red-600 tw:dark:text-red-400", data: {"org--invite-form-target": "invalid"}}
    = render partial: "card", locals: {title: t(".emails"), body: emails}

    = render partial: "card", locals: {title: t(".role"), body: render(partial: "organization_role_fields", locals: {f:})}

  %div{class: "tw:mt-6 tw:flex tw:flex-wrap tw:items-center tw:gap-4"}
    = render(UI::Button::Component.new(text: t(".send_invitation"), color: :primary, type: "submit", data: {"org--invite-form-target": "submit"}))
    %span{class: "tw:hidden tw:text-sm tw:text-red-600 tw:dark:text-red-400", data: {"org--invite-form-target": "limit"}}
