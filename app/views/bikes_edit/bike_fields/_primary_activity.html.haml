.form-group.row.fancy-select-placeholder.unfancy
  = f.label :primary_activity_id, t(".primary_activity"), class: "form-well-label"
  .form-well-input
    = f.collection_select(:primary_activity_id, PrimaryActivity.by_priority.includes(:primary_activity_family), :id, :display_name, {include_blank: true, prompt: t(".choose_activity")}, {class: "form-control"})
