- skip_bike_claimed ||= false
- skip_bike_submitting ||= false

= render(UI::Table::Base::Component.new(records: impound_claims)) do |table|
  - table.column(label: "Submitted") do |impound_claim|
    = render(UI::Time::Component.new(time: impound_claim.submitted_at, format: :localize_time_precise)) if impound_claim.submitted?
  - unless skip_bike_claimed
    - table.column(label: "Claimed") do |impound_claim|
      - if impound_claim.bike_claimed.present?
        = link_to impound_claim.bike_claimed.title_string, bike_path(impound_claim.bike_claimed), class: "twlink"
  - unless skip_bike_submitting
    - table.column(label: "Your bike") do |impound_claim|
      - if impound_claim.bike_submitting.present?
        = link_to impound_claim.bike_submitting.title_string, bike_path(impound_claim.bike_submitting), class: "twlink"
  - table.column(label: "Status") do |impound_claim|
    = helpers.status_display(impound_claim.status_humanized.titleize)
  - table.column(label: "Response") do |impound_claim|
    = impound_claim.response_message
