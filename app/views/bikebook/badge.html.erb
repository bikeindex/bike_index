<%# Plain English-only view, like the license page. %>
<%# TODO: Confirm the final badge artwork and this page's copy with the license page's IP review %>
<% email = mail_to("licensing@bikeindex.org", nil, class: "twlink")
  base = "/powered-by-bike-index"
  badges = [["horizontal", "light", 191, 58], ["horizontal", "dark", 191, 58], ["stacked", "light", 106, 99], ["stacked", "dark", 106, 99]] %>

<div
  class="
    tw:mx-auto tw:max-w-3xl tw:px-5 tw:py-10 tw:text-base tw:leading-relaxed
    tw:twtext-color
  "
>
  <%= render(UI::Header::Component.new(text: "Powered by Bike Index badge")) %>

  <p class="tw:my-3">
    Use the badge as provided, link it to
    <%= link_to("the Bike Book license page", bikebook_license_path, class: "twlink") %>,
    and place it near the data or with your other data credits. The badge
    doesn't replace the credit described there. For any other use of our name or
    logo, email <%= email %>.
  </p>

  <div class="tw:mt-8 tw:grid tw:gap-6 tw:sm:grid-cols-2">
    <% badges.each do |layout, theme, width, height| %>
      <% name = "powered-by-bike-index-#{layout}-#{theme}" %>

      <%= render(UI::Card::Component.new(additional_classes: "tw:flex tw:flex-col")) do %>
        <div class="tw:flex tw:min-h-28 tw:items-center tw:justify-center">
          <%= image_tag("#{base}/svg/#{name}.svg", alt: "Powered by Bike Index", width:, height:) %>
        </div>

        <p class="tw:mt-4 tw:mb-1 tw:font-bold">
          <%= layout.capitalize %>, <%= theme %>
        </p>

        <p class="tw:m-0 tw:text-sm">
          Download:
          <%= link_to("SVG", "#{base}/svg/#{name}.svg", download: "#{name}.svg", class: "twlink") %>,
          <%= link_to("PNG 2x", "#{base}/png/#{name}-2x.png", download: "#{name}-2x.png", class: "twlink") %>,
          <%= link_to("PNG 4x", "#{base}/png/#{name}-4x.png", download: "#{name}-4x.png", class: "twlink") %>
        </p>
      <% end %>
    <% end %>
  </div>
</div>
