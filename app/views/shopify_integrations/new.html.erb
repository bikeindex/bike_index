<%= render(UI::Header::Component.new(text: "Shopify", subtitle: "Register the bikes #{@organization.short_name} sells, from the serial on the sale.")) %>

<% if @shopify_integration.present? %>
  <div class="tw:mb-6">
    <p class="tw:mb-2">
      Connected to
      <a class="twlink" href="<%= @shopify_integration.admin_url %>"><%= @shopify_integration.shop_name %></a>
    </p>

    <dl class="tw:mb-4 tw:text-sm">
      <dt class="twlabel">Registrations from Shopify</dt>

      <dd class="tw:mb-2">
        <%= number_display(@shopify_integration.registrations_count) %>
      </dd>

      <% if @shopify_integration.last_order_at.present? %>
        <dt class="twlabel">Most recent sale</dt>
        <dd class="tw:mb-2">
          <%= render(UI::Time::Component.new(time: @shopify_integration.last_order_at)) %>
        </dd>
      <% end %>

      <% if @shopify_integration.last_error.present? %>
        <dt class="twlabel">Last error</dt>
        <dd class="tw:mb-2"><%= @shopify_integration.last_error %></dd>
      <% end %>
    </dl>

    <%= render(UI::ButtonLink::Component.new(text: "Disconnect", color: :error, size: :sm,
      href: shopify_integration_path(organization_id: @organization.to_param), method: :delete,
      confirm: "Stop registering bikes from #{@shopify_integration.shop_name}?")) %>
  </div>
<% else %>
  <div class="tw:mb-6">
    <p class="tw:mb-2">
      Write the serial into the sale before completing it &mdash; either on the
      item itself, or in the order notes &mdash; and the bike is registered to
      whoever bought it.
    </p>

    <p class="tw:mb-2">
      <code>Serial: A1234567</code> and <code>S/N: A1234567</code> both work.
      Anything sold without a serial in its notes is left alone, so tubes and
      helmets need no special handling.
    </p>

    <p>
      A sale of more than one bike needs the serial on each item rather than in
      the order notes, since the notes don't say which bike they mean.
    </p>
  </div>

  <%= form_with url: shopify_integration_path, method: :post, class: "tw:mb-6" do |f| %>
    <%= hidden_field_tag :organization_id, @organization.to_param %>
    <label class="twlabel" for="shop_domain">Your Shopify store</label>

    <%= text_field_tag :shop_domain, nil, class: "twinput tw:mb-4", autocomplete: "url",
      placeholder: "your-store.myshopify.com", required: true %>

    <%= render(UI::Button::Component.new(text: "Connect Shopify", color: :primary, type: "submit")) %>
  <% end %>
<% end %>
