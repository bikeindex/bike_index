.user-page
  .container
    - if @user_banned
      = render(UI::Alerts::Base::Component.new(kind: :error, header: t(".banned_user"), text: t(".banned_only_visible_to_superusers"), margin_classes: "tw:mb-8", default_header_color: true))
    - elsif @profile_hidden_reason
      = render(UI::Alerts::Base::Component.new(kind: :notice, header: t(".profile_hidden"), text: t(".profile_hidden_#{@profile_hidden_reason}"), margin_classes: "tw:mb-8"))
    .row
      .col-md-6
        .row
          .col-xs-3
            - if @user.avatar
              - unless @user.avatar.url(:medium) == 'https://files.bikeindex.org/blank.png'
                = image_tag @user.avatar.url(:medium), class: 'users-show-avatar'
          .col-xs-9
            %header.with-subtitle
            %h2
              - if @user.title.present?
                = @user.title
              - else
                = t(".this_users_bikes")
            %p.sharing-links
              =# show_sharing_links(@user)
      -# .col-md-6.ad-col
      -#   .ad-block.ad-binx.ad468x60
    - if @user.description
      .row
        .col-md-12
          .description
            = @user.description
    .row
      .col-md-8
        %h3= t(".bikes")
      .sharing-section.col-md-4
        = render '/shared/share_this'
    .row.shared-bikes-row
      .col-xs-12
        - if @bikes.any?
          .card-deck-wrapper
            .card-deck
              - @bikes.each do |bike|
                .card.mt-3
                  %a.bike-list-image{ href: bike_url(bike) }
                    = bike_thumb_image(bike)
                    - if bike.status_stolen?
                      %span.personal-page-stolen-tag
                        = t(".stolen")
                  .card-title
                    %h4
                      = link_to bike.title_string, bike_path(bike)
          .pt-4.pb-4
            = render(UI::Pagination::Component.new(pagy: @pagy, page_params: params, size: :lg))
        - else
          %h2
            = t(".this_user_has_no_bikes_yet")
