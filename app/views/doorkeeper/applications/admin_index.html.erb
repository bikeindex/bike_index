<% admin_search_form = capture do %>
  <%= form_tag oauth_applications_path, method: :get do %>
    <%= hidden_field_tag :search_all, true %>
    <%= render partial: "/shared/hidden_search_fields" %>

    <div class="tw:my-4 tw:flex tw:flex-wrap tw:items-center tw:justify-end tw:gap-2">
      <%= text_field_tag :search_query, params[:search_query], placeholder: "Name/Client ID", class: "twinput tw:w-auto" %>

      <%= render UI::Button::Component.new(text: "Search", color: :primary, type: "submit", name: "search") %>
    </div>
  <% end %>
<% end %>

<%= render(Pages::Admin::IndexSkeleton::Component.new(
  index: admin_index_state,
  collection: @collection,
  viewing: controller_name.humanize,
  admin_search_form:, chart_collection: @render_chart && @matching_applications,
)) %>
