<%# locals: (collection:, render_sortable: false) %>

<div
  data-controller="update-cached-sortable-links"
  data-update-cached-sortable-links-base-url-value="<%= url_for(sort_state.search_params) %>"
>
  <%= render(UI::Table::Component.new(records: collection, render_sortable:, sort_state:,
        cache_key: cache_fragment_name(["doorkeeper_applications_table", render_sortable]),
        cache_records: ->(application) { [application.owner] },
        row_attributes: ->(application) { {id: "application_#{application.id}"} })) do |table| %>
    <% table.column(sortable: "created_at") do |application| %>
      <%= link_to render(UI::Time::Component.new(time: application.created_at)), oauth_application_url(application) %>
    <% end %>

    <% table.column(sortable: "name", lower_right: ->(application) { tag.span(application.id, class: "only-dev-visible") }) do |application| %>
      <%= application.name %>

      <% if application.is_internal %>
        <%= render(UI::Badge::Component.new(text: "Internal", color: :notice, size: :sm)) %>
      <% end %>

      <% if application.can_send_stolen_notifications? %>
        <span class="text-warning">
          Has permission to send stolen notifications
        </span>
      <% end %>
    <% end %>

    <% table.column(sortable: "owner_id") do |application| %>
      <%# Pass in search_url because caching breaks with url_for %>
      <% search_url = oauth_applications_path(user_id: application.owner_id, search_all: true) %>
      <%= render Atoms::Admin::TableCells::User::Component.new(user: application.owner, user_id: application.owner_id, search_url:, render_search: render_sortable) %>
    <% end %>

    <% table.column(label: "Callback URLs", classes: "tw:max-w-[33vw] tw:overflow-x-scroll") do |application| %>
      <pre class="small mb-2"><%= application.redirect_uri.gsub(/\s+/, "\n") %></pre>
    <% end %>

    <% table.column(sortable: "tokens_count", label: "Tokens #", header_classes: "tw:text-xs") do |application| %>
      <small><%= helpers.number_display(application.access_tokens.count) %></small>
    <% end %>

    <% table.column(sortable: "ownerships_count", label: "Ownerships #", header_tooltip: "NOTE: only tracked since #{Time.at(START_TRACKING_REGISTRATION_APP_ID_AT).to_date}") do |application| %>
      <%= helpers.number_display(application.ownerships_count) %>
    <% end %>
  <% end %>
</div>
