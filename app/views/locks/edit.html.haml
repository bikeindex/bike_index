.container
  %header.with-subtitle
    %h1= t(".edit_the_lock")
    %p= link_to(t(".back_to_viewing_all_locks"), my_account_path(active_tab: 'locks'))

  = render partial: "form"

  .form-group.destroy-button
    = render(UI::ButtonLink::Component.new(text: t(".delete_this_lock"), href: {action: "destroy", id: @lock},
      method: :delete, color: :error, size: :lg, confirm: t(".are_you_sure")))
