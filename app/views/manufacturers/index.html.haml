- cache(['manufacturers_index2', @manufacturers.maximum(:updated_at)]) do
  - github_url = "https://github.com/bikeindex/bike_data/blob/main/data/manufacturers.csv"
  - csv_on_github = link_to t('.csv_on_github'), github_url
  %h1
    = t(".manufacturers_we_know_about")
  %p
    = t(".also_available_html", csv_on_github:)


  .mt-4
  = render(UI::Table::Base::Component.new(records: @manufacturers)) do |table|
    - table.column(label: t(".name")) do |manufacturer|
      - if manufacturer.website
        = link_to manufacturer.name, manufacturer.website, class: "twlink"
      - else
        = manufacturer.name
    - table.column(label: t(".only_makes_components"), classes: "table_cell_check") do |manufacturer|
      = check_mark unless manufacturer.frame_maker

  %h2.padded
    = t(".oh_no_were_missing_a_manufacturer")
  %p= t(".thats_not_actually_surprising")
  %p= t(".submit_a_pr_html", csv_on_github:)

