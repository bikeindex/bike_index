<div class="form-wrap" data-controller="my-account--organization-roles">
  <div class="form-well-form-header-always-visible">
    <h3><%= t(".organization_roles") %></h3>
  </div>

  <div class="col-xs-12">
    <p><%= t(".organization_role_information") %></p>

    <div class="tw:divide-y tw:divide-gray-200">
      <% @organization_roles.each do |organization_role| %>
        <% organization = organization_role.organization %>

        <%# Baseline, so the role sits on the same line as the organization's name %>
        <div
          class="tw:flex tw:items-baseline tw:gap-2 tw:py-2"
          data-my-account--organization-roles-target="item"
          data-organization-name="<%= organization.short_name %>"
          data-url="<%= my_account_organization_role_path(organization_role) %>"
        >
          <%= render UI::DragHandle::Component.new(controller: "my-account--organization-roles",
                html_class: "tw:self-center") %>

          <%#
            Rendered without an avatar too, so every row's name starts in the same place. The
            image is absolute, so its 100px doesn't set the height of the row - it takes the
            height of the two lines beside it instead
          %>

          <div class="tw:relative tw:w-11 tw:shrink-0 tw:self-stretch">
            <% if OrganizationDisplayer.avatar?(organization) %>
              <%= image_tag organization.avatar.url(:thumb), alt: "",
                    class: "tw:absolute tw:inset-0 tw:size-full tw:object-contain" %>
            <% end %>
          </div>

          <div class="tw:min-w-0 tw:flex-1">
            <%= link_to organization.short_name, organization_root_path(organization_id: organization.to_param), class: "twlink" %>

            <div class="tw:text-sm tw:text-gray-600">
              <%= t(".joined") %>
              <%= render UI::Time::Component.new(time: organization_role.claimed_at, preposition: true) %>
            </div>
          </div>

          <%# max-md rather than a size at both ends, so it keeps taking the name's size above %>
          <div class="tw:shrink-0 tw:max-md:text-sm">
            <%= t(".role_html", role: content_tag(:strong, t(".roles.#{organization_role.role}"))) %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <hr>

  <% first_organization_role = @organization_roles.first %>

  <div class="related-fields tw:pt-6">
    <div class="form-group row">
      <label class="form-well-label"><%= t(".use_on_login") %></label>

      <div class="form-well-input form-well-input-checks">
        <label>
          <%#
            The hidden field is what an unchecked box submits - check_box_tag doesn't render one.
            It shares the checkbox's name, so it can't carry its id too
          %>
          <%= hidden_field_tag :on_by_default, "0", id: nil %>
          <%= check_box_tag :on_by_default, "1", first_organization_role.on_by_default? %>

          <%# The name is its own element, so a drag can rewrite it to the new first organization %>
          <%= t(".automatically_show_organization_menu_html",
                org_name: content_tag(:span, first_organization_role.organization.short_name,
                  data: {"my-account--organization-roles-target": "organizationName"})) %>
        </label>
      </div>
    </div>
  </div>

  <%= render "/shared/form_well_footer_save" %>
</div>
