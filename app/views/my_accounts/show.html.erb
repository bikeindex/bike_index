<% membership = current_user.membership_active %>

<div class="container">
  <div class="row tw:flex tw:flex-wrap tw:items-end tw:py-4">
    <div class="tw:flex-1 tw:px-[15px] tw:pb-4">
      <h1 class="uncap mb-2">
        <%= t(".header_title", current_user_name: current_user.display_name) %>
      </h1>

      <% if membership.present? %>
        <h3 class="uncap">
          <%= t(".membership_subtitle", level: membership.basic? ? '' : membership.level_humanized) %>
        </h3>
      <% end %>
    </div>

    <% if membership.present? %>
      <div class="tw:flex tw:w-full tw:px-[15px] tw:sm:w-1/3">
        <%= render(Atoms::MemberBadge::Component.new(level: membership.level, shadow: true, classes: "tw:max-w-1/2! tw:sm:max-w-full! tw:mx-auto")) %>
      </div>
    <% end %>
  </div>
</div>

<div class="container">
  <div class="row">
    <div class="col-md-8">
      <ul class="user-items-nav nav nav-tabs" role="tablist">
        <li class="nav-item">
          <a
            class="<%= class_names("nav-link", active: !@locks_active_tab) %>"
            href="#bikes_tab_content"
            data-toggle="tab"
            data-role="tab"
          >
            <%= t(".bikes") %>
          </a>
        </li>

        <li class="nav-item">
          <a
            class="<%= class_names("nav-link", active: @locks_active_tab) %>"
            href="#locks_tab_content"
            data-toggle="tab"
            data-role="tab"
          >
            <%= t(".locks") %>
          </a>
        </li>
      </ul>

      <div class="user-items-content tab-content">
        <div
          class="<%= class_names("tab-pane", active: !@locks_active_tab) %>"
          id="bikes_tab_content"
        >
          <% if @bikes.present? %>
            <% user_alerts = Pages::MyAccount::Show::BikeBox::Component.user_alerts(current_user) %>
            <% unfinished_b_params = Pages::MyAccount::Show::BikeBox::Component.unfinished_b_params(@bikes) %>
            <ul class="bike-boxes">
              <% @bikes.each do |bike| %>
                <%= render(Pages::MyAccount::Show::BikeBox::Component.new(bike:, current_user:, user_alerts:, unfinished_b_params:)) %>
              <% end %>
            </ul>

            <div class="pt-4 pb-4">
              <%= render(UI::Pagination::Component.new(pagy: @pagy, page_params: params, size: :lg)) %>
            </div>
          <% else %>
            <h2><%= t(".you_have_no_registered_bikes") %></h2>
          <% end %>
        </div>

        <div
          class="<%= class_names("tab-pane", active: @locks_active_tab) %>"
          id="locks_tab_content"
        >
          <% if @locks.present? %>
            <% edit = t(".edit") %>

            <%= render(UI::Table::Base::Component.new(records: @locks)) do |table| %>
              <% table.column(label: t(".registered")) do |lock| %>
                <span class="mr-2"><%= render(UI::Time::Component.new(time: lock.created_at)) %></span>
                <small><%= link_to(edit, edit_lock_path(lock), class: "twlink") %></small>
              <% end %>

              <% table.column(label: t(".lock_type")) do |lock| %>
                <%= lock.lock_type&.name %>
              <% end %>

              <% table.column(label: t(".manufacturer")) do |lock| %>
                <%= lock.mnfg_name %>
              <% end %>

              <% table.column(label: t(".key_serial")) do |lock| %>
                <%= lock.key_serial %>
              <% end %>

              <% table.column(label: t(".combination")) do |lock| %>
                <%= lock.combination %>
              <% end %>

              <% table.column(label: t(".updated"), header_classes: "tw:text-xs") do |lock| %>
                <small><%= render(UI::Time::Component.new(time: lock.updated_at)) %></small>
              <% end %>
            <% end %>
          <% else %>
            <h2><%= t(".you_have_no_registered_locks") %></h2>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="side-box">
        <h3 class="first-item"><%= t(".register_new_items") %></h3>

        <div class="inner">
          <%= link_to t(".add_a_bike"), register_path, class: "btn btn-primary btn-lg" %>
          <%= link_to t(".add_a_lock"), new_lock_url, class: "btn btn-primary-offset btn-lg" %>
        </div>

        <h3><%= t(".next") %></h3>

        <div class="inner last-item tw:space-y-2 tw:[&_.lock-group]:mb-0 tw:[&_p]:mb-0">
          <% if @bikes.present? %>
            <div class="lock-group">
              <div class="image-column">
                <% if @bikes.last.status_stolen? %>
                  <%= image_tag 'icons/emoji-crying.png', alt: 'Crying, sad face' %>
                <% else %>
                  <%= image_tag 'icons/emoji-smiling.png', alt: 'Happy, Smiling face' %>
                <% end %>
              </div>

              <div class="col-xs-10">
                <p>
                  <% if @bikes.count > 0 %>
                    <% if @bikes.last.status_stolen? %>
                      <%= t(".sorry_your_bike_was_stolen", bikes_last_type: @bikes.last.type) %>
                    <% else %>
                      <%= t(".thanks_for_adding_your_bike", bikes_last_type: @bikes.last.type) %>
                    <% end %>
                  <% else %>
                    <strong><%= t(".welcome") %></strong>
                    <%= t(".to_bike_index_thanks_for_signing_up") %>
                  <% end %>
                </p>
              </div>
            </div>
          <% end %>

          <div class="lock-group">
            <div class="image-column">
              <%= image_tag 'revised/update_account_icon.svg', alt: "" %>
            </div>

            <div class="col-xs-10">
              <p>
                <strong><%= t(".tell_us_more_about_yourself") %></strong>
                <%= link_to t(".update_your_profile"), edit_my_account_url %>
              </p>
            </div>
          </div>

          <%= render(Pages::MyAccount::StravaIntegration::Component.new(user: current_user)) %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if OrganizedMailer.render_donation?(user: current_user, emails: [current_user.email]) %>
  <%# Cache this render callout to avoid allocations %>
  <% cache("donation_modal2") do %>
    <%= render "/shared/donation_modal" %>
  <% end %>
<% end %>
