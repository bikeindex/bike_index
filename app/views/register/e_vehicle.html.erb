<div class="tw:mx-auto tw:max-w-md tw:px-4 tw:py-10">
  <%= render UI::Card::Component.new(shadow: true) do %>
    <%= render Registrations::New::Progress::Component.new(step: 3, total: 3) %>

    <div class="tw:mb-3">
      <%= render UI::Badge::Component.new(text: "⚡️ #{t(".electric_detected")}", color: :warning) %>
    </div>

    <%= render Registrations::New::Heading::Component.new(title: t(".e_vehicle_attestation"), subtitle: t(".confirm_details_below")) %>

    <%= form_with(url: register_path, method: :patch) do %>
      <%= hidden_field_tag :b_param_token, @b_param.id_token %>
      <%= hidden_field_tag :finalize, true %>

      <div
        class="
          tw:divide-y tw:divide-gray-100 tw:rounded-sm tw:border
          tw:border-gray-200 tw:px-4 tw:dark:divide-gray-700
          tw:dark:border-gray-700
        "
      >
        <label class="tw:flex tw:cursor-pointer tw:items-start tw:gap-3 tw:py-3.5">
          <%= check_box_tag "e_vehicle_attestation[en_15194]", true, false, class: "tw:mt-0.5 tw:h-4 tw:w-4" %>

          <span class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-300">
            <%= t(".meets_certification") %>
          </span>
        </label>

        <label class="tw:flex tw:cursor-pointer tw:items-start tw:gap-3 tw:py-3.5">
          <%= check_box_tag "e_vehicle_attestation[motor_under_750w]", true, false, class: "tw:mt-0.5 tw:h-4 tw:w-4" %>

          <span class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-300">
            <%= t(".motor_under_750w") %>
          </span>
        </label>

        <label class="tw:flex tw:cursor-pointer tw:items-start tw:gap-3 tw:py-3.5">
          <%= check_box_tag :propulsion_type_pedal_assist, true, false, class: "tw:mt-0.5 tw:h-4 tw:w-4" %>

          <span class="tw:text-sm tw:text-gray-700 tw:dark:text-gray-300">
            <%= t(".pedal_assist") %>
          </span>
        </label>
      </div>

      <label class="tw:my-5 tw:flex tw:cursor-pointer tw:items-start tw:gap-3">
        <%= check_box_tag "e_vehicle_attestation[accurate]", true, false, class: "tw:mt-0.5 tw:h-4 tw:w-4" %>

        <span class="tw:text-sm tw:font-semibold tw:text-gray-800 tw:dark:text-gray-200">
          <%= t(".i_attest") %>
        </span>
      </label>

      <%= render UI::Button::Component.new(text: t(".complete_registration"), color: :primary,
        size: :lg, kind: :submit, html_class: "tw:w-full") %>
    <% end %>

    <%= form_with(url: register_path, method: :patch, html: {class: "tw:mt-3 tw:text-center"}) do %>
      <%= hidden_field_tag :b_param_token, @b_param.id_token %>
      <%= hidden_field_tag :finalize, true %>
      <%= hidden_field_tag :propulsion_type_motorized, false %>
      <%= render UI::Button::Component.new(text: t(".skip_not_an_e_vehicle"), color: :link, kind: :submit) %>
    <% end %>
  <% end %>
</div>
