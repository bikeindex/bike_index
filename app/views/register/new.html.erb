<div
  class="
    tw:-mt-9 tw:-mb-18 tw:bg-gray-100 tw:px-4 tw:py-10 tw:min-[992px]:-mt-15
    tw:dark:bg-gray-900
  "
>
  <div class="tw:mx-auto tw:max-w-md">
    <%= render Registrations::New::Progress::Component.new(step: 1, total: 2) %>
    <%= render Registrations::New::Heading::Component.new(title: t(".register_your_bike"), subtitle: t(".just_the_essentials")) %>

    <% if @b_param.errors.any? %>
      <%= render UI::Alert::Component.new(kind: :error, text: @b_param.errors.full_messages.to_sentence) %>
    <% end %>

    <%= form_with(url: register_path, method: :post, scope: :b_param) do |f| %>
      <%= render Registrations::New::SectionLabel::Component.new(text: t(".bike_info")) %>

      <div class="tw:mb-4">
        <%= render Form::Combobox::Component.new(name: :manufacturer_id, form: f,
          label: t(".manufacturer"), label_class: "twlabel", free_text: true,
          value: @b_param.bike["manufacturer_other"].presence || @b_param.bike["manufacturer_id"],
          placeholder: t(".manufacturer_placeholder"),
          options: Manufacturer.frame_makers.pluck(:name, :id)) %>
      </div>

      <div class="tw:mb-4">
        <%= f.label :frame_model, class: "twlabel" do %>
          <%= t(".model") %>
          <%= render UI::Badge::Component.new(text: t(".optional"), color: :muted, size: :xs) %>
        <% end %>

        <%= f.text_field :frame_model, value: @b_param.bike["frame_model"],
          placeholder: t(".model_placeholder"), class: "twinput tw:mt-1" %>
      </div>

      <label class="twlabel tw:mb-4 tw:flex tw:items-center tw:gap-2">
        <%= check_box_tag :propulsion_type_motorized, true, @b_param.motorized?, class: "tw:h-4 tw:w-4" %>
        <%= t(".electric_motorized") %>
      </label>

      <%= render Registrations::New::SectionLabel::Component.new(text: t(".your_info"), divider: true) %>

      <div class="tw:mb-6">
        <%= f.label :owner_email, class: "twlabel" do %>
          <%= t(".email") %>
          <span class="tw:text-red-600">*</span>
        <% end %>

        <%= f.email_field :owner_email, value: @b_param.owner_email, required: true,
          placeholder: t(".email_placeholder"), class: "twinput tw:mt-1" %>

        <p class="tw:mt-1.5 tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">
          <%= t(".confirmation_link_here") %>
        </p>
      </div>

      <%= render UI::Button::Component.new(text: t(".next"), color: :purple, size: :lg,
        kind: :submit, html_class: "tw:w-full") %>

      <p
        class="
          tw:mt-3 tw:text-center tw:text-xs tw:text-gray-500
          tw:dark:text-gray-400
        "
      >
        <%= t(".no_need_to_wait") %>
      </p>
    <% end %>
  </div>
</div>
