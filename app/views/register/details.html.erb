<%= render Registrations::New::Page::Component.new do %>
  <%= render Registrations::New::Progress::Component.new(step: 2, total: 2) %>

  <%= render UI::Alert::Component.new(kind: :purple, text: t(".confirmation_link_sent"),
      icon: inline_svg_tag("icons/envelope.svg", class: "tw:-mb-0.5 tw:h-4 tw:w-4 tw:shrink-0", aria_hidden: true)) %>

  <%= render Registrations::New::Heading::Component.new(title: t(".add_your_bikes_details"), subtitle: t(".easier_to_recover")) %>

  <%= form_with(url: register_path, method: :patch, scope: :bike) do |f| %>
    <%= hidden_field_tag :b_param_token, @b_param.id_token %>

    <% bike = @b_param.bike %>
    <% color_options = Color.select_options %>
    <% optional_badge = render(UI::Badge::Component.new(text: t(".optional"), size: :xs)) %>

    <%= render Registrations::New::SectionLabel::Component.new(text: t(".bike_details")) %>

    <div class="tw:mb-4">
      <%= f.label :frame_model, class: "twlabel" do %>
        <%= t(".model") %>
        <%= optional_badge %>
      <% end %>

      <%= f.text_field :frame_model, value: bike["frame_model"],
          placeholder: t(".model_placeholder"), class: "twinput tw:mt-1" %>
    </div>

    <div class="tw:mb-4">
      <%= f.label :year, class: "twlabel" do %>
        <%= t(".model_year") %>
        <%= optional_badge %>
      <% end %>

      <%= f.text_field :year, value: bike["year"], inputmode: "numeric",
          placeholder: t(".model_year_placeholder"), class: "twinput tw:mt-1 tw:font-mono" %>
    </div>

    <div
      class="tw:mb-4"
      data-controller="registrations--new--additional-colors"
    >
      <%= f.label :primary_frame_color_id, class: "twlabel" do %>
        <%= t(".color") %>
        <%= render UI::Badge::Component.new(text: t(".up_to_3"), size: :xs) %>
      <% end %>

      <%= f.select :primary_frame_color_id, color_options,
          {selected: @b_param.primary_frame_color_id, include_blank: t(".primary_color_blank")},
          class: "twinput tw:mt-1" %>

      <% {secondary_frame_color_id: t(".second_color_blank"), tertiary_frame_color_id: t(".third_color_blank")}.each do |field, blank_label| %>
        <% value = bike[field.to_s] %>

        <div
          class="tw:mt-2 tw:flex tw:items-center tw:gap-3 <%= "tw:hidden" if value.blank? %>"
          data-registrations--new--additional-colors-target="row"
        >
          <%= f.select field, color_options,
              {selected: value, include_blank: blank_label}, class: "twinput" %>

          <%= render UI::Button::Component.new(text: "×", color: :blue_link,
              html_class: "tw:shrink-0 tw:text-xl tw:leading-none",
              aria: {label: t(".remove_additional_color")},
              data: {action: "registrations--new--additional-colors#remove"}) %>
        </div>
      <% end %>

      <% all_colors_shown = %w[secondary_frame_color_id tertiary_frame_color_id].all? { |field| bike[field].present? } %>

      <div
        class="tw:mt-2 <%= "tw:hidden" if all_colors_shown %>"
        data-registrations--new--additional-colors-target="addButton"
      >
        <%= render UI::Button::Component.new(text: "+ #{t(".add_another_color")}",
            color: :blue_link, html_class: "tw:text-xs",
            data: {action: "registrations--new--additional-colors#add"}) %>
      </div>
    </div>

    <div class="tw:mb-4" data-controller="registrations--new--frame-size">
      <span class="twlabel"><%= t(".frame_size") %><%= optional_badge %></span>

      <div class="tw:mt-2 tw:mb-2 tw:grid tw:grid-cols-5 tw:gap-2">
        <% %w[xs s m l xl].each do |size| %>
          <label class="tw:cursor-pointer">
            <%= f.radio_button :frame_size, size, checked: bike["frame_size"] == size,
                class: "tw:peer tw:sr-only",
                data: {
                  "registrations--new--frame-size-target": "chip",
                  action: "change->registrations--new--frame-size#pickChip"
                } %>

            <span
              class="
                tw:block tw:rounded-sm tw:border tw:border-gray-300
                tw:bg-white tw:py-2 tw:text-center tw:text-sm tw:font-medium
                tw:text-gray-700 tw:peer-checked:border-[#715eb2]
                tw:peer-checked:bg-[#f3f1fa] tw:peer-checked:font-bold
                tw:peer-checked:text-[#715eb2] tw:dark:border-gray-600
                tw:dark:bg-gray-800 tw:dark:text-gray-300
                tw:dark:peer-checked:bg-[#2b2543]
                tw:dark:peer-checked:text-[#b3a6e3]
              "
            >
              <%= size.upcase %>
            </span>
          </label>
        <% end %>
      </div>

      <div class="tw:flex tw:items-center tw:gap-2.5">
        <span class="tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">
          <%= t(".or") %>
        </span>

        <div class="tw:flex tw:flex-1 tw:items-center">
          <%= f.number_field :frame_size_number, value: bike["frame_size_number"],
              step: 0.5, min: 0, placeholder: t(".enter_size"),
              class: "twinput tw:rounded-r-none",
              data: {
                "registrations--new--frame-size-target": "number",
                action: "input->registrations--new--frame-size#pickNumber"
              } %>

          <%= f.select :frame_size_unit, [[t(".inches"), "in"], [t(".cm"), "cm"]],
              {selected: bike["frame_size_unit"] || "in"},
              class: "tw:self-stretch tw:rounded-r-sm tw:border tw:border-l-0
                tw:border-gray-300 tw:bg-gray-50 tw:px-3 tw:py-1.5
                tw:text-sm tw:font-medium tw:text-gray-500
                tw:dark:border-gray-600 tw:dark:bg-gray-700
                tw:dark:text-gray-400" %>
        </div>
      </div>
    </div>

    <div class="tw:mb-4" data-controller="registrations--new--photo">
      <span class="twlabel">
        <%= t(".attach_photo") %>
        <%= optional_badge %>
      </span>

      <%= f.file_field :image, accept: ImageUploader.permitted_extensions.join(","),
          class: "tw:hidden",
          data: {
            "registrations--new--photo-target": "input",
            action: "change->registrations--new--photo#changed"
          } %>

      <div class="tw:mt-2 tw:grid tw:grid-cols-2 tw:gap-2">
        <%= render UI::Button::Component.new(text: t(".take_photo"), color: :secondary,
            html_class: "tw:justify-center", data: {action: "registrations--new--photo#takePhoto"}) %>

        <%= render UI::Button::Component.new(text: t(".upload"), color: :secondary,
            html_class: "tw:justify-center", data: {action: "registrations--new--photo#upload"}) %>
      </div>

      <p
        class="
          tw:mt-1.5 tw:truncate tw:text-xs tw:font-medium tw:text-gray-700
          tw:dark:text-gray-300
        "
        data-registrations--new--photo-target="filename"
      ></p>

      <p class="tw:mt-1.5 tw:text-xs tw:text-gray-500 tw:dark:text-gray-400">
        <%= t(".database_public_note") %>
      </p>
    </div>

    <div class="tw:mb-4" data-controller="collapse registrations--new--serial">
      <div class="tw:flex tw:items-center tw:justify-between tw:gap-2">
        <%= f.label :serial_number, class: "twlabel" do %>
          <%= t(".serial_number") %>
          <span class="tw:text-red-600">*</span>
        <% end %>

        <%= render UI::Button::Component.new(text: t(".wheres_my_serial"),
            color: :blue_link, html_class: "tw:text-xs", data: {action: "collapse#toggle"}) %>
      </div>

      <% made_without_serial = bike["serial_number"] == "made_without_serial" %>

      <div
        class="<%= "tw:hidden" if made_without_serial %>"
        data-registrations--new--serial-target="serialSection"
      >
        <%= f.text_field :serial_number, value: bike["serial_number"],
            placeholder: t(".serial_placeholder"), autocomplete: "off", required: true,
            class: "twinput tw:mt-1 tw:font-mono #{"tw:text-gray-400" if bike["serial_number"] == "unknown"}",
            data: {"registrations--new--serial-target": "input"} %>

        <label class="twlabel tw:mt-2 tw:flex tw:items-center tw:gap-2">
          <%= check_box_tag :serial_missing, true, bike["serial_number"] == "unknown",
              class: "tw:h-4 tw:w-4",
              data: {
                "registrations--new--serial-target": "missing",
                action: "change->registrations--new--serial#toggleMissing"
              } %>

          <%= t(".missing_serial") %>
        </label>

        <div
          class="tw:mt-1.5 <%= "tw:hidden" unless bike["serial_number"] == "unknown" %>"
          data-registrations--new--serial-target="madeWithoutLink"
        >
          <%= render UI::Button::Component.new(text: t(".without_serial_number"),
              color: :blue_link, html_class: "tw:text-xs",
              data: {open_modal: "made-without-serial-modal"}) %>
        </div>
      </div>

      <div
        class="<%= "tw:hidden" unless made_without_serial %>"
        data-registrations--new--serial-target="madeWithoutRow"
      >
        <label class="twlabel tw:mt-2 tw:flex tw:items-center tw:gap-2">
          <%= check_box_tag :made_without_serial_checkbox, true, made_without_serial,
              class: "tw:h-4 tw:w-4",
              data: {
                "registrations--new--serial-target": "madeWithoutCheckbox",
                action: "change->registrations--new--serial#toggleMadeWithout"
              } %>

          <%= t(".without_serial") %>
        </label>
      </div>

      <%= render UI::Modal::Component.new(id: "made-without-serial-modal", title: t(".are_you_certain")) do |modal| %>
        <% modal.with_body do %>
          <p class="tw:mb-2"><%= t(".very_very_few_bikes_html") %></p>

          <ul class="tw:mb-2 tw:list-disc tw:pl-5">
            <li><%= t(".was_made_before_1970") %></li>
            <li class="tw:list-none tw:text-center">— <%= t(".or") %> —</li>
            <li><%= t(".is_a_handmade_frame") %></li>
          </ul>

          <p class="tw:mb-1"><%= t(".it_probably_has_a_serial_number") %></p>

          <p class="tw:mb-4">
            <%= t(".read_how_to_find_html",
              how_to_find_link: link_to(t(".how_to_find_serial"), serials_path, target: "_blank", class: "twlink")) %>
          </p>

          <div class="tw:grid tw:grid-cols-2 tw:gap-4">
            <div>
              <%= render UI::Button::Component.new(text: t(".nevermind"), color: :secondary,
                  html_class: "tw:w-full tw:justify-center", data: {action: "ui--modal#close"}) %>

              <p class="tw:mt-1 tw:mb-0 tw:text-center tw:text-xs tw:text-gray-500">
                <%= t(".i_just_dont_know_the_serial") %>
              </p>
            </div>

            <div>
              <%= render UI::Button::Component.new(text: t(".im_100_sure"), color: :error,
                  html_class: "tw:w-full tw:justify-center",
                  data: {action: "registrations--new--serial#confirmMadeWithout ui--modal#close"}) %>

              <p class="tw:mt-1 tw:mb-0 tw:text-center tw:text-xs tw:text-gray-500">
                <%= t(".without_serial") %>
              </p>
            </div>
          </div>
        <% end %>
      <% end %>

      <div
        class="
          tw:mt-2 tw:hidden tw:rounded-sm tw:border tw:border-gray-200
          tw:bg-gray-50 tw:p-4 tw:dark:border-gray-700 tw:dark:bg-gray-900
        "
        data-collapse-target="content"
      >
        <p class="tw:mb-2 tw:text-xs tw:text-gray-600 tw:dark:text-gray-400">
          <%= t(".serial_help_intro") %>
        </p>

        <ul
          class="
            tw:mb-3 tw:list-disc tw:pl-5 tw:text-xs tw:text-gray-600
            tw:dark:text-gray-400
          "
        >
          <li><%= t(".serial_location_bottom_bracket") %></li>
          <li><%= t(".serial_location_head_tube") %></li>
          <li><%= t(".serial_location_rear_dropouts") %></li>
        </ul>

        <div class="tw:mb-3 tw:grid tw:grid-cols-3 tw:gap-2">
          <% {"serials/serial_bb.jpg" => t(".bottom_bracket"),
              "serials/serial_headtube.jpg" => t(".head_tube"),
              "serials/serial_pinsch.jpg" => t(".rear_dropouts")}.each do |image, caption| %>
            <figure class="tw:m-0">
              <%= image_tag image, alt: caption, class: "tw:aspect-square tw:w-full tw:rounded-sm tw:object-cover" %>

              <figcaption
                class="
                  tw:mt-1 tw:text-center tw:text-xs tw:font-medium
                  tw:text-gray-500 tw:dark:text-gray-400
                "
              >
                <%= caption %>
              </figcaption>
            </figure>
          <% end %>
        </div>

        <%= link_to t(".view_serial_guide"), serials_path, class: "twlink tw:text-xs tw:font-semibold" %>
      </div>
    </div>

    <div class="tw:mb-4">
      <%= f.label :bike_sticker, class: "twlabel" do %>
        <%= t(".sticker_number") %>
        <%= optional_badge %>
      <% end %>

      <%= f.text_field :bike_sticker, value: @b_param.bike_sticker_code,
          placeholder: t(".sticker_placeholder"), autocomplete: "off",
          class: "twinput tw:mt-1 tw:font-mono" %>
    </div>

    <div class="tw:mb-4">
      <%= f.label :status, t(".registration_type"), class: "twlabel" %>

      <% status_options = {"status_with_owner" => [t(".owner_registration"), t(".owner_registration_description")],
          "status_stolen" => [t(".stolen"), t(".stolen_description")],
          "status_impounded" => [t(".found"), t(".found_description")]}.map do |status, (title, description)|
          content = safe_join([content_tag(:span, title, class: "tw:block tw:font-semibold"),
            content_tag(:span, description, class: "tw:block tw:text-xs tw:text-[#9a9aa2] tw:dark:text-gray-500")])
          {display: title, value: status, content:}
        end %>

      <%= render Form::Combobox::Component.new(name: :status, form: f,
          value: @b_param.status || "status_with_owner", options: status_options) %>
    </div>

    <%= render Registrations::New::SectionLabel::Component.new(text: t(".additional_contact_info"), divider: true) %>

    <div class="tw:mb-4">
      <span class="twlabel"><%= t(".email") %></span>

      <p
        class="
          tw:mt-1 tw:mb-0 tw:flex tw:items-center tw:justify-between
          tw:gap-2 tw:rounded-sm tw:border tw:border-gray-300 tw:bg-gray-50
          tw:px-2.5 tw:py-1.5 tw:dark:border-gray-600 tw:dark:bg-gray-700
        "
      >
        <span class="tw:truncate tw:text-base tw:text-gray-600 tw:dark:text-gray-300">
          <%= @b_param.owner_email %>
        </span>

        <%= render UI::Badge::Component.new(text: t(".from_step_1"), size: :xs) %>
      </p>
    </div>

    <div class="tw:mb-6">
      <%= f.label :phone, class: "twlabel" do %>
        <%= t(".phone") %>
        <%= optional_badge %>
      <% end %>

      <%= f.telephone_field :phone, value: bike["phone"],
          placeholder: t(".phone_placeholder"), class: "twinput tw:mt-1" %>
    </div>

    <%= render UI::Button::Component.new(text: t(".complete_registration"),
        color: :blue, size: :lg, kind: :submit, html_class: "tw:w-full") %>

    <p class="tw:mt-3 tw:mb-0 tw:text-center">
      <%= link_to "← #{t(".back")}", new_register_path,
          class: "tw:text-sm tw:font-medium tw:text-gray-500 tw:no-underline tw:hover:text-gray-700 tw:dark:text-gray-400" %>
    </p>
  <% end %>
<% end %>
