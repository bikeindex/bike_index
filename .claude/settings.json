{
  "enabledMcpjsonServers": ["playwright"],
  "permissions": {
    "allow": [
      "Bash(bin/workspace_setup:*)",
      "Bash(bin/env:*)",
      "Bash(ruby bin/env:*)",
      "Bash(bin/lint:*)",
      "Bash(bin/char_count:*)",
      "Bash(bin/rails:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rails:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq --arg root \"$CLAUDE_PROJECT_DIR\" -c 'if (((.tool_input.file_path // .tool_input.notebook_path) // \"\") == \"\" or (((.tool_input.file_path // .tool_input.notebook_path)) | startswith($root + \"/\")) or (((.tool_input.file_path // .tool_input.notebook_path)) | test(\"^\" + env.HOME + \"/\\\\.claude/projects/[^/]+/memory/[^/]+$\"))) then empty else {hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:(\"Refusing to write \" + (.tool_input.file_path // .tool_input.notebook_path) + \" -- it is outside this checkout (\" + $root + \"). In a worktree, the main checkout is a sibling you must not edit; use a path inside this one.\")}} end'",
            "statusMessage": "Checking the path is inside this checkout"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pr-guardrails.sh",
            "statusMessage": "Checking the PR guardrails"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/mise-shims.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 900,
            "statusMessage": "Setting up the sandbox toolchain"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-setup.sh",
            "timeout": 900,
            "statusMessage": "Running bin/workspace_setup for this worktree"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-teardown.sh",
            "timeout": 120,
            "statusMessage": "Dropping this worktree's databases"
          }
        ]
      }
    ]
  }
}
