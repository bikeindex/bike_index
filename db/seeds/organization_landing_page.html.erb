<% brand_color = "c9a227" %>

<style>
  #organized_manage_landing,
  #landing_pages_show {
    background: url(https://files.bikeindex.org/uploads/Pu/735759/princeton-bg.jpg)
      no-repeat top center fixed;
    background-size: cover;
    background-color: #000000;
  }
  .binx-ico-bg {
    fill: none;
  }
  .binx-ico-ring,
  .binx-ico-obj,
  .binx-ico-obj-exclamation {
    fill: #000000;
  }
  div.org-landing-tips-list img {
    border-color: #<%= brand_color %>;
  }
  .org-landing-header-logo {
    max-width: 300px;
    margin: 0 auto 24px;
    display: block;
  }
</style>

<div class="container org-landing-wrapper">
  <img
    src="<%= organization.avatar.url %>"
    class="org-landing-header-logo"
    alt="Brakebills University"
  >

  <h1>Brakebills University Bicycle Registration</h1>

  <div class="row">
    <div class="col-md-5 org-landing-embed-col">
      <iframe
        src="/register/embed?organization_id=<%= organization.to_param %>&button=<%= brand_color %>&button_hover=a78620"
        title="Register your bike with Brakebills University"
        style="width: 100%; border: none; height: 620px;"
      ></iframe>
    </div>

    <div class="col-md-7">
